{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:dap:timeline-navigation:v1",
  "title": "Elisa DAP timeline navigation version 1",
  "description": "Custom DAP requests and responses for querying retained execution history and seeking within it.",
  "oneOf": [
    { "$ref": "#/$defs/getTimelineRequest" },
    { "$ref": "#/$defs/seekRequest" },
    { "$ref": "#/$defs/timelineResponse" },
    { "$ref": "#/$defs/seekResponse" }
  ],
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "requestEnvelope": {
      "type": "object",
      "required": ["seq", "type", "command"],
      "properties": {
        "seq": { "$ref": "#/$defs/nonNegativeInteger" },
        "type": { "const": "request" }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "required": ["seq", "type", "request_seq", "success", "command"],
      "properties": {
        "seq": { "$ref": "#/$defs/nonNegativeInteger" },
        "type": { "const": "response" },
        "request_seq": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "getTimelineRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "not": { "required": ["arguments"] },
          "properties": {
            "command": { "const": "elisa/getTimeline" }
          }
        }
      ]
    },
    "seekRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "required": ["arguments"],
          "properties": {
            "command": { "const": "elisa/seek" },
            "arguments": {
              "type": "object",
              "required": ["eventIndex", "expectedStopGeneration"],
              "properties": {
                "eventIndex": { "$ref": "#/$defs/nonNegativeInteger" },
                "expectedStopGeneration": { "$ref": "#/$defs/nonNegativeInteger" }
              }
            }
          }
        }
      ]
    },
    "timelineBody": {
      "type": "object",
      "required": [
        "version",
        "stopGeneration",
        "currentEvent",
        "hasRetainedRange",
        "retainedFirst",
        "retainedLast",
        "hasExactRange",
        "exactFirst",
        "exactLast",
        "canSeek",
        "canReverse"
      ],
      "properties": {
        "version": { "const": 1 },
        "stopGeneration": { "$ref": "#/$defs/nonNegativeInteger" },
        "currentEvent": { "$ref": "#/$defs/nonNegativeInteger" },
        "hasRetainedRange": { "type": "boolean" },
        "retainedFirst": { "$ref": "#/$defs/nonNegativeInteger" },
        "retainedLast": { "$ref": "#/$defs/nonNegativeInteger" },
        "hasExactRange": { "type": "boolean" },
        "exactFirst": { "$ref": "#/$defs/nonNegativeInteger" },
        "exactLast": { "$ref": "#/$defs/nonNegativeInteger" },
        "canSeek": { "type": "boolean" },
        "canReverse": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "hasRetainedRange": { "const": false } } },
          "then": {
            "properties": {
              "retainedFirst": { "const": 0 },
              "retainedLast": { "const": 0 }
            }
          }
        },
        {
          "if": { "properties": { "hasExactRange": { "const": false } } },
          "then": {
            "properties": {
              "exactFirst": { "const": 0 },
              "exactLast": { "const": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "timelineResponse": {
      "allOf": [
        { "$ref": "#/$defs/responseEnvelope" },
        {
          "properties": {
            "success": { "const": true },
            "command": { "const": "elisa/getTimeline" },
            "body": { "$ref": "#/$defs/timelineBody" }
          },
          "required": ["body"]
        }
      ]
    },
    "seekResponse": {
      "allOf": [
        { "$ref": "#/$defs/responseEnvelope" },
        {
          "properties": {
            "command": { "const": "elisa/seek" },
            "success": { "type": "boolean" },
            "message": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "success": { "const": false } } },
              "then": { "required": ["message"] }
            }
          ]
        }
      ]
    }
  }
}
