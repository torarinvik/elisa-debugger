{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:dap:trace-files:v1",
  "title": "Elisa DAP trace files version 1",
  "description": "Custom DAP requests and responses for saving exact managed traces and opening compatible trace files.",
  "oneOf": [
    {
      "$ref": "#/$defs/saveTraceRequest"
    },
    {
      "$ref": "#/$defs/openTraceRequest"
    },
    {
      "$ref": "#/$defs/traceFileResponse"
    }
  ],
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "requestEnvelope": {
      "type": "object",
      "required": [
        "seq",
        "type",
        "command",
        "arguments"
      ],
      "properties": {
        "seq": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "type": {
          "const": "request"
        }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "required": [
        "seq",
        "type",
        "request_seq",
        "success",
        "command"
      ],
      "properties": {
        "seq": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "type": {
          "const": "response"
        },
        "request_seq": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "success": {
          "type": "boolean"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "saveTraceRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/requestEnvelope"
        },
        {
          "properties": {
            "command": {
              "const": "elisa/saveTrace"
            },
            "arguments": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/path"
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "openTraceRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/requestEnvelope"
        },
        {
          "properties": {
            "command": {
              "const": "elisa/openTrace"
            },
            "arguments": {
              "type": "object",
              "required": [
                "path",
                "eventIndex",
                "expectedStopGeneration"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/path"
                },
                "eventIndex": {
                  "$ref": "#/$defs/nonNegativeInteger"
                },
                "expectedStopGeneration": {
                  "$ref": "#/$defs/nonNegativeInteger"
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "traceFileResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/responseEnvelope"
        },
        {
          "properties": {
            "command": {
              "enum": [
                "elisa/saveTrace",
                "elisa/openTrace"
              ]
            },
            "success": {
              "type": "boolean"
            },
            "body": {
              "oneOf": [
                {
                  "$ref": "#/$defs/traceSuccessBody"
                },
                {
                  "$ref": "#/$defs/traceDivergenceBody"
                }
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "success": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "$ref": "#/$defs/traceSuccessBody"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "success": {
                    "const": false
                  }
                }
              },
              "then": {
                "required": [
                  "message"
                ],
                "properties": {
                  "body": {
                    "$ref": "#/$defs/traceDivergenceBody"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "required": [
                      "elisaReplayDivergence"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "command": {
                    "const": "elisa/openTrace"
                  },
                  "success": {
                    "const": false
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "unsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned 64-bit decimal value. Strings preserve all bits in JSON clients."
    },
    "replayDivergence": {
      "type": "object",
      "required": [
        "version",
        "component",
        "eventIndex",
        "lastVerifiedEvent",
        "recordingId",
        "branchId",
        "expectedTaskId",
        "observedTaskId",
        "expectedInvocationId",
        "observedInvocationId",
        "expectedCallSiteId",
        "observedCallSiteId",
        "expectedRequestHash",
        "observedRequestHash",
        "expectedValue",
        "observedValue",
        "verifiedCheckpointEvent",
        "expectedEventAvailable",
        "observedEventAvailable",
        "expectedValueAvailable",
        "observedValueAvailable",
        "verifiedCheckpointAvailable",
        "expectedKind",
        "observedKind"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "component": {
          "enum": [
            "event-identity",
            "event-kind",
            "payload",
            "machine-state",
            "side-state",
            "effect-kind",
            "call-site",
            "invocation",
            "request",
            "resource-identity",
            "event-count",
            "missing-result"
          ]
        },
        "eventIndex": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "lastVerifiedEvent": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "recordingId": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "branchId": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "expectedTaskId": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "observedTaskId": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "expectedInvocationId": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "observedInvocationId": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "expectedCallSiteId": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "observedCallSiteId": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "expectedRequestHash": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "observedRequestHash": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "expectedValue": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "observedValue": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "verifiedCheckpointEvent": {
          "$ref": "#/$defs/unsignedDecimal"
        },
        "expectedEventAvailable": {
          "type": "boolean"
        },
        "observedEventAvailable": {
          "type": "boolean"
        },
        "expectedValueAvailable": {
          "type": "boolean"
        },
        "observedValueAvailable": {
          "type": "boolean"
        },
        "verifiedCheckpointAvailable": {
          "type": "boolean"
        },
        "expectedKind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "observedKind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "traceSuccessBody": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "traceDivergenceBody": {
      "type": "object",
      "required": [
        "elisaReplayDivergence"
      ],
      "properties": {
        "elisaReplayDivergence": {
          "$ref": "#/$defs/replayDivergence"
        }
      },
      "additionalProperties": false
    }
  }
}
