{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:dap:trace-files:v1",
  "title": "Elisa DAP trace files version 1",
  "description": "Custom DAP requests and responses for saving exact managed traces and opening compatible trace files.",
  "oneOf": [
    { "$ref": "#/$defs/saveTraceRequest" },
    { "$ref": "#/$defs/openTraceRequest" },
    { "$ref": "#/$defs/traceFileResponse" }
  ],
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "requestEnvelope": {
      "type": "object",
      "required": ["seq", "type", "command", "arguments"],
      "properties": {
        "seq": { "$ref": "#/$defs/nonNegativeInteger" },
        "type": { "const": "request" }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "required": ["seq", "type", "request_seq", "success", "command"],
      "properties": {
        "seq": { "$ref": "#/$defs/nonNegativeInteger" },
        "type": { "const": "response" },
        "request_seq": { "$ref": "#/$defs/nonNegativeInteger" },
        "success": { "type": "boolean" }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "saveTraceRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "command": { "const": "elisa/saveTrace" },
            "arguments": {
              "type": "object",
              "required": ["path"],
              "properties": { "path": { "$ref": "#/$defs/path" } },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "openTraceRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "command": { "const": "elisa/openTrace" },
            "arguments": {
              "type": "object",
              "required": ["path", "eventIndex", "expectedStopGeneration"],
              "properties": {
                "path": { "$ref": "#/$defs/path" },
                "eventIndex": { "$ref": "#/$defs/nonNegativeInteger" },
                "expectedStopGeneration": { "$ref": "#/$defs/nonNegativeInteger" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "traceFileResponse": {
      "allOf": [
        { "$ref": "#/$defs/responseEnvelope" },
        {
          "properties": {
            "command": { "enum": ["elisa/saveTrace", "elisa/openTrace"] },
            "success": { "type": "boolean" },
            "body": {
              "type": "object",
              "required": ["accepted"],
              "properties": { "accepted": { "const": true } },
              "additionalProperties": false
            },
            "message": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "success": { "const": true } } },
              "then": { "required": ["body"] }
            },
            {
              "if": { "properties": { "success": { "const": false } } },
              "then": { "required": ["message"] }
            }
          ]
        }
      ]
    }
  }
}
