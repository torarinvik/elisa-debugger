{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:branch",
  "title": "Elisa debugger compact managed branch metadata",
  "description": "Branch creation returns a stable branch identity; interventions and durable trace transfer use separate typed operations.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      ]
    },
    "responseId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "u64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "request": {
      "type": "object",
      "required": ["method", "id"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "branch" },
        "id": { "$ref": "#/$defs/requestId" },
        "sessionId": { "$ref": "#/$defs/u64" },
        "ownerToken": { "$ref": "#/$defs/u64" },
        "expectedStopGeneration": { "$ref": "#/$defs/u64" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": ["accepted", "stopGeneration", "branch"],
          "properties": {
            "accepted": { "const": true },
            "stopGeneration": { "$ref": "#/$defs/u64" },
            "branch": {
              "type": "object",
              "required": ["id"],
              "properties": { "id": { "$ref": "#/$defs/u64" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
