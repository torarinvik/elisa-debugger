{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:create-session",
  "title": "Elisa debugger compact session ownership exchange",
  "description": "The optional compact-process ownership handshake. Once accepted, state-changing requests must carry the returned sessionId and ownerToken.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      ]
    },
    "responseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "positiveId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "request": {
      "type": "object",
      "required": ["method", "id"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "createSession" },
        "id": { "$ref": "#/$defs/requestId" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": ["accepted", "sessionId", "ownerToken", "stopGeneration"],
          "properties": {
            "accepted": { "const": true },
            "sessionId": { "$ref": "#/$defs/positiveId" },
            "ownerToken": { "$ref": "#/$defs/positiveId" },
            "stopGeneration": { "$ref": "#/$defs/generation" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
