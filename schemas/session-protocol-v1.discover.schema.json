{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:discover",
  "title": "Elisa debugger compact session protocol v1 discovery exchange",
  "description": "The current headless process discover request and its capability response. Discovery is available before initialize.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Positive decimal u64 value. The numeric value must not exceed 18446744073709551615."
        }
      ]
    },
    "responseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "description": "The request ID encoded as a decimal string; id-less discover requests receive fallback ID 1."
    },
    "request": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "discover" },
        "id": { "$ref": "#/$defs/requestId" }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "required": [
        "sourceBreakpoints",
        "functionBreakpoints",
        "dataBreakpoints",
        "typedValues",
        "expressionEvaluation",
        "reverseExecution",
        "checkpoints",
        "branches",
        "concurrencyGraph",
        "provenance",
        "remoteTransport",
        "traceVerification",
        "memoryRead",
        "historicalQueries",
        "traceExport",
        "scheduleExploration",
        "nativeAttach",
        "postmortemInspection"
      ],
      "properties": {
        "sourceBreakpoints": { "type": "boolean" },
        "functionBreakpoints": { "type": "boolean" },
        "dataBreakpoints": { "type": "boolean" },
        "typedValues": { "type": "boolean" },
        "expressionEvaluation": { "type": "boolean" },
        "reverseExecution": { "type": "boolean" },
        "checkpoints": { "type": "boolean" },
        "branches": { "type": "boolean" },
        "concurrencyGraph": { "type": "boolean" },
        "provenance": { "type": "boolean" },
        "remoteTransport": { "type": "boolean" },
        "traceVerification": { "type": "boolean" },
        "memoryRead": { "type": "boolean" },
        "historicalQueries": { "type": "boolean" },
        "traceExport": { "type": "boolean" },
        "scheduleExploration": { "type": "boolean" },
        "nativeAttach": { "type": "boolean" },
        "postmortemInspection": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": [
            "protocolMajor",
            "protocolMinor",
            "server",
            "productVersion",
            "engines",
            "traceSchema",
            "features",
            "installationHealthy"
          ],
          "properties": {
            "protocolMajor": { "const": 1 },
            "protocolMinor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "server": { "const": "elisa-debugger" },
            "productVersion": { "type": "string", "minLength": 1 },
            "engines": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "traceSchema": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
            "features": { "$ref": "#/$defs/features" },
            "installationHealthy": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
