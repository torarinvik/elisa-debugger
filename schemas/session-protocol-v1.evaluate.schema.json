{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:evaluate",
  "title": "Elisa debugger compact expression evaluation",
  "description": "Side-effect-free bounded integer evaluation against one stopped managed frame.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      ]
    },
    "responseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Decimal u64 value; its numeric value must not exceed 18446744073709551615."
    },
    "request": {
      "type": "object",
      "required": ["method", "id", "arguments"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "evaluate" },
        "id": { "$ref": "#/$defs/requestId" },
        "sessionId": { "$ref": "#/$defs/u64" },
        "ownerToken": { "$ref": "#/$defs/u64" },
        "expectedStopGeneration": { "$ref": "#/$defs/u64" },
        "arguments": {
          "type": "object",
          "required": ["expression"],
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Bounded ASCII integer expression using the grammar in spec/expression-evaluation.md. JSON escapes are decoded before evaluation."
            },
            "frameIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "default": 0,
              "description": "Zero-based stopped call frame; omitted selects the current frame."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": ["accepted", "stopGeneration", "evaluation"],
          "properties": {
            "accepted": { "const": true },
            "stopGeneration": { "$ref": "#/$defs/u64" },
            "evaluation": {
              "type": "object",
              "required": ["type", "value", "consumed"],
              "properties": {
                "type": { "const": "i64" },
                "value": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)$",
                  "description": "Exact signed 64-bit result encoded as a decimal string."
                },
                "consumed": { "type": "integer", "minimum": 0, "maximum": 256 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
