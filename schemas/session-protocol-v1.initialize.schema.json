{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:initialize",
  "title": "Elisa debugger session protocol v1 initialize exchange",
  "description": "The current headless-process version negotiation request and responses.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/compatibleResponse" },
    { "$ref": "#/$defs/incompatibleVersionResponse" },
    { "$ref": "#/$defs/invalidRequestResponse" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      ]
    },
    "responseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "request": {
      "type": "object",
      "required": ["method", "id", "protocolMajor", "protocolMinor"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "initialize" },
        "id": { "$ref": "#/$defs/requestId" },
        "protocolMajor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "protocolMinor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "client": {
          "type": "object",
          "description": "Reserved for client identity metadata; identity exchange is not yet part of the compact process handshake."
        }
      },
      "additionalProperties": true
    },
    "compatibleResponse": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": ["protocolMajor", "protocolMinor", "server", "productVersion", "installationHealthy"],
          "properties": {
            "protocolMajor": { "const": 1 },
            "protocolMinor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "server": { "const": "elisa-debugger" },
            "productVersion": { "type": "string" },
            "installationHealthy": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "incompatibleVersionResponse": {
      "type": "object",
      "required": ["kind", "id", "ok", "error"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message", "requestedProtocolMajor", "serverProtocolMajor", "serverProtocolMinor"],
          "properties": {
            "code": { "const": "INCOMPATIBLE_VERSION" },
            "message": { "type": "string" },
            "requestedProtocolMajor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "serverProtocolMajor": { "const": 1 },
            "serverProtocolMinor": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "invalidRequestResponse": {
      "type": "object",
      "required": ["kind", "id", "ok", "error"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "const": "INVALID_ARGUMENT" },
            "message": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
