{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:memory",
  "title": "Elisa debugger compact managed memory read",
  "description": "Bounded logical managed-memory reads for editor-neutral clients.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      ]
    },
    "responseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Decimal u64 value; its numeric value must not exceed 18446744073709551615."
    },
    "request": {
      "type": "object",
      "required": ["method", "id", "arguments"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "memory" },
        "id": { "$ref": "#/$defs/requestId" },
        "sessionId": { "$ref": "#/$defs/u64" },
        "expectedStopGeneration": { "$ref": "#/$defs/u64" },
        "arguments": {
          "type": "object",
          "required": ["address", "length"],
          "properties": {
            "address": {
              "oneOf": [
                { "type": "integer", "minimum": 0, "maximum": 512 },
                { "type": "string", "pattern": "^(0|[1-9][0-9]{0,2})$" }
              ]
            },
            "length": { "type": "integer", "minimum": 0, "maximum": 64 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": ["accepted", "stopGeneration", "memory"],
          "properties": {
            "accepted": { "const": true },
            "stopGeneration": { "$ref": "#/$defs/u64" },
            "memory": {
              "type": "object",
              "required": ["address", "length", "state", "bytes"],
              "properties": {
                "address": { "$ref": "#/$defs/u64" },
                "length": { "type": "integer", "minimum": 0, "maximum": 64 },
                "state": { "const": "available" },
                "bytes": { "type": "string", "pattern": "^[0-9a-f]{0,128}$" }
              },
              "allOf": [
                {
                  "if": { "properties": { "length": { "type": "integer" } } },
                  "then": { "properties": { "bytes": { "minLength": 0, "maxLength": 128 } } }
                }
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
