{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elisa-debugger.invalid/schemas/session-protocol-v1.native-stack.schema.json",
  "title": "Elisa debugger native stack page response",
  "type": "object",
  "required": ["kind", "id", "ok", "result"],
  "properties": {
    "kind": { "const": "response" },
    "id": { "$ref": "#/$defs/positiveId" },
    "ok": { "const": true },
    "result": {
      "type": "object",
      "required": ["accepted", "stopGeneration", "stack"],
      "properties": {
        "accepted": { "const": true },
        "stopGeneration": { "$ref": "#/$defs/positiveId" },
        "stack": {
          "type": "object",
          "required": ["threadId", "totalFrames", "startFrame", "frames", "nextFrame", "complete"],
          "properties": {
            "threadId": { "$ref": "#/$defs/positiveId" },
            "totalFrames": { "type": "integer", "minimum": 0, "maximum": 32 },
            "startFrame": { "type": "integer", "minimum": 0, "maximum": 32 },
            "frames": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/frame" }
            },
            "nextFrame": {
              "oneOf": [
                { "type": "integer", "minimum": 0, "maximum": 32 },
                { "type": "null" }
              ]
            },
            "complete": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": { "properties": { "complete": { "const": true } }, "required": ["complete"] },
              "then": { "properties": { "nextFrame": { "type": "null" } } }
            },
            {
              "if": { "properties": { "complete": { "const": false } }, "required": ["complete"] },
              "then": { "properties": { "nextFrame": { "type": "integer", "minimum": 1, "maximum": 32 } } }
            }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "positiveId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "optionalId": {
      "oneOf": [
        { "$ref": "#/$defs/positiveId" },
        { "type": "null" }
      ]
    },
    "frame": {
      "type": "object",
      "required": ["index", "invocationId", "parentInvocationId", "functionId", "taskId", "sourceId", "line", "column", "localCount"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 31 },
        "invocationId": { "$ref": "#/$defs/positiveId" },
        "parentInvocationId": { "$ref": "#/$defs/optionalId" },
        "functionId": { "$ref": "#/$defs/positiveId" },
        "taskId": { "$ref": "#/$defs/positiveId" },
        "sourceId": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "line": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "column": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "localCount": { "type": "integer", "minimum": 0, "maximum": 32 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
