{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elisa-debugger.invalid/schemas/session-protocol-v1.native-values.schema.json",
  "title": "Elisa debugger native local values page response",
  "type": "object",
  "required": ["kind", "id", "ok", "result"],
  "properties": {
    "kind": { "const": "response" },
    "id": { "$ref": "#/$defs/positiveId" },
    "ok": { "const": true },
    "result": {
      "type": "object",
      "required": ["accepted", "stopGeneration", "frame", "totalBindings", "startBinding", "values", "complete", "nextBinding"],
      "properties": {
        "accepted": { "const": true },
        "stopGeneration": { "$ref": "#/$defs/positiveId" },
        "frame": {
          "type": "object",
          "required": ["index", "invocationId"],
          "properties": {
            "index": { "type": "integer", "minimum": 0, "maximum": 31 },
            "invocationId": { "$ref": "#/$defs/positiveId" }
          },
          "additionalProperties": true
        },
        "totalBindings": { "type": "integer", "minimum": 0, "maximum": 32 },
        "startBinding": { "type": "integer", "minimum": 0, "maximum": 32 },
        "values": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/value" }
        },
        "complete": { "type": "boolean" },
        "nextBinding": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 32 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "complete": { "const": true } }, "required": ["complete"] },
          "then": { "properties": { "nextBinding": { "type": "null" } } }
        },
        {
          "if": { "properties": { "complete": { "const": false } }, "required": ["complete"] },
          "then": { "properties": { "nextBinding": { "type": "integer", "minimum": 1, "maximum": 32 } } }
        }
      ],
      "additionalProperties": true
    }
  },
  "$defs": {
    "positiveId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "value": {
      "type": "object",
      "required": ["bindingId", "scopeId", "typeId", "name", "kind", "state", "storageKind", "storageLocation", "byteSize", "bytes", "display", "displayStatus"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/positiveId" },
        "scopeId": { "$ref": "#/$defs/positiveId" },
        "typeId": { "$ref": "#/$defs/positiveId" },
        "name": { "type": "string", "pattern": "^binding-[1-9][0-9]*$" },
        "kind": { "enum": ["void", "signed", "unsigned", "floating", "boolean", "text", "aggregate", "reference", "opaque"] },
        "state": { "enum": ["available", "unavailable", "optimizedAway", "uninitialized", "redacted", "invalid"] },
        "storageKind": { "enum": ["register", "stackSlot", "constant", "runtimeSlot", "unknown"] },
        "storageLocation": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
        "byteSize": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "bytes": {
          "oneOf": [
            { "type": "string", "pattern": "^(?:[0-9a-f]{2}){0,32}$" },
            { "type": "null" }
          ]
        },
        "display": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "displayStatus": { "enum": ["available", "unavailable", "unsupported", "invalid"] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "available" } }, "required": ["state"] },
          "then": { "properties": { "bytes": { "type": "string" } } },
          "else": { "properties": { "bytes": { "type": "null" }, "display": { "type": "null" } } }
        },
        {
          "if": { "properties": { "displayStatus": { "const": "available" } }, "required": ["displayStatus"] },
          "then": { "properties": { "display": { "type": "string" } } },
          "else": { "properties": { "display": { "type": "null" } } }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
