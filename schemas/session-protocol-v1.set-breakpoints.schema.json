{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:setBreakpoints",
  "title": "Elisa debugger compact source-breakpoint exchange",
  "description": "Managed EDIR source-line breakpoint replacement for the compact headless process.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Positive decimal u64 value; its numeric value must not exceed 18446744073709551615."
        }
      ]
    },
    "responseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "description": "The request ID encoded as a decimal string."
    },
    "generation": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "Decimal u64 value; its numeric value must not exceed 18446744073709551615."
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Exact normalized logical source path stored in the EDIR artifact. Absolute editor paths must be mapped by the host."
        }
      },
      "additionalProperties": false
    },
    "breakpoint": {
      "type": "object",
      "required": ["line"],
      "properties": {
        "line": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["method", "id", "arguments"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "setBreakpoints" },
        "id": { "$ref": "#/$defs/requestId" },
        "expectedStopGeneration": { "$ref": "#/$defs/generation" },
        "arguments": {
          "type": "object",
          "required": ["source", "breakpoints"],
          "properties": {
            "source": { "$ref": "#/$defs/source" },
            "breakpoints": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/breakpoint" },
              "description": "Replaces the complete set of source-line breakpoints for this path. An empty array clears them."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "resolvedBreakpoint": {
      "type": "object",
      "required": ["id", "line", "verified"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Manager-assigned breakpoint ID encoded as a decimal string."
        },
        "line": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "verified": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": ["accepted", "stopGeneration", "breakpoints"],
          "properties": {
            "accepted": { "const": true },
            "stopGeneration": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Current stop generation encoded as a decimal string."
            },
            "breakpoints": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/resolvedBreakpoint" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
