{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:timeline",
  "title": "Elisa debugger compact timeline snapshot",
  "description": "Read-only managed history, bookmark, and checkpoint metadata for editor-neutral clients.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      ]
    },
    "responseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Decimal u64 value; its numeric value must not exceed 18446744073709551615."
    },
    "generation": {
      "$ref": "#/$defs/u64"
    },
    "range": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "firstEvent": { "$ref": "#/$defs/u64" },
        "lastEvent": { "$ref": "#/$defs/u64" }
      },
      "allOf": [
        {
          "if": { "properties": { "available": { "const": true } } },
          "then": { "required": ["firstEvent", "lastEvent"] }
        }
      ],
      "additionalProperties": false
    },
    "bookmark": {
      "type": "object",
      "required": ["id", "event", "labelId", "noteId", "pinned"],
      "properties": {
        "id": { "$ref": "#/$defs/u64" },
        "event": { "$ref": "#/$defs/u64" },
        "labelId": { "$ref": "#/$defs/u64" },
        "noteId": { "$ref": "#/$defs/u64" },
        "pinned": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "event": { "$ref": "#/$defs/u64" },
        "stateHash": { "$ref": "#/$defs/u64" }
      },
      "allOf": [
        {
          "if": { "properties": { "available": { "const": true } } },
          "then": { "required": ["event", "stateHash"] }
        }
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["method", "id"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "timeline" },
        "id": { "$ref": "#/$defs/requestId" },
        "sessionId": { "$ref": "#/$defs/u64" },
        "expectedStopGeneration": { "$ref": "#/$defs/generation" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": ["accepted", "stopGeneration", "timeline"],
          "properties": {
            "accepted": { "const": true },
            "stopGeneration": { "$ref": "#/$defs/generation" },
            "timeline": {
              "type": "object",
              "required": ["position", "history", "bookmarks", "checkpoint"],
              "properties": {
                "position": {
                  "type": "object",
                  "required": ["event", "branch"],
                  "properties": {
                    "event": { "$ref": "#/$defs/u64" },
                    "branch": { "$ref": "#/$defs/u64" }
                  },
                  "additionalProperties": false
                },
                "history": {
                  "type": "object",
                  "required": ["retained", "exact"],
                  "properties": {
                    "retained": { "$ref": "#/$defs/range" },
                    "exact": { "$ref": "#/$defs/range" }
                  },
                  "additionalProperties": false
                },
                "bookmarks": {
                  "type": "array",
                  "maxItems": 128,
                  "items": { "$ref": "#/$defs/bookmark" }
                },
                "checkpoint": { "$ref": "#/$defs/checkpoint" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
