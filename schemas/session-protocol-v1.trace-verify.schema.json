{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elisa-debugger:session-protocol:v1:trace-verify",
  "title": "Elisa debugger compact trace verification",
  "description": "A bounded, read-only verification snapshot for the current managed trace. It reports metadata only; trace bytes use a separate transport.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      ]
    },
    "responseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Decimal u64 value; its numeric value must not exceed 18446744073709551615."
    },
    "request": {
      "type": "object",
      "required": ["method", "id"],
      "properties": {
        "kind": { "const": "request" },
        "method": { "const": "trace.verify" },
        "id": { "$ref": "#/$defs/requestId" },
        "sessionId": { "$ref": "#/$defs/u64" },
        "expectedStopGeneration": { "$ref": "#/$defs/u64" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["kind", "id", "ok", "result"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/responseId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "required": ["accepted", "stopGeneration", "verification"],
          "properties": {
            "accepted": { "const": true },
            "stopGeneration": { "$ref": "#/$defs/u64" },
            "verification": {
              "type": "object",
              "required": ["state", "verifiedChunks", "verifiedEvent", "replayable"],
              "properties": {
                "state": { "enum": ["exact", "partial", "unavailable", "corrupt", "empty"] },
                "verifiedChunks": { "$ref": "#/$defs/u64" },
                "verifiedEvent": { "$ref": "#/$defs/u64" },
                "replayable": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
