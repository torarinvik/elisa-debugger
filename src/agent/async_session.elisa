# Event-loop driven agent transactions. Each poll performs at most one
# nonblocking transport operation and retains partial frame progress.

include "./session.elisa"

module DebuggerAgentAsyncSession:
    private:
        const module AsyncFrame:
            CAPACITY: usize = 32
            BYTE_COUNT: usize = 32
            FIRST_BYTE: usize = 0
            EMPTY_LENGTH: usize = 0
            OFFSET_INCREMENT: usize = 1

        const module Deadline:
            NONE: u64 = 0

        const module AsyncProtocol:
            CONTROL_ACKNOWLEDGEMENT_MINOR: u32 = 4

        def operation_result(status: AsyncStatus, detail: DebuggerAgentSession::SessionStatus, transport_status: DebuggerLocalAgentTransport::TransportStatus, wire_status: DebuggerAgentWire::WireStatus) -> AsyncResult:
            return AsyncResult{status: status, detail: detail, transport_status: transport_status, wire_status: wire_status}

        def ready_result(status: AsyncStatus) -> AsyncResult:
            return operation_result(status, DebuggerAgentSession::SessionStatus.Ready, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready)

        def prepare_request(session: mutable AsyncSession&, bytes: u8&, length: usize, operation: AsyncOperation, deadline_ns: u64) -> AsyncResult:
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.InvalidTransferLength, DebuggerLocalAgentTransport::TransportStatus.InvalidArgument, DebuggerAgentWire::WireStatus.Ready) if length != AsyncFrame::BYTE_COUNT
            for index in AsyncFrame::FIRST_BYTE..<AsyncFrame::BYTE_COUNT:
                session.transmit_bytes[index] <- bytes[index]
            session.transmit_length <- length
            session.transmit_offset <- AsyncFrame::EMPTY_LENGTH
            session.receive_length <- AsyncFrame::EMPTY_LENGTH
            session.operation <- operation
            session.deadline_ns <- deadline_ns
            session.state <- AsyncState.WritingRequest
            return ready_result(AsyncStatus.Accepted)

        def clear_io_progress(session: mutable AsyncSession&) -> void:
            session.transmit_length <- AsyncFrame::EMPTY_LENGTH
            session.transmit_offset <- AsyncFrame::EMPTY_LENGTH
            session.receive_length <- AsyncFrame::EMPTY_LENGTH
            session.deadline_ns <- Deadline::NONE
            session.operation <- AsyncOperation.None
            session.state <- AsyncState.Idle

        def fail_operation(session: mutable AsyncSession&, controller: mutable DebuggerNative::NativeController&, status: AsyncStatus, detail: DebuggerAgentSession::SessionStatus, transport_status: DebuggerLocalAgentTransport::TransportStatus, wire_status: DebuggerAgentWire::WireStatus) -> AsyncResult:
            if session.operation == AsyncOperation.Pause or session.operation == AsyncOperation.Resume:
                controller <- DebuggerNative::native_agent_transport_failed(controller)
            session.state <- AsyncState.Failed
            return operation_result(status, detail, transport_status, wire_status)

        def complete_operation(session: mutable AsyncSession&) -> AsyncResult:
            clear_io_progress(session)
            return ready_result(AsyncStatus.Completed)

        def pending_operation(transport_status: DebuggerLocalAgentTransport::TransportStatus) -> AsyncResult:
            return operation_result(AsyncStatus.Pending, DebuggerAgentSession::SessionStatus.Ready, transport_status, DebuggerAgentWire::WireStatus.Ready)

        def decode_received_frame(session: mutable AsyncSession&, controller: mutable DebuggerNative::NativeController&) -> AsyncResult:
            if session.operation == AsyncOperation.Handshake:
                response: DebuggerAgentWire::DecodedAgentHello = DebuggerAgentWire::agent_hello_response_decode(session.receive_bytes[AsyncFrame::FIRST_BYTE], session.receive_length)
                return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.WireRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, response.status) if response.status != DebuggerAgentWire::WireStatus.Ready
                negotiated: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(session.local_hello, response.hello, session.required_capabilities)
                return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.NegotiationRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if negotiated.status != DebuggerAgentHandshake::HandshakeStatus.Ready
                session.negotiated <- negotiated
                session.handshake_complete <- true
                return complete_operation(session)

            if session.state == AsyncState.ReadingStopAcknowledgement:
                acknowledgement: DebuggerAgentWire::DecodedStopAcknowledgement = DebuggerAgentWire::stop_acknowledgement_decode(session.receive_bytes[AsyncFrame::FIRST_BYTE], session.receive_length)
                return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.WireRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, acknowledgement.status) if acknowledgement.status != DebuggerAgentWire::WireStatus.Ready
                controller <- DebuggerNative::native_acknowledge_pause(controller, acknowledgement.acknowledgement)
                return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if controller.status != DebuggerNative::NativeStopStatus.Stopped
                return complete_operation(session)

            acknowledgement: DebuggerAgentWire::DecodedAgentControlAcknowledgement = DebuggerAgentWire::agent_control_acknowledgement_decode(session.receive_bytes[AsyncFrame::FIRST_BYTE], session.receive_length)
            return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.WireRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, acknowledgement.status) if acknowledgement.status != DebuggerAgentWire::WireStatus.Ready
            expected_kind: mutable DebuggerAgentWire::AgentControlKind = DebuggerAgentWire::AgentControlKind.StopRequest
            expected_kind <- DebuggerAgentWire::AgentControlKind.ResumeRequest if session.operation == AsyncOperation.Resume
            return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.ResponseMismatch, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if acknowledgement.acknowledgement.request_kind != expected_kind or acknowledgement.acknowledgement.generation != session.request_generation
            return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.AgentRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if acknowledgement.acknowledgement.result != DebuggerAgentWire::AgentControlResult.Applied
            if session.operation == AsyncOperation.Pause:
                session.state <- AsyncState.ReadingStopAcknowledgement
                session.receive_length <- AsyncFrame::EMPTY_LENGTH
                return ready_result(AsyncStatus.Pending)

            controller <- DebuggerNative::native_resume(controller)
            return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if controller.status != DebuggerNative::NativeStopStatus.Attached
            return complete_operation(session)

        def control_capability_is_ready(negotiated: DebuggerAgentHandshake::NegotiatedProtocol&) -> bool:
            return false if negotiated.status != DebuggerAgentHandshake::HandshakeStatus.Ready
            required: u64 = DebuggerAgentHandshake::Capability::STOP_CONTROL
            return (negotiated.capabilities & required) == required

    public:
        enum AsyncState:
            Idle
            WritingRequest
            ReadingResponse
            ReadingStopAcknowledgement
            Failed

        enum AsyncOperation:
            None
            Handshake
            Pause
            Resume

        enum AsyncInterest:
            NoInterest
            Readable
            Writable

        enum AsyncStatus:
            Accepted
            Pending
            Completed
            Failed
            TimedOut
            Cancelled
            Rejected

        struct AsyncResult:
            status: mutable AsyncStatus
            detail: mutable DebuggerAgentSession::SessionStatus
            transport_status: mutable DebuggerLocalAgentTransport::TransportStatus
            wire_status: mutable DebuggerAgentWire::WireStatus

        struct AsyncSession:
            state: mutable AsyncState
            operation: mutable AsyncOperation
            transmit_bytes: mutable u8[AsyncFrame::CAPACITY]
            transmit_length: mutable usize
            transmit_offset: mutable usize
            receive_bytes: mutable u8[AsyncFrame::CAPACITY]
            receive_length: mutable usize
            deadline_ns: mutable u64
            local_hello: mutable DebuggerAgentWire::AgentHello
            required_capabilities: mutable u64
            negotiated: mutable DebuggerAgentHandshake::NegotiatedProtocol
            handshake_complete: mutable bool
            request_generation: mutable u64

        def async_session_initialize(session: mutable AsyncSession&) -> void:
            session <- zeroed
            session.state <- AsyncState.Idle
            session.operation <- AsyncOperation.None
            session.transmit_length <- AsyncFrame::EMPTY_LENGTH
            session.transmit_offset <- AsyncFrame::EMPTY_LENGTH
            session.receive_length <- AsyncFrame::EMPTY_LENGTH
            session.deadline_ns <- Deadline::NONE
            session.negotiated.status <- DebuggerAgentHandshake::HandshakeStatus.InvalidProtocolMajor

        def async_session_is_exact(session: AsyncSession&) -> bool:
            return false if session.transmit_length > AsyncFrame::BYTE_COUNT or session.transmit_offset > session.transmit_length or session.receive_length > AsyncFrame::BYTE_COUNT
            return false if session.handshake_complete != (session.negotiated.status == DebuggerAgentHandshake::HandshakeStatus.Ready)
            if session.state == AsyncState.Idle:
                return session.operation == AsyncOperation.None and session.transmit_length == AsyncFrame::EMPTY_LENGTH and session.transmit_offset == AsyncFrame::EMPTY_LENGTH and session.receive_length == AsyncFrame::EMPTY_LENGTH and session.deadline_ns == Deadline::NONE
            return false if session.state == AsyncState.Failed
            return false if session.operation == AsyncOperation.None or session.deadline_ns == Deadline::NONE
            return false if session.state == AsyncState.WritingRequest and (session.transmit_length != AsyncFrame::BYTE_COUNT or session.transmit_offset >= session.transmit_length)
            return false if session.state != AsyncState.WritingRequest and session.transmit_offset != session.transmit_length
            return false if session.state == AsyncState.ReadingStopAcknowledgement and session.operation != AsyncOperation.Pause
            return true

        # Start negotiation without reading or writing the socket. `deadline_ns`
        # is an absolute monotonic-clock deadline supplied by the adapter.
        def async_handshake_begin(session: mutable AsyncSession&, local_hello: DebuggerAgentWire::AgentHello, required_capabilities: u64, now_ns: u64, deadline_ns: u64) -> AsyncResult:
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if not async_session_is_exact(session) or session.state != AsyncState.Idle or session.handshake_complete
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if deadline_ns <= now_ns
            encoded: DebuggerAgentWire::EncodedAgentHello = DebuggerAgentWire::agent_hello_request_encode(local_hello)
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.WireRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, encoded.status) if encoded.status != DebuggerAgentWire::WireStatus.Ready
            session.local_hello <- local_hello
            session.required_capabilities <- required_capabilities
            return prepare_request(session, encoded.bytes[AsyncFrame::FIRST_BYTE], encoded.length, AsyncOperation.Handshake, deadline_ns)

        def async_pause_begin(session: mutable AsyncSession&, controller: mutable DebuggerNative::NativeController&, now_ns: u64, deadline_ns: u64) -> AsyncResult:
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if not async_session_is_exact(session) or session.state != AsyncState.Idle or not session.handshake_complete
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.UnsupportedControlProtocol, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if session.negotiated.protocol_minor < AsyncProtocol::CONTROL_ACKNOWLEDGEMENT_MINOR
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.MissingStopControlCapability, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if not control_capability_is_ready(session.negotiated)
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if controller.agent.protocol_major != session.negotiated.protocol_major or deadline_ns <= now_ns
            controller <- DebuggerNative::native_pause(controller)
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if controller.status != DebuggerNative::NativeStopStatus.Pausing
            request: DebuggerAgentWire::AgentControlRequest = DebuggerAgentWire::AgentControlRequest{kind: DebuggerAgentWire::AgentControlKind.StopRequest, generation: DebuggerNative::native_pending_stop_generation(controller)}
            encoded: DebuggerAgentWire::EncodedAgentControlRequest = DebuggerAgentWire::agent_control_request_encode(request)
            if encoded.status != DebuggerAgentWire::WireStatus.Ready:
                controller <- DebuggerNative::native_agent_transport_failed(controller)
                return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.WireRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, encoded.status)
            session.request_generation <- request.generation
            prepared: AsyncResult = prepare_request(session, encoded.bytes[AsyncFrame::FIRST_BYTE], encoded.length, AsyncOperation.Pause, deadline_ns)
            if prepared.status != AsyncStatus.Accepted:
                controller <- DebuggerNative::native_agent_transport_failed(controller)
            return prepared

        def async_resume_begin(session: mutable AsyncSession&, controller: mutable DebuggerNative::NativeController&, now_ns: u64, deadline_ns: u64) -> AsyncResult:
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if not async_session_is_exact(session) or session.state != AsyncState.Idle or not session.handshake_complete
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.UnsupportedControlProtocol, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if session.negotiated.protocol_minor < AsyncProtocol::CONTROL_ACKNOWLEDGEMENT_MINOR
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.MissingStopControlCapability, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if not control_capability_is_ready(session.negotiated)
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if controller.agent.protocol_major != session.negotiated.protocol_major or deadline_ns <= now_ns
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if controller.status != DebuggerNative::NativeStopStatus.Stopped or not DebuggerNative::native_can_inspect(controller)
            request: DebuggerAgentWire::AgentControlRequest = DebuggerAgentWire::AgentControlRequest{kind: DebuggerAgentWire::AgentControlKind.ResumeRequest, generation: DebuggerNative::native_pending_stop_generation(controller)}
            encoded: DebuggerAgentWire::EncodedAgentControlRequest = DebuggerAgentWire::agent_control_request_encode(request)
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.WireRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, encoded.status) if encoded.status != DebuggerAgentWire::WireStatus.Ready
            session.request_generation <- request.generation
            return prepare_request(session, encoded.bytes[AsyncFrame::FIRST_BYTE], encoded.length, AsyncOperation.Resume, deadline_ns)

        # Call after the host event loop signals channel readiness. This step
        # performs no blocking I/O and preserves partial stream-frame progress.
        def async_session_poll(session: mutable AsyncSession&, transport: mutable DebuggerLocalAgentTransport::LocalAgentSession&, controller: mutable DebuggerNative::NativeController&, now_ns: u64) -> AsyncResult can[Unsafe.PointerCast]:
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.InvalidState, DebuggerAgentWire::WireStatus.Ready) if not async_session_is_exact(session) or session.state == AsyncState.Idle or session.state == AsyncState.Failed
            if now_ns >= session.deadline_ns:
                return fail_operation(session, controller, AsyncStatus.TimedOut, DebuggerAgentSession::SessionStatus.TransportRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready)

            if session.state == AsyncState.WritingRequest:
                remaining: usize = session.transmit_length - session.transmit_offset
                transfer: DebuggerLocalAgentTransport::TransferResult = DebuggerLocalAgentTransport::local_agent_channel_try_send(transport, session.transmit_bytes[session.transmit_offset], remaining) can Unsafe.PointerCast
                if transfer.status == DebuggerLocalAgentTransport::TransportStatus.WouldBlock or transfer.status == DebuggerLocalAgentTransport::TransportStatus.Interrupted:
                    return pending_operation(transfer.status)
                return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.TransportRejected, transfer.status, DebuggerAgentWire::WireStatus.Ready) if transfer.status != DebuggerLocalAgentTransport::TransportStatus.Ready or transfer.bytes_transferred == AsyncFrame::EMPTY_LENGTH
                session.transmit_offset <- session.transmit_offset + transfer.bytes_transferred
                return pending_operation(DebuggerLocalAgentTransport::TransportStatus.Ready) if session.transmit_offset < session.transmit_length
                session.state <- AsyncState.ReadingResponse
                return pending_operation(DebuggerLocalAgentTransport::TransportStatus.Ready)

            return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.InvalidTransferLength, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready) if session.receive_length >= AsyncFrame::BYTE_COUNT
            receive_capacity: usize = AsyncFrame::BYTE_COUNT - session.receive_length
            received: DebuggerLocalAgentTransport::TransferResult = DebuggerLocalAgentTransport::local_agent_channel_try_receive(transport, session.receive_bytes[session.receive_length], receive_capacity) can Unsafe.PointerCast
            if received.status == DebuggerLocalAgentTransport::TransportStatus.WouldBlock or received.status == DebuggerLocalAgentTransport::TransportStatus.Interrupted:
                return pending_operation(received.status)
            return fail_operation(session, controller, AsyncStatus.Failed, DebuggerAgentSession::SessionStatus.TransportRejected, received.status, DebuggerAgentWire::WireStatus.Ready) if received.status != DebuggerLocalAgentTransport::TransportStatus.Ready or received.bytes_transferred == AsyncFrame::EMPTY_LENGTH
            session.receive_length <- session.receive_length + received.bytes_transferred
            return pending_operation(DebuggerLocalAgentTransport::TransportStatus.Ready) if session.receive_length < AsyncFrame::BYTE_COUNT
            return decode_received_frame(session, controller)

        # Cancellation is terminal for an in-flight command because the target
        # may already have received some bytes. Mark command operations failed
        # closed; handshake cancellation leaves native controller state alone.
        def async_session_cancel(session: mutable AsyncSession&, controller: mutable DebuggerNative::NativeController&) -> AsyncResult:
            return operation_result(AsyncStatus.Rejected, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.InvalidState, DebuggerAgentWire::WireStatus.Ready) if not async_session_is_exact(session) or session.state == AsyncState.Idle or session.state == AsyncState.Failed
            return fail_operation(session, controller, AsyncStatus.Cancelled, DebuggerAgentSession::SessionStatus.ControllerRejected, DebuggerLocalAgentTransport::TransportStatus.Ready, DebuggerAgentWire::WireStatus.Ready)

        def async_session_is_ready(session: AsyncSession&) -> bool:
            return session.state == AsyncState.Idle and session.handshake_complete and session.negotiated.status == DebuggerAgentHandshake::HandshakeStatus.Ready

        # Stable readiness hint for host event loops. The transport descriptor
        # remains owned by LocalAgentSession; this reports which edge to watch.
        def async_session_interest(session: AsyncSession&) -> AsyncInterest:
            return AsyncInterest.Writable if session.state == AsyncState.WritingRequest
            return AsyncInterest.Readable if session.state == AsyncState.ReadingResponse or session.state == AsyncState.ReadingStopAcknowledgement
            return AsyncInterest.NoInterest
