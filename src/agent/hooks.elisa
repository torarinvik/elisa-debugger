# Target-agent records safe-point and fault handoff state without importing the
# debugger UI or protocol implementation.

module DebuggerAgent:
    private:
        const module Agent:
            AGENT_HOOKS_EVENT_CAPACITY: usize = 256
            AGENT_HOOKS_EVENT_KIND_MAX: u16 = 5

        const module Generation:
            FIRST_STOP_GENERATION: u64 = 1
            STOP_GENERATION_INCREMENT: u64 = 1
            MAX_STOP_GENERATION: u64 = 18446744073709551615

        const module Sentinel:
            NO_STOP_GENERATION: u64 = 0

        const module Index:
            FIRST_EVENT_INDEX: usize = 0

        const module Count:
            EMPTY_EVENT_COUNT: usize = 0
            EVENT_COUNT_INCREMENT: usize = 1

    public:
        enum AgentEventKind:
            SafePoint
            Mutation
            Effect
            Fault
            ThreadStart
            ThreadExit

        struct AgentEvent:
            kind: mutable AgentEventKind
            ordinal: mutable u64
            payload_hash: mutable u64

        # Keep the acknowledged generation in a compact message record. The
        # native ABI passes this reliably alongside the large fixed event
        # buffer and adapters can serialize the same value as a stop reply.
        struct AgentStopAcknowledgement:
            generation: mutable u64
            event_count: mutable u64

        struct AgentBuffer:
            events: mutable AgentEvent[Agent::AGENT_HOOKS_EVENT_CAPACITY]
            count: mutable usize
            stopped: mutable bool
            stop_requested: mutable bool
            stop_acknowledged: mutable bool
            overflowed: mutable bool
            stop_generation: mutable u64
            acknowledged_generation: mutable u64

        def agent_buffer_new() -> AgentBuffer:
            buffer: mutable AgentBuffer = zeroed
            buffer.count <- Count::EMPTY_EVENT_COUNT
            buffer.stopped <- false
            buffer.stop_requested <- false
            buffer.stop_acknowledged <- false
            buffer.overflowed <- false
            buffer.stop_generation <- Sentinel::NO_STOP_GENERATION
            buffer.acknowledged_generation <- Sentinel::NO_STOP_GENERATION
            return buffer

        def agent_publish(buffer: AgentBuffer, event: AgentEvent) -> AgentBuffer:
            updated: mutable AgentBuffer = buffer
            if buffer.stopped or buffer.stop_acknowledged or buffer.count >= Agent::AGENT_HOOKS_EVENT_CAPACITY or event.kind.u16() > Agent::AGENT_HOOKS_EVENT_KIND_MAX or event.ordinal != buffer.count.u64():
                updated.overflowed <- true
                return updated
            updated.events[buffer.count] <- event
            updated.count <- buffer.count + Count::EVENT_COUNT_INCREMENT
            return updated

        def agent_request_stop(buffer: AgentBuffer) -> AgentBuffer:
            updated: mutable AgentBuffer = buffer
            updated.stopped <- true
            updated.stop_requested <- false
            updated.stop_acknowledged <- false
            updated.acknowledged_generation <- Sentinel::NO_STOP_GENERATION
            if buffer.stop_generation == Generation::MAX_STOP_GENERATION:
                updated.overflowed <- true
                return updated
            if buffer.stop_generation == Sentinel::NO_STOP_GENERATION:
                updated.stop_generation <- Generation::FIRST_STOP_GENERATION
            else:
                updated.stop_generation <- buffer.stop_generation + Generation::STOP_GENERATION_INCREMENT
            return updated

        # Protocol-driven stop requests carry their generation from the
        # controller. Reject stale or overlapping requests without changing
        # the agent state; the dispatcher can then report the cause precisely.
        def agent_request_stop_generation(buffer: AgentBuffer, generation: u64) -> AgentBuffer:
            return buffer if generation == Sentinel::NO_STOP_GENERATION or generation <= buffer.stop_generation
            return buffer if buffer.stopped or buffer.stop_requested or not agent_is_exact(buffer)
            updated: mutable AgentBuffer = buffer
            updated.stop_requested <- true
            updated.stop_acknowledged <- false
            updated.acknowledged_generation <- Sentinel::NO_STOP_GENERATION
            updated.stop_generation <- generation
            return updated

        # Instrumented target code calls this only after reaching a declared
        # safe point. Receiving a stop command alone does not freeze execution.
        def agent_safe_point_reached(buffer: AgentBuffer) -> AgentBuffer:
            return buffer if not buffer.stop_requested or buffer.overflowed or not agent_is_exact(buffer)
            updated: mutable AgentBuffer = buffer
            updated.stop_requested <- false
            updated.stopped <- true
            return updated

        # The generation is captured with the stop request and must travel with
        # the asynchronous acknowledgement. A stale or unsolicited reply makes
        # the agent state unsafe to inspect or resume.
        def agent_acknowledge_stop(buffer: AgentBuffer, acknowledgement: AgentStopAcknowledgement) -> AgentBuffer:
            updated: mutable AgentBuffer = buffer
            if not buffer.stopped:
                updated.overflowed <- true
                return updated
            if acknowledgement.generation == Sentinel::NO_STOP_GENERATION:
                updated.overflowed <- true
                return updated
            if acknowledgement.generation != buffer.stop_generation:
                updated.overflowed <- true
                return updated
            if acknowledgement.event_count != buffer.count.u64():
                updated.overflowed <- true
                return updated
            updated.stop_acknowledged <- true
            updated.acknowledged_generation <- acknowledgement.generation
            return updated

        def agent_resume(buffer: AgentBuffer) -> AgentBuffer:
            updated: mutable AgentBuffer = buffer
            return updated if buffer.stop_requested
            return updated if buffer.stopped and not buffer.stop_acknowledged
            return updated if buffer.stop_acknowledged and not buffer.stopped
            return updated if buffer.overflowed
            updated.stopped <- false
            updated.stop_acknowledged <- false
            updated.acknowledged_generation <- Sentinel::NO_STOP_GENERATION
            return updated

        # A wire resume must name the same acknowledged stop that is active.
        # This protects a newer stop from delayed resume commands.
        def agent_resume_generation(buffer: AgentBuffer, generation: u64) -> AgentBuffer:
            return buffer if generation == Sentinel::NO_STOP_GENERATION
            return buffer if not agent_stop_is_acknowledged(buffer) or generation != buffer.stop_generation
            return buffer if buffer.overflowed or not agent_is_exact(buffer)
            updated: mutable AgentBuffer = buffer
            updated.stopped <- false
            updated.stop_acknowledged <- false
            updated.acknowledged_generation <- Sentinel::NO_STOP_GENERATION
            return updated

        def agent_is_exact(buffer: AgentBuffer&) -> bool:
            return false if buffer.overflowed or buffer.count > Agent::AGENT_HOOKS_EVENT_CAPACITY
            return false if buffer.stop_requested and buffer.stopped
            return false if buffer.stop_acknowledged and not buffer.stopped
            return false if buffer.stop_requested and buffer.stop_generation == Sentinel::NO_STOP_GENERATION
            return false if buffer.stop_requested and buffer.stop_acknowledged
            return false if buffer.stopped and buffer.stop_generation == Sentinel::NO_STOP_GENERATION
            return false if buffer.acknowledged_generation > buffer.stop_generation
            return false if buffer.stop_acknowledged and buffer.acknowledged_generation != buffer.stop_generation
            return false if not buffer.stop_acknowledged and buffer.acknowledged_generation != Sentinel::NO_STOP_GENERATION and not buffer.stopped
            for index in Index::FIRST_EVENT_INDEX..<buffer.count:
                return false if buffer.events[index].ordinal != index.u64() or buffer.events[index].kind.u16() > Agent::AGENT_HOOKS_EVENT_KIND_MAX
            return true

        def agent_stop_is_acknowledged(buffer: AgentBuffer&) -> bool:
            return buffer.stopped and buffer.stop_generation != Sentinel::NO_STOP_GENERATION and buffer.stop_acknowledged and buffer.acknowledged_generation == buffer.stop_generation

        def agent_can_resume(buffer: AgentBuffer&) -> bool:
            return false if buffer.overflowed
            return false if buffer.stop_requested
            return false if buffer.stopped and not buffer.stop_acknowledged
            return true

        def agent_event_count(buffer: AgentBuffer&) -> usize:
            return buffer.count

        def agent_event_capacity() -> usize:
            return Agent::AGENT_HOOKS_EVENT_CAPACITY
