# Versioned, bounded frame-and-local pages for adapter-neutral native inspection.

include "./inspection.elisa"

module DebuggerAgentSnapshotWire:
    private:
        const module SnapshotCapacity:
            MAX_PAYLOAD_BYTES: usize = 4096
            MAX_BINDINGS_PER_PAGE: usize = 16

        const module SnapshotHeader:
            HEADER_LENGTH: usize = 32
            MAGIC_OFFSET: usize = 0
            VERSION_OFFSET: usize = 4
            KIND_OFFSET: usize = 6
            GENERATION_OFFSET: usize = 8
            PAYLOAD_LENGTH_OFFSET: usize = 16
            RESERVED_OFFSET: usize = 20
            CHECKSUM_OFFSET: usize = 24
            PAYLOAD_OFFSET: usize = HEADER_LENGTH

        const module SnapshotCapacityShape:
            MESSAGE_CAPACITY: usize = SnapshotCapacity::MAX_PAYLOAD_BYTES + SnapshotHeader::HEADER_LENGTH

        const module SnapshotMagic:
            FIRST: u8 = 69
            SECOND: u8 = 76
            THIRD: u8 = 83
            FOURTH: u8 = 65
            SECOND_OFFSET: usize = 1
            THIRD_OFFSET: usize = 2
            FOURTH_OFFSET: usize = 3

        const module SnapshotProtocol:
            VERSION: u16 = 1
            FRAME_PAGE_KIND: u16 = SnapshotResponseShape::PAGE_MESSAGE_KIND
            NO_GENERATION: u64 = 0
            ZERO_VALUE: u64 = 0
            ZERO_LENGTH: usize = 0
            EMPTY_RESERVED_WORD: u32 = 0

        const module SnapshotSequence:
            FIRST: usize = 0

        const module SnapshotChecksum:
            OFFSET_BASIS: u64 = 14695981039346656037
            PRIME: u64 = 1099511628211

        const module SnapshotByteEncoding:
            BITS_PER_BYTE: u64 = 8
            BYTE_MASK: u64 = 255
            U16_WIDTH: usize = 2
            U32_WIDTH: usize = 4
            U64_WIDTH: usize = 8

        const module SnapshotRequestShape:
            MESSAGE_KIND: u16 = 2
            U64_FIELD_COUNT: usize = 1
            U32_FIELD_COUNT: usize = 4
            PAYLOAD_LENGTH: usize = U64_FIELD_COUNT * SnapshotByteEncoding::U64_WIDTH + U32_FIELD_COUNT * SnapshotByteEncoding::U32_WIDTH
            MESSAGE_LENGTH: usize = SnapshotHeader::HEADER_LENGTH + PAYLOAD_LENGTH

        const module SnapshotResponseShape:
            PAGE_MESSAGE_KIND: u16 = 1
            ERROR_MESSAGE_KIND: u16 = 3

        const module SnapshotErrorPayload:
            LENGTH: usize = SnapshotByteEncoding::U32_WIDTH
            STATUS_OFFSET: usize = SnapshotHeader::PAYLOAD_OFFSET

        const module SnapshotErrorCode:
            SNAPSHOT_UNAVAILABLE: u32 = 1
            INVALID_PAGE: u32 = 2
            RESOURCE_LIMIT: u32 = 3
            THREAD_MISMATCH: u32 = 4
            INVALID_DESCRIPTOR: u32 = 5
            STALE_GENERATION: u32 = 6

        const module SnapshotPayloadShape:
            U64_FIELD_COUNT: usize = 7
            U32_FIELD_COUNT: usize = 5
            FRAME_HEADER_LENGTH: usize = U64_FIELD_COUNT * SnapshotByteEncoding::U64_WIDTH + U32_FIELD_COUNT * SnapshotByteEncoding::U32_WIDTH

        const module SnapshotDescriptorShape:
            ID_FIELD_COUNT: usize = 3
            TAG_FIELD_COUNT: usize = 4
            U64_FIELD_COUNT: usize = 2
            U32_FIELD_COUNT: usize = 1
            PREFIX_LENGTH: usize = ID_FIELD_COUNT * SnapshotByteEncoding::U64_WIDTH + TAG_FIELD_COUNT * SnapshotByteEncoding::U16_WIDTH + U64_FIELD_COUNT * SnapshotByteEncoding::U64_WIDTH + U32_FIELD_COUNT * SnapshotByteEncoding::U32_WIDTH

        const module SnapshotEnumBounds:
            MAX_VALUE_KIND: u16 = 8
            MAX_VALUE_STATE: u16 = 5
            MAX_STORAGE_KIND: u16 = 4

        const module SnapshotEnumInvalid:
            CODE: u16 = 65535

        const module SnapshotEnumCode:
            VALUE_VOID: u16 = 0
            VALUE_SIGNED: u16 = 1
            VALUE_UNSIGNED: u16 = 2
            VALUE_FLOATING: u16 = 3
            VALUE_BOOLEAN: u16 = 4
            VALUE_TEXT: u16 = 5
            VALUE_AGGREGATE: u16 = 6
            VALUE_REFERENCE: u16 = 7
            VALUE_OPAQUE: u16 = 8
            STATE_AVAILABLE: u16 = 0
            STATE_UNAVAILABLE: u16 = 1
            STATE_OPTIMIZED_AWAY: u16 = 2
            STATE_UNINITIALIZED: u16 = 3
            STATE_REDACTED: u16 = 4
            STATE_INVALID: u16 = 5
            STORAGE_REGISTER: u16 = 0
            STORAGE_STACK_SLOT: u16 = 1
            STORAGE_CONSTANT: u16 = 2
            STORAGE_RUNTIME_SLOT: u16 = 3
            STORAGE_UNKNOWN: u16 = 4

        const module SnapshotIdentifier:
            NO_ID: u64 = 0

        def write_u16(bytes: mutable u8&, offset: usize, value: u16) -> void:
            for index in SnapshotSequence::FIRST..<SnapshotByteEncoding::U16_WIDTH:
                bytes[offset + index] <- ((value.u64() >> (SnapshotByteEncoding::BITS_PER_BYTE * index.u64())) & SnapshotByteEncoding::BYTE_MASK).u8()

        def write_u32(bytes: mutable u8&, offset: usize, value: u32) -> void:
            for index in SnapshotSequence::FIRST..<SnapshotByteEncoding::U32_WIDTH:
                bytes[offset + index] <- ((value.u64() >> (SnapshotByteEncoding::BITS_PER_BYTE * index.u64())) & SnapshotByteEncoding::BYTE_MASK).u8()

        def write_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
            for index in SnapshotSequence::FIRST..<SnapshotByteEncoding::U64_WIDTH:
                bytes[offset + index] <- ((value >> (SnapshotByteEncoding::BITS_PER_BYTE * index.u64())) & SnapshotByteEncoding::BYTE_MASK).u8()

        def read_u16(bytes: u8&, offset: usize) -> u16:
            low: u64 = bytes[offset].u64()
            high: u64 = bytes[offset + SnapshotMagic::SECOND_OFFSET].u64()
            return (low | (high << SnapshotByteEncoding::BITS_PER_BYTE)).u16()

        def read_u32(bytes: u8&, offset: usize) -> u32:
            value: mutable u64 = SnapshotProtocol::ZERO_VALUE
            for index in SnapshotSequence::FIRST..<SnapshotByteEncoding::U32_WIDTH:
                value <- value | (bytes[offset + index].u64() << (SnapshotByteEncoding::BITS_PER_BYTE * index.u64()))
            return value.u32()

        def read_u64(bytes: u8&, offset: usize) -> u64:
            value: mutable u64 = SnapshotProtocol::ZERO_VALUE
            for index in SnapshotSequence::FIRST..<SnapshotByteEncoding::U64_WIDTH:
                value <- value | (bytes[offset + index].u64() << (SnapshotByteEncoding::BITS_PER_BYTE * index.u64()))
            return value

        def page_checksum(bytes: u8&, message_length: usize) -> u64:
            checksum: mutable u64 = SnapshotChecksum::OFFSET_BASIS
            for index in SnapshotSequence::FIRST..<SnapshotHeader::CHECKSUM_OFFSET:
                checksum <- (checksum ^ bytes[index].u64()) * SnapshotChecksum::PRIME
            for index in SnapshotHeader::PAYLOAD_OFFSET..<message_length:
                checksum <- (checksum ^ bytes[index].u64()) * SnapshotChecksum::PRIME
            return checksum

        def request_header_status(bytes: u8&, length: usize) -> SnapshotWireStatus:
            return SnapshotWireStatus.Truncated if length < SnapshotRequestShape::MESSAGE_LENGTH
            return SnapshotWireStatus.InvalidLength if length > SnapshotRequestShape::MESSAGE_LENGTH
            return SnapshotWireStatus.InvalidMagic if bytes[SnapshotHeader::MAGIC_OFFSET] != SnapshotMagic::FIRST or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::SECOND_OFFSET] != SnapshotMagic::SECOND or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::THIRD_OFFSET] != SnapshotMagic::THIRD or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::FOURTH_OFFSET] != SnapshotMagic::FOURTH
            return SnapshotWireStatus.UnsupportedVersion if read_u16(bytes, SnapshotHeader::VERSION_OFFSET) != SnapshotProtocol::VERSION
            return SnapshotWireStatus.UnsupportedMessage if read_u16(bytes, SnapshotHeader::KIND_OFFSET) != SnapshotRequestShape::MESSAGE_KIND
            return SnapshotWireStatus.InvalidGeneration if read_u64(bytes, SnapshotHeader::GENERATION_OFFSET) == SnapshotProtocol::NO_GENERATION
            return SnapshotWireStatus.InvalidLength if read_u32(bytes, SnapshotHeader::PAYLOAD_LENGTH_OFFSET).usize() != SnapshotRequestShape::PAYLOAD_LENGTH
            return SnapshotWireStatus.InvalidReservedWord if read_u32(bytes, SnapshotHeader::RESERVED_OFFSET) != SnapshotProtocol::EMPTY_RESERVED_WORD
            return SnapshotWireStatus.ChecksumMismatch if read_u64(bytes, SnapshotHeader::CHECKSUM_OFFSET) != page_checksum(bytes, length)
            return SnapshotWireStatus.Ready

        def decode_value_kind(code: u16) -> DebuggerAgentFrames::AgentValueKind:
            kind: mutable DebuggerAgentFrames::AgentValueKind = DebuggerAgentFrames::AgentValueKind.Void
            kind <- DebuggerAgentFrames::AgentValueKind.Signed if code == SnapshotEnumCode::VALUE_SIGNED
            kind <- DebuggerAgentFrames::AgentValueKind.Unsigned if code == SnapshotEnumCode::VALUE_UNSIGNED
            kind <- DebuggerAgentFrames::AgentValueKind.Floating if code == SnapshotEnumCode::VALUE_FLOATING
            kind <- DebuggerAgentFrames::AgentValueKind.Boolean if code == SnapshotEnumCode::VALUE_BOOLEAN
            kind <- DebuggerAgentFrames::AgentValueKind.Text if code == SnapshotEnumCode::VALUE_TEXT
            kind <- DebuggerAgentFrames::AgentValueKind.Aggregate if code == SnapshotEnumCode::VALUE_AGGREGATE
            kind <- DebuggerAgentFrames::AgentValueKind.Reference if code == SnapshotEnumCode::VALUE_REFERENCE
            kind <- DebuggerAgentFrames::AgentValueKind.Opaque if code == SnapshotEnumCode::VALUE_OPAQUE
            return kind

        def decode_value_state(code: u16) -> DebuggerAgentFrames::AgentValueState:
            state: mutable DebuggerAgentFrames::AgentValueState = DebuggerAgentFrames::AgentValueState.Available
            state <- DebuggerAgentFrames::AgentValueState.Unavailable if code == SnapshotEnumCode::STATE_UNAVAILABLE
            state <- DebuggerAgentFrames::AgentValueState.OptimizedAway if code == SnapshotEnumCode::STATE_OPTIMIZED_AWAY
            state <- DebuggerAgentFrames::AgentValueState.Uninitialized if code == SnapshotEnumCode::STATE_UNINITIALIZED
            state <- DebuggerAgentFrames::AgentValueState.Redacted if code == SnapshotEnumCode::STATE_REDACTED
            state <- DebuggerAgentFrames::AgentValueState.Invalid if code == SnapshotEnumCode::STATE_INVALID
            return state

        def decode_storage_kind(code: u16) -> DebuggerAgentFrames::AgentStorageKind:
            kind: mutable DebuggerAgentFrames::AgentStorageKind = DebuggerAgentFrames::AgentStorageKind.Register
            kind <- DebuggerAgentFrames::AgentStorageKind.StackSlot if code == SnapshotEnumCode::STORAGE_STACK_SLOT
            kind <- DebuggerAgentFrames::AgentStorageKind.Constant if code == SnapshotEnumCode::STORAGE_CONSTANT
            kind <- DebuggerAgentFrames::AgentStorageKind.RuntimeSlot if code == SnapshotEnumCode::STORAGE_RUNTIME_SLOT
            kind <- DebuggerAgentFrames::AgentStorageKind.Unknown if code == SnapshotEnumCode::STORAGE_UNKNOWN
            return kind

        def inspection_failure_status(status: DebuggerAgentFrames::ShadowStatus) -> SnapshotWireStatus:
            return SnapshotWireStatus.StaleGeneration if status == DebuggerAgentFrames::ShadowStatus.StaleGeneration or status == DebuggerAgentFrames::ShadowStatus.GenerationMismatch
            return SnapshotWireStatus.SnapshotUnavailable

        def encode_value_kind(kind: DebuggerAgentFrames::AgentValueKind) -> u16:
            return SnapshotEnumCode::VALUE_SIGNED if kind == DebuggerAgentFrames::AgentValueKind.Signed
            return SnapshotEnumCode::VALUE_UNSIGNED if kind == DebuggerAgentFrames::AgentValueKind.Unsigned
            return SnapshotEnumCode::VALUE_FLOATING if kind == DebuggerAgentFrames::AgentValueKind.Floating
            return SnapshotEnumCode::VALUE_BOOLEAN if kind == DebuggerAgentFrames::AgentValueKind.Boolean
            return SnapshotEnumCode::VALUE_TEXT if kind == DebuggerAgentFrames::AgentValueKind.Text
            return SnapshotEnumCode::VALUE_AGGREGATE if kind == DebuggerAgentFrames::AgentValueKind.Aggregate
            return SnapshotEnumCode::VALUE_REFERENCE if kind == DebuggerAgentFrames::AgentValueKind.Reference
            return SnapshotEnumCode::VALUE_OPAQUE if kind == DebuggerAgentFrames::AgentValueKind.Opaque
            return SnapshotEnumCode::VALUE_VOID if kind == DebuggerAgentFrames::AgentValueKind.Void
            return SnapshotEnumInvalid::CODE

        def encode_value_state(state: DebuggerAgentFrames::AgentValueState) -> u16:
            return SnapshotEnumCode::STATE_UNAVAILABLE if state == DebuggerAgentFrames::AgentValueState.Unavailable
            return SnapshotEnumCode::STATE_OPTIMIZED_AWAY if state == DebuggerAgentFrames::AgentValueState.OptimizedAway
            return SnapshotEnumCode::STATE_UNINITIALIZED if state == DebuggerAgentFrames::AgentValueState.Uninitialized
            return SnapshotEnumCode::STATE_REDACTED if state == DebuggerAgentFrames::AgentValueState.Redacted
            return SnapshotEnumCode::STATE_INVALID if state == DebuggerAgentFrames::AgentValueState.Invalid
            return SnapshotEnumCode::STATE_AVAILABLE if state == DebuggerAgentFrames::AgentValueState.Available
            return SnapshotEnumInvalid::CODE

        def encode_storage_kind(kind: DebuggerAgentFrames::AgentStorageKind) -> u16:
            return SnapshotEnumCode::STORAGE_STACK_SLOT if kind == DebuggerAgentFrames::AgentStorageKind.StackSlot
            return SnapshotEnumCode::STORAGE_CONSTANT if kind == DebuggerAgentFrames::AgentStorageKind.Constant
            return SnapshotEnumCode::STORAGE_RUNTIME_SLOT if kind == DebuggerAgentFrames::AgentStorageKind.RuntimeSlot
            return SnapshotEnumCode::STORAGE_UNKNOWN if kind == DebuggerAgentFrames::AgentStorageKind.Unknown
            return SnapshotEnumCode::STORAGE_REGISTER if kind == DebuggerAgentFrames::AgentStorageKind.Register
            return SnapshotEnumInvalid::CODE

        def encode_snapshot_error_code(status: SnapshotWireStatus) -> u32:
            return SnapshotErrorCode::SNAPSHOT_UNAVAILABLE if status == SnapshotWireStatus.SnapshotUnavailable
            return SnapshotErrorCode::INVALID_PAGE if status == SnapshotWireStatus.InvalidPage
            return SnapshotErrorCode::RESOURCE_LIMIT if status == SnapshotWireStatus.ResourceLimit
            return SnapshotErrorCode::THREAD_MISMATCH if status == SnapshotWireStatus.ThreadMismatch
            return SnapshotErrorCode::INVALID_DESCRIPTOR if status == SnapshotWireStatus.InvalidDescriptor
            return SnapshotErrorCode::STALE_GENERATION if status == SnapshotWireStatus.StaleGeneration
            return SnapshotProtocol::EMPTY_RESERVED_WORD

        def decode_snapshot_error_code(code: u32) -> SnapshotWireStatus:
            return SnapshotWireStatus.SnapshotUnavailable if code == SnapshotErrorCode::SNAPSHOT_UNAVAILABLE
            return SnapshotWireStatus.InvalidPage if code == SnapshotErrorCode::INVALID_PAGE
            return SnapshotWireStatus.ResourceLimit if code == SnapshotErrorCode::RESOURCE_LIMIT
            return SnapshotWireStatus.ThreadMismatch if code == SnapshotErrorCode::THREAD_MISMATCH
            return SnapshotWireStatus.InvalidDescriptor if code == SnapshotErrorCode::INVALID_DESCRIPTOR
            return SnapshotWireStatus.StaleGeneration if code == SnapshotErrorCode::STALE_GENERATION
            return SnapshotWireStatus.InvalidPayload

        def snapshot_error_response_decode(bytes: u8&, length: usize) -> SnapshotWireStatus:
            return SnapshotWireStatus.Truncated if length < SnapshotHeader::HEADER_LENGTH
            return SnapshotWireStatus.InvalidLength if length != SnapshotHeader::HEADER_LENGTH + SnapshotErrorPayload::LENGTH
            return SnapshotWireStatus.InvalidMagic if bytes[SnapshotHeader::MAGIC_OFFSET] != SnapshotMagic::FIRST or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::SECOND_OFFSET] != SnapshotMagic::SECOND or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::THIRD_OFFSET] != SnapshotMagic::THIRD or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::FOURTH_OFFSET] != SnapshotMagic::FOURTH
            return SnapshotWireStatus.UnsupportedVersion if read_u16(bytes, SnapshotHeader::VERSION_OFFSET) != SnapshotProtocol::VERSION
            return SnapshotWireStatus.UnsupportedMessage if read_u16(bytes, SnapshotHeader::KIND_OFFSET) != SnapshotResponseShape::ERROR_MESSAGE_KIND
            return SnapshotWireStatus.InvalidGeneration if read_u64(bytes, SnapshotHeader::GENERATION_OFFSET) == SnapshotProtocol::NO_GENERATION
            return SnapshotWireStatus.InvalidLength if read_u32(bytes, SnapshotHeader::PAYLOAD_LENGTH_OFFSET).usize() != SnapshotErrorPayload::LENGTH
            return SnapshotWireStatus.InvalidReservedWord if read_u32(bytes, SnapshotHeader::RESERVED_OFFSET) != SnapshotProtocol::EMPTY_RESERVED_WORD
            return SnapshotWireStatus.ChecksumMismatch if read_u64(bytes, SnapshotHeader::CHECKSUM_OFFSET) != page_checksum(bytes, length)
            code: u32 = read_u32(bytes, SnapshotErrorPayload::STATUS_OFFSET)
            return SnapshotWireStatus.InvalidPayload if code == SnapshotProtocol::EMPTY_RESERVED_WORD
            return decode_snapshot_error_code(code)

        def snapshot_error_response_encode(generation: u64, failure_status: SnapshotWireStatus, output: mutable SnapshotWireBuffer&) -> SnapshotWireStatus:
            output.length <- SnapshotProtocol::ZERO_LENGTH
            output.status <- SnapshotWireStatus.InvalidGeneration if generation == SnapshotProtocol::NO_GENERATION
            return output.status if generation == SnapshotProtocol::NO_GENERATION
            error_code: u32 = encode_snapshot_error_code(failure_status)
            output.status <- SnapshotWireStatus.InvalidPayload if error_code == SnapshotProtocol::EMPTY_RESERVED_WORD
            return output.status if error_code == SnapshotProtocol::EMPTY_RESERVED_WORD
            total_length: usize = SnapshotHeader::HEADER_LENGTH + SnapshotErrorPayload::LENGTH
            output.bytes[SnapshotHeader::MAGIC_OFFSET] <- SnapshotMagic::FIRST
            output.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::SECOND_OFFSET] <- SnapshotMagic::SECOND
            output.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::THIRD_OFFSET] <- SnapshotMagic::THIRD
            output.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::FOURTH_OFFSET] <- SnapshotMagic::FOURTH
            write_u16(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::VERSION_OFFSET, SnapshotProtocol::VERSION)
            write_u16(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::KIND_OFFSET, SnapshotResponseShape::ERROR_MESSAGE_KIND)
            write_u64(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::GENERATION_OFFSET, generation)
            write_u32(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::PAYLOAD_LENGTH_OFFSET, SnapshotErrorPayload::LENGTH.u32())
            write_u32(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::RESERVED_OFFSET, SnapshotProtocol::EMPTY_RESERVED_WORD)
            write_u32(output.bytes[SnapshotSequence::FIRST], SnapshotErrorPayload::STATUS_OFFSET, error_code)
            write_u64(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::CHECKSUM_OFFSET, page_checksum(output.bytes[SnapshotSequence::FIRST], total_length))
            output.length <- total_length
            output.status <- SnapshotWireStatus.Ready
            return output.status

    public:
        const module SnapshotBuffer:
            MAX_MESSAGE_BYTES: usize = SnapshotCapacityShape::MESSAGE_CAPACITY
            MAX_REQUEST_BYTES: usize = SnapshotRequestShape::MESSAGE_LENGTH
            MAX_BINDINGS_PER_PAGE: usize = SnapshotCapacity::MAX_BINDINGS_PER_PAGE

        enum SnapshotWireStatus:
            Ready
            SnapshotUnavailable
            InvalidPage
            ResourceLimit
            Truncated
            InvalidLength
            InvalidMagic
            UnsupportedVersion
            UnsupportedMessage
            InvalidGeneration
            GenerationMismatch
            StaleGeneration
            ThreadMismatch
            InvalidReservedWord
            ChecksumMismatch
            InvalidPayload
            InvalidDescriptor

        struct SnapshotWireBuffer:
            bytes: mutable u8[SnapshotCapacityShape::MESSAGE_CAPACITY]
            length: mutable usize
            status: mutable SnapshotWireStatus

        struct DecodedSnapshotPage:
            status: mutable SnapshotWireStatus
            generation: mutable u64
            thread_id: mutable u64
            frame_index: mutable usize
            frame: mutable DebuggerAgentFrames::AgentShadowFrameInfo
            binding_start: mutable usize
            binding_count: mutable usize
            bindings: mutable DebuggerAgentFrames::AgentStorageDescriptor[SnapshotCapacity::MAX_BINDINGS_PER_PAGE]

        struct SnapshotPageRequest:
            generation: mutable u64
            thread_id: mutable u64
            frame_index: mutable usize
            binding_start: mutable usize
            binding_limit: mutable usize

        struct EncodedSnapshotPageRequest:
            bytes: mutable u8[SnapshotRequestShape::MESSAGE_LENGTH]
            length: mutable usize
            status: mutable SnapshotWireStatus

        struct DecodedSnapshotPageRequest:
            request: mutable SnapshotPageRequest
            status: mutable SnapshotWireStatus

        def snapshot_page_capacity() -> usize:
            return SnapshotCapacity::MAX_BINDINGS_PER_PAGE

        def snapshot_page_header_length() -> usize:
            return SnapshotHeader::HEADER_LENGTH

        def snapshot_page_request_length() -> usize:
            return SnapshotRequestShape::MESSAGE_LENGTH

        def snapshot_page_message_capacity() -> usize:
            return SnapshotCapacityShape::MESSAGE_CAPACITY

        def snapshot_error_response_length() -> usize:
            return SnapshotHeader::HEADER_LENGTH + SnapshotErrorPayload::LENGTH

        def snapshot_page_request_capacity() -> usize:
            return SnapshotRequestShape::MESSAGE_LENGTH

        # Validate the fixed response header before allocating or reading its
        # declared payload. The checksum and descriptor body are verified once
        # the remaining bytes arrive.
        def agent_snapshot_page_expected_length(bytes: u8&, header_length: usize, expected_generation: u64, message_length: mutable usize&) -> SnapshotWireStatus:
            message_length <- SnapshotProtocol::ZERO_LENGTH
            return SnapshotWireStatus.Truncated if header_length < SnapshotHeader::HEADER_LENGTH
            return SnapshotWireStatus.InvalidLength if header_length != SnapshotHeader::HEADER_LENGTH
            return SnapshotWireStatus.InvalidMagic if bytes[SnapshotHeader::MAGIC_OFFSET] != SnapshotMagic::FIRST or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::SECOND_OFFSET] != SnapshotMagic::SECOND or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::THIRD_OFFSET] != SnapshotMagic::THIRD or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::FOURTH_OFFSET] != SnapshotMagic::FOURTH
            return SnapshotWireStatus.UnsupportedVersion if read_u16(bytes, SnapshotHeader::VERSION_OFFSET) != SnapshotProtocol::VERSION
            response_kind: u16 = read_u16(bytes, SnapshotHeader::KIND_OFFSET)
            return SnapshotWireStatus.UnsupportedMessage if response_kind != SnapshotResponseShape::PAGE_MESSAGE_KIND and response_kind != SnapshotResponseShape::ERROR_MESSAGE_KIND
            generation: u64 = read_u64(bytes, SnapshotHeader::GENERATION_OFFSET)
            return SnapshotWireStatus.InvalidGeneration if generation == SnapshotProtocol::NO_GENERATION or expected_generation == SnapshotProtocol::NO_GENERATION
            return SnapshotWireStatus.GenerationMismatch if generation != expected_generation
            return SnapshotWireStatus.InvalidReservedWord if read_u32(bytes, SnapshotHeader::RESERVED_OFFSET) != SnapshotProtocol::EMPTY_RESERVED_WORD
            payload_length: usize = read_u32(bytes, SnapshotHeader::PAYLOAD_LENGTH_OFFSET).usize()
            return SnapshotWireStatus.InvalidLength if payload_length > SnapshotCapacity::MAX_PAYLOAD_BYTES
            return SnapshotWireStatus.InvalidLength if response_kind == SnapshotResponseShape::ERROR_MESSAGE_KIND and payload_length != SnapshotErrorPayload::LENGTH
            return SnapshotWireStatus.InvalidLength if response_kind == SnapshotResponseShape::PAGE_MESSAGE_KIND and payload_length < SnapshotPayloadShape::FRAME_HEADER_LENGTH
            message_length <- SnapshotHeader::HEADER_LENGTH + payload_length
            return SnapshotWireStatus.Ready

        # Encode a fixed-size page request with the same envelope and checksum
        # rules as the page response. The target still validates live frame and
        # stop state before exposing any descriptor.
        def agent_snapshot_page_request_encode(request: SnapshotPageRequest) -> EncodedSnapshotPageRequest:
            frame: mutable EncodedSnapshotPageRequest = zeroed
            frame.status <- SnapshotWireStatus.InvalidGeneration if request.generation == SnapshotProtocol::NO_GENERATION
            return frame if frame.status == SnapshotWireStatus.InvalidGeneration
            frame.status <- SnapshotWireStatus.InvalidPage if request.thread_id == SnapshotIdentifier::NO_ID or request.frame_index >= DebuggerAgentFrames::agent_shadow_frame_capacity() or request.binding_start > DebuggerAgentFrames::agent_shadow_binding_capacity() or request.binding_limit == SnapshotProtocol::ZERO_LENGTH or request.binding_limit > SnapshotCapacity::MAX_BINDINGS_PER_PAGE
            return frame if frame.status == SnapshotWireStatus.InvalidPage
            frame.bytes[SnapshotHeader::MAGIC_OFFSET] <- SnapshotMagic::FIRST
            frame.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::SECOND_OFFSET] <- SnapshotMagic::SECOND
            frame.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::THIRD_OFFSET] <- SnapshotMagic::THIRD
            frame.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::FOURTH_OFFSET] <- SnapshotMagic::FOURTH
            write_u16(frame.bytes[SnapshotSequence::FIRST], SnapshotHeader::VERSION_OFFSET, SnapshotProtocol::VERSION)
            write_u16(frame.bytes[SnapshotSequence::FIRST], SnapshotHeader::KIND_OFFSET, SnapshotRequestShape::MESSAGE_KIND)
            write_u64(frame.bytes[SnapshotSequence::FIRST], SnapshotHeader::GENERATION_OFFSET, request.generation)
            write_u32(frame.bytes[SnapshotSequence::FIRST], SnapshotHeader::PAYLOAD_LENGTH_OFFSET, SnapshotRequestShape::PAYLOAD_LENGTH.u32())
            write_u32(frame.bytes[SnapshotSequence::FIRST], SnapshotHeader::RESERVED_OFFSET, SnapshotProtocol::EMPTY_RESERVED_WORD)
            cursor: mutable usize = SnapshotHeader::PAYLOAD_OFFSET
            write_u64(frame.bytes[SnapshotSequence::FIRST], cursor, request.thread_id)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            write_u32(frame.bytes[SnapshotSequence::FIRST], cursor, request.frame_index.u32())
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            write_u32(frame.bytes[SnapshotSequence::FIRST], cursor, request.binding_start.u32())
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            write_u32(frame.bytes[SnapshotSequence::FIRST], cursor, request.binding_limit.u32())
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            write_u32(frame.bytes[SnapshotSequence::FIRST], cursor, SnapshotProtocol::EMPTY_RESERVED_WORD)
            write_u64(frame.bytes[SnapshotSequence::FIRST], SnapshotHeader::CHECKSUM_OFFSET, page_checksum(frame.bytes[SnapshotSequence::FIRST], SnapshotRequestShape::MESSAGE_LENGTH))
            frame.length <- SnapshotRequestShape::MESSAGE_LENGTH
            frame.status <- SnapshotWireStatus.Ready
            return frame

        def agent_snapshot_page_request_decode(bytes: u8&, length: usize) -> DecodedSnapshotPageRequest:
            result: mutable DecodedSnapshotPageRequest = zeroed
            result.status <- request_header_status(bytes, length)
            return result if result.status != SnapshotWireStatus.Ready
            request: mutable SnapshotPageRequest = zeroed
            request.generation <- read_u64(bytes, SnapshotHeader::GENERATION_OFFSET)
            cursor: mutable usize = SnapshotHeader::PAYLOAD_OFFSET
            request.thread_id <- read_u64(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            frame_index_value: u64 = read_u32(bytes, cursor).u64()
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            binding_start: usize = read_u32(bytes, cursor).usize()
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            binding_limit: usize = read_u32(bytes, cursor).usize()
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            reserved_payload: u32 = read_u32(bytes, cursor)
            result.status <- SnapshotWireStatus.InvalidPage if request.thread_id == SnapshotIdentifier::NO_ID or frame_index_value >= DebuggerAgentFrames::agent_shadow_frame_capacity().u64() or binding_start > DebuggerAgentFrames::agent_shadow_binding_capacity() or binding_limit == SnapshotProtocol::ZERO_LENGTH or binding_limit > SnapshotCapacity::MAX_BINDINGS_PER_PAGE or reserved_payload != SnapshotProtocol::EMPTY_RESERVED_WORD
            return result if result.status != SnapshotWireStatus.Ready
            request.frame_index <- frame_index_value.usize()
            request.binding_start <- binding_start
            request.binding_limit <- binding_limit
            result.request <- request
            return result

        # Adapter and target loops can use this one request boundary: decode
        # first, then produce only the rendezvous-authorized response page.
        def agent_snapshot_page_dispatch(bytes: u8&, length: usize, shadow_stack: DebuggerAgentFrames::AgentShadowStack&, registry: DebuggerAgentThreads::AgentThreadRegistry&, output: mutable SnapshotWireBuffer&) -> SnapshotWireStatus:
            output.length <- SnapshotProtocol::ZERO_LENGTH
            request: DecodedSnapshotPageRequest = agent_snapshot_page_request_decode(bytes, length)
            output.status <- request.status
            return output.status if request.status != SnapshotWireStatus.Ready
            failure_status: mutable SnapshotWireStatus = SnapshotWireStatus.ThreadMismatch
            if request.request.thread_id == shadow_stack.thread.value:
                failure_status <- agent_snapshot_frame_page_encode(shadow_stack, registry, request.request.frame_index, request.request.binding_start, request.request.binding_limit, request.request.generation, output)
            if failure_status == SnapshotWireStatus.Ready:
                return failure_status
            error_response_status: SnapshotWireStatus = snapshot_error_response_encode(request.request.generation, failure_status, output)
            return error_response_status if error_response_status != SnapshotWireStatus.Ready
            output.status <- failure_status
            return failure_status

        # Encode one frame header and a caller-selected bounded slice of its
        # bindings. The buffer is caller-owned and only its live prefix changes.
        def agent_snapshot_frame_page_encode(shadow_stack: DebuggerAgentFrames::AgentShadowStack&, registry: DebuggerAgentThreads::AgentThreadRegistry&, frame_index_value: usize, binding_start: usize, binding_limit: usize, generation: u64, output: mutable SnapshotWireBuffer&) -> SnapshotWireStatus:
            output.length <- SnapshotProtocol::ZERO_LENGTH
            output.status <- SnapshotWireStatus.InvalidPage
            if binding_limit == SnapshotProtocol::ZERO_LENGTH or binding_limit > SnapshotCapacity::MAX_BINDINGS_PER_PAGE:
                return output.status
            frame_result: DebuggerAgentFrames::FrameReadResult = DebuggerAgentInspection::agent_inspection_read_frame(shadow_stack, registry, frame_index_value, generation)
            output.status <- inspection_failure_status(frame_result.status)
            return output.status if frame_result.status != DebuggerAgentFrames::ShadowStatus.Ready
            output.status <- SnapshotWireStatus.InvalidPage
            return output.status if binding_start > frame_result.frame.binding_count
            remaining: usize = frame_result.frame.binding_count - binding_start
            page_binding_count: mutable usize = binding_limit
            page_binding_count <- remaining if remaining < binding_limit
            payload_length: mutable usize = SnapshotPayloadShape::FRAME_HEADER_LENGTH
            cursor: mutable usize = SnapshotHeader::PAYLOAD_OFFSET
            write_u64(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::GENERATION_OFFSET, generation)
            write_u32(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::RESERVED_OFFSET, SnapshotProtocol::EMPTY_RESERVED_WORD)
            write_u64(output.bytes[SnapshotSequence::FIRST], cursor, shadow_stack.thread.value)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            write_u64(output.bytes[SnapshotSequence::FIRST], cursor, frame_index_value.u64())
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            write_u64(output.bytes[SnapshotSequence::FIRST], cursor, frame_result.frame.invocation.value)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            write_u64(output.bytes[SnapshotSequence::FIRST], cursor, frame_result.frame.parent_invocation.value)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            write_u64(output.bytes[SnapshotSequence::FIRST], cursor, frame_result.frame.function.value)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            write_u64(output.bytes[SnapshotSequence::FIRST], cursor, frame_result.frame.task.value)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            write_u64(output.bytes[SnapshotSequence::FIRST], cursor, frame_result.frame.source_file.value)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            write_u32(output.bytes[SnapshotSequence::FIRST], cursor, frame_result.frame.source_line)
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            write_u32(output.bytes[SnapshotSequence::FIRST], cursor, frame_result.frame.source_column)
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            write_u32(output.bytes[SnapshotSequence::FIRST], cursor, frame_result.frame.binding_count.u32())
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            write_u32(output.bytes[SnapshotSequence::FIRST], cursor, binding_start.u32())
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            write_u32(output.bytes[SnapshotSequence::FIRST], cursor, page_binding_count.u32())
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH

            for page_index in SnapshotSequence::FIRST..<page_binding_count:
                binding_result: DebuggerAgentFrames::BindingReadResult = DebuggerAgentInspection::agent_inspection_read_binding_at(shadow_stack, registry, frame_result.frame.invocation, binding_start + page_index, generation)
                output.status <- inspection_failure_status(binding_result.status)
                return output.status if binding_result.status != DebuggerAgentFrames::ShadowStatus.Ready and binding_result.status != DebuggerAgentFrames::ShadowStatus.ValueNotAvailable
                descriptor: DebuggerAgentFrames::AgentStorageDescriptor = binding_result.descriptor
                output.status <- SnapshotWireStatus.InvalidDescriptor
                return output.status if not DebuggerAgentFrames::agent_storage_descriptor_is_exact(descriptor)
                data_length: mutable usize = SnapshotProtocol::ZERO_LENGTH
                data_length <- descriptor.byte_size.usize() if descriptor.state == DebuggerAgentFrames::AgentValueState.Available
                payload_length <- payload_length + SnapshotDescriptorShape::PREFIX_LENGTH + data_length
                output.status <- SnapshotWireStatus.ResourceLimit
                return output.status if payload_length > SnapshotCapacity::MAX_PAYLOAD_BYTES
                write_u64(output.bytes[SnapshotSequence::FIRST], cursor, descriptor.binding.value)
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                write_u64(output.bytes[SnapshotSequence::FIRST], cursor, descriptor.scope.value)
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                write_u64(output.bytes[SnapshotSequence::FIRST], cursor, descriptor.type_id.value)
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                write_u16(output.bytes[SnapshotSequence::FIRST], cursor, encode_value_kind(descriptor.value_kind))
                cursor <- cursor + SnapshotByteEncoding::U16_WIDTH
                write_u16(output.bytes[SnapshotSequence::FIRST], cursor, encode_value_state(descriptor.state))
                cursor <- cursor + SnapshotByteEncoding::U16_WIDTH
                write_u16(output.bytes[SnapshotSequence::FIRST], cursor, encode_storage_kind(descriptor.storage_kind))
                cursor <- cursor + SnapshotByteEncoding::U16_WIDTH
                write_u16(output.bytes[SnapshotSequence::FIRST], cursor, SnapshotProtocol::EMPTY_RESERVED_WORD.u16())
                cursor <- cursor + SnapshotByteEncoding::U16_WIDTH
                write_u64(output.bytes[SnapshotSequence::FIRST], cursor, descriptor.storage_location.u64())
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                write_u64(output.bytes[SnapshotSequence::FIRST], cursor, descriptor.byte_size)
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                write_u32(output.bytes[SnapshotSequence::FIRST], cursor, data_length.u32())
                cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
                for byte_index in SnapshotSequence::FIRST..<data_length:
                    output.bytes[cursor + byte_index] <- descriptor.bytes[byte_index]
                cursor <- cursor + data_length

            total_length: usize = SnapshotHeader::HEADER_LENGTH + payload_length
            if total_length > SnapshotCapacityShape::MESSAGE_CAPACITY or cursor != total_length:
                output.status <- SnapshotWireStatus.ResourceLimit
                return output.status
            output.bytes[SnapshotHeader::MAGIC_OFFSET] <- SnapshotMagic::FIRST
            output.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::SECOND_OFFSET] <- SnapshotMagic::SECOND
            output.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::THIRD_OFFSET] <- SnapshotMagic::THIRD
            output.bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::FOURTH_OFFSET] <- SnapshotMagic::FOURTH
            write_u16(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::VERSION_OFFSET, SnapshotProtocol::VERSION)
            write_u16(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::KIND_OFFSET, SnapshotProtocol::FRAME_PAGE_KIND)
            write_u32(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::PAYLOAD_LENGTH_OFFSET, payload_length.u32())
            write_u64(output.bytes[SnapshotSequence::FIRST], SnapshotHeader::CHECKSUM_OFFSET, page_checksum(output.bytes[SnapshotSequence::FIRST], total_length))
            output.length <- total_length
            output.status <- SnapshotWireStatus.Ready
            return output.status

        # Decode into caller-owned storage. On any failure, `status` is not
        # Ready and consumers must ignore all partially decoded fields.
        def agent_snapshot_frame_page_decode(bytes: u8&, length: usize, page: mutable DecodedSnapshotPage&) -> SnapshotWireStatus:
            page.status <- SnapshotWireStatus.InvalidLength
            page.generation <- SnapshotProtocol::NO_GENERATION
            page.thread_id <- SnapshotIdentifier::NO_ID
            page.frame_index <- SnapshotProtocol::ZERO_LENGTH
            page.binding_start <- SnapshotProtocol::ZERO_LENGTH
            page.binding_count <- SnapshotProtocol::ZERO_LENGTH
            if length < SnapshotHeader::HEADER_LENGTH:
                page.status <- SnapshotWireStatus.Truncated
                return page.status
            if length > SnapshotCapacityShape::MESSAGE_CAPACITY:
                return page.status
            if bytes[SnapshotHeader::MAGIC_OFFSET] != SnapshotMagic::FIRST or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::SECOND_OFFSET] != SnapshotMagic::SECOND or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::THIRD_OFFSET] != SnapshotMagic::THIRD or bytes[SnapshotHeader::MAGIC_OFFSET + SnapshotMagic::FOURTH_OFFSET] != SnapshotMagic::FOURTH:
                page.status <- SnapshotWireStatus.InvalidMagic
                return page.status
            if read_u16(bytes, SnapshotHeader::VERSION_OFFSET) != SnapshotProtocol::VERSION:
                page.status <- SnapshotWireStatus.UnsupportedVersion
                return page.status
            response_kind: u16 = read_u16(bytes, SnapshotHeader::KIND_OFFSET)
            if response_kind == SnapshotResponseShape::ERROR_MESSAGE_KIND:
                page.status <- snapshot_error_response_decode(bytes, length)
                return page.status
            if response_kind != SnapshotProtocol::FRAME_PAGE_KIND:
                page.status <- SnapshotWireStatus.UnsupportedMessage
                return page.status
            generation: u64 = read_u64(bytes, SnapshotHeader::GENERATION_OFFSET)
            if generation == SnapshotProtocol::NO_GENERATION:
                page.status <- SnapshotWireStatus.InvalidGeneration
                return page.status
            payload_length: usize = read_u32(bytes, SnapshotHeader::PAYLOAD_LENGTH_OFFSET).usize()
            if payload_length > SnapshotCapacity::MAX_PAYLOAD_BYTES:
                return page.status
            available_payload_length: usize = length - SnapshotHeader::HEADER_LENGTH
            if payload_length > available_payload_length:
                page.status <- SnapshotWireStatus.Truncated
                return page.status
            if payload_length < available_payload_length:
                return page.status
            if read_u32(bytes, SnapshotHeader::RESERVED_OFFSET) != SnapshotProtocol::EMPTY_RESERVED_WORD:
                page.status <- SnapshotWireStatus.InvalidReservedWord
                return page.status
            expected_checksum: u64 = read_u64(bytes, SnapshotHeader::CHECKSUM_OFFSET)
            if expected_checksum != page_checksum(bytes, length):
                page.status <- SnapshotWireStatus.ChecksumMismatch
                return page.status
            if payload_length < SnapshotPayloadShape::FRAME_HEADER_LENGTH:
                page.status <- SnapshotWireStatus.InvalidPayload
                return page.status

            cursor: mutable usize = SnapshotHeader::PAYLOAD_OFFSET
            page.thread_id <- read_u64(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            frame_index_value: u64 = read_u64(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            page.frame.invocation.value <- read_u64(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            page.frame.parent_invocation.value <- read_u64(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            page.frame.function.value <- read_u64(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            page.frame.task.value <- read_u64(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            page.frame.source_file.value <- read_u64(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
            page.frame.source_line <- read_u32(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            page.frame.source_column <- read_u32(bytes, cursor)
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            frame_binding_count: usize = read_u32(bytes, cursor).usize()
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            page.binding_start <- read_u32(bytes, cursor).usize()
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
            page.binding_count <- read_u32(bytes, cursor).usize()
            cursor <- cursor + SnapshotByteEncoding::U32_WIDTH

            page.status <- SnapshotWireStatus.InvalidPayload
            return page.status if page.thread_id == SnapshotIdentifier::NO_ID or frame_index_value >= DebuggerAgentFrames::agent_shadow_frame_capacity().u64()
            return page.status if page.frame.invocation.value == SnapshotIdentifier::NO_ID or page.frame.function.value == SnapshotIdentifier::NO_ID or page.frame.task.value == SnapshotIdentifier::NO_ID
            return page.status if frame_binding_count > DebuggerAgentFrames::agent_shadow_binding_capacity() or page.binding_start > frame_binding_count
            return page.status if page.binding_count > SnapshotCapacity::MAX_BINDINGS_PER_PAGE or page.binding_count > frame_binding_count - page.binding_start
            page.frame_index <- frame_index_value.usize()
            page.frame.binding_count <- frame_binding_count
            page.generation <- generation

            for binding_index in SnapshotSequence::FIRST..<page.binding_count:
                if cursor > length or SnapshotDescriptorShape::PREFIX_LENGTH > length - cursor:
                    page.status <- SnapshotWireStatus.InvalidPayload
                    return page.status
                descriptor: mutable DebuggerAgentFrames::AgentStorageDescriptor = zeroed
                descriptor.binding.value <- read_u64(bytes, cursor)
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                descriptor.scope.value <- read_u64(bytes, cursor)
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                descriptor.type_id.value <- read_u64(bytes, cursor)
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                value_kind_code: u16 = read_u16(bytes, cursor)
                cursor <- cursor + SnapshotByteEncoding::U16_WIDTH
                value_state_code: u16 = read_u16(bytes, cursor)
                cursor <- cursor + SnapshotByteEncoding::U16_WIDTH
                storage_kind_code: u16 = read_u16(bytes, cursor)
                cursor <- cursor + SnapshotByteEncoding::U16_WIDTH
                reserved_code: u16 = read_u16(bytes, cursor)
                cursor <- cursor + SnapshotByteEncoding::U16_WIDTH
                descriptor.storage_location <- read_u64(bytes, cursor).i64()
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                descriptor.byte_size <- read_u64(bytes, cursor)
                cursor <- cursor + SnapshotByteEncoding::U64_WIDTH
                data_length: usize = read_u32(bytes, cursor).usize()
                cursor <- cursor + SnapshotByteEncoding::U32_WIDTH
                if value_kind_code > SnapshotEnumBounds::MAX_VALUE_KIND or value_state_code > SnapshotEnumBounds::MAX_VALUE_STATE or storage_kind_code > SnapshotEnumBounds::MAX_STORAGE_KIND or reserved_code != SnapshotProtocol::EMPTY_RESERVED_WORD.u16():
                    page.status <- SnapshotWireStatus.InvalidDescriptor
                    return page.status
                descriptor.value_kind <- decode_value_kind(value_kind_code)
                descriptor.state <- decode_value_state(value_state_code)
                descriptor.storage_kind <- decode_storage_kind(storage_kind_code)
                if data_length > DebuggerAgentFrames::agent_shadow_inline_value_capacity() or data_length > length - cursor:
                    page.status <- SnapshotWireStatus.InvalidDescriptor
                    return page.status
                if descriptor.state == DebuggerAgentFrames::AgentValueState.Available:
                    if descriptor.byte_size != data_length.u64():
                        page.status <- SnapshotWireStatus.InvalidDescriptor
                        return page.status
                else:
                    if data_length != SnapshotProtocol::ZERO_LENGTH:
                        page.status <- SnapshotWireStatus.InvalidDescriptor
                        return page.status
                for byte_index in SnapshotSequence::FIRST..<data_length:
                    descriptor.bytes[byte_index] <- bytes[cursor + byte_index]
                cursor <- cursor + data_length
                if not DebuggerAgentFrames::agent_storage_descriptor_is_exact(descriptor):
                    page.status <- SnapshotWireStatus.InvalidDescriptor
                    return page.status
                for previous in SnapshotSequence::FIRST..<binding_index:
                    if page.bindings[previous].binding.value == descriptor.binding.value:
                        page.status <- SnapshotWireStatus.InvalidDescriptor
                        return page.status
                page.bindings[binding_index] <- descriptor

            if cursor != length:
                page.status <- SnapshotWireStatus.InvalidPayload
                return page.status
            page.status <- SnapshotWireStatus.Ready
            return page.status
