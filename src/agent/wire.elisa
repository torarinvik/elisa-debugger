# Fixed-width target-agent wire messages. This module stays independent of DAP
# so editor adapters and the in-process agent transport share one byte format.

include "./hooks.elisa"
include "../trace/binary.elisa"

module DebuggerAgentWire:
    private:
        const module WireEnvelope:
            FRAME_CAPACITY: usize = 32
            FRAME_LENGTH: usize = 32
            PAYLOAD_LENGTH: usize = 24

        const module Offset:
            MAGIC: usize = 0
            VERSION: usize = 4
            MESSAGE_KIND: usize = 6
            GENERATION: usize = 8
            EVENT_COUNT: usize = 16
            CHECKSUM: usize = 24

        const module Magic:
            BYTE_FIRST: u8 = 69
            BYTE_SECOND: u8 = 76
            BYTE_THIRD: u8 = 83
            BYTE_FOURTH: u8 = 65

        const module Index:
            FIRST_BYTE: usize = 0
            MAGIC_SECOND_BYTE: usize = 1
            MAGIC_THIRD_BYTE: usize = 2
            MAGIC_FOURTH_BYTE: usize = 3

        const module Protocol:
            MAJOR: u16 = 1
            NO_AGENT_MAJOR: u32 = 0
            U32_MAJOR_SHIFT: u64 = 32
            U32_MINOR_MASK: u64 = 4294967295

        const module Sentinel:
            NO_GENERATION: u64 = 0

        const module Message:
            STOP_ACKNOWLEDGEMENT: u16 = 1
            HELLO_REQUEST: u16 = 2
            HELLO_RESPONSE: u16 = 3
            STOP_REQUEST: u16 = 4
            RESUME_REQUEST: u16 = 5

        const module ControlPayload:
            EMPTY_RESERVED_WORD: u64 = 0

        const module ByteEncoding:
            BITS_PER_BYTE: u64 = 8
            BYTE_MASK: u64 = 255
            ZERO_VALUE: u64 = 0
            U16_BYTE_COUNT: usize = 2
            U16_HIGH_BYTE_OFFSET: usize = 1
            U64_BYTE_COUNT: usize = 8

        def write_u16(bytes: mutable u8&, offset: usize, value: u16) -> void:
            for index in Index::FIRST_BYTE..<ByteEncoding::U16_BYTE_COUNT:
                bytes[offset + index] <- ((value.u64() >> (ByteEncoding::BITS_PER_BYTE * index.u64())) & ByteEncoding::BYTE_MASK).u8()

        def write_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
            for index in Index::FIRST_BYTE..<ByteEncoding::U64_BYTE_COUNT:
                bytes[offset + index] <- ((value >> (ByteEncoding::BITS_PER_BYTE * index.u64())) & ByteEncoding::BYTE_MASK).u8()

        def read_u16(bytes: u8&, offset: usize) -> u16:
            low: u64 = bytes[offset].u64()
            high: u64 = bytes[offset + ByteEncoding::U16_HIGH_BYTE_OFFSET].u64()
            return (low | (high << ByteEncoding::BITS_PER_BYTE)).u16()

        def read_u64(bytes: u8&, offset: usize) -> u64:
            value: mutable u64 = ByteEncoding::ZERO_VALUE
            for index in Index::FIRST_BYTE..<ByteEncoding::U64_BYTE_COUNT:
                value <- value | (bytes[offset + index].u64() << (ByteEncoding::BITS_PER_BYTE * index.u64()))
            return value

        def write_frame(bytes: mutable u8&, message_kind: u16, first_payload: u64, second_payload: u64) -> void:
            bytes[Offset::MAGIC] <- Magic::BYTE_FIRST
            bytes[Offset::MAGIC + Index::MAGIC_SECOND_BYTE] <- Magic::BYTE_SECOND
            bytes[Offset::MAGIC + Index::MAGIC_THIRD_BYTE] <- Magic::BYTE_THIRD
            bytes[Offset::MAGIC + Index::MAGIC_FOURTH_BYTE] <- Magic::BYTE_FOURTH
            write_u16(bytes, Offset::VERSION, Protocol::MAJOR)
            write_u16(bytes, Offset::MESSAGE_KIND, message_kind)
            write_u64(bytes, Offset::GENERATION, first_payload)
            write_u64(bytes, Offset::EVENT_COUNT, second_payload)
            checksum: u64 = DebuggerTraceBinary::bytes_checksum(bytes, WireEnvelope::PAYLOAD_LENGTH)
            write_u64(bytes, Offset::CHECKSUM, checksum)

        def frame_decode_status(bytes: u8&, length: usize, expected_message_kind: u16) -> WireStatus:
            return WireStatus.Truncated if length < WireEnvelope::FRAME_LENGTH
            return WireStatus.InvalidLength if length > WireEnvelope::FRAME_LENGTH
            return WireStatus.InvalidMagic if bytes[Offset::MAGIC] != Magic::BYTE_FIRST or bytes[Offset::MAGIC + Index::MAGIC_SECOND_BYTE] != Magic::BYTE_SECOND or bytes[Offset::MAGIC + Index::MAGIC_THIRD_BYTE] != Magic::BYTE_THIRD or bytes[Offset::MAGIC + Index::MAGIC_FOURTH_BYTE] != Magic::BYTE_FOURTH
            return WireStatus.UnsupportedVersion if read_u16(bytes, Offset::VERSION) != Protocol::MAJOR
            return WireStatus.UnsupportedMessage if read_u16(bytes, Offset::MESSAGE_KIND) != expected_message_kind
            expected_checksum: u64 = read_u64(bytes, Offset::CHECKSUM)
            actual_checksum: u64 = DebuggerTraceBinary::bytes_checksum(bytes, WireEnvelope::PAYLOAD_LENGTH)
            return WireStatus.ChecksumMismatch if expected_checksum != actual_checksum
            return WireStatus.Ready

        def decode_failure(status: WireStatus) -> DecodedStopAcknowledgement:
            result: mutable DecodedStopAcknowledgement = zeroed
            result.status <- status
            return result

        def hello_decode_failure(status: WireStatus) -> DecodedAgentHello:
            result: mutable DecodedAgentHello = zeroed
            result.status <- status
            return result

        def control_decode_failure(status: WireStatus) -> DecodedAgentControlRequest:
            result: mutable DecodedAgentControlRequest = zeroed
            result.status <- status
            return result

        def hello_encode(hello: AgentHello, message_kind: u16) -> EncodedAgentHello:
            frame: mutable EncodedAgentHello = zeroed
            frame.status <- WireStatus.InvalidProtocolMajor if hello.protocol_major == Protocol::NO_AGENT_MAJOR
            return frame if frame.status == WireStatus.InvalidProtocolMajor
            version_word: u64 = (hello.protocol_major.u64() << Protocol::U32_MAJOR_SHIFT) | hello.protocol_minor.u64()
            write_frame(frame.bytes[Index::FIRST_BYTE], message_kind, version_word, hello.capabilities)
            frame.length <- WireEnvelope::FRAME_LENGTH
            frame.status <- WireStatus.Ready
            return frame

        def hello_decode(bytes: u8&, length: usize, expected_message_kind: u16) -> DecodedAgentHello:
            frame_status: WireStatus = frame_decode_status(bytes, length, expected_message_kind)
            return hello_decode_failure(frame_status) if frame_status != WireStatus.Ready
            version_word: u64 = read_u64(bytes, Offset::GENERATION)
            hello: mutable AgentHello = zeroed
            hello.protocol_major <- (version_word >> Protocol::U32_MAJOR_SHIFT).u32()
            hello.protocol_minor <- (version_word & Protocol::U32_MINOR_MASK).u32()
            hello.capabilities <- read_u64(bytes, Offset::EVENT_COUNT)
            return hello_decode_failure(WireStatus.InvalidProtocolMajor) if hello.protocol_major == Protocol::NO_AGENT_MAJOR
            return DecodedAgentHello{hello: hello, status: WireStatus.Ready}

        def control_request_encode(request: AgentControlRequest, message_kind: u16) -> EncodedAgentControlRequest:
            frame: mutable EncodedAgentControlRequest = zeroed
            frame.status <- WireStatus.InvalidGeneration if request.generation == Sentinel::NO_GENERATION
            return frame if frame.status == WireStatus.InvalidGeneration
            write_frame(frame.bytes[Index::FIRST_BYTE], message_kind, request.generation, ControlPayload::EMPTY_RESERVED_WORD)
            frame.length <- WireEnvelope::FRAME_LENGTH
            frame.status <- WireStatus.Ready
            return frame

        def control_request_decode(bytes: u8&, length: usize) -> DecodedAgentControlRequest:
            return control_decode_failure(WireStatus.Truncated) if length < WireEnvelope::FRAME_LENGTH
            return control_decode_failure(WireStatus.InvalidLength) if length > WireEnvelope::FRAME_LENGTH
            message_kind: u16 = read_u16(bytes, Offset::MESSAGE_KIND)
            return control_decode_failure(WireStatus.UnsupportedMessage) if message_kind != Message::STOP_REQUEST and message_kind != Message::RESUME_REQUEST
            frame_status: WireStatus = frame_decode_status(bytes, length, message_kind)
            return control_decode_failure(frame_status) if frame_status != WireStatus.Ready
            return control_decode_failure(WireStatus.InvalidControlPayload) if read_u64(bytes, Offset::EVENT_COUNT) != ControlPayload::EMPTY_RESERVED_WORD
            generation: u64 = read_u64(bytes, Offset::GENERATION)
            return control_decode_failure(WireStatus.InvalidGeneration) if generation == Sentinel::NO_GENERATION
            request_kind: mutable AgentControlKind = AgentControlKind.StopRequest
            request_kind <- AgentControlKind.ResumeRequest if message_kind == Message::RESUME_REQUEST
            return DecodedAgentControlRequest{request: AgentControlRequest{kind: request_kind, generation: generation}, status: WireStatus.Ready}

    public:
        enum WireStatus:
            Ready
            InvalidGeneration
            EventCountOutOfRange
            InvalidLength
            Truncated
            InvalidMagic
            UnsupportedVersion
            UnsupportedMessage
            ChecksumMismatch
            InvalidProtocolMajor
            InvalidControlPayload

        enum AgentControlKind:
            StopRequest
            ResumeRequest

        struct EncodedStopAcknowledgement:
            bytes: mutable u8[WireEnvelope::FRAME_CAPACITY]
            length: mutable usize
            status: mutable WireStatus

        struct DecodedStopAcknowledgement:
            acknowledgement: mutable DebuggerAgent::AgentStopAcknowledgement
            status: mutable WireStatus

        struct AgentHello:
            protocol_major: mutable u32
            protocol_minor: mutable u32
            capabilities: mutable u64

        struct EncodedAgentHello:
            bytes: mutable u8[WireEnvelope::FRAME_CAPACITY]
            length: mutable usize
            status: mutable WireStatus

        struct DecodedAgentHello:
            hello: mutable AgentHello
            status: mutable WireStatus

        struct AgentControlRequest:
            kind: mutable AgentControlKind
            generation: mutable u64

        struct EncodedAgentControlRequest:
            bytes: mutable u8[WireEnvelope::FRAME_CAPACITY]
            length: mutable usize
            status: mutable WireStatus

        struct DecodedAgentControlRequest:
            request: mutable AgentControlRequest
            status: mutable WireStatus

        def stop_acknowledgement_frame_length() -> usize:
            return WireEnvelope::FRAME_LENGTH

        def stop_acknowledgement_encode(acknowledgement: DebuggerAgent::AgentStopAcknowledgement) -> EncodedStopAcknowledgement:
            frame: mutable EncodedStopAcknowledgement = zeroed
            frame.status <- WireStatus.InvalidGeneration if acknowledgement.generation == Sentinel::NO_GENERATION
            return frame if frame.status == WireStatus.InvalidGeneration
            frame.status <- WireStatus.EventCountOutOfRange if acknowledgement.event_count > DebuggerAgent::agent_event_capacity().u64()
            return frame if frame.status == WireStatus.EventCountOutOfRange

            write_frame(frame.bytes[Index::FIRST_BYTE], Message::STOP_ACKNOWLEDGEMENT, acknowledgement.generation, acknowledgement.event_count)
            frame.length <- WireEnvelope::FRAME_LENGTH
            frame.status <- WireStatus.Ready
            return frame

        def stop_acknowledgement_decode(bytes: u8&, length: usize) -> DecodedStopAcknowledgement:
            frame_status: WireStatus = frame_decode_status(bytes, length, Message::STOP_ACKNOWLEDGEMENT)
            return decode_failure(frame_status) if frame_status != WireStatus.Ready

            acknowledgement: mutable DebuggerAgent::AgentStopAcknowledgement = zeroed
            acknowledgement.generation <- read_u64(bytes, Offset::GENERATION)
            acknowledgement.event_count <- read_u64(bytes, Offset::EVENT_COUNT)
            return decode_failure(WireStatus.InvalidGeneration) if acknowledgement.generation == Sentinel::NO_GENERATION
            return decode_failure(WireStatus.EventCountOutOfRange) if acknowledgement.event_count > DebuggerAgent::agent_event_capacity().u64()
            return DecodedStopAcknowledgement{acknowledgement: acknowledgement, status: WireStatus.Ready}

        def agent_hello_request_encode(hello: AgentHello) -> EncodedAgentHello:
            return hello_encode(hello, Message::HELLO_REQUEST)

        def agent_hello_request_decode(bytes: u8&, length: usize) -> DecodedAgentHello:
            return hello_decode(bytes, length, Message::HELLO_REQUEST)

        def agent_hello_response_encode(hello: AgentHello) -> EncodedAgentHello:
            return hello_encode(hello, Message::HELLO_RESPONSE)

        def agent_hello_response_decode(bytes: u8&, length: usize) -> DecodedAgentHello:
            return hello_decode(bytes, length, Message::HELLO_RESPONSE)

        def agent_control_request_frame_length() -> usize:
            return WireEnvelope::FRAME_LENGTH

        def agent_control_request_encode(request: AgentControlRequest) -> EncodedAgentControlRequest:
            message_kind: mutable u16 = Message::STOP_REQUEST
            message_kind <- Message::RESUME_REQUEST if request.kind == AgentControlKind.ResumeRequest
            return control_request_encode(request, message_kind)

        def agent_control_request_decode(bytes: u8&, length: usize) -> DecodedAgentControlRequest:
            return control_request_decode(bytes, length)
