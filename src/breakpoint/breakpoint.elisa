# Breakpoints resolve against build/source identity and are evaluated against a
# selected branch, never against a global mutable hit counter.

include "../core/identity.elisa"
include "../metadata/source.elisa"

module DebuggerBreakpoints:
    public:
        enum BreakpointKind:
            Source
            Function
            Instruction
            Data
            Exception
            Tracepoint

        enum BreakpointStatus:
            Pending
            Verified
            Disabled
            Invalid

        struct Breakpoint:
            id: mutable DebuggerIdentity::DebugId
            branch: mutable DebuggerIdentity::DebugId
            kind: mutable BreakpointKind
            status: mutable BreakpointStatus
            source: mutable DebuggerMetadata::SourceLocation
            condition: mutable DebuggerIdentity::DebugId
            hit_target: mutable u64
            hit_count: mutable u64
            hit_stride: mutable u64
            task: mutable DebuggerIdentity::DebugId
            logpoint: mutable bool
            temporary: mutable bool

        def breakpoint_should_stop(point: Breakpoint, branch: DebuggerIdentity::DebugId) -> bool:
            return false if point.status != BreakpointStatus.Verified
            return false if point.hit_target > 0 and point.hit_count < point.hit_target
            return false if point.hit_stride > 1 and point.hit_count % point.hit_stride != 0
            return point.branch.value == 0 or point.branch.value == branch.value

        def breakpoint_observe_hit(point: Breakpoint) -> Breakpoint:
            updated: mutable Breakpoint = point
            updated.hit_count <- point.hit_count + 1
            return updated

        def breakpoint_is_logpoint(point: Breakpoint) -> bool:
            return point.logpoint
