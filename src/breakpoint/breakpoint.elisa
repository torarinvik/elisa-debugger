# Breakpoints resolve against build/source identity and are evaluated against a
# selected branch, never against a global mutable hit counter.

include "../core/identity.elisa"
include "../core/expression_limits.elisa"
include "../metadata/source.elisa"

module DebuggerBreakpoints:
    private:
        const module BreakpointLimits:
            BREAKPOINT_LIMITS_MAX_HIT_COUNT: u64 = 18446744073709551615
            CONDITION_MAX_EXPRESSION_BYTES: usize = DebuggerExpressionLimits::Source::MAX_EXPRESSION_BYTES
            EMPTY_EXPRESSION_BYTE: u8 = 0


    public:
        enum BreakpointKind:
            Source
            Function
            Instruction
            Data
            Exception
            Tracepoint

        enum BreakpointStatus:
            Pending
            Verified
            Disabled
            Invalid

        struct Breakpoint:
            id: mutable DebuggerIdentity::DebugId
            branch: mutable DebuggerIdentity::DebugId
            kind: mutable BreakpointKind
            status: mutable BreakpointStatus
            source: mutable DebuggerMetadata::SourceLocation
            condition: mutable DebuggerIdentity::DebugId
            condition_expression: mutable u8[BreakpointLimits::CONDITION_MAX_EXPRESSION_BYTES]
            condition_length: mutable usize
            hit_target: mutable u64
            hit_count: mutable u64
            hit_stride: mutable u64
            task: mutable DebuggerIdentity::DebugId
            logpoint: mutable bool
            temporary: mutable bool

        def breakpoint_matches_branch(point: Breakpoint, branch: DebuggerIdentity::DebugId) -> bool:
            return point.branch.value == 0 or point.branch.value == branch.value

        def breakpoint_should_stop(point: Breakpoint, branch: DebuggerIdentity::DebugId) -> bool:
            return false if point.status != BreakpointStatus.Verified
            return false if not breakpoint_matches_branch(point, branch)
            return false if point.logpoint
            return false if point.hit_target > 0 and point.hit_count < point.hit_target
            return false if point.hit_stride > 1 and point.hit_count % point.hit_stride != 0
            return true

        def breakpoint_observe_hit(point: Breakpoint, branch: DebuggerIdentity::DebugId) -> Breakpoint:
            updated: mutable Breakpoint = point
            return updated if not breakpoint_matches_branch(point, branch)
            updated.hit_count <- BreakpointLimits::BREAKPOINT_LIMITS_MAX_HIT_COUNT if point.hit_count == BreakpointLimits::BREAKPOINT_LIMITS_MAX_HIT_COUNT
            updated.hit_count <- point.hit_count + 1 if point.hit_count < BreakpointLimits::BREAKPOINT_LIMITS_MAX_HIT_COUNT
            return updated

        def breakpoint_is_logpoint(point: Breakpoint) -> bool:
            return point.logpoint

        def breakpoint_condition_capacity() -> usize:
            return BreakpointLimits::CONDITION_MAX_EXPRESSION_BYTES

        def breakpoint_empty_expression_byte() -> u8:
            return BreakpointLimits::EMPTY_EXPRESSION_BYTE
