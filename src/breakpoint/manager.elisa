# Build-aware breakpoint storage and resolution.  Resolution is explicit so a
# client can show pending breakpoints rather than silently dropping them.

include "./breakpoint.elisa"
include "../core/identity.elisa"
include "../vm/edir.elisa"

module DebuggerBreakpointManager:
    private:
        const module Breakpoint:
            BREAKPOINT_MANAGER_CAPACITY: usize = 256
            COUNT_INCREMENT: usize = 1
            BREAKPOINT_MANAGER_ID_INCREMENT: u64 = 1
            NO_BREAKPOINT_ID: u64 = 0
            NO_REQUESTED_BREAKPOINTS: usize = 0
            BREAKPOINT_MANAGER_FIRST_ID: u64 = 1
            BREAKPOINT_MANAGER_MAX_ID: u64 = 18446744073709551615
            NO_SOURCE: u64 = 0
            BREAKPOINT_MANAGER_NO_LINE: u64 = 0
            BREAKPOINT_MANAGER_SOURCE_BREAKPOINT_NO_COLUMN: u32 = 0
            BREAKPOINT_MANAGER_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX: usize = 0
            BREAKPOINT_MANAGER_NO_INSTRUCTION: u64 = 18446744073709551615
            BREAKPOINT_MANAGER_KIND_MAX: u16 = 5
            BREAKPOINT_MANAGER_STATUS_MAX: u16 = 3

        const module FunctionName:
            FIRST_BYTE_INDEX: usize = 0


    public:
        struct BreakpointTable:
            points: mutable DebuggerBreakpoints::Breakpoint[Breakpoint::BREAKPOINT_MANAGER_CAPACITY]
            resolved_instructions: mutable u64[Breakpoint::BREAKPOINT_MANAGER_CAPACITY]
            count: mutable usize
            next_id: mutable u64

        struct BreakpointResult:
            id: mutable DebuggerIdentity::DebugId
            line: mutable u32
            column: mutable u32
            has_column: mutable bool
            verified: mutable bool

        struct BreakpointReplacement:
            accepted: mutable bool
            results: mutable BreakpointResult[Breakpoint::BREAKPOINT_MANAGER_CAPACITY]
            count: mutable usize

        def breakpoint_table_new() -> BreakpointTable:
            table: mutable BreakpointTable = zeroed
            table.count <- 0
            table.next_id <- Breakpoint::BREAKPOINT_MANAGER_FIRST_ID
            return table

        def breakpoint_table_add(table: mutable BreakpointTable&, point: DebuggerBreakpoints::Breakpoint) -> bool:
            return false if table.count >= Breakpoint::BREAKPOINT_MANAGER_CAPACITY or table.next_id == Breakpoint::NO_BREAKPOINT_ID or table.next_id == Breakpoint::BREAKPOINT_MANAGER_MAX_ID
            return false if point.kind.u16() > Breakpoint::BREAKPOINT_MANAGER_KIND_MAX or point.status.u16() > Breakpoint::BREAKPOINT_MANAGER_STATUS_MAX or point.status == DebuggerBreakpoints::BreakpointStatus.Invalid
            return false if point.condition_length > DebuggerBreakpoints::breakpoint_condition_capacity() or point.log_message_length > DebuggerBreakpoints::breakpoint_log_message_capacity()
            return false if point.function_name_length > DebuggerBreakpoints::breakpoint_function_name_capacity()
            return false if point.logpoint and point.kind != DebuggerBreakpoints::BreakpointKind.Source
            return false if not point.logpoint and point.log_message_length > DebuggerBreakpoints::breakpoint_empty_log_message_length()
            return false if point.kind == DebuggerBreakpoints::BreakpointKind.Source and not DebuggerMetadata::source_location_is_valid(point.source)
            return false if point.kind == DebuggerBreakpoints::BreakpointKind.Function and point.function_name_length == DebuggerBreakpoints::breakpoint_empty_function_name_length()
            return false if point.kind != DebuggerBreakpoints::BreakpointKind.Function and point.function_name_length != DebuggerBreakpoints::breakpoint_empty_function_name_length()
            return false if point.kind == DebuggerBreakpoints::BreakpointKind.Function and not DebuggerMetadata::metadata_text_utf8_is_valid(point.function_name[FunctionName::FIRST_BYTE_INDEX], point.function_name_length, DebuggerBreakpoints::breakpoint_function_name_capacity())
            for index in 0..<table.count:
                return false if table.points[index].id.value == table.next_id
            table.points[table.count] <- point
            table.resolved_instructions[table.count] <- Breakpoint::BREAKPOINT_MANAGER_NO_INSTRUCTION
            table.points[table.count].id <- DebuggerIdentity::debug_id(table.next_id)
            table.points[table.count].status <- DebuggerBreakpoints::BreakpointStatus.Pending
            table.count <- table.count + Breakpoint::COUNT_INCREMENT
            table.next_id <- table.next_id + Breakpoint::BREAKPOINT_MANAGER_ID_INCREMENT
            return true

        def breakpoint_table_can_allocate_ids(table: BreakpointTable&, requested_count: usize) -> bool:
            return true if requested_count == Breakpoint::NO_REQUESTED_BREAKPOINTS
            return false if table.next_id == Breakpoint::NO_BREAKPOINT_ID or table.next_id == Breakpoint::BREAKPOINT_MANAGER_MAX_ID
            return requested_count.u64() <= Breakpoint::BREAKPOINT_MANAGER_MAX_ID - table.next_id

        # DAP setBreakpoints replaces the source's full set in one operation.
        # Validate capacity and IDs before constructing a changed table so an
        # invalid request can never remove the client's previous breakpoints.
        def breakpoint_table_replace_source(table: mutable BreakpointTable&, source: DebuggerIdentity::DebugId, branch: DebuggerIdentity::DebugId, lines: u32&, requested_count: usize) -> BreakpointReplacement:
            columns: mutable u32[Breakpoint::BREAKPOINT_MANAGER_CAPACITY] = zeroed
            has_columns: mutable bool[Breakpoint::BREAKPOINT_MANAGER_CAPACITY] = zeroed
            return breakpoint_table_replace_source_with_columns(table, source, branch, lines, columns[Breakpoint::BREAKPOINT_MANAGER_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], has_columns[Breakpoint::BREAKPOINT_MANAGER_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], requested_count)

        def breakpoint_table_replace_source_with_columns(table: mutable BreakpointTable&, source: DebuggerIdentity::DebugId, branch: DebuggerIdentity::DebugId, lines: u32&, columns: u32&, has_columns: bool&, requested_count: usize) -> BreakpointReplacement:
            replacement: mutable BreakpointReplacement = zeroed
            return replacement if not breakpoint_table_is_valid(table) or requested_count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY or source.value == Breakpoint::NO_SOURCE
            original_count: usize = table.count
            retained_count: mutable usize = 0
            for index in 0..<original_count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                retained_count <- retained_count + Breakpoint::COUNT_INCREMENT if point.kind != DebuggerBreakpoints::BreakpointKind.Source or point.source.file.value != source.value
            return replacement if retained_count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY or requested_count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY - retained_count
            return replacement if requested_count.u64() > Breakpoint::BREAKPOINT_MANAGER_MAX_ID - table.next_id
            for index in 0..<requested_count:
                return replacement if lines[index] == Breakpoint::BREAKPOINT_MANAGER_NO_LINE
            table.count <- 0
            for index in 0..<original_count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                if point.kind != DebuggerBreakpoints::BreakpointKind.Source or point.source.file.value != source.value:
                    table.points[table.count] <- point
                    table.resolved_instructions[table.count] <- table.resolved_instructions[index]
                    table.count <- table.count + Breakpoint::COUNT_INCREMENT
            for index in 0..<requested_count:
                column: mutable u32 = Breakpoint::BREAKPOINT_MANAGER_SOURCE_BREAKPOINT_NO_COLUMN
                column <- columns[index] if has_columns[index]
                point: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::Breakpoint{
                    id: DebuggerIdentity::debug_id(table.next_id),
                    branch: branch,
                    kind: DebuggerBreakpoints::BreakpointKind.Source,
                    status: DebuggerBreakpoints::BreakpointStatus.Pending,
                    source: DebuggerMetadata::SourceLocation{file: source, line: lines[index], column: column, discriminator: 0},
                    condition: DebuggerIdentity::debug_id(0),
                    condition_expression: zeroed,
                    condition_length: 0,
                    function_name: zeroed,
                    function_name_length: DebuggerBreakpoints::breakpoint_empty_function_name_length(),
                    log_message: zeroed,
                    log_message_length: 0,
                    hit_target: 0,
                    hit_count: 0,
                    hit_stride: Breakpoint::BREAKPOINT_MANAGER_FIRST_ID,
                    task: DebuggerIdentity::debug_id(0),
                    logpoint: false,
                    temporary: false
                }
                table.points[table.count] <- point
                table.resolved_instructions[table.count] <- Breakpoint::BREAKPOINT_MANAGER_NO_INSTRUCTION
                replacement.results[index] <- BreakpointResult{id: point.id, line: lines[index], column: point.source.column, has_column: has_columns[index], verified: false}
                table.count <- table.count + Breakpoint::COUNT_INCREMENT
                table.next_id <- table.next_id + Breakpoint::BREAKPOINT_MANAGER_ID_INCREMENT
            replacement.count <- requested_count
            replacement.accepted <- true
            return replacement

        def breakpoint_table_resolve(table: BreakpointTable, source: DebuggerIdentity::DebugId, line: u64) -> BreakpointTable:
            updated: mutable BreakpointTable = table
            return updated if table.count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY
            return updated if source.value == Breakpoint::NO_SOURCE or line == Breakpoint::BREAKPOINT_MANAGER_NO_LINE
            for index in 0..<table.count:
                if table.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source and table.points[index].source.file.value == source.value and table.points[index].source.line == line:
                    updated.points[index].status <- DebuggerBreakpoints::BreakpointStatus.Verified
            return updated

        # Bind a verified source breakpoint to the exact executable instruction
        # chosen by source resolution. IDs distinguish same-line locations.
        def breakpoint_table_resolve_at_instruction(table: mutable BreakpointTable&, breakpoint: DebuggerIdentity::DebugId, instruction: u64) -> void:
            return if table.count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY or breakpoint.value == Breakpoint::NO_BREAKPOINT_ID or instruction == Breakpoint::BREAKPOINT_MANAGER_NO_INSTRUCTION
            for index in 0..<table.count:
                if table.points[index].id.value == breakpoint.value and table.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source:
                    table.points[index].status <- DebuggerBreakpoints::BreakpointStatus.Verified
                    table.resolved_instructions[index] <- instruction
                    break

        def breakpoint_table_count(table: BreakpointTable) -> usize:
            return table.count

        def breakpoint_table_capacity() -> usize:
            return Breakpoint::BREAKPOINT_MANAGER_CAPACITY

        def breakpoint_table_is_valid(table: BreakpointTable&) -> bool:
            return false if table.count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY or table.next_id == Breakpoint::NO_BREAKPOINT_ID or table.next_id > Breakpoint::BREAKPOINT_MANAGER_MAX_ID
            for index in 0..<table.count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                return false if point.id.value == Breakpoint::NO_BREAKPOINT_ID or point.id.value >= table.next_id
                return false if point.kind.u16() > Breakpoint::BREAKPOINT_MANAGER_KIND_MAX or point.status.u16() > Breakpoint::BREAKPOINT_MANAGER_STATUS_MAX or point.status == DebuggerBreakpoints::BreakpointStatus.Invalid
                return false if point.kind == DebuggerBreakpoints::BreakpointKind.Source and not DebuggerMetadata::source_location_is_valid(point.source)
                return false if point.condition_length > DebuggerBreakpoints::breakpoint_condition_capacity() or point.log_message_length > DebuggerBreakpoints::breakpoint_log_message_capacity()
                return false if point.function_name_length > DebuggerBreakpoints::breakpoint_function_name_capacity()
                return false if point.logpoint and point.kind != DebuggerBreakpoints::BreakpointKind.Source
                return false if not point.logpoint and point.log_message_length > DebuggerBreakpoints::breakpoint_empty_log_message_length()
                return false if point.kind == DebuggerBreakpoints::BreakpointKind.Function and point.function_name_length == DebuggerBreakpoints::breakpoint_empty_function_name_length()
                return false if point.kind != DebuggerBreakpoints::BreakpointKind.Function and point.function_name_length != DebuggerBreakpoints::breakpoint_empty_function_name_length()
                return false if point.kind == DebuggerBreakpoints::BreakpointKind.Function and not DebuggerMetadata::metadata_text_utf8_is_valid(point.function_name[FunctionName::FIRST_BYTE_INDEX], point.function_name_length, DebuggerBreakpoints::breakpoint_function_name_capacity())
                for previous in 0..<index:
                    return false if table.points[previous].id.value == point.id.value
            return true

        def breakpoint_table_should_stop(table: mutable BreakpointTable&, branch: DebuggerIdentity::DebugId, source: DebuggerIdentity::SourceSpan) -> bool:
            return false if table.count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY or not DebuggerMetadata::source_span_is_valid(source)
            should_stop: mutable bool = false
            for index in 0..<table.count:
                if table.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source and table.points[index].status == DebuggerBreakpoints::BreakpointStatus.Verified and DebuggerMetadata::source_span_contains(source, table.points[index].source) and DebuggerBreakpoints::breakpoint_matches_branch(table.points[index], branch):
                    observed: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::breakpoint_observe_hit(table.points[index], branch)
                    table.points[index] <- observed
                    should_stop <- true if DebuggerBreakpoints::breakpoint_should_stop(observed, branch)
            return should_stop

        def breakpoint_table_should_stop_at_instruction(table: mutable BreakpointTable&, branch: DebuggerIdentity::DebugId, source: DebuggerIdentity::SourceSpan, instruction: u64) -> bool:
            return false if table.count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY or not DebuggerMetadata::source_span_is_valid(source)
            return false if instruction == Breakpoint::BREAKPOINT_MANAGER_NO_INSTRUCTION
            should_stop: mutable bool = false
            for index in 0..<table.count:
                if table.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source and table.points[index].status == DebuggerBreakpoints::BreakpointStatus.Verified and table.resolved_instructions[index] == instruction and DebuggerMetadata::source_span_contains(source, table.points[index].source) and DebuggerBreakpoints::breakpoint_matches_branch(table.points[index], branch):
                    observed: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::breakpoint_observe_hit(table.points[index], branch)
                    table.points[index] <- observed
                    should_stop <- true if DebuggerBreakpoints::breakpoint_should_stop(observed, branch)
            return should_stop

        # Reverse navigation must inspect breakpoint policy without recording a
        # new hit.  Work on a local observed copy so the forward hit counter is
        # unchanged while still applying target/stride/logpoint rules.
        def breakpoint_table_would_stop(table: BreakpointTable, branch: DebuggerIdentity::DebugId, source: DebuggerIdentity::SourceSpan) -> bool:
            return false if table.count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY or not DebuggerMetadata::source_span_is_valid(source)
            for index in 0..<table.count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                if point.kind == DebuggerBreakpoints::BreakpointKind.Source and point.status == DebuggerBreakpoints::BreakpointStatus.Verified and DebuggerMetadata::source_span_contains(source, point.source) and DebuggerBreakpoints::breakpoint_matches_branch(point, branch):
                    observed: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::breakpoint_observe_hit(point, branch)
                    return true if DebuggerBreakpoints::breakpoint_should_stop(observed, branch)
            return false

        def breakpoint_table_would_stop_at_instruction(table: BreakpointTable, branch: DebuggerIdentity::DebugId, source: DebuggerIdentity::SourceSpan, instruction: u64) -> bool:
            return false if table.count > Breakpoint::BREAKPOINT_MANAGER_CAPACITY or not DebuggerMetadata::source_span_is_valid(source) or instruction == Breakpoint::BREAKPOINT_MANAGER_NO_INSTRUCTION
            for index in 0..<table.count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                if point.kind == DebuggerBreakpoints::BreakpointKind.Source and point.status == DebuggerBreakpoints::BreakpointStatus.Verified and table.resolved_instructions[index] == instruction and DebuggerMetadata::source_span_contains(source, point.source) and DebuggerBreakpoints::breakpoint_matches_branch(point, branch):
                    observed: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::breakpoint_observe_hit(point, branch)
                    return true if DebuggerBreakpoints::breakpoint_should_stop(observed, branch)
            return false
