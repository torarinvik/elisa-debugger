# Build-aware breakpoint storage and resolution.  Resolution is explicit so a
# client can show pending breakpoints rather than silently dropping them.

include "./breakpoint.elisa"
include "../core/identity.elisa"

module DebuggerBreakpointManager:
    private:
        const BREAKPOINT_CAPACITY: usize = 256
        const BREAKPOINT_FIRST_ID: u64 = 1
        const BREAKPOINT_MAX_ID: u64 = 18446744073709551615
        const BREAKPOINT_NO_SOURCE: u64 = 0
        const BREAKPOINT_NO_LINE: u64 = 0
        const BREAKPOINT_KIND_MAX: u16 = 5
        const BREAKPOINT_STATUS_MAX: u16 = 3

    public:
        struct BreakpointTable:
            points: mutable DebuggerBreakpoints::Breakpoint[BREAKPOINT_CAPACITY]
            count: mutable usize
            next_id: mutable u64

        struct BreakpointResult:
            id: mutable DebuggerIdentity::DebugId
            line: mutable u32
            verified: mutable bool

        struct BreakpointReplacement:
            accepted: mutable bool
            table: mutable BreakpointTable
            results: mutable BreakpointResult[BREAKPOINT_CAPACITY]
            count: mutable usize

        def breakpoint_table_new() -> BreakpointTable:
            table: mutable BreakpointTable = zeroed
            table.count <- 0
            table.next_id <- BREAKPOINT_FIRST_ID
            return table

        def breakpoint_table_add(table: BreakpointTable, point: DebuggerBreakpoints::Breakpoint) -> BreakpointTable:
            updated: mutable BreakpointTable = table
            return updated if table.count >= BREAKPOINT_CAPACITY or table.next_id == 0 or table.next_id == BREAKPOINT_MAX_ID
            return updated if point.kind.u16() > BREAKPOINT_KIND_MAX or point.status.u16() > BREAKPOINT_STATUS_MAX or point.status == DebuggerBreakpoints::BreakpointStatus.Invalid
            return updated if point.kind == DebuggerBreakpoints::BreakpointKind.Source and not DebuggerMetadata::source_location_is_valid(point.source)
            for index in 0..<table.count:
                return updated if table.points[index].id.value == table.next_id
            updated.points[table.count] <- point
            updated.points[table.count].id <- DebuggerIdentity::debug_id(table.next_id)
            updated.points[table.count].status <- DebuggerBreakpoints::BreakpointStatus.Pending
            updated.count <- table.count + 1
            updated.next_id <- table.next_id + 1
            return updated

        # DAP setBreakpoints replaces the source's full set in one operation.
        # Validate capacity and IDs before constructing a changed table so an
        # invalid request can never remove the client's previous breakpoints.
        def breakpoint_table_replace_source(table: BreakpointTable, source: DebuggerIdentity::DebugId, branch: DebuggerIdentity::DebugId, lines: u32&, requested_count: usize) -> BreakpointReplacement:
            replacement: mutable BreakpointReplacement = zeroed
            return replacement if not breakpoint_table_is_valid(table) or requested_count > BREAKPOINT_CAPACITY or source.value == BREAKPOINT_NO_SOURCE
            retained_count: mutable usize = 0
            for index in 0..<table.count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                retained_count <- retained_count + 1 if point.kind != DebuggerBreakpoints::BreakpointKind.Source or point.source.file.value != source.value
            return replacement if retained_count > BREAKPOINT_CAPACITY or requested_count > BREAKPOINT_CAPACITY - retained_count
            return replacement if requested_count.u64() > BREAKPOINT_MAX_ID - table.next_id
            for index in 0..<requested_count:
                return replacement if lines[index] == BREAKPOINT_NO_LINE
            updated: mutable BreakpointTable = table
            updated.count <- 0
            for index in 0..<table.count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                if point.kind != DebuggerBreakpoints::BreakpointKind.Source or point.source.file.value != source.value:
                    updated.points[updated.count] <- point
                    updated.count <- updated.count + 1
            for index in 0..<requested_count:
                point: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::Breakpoint{
                    id: DebuggerIdentity::debug_id(updated.next_id),
                    branch: branch,
                    kind: DebuggerBreakpoints::BreakpointKind.Source,
                    status: DebuggerBreakpoints::BreakpointStatus.Pending,
                    source: DebuggerMetadata::SourceLocation{file: source, line: lines[index], column: 0, discriminator: 0},
                    condition: DebuggerIdentity::debug_id(0),
                    hit_target: 0,
                    hit_count: 0,
                    hit_stride: BREAKPOINT_FIRST_ID,
                    task: DebuggerIdentity::debug_id(0),
                    logpoint: false,
                    temporary: false
                }
                updated.points[updated.count] <- point
                replacement.results[index] <- BreakpointResult{id: point.id, line: lines[index], verified: false}
                updated.count <- updated.count + 1
                updated.next_id <- updated.next_id + 1
            replacement.table <- updated
            replacement.count <- requested_count
            replacement.accepted <- true
            return replacement

        def breakpoint_table_resolve(table: BreakpointTable, source: DebuggerIdentity::DebugId, line: u64) -> BreakpointTable:
            updated: mutable BreakpointTable = table
            return updated if table.count > BREAKPOINT_CAPACITY
            return updated if source.value == BREAKPOINT_NO_SOURCE or line == BREAKPOINT_NO_LINE
            for index in 0..<table.count:
                if table.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source and table.points[index].source.file.value == source.value and table.points[index].source.line == line:
                    updated.points[index].status <- DebuggerBreakpoints::BreakpointStatus.Verified
            return updated

        def breakpoint_table_count(table: BreakpointTable) -> usize:
            return table.count

        def breakpoint_table_is_valid(table: BreakpointTable) -> bool:
            return false if table.count > BREAKPOINT_CAPACITY or table.next_id == 0 or table.next_id > BREAKPOINT_MAX_ID
            for index in 0..<table.count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                return false if point.id.value == 0 or point.id.value >= table.next_id
                return false if point.kind.u16() > BREAKPOINT_KIND_MAX or point.status.u16() > BREAKPOINT_STATUS_MAX or point.status == DebuggerBreakpoints::BreakpointStatus.Invalid
                return false if point.kind == DebuggerBreakpoints::BreakpointKind.Source and not DebuggerMetadata::source_location_is_valid(point.source)
                for previous in 0..<index:
                    return false if table.points[previous].id.value == point.id.value
            return true

        def breakpoint_table_should_stop(table: mutable BreakpointTable&, branch: DebuggerIdentity::DebugId, source: DebuggerIdentity::SourceSpan) -> bool:
            return false if table.count > BREAKPOINT_CAPACITY or not DebuggerMetadata::source_span_is_valid(source)
            should_stop: mutable bool = false
            for index in 0..<table.count:
                if table.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source and table.points[index].status == DebuggerBreakpoints::BreakpointStatus.Verified and DebuggerMetadata::source_span_contains(source, table.points[index].source) and DebuggerBreakpoints::breakpoint_matches_branch(table.points[index], branch):
                    observed: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::breakpoint_observe_hit(table.points[index], branch)
                    table.points[index] <- observed
                    should_stop <- true if DebuggerBreakpoints::breakpoint_should_stop(observed, branch)
            return should_stop

        # Reverse navigation must inspect breakpoint policy without recording a
        # new hit.  Work on a local observed copy so the forward hit counter is
        # unchanged while still applying target/stride/logpoint rules.
        def breakpoint_table_would_stop(table: BreakpointTable, branch: DebuggerIdentity::DebugId, source: DebuggerIdentity::SourceSpan) -> bool:
            return false if table.count > BREAKPOINT_CAPACITY or not DebuggerMetadata::source_span_is_valid(source)
            for index in 0..<table.count:
                point: DebuggerBreakpoints::Breakpoint = table.points[index]
                if point.kind == DebuggerBreakpoints::BreakpointKind.Source and point.status == DebuggerBreakpoints::BreakpointStatus.Verified and DebuggerMetadata::source_span_contains(source, point.source) and DebuggerBreakpoints::breakpoint_matches_branch(point, branch):
                    observed: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::breakpoint_observe_hit(point, branch)
                    return true if DebuggerBreakpoints::breakpoint_should_stop(observed, branch)
            return false
