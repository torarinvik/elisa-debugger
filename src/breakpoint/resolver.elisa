# Build-aware source and function breakpoint resolution.  Pending requests are
# retained until metadata for the selected build is installed.

include "./breakpoint.elisa"
include "../core/identity.elisa"
include "../metadata/source.elisa"

module DebuggerBreakpointResolver:
    private:
        const RESOLUTION_CAPACITY: usize = 512
        const RESOLUTION_LOCATION_CAPACITY: usize = 32
        const NO_INSTRUCTION: u64 = 0

    public:
        struct Candidate:
            id: mutable DebuggerIdentity::DebugId
            function: mutable DebuggerIdentity::DebugId
            source: mutable DebuggerIdentity::SourceSpan
            instruction: mutable u64

        struct Resolver:
            candidates: mutable Candidate[RESOLUTION_CAPACITY]
            count: mutable usize

        struct Resolution:
            status: mutable DebuggerMetadata::BreakpointResolution
            instruction: mutable u64
            matched: mutable usize
            instructions: mutable u64[RESOLUTION_LOCATION_CAPACITY]

        def resolver_new() -> Resolver:
            return zeroed

        def resolver_add(resolver: mutable Resolver&, candidate: Candidate) -> bool:
            return false if resolver.count >= RESOLUTION_CAPACITY
            resolver.candidates[resolver.count] <- candidate
            resolver.count <- resolver.count + 1
            return true

        def resolver_source(resolver: mutable Resolver&, location: DebuggerMetadata::SourceLocation) -> Resolution:
            result: mutable Resolution = zeroed
            result.status <- DebuggerMetadata::BreakpointResolution.Unresolved
            result.instruction <- NO_INSTRUCTION
            for index in 0..<resolver.count:
                if DebuggerMetadata::source_span_contains(resolver.candidates[index].source, location):
                    result.instruction <- resolver.candidates[index].instruction
                    result.matched <- result.matched + 1
                    result.instructions[result.matched - 1] <- resolver.candidates[index].instruction if result.matched <= RESOLUTION_LOCATION_CAPACITY
            result.status <- DebuggerMetadata::BreakpointResolution.Resolved if result.matched == 1
            result.status <- DebuggerMetadata::BreakpointResolution.PartiallyResolved if result.matched > 1
            return result

        def resolver_function(resolver: mutable Resolver&, function: DebuggerIdentity::DebugId) -> Resolution:
            result: mutable Resolution = zeroed
            result.status <- DebuggerMetadata::BreakpointResolution.Unresolved
            for index in 0..<resolver.count:
                if resolver.candidates[index].function.value == function.value:
                    result.instruction <- resolver.candidates[index].instruction
                    result.matched <- result.matched + 1
                    result.instructions[result.matched - 1] <- resolver.candidates[index].instruction if result.matched <= RESOLUTION_LOCATION_CAPACITY
            result.status <- DebuggerMetadata::BreakpointResolution.Resolved if result.matched == 1
            result.status <- DebuggerMetadata::BreakpointResolution.PartiallyResolved if result.matched > 1
            return result

        def resolution_instruction_at(resolution: Resolution, index: usize) -> u64:
            return NO_INSTRUCTION if index >= resolution.matched or index >= RESOLUTION_LOCATION_CAPACITY
            return resolution.instructions[index]
