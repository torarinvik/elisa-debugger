# Generation-aware data breakpoints.  A watched identity is logical storage,
# never a recycled native address, so reuse cannot produce a false history hit.

include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerWatchpoints:
    private:
        const module Access:
            BREAKPOINT_WATCHPOINT_ACCESS_KIND_MAX: u16 = 2

        const module Detail:
            BREAKPOINT_WATCHPOINT_DETAIL_CAPACITY: u32 = 1
            STALE: u32 = 2
            BREAKPOINT_WATCHPOINT_DETAIL_ENUM: u32 = 3

        const module Watchpoint:
            BREAKPOINT_WATCHPOINT_CAPACITY: usize = 128
            BREAKPOINT_WATCHPOINT_FIRST_ID: u64 = 1
            BREAKPOINT_WATCHPOINT_MAX_ID: u64 = 18446744073709551615
            BREAKPOINT_WATCHPOINT_MAX_HIT_COUNT: u64 = 18446744073709551615
            BREAKPOINT_WATCHPOINT_NO_VALUE: u64 = 0
            NO_ALLOCATION: u64 = 0
            BREAKPOINT_WATCHPOINT_NO_GENERATION: u64 = 0
            BREAKPOINT_WATCHPOINT_STATE_MAX: u16 = 3


    public:
        enum AccessKind:
            Read
            Write
            ReadWrite

        enum WatchpointState:
            Pending
            Verified
            Disabled
            Stale

        struct DataBreakpoint:
            id: mutable DebuggerIdentity::DebugId
            allocation: mutable DebuggerIdentity::AllocationIdentity
            access: mutable AccessKind
            state: mutable WatchpointState
            generation: mutable u64
            last_value_hash: mutable u64
            has_value: mutable bool
            hit_count: mutable u64

        struct WatchpointTable:
            points: mutable DataBreakpoint[Watchpoint::BREAKPOINT_WATCHPOINT_CAPACITY]
            count: mutable usize
            next_id: mutable u64

        struct Observation:
            point: mutable DataBreakpoint
            stop: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def watchpoints_new() -> WatchpointTable:
            table: mutable WatchpointTable = zeroed
            table.next_id <- Watchpoint::BREAKPOINT_WATCHPOINT_FIRST_ID
            return table

        def watchpoints_add(table: mutable WatchpointTable&, allocation: DebuggerIdentity::AllocationIdentity, access: AccessKind, generation: u64) -> DebuggerIdentity::DebugId:
            return DebuggerIdentity::debug_id(Watchpoint::BREAKPOINT_WATCHPOINT_NO_VALUE) if table.count >= Watchpoint::BREAKPOINT_WATCHPOINT_CAPACITY or table.next_id == 0 or table.next_id == Watchpoint::BREAKPOINT_WATCHPOINT_MAX_ID or allocation.allocation.value == Watchpoint::NO_ALLOCATION or allocation.generation == Watchpoint::BREAKPOINT_WATCHPOINT_NO_GENERATION or generation == Watchpoint::BREAKPOINT_WATCHPOINT_NO_GENERATION or access.u16() > Access::BREAKPOINT_WATCHPOINT_ACCESS_KIND_MAX
            for index in 0..<table.count:
                return DebuggerIdentity::debug_id(Watchpoint::BREAKPOINT_WATCHPOINT_NO_VALUE) if table.points[index].id.value == table.next_id
            index: usize = table.count
            table.points[index] <- DataBreakpoint{id: DebuggerIdentity::debug_id(table.next_id), allocation: allocation, access: access, state: WatchpointState.Verified, generation: generation, last_value_hash: Watchpoint::BREAKPOINT_WATCHPOINT_NO_VALUE, has_value: false, hit_count: 0}
            table.count <- table.count + 1
            table.next_id <- table.next_id + Watchpoint::BREAKPOINT_WATCHPOINT_FIRST_ID
            return table.points[index].id

        def watchpoints_find(table: mutable WatchpointTable&, id: DebuggerIdentity::DebugId) -> DataBreakpoint:
            result: mutable DataBreakpoint = zeroed
            return result if table.count > Watchpoint::BREAKPOINT_WATCHPOINT_CAPACITY
            for index in 0..<table.count:
                return table.points[index] if table.points[index].id.value == id.value
            return result

        def watchpoints_is_valid(table: WatchpointTable) -> bool:
            return false if table.count > Watchpoint::BREAKPOINT_WATCHPOINT_CAPACITY or table.next_id == Watchpoint::BREAKPOINT_WATCHPOINT_NO_VALUE or table.next_id > Watchpoint::BREAKPOINT_WATCHPOINT_MAX_ID
            return false if table.next_id != table.count.u64() + Watchpoint::BREAKPOINT_WATCHPOINT_FIRST_ID
            for index in 0..<table.count:
                point: DataBreakpoint = table.points[index]
                return false if point.id.value == Watchpoint::BREAKPOINT_WATCHPOINT_NO_VALUE or point.allocation.allocation.value == Watchpoint::NO_ALLOCATION or point.allocation.generation == Watchpoint::BREAKPOINT_WATCHPOINT_NO_GENERATION or point.access.u16() > Access::BREAKPOINT_WATCHPOINT_ACCESS_KIND_MAX or point.state.u16() > Watchpoint::BREAKPOINT_WATCHPOINT_STATE_MAX or point.generation == Watchpoint::BREAKPOINT_WATCHPOINT_NO_GENERATION or point.hit_count > Watchpoint::BREAKPOINT_WATCHPOINT_MAX_HIT_COUNT
                return false if point.id.value >= table.next_id
                for previous in 0..<index:
                    return false if table.points[previous].id.value == point.id.value
            return true

        def watchpoint_observe(table: mutable WatchpointTable&, id: DebuggerIdentity::DebugId, allocation: DebuggerIdentity::AllocationIdentity, value_hash: u64, generation: u64) -> Observation:
            return watchpoint_observe_access(table, id, allocation, value_hash, generation, AccessKind.Write)

        def watchpoint_observe_access(table: mutable WatchpointTable&, id: DebuggerIdentity::DebugId, allocation: DebuggerIdentity::AllocationIdentity, value_hash: u64, generation: u64, observed: AccessKind) -> Observation:
            result: mutable Observation = zeroed
            result.failure <- DebuggerErrors::no_error()
            if table.count > Watchpoint::BREAKPOINT_WATCHPOINT_CAPACITY:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::BREAKPOINT_WATCHPOINT_DETAIL_CAPACITY)
                return result
            if not watchpoints_is_valid(table):
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::BREAKPOINT_WATCHPOINT_DETAIL_ENUM)
                return result
            if observed.u16() > Access::BREAKPOINT_WATCHPOINT_ACCESS_KIND_MAX:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::BREAKPOINT_WATCHPOINT_DETAIL_ENUM)
                return result
            for index in 0..<table.count:
                if table.points[index].id.value == id.value:
                    result.point <- table.points[index]
                    return result if table.points[index].state != WatchpointState.Verified
                    if table.points[index].generation != generation or allocation.allocation.value != table.points[index].allocation.allocation.value or allocation.generation != table.points[index].allocation.generation:
                        table.points[index].state <- WatchpointState.Stale
                        result.point <- table.points[index]
                        result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, Detail::STALE)
                        return result
                    return result if table.points[index].access != AccessKind.ReadWrite and observed != AccessKind.ReadWrite and table.points[index].access != observed
                    return result if allocation.offset != table.points[index].allocation.offset
                    result.stop <- table.points[index].has_value and table.points[index].last_value_hash != value_hash
                    table.points[index].last_value_hash <- value_hash
                    table.points[index].has_value <- true
                    table.points[index].hit_count <- Watchpoint::BREAKPOINT_WATCHPOINT_MAX_HIT_COUNT if table.points[index].hit_count == Watchpoint::BREAKPOINT_WATCHPOINT_MAX_HIT_COUNT
                    table.points[index].hit_count <- table.points[index].hit_count + Watchpoint::BREAKPOINT_WATCHPOINT_FIRST_ID if table.points[index].hit_count < Watchpoint::BREAKPOINT_WATCHPOINT_MAX_HIT_COUNT
                    result.point <- table.points[index]
                    return result
            result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::BREAKPOINT_WATCHPOINT_DETAIL_CAPACITY)
            return result

        def watchpoints_count(table: WatchpointTable) -> usize:
            return table.count
