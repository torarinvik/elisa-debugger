# Compiler/runtime discovery and compatibility checks.  The actual process
# invocation remains a host operation; all compatibility policy is Elisa data.

include "./manifest.elisa"
include "../core/errors.elisa"

module DebuggerCompilerDiscovery:
    private:
        const REQUIRED_COMPILER_MAJOR: u32 = 1
        const REQUIRED_RUNTIME_MAJOR: u32 = 1
        const DETAIL_TOOL_MISSING: u32 = 1
        const DETAIL_VERSION_MISMATCH: u32 = 2

    public:
        struct ToolIdentity:
            path_id: mutable u64
            revision: mutable u64
            major: mutable u32
            present: mutable bool

        struct Toolchain:
            compiler: mutable ToolIdentity
            runtime: mutable ToolIdentity
            compatible: mutable bool

        def toolchain_new() -> Toolchain:
            empty: ToolIdentity = ToolIdentity{path_id: 0, revision: 0, major: 0, present: false}
            return Toolchain{compiler: empty, runtime: empty, compatible: false}

        def toolchain_validate(toolchain: Toolchain) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, DETAIL_TOOL_MISSING) if not toolchain.compiler.present or not toolchain.runtime.present
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_VERSION_MISMATCH) if toolchain.compiler.major != REQUIRED_COMPILER_MAJOR or toolchain.runtime.major != REQUIRED_RUNTIME_MAJOR
            return DebuggerErrors::no_error()

        def toolchain_is_compatible(toolchain: Toolchain) -> bool:
            return DebuggerErrors::error_is_ok(toolchain_validate(toolchain))
