# Compiler/runtime discovery and compatibility checks.  The actual process
# invocation remains a host operation; all compatibility policy is Elisa data.

include "./manifest.elisa"
include "../core/errors.elisa"

module DebuggerCompilerDiscovery:
    private:
        const module Compatibility:
            COMPILER_MAJOR: u32 = 1
            RUNTIME_MAJOR: u32 = 1

        const module Detail:
            TOOL_MISSING: u32 = 1
            VERSION_MISMATCH: u32 = 2
            IDENTITY_MISSING: u32 = 3
            SELECTION_SOURCE: u32 = 4

        const module Selection:
            SOURCE_MAX: u16 = 1

        const module ToolPath:
            BUILD_DISCOVERY_TOOL_PATH_CAPACITY: usize = 4096
            BUILD_DISCOVERY_TOOL_PATH_HASH_OFFSET_BASIS: u64 = 14695981039346656037
            BUILD_DISCOVERY_TOOL_PATH_HASH_PRIME: u64 = 1099511628211
            ID_NONZERO_MASK: u64 = 1

    public:
        struct ToolIdentity:
            path_id: mutable u64
            revision: mutable u64
            major: mutable u32
            present: mutable bool

        struct Toolchain:
            compiler: mutable ToolIdentity
            runtime: mutable ToolIdentity
            compatible: mutable bool

        enum ToolchainSource:
            ExplicitOverride
            Discovered

        struct ToolchainSelection:
            toolchain: mutable Toolchain
            source: mutable ToolchainSource

        def toolchain_new() -> Toolchain:
            empty: ToolIdentity = ToolIdentity{path_id: 0, revision: 0, major: 0, present: false}
            return Toolchain{compiler: empty, runtime: empty, compatible: false}

        def toolchain_validate(toolchain: Toolchain) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, Detail::TOOL_MISSING) if not toolchain.compiler.present or not toolchain.runtime.present
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::IDENTITY_MISSING) if toolchain.compiler.path_id == 0 or toolchain.runtime.path_id == 0 or toolchain.compiler.revision == 0 or toolchain.runtime.revision == 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::VERSION_MISMATCH) if toolchain.compiler.major != Compatibility::COMPILER_MAJOR or toolchain.runtime.major != Compatibility::RUNTIME_MAJOR
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::VERSION_MISMATCH) if toolchain.compiler.revision != toolchain.runtime.revision
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::VERSION_MISMATCH) if not toolchain.compatible
            return DebuggerErrors::no_error()

        # An explicit override is authoritative. If it is absent or
        # incompatible, return its failure to the caller rather than silently
        # falling back to a different compiler/runtime pair.
        def toolchain_select(has_explicit_override: bool, explicit_override: Toolchain, discovered: Toolchain) -> ToolchainSelection:
            return ToolchainSelection{toolchain: explicit_override, source: ToolchainSource.ExplicitOverride} if has_explicit_override
            return ToolchainSelection{toolchain: discovered, source: ToolchainSource.Discovered}

        def toolchain_selection_validate(selection: ToolchainSelection) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::SELECTION_SOURCE) if selection.source.u16() > Selection::SOURCE_MAX
            return toolchain_validate(selection.toolchain)

        def toolchain_is_compatible(toolchain: Toolchain) -> bool:
            return DebuggerErrors::error_is_ok(toolchain_validate(toolchain))

        # Derives a stable nonzero identity from the exact UTF-8 path bytes. A
        # process launcher can compare this with the path selected during
        # toolchain validation before starting an executable.
        def tool_path_identity(path: cstr) -> u64:
            hash: mutable u64 = ToolPath::BUILD_DISCOVERY_TOOL_PATH_HASH_OFFSET_BASIS
            for index in 0..<ToolPath::BUILD_DISCOVERY_TOOL_PATH_CAPACITY:
                byte: u8 = path[index].u8()
                return 0 if index == 0 and byte == 0
                return hash | ToolPath::ID_NONZERO_MASK if byte == 0
                hash <- (hash ^ byte.u64()) * ToolPath::BUILD_DISCOVERY_TOOL_PATH_HASH_PRIME
            return 0
