# Structured compiler invocation configuration.  The debugger never builds a
# shell command string; adapters pass validated argument identities instead.

include "./discovery.elisa"
include "../core/errors.elisa"

module DebuggerBuildInvocation:
    private:
        const module Argument:
            BUILD_INVOCATION_ARGUMENT_CAPACITY: usize = 64

        const module Detail:
            TOOLCHAIN: u32 = 1
            BUILD_INVOCATION_DETAIL_ARGUMENTS: u32 = 2
            BUILD_INVOCATION_DETAIL_OUTPUT: u32 = 3

        const module Sentinel:
            BUILD_INVOCATION_SENTINEL_NO_ID: u64 = 0


    public:
        struct Invocation:
            toolchain: mutable DebuggerCompilerDiscovery::Toolchain
            arguments: mutable u64[Argument::BUILD_INVOCATION_ARGUMENT_CAPACITY]
            argument_count: mutable usize
            source: mutable u64
            output: mutable u64
            debug_metadata: mutable bool
            managed_edir: mutable bool
            recording: mutable bool
            arguments_overflowed: mutable bool

        def invocation_new(toolchain: DebuggerCompilerDiscovery::Toolchain) -> Invocation:
            return Invocation{toolchain: toolchain, arguments: zeroed, argument_count: 0, source: Sentinel::BUILD_INVOCATION_SENTINEL_NO_ID, output: Sentinel::BUILD_INVOCATION_SENTINEL_NO_ID, debug_metadata: false, managed_edir: false, recording: false, arguments_overflowed: false}

        def invocation_add_argument(invocation: Invocation, argument: u64) -> Invocation:
            updated: mutable Invocation = invocation
            if invocation.argument_count >= Argument::BUILD_INVOCATION_ARGUMENT_CAPACITY or argument == Sentinel::BUILD_INVOCATION_SENTINEL_NO_ID:
                updated.arguments_overflowed <- true
                return updated
            updated.arguments[invocation.argument_count] <- argument
            updated.argument_count <- invocation.argument_count + 1
            return updated

        def invocation_validate(invocation: Invocation) -> DebuggerErrors::DebuggerError:
            return DebuggerCompilerDiscovery::toolchain_validate(invocation.toolchain) if not DebuggerCompilerDiscovery::toolchain_is_compatible(invocation.toolchain)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::BUILD_INVOCATION_DETAIL_ARGUMENTS) if invocation.arguments_overflowed or invocation.argument_count > Argument::BUILD_INVOCATION_ARGUMENT_CAPACITY
            for index in 0..<invocation.argument_count:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::BUILD_INVOCATION_DETAIL_ARGUMENTS) if invocation.arguments[index] == Sentinel::BUILD_INVOCATION_SENTINEL_NO_ID
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, Detail::BUILD_INVOCATION_DETAIL_OUTPUT) if invocation.source == Sentinel::BUILD_INVOCATION_SENTINEL_NO_ID or invocation.output == Sentinel::BUILD_INVOCATION_SENTINEL_NO_ID
            return DebuggerErrors::no_error()

        def invocation_is_recordable(invocation: Invocation) -> bool:
            return invocation.debug_metadata and invocation.managed_edir and invocation.recording and DebuggerErrors::error_is_ok(invocation_validate(invocation))
