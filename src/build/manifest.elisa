# Build and artifact identity.  A trace may be opened only when the selected
# executable and source artifacts satisfy the declared compatibility policy.

include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerBuild:
    private:
        const module ArtifactBounds:
            BUILD_MANIFEST_ARTIFACT_BOUNDS_KIND_MAX: u32 = 3
            NO_KIND: u32 = 0
            NO_SIZE: u64 = 0

        const module Detail:
            EXECUTABLE_MISSING: u32 = 1
            SOURCE_MISSING: u32 = 2
            RUNTIME_MISSING: u32 = 3

        const module Manifest:
            BUILD_MANIFEST_SCHEMA: u32 = 1


        def artifact_is_present(artifact: Artifact) -> bool:
            return artifact.present and not DebuggerIdentity::debug_id_is_zero(artifact.id) and artifact.kind != ArtifactBounds::NO_KIND and artifact.kind <= ArtifactBounds::BUILD_MANIFEST_ARTIFACT_BOUNDS_KIND_MAX and artifact.size > ArtifactBounds::NO_SIZE

        def build_identity_is_valid(identity: DebuggerIdentity::BuildIdentity) -> bool:
            return not DebuggerIdentity::debug_id_is_zero(identity.compiler) and not DebuggerIdentity::debug_id_is_zero(identity.runtime) and not DebuggerIdentity::debug_id_is_zero(identity.source) and not DebuggerIdentity::debug_id_is_zero(identity.target) and identity.metadata_version != 0

    public:
        struct Artifact:
            id: mutable DebuggerIdentity::DebugId
            kind: mutable u32
            size: mutable u64
            present: mutable bool

        struct BuildManifest:
            schema: mutable u32
            identity: mutable DebuggerIdentity::BuildIdentity
            executable: mutable Artifact
            source: mutable Artifact
            runtime: mutable Artifact

        def build_manifest_new(identity: DebuggerIdentity::BuildIdentity) -> BuildManifest:
            empty: Artifact = Artifact{id: DebuggerIdentity::debug_id(0), kind: 0, size: 0, present: false}
            return BuildManifest{schema: Manifest::BUILD_MANIFEST_SCHEMA, identity: identity, executable: empty, source: empty, runtime: empty}

        def build_manifest_is_compatible(manifest: BuildManifest, identity: DebuggerIdentity::BuildIdentity) -> bool:
            return false if DebuggerIdentity::debug_id_is_zero(manifest.identity.compiler) or DebuggerIdentity::debug_id_is_zero(manifest.identity.runtime) or DebuggerIdentity::debug_id_is_zero(manifest.identity.source) or DebuggerIdentity::debug_id_is_zero(manifest.identity.target)
            return false if DebuggerIdentity::debug_id_is_zero(identity.compiler) or DebuggerIdentity::debug_id_is_zero(identity.runtime) or DebuggerIdentity::debug_id_is_zero(identity.source) or DebuggerIdentity::debug_id_is_zero(identity.target)
            return false if manifest.identity.metadata_version == 0 or identity.metadata_version == 0
            return false if manifest.identity.metadata_version != identity.metadata_version
            return manifest.schema == Manifest::BUILD_MANIFEST_SCHEMA and manifest.identity.compiler.value == identity.compiler.value and manifest.identity.runtime.value == identity.runtime.value and manifest.identity.source.value == identity.source.value and manifest.identity.target.value == identity.target.value

        def build_manifest_require_artifacts(manifest: BuildManifest) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::EXECUTABLE_MISSING) if manifest.schema != Manifest::BUILD_MANIFEST_SCHEMA or not build_identity_is_valid(manifest.identity)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, Detail::EXECUTABLE_MISSING) if not artifact_is_present(manifest.executable)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, Detail::SOURCE_MISSING) if not artifact_is_present(manifest.source)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, Detail::RUNTIME_MISSING) if not artifact_is_present(manifest.runtime)
            return DebuggerErrors::no_error()

        def build_manifest_is_valid(manifest: BuildManifest) -> bool:
            return DebuggerErrors::error_is_ok(build_manifest_require_artifacts(manifest))
