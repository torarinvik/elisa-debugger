# Structured Elisa compiler execution. Paths and options remain separate argv
# entries all the way to posix_spawn; no shell string is constructed.

include "./discovery.elisa"
include "../platform/child_process.elisa"
include "../core/errors.elisa"

module DebuggerBuildRunner:
    private:
        const ARGUMENT_TEXT_CAPACITY: usize = 4096
        const COMMAND_FIRST_ARGUMENT_INDEX: usize = 0
        const COMMAND_DEBUG_ARGUMENT_COUNT: usize = 8
        const COMMAND_STANDARD_ARGUMENT_COUNT: usize = 7
        const ARTIFACT_MODE_MAX: u16 = 1
        const OPTIMIZATION_MAX: u16 = 3
        const DETAIL_COMPILER_PATH: u32 = 2
        const DETAIL_SOURCE_PATH: u32 = 3
        const DETAIL_OUTPUT_PATH: u32 = 4
        const DETAIL_ENUM: u32 = 5
        const DETAIL_OUTPUT_LIMIT: u32 = 6
        const DETAIL_SPAWN: u32 = 7
        const DETAIL_COMPILER_EXIT: u32 = 8
        const DETAIL_OUTPUT_TRUNCATED: u32 = 9
        const PROCESS_EXIT_SUCCESS: i32 = 0

        const EMIT_FLAG: cstr = "-emit"
        const EMIT_EDIR: cstr = "edir"
        const EMIT_EXECUTABLE: cstr = "exe"
        const OPTIMIZATION_ZERO: cstr = "-O0"
        const OPTIMIZATION_ONE: cstr = "-O1"
        const OPTIMIZATION_TWO: cstr = "-O2"
        const OPTIMIZATION_THREE: cstr = "-O3"
        const DEBUG_METADATA_FLAG: cstr = "-g"
        const OUTPUT_FLAG: cstr = "-o"

        def cstr_has_terminator(value: cstr, capacity: usize) -> bool:
            for index in 0..<capacity:
                return true if value[index].u8() == 0
            return false

        def optimization_argument(optimization: Optimization) -> cstr:
            return OPTIMIZATION_ZERO if optimization == Optimization.O0
            return OPTIMIZATION_ONE if optimization == Optimization.O1
            return OPTIMIZATION_TWO if optimization == Optimization.O2
            return OPTIMIZATION_THREE

        def compile_failure(detail: u32) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, detail) if detail <= DETAIL_ENUM
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, detail) if detail == DETAIL_OUTPUT_LIMIT or detail == DETAIL_OUTPUT_TRUNCATED
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, true, detail) if detail == DETAIL_SPAWN
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, detail)

    public:
        enum ArtifactMode:
            ManagedEDIR
            NativeExecutable

        enum Optimization:
            O0
            O1
            O2
            O3

        enum BuildOutcome:
            Complete
            InvalidRequest
            SpawnFailed
            CompilerFailed
            OutputTruncated

        struct CompilerCommand:
            arguments: mutable darray[cstr]
            count: mutable usize
            failure: mutable DebuggerErrors::DebuggerError

        struct BuildResult:
            outcome: mutable BuildOutcome
            process: mutable DebuggerHostProcess::SpawnResult
            failure: mutable DebuggerErrors::DebuggerError

        def compiler_command_build(toolchain: DebuggerCompilerDiscovery::Toolchain, compiler_path: cstr, source_path: cstr, output_path: cstr, mode: ArtifactMode, optimization: Optimization, include_debug_metadata: bool) -> CompilerCommand:
            command: mutable CompilerCommand = zeroed
            command.failure <- DebuggerErrors::no_error()
            toolchain_failure: DebuggerErrors::DebuggerError = DebuggerCompilerDiscovery::toolchain_validate(toolchain)
            if not DebuggerErrors::error_is_ok(toolchain_failure):
                command.failure <- toolchain_failure
                return command
            if not cstr_has_terminator(compiler_path, ARGUMENT_TEXT_CAPACITY) or compiler_path[0].u8() == 0 or DebuggerCompilerDiscovery::tool_path_identity(compiler_path) != toolchain.compiler.path_id:
                command.failure <- compile_failure(DETAIL_COMPILER_PATH)
                return command
            if not cstr_has_terminator(source_path, ARGUMENT_TEXT_CAPACITY) or source_path[0].u8() == 0:
                command.failure <- compile_failure(DETAIL_SOURCE_PATH)
                return command
            if not cstr_has_terminator(output_path, ARGUMENT_TEXT_CAPACITY) or output_path[0].u8() == 0:
                command.failure <- compile_failure(DETAIL_OUTPUT_PATH)
                return command
            if mode.u16() > ARTIFACT_MODE_MAX or optimization.u16() > OPTIMIZATION_MAX:
                command.failure <- compile_failure(DETAIL_ENUM)
                return command
            emit_mode: cstr = EMIT_EDIR if mode == ArtifactMode.ManagedEDIR else EMIT_EXECUTABLE
            if include_debug_metadata:
                command.arguments <- [compiler_path, EMIT_FLAG, emit_mode, optimization_argument(optimization), DEBUG_METADATA_FLAG, OUTPUT_FLAG, output_path, source_path, null]
                command.count <- COMMAND_DEBUG_ARGUMENT_COUNT
            else:
                command.arguments <- [compiler_path, EMIT_FLAG, emit_mode, optimization_argument(optimization), OUTPUT_FLAG, output_path, source_path, null]
                command.count <- COMMAND_STANDARD_ARGUMENT_COUNT
            return command

        def compiler_build(toolchain: DebuggerCompilerDiscovery::Toolchain, compiler_path: cstr, source_path: cstr, output_path: cstr, mode: ArtifactMode, optimization: Optimization, include_debug_metadata: bool, output: mutable u8&, output_capacity: usize) -> BuildResult can[Blocking.IO, Unsafe.PointerCast]:
            result: mutable BuildResult = zeroed
            result.outcome <- BuildOutcome.InvalidRequest
            result.failure <- DebuggerErrors::no_error()
            command: CompilerCommand = compiler_command_build(toolchain, compiler_path, source_path, output_path, mode, optimization, include_debug_metadata)
            if not DebuggerErrors::error_is_ok(command.failure):
                result.failure <- command.failure
                return result
            if output_capacity > DebuggerHostProcess::spawn_output_capacity():
                result.failure <- compile_failure(DETAIL_OUTPUT_LIMIT)
                return result
            argv: mutable cstr&& = (&command.arguments[COMMAND_FIRST_ARGUMENT_INDEX]).cast[mutable cstr&&] can Unsafe.PointerCast
            process: DebuggerHostProcess::SpawnResult = DebuggerHostProcess::spawn_capture(compiler_path, argv, output, output_capacity) can Blocking.IO, Unsafe.PointerCast
            result.process <- process
            if process.failure != DebuggerHostProcess::SpawnFailure.None:
                result.outcome <- BuildOutcome.SpawnFailed
                result.failure <- compile_failure(DETAIL_SPAWN)
                return result
            if process.output_truncated:
                result.outcome <- BuildOutcome.OutputTruncated
                result.failure <- compile_failure(DETAIL_OUTPUT_TRUNCATED)
                return result
            if not process.child_spawned or not process.child_reaped or process.terminated_by_signal or process.exit_code != PROCESS_EXIT_SUCCESS:
                result.outcome <- BuildOutcome.CompilerFailed
                result.failure <- compile_failure(DETAIL_COMPILER_EXIT)
                return result
            result.outcome <- BuildOutcome.Complete
            result.failure <- DebuggerErrors::no_error()
            return result
