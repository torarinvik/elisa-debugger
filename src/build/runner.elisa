# Structured Elisa compiler execution. Paths and options remain separate argv
# entries all the way to posix_spawn; no shell string is constructed.

include "./discovery.elisa"
include "../platform/child_process.elisa"
include "../core/errors.elisa"

module DebuggerBuildRunner:
    private:
        const module Path:
            ARGUMENT_TEXT_CAPACITY: usize = 4096

        const module Command:
            BUILD_COMMAND_FIRST_ARGUMENT_INDEX: usize = 0
            DEBUG_ARGUMENT_COUNT: usize = 8
            STANDARD_ARGUMENT_COUNT: usize = 7

        const module Artifact:
            MODE_MAX: u16 = 1
            OPTIMIZATION_MAX: u16 = 3

        const module Detail:
            COMPILER_PATH: u32 = 2
            SOURCE_PATH: u32 = 3
            OUTPUT_PATH: u32 = 4
            RUNNER_DETAIL_ENUM: u32 = 5
            OUTPUT_LIMIT: u32 = 6
            SPAWN: u32 = 7
            COMPILER_EXIT: u32 = 8
            OUTPUT_TRUNCATED: u32 = 9

        const module Process:
            EXIT_SUCCESS: i32 = 0

        const module Argument:
            EMIT_FLAG: cstr = "-emit"
            EMIT_EDIR: cstr = "edir"
            EMIT_EXECUTABLE: cstr = "exe"
            OPTIMIZATION_O0: cstr = "-O0"
            OPTIMIZATION_O1: cstr = "-O1"
            OPTIMIZATION_O2: cstr = "-O2"
            OPTIMIZATION_O3: cstr = "-O3"
            DEBUG_METADATA_FLAG: cstr = "-g"
            OUTPUT_FLAG: cstr = "-o"

        def cstr_has_terminator(value: cstr, capacity: usize) -> bool:
            for index in 0..<capacity:
                return true if value[index].u8() == 0
            return false

        def optimization_argument(optimization: Optimization) -> cstr:
            return Argument::OPTIMIZATION_O0 if optimization == Optimization.O0
            return Argument::OPTIMIZATION_O1 if optimization == Optimization.O1
            return Argument::OPTIMIZATION_O2 if optimization == Optimization.O2
            return Argument::OPTIMIZATION_O3

        def compile_failure(detail: u32) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, detail) if detail <= Detail::RUNNER_DETAIL_ENUM
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, detail) if detail == Detail::OUTPUT_LIMIT or detail == Detail::OUTPUT_TRUNCATED
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, true, detail) if detail == Detail::SPAWN
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, detail)

    public:
        enum ArtifactMode:
            ManagedEDIR
            NativeExecutable

        enum Optimization:
            O0
            O1
            O2
            O3

        enum BuildOutcome:
            Complete
            InvalidRequest
            SpawnFailed
            CompilerFailed
            OutputTruncated

        struct CompilerCommand:
            arguments: mutable darray[cstr]
            count: mutable usize
            failure: mutable DebuggerErrors::DebuggerError

        struct BuildResult:
            outcome: mutable BuildOutcome
            process: mutable DebuggerHostProcess::SpawnResult
            failure: mutable DebuggerErrors::DebuggerError

        def compiler_command_build(toolchain: DebuggerCompilerDiscovery::Toolchain, compiler_path: cstr, source_path: cstr, output_path: cstr, mode: ArtifactMode, optimization: Optimization, include_debug_metadata: bool) -> CompilerCommand:
            command: mutable CompilerCommand = zeroed
            command.failure <- DebuggerErrors::no_error()
            toolchain_failure: DebuggerErrors::DebuggerError = DebuggerCompilerDiscovery::toolchain_validate(toolchain)
            if not DebuggerErrors::error_is_ok(toolchain_failure):
                command.failure <- toolchain_failure
                return command
            if not cstr_has_terminator(compiler_path, Path::ARGUMENT_TEXT_CAPACITY) or compiler_path[0].u8() == 0 or DebuggerCompilerDiscovery::tool_path_identity(compiler_path) != toolchain.compiler.path_id:
                command.failure <- compile_failure(Detail::COMPILER_PATH)
                return command
            if not cstr_has_terminator(source_path, Path::ARGUMENT_TEXT_CAPACITY) or source_path[0].u8() == 0:
                command.failure <- compile_failure(Detail::SOURCE_PATH)
                return command
            if not cstr_has_terminator(output_path, Path::ARGUMENT_TEXT_CAPACITY) or output_path[0].u8() == 0:
                command.failure <- compile_failure(Detail::OUTPUT_PATH)
                return command
            if mode.u16() > Artifact::MODE_MAX or optimization.u16() > Artifact::OPTIMIZATION_MAX:
                command.failure <- compile_failure(Detail::RUNNER_DETAIL_ENUM)
                return command
            emit_mode: cstr = Argument::EMIT_EDIR if mode == ArtifactMode.ManagedEDIR else Argument::EMIT_EXECUTABLE
            if include_debug_metadata:
                command.arguments <- [compiler_path, Argument::EMIT_FLAG, emit_mode, optimization_argument(optimization), Argument::DEBUG_METADATA_FLAG, Argument::OUTPUT_FLAG, output_path, source_path, null]
                command.count <- Command::DEBUG_ARGUMENT_COUNT
            else:
                command.arguments <- [compiler_path, Argument::EMIT_FLAG, emit_mode, optimization_argument(optimization), Argument::OUTPUT_FLAG, output_path, source_path, null]
                command.count <- Command::STANDARD_ARGUMENT_COUNT
            return command

        def compiler_build(toolchain: DebuggerCompilerDiscovery::Toolchain, compiler_path: cstr, source_path: cstr, output_path: cstr, mode: ArtifactMode, optimization: Optimization, include_debug_metadata: bool, output: mutable u8&, output_capacity: usize) -> BuildResult can[Blocking.IO, Unsafe.PointerCast]:
            result: mutable BuildResult = zeroed
            result.outcome <- BuildOutcome.InvalidRequest
            result.failure <- DebuggerErrors::no_error()
            command: CompilerCommand = compiler_command_build(toolchain, compiler_path, source_path, output_path, mode, optimization, include_debug_metadata)
            if not DebuggerErrors::error_is_ok(command.failure):
                result.failure <- command.failure
                return result
            if output_capacity > DebuggerHostProcess::spawn_output_capacity():
                result.failure <- compile_failure(Detail::OUTPUT_LIMIT)
                return result
            argv: mutable cstr&& = (&command.arguments[Command::BUILD_COMMAND_FIRST_ARGUMENT_INDEX]).cast[mutable cstr&&] can Unsafe.PointerCast
            process: DebuggerHostProcess::SpawnResult = DebuggerHostProcess::spawn_capture(compiler_path, argv, output, output_capacity) can Blocking.IO, Unsafe.PointerCast
            result.process <- process
            if process.failure != DebuggerHostProcess::SpawnFailure.None:
                result.outcome <- BuildOutcome.SpawnFailed
                result.failure <- compile_failure(Detail::SPAWN)
                return result
            if process.output_truncated:
                result.outcome <- BuildOutcome.OutputTruncated
                result.failure <- compile_failure(Detail::OUTPUT_TRUNCATED)
                return result
            if not process.child_spawned or not process.child_reaped or process.terminated_by_signal or process.exit_code != Process::EXIT_SUCCESS:
                result.outcome <- BuildOutcome.CompilerFailed
                result.failure <- compile_failure(Detail::COMPILER_EXIT)
                return result
            result.outcome <- BuildOutcome.Complete
            result.failure <- DebuggerErrors::no_error()
            return result
