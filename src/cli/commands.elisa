# CLI command vocabulary is shared with protocol adapters.  Rendering remains
# a client concern; this module only validates command intent and generation.

include "../core/errors.elisa"

module DebuggerCLI:
    private:
        const NO_EXPECTED_GENERATION: u64 = 0

    public:
        enum Command:
            Unknown
            Run
            Launch
            Attach
            Pause
            Continue
            Step
            ReverseStep
            Seek
            Stack
            Locals
            Evaluate
            Break
            Watch
            Record
            Replay
            SaveTrace
            Branch
            Quit

        struct CommandRequest:
            command: mutable Command
            argument: mutable u64
            expected_generation: mutable u64

        def command_is_mutating(command: Command) -> bool:
            return command == Command.Run or command == Command.Launch or command == Command.Attach or command == Command.Pause or command == Command.Continue or command == Command.Step or command == Command.ReverseStep or command == Command.Seek or command == Command.Break or command == Command.Watch or command == Command.Record or command == Command.Replay or command == Command.SaveTrace or command == Command.Branch or command == Command.Quit

        def command_validate(request: CommandRequest, generation: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, generation.u32()) if request.expected_generation != NO_EXPECTED_GENERATION and request.expected_generation != generation
            return DebuggerErrors::no_error()
