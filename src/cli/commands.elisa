# CLI command vocabulary is shared with protocol adapters.  Rendering remains
# a client concern; this module only validates command intent and generation.

include "../core/errors.elisa"

module DebuggerCLI:
    private:
        const NO_EXPECTED_GENERATION: u64 = 0
        const DETAIL_STALE_GENERATION: u32 = 1
        const DETAIL_COMMAND: u32 = 2
        const DETAIL_ARGUMENT: u32 = 3
        const COMMAND_HASH_MULTIPLIER: u64 = 31
        const COMMAND_MAX_LENGTH: usize = 64
        const COMMAND_MAX_ARGUMENT_DIGITS: usize = 20
        const DECIMAL_BASE: u64 = 10
        const MAX_U64: u64 = 18446744073709551615
        const ASCII_ZERO: u8 = 48
        const ASCII_NINE: u8 = 57
        const ASCII_SPACE: u8 = 32
        const ASCII_TAB: u8 = 9
        const ASCII_LINE_FEED: u8 = 10
        const ASCII_CARRIAGE_RETURN: u8 = 13
        const HASH_RUN: u64 = 113291
        const HASH_LAUNCH: u64 = 3185124275
        const HASH_ATTACH: u64 = 2887708229
        const HASH_PAUSE: u64 = 106440182
        const HASH_CONTINUE: u64 = 2825521278119
        const HASH_NEXT: u64 = 3377907
        const HASH_STEP: u64 = 3540684
        const HASH_REVERSE_STEP: u64 = 96211551034117326
        const HASH_SEEK: u64 = 3526264
        const HASH_STACK: u64 = 109757064
        const HASH_LOCALS: u64 = 3197505128
        const HASH_EVALUATE: u64 = 2886379809945
        const HASH_INSPECT: u64 = 96446734868
        const HASH_BREAK: u64 = 94001407
        const HASH_WATCH: u64 = 112903375
        const HASH_RECORD: u64 = 3360058449
        const HASH_REPLAY: u64 = 3360442343
        const HASH_SAVE_TRACE: u64 = 100858890921416
        const HASH_TRACE_VERIFY: u64 = 98176544592272926
        const HASH_COMPARE: u64 = 91144797413
        const HASH_CHECKPOINT: u64 = 2709093068854664
        const HASH_TASKS: u64 = 110132110
        const HASH_BRANCH: u64 = 2913936802
        const HASH_CLOSE: u64 = 94756344
        const COMMAND_NAME_RUN: cstr = "run"
        const COMMAND_NAME_LAUNCH: cstr = "launch"
        const COMMAND_NAME_ATTACH: cstr = "attach"
        const COMMAND_NAME_PAUSE: cstr = "pause"
        const COMMAND_NAME_CONTINUE: cstr = "continue"
        const COMMAND_NAME_NEXT: cstr = "next"
        const COMMAND_NAME_STEP: cstr = "step"
        const COMMAND_NAME_REVERSE_STEP: cstr = "reverseStep"
        const COMMAND_NAME_SEEK: cstr = "seek"
        const COMMAND_NAME_STACK: cstr = "stack"
        const COMMAND_NAME_LOCALS: cstr = "locals"
        const COMMAND_NAME_EVALUATE: cstr = "evaluate"
        const COMMAND_NAME_INSPECT: cstr = "inspect"
        const COMMAND_NAME_BREAK: cstr = "break"
        const COMMAND_NAME_WATCH: cstr = "watch"
        const COMMAND_NAME_RECORD: cstr = "record"
        const COMMAND_NAME_REPLAY: cstr = "replay"
        const COMMAND_NAME_SAVE_TRACE: cstr = "saveTrace"
        const COMMAND_NAME_TRACE_VERIFY: cstr = "traceVerify"
        const COMMAND_NAME_COMPARE: cstr = "compare"
        const COMMAND_NAME_CHECKPOINT: cstr = "checkpoint"
        const COMMAND_NAME_TASKS: cstr = "tasks"
        const COMMAND_NAME_BRANCH: cstr = "branch"
        const COMMAND_NAME_CLOSE: cstr = "close"
        const COMMAND_TOKEN_INDEX_INCREMENT: usize = 1
        const ASCII_NUL: u8 = 0

    public:
        enum Command:
            Unknown
            Run
            Launch
            Attach
            Pause
            Continue
            Step
            ReverseStep
            Seek
            Stack
            Locals
            Evaluate
            Inspect
            Break
            Watch
            Record
            Replay
            SaveTrace
            TraceVerify
            Compare
            Checkpoint
            Tasks
            Branch
            Quit

        struct CommandRequest:
            command: mutable Command
            argument: mutable u64
            expected_generation: mutable u64

        struct ParsedCommand:
            command: mutable Command
            argument: mutable u64
            argument_present: mutable bool
            expected_generation: mutable u64
            consumed: mutable usize
            valid: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

    private:
        def command_is_whitespace(byte: u8) -> bool:
            return byte == ASCII_SPACE or byte == ASCII_TAB or byte == ASCII_LINE_FEED or byte == ASCII_CARRIAGE_RETURN

        def command_hash_byte(hash: u64, byte: u8) -> u64:
            return hash * COMMAND_HASH_MULTIPLIER + byte.u64()

        def command_token_matches(payload: u8&, start: usize, end: usize, expected: cstr) -> bool:
            cursor: mutable usize = start
            expected_index: mutable usize = 0
            while cursor < end:
                return false if expected[expected_index] == ASCII_NUL
                return false if payload[cursor] != expected[expected_index].u8()
                cursor <- cursor + COMMAND_TOKEN_INDEX_INCREMENT
                expected_index <- expected_index + COMMAND_TOKEN_INDEX_INCREMENT
            return expected[expected_index] == ASCII_NUL

        def command_from_hash(hash: u64, payload: u8&, start: usize, end: usize) -> Command:
            return Command.Run if hash == HASH_RUN and command_token_matches(payload, start, end, COMMAND_NAME_RUN)
            return Command.Launch if hash == HASH_LAUNCH and command_token_matches(payload, start, end, COMMAND_NAME_LAUNCH)
            return Command.Attach if hash == HASH_ATTACH and command_token_matches(payload, start, end, COMMAND_NAME_ATTACH)
            return Command.Pause if hash == HASH_PAUSE and command_token_matches(payload, start, end, COMMAND_NAME_PAUSE)
            return Command.Continue if hash == HASH_CONTINUE and command_token_matches(payload, start, end, COMMAND_NAME_CONTINUE)
            return Command.Step if hash == HASH_NEXT and command_token_matches(payload, start, end, COMMAND_NAME_NEXT)
            return Command.Step if hash == HASH_STEP and command_token_matches(payload, start, end, COMMAND_NAME_STEP)
            return Command.ReverseStep if hash == HASH_REVERSE_STEP and command_token_matches(payload, start, end, COMMAND_NAME_REVERSE_STEP)
            return Command.Seek if hash == HASH_SEEK and command_token_matches(payload, start, end, COMMAND_NAME_SEEK)
            return Command.Stack if hash == HASH_STACK and command_token_matches(payload, start, end, COMMAND_NAME_STACK)
            return Command.Locals if hash == HASH_LOCALS and command_token_matches(payload, start, end, COMMAND_NAME_LOCALS)
            return Command.Evaluate if hash == HASH_EVALUATE and command_token_matches(payload, start, end, COMMAND_NAME_EVALUATE)
            return Command.Inspect if hash == HASH_INSPECT and command_token_matches(payload, start, end, COMMAND_NAME_INSPECT)
            return Command.Break if hash == HASH_BREAK and command_token_matches(payload, start, end, COMMAND_NAME_BREAK)
            return Command.Watch if hash == HASH_WATCH and command_token_matches(payload, start, end, COMMAND_NAME_WATCH)
            return Command.Record if hash == HASH_RECORD and command_token_matches(payload, start, end, COMMAND_NAME_RECORD)
            return Command.Replay if hash == HASH_REPLAY and command_token_matches(payload, start, end, COMMAND_NAME_REPLAY)
            return Command.SaveTrace if hash == HASH_SAVE_TRACE and command_token_matches(payload, start, end, COMMAND_NAME_SAVE_TRACE)
            return Command.TraceVerify if hash == HASH_TRACE_VERIFY and command_token_matches(payload, start, end, COMMAND_NAME_TRACE_VERIFY)
            return Command.Compare if hash == HASH_COMPARE and command_token_matches(payload, start, end, COMMAND_NAME_COMPARE)
            return Command.Checkpoint if hash == HASH_CHECKPOINT and command_token_matches(payload, start, end, COMMAND_NAME_CHECKPOINT)
            return Command.Tasks if hash == HASH_TASKS and command_token_matches(payload, start, end, COMMAND_NAME_TASKS)
            return Command.Branch if hash == HASH_BRANCH and command_token_matches(payload, start, end, COMMAND_NAME_BRANCH)
            return Command.Quit if hash == HASH_CLOSE and command_token_matches(payload, start, end, COMMAND_NAME_CLOSE)
            return Command.Unknown

    public:
        # Parse one bounded command line. The parser deliberately accepts only
        # an optional unsigned numeric argument; paths and expressions stay
        # opaque IDs in the structured protocol instead of becoming shell text.
        def command_parse_line(payload: u8&, length: usize, expected_generation: u64) -> ParsedCommand:
            result: mutable ParsedCommand = zeroed
            result.expected_generation <- expected_generation
            result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_COMMAND)
            return result if length == 0 or length > COMMAND_MAX_LENGTH
            index: mutable usize = 0
            while index < length and command_is_whitespace(payload[index]):
                index <- index + 1
            token_start: usize = index
            hash: mutable u64 = 0
            while index < length and not command_is_whitespace(payload[index]):
                return result if index - token_start >= COMMAND_MAX_LENGTH
                hash <- command_hash_byte(hash, payload[index])
                index <- index + 1
            return result if index == token_start
            result.command <- command_from_hash(hash, payload, token_start, index)
            return result if result.command == Command.Unknown
            while index < length and command_is_whitespace(payload[index]):
                index <- index + 1
            if index < length:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_ARGUMENT)
                digits: mutable usize = 0
                while index < length and not command_is_whitespace(payload[index]):
                    byte: u8 = payload[index]
                    return result if byte < ASCII_ZERO or byte > ASCII_NINE
                    return result if digits >= COMMAND_MAX_ARGUMENT_DIGITS or result.argument > (MAX_U64 - (byte - ASCII_ZERO).u64()) / DECIMAL_BASE
                    result.argument <- result.argument * DECIMAL_BASE + (byte - ASCII_ZERO).u64()
                    result.argument_present <- true
                    digits <- digits + 1
                    index <- index + 1
                return result if digits == 0
                while index < length and command_is_whitespace(payload[index]):
                    index <- index + 1
                return result if index < length
            result.consumed <- index
            result.valid <- true
            result.failure <- DebuggerErrors::no_error()
            return result

        def command_parse(payload: u8&, length: usize) -> ParsedCommand:
            return command_parse_line(payload, length, NO_EXPECTED_GENERATION)

        def command_is_mutating(command: Command) -> bool:
            return command == Command.Run or command == Command.Launch or command == Command.Attach or command == Command.Pause or command == Command.Continue or command == Command.Step or command == Command.ReverseStep or command == Command.Seek or command == Command.Break or command == Command.Watch or command == Command.Record or command == Command.Replay or command == Command.Checkpoint or command == Command.Branch or command == Command.Quit

        def command_validate(request: CommandRequest, generation: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, DETAIL_STALE_GENERATION) if request.expected_generation != NO_EXPECTED_GENERATION and request.expected_generation != generation
            return DebuggerErrors::no_error()
