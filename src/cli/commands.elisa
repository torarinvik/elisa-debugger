# CLI command vocabulary is shared with protocol adapters.  Rendering remains
# a client concern; this module only validates command intent and generation.

include "../core/errors.elisa"

module DebuggerCLI:
    private:
        const module Bounds:
            COMMANDS_BOUNDS_MAX_U64: u64 = 18446744073709551615

        const module CommandName:
            MAX_LENGTH: usize = 64
            MAX_ARGUMENT_DIGITS: usize = 20
            NAME_RUN: cstr = "run"
            NAME_LAUNCH: cstr = "launch"
            NAME_ATTACH: cstr = "attach"
            NAME_PAUSE: cstr = "pause"
            NAME_CONTINUE: cstr = "continue"
            NAME_NEXT: cstr = "next"
            NAME_STEP: cstr = "step"
            NAME_REVERSE_STEP: cstr = "reverseStep"
            NAME_REVERSE_STEP_OVER: cstr = "reverseStepOver"
            NAME_REVERSE_STEP_OUT: cstr = "reverseStepOut"
            NAME_SEEK: cstr = "seek"
            NAME_STACK: cstr = "stack"
            NAME_LOCALS: cstr = "locals"
            NAME_EVALUATE: cstr = "evaluate"
            NAME_INSPECT: cstr = "inspect"
            NAME_BREAK: cstr = "break"
            NAME_WATCH: cstr = "watch"
            NAME_RECORD: cstr = "record"
            NAME_REPLAY: cstr = "replay"
            NAME_SAVE_TRACE: cstr = "saveTrace"
            NAME_TRACE_VERIFY: cstr = "traceVerify"
            NAME_COMPARE: cstr = "compare"
            NAME_CHECKPOINT: cstr = "checkpoint"
            NAME_TASKS: cstr = "tasks"
            NAME_BRANCH: cstr = "branch"
            NAME_CLOSE: cstr = "close"
            TOKEN_INDEX_INCREMENT: usize = 1

        const module Decimal:
            BASE: u64 = 10

        const module Detail:
            STALE_GENERATION: u32 = 1
            COMMAND: u32 = 2
            ARGUMENT: u32 = 3

        const module Encoding:
            COMMANDS_ENCODING_ASCII_ZERO: u8 = 48
            COMMANDS_ENCODING_ASCII_NINE: u8 = 57
            COMMANDS_ENCODING_ASCII_SPACE: u8 = 32
            COMMANDS_ENCODING_ASCII_TAB: u8 = 9
            COMMANDS_ENCODING_ASCII_LINE_FEED: u8 = 10
            COMMANDS_ENCODING_ASCII_CARRIAGE_RETURN: u8 = 13
            ASCII_NUL: u8 = 0

        const module Hash:
            COMMANDS_HASH_MULTIPLIER: u64 = 31
            RUN: u64 = 113291
            LAUNCH: u64 = 3185124275
            ATTACH: u64 = 2887708229
            PAUSE: u64 = 106440182
            CONTINUE: u64 = 2825521278119
            NEXT: u64 = 3377907
            STEP: u64 = 3540684
            REVERSE_STEP: u64 = 96211551034117326
            REVERSE_STEP_OVER: u64 = 13868363593868912322
            REVERSE_STEP_OUT: u64 = 6992985432408838048
            SEEK: u64 = 3526264
            STACK: u64 = 109757064
            LOCALS_COMMAND: u64 = 3197505128
            EVALUATE: u64 = 2886379809945
            INSPECT: u64 = 96446734868
            BREAK: u64 = 94001407
            WATCH: u64 = 112903375
            RECORD: u64 = 3360058449
            REPLAY: u64 = 3360442343
            SAVE_TRACE: u64 = 100858890921416
            TRACE_VERIFY: u64 = 98176544592272926
            COMPARE: u64 = 91144797413
            COMMANDS_HASH_CHECKPOINT: u64 = 2709093068854664
            TASKS: u64 = 110132110
            COMMANDS_HASH_BRANCH: u64 = 2913936802
            CLOSE: u64 = 94756344

        const module Sentinel:
            EXPECTED_GENERATION: u64 = 0


    public:
        enum Command:
            Unknown
            Run
            Launch
            Attach
            Pause
            Continue
            Step
            ReverseStep
            Seek
            Stack
            Locals
            Evaluate
            Inspect
            Break
            Watch
            Record
            Replay
            SaveTrace
            TraceVerify
            Compare
            Checkpoint
            Tasks
            Branch
            Quit
            ReverseStepOver
            ReverseStepOut

        struct CommandRequest:
            command: mutable Command
            argument: mutable u64
            expected_generation: mutable u64

        struct ParsedCommand:
            command: mutable Command
            argument: mutable u64
            argument_present: mutable bool
            expected_generation: mutable u64
            consumed: mutable usize
            valid: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

    private:
        def command_is_whitespace(byte: u8) -> bool:
            return byte == Encoding::COMMANDS_ENCODING_ASCII_SPACE or byte == Encoding::COMMANDS_ENCODING_ASCII_TAB or byte == Encoding::COMMANDS_ENCODING_ASCII_LINE_FEED or byte == Encoding::COMMANDS_ENCODING_ASCII_CARRIAGE_RETURN

        def command_hash_byte(hash: u64, byte: u8) -> u64:
            return hash * Hash::COMMANDS_HASH_MULTIPLIER + byte.u64()

        def command_token_matches(payload: u8&, start: usize, end: usize, expected: cstr) -> bool:
            cursor: mutable usize = start
            expected_index: mutable usize = 0
            while cursor < end:
                return false if expected[expected_index] == Encoding::ASCII_NUL
                return false if payload[cursor] != expected[expected_index].u8()
                cursor <- cursor + CommandName::TOKEN_INDEX_INCREMENT
                expected_index <- expected_index + CommandName::TOKEN_INDEX_INCREMENT
            return expected[expected_index] == Encoding::ASCII_NUL

        def command_from_hash(hash: u64, payload: u8&, start: usize, end: usize) -> Command:
            return Command.Run if hash == Hash::RUN and command_token_matches(payload, start, end, CommandName::NAME_RUN)
            return Command.Launch if hash == Hash::LAUNCH and command_token_matches(payload, start, end, CommandName::NAME_LAUNCH)
            return Command.Attach if hash == Hash::ATTACH and command_token_matches(payload, start, end, CommandName::NAME_ATTACH)
            return Command.Pause if hash == Hash::PAUSE and command_token_matches(payload, start, end, CommandName::NAME_PAUSE)
            return Command.Continue if hash == Hash::CONTINUE and command_token_matches(payload, start, end, CommandName::NAME_CONTINUE)
            return Command.Step if hash == Hash::NEXT and command_token_matches(payload, start, end, CommandName::NAME_NEXT)
            return Command.Step if hash == Hash::STEP and command_token_matches(payload, start, end, CommandName::NAME_STEP)
            return Command.ReverseStep if hash == Hash::REVERSE_STEP and command_token_matches(payload, start, end, CommandName::NAME_REVERSE_STEP)
            return Command.ReverseStepOver if hash == Hash::REVERSE_STEP_OVER and command_token_matches(payload, start, end, CommandName::NAME_REVERSE_STEP_OVER)
            return Command.ReverseStepOut if hash == Hash::REVERSE_STEP_OUT and command_token_matches(payload, start, end, CommandName::NAME_REVERSE_STEP_OUT)
            return Command.Seek if hash == Hash::SEEK and command_token_matches(payload, start, end, CommandName::NAME_SEEK)
            return Command.Stack if hash == Hash::STACK and command_token_matches(payload, start, end, CommandName::NAME_STACK)
            return Command.Locals if hash == Hash::LOCALS_COMMAND and command_token_matches(payload, start, end, CommandName::NAME_LOCALS)
            return Command.Evaluate if hash == Hash::EVALUATE and command_token_matches(payload, start, end, CommandName::NAME_EVALUATE)
            return Command.Inspect if hash == Hash::INSPECT and command_token_matches(payload, start, end, CommandName::NAME_INSPECT)
            return Command.Break if hash == Hash::BREAK and command_token_matches(payload, start, end, CommandName::NAME_BREAK)
            return Command.Watch if hash == Hash::WATCH and command_token_matches(payload, start, end, CommandName::NAME_WATCH)
            return Command.Record if hash == Hash::RECORD and command_token_matches(payload, start, end, CommandName::NAME_RECORD)
            return Command.Replay if hash == Hash::REPLAY and command_token_matches(payload, start, end, CommandName::NAME_REPLAY)
            return Command.SaveTrace if hash == Hash::SAVE_TRACE and command_token_matches(payload, start, end, CommandName::NAME_SAVE_TRACE)
            return Command.TraceVerify if hash == Hash::TRACE_VERIFY and command_token_matches(payload, start, end, CommandName::NAME_TRACE_VERIFY)
            return Command.Compare if hash == Hash::COMPARE and command_token_matches(payload, start, end, CommandName::NAME_COMPARE)
            return Command.Checkpoint if hash == Hash::COMMANDS_HASH_CHECKPOINT and command_token_matches(payload, start, end, CommandName::NAME_CHECKPOINT)
            return Command.Tasks if hash == Hash::TASKS and command_token_matches(payload, start, end, CommandName::NAME_TASKS)
            return Command.Branch if hash == Hash::COMMANDS_HASH_BRANCH and command_token_matches(payload, start, end, CommandName::NAME_BRANCH)
            return Command.Quit if hash == Hash::CLOSE and command_token_matches(payload, start, end, CommandName::NAME_CLOSE)
            return Command.Unknown

    public:
        # Parse one bounded command line. The parser deliberately accepts only
        # an optional unsigned numeric argument; paths and expressions stay
        # opaque IDs in the structured protocol instead of becoming shell text.
        def command_parse_line(payload: u8&, length: usize, expected_generation: u64) -> ParsedCommand:
            result: mutable ParsedCommand = zeroed
            result.expected_generation <- expected_generation
            result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::COMMAND)
            return result if length == 0 or length > CommandName::MAX_LENGTH
            index: mutable usize = 0
            while index < length and command_is_whitespace(payload[index]):
                index <- index + 1
            token_start: usize = index
            hash: mutable u64 = 0
            while index < length and not command_is_whitespace(payload[index]):
                return result if index - token_start >= CommandName::MAX_LENGTH
                hash <- command_hash_byte(hash, payload[index])
                index <- index + 1
            return result if index == token_start
            result.command <- command_from_hash(hash, payload, token_start, index)
            return result if result.command == Command.Unknown
            while index < length and command_is_whitespace(payload[index]):
                index <- index + 1
            if index < length:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::ARGUMENT)
                digits: mutable usize = 0
                while index < length and not command_is_whitespace(payload[index]):
                    byte: u8 = payload[index]
                    return result if byte < Encoding::COMMANDS_ENCODING_ASCII_ZERO or byte > Encoding::COMMANDS_ENCODING_ASCII_NINE
                    return result if digits >= CommandName::MAX_ARGUMENT_DIGITS or result.argument > (Bounds::COMMANDS_BOUNDS_MAX_U64 - (byte - Encoding::COMMANDS_ENCODING_ASCII_ZERO).u64()) / Decimal::BASE
                    result.argument <- result.argument * Decimal::BASE + (byte - Encoding::COMMANDS_ENCODING_ASCII_ZERO).u64()
                    result.argument_present <- true
                    digits <- digits + 1
                    index <- index + 1
                return result if digits == 0
                while index < length and command_is_whitespace(payload[index]):
                    index <- index + 1
                return result if index < length
                # Only seek consumes the numeric operand. Accepting an
                # operand on other commands would silently discard it in
                # both the terminal and structured CLI runners.
                return result if result.argument_present and result.command != Command.Seek
            result.consumed <- index
            result.valid <- true
            result.failure <- DebuggerErrors::no_error()
            return result

        def command_parse(payload: u8&, length: usize) -> ParsedCommand:
            return command_parse_line(payload, length, Sentinel::EXPECTED_GENERATION)

        def command_is_mutating(command: Command) -> bool:
            return command == Command.Run or command == Command.Launch or command == Command.Attach or command == Command.Pause or command == Command.Continue or command == Command.Step or command == Command.ReverseStep or command == Command.ReverseStepOver or command == Command.ReverseStepOut or command == Command.Seek or command == Command.Break or command == Command.Watch or command == Command.Record or command == Command.Replay or command == Command.Checkpoint or command == Command.Branch or command == Command.Quit

        def command_validate(request: CommandRequest, generation: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, Detail::STALE_GENERATION) if request.expected_generation != Sentinel::EXPECTED_GENERATION and request.expected_generation != generation
            return DebuggerErrors::no_error()
