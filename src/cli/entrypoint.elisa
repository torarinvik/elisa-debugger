# Small interactive/machine CLI.  It shares the protocol dispatcher, so a
# terminal command cannot bypass generation or lifecycle rules.

include "../core/session.elisa"
include "../core/capabilities.elisa"
include "../core/errors.elisa"
include "../core/identity.elisa"
include "../engine/default_image.elisa"
include "../vm/edir_file.elisa"
include "../inspect/managed.elisa"
include "./commands.elisa"
include "../protocol/request.elisa"
include "../protocol/dispatcher.elisa"
include "../protocol/managed_service.elisa"
include "../protocol/managed_trace_file.elisa"
include "../protocol/managed_trace.elisa"
include "../query/timeline.elisa"

extern read(fd: i32, buf: void&, count: usize) -> isize can[Console]
extern printf(format: cstr, ...) -> i32 can[Console]
extern puts(text: cstr) -> i32 can[Console]
extern fflush(stream: mutable void&?) -> i32 can[Console]

module DebuggerCLIEntrypoint:
    private:
        const module Bounds:
            MAX_REQUEST_ID: u64 = 18446744073709551615

        const module Cli:
            CLI_ENTRYPOINT_FIRST_LOCAL_INDEX: usize = 0
            DEFAULT_LOCAL_REQUEST: usize = 0
            UNSUPPORTED_RESULT_DETAIL: u32 = 4
            LAUNCH_STATE_DETAIL: u32 = 5

        const module Encoding:
            CLI_ENTRYPOINT_ENCODING_ASCII_NEWLINE: u8 = 10
            CLI_ENTRYPOINT_ENCODING_ASCII_CARRIAGE_RETURN: u8 = 13
            CLI_ENTRYPOINT_ENCODING_ASCII_SPACE: u8 = 32

        const module Exit:
            OK: i64 = 0
            INPUT_ERROR: i64 = 2

        const module First:
            CLI_ENTRYPOINT_FIRST_REQUEST_ID: u64 = 1

        const module RequestSentinel:
            NO_EXPECTED_GENERATION: u64 = 0
            NO_TARGET_EVENT: u64 = 0

        const module Line:
            CLI_ENTRYPOINT_LINE_CAPACITY: usize = DebuggerCLI::Limits::MAX_LINE_BYTES

        const module Stdin:
            FD: i32 = 0

        const module TimelineText:
            AVAILABLE: cstr = "available"
            UNAVAILABLE: cstr = "unavailable"
            TRUE: cstr = "true"
            FALSE: cstr = "false"
            REASON_READY: cstr = "ready"
            REASON_UNSUPPORTED: cstr = "unsupported-history"
            REASON_NOT_STOPPED: cstr = "session-not-stopped"
            REASON_INEXACT: cstr = "state-not-exact"
            REASON_SIDE_STATE: cstr = "side-state-unaligned"
            REASON_BOUNDARY: cstr = "at-boundary"


        def write_frame(frame: DebuggerManagedInspection::FrameSnapshot) -> void can[Console]:
            _ = printf("frame id=%llu event=%llu instruction=%llu accumulator=%lld result=%lld returnDepth=%llu\n", frame.id.value, frame.event, frame.instruction.value, frame.accumulator, frame.result, frame.return_depth.u64()) can Console

        def write_locals(service: mutable DebuggerManagedService::Service&) -> void can[Console]:
            page: DebuggerManagedInspection::LocalPage = DebuggerManagedService::service_locals(service, Cli::CLI_ENTRYPOINT_FIRST_LOCAL_INDEX, Cli::DEFAULT_LOCAL_REQUEST)
            _ = printf("locals count=%llu next=%llu\n", page.count.u64(), page.next.u64()) can Console
            for index in 0..<page.count:
                entry: DebuggerManagedInspection::LocalSnapshot = page.entries[index]
                if entry.available:
                    _ = printf("local[%llu]=%lld\n", entry.index.u64(), entry.value) can Console
                else:
                    _ = printf("local[%llu]=uninitialized\n", entry.index.u64()) can Console

        def timeline_availability_text(available: bool) -> cstr:
            return TimelineText::AVAILABLE if available else TimelineText::UNAVAILABLE

        def timeline_boolean_text(value: bool) -> cstr:
            return TimelineText::TRUE if value else TimelineText::FALSE

        def timeline_reason_text(reason: DebuggerTimeline::HistoryEligibilityReason) -> cstr:
            return TimelineText::REASON_READY if reason == DebuggerTimeline::HistoryEligibilityReason.Ready
            return TimelineText::REASON_UNSUPPORTED if reason == DebuggerTimeline::HistoryEligibilityReason.UnsupportedHistory
            return TimelineText::REASON_NOT_STOPPED if reason == DebuggerTimeline::HistoryEligibilityReason.SessionNotStopped
            return TimelineText::REASON_INEXACT if reason == DebuggerTimeline::HistoryEligibilityReason.StateNotExact
            return TimelineText::REASON_SIDE_STATE if reason == DebuggerTimeline::HistoryEligibilityReason.SideStateUnaligned
            return TimelineText::REASON_BOUNDARY

        def write_timeline(service: mutable DebuggerManagedService::Service&) -> void can[Console]:
            timeline: DebuggerTimeline::Timeline = DebuggerManagedService::service_timeline(service)
            _ = printf("timeline stopGeneration=%llu event=%llu branch=%llu retained=%s[%llu,%llu] exact=%s[%llu,%llu] canSeek=%s canReverse=%s reason=%s\n", service.controller.session.stop_generation, timeline.position.event, timeline.position.branch.value, timeline_availability_text(timeline.bounds.has_retained), timeline.bounds.retained_first, timeline.bounds.retained_last, timeline_availability_text(timeline.bounds.has_exact), timeline.bounds.exact_first, timeline.bounds.exact_last, timeline_boolean_text(timeline.eligibility.can_seek), timeline_boolean_text(timeline.eligibility.can_reverse), timeline_reason_text(timeline.eligibility.reason)) can Console
        def method_from_command(command: DebuggerCLI::Command) -> DebuggerProtocolRequest::RequestMethod:
            return DebuggerProtocolRequest::RequestMethod.Launch if command == DebuggerCLI::Command.Run or command == DebuggerCLI::Command.Launch
            return DebuggerProtocolRequest::RequestMethod.Attach if command == DebuggerCLI::Command.Attach
            return DebuggerProtocolRequest::RequestMethod.Pause if command == DebuggerCLI::Command.Pause
            return DebuggerProtocolRequest::RequestMethod.Continue if command == DebuggerCLI::Command.Continue
            return DebuggerProtocolRequest::RequestMethod.Step if command == DebuggerCLI::Command.Step
            return DebuggerProtocolRequest::RequestMethod.ReverseStep if command == DebuggerCLI::Command.ReverseStep
            return DebuggerProtocolRequest::RequestMethod.ReverseStepOver if command == DebuggerCLI::Command.ReverseStepOver
            return DebuggerProtocolRequest::RequestMethod.ReverseStepOut if command == DebuggerCLI::Command.ReverseStepOut
            return DebuggerProtocolRequest::RequestMethod.Seek if command == DebuggerCLI::Command.Seek
            return DebuggerProtocolRequest::RequestMethod.Timeline if command == DebuggerCLI::Command.Timeline
            return DebuggerProtocolRequest::RequestMethod.Stack if command == DebuggerCLI::Command.Stack
            return DebuggerProtocolRequest::RequestMethod.Variables if command == DebuggerCLI::Command.Locals or command == DebuggerCLI::Command.Inspect
            return DebuggerProtocolRequest::RequestMethod.Evaluate if command == DebuggerCLI::Command.Evaluate
            return DebuggerProtocolRequest::RequestMethod.Threads if command == DebuggerCLI::Command.Tasks
            return DebuggerProtocolRequest::RequestMethod.TraceVerify if command == DebuggerCLI::Command.TraceVerify
            return DebuggerProtocolRequest::RequestMethod.TraceExport if command == DebuggerCLI::Command.SaveTrace
            return DebuggerProtocolRequest::RequestMethod.Compare if command == DebuggerCLI::Command.Compare
            return DebuggerProtocolRequest::RequestMethod.Checkpoint if command == DebuggerCLI::Command.Checkpoint
            return DebuggerProtocolRequest::RequestMethod.Branch if command == DebuggerCLI::Command.Branch
            return DebuggerProtocolRequest::RequestMethod.SetBreakpoints if command == DebuggerCLI::Command.Break
            return DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints if command == DebuggerCLI::Command.Watch
            return DebuggerProtocolRequest::RequestMethod.Replay if command == DebuggerCLI::Command.Replay
            return DebuggerProtocolRequest::RequestMethod.Close if command == DebuggerCLI::Command.Quit
            return DebuggerProtocolRequest::RequestMethod.Unknown

        def initial_session() -> DebuggerSession::Session:
            build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
            return DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())

        def dispatch_request(service: mutable DebuggerManagedService::Service&, request: DebuggerProtocolRequest::Request) -> DebuggerProtocolDispatcher::DispatchResult:
            if request.method == DebuggerProtocolRequest::RequestMethod.ReverseStepOver or request.method == DebuggerProtocolRequest::RequestMethod.ReverseStepOut:
                result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}
            if request.method == DebuggerProtocolRequest::RequestMethod.Launch or request.method == DebuggerProtocolRequest::RequestMethod.Pause or request.method == DebuggerProtocolRequest::RequestMethod.Continue or request.method == DebuggerProtocolRequest::RequestMethod.Step or request.method == DebuggerProtocolRequest::RequestMethod.ReverseStep or request.method == DebuggerProtocolRequest::RequestMethod.Seek or request.method == DebuggerProtocolRequest::RequestMethod.Timeline or request.method == DebuggerProtocolRequest::RequestMethod.Stack or request.method == DebuggerProtocolRequest::RequestMethod.Variables or request.method == DebuggerProtocolRequest::RequestMethod.Checkpoint or request.method == DebuggerProtocolRequest::RequestMethod.Compare or request.method == DebuggerProtocolRequest::RequestMethod.TraceVerify or request.method == DebuggerProtocolRequest::RequestMethod.TraceExport or request.method == DebuggerProtocolRequest::RequestMethod.Replay or request.method == DebuggerProtocolRequest::RequestMethod.Close or request.method == DebuggerProtocolRequest::RequestMethod.Evaluate or request.method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints or request.method == DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints:
                result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}
            if request.method == DebuggerProtocolRequest::RequestMethod.Threads:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Cli::UNSUPPORTED_RESULT_DETAIL)
                return DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, failure)
            return DebuggerProtocolDispatcher::dispatch_request(service.controller.session, request, RequestSentinel::NO_EXPECTED_GENERATION)

        def launch_image(service: mutable DebuggerManagedService::Service&, parsed: mutable DebuggerCLI::ParsedCommand&, request: DebuggerProtocolRequest::Request) -> DebuggerProtocolDispatcher::DispatchResult can[Blocking.IO, Unsafe.PointerCast]:
            if service.controller.session.state != DebuggerSession::SessionState.Created:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Cli::LAUNCH_STATE_DETAIL)
                return DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, failure)
            loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(parsed.text_argument[DebuggerCLI::Limits::FIRST_TEXT_ARGUMENT_BYTE_INDEX], parsed.text_argument_length) can Blocking.IO, Unsafe.PointerCast
            if not loaded.valid:
                return DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, loaded.failure)
            session: DebuggerSession::Session = service.controller.session
            recording: DebuggerIdentity::DebugId = service.controller.engine.recording
            DebuggerManagedService::service_initialize(service, session, loaded.image, recording)
            return dispatch_request(service, request)

        def process_line(service: mutable DebuggerManagedService::Service&, session: mutable DebuggerSession::Session&, line: u8&, length: usize, request_id: u64) -> void can[Console, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            parsed: mutable DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(line, length, RequestSentinel::NO_EXPECTED_GENERATION)
            method: DebuggerProtocolRequest::RequestMethod = method_from_command(parsed.command)
            request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: method, id: request_id, has_id: true, expected_generation: parsed.expected_generation, target_event: RequestSentinel::NO_TARGET_EVENT, valid: parsed.valid and method != DebuggerProtocolRequest::RequestMethod.Unknown}
            request.target_event <- parsed.argument if parsed.command == DebuggerCLI::Command.Seek and parsed.argument_present
            if not parsed.valid:
                _ = printf("error code=%d detail=%u\n", parsed.failure.code, parsed.failure.detail) can Console
            elif parsed.command == DebuggerCLI::Command.SaveTrace:
                exported: DebuggerManagedTraceFile::ExportResult = DebuggerManagedTraceFile::export_service_trace(service, parsed.text_argument[DebuggerCLI::Limits::FIRST_TEXT_ARGUMENT_BYTE_INDEX], parsed.text_argument_length) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
                if exported.accepted:
                    _ = printf("saved trace bytes=%llu chunks=%llu\n", exported.bytes_written.u64(), exported.chunk_count.u64()) can Console
                else:
                    _ = printf("error code=%d detail=%u\n", exported.failure.code, exported.failure.detail) can Console
            elif parsed.command == DebuggerCLI::Command.OpenTrace:
                restored: mutable DebuggerManagedService::Result = zeroed
                if service.controller.session.state == DebuggerSession::SessionState.Stopped:
                    restored <- DebuggerManagedTraceService::service_trace_replace_from_file(service, parsed.text_argument[DebuggerCLI::Limits::FIRST_TEXT_ARGUMENT_BYTE_INDEX], parsed.text_argument_length, parsed.argument) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
                else:
                    restored <- DebuggerManagedTraceService::service_trace_restore_file(service, parsed.text_argument[DebuggerCLI::Limits::FIRST_TEXT_ARGUMENT_BYTE_INDEX], parsed.text_argument_length, parsed.argument) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
                if restored.accepted:
                    session <- service.controller.session
                    _ = printf("opened trace event=%llu generation=%llu\n", parsed.argument, session.stop_generation) can Console
                    write_timeline(service) can Console
                else:
                    _ = printf("error code=%d detail=%u\n", restored.failure.code, restored.failure.detail) can Console
                    diagnostic: DebuggerReplayDiagnostic::Divergence = DebuggerManagedService::service_replay_diagnostic(service)
                    if restored.failure.code == DebuggerErrors::ErrorCode.Diverged and diagnostic.available:
                        _ = printf("divergence version=%u component=%s event=%llu lastVerified=%llu recording=%llu branch=%llu expectedKind=%u observedKind=%u expectedInvocation=%llu observedInvocation=%llu expectedCallSite=%llu observedCallSite=%llu expectedRequest=%llu observedRequest=%llu\n", diagnostic.schema, DebuggerReplayDiagnostic::component_name(diagnostic.component), diagnostic.event, diagnostic.last_verified.event, diagnostic.last_verified.recording.value, diagnostic.last_verified.branch.value, diagnostic.expected_kind.u32(), diagnostic.observed_kind.u32(), diagnostic.expected_position.invocation.value, diagnostic.observed_position.invocation.value, diagnostic.expected_call_site.value, diagnostic.observed_call_site.value, diagnostic.expected_request_hash, diagnostic.observed_request_hash) can Console
                        _ = printf("divergence values expectedEvent=%s observedEvent=%s expectedTask=%llu observedTask=%llu expectedValue=%s:%llu observedValue=%s:%llu verifiedCheckpoint=%s:%llu\n", timeline_availability_text(diagnostic.has_expected_event), timeline_availability_text(diagnostic.has_observed_event), diagnostic.expected_position.task.value, diagnostic.observed_position.task.value, timeline_availability_text(diagnostic.has_expected_value), diagnostic.expected_value, timeline_availability_text(diagnostic.has_observed_value), diagnostic.observed_value, timeline_availability_text(diagnostic.has_verified_checkpoint), diagnostic.verified_checkpoint_event) can Console
            else:
                result: mutable DebuggerProtocolDispatcher::DispatchResult = zeroed
                if parsed.text_argument_present and (parsed.command == DebuggerCLI::Command.Launch or parsed.command == DebuggerCLI::Command.Run):
                    result <- launch_image(service, parsed, request) can Blocking.IO, Unsafe.PointerCast
                else:
                    result <- dispatch_request(service, request)
                session <- result.session
                service.controller.session <- result.session
                if result.accepted:
                    _ = printf("ok generation=%llu\n", session.stop_generation) can Console
                    write_frame(DebuggerManagedService::service_frame(service)) can Console if parsed.command == DebuggerCLI::Command.Stack
                    write_locals(service) can Console if parsed.command == DebuggerCLI::Command.Locals or parsed.command == DebuggerCLI::Command.Inspect
                    write_timeline(service) can Console if parsed.command == DebuggerCLI::Command.Timeline
                else:
                    _ = printf("error code=%d detail=%u\n", result.failure.code, result.failure.detail) can Console
            _ = fflush(null) can Console

    public:
        def run_cli() -> i64 can[Console, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            session: mutable DebuggerSession::Session = initial_session()
            service: mutable DebuggerManagedService::Service = zeroed
            DebuggerManagedService::service_initialize(service, session, DebuggerDefaultImage::image_new(), DebuggerIdentity::debug_id(1))
            line: mutable u8[Line::CLI_ENTRYPOINT_LINE_CAPACITY] = zeroed
            length: mutable usize = 0
            request_id: mutable u64 = First::CLI_ENTRYPOINT_FIRST_REQUEST_ID
            while true:
                count: isize = read(Stdin::FD, (&line[length]).cast[void&], 1) can Console
                if count <= 0:
                    process_line(service, session, line[0], length, request_id) can Console if length > 0
                    break
                byte: u8 = line[length]
                if byte == Encoding::CLI_ENTRYPOINT_ENCODING_ASCII_NEWLINE:
                    process_line(service, session, line[0], length, request_id) can Console
                    length <- 0
                    request_id <- request_id if request_id == Bounds::MAX_REQUEST_ID else request_id + First::CLI_ENTRYPOINT_FIRST_REQUEST_ID
                else:
                    if length + 1 >= Line::CLI_ENTRYPOINT_LINE_CAPACITY:
                        DebuggerManagedEngine::managed_controller_release_owned_history(service.controller) can Memory.Release, Unsafe.PointerCast
                        return Exit::INPUT_ERROR
                    length <- length + 1
            DebuggerManagedEngine::managed_controller_release_owned_history(service.controller) can Memory.Release, Unsafe.PointerCast
            return Exit::OK

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return DebuggerCLIEntrypoint::run_cli()
