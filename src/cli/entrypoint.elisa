# Small interactive/machine CLI.  It shares the protocol dispatcher, so a
# terminal command cannot bypass generation or lifecycle rules.

include "../core/session.elisa"
include "../core/capabilities.elisa"
include "../core/identity.elisa"
include "../engine/default_image.elisa"
include "../protocol/request.elisa"
include "../protocol/dispatcher.elisa"
include "../protocol/managed_service.elisa"

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern printf(format: cstr, ...) -> int can[Console]
extern puts(text: cstr) -> int can[Console]

module DebuggerCLIEntrypoint:
    private:
        const STDIN_FD: int = 0
        const LINE_CAPACITY: usize = 256
        const ASCII_NEWLINE: u8 = 10
        const ASCII_SPACE: u8 = 32
        const HASH_MULTIPLIER: u64 = 31
        const EXIT_OK: i64 = 0
        const EXIT_INPUT_ERROR: i64 = 2
        const HASH_LAUNCH: u64 = 3185124275
        const HASH_PAUSE: u64 = 106440182
        const HASH_CONTINUE: u64 = 2825521278119
        const HASH_STEP: u64 = 3540684
        const HASH_REVERSE_STEP: u64 = 96211551034117326
        const HASH_CLOSE: u64 = 94756344
        const HASH_STACK: u64 = 109757064
        const HASH_LOCALS: u64 = 3197505128
        const HASH_THREADS: u64 = 106036245417
        const HASH_EVALUATE: u64 = 2886379809945
        const HASH_SEEK: u64 = 3526264
        const HASH_REPLAY: u64 = 3360442343
        const HASH_ATTACH: u64 = 2887708229
        const HASH_TERMINATE: u64 = 101818530709089
        const HASH_DETACH: u64 = 2959742867

        def method_from_hash(hash: u64) -> DebuggerProtocolRequest::RequestMethod:
            return DebuggerProtocolRequest::RequestMethod.Launch if hash == HASH_LAUNCH
            return DebuggerProtocolRequest::RequestMethod.Pause if hash == HASH_PAUSE
            return DebuggerProtocolRequest::RequestMethod.Continue if hash == HASH_CONTINUE
            return DebuggerProtocolRequest::RequestMethod.Step if hash == HASH_STEP
            return DebuggerProtocolRequest::RequestMethod.ReverseStep if hash == HASH_REVERSE_STEP
            return DebuggerProtocolRequest::RequestMethod.Stack if hash == HASH_STACK
            return DebuggerProtocolRequest::RequestMethod.Variables if hash == HASH_LOCALS
            return DebuggerProtocolRequest::RequestMethod.Threads if hash == HASH_THREADS
            return DebuggerProtocolRequest::RequestMethod.Evaluate if hash == HASH_EVALUATE
            return DebuggerProtocolRequest::RequestMethod.Seek if hash == HASH_SEEK
            return DebuggerProtocolRequest::RequestMethod.Replay if hash == HASH_REPLAY
            return DebuggerProtocolRequest::RequestMethod.Attach if hash == HASH_ATTACH
            return DebuggerProtocolRequest::RequestMethod.Terminate if hash == HASH_TERMINATE
            return DebuggerProtocolRequest::RequestMethod.Detach if hash == HASH_DETACH
            return DebuggerProtocolRequest::RequestMethod.Close if hash == HASH_CLOSE
            return DebuggerProtocolRequest::RequestMethod.Unknown

        def initial_session() -> DebuggerSession::Session:
            build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
            return DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())

        def dispatch_request(service: mutable DebuggerManagedService::Service&, request: DebuggerProtocolRequest::Request) -> DebuggerProtocolDispatcher::DispatchResult:
            if request.method == DebuggerProtocolRequest::RequestMethod.Launch or request.method == DebuggerProtocolRequest::RequestMethod.Pause or request.method == DebuggerProtocolRequest::RequestMethod.Continue or request.method == DebuggerProtocolRequest::RequestMethod.Step or request.method == DebuggerProtocolRequest::RequestMethod.ReverseStep or request.method == DebuggerProtocolRequest::RequestMethod.Seek or request.method == DebuggerProtocolRequest::RequestMethod.Close:
                result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}
            return DebuggerProtocolDispatcher::dispatch_request(service.controller.session, request, 0)

    public:
        def run_cli() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            session: mutable DebuggerSession::Session = initial_session()
            service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, DebuggerDefaultImage::image_new(), DebuggerIdentity::debug_id(1))
            line: mutable u8[LINE_CAPACITY] = zeroed
            length: mutable usize = 0
            hash: mutable u64 = 0
            while true:
                count: isize = read(STDIN_FD, (&line[length]).cast[void&], 1) can Console
                break if count <= 0
                byte: u8 = line[length]
                if byte == ASCII_NEWLINE:
                    method: DebuggerProtocolRequest::RequestMethod = method_from_hash(hash)
                    request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: method, id: 0, has_id: false, expected_generation: 0, target_event: 0, valid: method != DebuggerProtocolRequest::RequestMethod.Unknown}
                    result: DebuggerProtocolDispatcher::DispatchResult = dispatch_request(service, request)
                    session <- result.session
                    service.controller.session <- result.session
                    if result.accepted:
                        _ = printf("ok generation=%llu\n", session.stop_generation) can Console
                    else:
                        _ = printf("error code=%d detail=%u\n", result.failure.code, result.failure.detail) can Console
                    length <- 0
                    hash <- 0
                else:
                    return EXIT_INPUT_ERROR if length + 1 >= LINE_CAPACITY
                    if byte != ASCII_SPACE:
                        hash <- hash * HASH_MULTIPLIER + byte.u64()
                    length <- length + 1
            return EXIT_OK

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return DebuggerCLIEntrypoint::run_cli()
