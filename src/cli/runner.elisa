# Machine and interactive command execution share this runner.  Rendering is
# intentionally outside it so JSON clients and terminals observe identical
# lifecycle, generation, and capability decisions.

include "./commands.elisa"
include "../protocol/dispatcher.elisa"
include "../protocol/request.elisa"

module DebuggerCLIRunner:
    private:
        const COMMAND_NONE: u64 = 0
        const COMMAND_HASH_MULTIPLIER: u64 = 31
        const COMMAND_HASH_CONTINUE: u64 = 2825521278119
        const COMMAND_HASH_NEXT: u64 = 3377907
        const COMMAND_HASH_STEP: u64 = 3540684
        const COMMAND_HASH_REVERSE_STEP: u64 = 96211551034117326
        const COMMAND_HASH_PAUSE: u64 = 106440182
        const COMMAND_HASH_CLOSE: u64 = 94756344
        const COMMAND_HASH_RUN: u64 = 113291
        const COMMAND_HASH_LAUNCH: u64 = 3185124275
        const COMMAND_HASH_ATTACH: u64 = 2887708229
        const COMMAND_HASH_RECORD: u64 = 3360058449
        const COMMAND_HASH_REPLAY: u64 = 3360442343
        const COMMAND_HASH_SAVE_TRACE: u64 = 100858890921416
        const COMMAND_HASH_BRANCH: u64 = 2913936802
        const COMMAND_HASH_BREAK: u64 = 94001407
        const COMMAND_HASH_WATCH: u64 = 112903375
        const COMMAND_HASH_STACK: u64 = 109757064
        const COMMAND_HASH_LOCALS: u64 = 3197505128
        const COMMAND_HASH_EVALUATE: u64 = 2886379809945
        const COMMAND_HASH_SEEK: u64 = 3526264

    public:
        enum OutputMode:
            Human
            Json
            Quiet

        struct Runner:
            session: mutable DebuggerSession::Session
            mode: mutable OutputMode
            last_status: mutable DebuggerErrors::DebuggerError

        def runner_new(session: DebuggerSession::Session, mode: OutputMode) -> Runner:
            return Runner{session: session, mode: mode, last_status: DebuggerErrors::no_error()}

        def command_hash_byte(hash: u64, byte: u8) -> u64:
            return hash * COMMAND_HASH_MULTIPLIER + byte.u64()

        def command_from_hash(hash: u64) -> DebuggerCLI::Command:
            return DebuggerCLI::Command.Launch if hash == COMMAND_HASH_LAUNCH
            return DebuggerCLI::Command.Attach if hash == COMMAND_HASH_ATTACH
            return DebuggerCLI::Command.Record if hash == COMMAND_HASH_RECORD
            return DebuggerCLI::Command.Replay if hash == COMMAND_HASH_REPLAY
            return DebuggerCLI::Command.SaveTrace if hash == COMMAND_HASH_SAVE_TRACE
            return DebuggerCLI::Command.Branch if hash == COMMAND_HASH_BRANCH
            return DebuggerCLI::Command.Break if hash == COMMAND_HASH_BREAK
            return DebuggerCLI::Command.Watch if hash == COMMAND_HASH_WATCH
            return DebuggerCLI::Command.Stack if hash == COMMAND_HASH_STACK
            return DebuggerCLI::Command.Locals if hash == COMMAND_HASH_LOCALS
            return DebuggerCLI::Command.Evaluate if hash == COMMAND_HASH_EVALUATE
            return DebuggerCLI::Command.Seek if hash == COMMAND_HASH_SEEK
            return DebuggerCLI::Command.Continue if hash == COMMAND_HASH_CONTINUE
            return DebuggerCLI::Command.Step if hash == COMMAND_HASH_NEXT
            return DebuggerCLI::Command.Step if hash == COMMAND_HASH_STEP
            return DebuggerCLI::Command.ReverseStep if hash == COMMAND_HASH_REVERSE_STEP
            return DebuggerCLI::Command.Pause if hash == COMMAND_HASH_PAUSE
            return DebuggerCLI::Command.Quit if hash == COMMAND_HASH_CLOSE
            return DebuggerCLI::Command.Run if hash == COMMAND_HASH_RUN
            return DebuggerCLI::Command.Unknown

        def request_for_command(command: DebuggerCLI::Command, id: u64, expected_generation: u64) -> DebuggerProtocolRequest::Request:
            request: mutable DebuggerProtocolRequest::Request = zeroed
            request.id <- id
            request.has_id <- true
            request.expected_generation <- expected_generation
            request.valid <- true
            request.method <- DebuggerProtocolRequest::RequestMethod.Launch if command == DebuggerCLI::Command.Launch or command == DebuggerCLI::Command.Run
            request.method <- DebuggerProtocolRequest::RequestMethod.Attach if command == DebuggerCLI::Command.Attach
            request.method <- DebuggerProtocolRequest::RequestMethod.Pause if command == DebuggerCLI::Command.Pause
            request.method <- DebuggerProtocolRequest::RequestMethod.Continue if command == DebuggerCLI::Command.Continue
            request.method <- DebuggerProtocolRequest::RequestMethod.Step if command == DebuggerCLI::Command.Step
            request.method <- DebuggerProtocolRequest::RequestMethod.ReverseStep if command == DebuggerCLI::Command.ReverseStep
            request.method <- DebuggerProtocolRequest::RequestMethod.Seek if command == DebuggerCLI::Command.Seek
            request.method <- DebuggerProtocolRequest::RequestMethod.Stack if command == DebuggerCLI::Command.Stack
            request.method <- DebuggerProtocolRequest::RequestMethod.Variables if command == DebuggerCLI::Command.Locals
            request.method <- DebuggerProtocolRequest::RequestMethod.Evaluate if command == DebuggerCLI::Command.Evaluate
            request.method <- DebuggerProtocolRequest::RequestMethod.Branch if command == DebuggerCLI::Command.Branch
            request.method <- DebuggerProtocolRequest::RequestMethod.SetBreakpoints if command == DebuggerCLI::Command.Break
            request.method <- DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints if command == DebuggerCLI::Command.Watch
            request.method <- DebuggerProtocolRequest::RequestMethod.Replay if command == DebuggerCLI::Command.Replay
            request.method <- DebuggerProtocolRequest::RequestMethod.TraceExport if command == DebuggerCLI::Command.SaveTrace
            request.method <- DebuggerProtocolRequest::RequestMethod.Close if command == DebuggerCLI::Command.Quit
            request.valid <- request.method != DebuggerProtocolRequest::RequestMethod.Unknown
            return request

        def runner_dispatch(runner: Runner, request: DebuggerProtocolRequest::Request, expected_generation: u64) -> Runner:
            updated: mutable Runner = runner
            result: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(runner.session, request, expected_generation)
            updated.session <- result.session
            updated.last_status <- result.failure
            return updated

        def runner_can_inspect(runner: Runner) -> bool:
            return DebuggerSession::session_can_inspect(runner.session)

        def runner_is_closed(runner: Runner) -> bool:
            return runner.session.state == DebuggerSession::SessionState.Closed
