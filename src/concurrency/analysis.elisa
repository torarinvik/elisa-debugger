# Wait-for graph and bounded happens-before analysis for managed tasks.

include "./model.elisa"

module DebuggerConcurrencyAnalysis:
    private:
        const module Vector:
            CLOCK_WIDTH: usize = 64
            CLOCK_MAX: u64 = 18446744073709551615
            FIRST_CLOCK_INDEX: usize = 0
            TICK_INCREMENT: u64 = 1

        const module Wait:
            GRAPH_CAPACITY: usize = 256
            GRAPH_NO_ID: u64 = 0
            GRAPH_SYNC_KIND_MAX: u16 = 4
            EMPTY_EDGE_COUNT: usize = 0
            FIRST_EDGE_INDEX: usize = 0
            EDGE_COUNT_INCREMENT: usize = 1


    public:
        struct WaitGraph:
            edges: mutable DebuggerConcurrency::WaitEdge[Wait::GRAPH_CAPACITY]
            count: mutable usize

        struct VectorClock:
            values: mutable u64[Vector::CLOCK_WIDTH]

        def wait_graph_new() -> WaitGraph:
            graph: mutable WaitGraph = zeroed
            graph.count <- Wait::EMPTY_EDGE_COUNT
            return graph

        def wait_graph_add(graph: WaitGraph, edge: DebuggerConcurrency::WaitEdge) -> WaitGraph:
            updated: mutable WaitGraph = graph
            return updated if graph.count >= Wait::GRAPH_CAPACITY or edge.waiter.value == Wait::GRAPH_NO_ID or edge.owner.value == Wait::GRAPH_NO_ID or edge.resource.value == Wait::GRAPH_NO_ID or edge.kind.u16() > Wait::GRAPH_SYNC_KIND_MAX
            updated.edges[graph.count] <- edge
            updated.count <- graph.count + Wait::EDGE_COUNT_INCREMENT
            return updated

        def wait_graph_has_cycle(graph: WaitGraph&, task: DebuggerConcurrency::TaskInfo) -> bool:
            return false if graph.count > Wait::GRAPH_CAPACITY or task.id.value == Wait::GRAPH_NO_ID
            reachable: mutable bool[Wait::GRAPH_CAPACITY] = zeroed
            for hop in Wait::FIRST_EDGE_INDEX..<graph.count:
                changed: mutable bool = false
                for index in Wait::FIRST_EDGE_INDEX..<graph.count:
                    edge: DebuggerConcurrency::WaitEdge = graph.edges[index]
                    found: mutable bool = edge.waiter.value == task.id.value
                    if not found:
                        for candidate in Wait::FIRST_EDGE_INDEX..<graph.count:
                            found <- true if reachable[candidate] and graph.edges[candidate].owner.value == edge.waiter.value
                    if found:
                        return true if edge.owner.value == task.id.value
                        changed <- true if not reachable[index]
                        reachable[index] <- true
                break if not changed
            return false

        def vector_clock_new() -> VectorClock:
            return zeroed

        def vector_clock_tick(clock: VectorClock, task_index: usize) -> VectorClock:
            updated: mutable VectorClock = clock
            return updated if task_index >= Vector::CLOCK_WIDTH
            updated.values[task_index] <- Vector::CLOCK_MAX if updated.values[task_index] == Vector::CLOCK_MAX
            updated.values[task_index] <- updated.values[task_index] + Vector::TICK_INCREMENT if updated.values[task_index] < Vector::CLOCK_MAX
            return updated

        def vector_clock_happens_before(left: VectorClock&, right: VectorClock&) -> bool:
            strictly_less: mutable bool = false
            for index in Vector::FIRST_CLOCK_INDEX..<Vector::CLOCK_WIDTH:
                return false if left.values[index] > right.values[index]
                strictly_less <- true if left.values[index] < right.values[index]
            return strictly_less

        def vector_clock_merge(left: VectorClock, right: VectorClock) -> VectorClock:
            merged: mutable VectorClock = left
            for index in Vector::FIRST_CLOCK_INDEX..<Vector::CLOCK_WIDTH:
                merged.values[index] <- right.values[index] if right.values[index] > left.values[index]
            return merged

        def vector_clock_equal(left: VectorClock&, right: VectorClock&) -> bool:
            for index in Vector::FIRST_CLOCK_INDEX..<Vector::CLOCK_WIDTH:
                return false if left.values[index] != right.values[index]
            return true

        def vector_clock_concurrent(left: VectorClock&, right: VectorClock&) -> bool:
            return false if vector_clock_equal(left, right)
            return not vector_clock_happens_before(left, right) and not vector_clock_happens_before(right, left)
