# Serializable managed-task checkpoint.  It captures logical tasks and wait
# edges, never OS thread IDs as identity, and restores scheduler cursors.

include "./runtime.elisa"

module DebuggerConcurrencyCheckpoint:
    private:
        const TASK_CHECKPOINT_CAPACITY: usize = 64
        const WAIT_CHECKPOINT_CAPACITY: usize = 128
        const SCHEDULE_CHECKPOINT_CAPACITY: usize = 512

    public:
        struct TaskSnapshot:
            tasks: mutable DebuggerConcurrency::TaskInfo[TASK_CHECKPOINT_CAPACITY]
            task_count: mutable usize
            current: mutable DebuggerIdentity::DebugId
            waits: mutable DebuggerConcurrency::WaitEdge[WAIT_CHECKPOINT_CAPACITY]
            wait_count: mutable usize
            scheduler_cursor: mutable usize
            scheduler_count: mutable usize
            scheduler_replaying: mutable bool
            scheduler_diverged: mutable bool
            scheduler_overflowed: mutable bool
            scheduler_decisions: mutable DebuggerScheduler::ScheduleDecision[SCHEDULE_CHECKPOINT_CAPACITY]

        def task_snapshot_capture(runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime&) -> TaskSnapshot:
            snapshot: mutable TaskSnapshot = zeroed
            snapshot.tasks <- runtime.tasks
            snapshot.task_count <- runtime.task_count
            snapshot.current <- runtime.current
            snapshot.waits <- runtime.waits
            snapshot.wait_count <- runtime.wait_count
            snapshot.scheduler_cursor <- runtime.scheduler.cursor
            snapshot.scheduler_count <- runtime.scheduler.count
            snapshot.scheduler_replaying <- runtime.scheduler.replaying
            snapshot.scheduler_diverged <- runtime.scheduler.diverged
            snapshot.scheduler_overflowed <- runtime.scheduler.overflowed
            snapshot.scheduler_decisions <- runtime.scheduler.decisions
            return snapshot

        def task_snapshot_restore(runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime&, snapshot: TaskSnapshot) -> void:
            runtime.tasks <- snapshot.tasks
            runtime.task_count <- snapshot.task_count
            runtime.current <- snapshot.current
            runtime.waits <- snapshot.waits
            runtime.wait_count <- snapshot.wait_count
            runtime.scheduler.cursor <- snapshot.scheduler_cursor
            runtime.scheduler.count <- snapshot.scheduler_count
            runtime.scheduler.replaying <- snapshot.scheduler_replaying
            runtime.scheduler.diverged <- snapshot.scheduler_diverged
            runtime.scheduler.overflowed <- snapshot.scheduler_overflowed
            runtime.scheduler.decisions <- snapshot.scheduler_decisions

        def task_snapshot_matches(runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime&, snapshot: TaskSnapshot) -> bool:
            return false if runtime.task_count != snapshot.task_count or runtime.wait_count != snapshot.wait_count or runtime.current.value != snapshot.current.value or runtime.scheduler.cursor != snapshot.scheduler_cursor or runtime.scheduler.count != snapshot.scheduler_count or runtime.scheduler.replaying != snapshot.scheduler_replaying or runtime.scheduler.diverged != snapshot.scheduler_diverged or runtime.scheduler.overflowed != snapshot.scheduler_overflowed
            for index in 0..<snapshot.task_count:
                return false if runtime.tasks[index].id.value != snapshot.tasks[index].id.value or runtime.tasks[index].state != snapshot.tasks[index].state or runtime.tasks[index].logical_time != snapshot.tasks[index].logical_time
            for index in 0..<snapshot.wait_count:
                return false if runtime.waits[index].waiter.value != snapshot.waits[index].waiter.value or runtime.waits[index].owner.value != snapshot.waits[index].owner.value or runtime.waits[index].resource.value != snapshot.waits[index].resource.value
            for index in 0..<snapshot.scheduler_count:
                return false if runtime.scheduler.decisions[index].ordinal != snapshot.scheduler_decisions[index].ordinal or runtime.scheduler.decisions[index].task.id.value != snapshot.scheduler_decisions[index].task.id.value
            return true
