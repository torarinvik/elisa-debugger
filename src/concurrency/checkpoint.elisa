# Serializable managed-task checkpoint.  It captures logical tasks and wait
# edges, never OS thread IDs as identity, and restores scheduler cursors.

include "./runtime.elisa"

module DebuggerConcurrencyCheckpoint:
    private:
        const TASK_CHECKPOINT_CAPACITY: usize = 64
        const WAIT_CHECKPOINT_CAPACITY: usize = 128
        const SCHEDULE_CHECKPOINT_CAPACITY: usize = 512
        const TASK_STATE_MAX: u16 = 5
        const SYNCHRONIZATION_KIND_MAX: u16 = 4
        const RUNTIME_STATUS_MAX: u16 = 4
        const SCHEDULE_KIND_MAX: u16 = 6

    public:
        struct TaskSnapshot:
            tasks: mutable DebuggerConcurrency::TaskInfo[TASK_CHECKPOINT_CAPACITY]
            task_count: mutable usize
            next_id: mutable u64
            status: mutable DebuggerConcurrencyRuntime::RuntimeStatus
            current: mutable DebuggerIdentity::DebugId
            waits: mutable DebuggerConcurrency::WaitEdge[WAIT_CHECKPOINT_CAPACITY]
            wait_count: mutable usize
            scheduler_cursor: mutable usize
            scheduler_count: mutable usize
            scheduler_replaying: mutable bool
            scheduler_diverged: mutable bool
            scheduler_overflowed: mutable bool
            scheduler_decisions: mutable DebuggerScheduler::ScheduleDecision[SCHEDULE_CHECKPOINT_CAPACITY]

        def task_snapshot_capture(runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime&) -> TaskSnapshot:
            snapshot: mutable TaskSnapshot = zeroed
            snapshot.tasks <- runtime.tasks
            snapshot.task_count <- runtime.task_count
            snapshot.next_id <- runtime.next_id
            snapshot.status <- runtime.status
            snapshot.current <- runtime.current
            snapshot.waits <- runtime.waits
            snapshot.wait_count <- runtime.wait_count
            snapshot.scheduler_cursor <- runtime.scheduler.cursor
            snapshot.scheduler_count <- runtime.scheduler.count
            snapshot.scheduler_replaying <- runtime.scheduler.replaying
            snapshot.scheduler_diverged <- runtime.scheduler.diverged
            snapshot.scheduler_overflowed <- runtime.scheduler.overflowed
            snapshot.scheduler_decisions <- runtime.scheduler.decisions
            return snapshot

        def task_snapshot_restore(runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime&, snapshot: TaskSnapshot) -> void:
            return if snapshot.task_count > TASK_CHECKPOINT_CAPACITY or snapshot.wait_count > WAIT_CHECKPOINT_CAPACITY or snapshot.scheduler_count > SCHEDULE_CHECKPOINT_CAPACITY or snapshot.scheduler_cursor > snapshot.scheduler_count
            return if snapshot.status.u16() > RUNTIME_STATUS_MAX
            for index in 0..<snapshot.task_count:
                return if snapshot.tasks[index].state.u16() > TASK_STATE_MAX
            for index in 0..<snapshot.wait_count:
                return if snapshot.waits[index].kind.u16() > SYNCHRONIZATION_KIND_MAX
            for index in 0..<snapshot.scheduler_count:
                return if snapshot.scheduler_decisions[index].ordinal != index.u64() or snapshot.scheduler_decisions[index].kind.u16() > SCHEDULE_KIND_MAX or snapshot.scheduler_decisions[index].task.state.u16() > TASK_STATE_MAX
            runtime.tasks <- snapshot.tasks
            runtime.task_count <- snapshot.task_count
            runtime.next_id <- snapshot.next_id
            runtime.status <- snapshot.status
            runtime.current <- snapshot.current
            runtime.waits <- snapshot.waits
            runtime.wait_count <- snapshot.wait_count
            runtime.scheduler.cursor <- snapshot.scheduler_cursor
            runtime.scheduler.count <- snapshot.scheduler_count
            runtime.scheduler.replaying <- snapshot.scheduler_replaying
            runtime.scheduler.diverged <- snapshot.scheduler_diverged
            runtime.scheduler.overflowed <- snapshot.scheduler_overflowed
            runtime.scheduler.decisions <- snapshot.scheduler_decisions

        def task_snapshot_matches(runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime&, snapshot: TaskSnapshot) -> bool:
            return false if runtime.task_count > TASK_CHECKPOINT_CAPACITY or runtime.wait_count > WAIT_CHECKPOINT_CAPACITY or runtime.scheduler.count > SCHEDULE_CHECKPOINT_CAPACITY or runtime.scheduler.cursor > runtime.scheduler.count
            return false if snapshot.task_count > TASK_CHECKPOINT_CAPACITY or snapshot.wait_count > WAIT_CHECKPOINT_CAPACITY or snapshot.scheduler_count > SCHEDULE_CHECKPOINT_CAPACITY or snapshot.scheduler_cursor > snapshot.scheduler_count
            return false if runtime.status.u16() > RUNTIME_STATUS_MAX or snapshot.status.u16() > RUNTIME_STATUS_MAX
            for index in 0..<runtime.task_count:
                return false if runtime.tasks[index].state.u16() > TASK_STATE_MAX
            for index in 0..<snapshot.task_count:
                return false if snapshot.tasks[index].state.u16() > TASK_STATE_MAX
            for index in 0..<runtime.wait_count:
                return false if runtime.waits[index].kind.u16() > SYNCHRONIZATION_KIND_MAX
            for index in 0..<snapshot.wait_count:
                return false if snapshot.waits[index].kind.u16() > SYNCHRONIZATION_KIND_MAX
            for index in 0..<runtime.scheduler.count:
                return false if runtime.scheduler.decisions[index].ordinal != index.u64() or runtime.scheduler.decisions[index].kind.u16() > SCHEDULE_KIND_MAX or runtime.scheduler.decisions[index].task.state.u16() > TASK_STATE_MAX
            for index in 0..<snapshot.scheduler_count:
                return false if snapshot.scheduler_decisions[index].ordinal != index.u64() or snapshot.scheduler_decisions[index].kind.u16() > SCHEDULE_KIND_MAX or snapshot.scheduler_decisions[index].task.state.u16() > TASK_STATE_MAX
            return false if runtime.next_id != snapshot.next_id or runtime.status != snapshot.status
            return false if runtime.task_count != snapshot.task_count or runtime.wait_count != snapshot.wait_count or runtime.current.value != snapshot.current.value or runtime.scheduler.cursor != snapshot.scheduler_cursor or runtime.scheduler.count != snapshot.scheduler_count or runtime.scheduler.replaying != snapshot.scheduler_replaying or runtime.scheduler.diverged != snapshot.scheduler_diverged or runtime.scheduler.overflowed != snapshot.scheduler_overflowed
            for index in 0..<snapshot.task_count:
                return false if runtime.tasks[index].id.value != snapshot.tasks[index].id.value or runtime.tasks[index].state != snapshot.tasks[index].state or runtime.tasks[index].logical_time != snapshot.tasks[index].logical_time
            for index in 0..<snapshot.wait_count:
                return false if runtime.waits[index].waiter.value != snapshot.waits[index].waiter.value or runtime.waits[index].owner.value != snapshot.waits[index].owner.value or runtime.waits[index].resource.value != snapshot.waits[index].resource.value or runtime.waits[index].kind != snapshot.waits[index].kind
            for index in 0..<snapshot.scheduler_count:
                return false if runtime.scheduler.decisions[index].ordinal != snapshot.scheduler_decisions[index].ordinal or runtime.scheduler.decisions[index].task.id.value != snapshot.scheduler_decisions[index].task.id.value or runtime.scheduler.decisions[index].task.state != snapshot.scheduler_decisions[index].task.state or runtime.scheduler.decisions[index].task.logical_time != snapshot.scheduler_decisions[index].task.logical_time or runtime.scheduler.decisions[index].task.os_thread != snapshot.scheduler_decisions[index].task.os_thread or runtime.scheduler.decisions[index].kind != snapshot.scheduler_decisions[index].kind or runtime.scheduler.decisions[index].synchronization != snapshot.scheduler_decisions[index].synchronization
            return true
