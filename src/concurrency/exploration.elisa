# Bounded alternate-schedule and observed-race analysis.  Exploration results
# are deliberately scoped to the configured bound and observed accesses.

include "./model.elisa"
include "./scheduler.elisa"
include "./analysis.elisa"
include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerConcurrencyExploration:
    private:
        const module Access:
            CONCURRENCY_EXPLORATION_ACCESS_KIND_MAX: u16 = 1

        const module Detail:
            LIMIT: u32 = 1
            RACE: u32 = 2

        const module Explore:
            CONCURRENCY_EXPLORATION_EXPLORE_TASK_CAPACITY: usize = 32
            CONCURRENCY_EXPLORATION_EXPLORE_EVENT_CAPACITY: usize = 256
            MAX_PREEMPTIONS: u64 = 1024
            EMPTY_COUNT: usize = 0
            FIRST_INDEX: usize = 0
            COUNT_INCREMENT: usize = 1
            EXPLORED_INCREMENT: u64 = 1
            NEXT_RECORD_OFFSET: usize = 1
            NO_TASKS: usize = 0
            NO_BUDGET: u64 = 0


    public:
        struct ExplorationLimits:
            max_tasks: mutable u64
            max_preemptions: mutable u64
            max_events: mutable u64
            max_branches: mutable u64

        struct ScheduleAlternative:
            decision: mutable u64
            original_task: mutable DebuggerIdentity::DebugId
            alternate_task: mutable DebuggerIdentity::DebugId
            preemptions: mutable u64

        struct ExplorationResult:
            alternatives: mutable ScheduleAlternative[Explore::CONCURRENCY_EXPLORATION_EXPLORE_EVENT_CAPACITY]
            count: mutable usize
            explored: mutable u64
            bounded: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        struct AccessRecord:
            event: mutable u64
            task: mutable DebuggerIdentity::DebugId
            allocation: mutable DebuggerIdentity::AllocationIdentity
            write: mutable bool
            clock: mutable DebuggerConcurrencyAnalysis::VectorClock

        struct RaceResult:
            race: mutable bool
            first: mutable AccessRecord
            second: mutable AccessRecord
            failure: mutable DebuggerErrors::DebuggerError

        def exploration_limits_default() -> ExplorationLimits:
            return ExplorationLimits{max_tasks: Explore::CONCURRENCY_EXPLORATION_EXPLORE_TASK_CAPACITY.u64(), max_preemptions: Explore::MAX_PREEMPTIONS, max_events: Explore::CONCURRENCY_EXPLORATION_EXPLORE_EVENT_CAPACITY.u64(), max_branches: Explore::CONCURRENCY_EXPLORATION_EXPLORE_EVENT_CAPACITY.u64()}

        def explore_schedules(scheduler: DebuggerScheduler::DeterministicScheduler&, tasks: DebuggerConcurrency::TaskInfo[Explore::CONCURRENCY_EXPLORATION_EXPLORE_TASK_CAPACITY], task_count: usize, limits: ExplorationLimits) -> ExplorationResult:
            result: mutable ExplorationResult = zeroed
            result.failure <- DebuggerErrors::no_error()
            return ExplorationResult{alternatives: result.alternatives, count: Explore::EMPTY_COUNT, explored: Explore::NO_BUDGET, bounded: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::LIMIT)} if not DebuggerScheduler::scheduler_is_exact(scheduler)
            return ExplorationResult{alternatives: result.alternatives, count: Explore::EMPTY_COUNT, explored: Explore::NO_BUDGET, bounded: true, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Detail::LIMIT)} if task_count == Explore::NO_TASKS or task_count > Explore::CONCURRENCY_EXPLORATION_EXPLORE_TASK_CAPACITY or limits.max_tasks == Explore::NO_BUDGET or task_count.u64() > limits.max_tasks or limits.max_preemptions == Explore::NO_BUDGET or limits.max_events == Explore::NO_BUDGET or limits.max_branches == Explore::NO_BUDGET
            return ExplorationResult{alternatives: result.alternatives, count: Explore::EMPTY_COUNT, explored: Explore::NO_BUDGET, bounded: true, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::LIMIT)} if scheduler.count > Explore::CONCURRENCY_EXPLORATION_EXPLORE_EVENT_CAPACITY
            for decision_index in Explore::FIRST_INDEX..<scheduler.count:
                break if decision_index.u64() >= limits.max_events
                if result.count >= limits.max_branches.usize() or result.count >= Explore::CONCURRENCY_EXPLORATION_EXPLORE_EVENT_CAPACITY:
                    result.bounded <- true
                    return result
                decision: DebuggerScheduler::ScheduleDecision = scheduler.decisions[decision_index]
                for task_index in Explore::FIRST_INDEX..<task_count:
                    candidate: DebuggerConcurrency::TaskInfo = tasks[task_index]
                    continue if candidate.id.value == decision.task.id.value or candidate.state != DebuggerConcurrency::TaskState.Runnable
                    if result.explored >= limits.max_preemptions:
                        result.bounded <- true
                        return result
                    alternative: ScheduleAlternative = ScheduleAlternative{decision: decision_index.u64(), original_task: decision.task.id, alternate_task: candidate.id, preemptions: 1}
                    result.alternatives[result.count] <- alternative
                    result.count <- result.count + Explore::COUNT_INCREMENT
                    result.explored <- result.explored + Explore::EXPLORED_INCREMENT
                    break if result.count.u64() >= limits.max_branches
                break if result.count.u64() >= limits.max_branches
            result.bounded <- result.count.u64() >= limits.max_branches or scheduler.count.u64() > limits.max_events
            return result

        def access_records_conflict(left: AccessRecord&, right: AccessRecord&) -> bool:
            return false if left.allocation.allocation.value != right.allocation.allocation.value or left.allocation.generation != right.allocation.generation or left.allocation.offset != right.allocation.offset
            return false if left.task.value == right.task.value or (not left.write and not right.write)
            # Access records from distinct tasks may legitimately carry the
            # same clock when neither task has observed a synchronization
            # edge.  Equal clocks therefore do not establish ordering here;
            # the task identity check above already rules out same-task
            # observations.
            return true if DebuggerConcurrencyAnalysis::vector_clock_equal(left.clock, right.clock)
            return true if DebuggerConcurrencyAnalysis::vector_clock_concurrent(left.clock, right.clock)
            return false

        def find_observed_race(records: AccessRecord[Explore::CONCURRENCY_EXPLORATION_EXPLORE_EVENT_CAPACITY]&, count: usize) -> RaceResult:
            result: mutable RaceResult = zeroed
            result.failure <- DebuggerErrors::no_error()
            return RaceResult{race: false, first: result.first, second: result.second, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Detail::RACE)} if count > Explore::CONCURRENCY_EXPLORATION_EXPLORE_EVENT_CAPACITY
            for left_index in Explore::FIRST_INDEX..<count:
                for right_index in left_index + Explore::NEXT_RECORD_OFFSET..<count:
                    if access_records_conflict(records[left_index], records[right_index]):
                        result.race <- true
                        result.first <- records[left_index]
                        result.second <- records[right_index]
                        return result
            return result
