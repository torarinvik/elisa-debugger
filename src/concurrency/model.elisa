# Logical task and synchronization identities are independent of recycled OS
# thread IDs and addresses.

include "../core/identity.elisa"

module DebuggerConcurrency:
    public:
        enum TaskState:
            Created
            Runnable
            Running
            Blocked
            Completed
            Cancelled

        enum SynchronizationKind:
            Mutex
            Condition
            Join
            Channel
            Atomic

        struct TaskInfo:
            id: mutable DebuggerIdentity::DebugId
            parent: mutable DebuggerIdentity::DebugId
            state: mutable TaskState
            logical_time: mutable u64
            os_thread: mutable u64

        struct WaitEdge:
            waiter: mutable DebuggerIdentity::DebugId
            owner: mutable DebuggerIdentity::DebugId
            resource: mutable DebuggerIdentity::DebugId
            kind: mutable SynchronizationKind

        def task_is_active(task: TaskInfo) -> bool:
            return task.state == TaskState.Runnable or task.state == TaskState.Running or task.state == TaskState.Blocked

        def wait_edge_is_self_cycle(edge: WaitEdge) -> bool:
            return edge.waiter.value == edge.owner.value
