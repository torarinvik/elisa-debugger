# Deterministic scheduler decisions are part of an exact recording.  The VM
# consumes these decisions during replay instead of asking the host scheduler.

include "./model.elisa"

module DebuggerScheduler:
    private:
        const module Schedule:
            CONCURRENCY_SCHEDULER_SCHEDULE_CAPACITY: usize = 512
            CONCURRENCY_SCHEDULER_SCHEDULE_KIND_MAX: u16 = 6
            CONCURRENCY_SCHEDULER_SCHEDULE_TASK_STATE_MAX: u16 = 5
            NO_TASK_ID: u64 = 0
            NO_SYNC_ID: u64 = 0


        def schedule_kind_requires_sync(kind: ScheduleKind) -> bool:
            return kind == ScheduleKind.LockAcquire or kind == ScheduleKind.LockRelease or kind == ScheduleKind.Wait or kind == ScheduleKind.Wake or kind == ScheduleKind.Join

    public:
        enum ScheduleKind:
            Run
            Yield
            LockAcquire
            LockRelease
            Wait
            Wake
            Join

        struct ScheduleDecision:
            ordinal: mutable u64
            task: mutable DebuggerConcurrency::TaskInfo
            kind: mutable ScheduleKind
            synchronization: mutable u64

        struct DeterministicScheduler:
            decisions: mutable ScheduleDecision[Schedule::CONCURRENCY_SCHEDULER_SCHEDULE_CAPACITY]
            count: mutable usize
            cursor: mutable usize
            replaying: mutable bool
            diverged: mutable bool
            overflowed: mutable bool

        def scheduler_decision_is_valid(decision: ScheduleDecision) -> bool:
            return false if decision.kind.u16() > Schedule::CONCURRENCY_SCHEDULER_SCHEDULE_KIND_MAX or decision.task.id.value == Schedule::NO_TASK_ID or decision.task.state.u16() > Schedule::CONCURRENCY_SCHEDULER_SCHEDULE_TASK_STATE_MAX
            return false if schedule_kind_requires_sync(decision.kind) and decision.synchronization == Schedule::NO_SYNC_ID
            return false if not schedule_kind_requires_sync(decision.kind) and decision.synchronization != Schedule::NO_SYNC_ID
            return true

        def scheduler_decision_matches_task(decision: ScheduleDecision, task: DebuggerConcurrency::TaskInfo) -> bool:
            return false if decision.task.id.value != task.id.value or decision.task.parent.value != task.parent.value
            return false if decision.task.logical_time > task.logical_time
            return decision.task.state == DebuggerConcurrency::TaskState.Blocked if decision.kind == ScheduleKind.Wake
            return decision.task.state == DebuggerConcurrency::TaskState.Runnable or decision.task.state == DebuggerConcurrency::TaskState.Running

        def scheduler_new(replaying: bool) -> DeterministicScheduler:
            scheduler: mutable DeterministicScheduler = zeroed
            scheduler.count <- 0
            scheduler.cursor <- 0
            scheduler.replaying <- replaying
            scheduler.diverged <- false
            scheduler.overflowed <- false
            return scheduler

        def scheduler_append(scheduler: DeterministicScheduler, decision: ScheduleDecision) -> DeterministicScheduler:
            updated: mutable DeterministicScheduler = scheduler
            return updated if scheduler.replaying
            if not scheduler_decision_is_valid(decision):
                updated.diverged <- true
                return updated
            if decision.ordinal != scheduler.count.u64():
                updated.diverged <- true
                return updated
            if scheduler.count >= Schedule::CONCURRENCY_SCHEDULER_SCHEDULE_CAPACITY:
                updated.overflowed <- true
                updated.diverged <- true
                return updated
            updated.decisions[scheduler.count] <- decision
            updated.count <- scheduler.count + 1
            return updated

        def scheduler_next_with_sync(scheduler: DeterministicScheduler, task: DebuggerConcurrency::TaskInfo, kind: ScheduleKind, synchronization: DebuggerIdentity::DebugId) -> DeterministicScheduler:
            updated: mutable DeterministicScheduler = scheduler
            if not scheduler.replaying:
                return scheduler_append(scheduler, ScheduleDecision{ordinal: scheduler.count.u64(), task: task, kind: kind, synchronization: synchronization.value})
            if scheduler.count > Schedule::CONCURRENCY_SCHEDULER_SCHEDULE_CAPACITY or scheduler.cursor > scheduler.count:
                updated.diverged <- true
                return updated
            if scheduler.cursor >= scheduler.count:
                updated.diverged <- true
                return updated
            expected: ScheduleDecision = scheduler.decisions[scheduler.cursor]
            # OS thread numbers are host attributes and can be reused or
            # remapped between record and replay. Logical task identity,
            # state, and logical time are the deterministic scheduler
            # contract, so host thread numbers must not cause divergence.
            if expected.ordinal != scheduler.cursor.u64() or not scheduler_decision_is_valid(expected) or kind.u16() > Schedule::CONCURRENCY_SCHEDULER_SCHEDULE_KIND_MAX or task.id.value == Schedule::NO_TASK_ID or task.state.u16() > Schedule::CONCURRENCY_SCHEDULER_SCHEDULE_TASK_STATE_MAX or schedule_kind_requires_sync(kind) and synchronization.value == Schedule::NO_SYNC_ID or not schedule_kind_requires_sync(kind) and synchronization.value != Schedule::NO_SYNC_ID or expected.task.id.value != task.id.value or expected.task.parent.value != task.parent.value or expected.task.state != task.state or expected.task.logical_time != task.logical_time or expected.kind != kind or expected.synchronization != synchronization.value:
                updated.diverged <- true
                return updated
            updated.cursor <- scheduler.cursor + 1
            return updated

        def scheduler_next(scheduler: DeterministicScheduler, task: DebuggerConcurrency::TaskInfo, kind: ScheduleKind) -> DeterministicScheduler:
            return scheduler_next_with_sync(scheduler, task, kind, DebuggerIdentity::debug_id(0))

        def scheduler_state_is_valid(scheduler: DeterministicScheduler) -> bool:
            return false if scheduler.count > Schedule::CONCURRENCY_SCHEDULER_SCHEDULE_CAPACITY or scheduler.cursor > scheduler.count
            return false if not scheduler.replaying and scheduler.cursor != 0
            return false if scheduler.overflowed and not scheduler.diverged
            for index in 0..<scheduler.count:
                decision: ScheduleDecision = scheduler.decisions[index]
                return false if decision.ordinal != index.u64() or not scheduler_decision_is_valid(decision)
            return true

        def scheduler_is_exact(scheduler: DeterministicScheduler) -> bool:
            return false if not scheduler_state_is_valid(scheduler) or scheduler.diverged or scheduler.overflowed
            return false if scheduler.replaying and scheduler.cursor != scheduler.count
            return true
