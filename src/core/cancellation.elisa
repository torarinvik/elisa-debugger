# Cooperative cancellation and progress accounting for long replay/query work.

module DebuggerCancellation:
    private:
        const INITIAL_GENERATION: u64 = 0
        const PROGRESS_NONE: u64 = 0
        const PROGRESS_MAX_VALUE: u64 = 18446744073709551615

    public:
        struct CancellationToken:
            generation: mutable u64
            cancelled: mutable bool
            deadline_tick: mutable u64

        struct Progress:
            completed: mutable u64
            total: mutable u64
            phase: mutable u32

        def cancellation_token_new(deadline_tick: u64) -> CancellationToken:
            return CancellationToken{generation: INITIAL_GENERATION, cancelled: false, deadline_tick: deadline_tick}

        def cancellation_cancel(token: CancellationToken) -> CancellationToken:
            updated: mutable CancellationToken = token
            updated.cancelled <- true
            updated.generation <- updated.generation + 1 if updated.generation < PROGRESS_MAX_VALUE
            return updated

        def cancellation_is_requested(token: CancellationToken, now_tick: u64) -> bool:
            return token.cancelled or (token.deadline_tick > 0 and now_tick >= token.deadline_tick)

        def progress_new(total: u64, phase: u32) -> Progress:
            return Progress{completed: PROGRESS_NONE, total: total, phase: phase}

        def progress_advance(progress: Progress, amount: u64) -> Progress:
            updated: mutable Progress = progress
            updated.completed <- PROGRESS_MAX_VALUE if amount > PROGRESS_MAX_VALUE - progress.completed
            updated.completed <- progress.completed + amount if amount <= PROGRESS_MAX_VALUE - progress.completed
            if updated.total > 0 and updated.completed > updated.total:
                updated.completed <- updated.total
            return updated
