# Capabilities are negotiated per session.

module DebuggerCapabilities:
    private:
        const ENGINE_KIND_MAX: u16 = 3
        const HISTORY_KIND_MAX: u16 = 3

    public:
        enum EngineKind:
            Managed
            InstrumentedNative
            AttachedNative
            Postmortem

        enum HistoryKind:
            None
            Observational
            Replayable
            Exact

        struct CapabilitySet:
            engine: mutable EngineKind
            history: mutable HistoryKind
            source_breakpoints: mutable bool
            function_breakpoints: mutable bool
            data_breakpoints: mutable bool
            typed_values: mutable bool
            expression_evaluation: mutable bool
            reverse_execution: mutable bool
            checkpoints: mutable bool
            branches: mutable bool
            concurrency_graph: mutable bool
            provenance: mutable bool
            remote_transport: mutable bool

        def managed_capabilities() -> CapabilitySet:
            return CapabilitySet{
                engine: EngineKind.Managed,
                history: HistoryKind.Exact,
                source_breakpoints: true,
                function_breakpoints: true,
                data_breakpoints: true,
                typed_values: true,
                expression_evaluation: true,
                reverse_execution: true,
                checkpoints: true,
                branches: true,
                concurrency_graph: true,
                provenance: true,
                remote_transport: true
            }

        def native_live_capabilities() -> CapabilitySet:
            return CapabilitySet{
                engine: EngineKind.InstrumentedNative,
                history: HistoryKind.Observational,
                source_breakpoints: true,
                function_breakpoints: true,
                data_breakpoints: false,
                typed_values: true,
                expression_evaluation: true,
                reverse_execution: false,
                checkpoints: false,
                branches: false,
                concurrency_graph: false,
                provenance: false,
                remote_transport: true
            }

        def native_attach_capabilities() -> CapabilitySet:
            return CapabilitySet{
                engine: EngineKind.AttachedNative,
                history: HistoryKind.None,
                source_breakpoints: true,
                function_breakpoints: true,
                data_breakpoints: false,
                typed_values: true,
                expression_evaluation: false,
                reverse_execution: false,
                checkpoints: false,
                branches: false,
                concurrency_graph: false,
                provenance: false,
                remote_transport: true
            }

        def postmortem_capabilities() -> CapabilitySet:
            return CapabilitySet{
                engine: EngineKind.Postmortem,
                history: HistoryKind.None,
                source_breakpoints: false,
                function_breakpoints: false,
                data_breakpoints: false,
                typed_values: true,
                expression_evaluation: false,
                reverse_execution: false,
                checkpoints: false,
                branches: false,
                concurrency_graph: false,
                provenance: false,
                remote_transport: false
            }

        def capabilities_is_valid(capabilities: CapabilitySet) -> bool:
            return false if capabilities.engine.u16() > ENGINE_KIND_MAX or capabilities.history.u16() > HISTORY_KIND_MAX
            return false if capabilities.reverse_execution and capabilities.history != HistoryKind.Exact
            return false if capabilities.checkpoints and capabilities.engine != EngineKind.Managed
            return false if capabilities.branches and capabilities.history != HistoryKind.Exact
            return false if capabilities.provenance and not capabilities.typed_values
            return true

        def capability_supports_history(capabilities: CapabilitySet, history: HistoryKind) -> bool:
            return capabilities_is_valid(capabilities) and capabilities.history.u16() >= history.u16()
