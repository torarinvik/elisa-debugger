# Capabilities are negotiated per session.

module DebuggerCapabilities:
    private:
        const module Engine:
            CORE_CAPABILITIES_ENGINE_KIND_MAX: u16 = 3

        const module History:
            CORE_CAPABILITIES_HISTORY_KIND_MAX: u16 = 3


    public:
        enum EngineKind:
            Managed
            InstrumentedNative
            AttachedNative
            Postmortem

        enum HistoryKind:
            None
            Observational
            Replayable
            Exact

        struct CapabilitySet:
            engine: mutable EngineKind
            history: mutable HistoryKind
            source_breakpoints: mutable bool
            function_breakpoints: mutable bool
            data_breakpoints: mutable bool
            typed_values: mutable bool
            expression_evaluation: mutable bool
            reverse_execution: mutable bool
            checkpoints: mutable bool
            branches: mutable bool
            concurrency_graph: mutable bool
            provenance: mutable bool
            remote_transport: mutable bool
            trace_verification: mutable bool
            trace_export: mutable bool
            historical_queries: mutable bool
            schedule_exploration: mutable bool
            memory_read: mutable bool
            native_attach: mutable bool
            postmortem_inspection: mutable bool

        def managed_capabilities() -> CapabilitySet:
            return CapabilitySet{
                engine: EngineKind.Managed,
                history: HistoryKind.Exact,
                source_breakpoints: true,
                function_breakpoints: false,
                data_breakpoints: false,
                typed_values: true,
                expression_evaluation: false,
                reverse_execution: true,
                checkpoints: true,
                branches: true,
                concurrency_graph: false,
                provenance: false,
                remote_transport: false,
                trace_verification: true,
                trace_export: true,
                historical_queries: false,
                schedule_exploration: false,
                memory_read: true,
                native_attach: false,
                postmortem_inspection: false
            }

        def native_live_capabilities() -> CapabilitySet:
            return CapabilitySet{
                engine: EngineKind.InstrumentedNative,
                history: HistoryKind.None,
                source_breakpoints: false,
                function_breakpoints: false,
                data_breakpoints: false,
                typed_values: false,
                expression_evaluation: false,
                reverse_execution: false,
                checkpoints: false,
                branches: false,
                concurrency_graph: false,
                provenance: false,
                remote_transport: false,
                trace_verification: false,
                trace_export: false,
                historical_queries: false,
                schedule_exploration: false,
                memory_read: false,
                native_attach: false,
                postmortem_inspection: false
            }

        def native_attach_capabilities() -> CapabilitySet:
            return CapabilitySet{
                engine: EngineKind.AttachedNative,
                history: HistoryKind.None,
                source_breakpoints: false,
                function_breakpoints: false,
                data_breakpoints: false,
                typed_values: false,
                expression_evaluation: false,
                reverse_execution: false,
                checkpoints: false,
                branches: false,
                concurrency_graph: false,
                provenance: false,
                remote_transport: false,
                trace_verification: false,
                trace_export: false,
                historical_queries: false,
                schedule_exploration: false,
                memory_read: false,
                native_attach: false,
                postmortem_inspection: false
            }

        def postmortem_capabilities() -> CapabilitySet:
            return CapabilitySet{
                engine: EngineKind.Postmortem,
                history: HistoryKind.None,
                source_breakpoints: false,
                function_breakpoints: false,
                data_breakpoints: false,
                typed_values: false,
                expression_evaluation: false,
                reverse_execution: false,
                checkpoints: false,
                branches: false,
                concurrency_graph: false,
                provenance: false,
                remote_transport: false,
                trace_verification: false,
                trace_export: false,
                historical_queries: false,
                schedule_exploration: false,
                memory_read: false,
                native_attach: false,
                postmortem_inspection: false
            }

        def capabilities_is_valid(capabilities: CapabilitySet) -> bool:
            return false if capabilities.engine.u16() > Engine::CORE_CAPABILITIES_ENGINE_KIND_MAX or capabilities.history.u16() > History::CORE_CAPABILITIES_HISTORY_KIND_MAX
            return false if capabilities.reverse_execution and capabilities.history != HistoryKind.Exact
            return false if capabilities.checkpoints and capabilities.engine != EngineKind.Managed
            return false if capabilities.branches and capabilities.history != HistoryKind.Exact
            return false if capabilities.provenance and not capabilities.typed_values
            return false if capabilities.trace_export and not capabilities.trace_verification
            return false if capabilities.historical_queries and capabilities.history == HistoryKind.None
            return false if capabilities.schedule_exploration and (not capabilities.concurrency_graph or capabilities.engine != EngineKind.Managed)
            return false if capabilities.native_attach and capabilities.engine != EngineKind.AttachedNative
            return false if capabilities.postmortem_inspection and capabilities.engine != EngineKind.Postmortem
            return true

        def capability_supports_history(capabilities: CapabilitySet, history: HistoryKind) -> bool:
            return capabilities_is_valid(capabilities) and capabilities.history.u16() >= history.u16()
