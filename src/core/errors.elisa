# Stable, machine-readable debugger errors.  Adapters can expose the code and
# retryability without parsing a human message.

module DebuggerErrors:
    private:
        const ERROR_CODE_UNKNOWN: u32 = 0
        const ERROR_CODE_MAX: u16 = 12
        const ERROR_SEVERITY_MAX: u16 = 2

    public:
        enum ErrorCode:
            None
            InvalidArgument
            InvalidState
            StaleGeneration
            Unsupported
            Unavailable
            Corrupt
            Diverged
            Cancelled
            ResourceLimit
            PermissionDenied
            Transport
            Internal

        enum ErrorSeverity:
            Info
            Warning
            Failure

        struct DebuggerError:
            code: mutable ErrorCode
            severity: mutable ErrorSeverity
            retryable: mutable bool
            detail: mutable u32

        def no_error() -> DebuggerError:
            return DebuggerError{code: ErrorCode.None, severity: ErrorSeverity.Info, retryable: false, detail: ERROR_CODE_UNKNOWN}

        def make_error(code: ErrorCode, retryable: bool, detail: u32) -> DebuggerError:
            return DebuggerError{code: code, severity: ErrorSeverity.Failure, retryable: retryable, detail: detail}

        def error_is_ok(value: DebuggerError) -> bool:
            return value.code == ErrorCode.None and value.severity == ErrorSeverity.Info and not value.retryable and value.detail == ERROR_CODE_UNKNOWN

        def error_code_is_valid(code: ErrorCode) -> bool:
            return code.u16() <= ERROR_CODE_MAX

        def error_severity_is_valid(severity: ErrorSeverity) -> bool:
            return severity.u16() <= ERROR_SEVERITY_MAX

        def error_is_well_formed(value: DebuggerError) -> bool:
            return false if not error_code_is_valid(value.code) or not error_severity_is_valid(value.severity)
            return false if value.code == ErrorCode.None and (value.severity != ErrorSeverity.Info or value.retryable or value.detail != ERROR_CODE_UNKNOWN)
            return false if value.code != ErrorCode.None and value.severity == ErrorSeverity.Info
            return true

        def error_is_retryable(value: DebuggerError) -> bool:
            return value.retryable
