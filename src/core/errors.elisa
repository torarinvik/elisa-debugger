# Stable, machine-readable debugger errors.  Adapters can expose the code and
# retryability without parsing a human message.

module DebuggerErrors:
    private:
        const ERROR_CODE_UNKNOWN: u32 = 0

    public:
        enum ErrorCode:
            None
            InvalidArgument
            InvalidState
            StaleGeneration
            Unsupported
            Unavailable
            Corrupt
            Diverged
            Cancelled
            ResourceLimit
            PermissionDenied
            Transport
            Internal

        enum ErrorSeverity:
            Info
            Warning
            Failure

        struct DebuggerError:
            code: mutable ErrorCode
            severity: mutable ErrorSeverity
            retryable: mutable bool
            detail: mutable u32

        def no_error() -> DebuggerError:
            return DebuggerError{code: ErrorCode.None, severity: ErrorSeverity.Info, retryable: false, detail: ERROR_CODE_UNKNOWN}

        def make_error(code: ErrorCode, retryable: bool, detail: u32) -> DebuggerError:
            return DebuggerError{code: code, severity: ErrorSeverity.Failure, retryable: retryable, detail: detail}

        def error_is_ok(value: DebuggerError) -> bool:
            return value.code == ErrorCode.None and value.severity == ErrorSeverity.Info and not value.retryable and value.detail == ERROR_CODE_UNKNOWN

        def error_is_retryable(value: DebuggerError) -> bool:
            return value.retryable
