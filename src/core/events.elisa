include "./identity.elisa"

module DebuggerEvents:
    private:
        const module Event:
            CORE_EVENTS_EVENT_KIND_MAX: u16 = 20
            CORE_EVENTS_EVENT_QUALITY_MAX: u16 = 4


    public:
        enum EventKind:
            ExecutionBoundary
            CallEntry
            CallExit
            Unwind
            ScopeEnter
            ScopeExit
            Allocation
            Release
            RegionReset
            MutationAttempt
            MutationCommit
            Input
            Output
            Scheduler
            Synchronization
            Atomic
            Fault
            Checkpoint
            Module
            DebuggerMutation
            TraceHealth

        enum EventQuality:
            Exact
            Partial
            Observational
            Diverged
            Corrupt

        struct EventEnvelope:
            schema: mutable u32
            ordinal: mutable u64
            task: mutable DebuggerIdentity::DebugId
            position: mutable DebuggerIdentity::Position
            kind: mutable EventKind
            quality: mutable EventQuality
            payload_hash: mutable u64

        def event_is_committed(event: EventEnvelope) -> bool:
            return event.kind == EventKind.MutationCommit or event.kind == EventKind.Output or event.kind == EventKind.Input

        def event_kind_is_valid(kind: EventKind) -> bool:
            return kind.u16() <= Event::CORE_EVENTS_EVENT_KIND_MAX

        def event_quality_is_valid(quality: EventQuality) -> bool:
            return quality.u16() <= Event::CORE_EVENTS_EVENT_QUALITY_MAX

        def event_envelope_is_well_formed(event: EventEnvelope) -> bool:
            return false if event.ordinal != event.position.event or event.task.value != event.position.task.value
            return event_kind_is_valid(event.kind) and event_quality_is_valid(event.quality)

        def event_envelopes_equal(left: EventEnvelope, right: EventEnvelope) -> bool:
            return left.schema == right.schema and left.ordinal == right.ordinal and left.task.value == right.task.value and left.position.recording.value == right.position.recording.value and left.position.branch.value == right.position.branch.value and left.position.event == right.position.event and left.position.task.value == right.position.task.value and left.position.invocation.value == right.position.invocation.value and left.position.statement.value == right.position.statement.value and left.position.microstep == right.position.microstep and left.kind == right.kind and left.quality == right.quality and left.payload_hash == right.payload_hash

        def event_envelope(schema: u32, ordinal: u64, position: DebuggerIdentity::Position, kind: EventKind, quality: EventQuality, payload_hash: u64) -> EventEnvelope:
            return EventEnvelope{
                schema: schema,
                ordinal: ordinal,
                task: position.task,
                position: position,
                kind: kind,
                quality: quality,
                payload_hash: payload_hash
            }
