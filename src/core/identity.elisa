# Stable identities used by every debugger provider and protocol surface.

module DebuggerIdentity:
    public:
        struct DebugId:
            value: u64

        def debug_id(value: u64) -> DebugId:
            return DebugId{value: value}

        def debug_id_is_zero(id: DebugId) -> bool:
            return id.value == 0

        struct BuildIdentity:
            compiler: mutable DebugId
            runtime: mutable DebugId
            source: mutable DebugId
            target: mutable DebugId
            metadata_version: mutable u32

        struct Position:
            recording: mutable DebugId
            branch: mutable DebugId
            event: mutable u64
            task: mutable DebugId
            invocation: mutable DebugId
            statement: mutable DebugId
            microstep: mutable u32

        def initial_position(recording: DebugId) -> Position:
            return Position{
                recording: recording,
                branch: debug_id(0),
                event: 0,
                task: debug_id(0),
                invocation: debug_id(0),
                statement: debug_id(0),
                microstep: 0
            }

        def position_recording_is_valid(position: Position) -> bool:
            return position.recording.value != 0

        struct SourceSpan:
            file: mutable DebugId
            start_byte: mutable u64
            end_byte: mutable u64
            start_line: mutable u32
            start_column: mutable u32
            end_line: mutable u32
            end_column: mutable u32
            discriminator: mutable u32

        struct AllocationIdentity:
            allocation: mutable DebugId
            generation: mutable u64
            offset: mutable u64

        struct BindingIdentity:
            declaration: mutable DebugId
            incarnation: mutable u64

        def binding_identity_equal(left: BindingIdentity, right: BindingIdentity) -> bool:
            left_declaration: DebugId = left.declaration
            right_declaration: DebugId = right.declaration
            return left_declaration.value == right_declaration.value and left.incarnation == right.incarnation
