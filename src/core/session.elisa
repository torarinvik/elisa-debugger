include "./identity.elisa"
include "./capabilities.elisa"

module DebuggerSession:
    private:
        const STOP_GENERATION_INCREMENT: u64 = 1
        const NO_EXPECTED_GENERATION: u64 = 0
        const EVENT_INCREMENT: u64 = 1
        const INITIAL_EVENT: u64 = 0
        const MAX_STOP_GENERATION: u64 = 18446744073709551615
        const MAX_EVENT: u64 = 18446744073709551615

        def next_stop_generation(current: u64) -> u64:
            return MAX_STOP_GENERATION if current == MAX_STOP_GENERATION
            return current + STOP_GENERATION_INCREMENT

    public:
        enum SessionState:
            Created
            Configuring
            Launching
            Running
            Pausing
            Stopped
            Recording
            Restoring
            Replaying
            Exited
            Detached
            Failed
            Closed

        enum SessionError:
            None
            InvalidTransition
            StaleGeneration
            Unsupported
            Cancelled
            ArtifactMismatch
            TraceCorrupt
            ReplayDiverged
            HistoryUnavailable

        struct Session:
            id: mutable DebuggerIdentity::DebugId
            build: mutable DebuggerIdentity::BuildIdentity
            capabilities: mutable DebuggerCapabilities::CapabilitySet
            state: mutable SessionState
            stop_generation: mutable u64
            position: mutable DebuggerIdentity::Position
            retained_first: mutable u64
            retained_last: mutable u64
            has_retained_history: mutable bool
            last_error: mutable SessionError

        def new_session(id: DebuggerIdentity::DebugId, build: DebuggerIdentity::BuildIdentity, capabilities: DebuggerCapabilities::CapabilitySet) -> Session:
            return Session{
                id: id,
                build: build,
                capabilities: capabilities,
                state: SessionState.Created,
                stop_generation: 0,
                position: DebuggerIdentity::initial_position(id),
                retained_first: INITIAL_EVENT,
                retained_last: INITIAL_EVENT,
                has_retained_history: true,
                last_error: SessionError.None
            }

        def session_can_inspect(session: Session) -> bool:
            return session.state == SessionState.Stopped or session.state == SessionState.Replaying

        def session_can_resume(session: Session) -> bool:
            return session.state == SessionState.Stopped or session.state == SessionState.Replaying

        def session_can_reverse(session: Session) -> bool:
            return session_can_inspect(session) and session.capabilities.reverse_execution

        def session_stop(session: Session) -> Session:
            updated: mutable Session = session
            if session.capabilities.engine == DebuggerCapabilities::EngineKind.Postmortem:
                updated.last_error <- SessionError.Unsupported
                return updated
            if session.state == SessionState.Running or session.state == SessionState.Pausing or session.state == SessionState.Recording or session.state == SessionState.Replaying:
                updated.state <- SessionState.Stopped
                updated.stop_generation <- next_stop_generation(session.stop_generation)
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_launch(session: Session) -> Session:
            updated: mutable Session = session
            if session.capabilities.engine == DebuggerCapabilities::EngineKind.AttachedNative or session.capabilities.engine == DebuggerCapabilities::EngineKind.Postmortem:
                updated.last_error <- SessionError.Unsupported
                return updated
            if session.state == SessionState.Created or session.state == SessionState.Configuring or session.state == SessionState.Launching:
                updated.state <- SessionState.Running
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_open_trace(session: Session) -> Session:
            updated: mutable Session = session
            if session.state == SessionState.Created or session.state == SessionState.Configuring:
                if session.capabilities.history == DebuggerCapabilities::HistoryKind.None:
                    updated.last_error <- SessionError.Unsupported
                    return updated
                updated.state <- SessionState.Stopped
                updated.stop_generation <- next_stop_generation(session.stop_generation)
                updated.position <- DebuggerIdentity::initial_position(session.position.recording)
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_attach(session: Session) -> Session:
            updated: mutable Session = session
            if session.capabilities.engine == DebuggerCapabilities::EngineKind.Managed or session.capabilities.engine == DebuggerCapabilities::EngineKind.Postmortem or not session.capabilities.native_attach:
                updated.last_error <- SessionError.Unsupported
                return updated
            if session.state == SessionState.Created or session.state == SessionState.Configuring:
                updated.state <- SessionState.Stopped
                updated.stop_generation <- next_stop_generation(session.stop_generation)
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_pause(session: Session) -> Session:
            return session_stop(session)

        def session_resume(session: Session) -> Session:
            updated: mutable Session = session
            if session.capabilities.engine == DebuggerCapabilities::EngineKind.Postmortem:
                updated.last_error <- SessionError.Unsupported
                return updated
            if session_can_resume(session):
                updated.state <- SessionState.Replaying if session.state == SessionState.Replaying else SessionState.Running
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_begin_replay(session: Session) -> Session:
            updated: mutable Session = session
            if session.state == SessionState.Stopped and session.capabilities.history == DebuggerCapabilities::HistoryKind.Exact:
                updated.state <- SessionState.Replaying
                updated.stop_generation <- next_stop_generation(session.stop_generation)
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.Unsupported
            return updated

        def session_step(session: Session) -> Session:
            updated: mutable Session = session
            if session.capabilities.engine == DebuggerCapabilities::EngineKind.Postmortem:
                updated.last_error <- SessionError.Unsupported
                return updated
            if session.state == SessionState.Stopped or session.state == SessionState.Replaying:
                if session.position.event == MAX_EVENT:
                    updated.last_error <- SessionError.HistoryUnavailable
                    return updated
                updated.position.event <- session.position.event + EVENT_INCREMENT
                updated.retained_last <- updated.position.event if updated.position.event > session.retained_last
                updated.state <- SessionState.Stopped
                updated.stop_generation <- next_stop_generation(session.stop_generation)
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_reverse_step(session: Session) -> Session:
            updated: mutable Session = session
            if not session_can_reverse(session):
                updated.last_error <- SessionError.Unsupported
                return updated
            if not session.has_retained_history or session.position.event <= session.retained_first or session.position.event > session.retained_last:
                updated.last_error <- SessionError.HistoryUnavailable
                return updated
            updated.position.event <- session.position.event - EVENT_INCREMENT
            updated.state <- SessionState.Stopped
            updated.stop_generation <- next_stop_generation(session.stop_generation)
            updated.last_error <- SessionError.None
            return updated

        def session_seek(session: Session, event: u64) -> Session:
            updated: mutable Session = session
            if not session_can_inspect(session):
                updated.last_error <- SessionError.InvalidTransition
                return updated
            if event != session.position.event and session.capabilities.history != DebuggerCapabilities::HistoryKind.Exact:
                updated.last_error <- SessionError.Unsupported
                return updated
            if not session.has_retained_history or event < session.retained_first or event > session.retained_last:
                updated.last_error <- SessionError.HistoryUnavailable
                return updated
            updated.position.event <- event
            updated.state <- SessionState.Stopped
            updated.stop_generation <- next_stop_generation(session.stop_generation)
            updated.last_error <- SessionError.None
            return updated

        def session_close(session: Session) -> Session:
            updated: mutable Session = session
            if session.state == SessionState.Closed:
                updated.last_error <- SessionError.InvalidTransition
                return updated
            updated.state <- SessionState.Closed
            updated.stop_generation <- next_stop_generation(session.stop_generation)
            updated.last_error <- SessionError.None
            return updated

        def session_configure(session: Session) -> Session:
            updated: mutable Session = session
            if session.state == SessionState.Created:
                updated.state <- SessionState.Configuring
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_begin_recording(session: Session) -> Session:
            updated: mutable Session = session
            if session.state == SessionState.Running or session.state == SessionState.Stopped:
                if session.capabilities.history == DebuggerCapabilities::HistoryKind.None:
                    updated.last_error <- SessionError.Unsupported
                    return updated
                updated.state <- SessionState.Recording
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_begin_restore(session: Session, expected_generation: u64) -> Session:
            updated: mutable Session = session
            if expected_generation != NO_EXPECTED_GENERATION and expected_generation != session.stop_generation:
                updated.last_error <- SessionError.StaleGeneration
                return updated
            if session.state == SessionState.Stopped or session.state == SessionState.Replaying:
                updated.state <- SessionState.Restoring
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_finish_restore(session: Session) -> Session:
            updated: mutable Session = session
            if session.state == SessionState.Restoring:
                updated.state <- SessionState.Stopped
                updated.stop_generation <- next_stop_generation(session.stop_generation)
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_detach(session: Session) -> Session:
            updated: mutable Session = session
            if session.capabilities.engine == DebuggerCapabilities::EngineKind.Postmortem:
                updated.last_error <- SessionError.Unsupported
                return updated
            if session.state == SessionState.Running or session.state == SessionState.Stopped or session.state == SessionState.Pausing or session.state == SessionState.Recording or session.state == SessionState.Replaying:
                updated.state <- SessionState.Detached
                updated.stop_generation <- next_stop_generation(session.stop_generation)
                updated.last_error <- SessionError.None
                return updated
            updated.last_error <- SessionError.InvalidTransition
            return updated

        def session_terminate(session: Session) -> Session:
            updated: mutable Session = session
            if session.capabilities.engine == DebuggerCapabilities::EngineKind.Postmortem or session.capabilities.engine == DebuggerCapabilities::EngineKind.AttachedNative:
                updated.last_error <- SessionError.Unsupported
                return updated
            if session.state == SessionState.Closed or session.state == SessionState.Exited:
                updated.last_error <- SessionError.InvalidTransition
                return updated
            updated.state <- SessionState.Exited
            updated.stop_generation <- next_stop_generation(session.stop_generation)
            updated.last_error <- SessionError.None
            return updated

        def session_accept_generation(session: Session, expected_generation: u64) -> bool:
            return expected_generation == NO_EXPECTED_GENERATION or expected_generation == session.stop_generation
