# Serialized session coordinator.  Protocol adapters hand this module typed
# operations; they never mutate session state directly or observe a half-applied
# restore.  The coordinator is deliberately provider-neutral so the same
# operation contract can drive managed, native, and postmortem providers.

include "../core/session.elisa"
include "../core/errors.elisa"
include "../core/cancellation.elisa"

module DebuggerCoordinator:
    private:
        const module CoordinatorLimits:
            ENGINE_COORDINATOR_LIMITS_INITIAL_TICK: u64 = 1

        const module Detail:
            INVALID_OPERATION: u32 = 1
            ENGINE_COORDINATOR_DETAIL_STALE_GENERATION: u32 = 2
            BUSY: u32 = 3
            ENGINE_COORDINATOR_DETAIL_UNSUPPORTED: u32 = 4
            ENGINE_COORDINATOR_DETAIL_CAPABILITY: u32 = 5

        const module OperationLimits:
            ENGINE_COORDINATOR_OPERATION_LIMITS_MAX: u16 = 31

        const module Sentinel:
            ENGINE_COORDINATOR_SENTINEL_EXPECTED_GENERATION: u64 = 0
            ENGINE_COORDINATOR_SENTINEL_REQUEST: u64 = 0

        # Coordinator work begins at logical tick one.  Checking at zero
        # makes every positive deadline appear unexpired indefinitely.

    public:
        enum Operation:
            Discover
            Initialize
            CreateSession
            OpenTrace
            Launch
            Attach
            Replay
            Pause
            Continue
            Step
            ReverseStep
            Seek
            Threads
            Stack
            Scopes
            Variables
            Evaluate
            SetBreakpoints
            SetDataBreakpoints
            Checkpoint
            Branch
            Compare
            TraceVerify
            TraceExport
            Detach
            Terminate
            Close
            Cancel
            Memory
            ReverseStepOver
            ReverseStepOut
            Timeline

        struct Coordinator:
            session: mutable DebuggerSession::Session
            busy: mutable bool
            active_request: mutable u64
            last_request: mutable u64
            last_error: mutable DebuggerErrors::DebuggerError

        struct Result:
            coordinator: mutable Coordinator
            operation: mutable Operation
            request_id: mutable u64
            accepted: mutable bool
            stop_generation: mutable u64
            failure: mutable DebuggerErrors::DebuggerError

        def coordinator_new(session: DebuggerSession::Session) -> Coordinator:
            return Coordinator{session: session, busy: false, active_request: Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST, last_request: Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST, last_error: DebuggerErrors::no_error()}

        def result_error(coordinator: Coordinator, operation: Operation, request_id: u64, failure: DebuggerErrors::DebuggerError) -> Result:
            updated: mutable Coordinator = coordinator
            updated.active_request <- Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST if not updated.busy
            updated.last_error <- failure
            return Result{coordinator: updated, operation: operation, request_id: request_id, accepted: false, stop_generation: updated.session.stop_generation, failure: failure}

        def result_ok(coordinator: Coordinator, operation: Operation, request_id: u64) -> Result:
            updated: mutable Coordinator = coordinator
            updated.active_request <- Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST
            updated.last_error <- DebuggerErrors::no_error()
            return Result{coordinator: updated, operation: operation, request_id: request_id, accepted: true, stop_generation: updated.session.stop_generation, failure: DebuggerErrors::no_error()}

        def map_session_error(failure: DebuggerSession::SessionError) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::INVALID_OPERATION) if failure == DebuggerSession::SessionError.InvalidTransition
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, Detail::ENGINE_COORDINATOR_DETAIL_STALE_GENERATION) if failure == DebuggerSession::SessionError.StaleGeneration
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_COORDINATOR_DETAIL_UNSUPPORTED) if failure == DebuggerSession::SessionError.Unsupported
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_COORDINATOR_DETAIL_UNSUPPORTED) if failure == DebuggerSession::SessionError.ReplayDiverged
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_UNSUPPORTED) if failure == DebuggerSession::SessionError.HistoryUnavailable
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENGINE_COORDINATOR_DETAIL_UNSUPPORTED) if failure == DebuggerSession::SessionError.TraceCorrupt
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, Detail::ENGINE_COORDINATOR_DETAIL_UNSUPPORTED) if failure == DebuggerSession::SessionError.ArtifactMismatch
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Cancelled, true, Detail::ENGINE_COORDINATOR_DETAIL_UNSUPPORTED) if failure == DebuggerSession::SessionError.Cancelled
            return DebuggerErrors::no_error()

        def coordinator_execute(coordinator: Coordinator, request_id: u64, operation: Operation, expected_generation: u64, token: DebuggerCancellation::CancellationToken) -> Result:
            updated: mutable Coordinator = coordinator
            return result_error(updated, operation, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::INVALID_OPERATION)) if request_id == Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST and operation != Operation.Discover
            return result_error(updated, operation, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::INVALID_OPERATION)) if operation.u16() > OperationLimits::ENGINE_COORDINATOR_OPERATION_LIMITS_MAX
            return coordinator_cancel(coordinator, request_id) if operation == Operation.Cancel
            return result_error(updated, operation, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, true, Detail::BUSY)) if coordinator.busy
            return result_error(updated, operation, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Cancelled, true, Detail::INVALID_OPERATION)) if DebuggerCancellation::cancellation_is_requested(token, CoordinatorLimits::ENGINE_COORDINATOR_LIMITS_INITIAL_TICK)
            return result_error(updated, operation, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, Detail::ENGINE_COORDINATOR_DETAIL_STALE_GENERATION)) if expected_generation != Sentinel::ENGINE_COORDINATOR_SENTINEL_EXPECTED_GENERATION and expected_generation != coordinator.session.stop_generation
            updated.busy <- true
            updated.active_request <- request_id
            updated.last_request <- request_id
            updated.last_error <- DebuggerErrors::no_error()
            # A prior operation's error must not poison read-only requests.
            updated.session.last_error <- DebuggerSession::SessionError.None
            if operation == Operation.Discover or operation == Operation.Initialize:
                updated.busy <- false
                return result_ok(updated, operation, request_id)
            if operation == Operation.CreateSession:
                updated.session <- DebuggerSession::session_configure(coordinator.session)
            if operation == Operation.Launch:
                updated.session <- DebuggerSession::session_launch(coordinator.session)
            if operation == Operation.OpenTrace:
                updated.session <- DebuggerSession::session_open_trace(coordinator.session)
            if operation == Operation.Attach:
                updated.session <- DebuggerSession::session_attach(coordinator.session)
            if operation == Operation.Replay:
                updated.session <- DebuggerSession::session_begin_replay(coordinator.session)
            if operation == Operation.Pause:
                updated.session <- DebuggerSession::session_pause(coordinator.session)
            if operation == Operation.Continue:
                updated.session <- DebuggerSession::session_resume(coordinator.session)
            if operation == Operation.Detach:
                updated.session <- DebuggerSession::session_detach(coordinator.session)
            if operation == Operation.Terminate:
                updated.session <- DebuggerSession::session_terminate(coordinator.session)
            if operation == Operation.Step:
                updated.session <- DebuggerSession::session_step(coordinator.session)
            if operation == Operation.ReverseStep:
                updated.session <- DebuggerSession::session_reverse_step(coordinator.session)
            if operation == Operation.Close:
                updated.session <- DebuggerSession::session_close(coordinator.session)
            if operation == Operation.Threads or operation == Operation.Stack or operation == Operation.Scopes or operation == Operation.Variables or operation == Operation.Evaluate:
                if not DebuggerSession::session_can_inspect(coordinator.session):
                    updated.busy <- false
                    updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                    return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Threads or operation == Operation.Stack or operation == Operation.Scopes or operation == Operation.Variables:
                if not coordinator.session.capabilities.typed_values:
                    updated.busy <- false
                    updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                    return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Evaluate and not coordinator.session.capabilities.expression_evaluation:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.TraceVerify and not coordinator.session.capabilities.trace_verification:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.TraceExport and not coordinator.session.capabilities.trace_export:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.TraceVerify or operation == Operation.TraceExport:
                if not DebuggerSession::session_can_inspect(coordinator.session):
                    updated.busy <- false
                    updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                    return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.SetBreakpoints and not coordinator.session.capabilities.source_breakpoints:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.SetDataBreakpoints and not coordinator.session.capabilities.data_breakpoints:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Checkpoint and (not coordinator.session.capabilities.checkpoints or not DebuggerSession::session_can_inspect(coordinator.session)):
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Branch and (not coordinator.session.capabilities.branches or not DebuggerSession::session_can_inspect(coordinator.session)):
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Compare and (not coordinator.session.capabilities.provenance or not DebuggerSession::session_can_inspect(coordinator.session)):
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Memory and (not coordinator.session.capabilities.memory_read or not DebuggerSession::session_can_inspect(coordinator.session)):
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.ReverseStep and not coordinator.session.capabilities.reverse_execution:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if (operation == Operation.ReverseStepOver or operation == Operation.ReverseStepOut) and not coordinator.session.capabilities.reverse_execution:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Timeline and coordinator.session.capabilities.history == DebuggerCapabilities::HistoryKind.None:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Timeline and not DebuggerSession::session_can_inspect(coordinator.session):
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::ENGINE_COORDINATOR_DETAIL_CAPABILITY)
                return result_error(updated, operation, request_id, updated.last_error)
            # The provider-neutral dispatcher has no operands or result payloads
            # for inspection and artifact operations. Leave those to the typed
            # provider APIs instead of acknowledging work that was not done.
            if operation == Operation.Threads or operation == Operation.Stack or operation == Operation.Scopes or operation == Operation.Variables or operation == Operation.Evaluate or operation == Operation.SetBreakpoints or operation == Operation.SetDataBreakpoints or operation == Operation.Checkpoint or operation == Operation.Branch or operation == Operation.Compare or operation == Operation.TraceVerify or operation == Operation.TraceExport or operation == Operation.Memory or operation == Operation.ReverseStepOver or operation == Operation.ReverseStepOut:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_COORDINATOR_DETAIL_UNSUPPORTED)
                return result_error(updated, operation, request_id, updated.last_error)
            if operation == Operation.Seek:
                updated.busy <- false
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_COORDINATOR_DETAIL_UNSUPPORTED)
                return result_error(updated, operation, request_id, updated.last_error)
            if updated.session.last_error != DebuggerSession::SessionError.None:
                updated.busy <- false
                updated.last_error <- map_session_error(updated.session.last_error)
                return result_error(updated, operation, request_id, updated.last_error)
            updated.busy <- false
            return result_ok(updated, operation, request_id)

        def coordinator_is_idle(coordinator: Coordinator) -> bool:
            return not coordinator.busy

        # Seek carries a target ordinal, so it has a dedicated typed entry
        # point instead of overloading the ordinary operation request.
        def coordinator_seek(coordinator: Coordinator, request_id: u64, expected_generation: u64, target_event: u64, token: DebuggerCancellation::CancellationToken) -> Result:
            updated: mutable Coordinator = coordinator
            return result_error(updated, Operation.Seek, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::INVALID_OPERATION)) if request_id == Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST
            return result_error(updated, Operation.Seek, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, true, Detail::BUSY)) if coordinator.busy
            return result_error(updated, Operation.Seek, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Cancelled, true, Detail::INVALID_OPERATION)) if DebuggerCancellation::cancellation_is_requested(token, CoordinatorLimits::ENGINE_COORDINATOR_LIMITS_INITIAL_TICK)
            return result_error(updated, Operation.Seek, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, Detail::ENGINE_COORDINATOR_DETAIL_STALE_GENERATION)) if expected_generation != Sentinel::ENGINE_COORDINATOR_SENTINEL_EXPECTED_GENERATION and expected_generation != coordinator.session.stop_generation
            updated.busy <- true
            updated.active_request <- request_id
            updated.last_request <- request_id
            updated.session <- DebuggerSession::session_seek(coordinator.session, target_event)
            updated.busy <- false
            return result_error(updated, Operation.Seek, request_id, map_session_error(updated.session.last_error)) if updated.session.last_error != DebuggerSession::SessionError.None
            return result_ok(updated, Operation.Seek, request_id)

        def coordinator_cancel(coordinator: Coordinator, request_id: u64) -> Result:
            updated: mutable Coordinator = coordinator
            return result_error(updated, Operation.Cancel, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::INVALID_OPERATION)) if request_id == Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST
            return result_error(updated, Operation.Cancel, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::INVALID_OPERATION)) if not coordinator.busy
            return result_error(updated, Operation.Cancel, request_id, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::INVALID_OPERATION)) if coordinator.active_request != Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST and coordinator.active_request != request_id
            updated.busy <- false
            updated.active_request <- Sentinel::ENGINE_COORDINATOR_SENTINEL_REQUEST
            updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Cancelled, true, Detail::INVALID_OPERATION)
            return result_error(updated, Operation.Cancel, request_id, updated.last_error)
