# Small valid EDIR image used by protocol smoke paths until a compiler-produced
# image is supplied. Keeping this fixture in one module prevents each adapter
# from inventing a different execution model.

include "../vm/edir.elisa"

module DebuggerDefaultImage:
    private:
        const DEFAULT_PROGRAM_VERSION: u32 = 1
        const DEFAULT_INSTRUCTION_COUNT: u64 = 2
        const DEFAULT_LOCAL_COUNT: u64 = 0
        const DEFAULT_CONSTANT: i64 = 42

    public:
        def image_new() -> DebuggerEDIR::ProgramImage:
            image: mutable DebuggerEDIR::ProgramImage = zeroed
            image.program <- DebuggerEDIR::Program{version: DEFAULT_PROGRAM_VERSION, instruction_count: DEFAULT_INSTRUCTION_COUNT, local_count: DEFAULT_LOCAL_COUNT, has_return: true}
            image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: DEFAULT_CONSTANT, b: 0, source: zeroed}
            image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
            return image
