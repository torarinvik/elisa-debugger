# Managed execution facade.  It owns the EDIR replay engine and keeps the
# provider-neutral session position synchronized for every editor adapter.

include "./provider.elisa"
include "../core/session.elisa"
include "../core/errors.elisa"
include "../replay/engine.elisa"
include "../replay/checkpoint_codec.elisa"
include "../breakpoint/breakpoint.elisa"
include "../breakpoint/manager.elisa"
include "../metadata/source.elisa"
include "../inspect/store.elisa"
include "./state.elisa"

module DebuggerManagedEngine:
    private:
        const module Detail:
            ENGINE_FAULT: u32 = 1
            HISTORY: u32 = 2
            ENGINE_MANAGED_DETAIL_UNSUPPORTED: u32 = 3

        const module Event:
            INITIAL_INDEX: usize = 0
            PREVIOUS_OFFSET: usize = 1

        const module Checkpoint:
            ENGINE_MANAGED_CHECKPOINT_ID_OFFSET: u64 = 1
            ENGINE_MANAGED_CHECKPOINT_MAX_ID: u64 = 18446744073709551615

        const module Value:
            NAME_OFFSET: u64 = 1
            GLOBAL_NAME_OFFSET: u64 = 33
            TYPE_ID: u64 = 1
            ENGINE_MANAGED_VALUE_MAX_LOCALS: usize = 32
            ENGINE_MANAGED_VALUE_MAX_GLOBALS: usize = 16

        const module Step:
            COMPOUND_LIMIT: u64 = 64

        const module Reverse:
            FRAME_DEPTH_INCREMENT: usize = 1
            TOP_LEVEL_FRAME_DEPTH: usize = 0
            PREVIOUS_EVENT_INCREMENT: usize = 1
            SNAPSHOT_ID_INCREMENT: u64 = 1
            CALL_RETURN_INCREMENT: u64 = 1
            NO_RETURN_ADDRESS: u64 = 0
            MINIMUM_CALL_TARGET: i64 = 0

        const module SourcePath:
            SLASH: u8 = 47
            BACKSLASH: u8 = 92
            ROOT_COLON: u8 = 58
            DOT: u8 = 46
            ROOT_MINIMUM_LENGTH: usize = 1
            WINDOWS_ROOT_MINIMUM_LENGTH: usize = 3
            UNC_PREFIX_LENGTH: usize = 2
            UNC_MINIMUM_SEPARATORS: usize = 1
            ROOT_COLON_INDEX: usize = 1
            ROOT_SLASH_INDEX: usize = 2
            ROOT_INITIAL_INDEX: usize = 0
            UNC_SECOND_SLASH_INDEX: usize = 1
            UNC_SERVER_START_INDEX: usize = 2
            SINGLE_DOT_SEGMENT_LENGTH: usize = 1
            PARENT_SEGMENT_LENGTH: usize = 2
            ROOT_DISABLED_LENGTH: usize = 0
            MANAGED_SOURCE_PATH_EMPTY_LENGTH: usize = 0
            ASCII_CONTROL_MAX: u8 = 31
            ENGINE_MANAGED_SOURCE_PATH_ASCII_DELETE: u8 = 127
            ENGINE_MANAGED_SOURCE_PATH_ASCII_UPPER_A: u8 = 65
            ENGINE_MANAGED_SOURCE_PATH_ASCII_UPPER_Z: u8 = 90
            ASCII_CASE_OFFSET: u8 = 32

        const module Identity:
            NO_SOURCE_FILE: u64 = 0
            NO_BRANCH: u64 = 0
            ENGINE_MANAGED_IDENTITY_NO_INSTRUCTION: u64 = 18446744073709551615

    public:
        struct ManagedController:
            session: mutable DebuggerSession::Session
            engine: mutable DebuggerReplayEngine::ReplayEngine
            state: mutable DebuggerManagedState::State
            last_error: mutable DebuggerErrors::DebuggerError
            source_path_root: mutable u8[DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY]
            source_path_root_length: mutable usize
            has_last_breakpoint_stop: mutable bool
            last_breakpoint_event: mutable u64
            last_breakpoint_instruction: mutable u64
            last_breakpoint_branch: mutable DebuggerIdentity::DebugId

        def managed_new(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage, recording: DebuggerIdentity::DebugId) -> ManagedController:
            return ManagedController{session: session, engine: DebuggerReplayEngine::replay_engine_new(image, recording), state: DebuggerManagedState::state_new(), last_error: DebuggerErrors::no_error(), source_path_root: zeroed, source_path_root_length: SourcePath::ROOT_DISABLED_LENGTH, has_last_breakpoint_stop: false, last_breakpoint_event: Event::INITIAL_INDEX.u64(), last_breakpoint_instruction: Identity::ENGINE_MANAGED_IDENTITY_NO_INSTRUCTION, last_breakpoint_branch: DebuggerIdentity::debug_id(Identity::NO_BRANCH)}

        def managed_sync_position(controller: mutable ManagedController&) -> void:
            controller.session.position <- DebuggerReplayEngine::replay_engine_position(controller.engine)
            controller.session.retained_last <- controller.session.position.event if controller.session.position.event > controller.session.retained_last

        def managed_refresh_values(controller: mutable ManagedController&) -> void:
            DebuggerManagedState::state_reset_values(controller.state, controller.session.stop_generation)
            available: usize = controller.engine.image.program.local_count.usize() if controller.engine.image.program.local_count <= Value::ENGINE_MANAGED_VALUE_MAX_LOCALS.u64() else Value::ENGINE_MANAGED_VALUE_MAX_LOCALS
            for index in 0..<available:
                name: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(index.u64() + Value::NAME_OFFSET)
                type_id: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Value::TYPE_ID)
                if controller.engine.machine.locals_initialized[index]:
                    DebuggerValueStore::value_store_add_scalar(controller.state.values, name, type_id, controller.engine.machine.locals[index])
                else:
                    DebuggerValueStore::value_store_add_uninitialized(controller.state.values, name, type_id)
            for index in 0..<Value::ENGINE_MANAGED_VALUE_MAX_GLOBALS:
                global_name: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(index.u64() + Value::GLOBAL_NAME_OFFSET)
                global_type_id: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Value::TYPE_ID)
                if controller.engine.machine.globals_initialized[index]:
                    DebuggerValueStore::value_store_add_scalar(controller.state.values, global_name, global_type_id, controller.engine.machine.globals[index])
                else:
                    DebuggerValueStore::value_store_add_uninitialized(controller.state.values, global_name, global_type_id)

        def managed_source_position_matches(left: DebuggerIdentity::SourceSpan, right: DebuggerIdentity::SourceSpan) -> bool:
            # A missing span cannot define a source-level step boundary.
            return false if not DebuggerMetadata::source_span_is_valid(left) or not DebuggerMetadata::source_span_is_valid(right)
            return left.file.value == right.file.value and left.start_byte == right.start_byte and left.end_byte == right.end_byte and left.start_line == right.start_line and left.start_column == right.start_column and left.end_line == right.end_line and left.end_column == right.end_column and left.discriminator == right.discriminator

        def managed_current_source(controller: mutable ManagedController&) -> DebuggerIdentity::SourceSpan:
            return zeroed if controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count
            return controller.engine.image.instructions[controller.engine.machine.program_counter.usize()].source

        def managed_compound_breakpoint_should_stop(controller: mutable ManagedController&, initial_source: DebuggerIdentity::SourceSpan) -> bool:
            current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            return false if managed_source_position_matches(initial_source, current_source)
            return managed_breakpoint_should_stop(controller)

        def managed_breakpoint_should_stop(controller: mutable ManagedController&) -> bool:
            return false if controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count
            instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
            event_branch: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64())
            should_stop: bool = DebuggerBreakpointManager::breakpoint_table_should_stop_at_instruction(controller.state.breakpoints, event_branch, instruction.source, controller.engine.machine.program_counter)
            if should_stop:
                controller.has_last_breakpoint_stop <- true
                controller.last_breakpoint_event <- controller.engine.event_count.u64()
                controller.last_breakpoint_instruction <- controller.engine.machine.program_counter
                controller.last_breakpoint_branch <- event_branch
            return should_stop

        def managed_launch(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or controller.engine.machine.faulted
            controller.session <- DebuggerSession::session_launch(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_pause(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            controller.session <- DebuggerSession::session_pause(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_continue(controller: mutable ManagedController&, max_steps: u64) -> DebuggerErrors::DebuggerError:
            # Continue checks its current position except when that exact event
            # and instruction already stopped on a breakpoint. This also lets
            # reverse navigation rediscover breakpoints at event zero.
            current_branch: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64())
            repeat_breakpoint_position: bool = controller.has_last_breakpoint_stop and controller.last_breakpoint_event == controller.engine.event_count.u64() and controller.last_breakpoint_instruction == controller.engine.machine.program_counter and controller.last_breakpoint_branch.value == current_branch.value
            if controller.session.state != DebuggerSession::SessionState.Running:
                controller.session <- DebuggerSession::session_resume(controller.session)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            controller.engine.engine_error <- DebuggerReplayEngine::EngineError.None if not controller.engine.machine.faulted
            start: u64 = controller.engine.event_count.u64()
            hit_breakpoint: mutable bool = false
            first_iteration: mutable bool = true
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count.u64() - start < max_steps:
                # Skip the exact position already reported as a breakpoint,
                # but allow breakpoints after reverse navigation to be found.
                if (not first_iteration or not repeat_breakpoint_position) and managed_breakpoint_should_stop(controller):
                    hit_breakpoint <- true
                    break
                DebuggerReplayEngine::replay_engine_step(controller.engine)
                first_iteration <- false
                break if controller.engine.engine_error != DebuggerReplayEngine::EngineError.None
            if not hit_breakpoint and not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count.u64() - start >= max_steps:
                controller.engine.engine_error <- DebuggerReplayEngine::EngineError.StepLimit
            managed_sync_position(controller)
            controller.session <- DebuggerSession::session_stop(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            managed_sync_position(controller)
            managed_refresh_values(controller)
            if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryFull or (controller.engine.engine_error == DebuggerReplayEngine::EngineError.StepLimit and controller.engine.event_count >= DebuggerReplayEngine::replay_engine_history_capacity()):
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::HISTORY)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable or controller.engine.engine_error == DebuggerReplayEngine::EngineError.StepLimit
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault
            return DebuggerErrors::no_error()

        def managed_step(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            original_engine: DebuggerReplayEngine::ReplayEngine = controller.engine
            original_session: DebuggerSession::Session = controller.session
            before_event: usize = controller.engine.event_count
            DebuggerReplayEngine::replay_engine_step(controller.engine)
            if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault:
                # A faulting EDIR instruction is still recorded as an event.
                # Keep the session coordinate and generation-scoped handles in
                # sync with that committed state change.
                if controller.engine.event_count > before_event:
                    controller.session <- DebuggerSession::session_step(controller.session)
                    if controller.session.last_error != DebuggerSession::SessionError.None:
                        controller.engine <- original_engine
                        controller.session <- original_session
                        return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
                    managed_sync_position(controller)
                    managed_refresh_values(controller)
                else:
                    managed_sync_position(controller)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count == before_event
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable
            controller.session <- DebuggerSession::session_step(controller.session)
            if controller.session.last_error != DebuggerSession::SessionError.None:
                session_failure: DebuggerSession::SessionError = controller.session.last_error
                controller.engine <- original_engine
                controller.session <- original_session
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if session_failure == DebuggerSession::SessionError.HistoryUnavailable
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryFull
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault
            return DebuggerErrors::no_error()

        def managed_step_over(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            return managed_step(controller) if controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count
            initial_instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
            initial_source: DebuggerIdentity::SourceSpan = initial_instruction.source
            initial_depth: usize = controller.engine.machine.return_stack_pointer
            initial_event: usize = controller.engine.event_count
            hit_breakpoint: mutable bool = false
            failure: mutable DebuggerErrors::DebuggerError = managed_step(controller)
            return failure if not DebuggerErrors::error_is_ok(failure)
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event < Step::COMPOUND_LIMIT:
                current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
                call_is_active: bool = initial_instruction.opcode == DebuggerEDIR::Opcode.Call and controller.engine.machine.return_stack_pointer > initial_depth
                same_source_position: bool = managed_source_position_matches(initial_source, current_source)
                if managed_compound_breakpoint_should_stop(controller, initial_source):
                    hit_breakpoint <- true
                    break
                # A breakpoint at the destination boundary takes precedence
                # over completing the source step at that same position.
                # Stay in the original source span, or in a called frame,
                # until a boundary or breakpoint.
                break if not call_is_active and not same_source_position
                failure <- managed_step(controller)
                return failure if not DebuggerErrors::error_is_ok(failure)
            call_is_active_after_limit: bool = initial_instruction.opcode == DebuggerEDIR::Opcode.Call and controller.engine.machine.return_stack_pointer > initial_depth
            source_position_unchanged_after_limit: bool = managed_source_position_matches(initial_source, managed_current_source(controller))
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not hit_breakpoint and not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event >= Step::COMPOUND_LIMIT and (call_is_active_after_limit or source_position_unchanged_after_limit)
            return DebuggerErrors::no_error()

        def managed_step_out(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            initial_depth: usize = controller.engine.machine.return_stack_pointer
            initial_event: usize = controller.engine.event_count
            initial_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            hit_breakpoint: mutable bool = false
            failure: mutable DebuggerErrors::DebuggerError = managed_step(controller)
            return failure if not DebuggerErrors::error_is_ok(failure)
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event < Step::COMPOUND_LIMIT:
                if managed_compound_breakpoint_should_stop(controller, initial_source):
                    hit_breakpoint <- true
                    break
                break if initial_depth > 0 and controller.engine.machine.return_stack_pointer < initial_depth
                failure <- managed_step(controller)
                return failure if not DebuggerErrors::error_is_ok(failure)
            frame_has_not_returned: bool = initial_depth == 0 or controller.engine.machine.return_stack_pointer >= initial_depth
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not hit_breakpoint and not controller.engine.machine.halted and not controller.engine.machine.faulted and frame_has_not_returned and controller.engine.event_count - initial_event >= Step::COMPOUND_LIMIT
            return DebuggerErrors::no_error()

    private:
        def managed_reverse_snapshot_is_valid(controller: mutable ManagedController&, event: usize) -> bool:
            return false if event >= controller.engine.event_count or event >= DebuggerReplayEngine::replay_engine_history_capacity()
            snapshot: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[event]
            return false if snapshot.id.value != event.u64() + Reverse::SNAPSHOT_ID_INCREMENT or snapshot.event != event.u64()
            return false if snapshot.program_counter >= controller.engine.image.program.instruction_count or snapshot.halted or snapshot.faulted
            return false if not DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
            return snapshot.state_hash == DebuggerCheckpoint::snapshot_state_hash(snapshot)

        def managed_reverse_snapshot_is_currently_same_frame(snapshot: DebuggerCheckpoint::MachineSnapshot, frame_depth: usize, return_address: u64) -> bool:
            return false if snapshot.return_stack_pointer != frame_depth
            return true if frame_depth == Reverse::TOP_LEVEL_FRAME_DEPTH
            return snapshot.return_stack[frame_depth - Reverse::FRAME_DEPTH_INCREMENT] == return_address

        # The pre-call snapshot and the immediately following snapshot identify
        # one dynamic invocation. Stack depth distinguishes recursive calls to
        # the same EDIR instruction; the return address ties the active frame
        # to that call instead of matching by function or target PC alone.
        def managed_reverse_call_entry_matches(controller: mutable ManagedController&, event: usize, frame_depth: usize, return_address: u64) -> bool:
            return false if frame_depth == Reverse::TOP_LEVEL_FRAME_DEPTH or not managed_reverse_snapshot_is_valid(controller, event)
            before: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[event]
            return false if before.return_stack_pointer != frame_depth - Reverse::FRAME_DEPTH_INCREMENT
            instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[before.program_counter.usize()]
            return false if instruction.opcode != DebuggerEDIR::Opcode.Call or instruction.a < Reverse::MINIMUM_CALL_TARGET
            return false if before.program_counter + Reverse::CALL_RETURN_INCREMENT != return_address
            if event == controller.engine.event_count - Reverse::PREVIOUS_EVENT_INCREMENT:
                return false if controller.engine.machine.return_stack_pointer != frame_depth or controller.engine.machine.program_counter != instruction.a.u64()
                return controller.engine.machine.return_stack[frame_depth - Reverse::FRAME_DEPTH_INCREMENT] == return_address
            after_event: usize = event + Reverse::PREVIOUS_EVENT_INCREMENT
            return false if not managed_reverse_snapshot_is_valid(controller, after_event)
            after: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[after_event]
            return false if after.return_stack_pointer != frame_depth or after.program_counter != instruction.a.u64()
            return after.return_stack[frame_depth - Reverse::FRAME_DEPTH_INCREMENT] == return_address

    public:
        def managed_reverse_step_over(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count == Event::INITIAL_INDEX
            current_event: usize = controller.engine.event_count
            current_machine: DebuggerEDIR::Machine = controller.engine.machine
            current_snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(current_machine, DebuggerIdentity::debug_id(current_event.u64() + Reverse::SNAPSHOT_ID_INCREMENT), current_event.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not DebuggerCheckpoint::snapshot_shape_is_valid(current_snapshot) or current_snapshot.state_hash != DebuggerCheckpoint::snapshot_state_hash(current_snapshot)
            selected_depth: usize = current_machine.return_stack_pointer
            selected_return_address: mutable u64 = Reverse::NO_RETURN_ADDRESS
            if selected_depth > Reverse::TOP_LEVEL_FRAME_DEPTH:
                selected_return_address <- current_machine.return_stack[selected_depth - Reverse::FRAME_DEPTH_INCREMENT]
            current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            event: mutable usize = current_event
            while event > Event::INITIAL_INDEX:
                event <- event - Reverse::PREVIOUS_EVENT_INCREMENT
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not managed_reverse_snapshot_is_valid(controller, event)
                candidate: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[event]
                call_entry_matches: bool = managed_reverse_call_entry_matches(controller, event, selected_depth, selected_return_address)
                if candidate.return_stack_pointer < selected_depth:
                    return managed_seek(controller, event) if call_entry_matches
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
                if managed_reverse_snapshot_is_currently_same_frame(candidate, selected_depth, selected_return_address):
                    candidate_instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[candidate.program_counter.usize()]
                    if not managed_source_position_matches(current_source, candidate_instruction.source):
                        return managed_seek(controller, event)
                return managed_seek(controller, event) if call_entry_matches
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)

        def managed_reverse_step_out(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count == Event::INITIAL_INDEX
            current_event: usize = controller.engine.event_count
            current_machine: DebuggerEDIR::Machine = controller.engine.machine
            current_snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(current_machine, DebuggerIdentity::debug_id(current_event.u64() + Reverse::SNAPSHOT_ID_INCREMENT), current_event.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not DebuggerCheckpoint::snapshot_shape_is_valid(current_snapshot) or current_snapshot.state_hash != DebuggerCheckpoint::snapshot_state_hash(current_snapshot)
            selected_depth: usize = current_machine.return_stack_pointer
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if selected_depth == Reverse::TOP_LEVEL_FRAME_DEPTH
            selected_return_address: u64 = current_machine.return_stack[selected_depth - Reverse::FRAME_DEPTH_INCREMENT]
            event: mutable usize = current_event
            while event > Event::INITIAL_INDEX:
                event <- event - Reverse::PREVIOUS_EVENT_INCREMENT
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not managed_reverse_snapshot_is_valid(controller, event)
                candidate: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[event]
                call_entry_matches: bool = managed_reverse_call_entry_matches(controller, event, selected_depth, selected_return_address)
                return managed_seek(controller, event) if call_entry_matches
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if candidate.return_stack_pointer < selected_depth
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)

        def managed_reverse_continue(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            steps: mutable u64 = 0
            while controller.engine.event_count > 0 and steps < Step::COMPOUND_LIMIT:
                failure: DebuggerErrors::DebuggerError = managed_reverse_step(controller)
                return failure if not DebuggerErrors::error_is_ok(failure)
                steps <- steps + 1
                if controller.engine.machine.program_counter < controller.engine.image.program.instruction_count:
                    instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
                    event_branch: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64())
                    if DebuggerBreakpointManager::breakpoint_table_would_stop_at_instruction(controller.state.breakpoints, event_branch, instruction.source, controller.engine.machine.program_counter):
                        controller.has_last_breakpoint_stop <- true
                        controller.last_breakpoint_event <- controller.engine.event_count.u64()
                        controller.last_breakpoint_instruction <- controller.engine.machine.program_counter
                        controller.last_breakpoint_branch <- event_branch
                        return DebuggerErrors::no_error()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count > 0
            return DebuggerErrors::no_error()

        def managed_reverse_step(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count == Event::INITIAL_INDEX
            original_engine: DebuggerReplayEngine::ReplayEngine = controller.engine
            original_session: DebuggerSession::Session = controller.session
            DebuggerReplayEngine::replay_engine_reverse_one(controller.engine)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable
            controller.session <- DebuggerSession::session_reverse_step(controller.session)
            if controller.session.last_error != DebuggerSession::SessionError.None:
                session_failure: DebuggerSession::SessionError = controller.session.last_error
                controller.engine <- original_engine
                controller.session <- original_session
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if session_failure == DebuggerSession::SessionError.HistoryUnavailable
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_seek(controller: mutable ManagedController&, event: usize) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if event.u64() != controller.session.position.event and controller.session.capabilities.history != DebuggerCapabilities::HistoryKind.Exact
            original_engine: DebuggerReplayEngine::ReplayEngine = controller.engine
            original_session: DebuggerSession::Session = controller.session
            DebuggerReplayEngine::replay_engine_seek(controller.engine, event)
            if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault:
                # Seeking is speculative until the target is accepted. A fault
                # can occur exactly at the requested event, in which case the
                # replay engine has advanced even though this operation fails.
                controller.engine <- original_engine
                controller.session <- original_session
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable
            # Validate the requested coordinate against the session's original
            # position before copying the speculative engine position into it.
            # Otherwise a Replayable session could turn an unsupported seek into
            # an apparent no-op by observing the engine after it had already
            # replayed to the requested event.
            controller.session.retained_last <- event.u64() if event.u64() > controller.session.retained_last
            controller.session <- DebuggerSession::session_seek(controller.session, event.u64())
            if controller.session.last_error != DebuggerSession::SessionError.None:
                session_failure: DebuggerSession::SessionError = controller.session.last_error
                controller.engine <- original_engine
                controller.session <- original_session
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if session_failure == DebuggerSession::SessionError.Unsupported
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_replace_source_breakpoints(controller: mutable ManagedController&, source: DebuggerIdentity::DebugId, lines: u32&, requested_count: usize) -> DebuggerBreakpointManager::BreakpointReplacement:
            return zeroed if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or controller.engine.machine.faulted
            replacement: mutable DebuggerBreakpointManager::BreakpointReplacement = DebuggerBreakpointManager::breakpoint_table_replace_source(controller.state.breakpoints, source, controller.engine.branch, lines, requested_count)
            return replacement if not replacement.accepted
            for request_index in 0..<replacement.count:
                requested_line: u32 = replacement.results[request_index].line
                resolved: mutable bool = false
                resolved_column: mutable u32 = 0
                resolved_instruction: mutable u64 = Identity::ENGINE_MANAGED_IDENTITY_NO_INSTRUCTION
                for instruction_index in 0..<controller.engine.image.program.instruction_count.usize():
                    span: DebuggerIdentity::SourceSpan = controller.engine.image.instructions[instruction_index].source
                    if DebuggerMetadata::source_span_is_valid(span) and span.file.value == source.value and requested_line >= span.start_line and requested_line <= span.end_line:
                        candidate_column: u32 = span.start_column if requested_line == span.start_line else 0
                        candidate_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: source, line: requested_line, column: candidate_column, discriminator: 0}
                        if DebuggerMetadata::source_span_contains(span, candidate_location) and (not resolved or candidate_column < resolved_column):
                            resolved <- true
                            resolved_column <- candidate_column
                            resolved_instruction <- instruction_index.u64()
                if resolved:
                    for breakpoint_index in 0..<replacement.table.count:
                        if replacement.table.points[breakpoint_index].id.value == replacement.results[request_index].id.value:
                            replacement.table.points[breakpoint_index].source.column <- resolved_column
                    replacement.table <- DebuggerBreakpointManager::breakpoint_table_resolve_at_instruction(replacement.table, replacement.results[request_index].id, resolved_instruction)
                    replacement.results[request_index].verified <- true
            controller.state.breakpoints <- replacement.table
            return replacement

        def managed_source_root_is_valid(root: u8&, root_length: usize) -> bool:
            return false if root_length < SourcePath::ROOT_MINIMUM_LENGTH or root_length > DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
            return false if not DebuggerMetadata::source_path_utf8_is_valid(root, root_length)
            windows_drive_root: bool = root_length >= SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH and root[SourcePath::ROOT_COLON_INDEX] == SourcePath::ROOT_COLON and root[SourcePath::ROOT_SLASH_INDEX] == SourcePath::SLASH
            windows_unc_root: bool = root_length >= SourcePath::UNC_PREFIX_LENGTH and root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::SLASH and root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::SLASH
            return false if root[SourcePath::ROOT_INITIAL_INDEX] != SourcePath::SLASH and not windows_drive_root
            segment_start: mutable usize = SourcePath::ROOT_MINIMUM_LENGTH if root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::SLASH else SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH
            segment_start <- SourcePath::UNC_PREFIX_LENGTH if windows_unc_root
            return true if root_length == segment_start and not windows_unc_root
            unc_separator_count: mutable usize = 0
            for index in segment_start..<root_length:
                return false if root[index] <= SourcePath::ASCII_CONTROL_MAX or root[index] == SourcePath::ENGINE_MANAGED_SOURCE_PATH_ASCII_DELETE
                return false if root[index] == SourcePath::BACKSLASH
                if root[index] == SourcePath::SLASH:
                    segment_length: usize = index - segment_start
                    return false if segment_length == 0 or (segment_length == SourcePath::SINGLE_DOT_SEGMENT_LENGTH and root[segment_start] == SourcePath::DOT)
                    return false if segment_length == SourcePath::PARENT_SEGMENT_LENGTH and root[segment_start] == SourcePath::DOT and root[segment_start + 1] == SourcePath::DOT
                    unc_separator_count <- unc_separator_count + 1 if windows_unc_root
                    segment_start <- index + 1
            final_segment_length: usize = root_length - segment_start
            return false if final_segment_length == 0 or (final_segment_length == SourcePath::SINGLE_DOT_SEGMENT_LENGTH and root[segment_start] == SourcePath::DOT)
            return false if final_segment_length == SourcePath::PARENT_SEGMENT_LENGTH and root[segment_start] == SourcePath::DOT and root[segment_start + 1] == SourcePath::DOT
            return false if windows_unc_root and unc_separator_count < SourcePath::UNC_MINIMUM_SEPARATORS
            return true

        def managed_set_source_path_root(controller: mutable ManagedController&, root: u8&, root_length: usize) -> bool:
            return false if root_length == SourcePath::ROOT_DISABLED_LENGTH or root_length > DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
            candidate_root: mutable u8[DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY] = zeroed
            normalized_length: mutable usize = root_length
            for index in 0..<root_length:
                candidate_root[index] <- SourcePath::SLASH if root[index] == SourcePath::BACKSLASH else root[index]
            windows_drive_root: bool = normalized_length >= SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH and candidate_root[SourcePath::ROOT_COLON_INDEX] == SourcePath::ROOT_COLON and candidate_root[SourcePath::ROOT_SLASH_INDEX] == SourcePath::SLASH
            windows_unc_root: bool = normalized_length >= SourcePath::UNC_PREFIX_LENGTH and candidate_root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::SLASH and candidate_root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::SLASH
            return false if candidate_root[SourcePath::ROOT_INITIAL_INDEX] != SourcePath::SLASH and not windows_drive_root
            minimum_root_length: mutable usize = SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH if windows_drive_root else SourcePath::ROOT_MINIMUM_LENGTH
            minimum_root_length <- SourcePath::UNC_PREFIX_LENGTH if windows_unc_root
            while normalized_length > minimum_root_length and candidate_root[normalized_length - 1] == SourcePath::SLASH:
                normalized_length <- normalized_length - 1
            return false if not managed_source_root_is_valid(candidate_root[0], normalized_length)
            for index in 0..<normalized_length:
                controller.source_path_root[index] <- candidate_root[index]
            controller.source_path_root_length <- normalized_length
            return true

        def managed_source_root_is_windows(root: u8&, root_length: usize) -> bool:
            return root[SourcePath::ROOT_INITIAL_INDEX] != SourcePath::SLASH or (root_length >= SourcePath::UNC_PREFIX_LENGTH and root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::SLASH)

        def managed_source_path_ascii_lower(byte: u8) -> u8:
            return byte + SourcePath::ASCII_CASE_OFFSET if byte >= SourcePath::ENGINE_MANAGED_SOURCE_PATH_ASCII_UPPER_A and byte <= SourcePath::ENGINE_MANAGED_SOURCE_PATH_ASCII_UPPER_Z
            return byte

        def managed_source_path_byte_matches(client_byte: u8, metadata_byte: u8, windows_path: bool) -> bool:
            return true if client_byte == metadata_byte
            return managed_source_path_ascii_lower(client_byte) == managed_source_path_ascii_lower(metadata_byte) if windows_path
            return false

        def managed_source_file_id_for_path(controller: mutable ManagedController&, path: u8&, path_length: usize) -> DebuggerIdentity::DebugId:
            return DebuggerIdentity::debug_id(Identity::NO_SOURCE_FILE) if path_length == SourcePath::MANAGED_SOURCE_PATH_EMPTY_LENGTH or path_length > DebuggerMetadataSourcePath::MAPPED_SOURCE_PATH_CAPACITY
            return DebuggerIdentity::debug_id(Identity::NO_SOURCE_FILE) if controller.engine.image.source_file_count > DebuggerEDIR::source_file_capacity()
            matched_id: mutable DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Identity::NO_SOURCE_FILE)
            relative_start: mutable usize = 0
            relative_length: mutable usize = path_length
            windows_path: mutable bool = false
            if controller.source_path_root_length > SourcePath::ROOT_DISABLED_LENGTH:
                root_length: usize = controller.source_path_root_length
                windows_path <- managed_source_root_is_windows(controller.source_path_root[0], root_length)
                same_root: mutable bool = path_length > root_length
                if path_length >= root_length:
                    for byte_index in 0..<root_length:
                        client_byte: u8 = SourcePath::SLASH if path[byte_index] == SourcePath::BACKSLASH else path[byte_index]
                        same_root <- false if not managed_source_path_byte_matches(client_byte, controller.source_path_root[byte_index], windows_path)
                else:
                    same_root <- false
                root_has_separator: bool = controller.source_path_root[root_length - 1] == SourcePath::SLASH
                if same_root:
                    if root_has_separator:
                        relative_start <- root_length
                        relative_length <- path_length - root_length
                    else:
                        if path[root_length] == SourcePath::SLASH or path[root_length] == SourcePath::BACKSLASH:
                            relative_start <- root_length + 1
                            relative_length <- path_length - relative_start
            for file_index in 0..<controller.engine.image.source_file_count:
                file: DebuggerMetadata::SourceFile = controller.engine.image.source_files[file_index]
                continue if file.path_length != relative_length
                same_path: mutable bool = true
                for byte_index in 0..<relative_length:
                    client_byte: u8 = SourcePath::SLASH if path[relative_start + byte_index] == SourcePath::BACKSLASH else path[relative_start + byte_index]
                    same_path <- false if not managed_source_path_byte_matches(client_byte, file.path_bytes[byte_index], windows_path)
                if same_path:
                    return DebuggerIdentity::debug_id(Identity::NO_SOURCE_FILE) if matched_id.value != Identity::NO_SOURCE_FILE
                    matched_id <- file.id
            return matched_id

        def managed_source_file_id_is_known(controller: mutable ManagedController&, file_id: DebuggerIdentity::DebugId) -> bool:
            return false if file_id.value == Identity::NO_SOURCE_FILE or controller.engine.image.source_file_count > DebuggerEDIR::source_file_capacity()
            for file_index in 0..<controller.engine.image.source_file_count:
                return true if controller.engine.image.source_files[file_index].id.value == file_id.value
            return false

        def managed_set_source_breakpoint(controller: mutable ManagedController&, location: DebuggerMetadata::SourceLocation) -> DebuggerIdentity::DebugId:
            return DebuggerIdentity::debug_id(0) if not DebuggerMetadata::source_location_is_valid(location) or controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or controller.engine.machine.faulted
            point: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::Breakpoint{
                id: DebuggerIdentity::debug_id(0),
                branch: controller.engine.branch,
                kind: DebuggerBreakpoints::BreakpointKind.Source,
                status: DebuggerBreakpoints::BreakpointStatus.Pending,
                source: location,
                condition: DebuggerIdentity::debug_id(0),
                hit_target: 0,
                hit_count: 0,
                hit_stride: Value::NAME_OFFSET,
                task: DebuggerIdentity::debug_id(0),
                logpoint: false,
                temporary: false
            }
            next_id: u64 = controller.state.breakpoints.next_id
            previous_count: usize = controller.state.breakpoints.count
            updated: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_add(controller.state.breakpoints, point)
            return DebuggerIdentity::debug_id(0) if updated.count == previous_count
            for instruction_index in 0..<controller.engine.image.program.instruction_count.usize():
                span: DebuggerIdentity::SourceSpan = controller.engine.image.instructions[instruction_index].source
                if DebuggerMetadata::source_span_contains(span, location):
                    updated <- DebuggerBreakpointManager::breakpoint_table_resolve_at_instruction(updated, DebuggerIdentity::debug_id(next_id), instruction_index.u64())
                    break
            controller.state.breakpoints <- updated
            return DebuggerIdentity::debug_id(next_id)

        def managed_values(controller: mutable ManagedController&) -> DebuggerValueStore::ValueStore:
            return controller.state.values

        def managed_checkpoint(controller: mutable ManagedController&) -> DebuggerTraceBinary::ByteWriter:
            checkpoint_id: u64 = Checkpoint::ENGINE_MANAGED_CHECKPOINT_MAX_ID if controller.engine.event_count.u64() == Checkpoint::ENGINE_MANAGED_CHECKPOINT_MAX_ID else controller.engine.event_count.u64() + Checkpoint::ENGINE_MANAGED_CHECKPOINT_ID_OFFSET
            snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(controller.engine.machine, DebuggerIdentity::debug_id(checkpoint_id), controller.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))
            return DebuggerCheckpointCodec::checkpoint_encode(snapshot)

        def managed_full_checkpoint(controller: mutable ManagedController&) -> DebuggerFullCheckpoint::ManagedCheckpoint:
            return DebuggerManagedState::state_capture(controller.state, controller.engine.machine, controller.engine.recording, controller.engine.branch, controller.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))

        def managed_restore_full_checkpoint(controller: mutable ManagedController&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> DebuggerErrors::DebuggerError:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::HISTORY) if not DebuggerSession::session_can_inspect(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::ENGINE_FAULT) if checkpoint.recording.value != controller.engine.recording.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::HISTORY) if checkpoint.branch.value != controller.engine.branch.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::ENGINE_FAULT) if checkpoint.machine.program_counter > controller.engine.image.program.instruction_count
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::ENGINE_FAULT) if checkpoint.machine.program_counter == controller.engine.image.program.instruction_count and not checkpoint.machine.halted
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if checkpoint.event > controller.engine.event_count.u64()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if checkpoint.event != controller.session.position.event and controller.session.capabilities.history != DebuggerCapabilities::HistoryKind.Exact
            expected_machine: mutable DebuggerEDIR::Machine = zeroed
            if checkpoint.event < controller.engine.event_count.u64():
                historical_index: usize = checkpoint.event.usize()
                historical_snapshot: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[historical_index]
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if not DebuggerReplayEngine::replay_engine_snapshot_is_valid(controller.engine, historical_index, historical_snapshot)
                expected_machine <- DebuggerCheckpoint::snapshot_restore(historical_snapshot)
            else:
                if controller.engine.event_count == Event::INITIAL_INDEX:
                    expected_machine <- DebuggerEDIR::machine_new()
                    if not DebuggerEDIR::verify_image(controller.engine.image).valid:
                        expected_machine.faulted <- true
                        expected_machine.halted <- true
                else:
                    previous_index: usize = controller.engine.event_count - Event::PREVIOUS_OFFSET
                    previous_snapshot: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[previous_index]
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if not DebuggerReplayEngine::replay_engine_snapshot_is_valid(controller.engine, previous_index, previous_snapshot)
                    expected_machine <- DebuggerCheckpoint::snapshot_restore(previous_snapshot)
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if expected_machine.program_counter >= controller.engine.image.program.instruction_count
                    DebuggerEDIR::machine_step_in_place(expected_machine, controller.engine.image.instructions[expected_machine.program_counter.usize()])
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::HISTORY) if not DebuggerCheckpoint::snapshot_matches_machine(checkpoint.machine, expected_machine)
            restored_session: DebuggerSession::Session = DebuggerSession::session_seek(controller.session, checkpoint.event)
            if restored_session.last_error == DebuggerSession::SessionError.HistoryUnavailable:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            if restored_session.last_error == DebuggerSession::SessionError.Unsupported:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::HISTORY) if restored_session.last_error != DebuggerSession::SessionError.None
            failure <- DebuggerManagedState::state_restore(controller.state, checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            restored: DebuggerEDIR::Machine = DebuggerFullCheckpoint::full_checkpoint_restore_machine(checkpoint)
            controller.engine.machine <- restored
            controller.engine.event_count <- checkpoint.event.usize()
            controller.engine.branch <- checkpoint.branch
            controller.engine.engine_error <- DebuggerReplayEngine::EngineError.None
            controller.session <- restored_session
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_create_branch(controller: mutable ManagedController&) -> DebuggerIdentity::DebugId:
            parent_engine: DebuggerReplayEngine::ReplayEngine = controller.engine
            allocation_engine: mutable DebuggerReplayEngine::ReplayEngine = parent_engine
            branch_value: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(allocation_engine)
            return DebuggerIdentity::debug_id(0) if branch_value.value == 0
            updated: DebuggerBranches::BranchStore = DebuggerBranches::branches_fork(controller.state.branches, parent_engine.branch, parent_engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(parent_engine))
            return DebuggerIdentity::debug_id(0) if updated.count == controller.state.branches.count
            return DebuggerIdentity::debug_id(0) if updated.branches[updated.count - 1].id.value != branch_value.value
            forked: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(parent_engine, branch_value)
            return DebuggerIdentity::debug_id(0) if forked.branch.value != branch_value.value or forked.engine_error != DebuggerReplayEngine::EngineError.None
            forked.next_branch_id <- allocation_engine.next_branch_id
            controller.state.branches <- updated
            controller.engine <- forked
            managed_sync_position(controller)
            return DebuggerIdentity::debug_id(branch_value.value)

        def managed_add_intervention(controller: mutable ManagedController&, branch: DebuggerIdentity::DebugId, intervention: DebuggerBranches::Intervention) -> DebuggerErrors::DebuggerError:
            updated: DebuggerBranches::BranchStore = DebuggerBranches::branches_add_intervention(controller.state.branches, branch, intervention)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HISTORY) if updated.count != controller.state.branches.count
            found: mutable bool = false
            changed: mutable bool = false
            for index in 0..<controller.state.branches.count:
                if controller.state.branches.branches[index].id.value == branch.value:
                    found <- true
                    changed <- updated.branches[index].intervention_count > controller.state.branches.branches[index].intervention_count
                    break
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HISTORY) if not found or not changed
            controller.state.branches <- updated
            return DebuggerErrors::no_error()

        def managed_is_exact(controller: mutable ManagedController&) -> bool:
            return DebuggerReplayEngine::replay_engine_is_exact(controller.engine)

        def managed_fork(controller: mutable ManagedController&, branch: DebuggerIdentity::DebugId) -> DebuggerReplayEngine::ReplayEngine:
            return DebuggerReplayEngine::replay_engine_fork(controller.engine, branch)

        def managed_intervene_accumulator(controller: mutable DebuggerReplayEngine::ReplayEngine&, value: i64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not DebuggerReplayEngine::replay_engine_set_accumulator(controller, value)
            return DebuggerErrors::no_error()
