# Managed execution facade.  It owns the EDIR replay engine and keeps the
# provider-neutral session position synchronized for every editor adapter.

include "./provider.elisa"
include "../core/session.elisa"
include "../core/errors.elisa"
include "../replay/engine.elisa"
include "../replay/checkpoint_codec.elisa"
include "../breakpoint/breakpoint.elisa"
include "../breakpoint/manager.elisa"
include "../breakpoint/resolver.elisa"
include "../metadata/source.elisa"
include "../query/timeline.elisa"
include "../inspect/store.elisa"
include "../inspect/expression_parser.elisa"
include "../vm/edir_codec.elisa"
include "../vm/edir_identity.elisa"
include "./state.elisa"

extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]

module DebuggerManagedEngine:
    private:
        const module Detail:
            ENGINE_FAULT: u32 = 1
            HISTORY: u32 = 2
            ENGINE_MANAGED_DETAIL_UNSUPPORTED: u32 = 3
            HOST_EFFECT_REQUEST: u32 = 7

        const module RestoreIdentityDetail:
            BUILD_MISMATCH: u32 = 4
            IMAGE_MISMATCH: u32 = 5

        const module Event:
            INITIAL_INDEX: usize = 0
            PREVIOUS_OFFSET: usize = 1

        const module Checkpoint:
            ENGINE_MANAGED_CHECKPOINT_ID_OFFSET: u64 = 1
            ENGINE_MANAGED_CHECKPOINT_MAX_ID: u64 = 18446744073709551615

        const module Value:
            NAME_OFFSET: u64 = 1
            GLOBAL_NAME_OFFSET: u64 = 33
            TYPE_ID: u64 = 1
            ENGINE_MANAGED_VALUE_MAX_LOCALS: usize = 32
            ENGINE_MANAGED_VALUE_MAX_GLOBALS: usize = 16

        const module Step:
            COMPOUND_LIMIT: u64 = 64

        const module Reverse:
            FRAME_DEPTH_INCREMENT: usize = 1
            TOP_LEVEL_FRAME_DEPTH: usize = 0
            PREVIOUS_EVENT_INCREMENT: usize = 1
            SNAPSHOT_ID_INCREMENT: u64 = 1
            CALL_RETURN_INCREMENT: u64 = 1
            NO_RETURN_ADDRESS: u64 = 0
            MINIMUM_CALL_TARGET: i64 = 0

        const module SourcePath:
            SLASH: u8 = 47
            BACKSLASH: u8 = 92
            ROOT_COLON: u8 = 58
            DOT: u8 = 46
            ROOT_MINIMUM_LENGTH: usize = 1
            WINDOWS_ROOT_MINIMUM_LENGTH: usize = 3
            UNC_PREFIX_LENGTH: usize = 2
            UNC_MINIMUM_SEPARATORS: usize = 1
            ROOT_COLON_INDEX: usize = 1
            ROOT_SLASH_INDEX: usize = 2
            ROOT_INITIAL_INDEX: usize = 0
            TRAILING_BYTE_OFFSET: usize = 1
            UNC_SECOND_SLASH_INDEX: usize = 1
            UNC_SERVER_START_INDEX: usize = 2
            UNC_SEPARATOR_INCREMENT: usize = 1
            SINGLE_DOT_SEGMENT_LENGTH: usize = 1
            PARENT_SEGMENT_LENGTH: usize = 2
            ROOT_DISABLED_LENGTH: usize = 0
            MANAGED_SOURCE_PATH_EMPTY_LENGTH: usize = 0
            ASCII_CONTROL_MAX: u8 = 31
            ENGINE_MANAGED_SOURCE_PATH_ASCII_DELETE: u8 = 127
            ENGINE_MANAGED_SOURCE_PATH_ASCII_UPPER_A: u8 = 65
            ENGINE_MANAGED_SOURCE_PATH_ASCII_UPPER_Z: u8 = 90
            ASCII_CASE_OFFSET: u8 = 32

        const module Identity:
            NO_SOURCE_FILE: u64 = 0
            NO_BRANCH: u64 = 0
            ENGINE_MANAGED_IDENTITY_NO_INSTRUCTION: u64 = 18446744073709551615

        const module SourceBreakpoint:
            ENGINE_MANAGED_SOURCE_BREAKPOINT_CAPACITY: usize = 256
            ENGINE_MANAGED_SOURCE_BREAKPOINT_NO_COLUMN: u32 = 0
            ENGINE_MANAGED_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX: usize = 0

        const module FunctionBreakpoint:
            FIRST_REQUEST_INDEX: usize = 0
            NO_TEXT_BYTES: usize = 0
            COUNT_INCREMENT: usize = 1
            ID_INCREMENT: u64 = 1
            NO_BREAKPOINT_ID: u64 = 0
            NO_HIT_TARGET: u64 = 0
            NO_HIT_COUNT: u64 = 0
            DEFAULT_HIT_STRIDE: u64 = 1
            NO_TASK: u64 = 0
            NO_CONDITION_LENGTH: usize = 0
            NO_SOURCE_LINE: u32 = 0
            NO_SOURCE_COLUMN: u32 = 0

        const module ConditionBinding:
            LOCAL_PREFIX: cstr = "local"
            GLOBAL_PREFIX: cstr = "global"
            LOCAL_PREFIX_LENGTH: usize = 5
            GLOBAL_PREFIX_LENGTH: usize = 6
            NAME_BUFFER_CAPACITY: usize = 32
            MAX_INDEX_DIGITS: usize = 2
            SINGLE_INDEX_DIGIT_COUNT: usize = 1
            DECIMAL_BASE: usize = 10
            ASCII_ZERO: u8 = 48
            FIRST_INDEX: usize = 0
            FIRST_DIGIT_INDEX: usize = 0
            SECOND_DIGIT_INDEX: usize = 1
            ENVIRONMENT_DETAIL: u32 = 4
            FALSE_VALUE: i64 = 0

        const module Logpoint:
            OUTPUT_CAPACITY: usize = 8192
            DIGIT_CAPACITY: usize = 20
            DECIMAL_BASE: u64 = 10
            ASCII_OPEN_BRACE: u8 = 123
            ASCII_CLOSE_BRACE: u8 = 125
            ASCII_MINUS: u8 = 45
            ASCII_ZERO: u8 = 48
            LINE_FEED: u8 = 10
            FIRST_INDEX: usize = 0
            BYTE_INCREMENT: usize = 1
            EMPTY_EXPRESSION_DETAIL: u32 = 5
            OUTPUT_LIMIT_DETAIL: u32 = 6

        const module HistoryStorage:
            SIDE_HISTORY_INITIALIZED: bool = true

        const module ManagedEffectStep:
            NO_RESULT_BITS: u64 = 0


        def managed_build_identity_matches(left: DebuggerIdentity::BuildIdentity, right: DebuggerIdentity::BuildIdentity) -> bool:
            return left.compiler.value == right.compiler.value and left.runtime.value == right.runtime.value and left.source.value == right.source.value and left.target.value == right.target.value and left.metadata_version == right.metadata_version

    public:
        struct ManagedController:
            session: mutable DebuggerSession::Session
            engine: mutable DebuggerReplayEngine::ReplayEngine
            state: mutable DebuggerManagedState::State
            last_error: mutable DebuggerErrors::DebuggerError
            source_path_root: mutable u8[DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY]
            source_path_root_length: mutable usize
            has_last_breakpoint_stop: mutable bool
            last_breakpoint_event: mutable u64
            last_breakpoint_instruction: mutable u64
            last_breakpoint_branch: mutable DebuggerIdentity::DebugId
            log_output: mutable u8[Logpoint::OUTPUT_CAPACITY]
            log_output_length: mutable usize
            side_history: mutable heap void&?
            side_history_initialized: mutable bool
            side_history_first_event: mutable usize
            side_history_count: mutable usize

        private:
        const module ManagedEffectIdentityDefaults:
            NO_ID: u64 = 0

        const module HostEffectRequestHash:
            NO_REQUEST: u64 = 0
            CLOCK_NOW: u64 = 7570744269544461322
            RANDOM_U64: u64 = 14060235569520077978
            VIRTUAL_FILE_READ_BYTE_BASE: u64 = 13809278000000001024

        const module HostEffectOutput:
            CONSOLE_OUTPUT_RESULT_HASH: u64 = 12802676217615765313
            CONSOLE_OUTPUT_TRANSFERRED_BITS: u64 = 1

        const module HostEffectInput:
            CONSOLE_INPUT_REQUESTED_BYTES: u64 = 1

        const module VirtualFileInput:
            REQUESTED_BYTES: usize = 1
            FIRST_BYTE_INDEX: usize = 0
            EOF_RESULT_BITS: u64 = 18446744073709551615

        const module HostEffectReplayDefaults:
            NO_RESULT_HASH: u64 = 0
            NO_CLOCK_VALUE: i64 = 0
            NO_RANDOM_VALUE: u64 = 0
            DO_NOT_SUPPRESS_EXTERNAL_WRITE: bool = false

        struct ManagedEffectIdentity:
            call_site: mutable DebuggerIdentity::DebugId
            invocation: mutable DebuggerIdentity::DebugId
            valid: mutable bool

        def managed_side_checkpoint_at(controller: ManagedController&, event: usize) -> DebuggerFullCheckpoint::ManagedCheckpoint:
            return zeroed if controller.side_history == null
            trusted Unsafe.PointerCast:
                history: mutable heap DebuggerFullCheckpoint::ManagedCheckpoint& = controller.side_history.cast[mutable heap DebuggerFullCheckpoint::ManagedCheckpoint&]
                return history[event]

        def managed_side_checkpoint_store(controller: mutable ManagedController&, event: usize, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> void:
            return if controller.side_history == null
            trusted Unsafe.PointerCast:
                history: mutable heap DebuggerFullCheckpoint::ManagedCheckpoint& = controller.side_history.cast[mutable heap DebuggerFullCheckpoint::ManagedCheckpoint&]
                history[event] <- checkpoint

        def managed_active_effect_identity(controller: ManagedController&) -> ManagedEffectIdentity:
            return ManagedEffectIdentity{call_site: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), invocation: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), valid: false} if controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count
            call_site: DebuggerEDIRIdentity::StableIdentity = DebuggerEDIRIdentity::effect_call_site_identity(controller.engine.image, controller.engine.machine.program_counter.usize())
            return ManagedEffectIdentity{call_site: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), invocation: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), valid: false} if not call_site.valid
            invocation: DebuggerEDIRIdentity::StableIdentity = DebuggerEDIRIdentity::effect_invocation_identity(controller.engine.image, controller.engine.machine)
            return ManagedEffectIdentity{call_site: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), invocation: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), valid: false} if not invocation.valid
            return ManagedEffectIdentity{call_site: call_site.value, invocation: invocation.value, valid: true}

        def managed_side_checkpoint_capture_current(controller: mutable ManagedController&) -> bool:
            event_index: usize = controller.engine.event_count
            return false if event_index < controller.side_history_first_event or event_index >= DebuggerReplayEngine::Limits::HISTORY_BOUNDARY_CAPACITY or event_index > controller.side_history_count
            checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = managed_full_checkpoint(controller)
            return false if not DebuggerErrors::error_is_ok(DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint))
            if event_index < controller.side_history_count and (managed_side_checkpoint_at(controller, event_index).side_state_hash != checkpoint.side_state_hash or managed_side_checkpoint_at(controller, event_index).state_hash != checkpoint.state_hash):
                controller.side_history_count <- event_index + DebuggerReplayEngine::Limits::BOUNDARY_INCREMENT
            managed_side_checkpoint_store(controller, event_index, checkpoint)
            if event_index == controller.side_history_count:
                controller.side_history_count <- controller.side_history_count + DebuggerReplayEngine::Limits::BOUNDARY_INCREMENT
            return true

        def managed_side_checkpoint_is_valid(controller: mutable ManagedController&, event: usize) -> bool:
            return false if event < controller.side_history_first_event or event >= controller.side_history_count or event >= DebuggerReplayEngine::Limits::HISTORY_BOUNDARY_CAPACITY
            checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = managed_side_checkpoint_at(controller, event)
            return false if checkpoint.event != event.u64() or checkpoint.recording.value != controller.engine.recording.value
            return false if checkpoint.branch.value != DebuggerReplayEngine::replay_engine_branch_at(controller.engine, event.u64()).value
            return false if not managed_build_identity_matches(checkpoint.build, controller.session.build)
            image_fingerprint: DebuggerEDIRCodec::ArtifactFingerprint = DebuggerEDIRCodec::artifact_fingerprint(controller.engine.image)
            return false if not image_fingerprint.valid or checkpoint.image_fingerprint != image_fingerprint.value
            return false if not DebuggerErrors::error_is_ok(DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint))
            if event < controller.engine.event_count:
                return false if not DebuggerReplayEngine::replay_engine_snapshot_is_valid(controller.engine, event, controller.engine.history[event])
                return checkpoint.state_hash == controller.engine.history[event].state_hash
            return true if event > controller.engine.event_count
            return checkpoint.state_hash == DebuggerReplayEngine::replay_engine_state_hash(controller.engine)

        def managed_side_checkpoint_matches_current(controller: mutable ManagedController&) -> bool:
            event: usize = controller.engine.event_count
            return false if not managed_side_checkpoint_is_valid(controller, event)
            current: DebuggerFullCheckpoint::ManagedCheckpoint = managed_full_checkpoint(controller)
            return false if not DebuggerErrors::error_is_ok(DebuggerFullCheckpoint::full_checkpoint_validate(current))
            return managed_side_checkpoint_at(controller, event).side_state_hash == current.side_state_hash and managed_side_checkpoint_at(controller, event).state_hash == current.state_hash

        def managed_side_checkpoint_restore(controller: mutable ManagedController&, event: usize) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not managed_side_checkpoint_is_valid(controller, event)
            candidate_state: mutable DebuggerManagedState::State = controller.state
            failure: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_restore(candidate_state, managed_side_checkpoint_at(controller, event))
            return failure if not DebuggerErrors::error_is_ok(failure)
            controller.state <- candidate_state
            return DebuggerErrors::no_error()

    public:
        enum HostEffectKind:
            None
            ClockNow
            RandomU64
            ConsoleInput
            ConsoleOutput
            VirtualFileReadByte

        struct HostEffectRequest:
            kind: mutable HostEffectKind
            call_site: mutable DebuggerIdentity::DebugId
            invocation: mutable DebuggerIdentity::DebugId
            request_hash: mutable u64
            payload: mutable u64
            valid: mutable bool

        enum ExecutionOutcomeKind:
            Completed
            AwaitingHostEffect
            Failed

        struct ExecutionOutcome:
            kind: mutable ExecutionOutcomeKind
            position: mutable DebuggerIdentity::Position
            host_effect: mutable HostEffectRequest
            failure: mutable DebuggerErrors::DebuggerError

        # Host effect providers use the current EDIR source and active call
        # stack directly, keeping editor adapters out of identity derivation.
        def managed_host_effect_request(controller: ManagedController&) -> HostEffectRequest:
            request: mutable HostEffectRequest = HostEffectRequest{kind: HostEffectKind.None, call_site: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), invocation: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), request_hash: HostEffectRequestHash::NO_REQUEST, payload: ManagedEffectIdentityDefaults::NO_ID, valid: false}
            return request if controller.engine.machine.halted or controller.engine.machine.faulted or controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count
            instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
            if instruction.opcode == DebuggerEDIR::Opcode.ClockNow:
                request.kind <- HostEffectKind.ClockNow
                request.request_hash <- HostEffectRequestHash::CLOCK_NOW
            elif instruction.opcode == DebuggerEDIR::Opcode.RandomU64:
                request.kind <- HostEffectKind.RandomU64
                request.request_hash <- HostEffectRequestHash::RANDOM_U64
            elif instruction.opcode == DebuggerEDIR::Opcode.ConsoleWriteByte:
                request.kind <- HostEffectKind.ConsoleOutput
                request.payload <- instruction.a.u64()
                request.request_hash <- DebuggerManagedState::console_output_request_hash(instruction.a.u8())
            elif instruction.opcode == DebuggerEDIR::Opcode.ConsoleReadByte:
                request.kind <- HostEffectKind.ConsoleInput
                request.payload <- HostEffectInput::CONSOLE_INPUT_REQUESTED_BYTES
                request.request_hash <- DebuggerManagedState::console_input_request_hash(HostEffectInput::CONSOLE_INPUT_REQUESTED_BYTES.usize())
            elif instruction.opcode == DebuggerEDIR::Opcode.VirtualFileReadByte:
                request.kind <- HostEffectKind.VirtualFileReadByte
                request.payload <- instruction.a.u64()
                request.request_hash <- HostEffectRequestHash::VIRTUAL_FILE_READ_BYTE_BASE + request.payload
            else:
                return request
            identity: ManagedEffectIdentity = managed_active_effect_identity(controller)
            return request if not identity.valid
            request.call_site <- identity.call_site
            request.invocation <- identity.invocation
            request.valid <- true
            return request

        def managed_host_effect_requires_provider(kind: HostEffectKind) -> bool:
            return kind == HostEffectKind.ClockNow or kind == HostEffectKind.RandomU64 or kind == HostEffectKind.ConsoleInput or kind == HostEffectKind.ConsoleOutput

        def managed_host_effect_is_pending(controller: ManagedController&) -> bool:
            return managed_host_effect_requires_provider(managed_host_effect_request(controller).kind)

        def managed_begin_side_effect_replay(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            candidate_state: mutable DebuggerManagedState::State = controller.state
            failure: DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(candidate_state)
            return failure if not DebuggerErrors::error_is_ok(failure)
            previous_state: DebuggerManagedState::State = controller.state
            controller.state <- candidate_state
            if not managed_side_checkpoint_capture_current(controller):
                controller.state <- previous_state
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            return DebuggerErrors::no_error()

        def managed_record_clock_effect(controller: mutable ManagedController&, request_hash: u64, result_hash: u64, value: i64) -> DebuggerErrors::DebuggerError:
            request: HostEffectRequest = managed_host_effect_request(controller)
            if request.kind != HostEffectKind.None:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if not request.valid
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if request.kind != HostEffectKind.ClockNow or request.request_hash != request_hash
                preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.ClockNow)
                return preflight if not DebuggerErrors::error_is_ok(preflight)
                candidate_state: mutable DebuggerManagedState::State = controller.state
                failure: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_clock_effect(candidate_state, request.call_site, request.call_site, request.invocation, request_hash, result_hash, value)
                return failure if not DebuggerErrors::error_is_ok(failure)
                return managed_commit_host_effect(controller, candidate_state, value.u64(), HostEffectKind.ClockNow)
            identity: ManagedEffectIdentity = managed_active_effect_identity(controller)
            failure: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_clock_effect(controller.state, identity.call_site, identity.call_site, identity.invocation, request_hash, result_hash, value)
            if DebuggerErrors::error_is_ok(failure):
                _ = managed_side_checkpoint_capture_current(controller)
            return failure

        def managed_replay_clock_effect(controller: mutable ManagedController&, request_hash: u64) -> DebuggerEffects::EffectReplay:
            request: HostEffectRequest = managed_host_effect_request(controller)
            if request.kind != HostEffectKind.None:
                return managed_clock_effect_replay_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST)) if not request.valid
                return managed_clock_effect_replay_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST)) if request.kind != HostEffectKind.ClockNow
                preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.ClockNow)
                return managed_clock_effect_replay_failure(preflight) if not DebuggerErrors::error_is_ok(preflight)
                candidate_state: mutable DebuggerManagedState::State = controller.state
                replay: mutable DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(candidate_state, request.call_site, request.call_site, request.invocation, request_hash)
                if not replay.accepted:
                    controller.state <- candidate_state
                    return replay
                failure: DebuggerErrors::DebuggerError = managed_commit_host_effect(controller, candidate_state, replay.result_value.u64(), HostEffectKind.ClockNow)
                return managed_clock_effect_replay_failure(failure) if not DebuggerErrors::error_is_ok(failure)
                return replay
            identity: ManagedEffectIdentity = managed_active_effect_identity(controller)
            replay: mutable DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(controller.state, identity.call_site, identity.call_site, identity.invocation, request_hash)
            if replay.accepted:
                _ = managed_side_checkpoint_capture_current(controller)
            return replay

        def managed_record_random_effect(controller: mutable ManagedController&, request_hash: u64, result_hash: u64, value: u64) -> DebuggerErrors::DebuggerError:
            request: HostEffectRequest = managed_host_effect_request(controller)
            if request.kind != HostEffectKind.None:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if not request.valid
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if request.kind != HostEffectKind.RandomU64 or request.request_hash != request_hash
                preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.RandomU64)
                return preflight if not DebuggerErrors::error_is_ok(preflight)
                candidate_state: mutable DebuggerManagedState::State = controller.state
                failure: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_random_effect(candidate_state, request.call_site, request.call_site, request.invocation, request_hash, result_hash, value)
                return failure if not DebuggerErrors::error_is_ok(failure)
                return managed_commit_host_effect(controller, candidate_state, value, HostEffectKind.RandomU64)
            identity: ManagedEffectIdentity = managed_active_effect_identity(controller)
            failure: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_random_effect(controller.state, identity.call_site, identity.call_site, identity.invocation, request_hash, result_hash, value)
            if DebuggerErrors::error_is_ok(failure):
                _ = managed_side_checkpoint_capture_current(controller)
            return failure

        def managed_replay_random_effect(controller: mutable ManagedController&, request_hash: u64) -> DebuggerEffects::RandomEffectReplay:
            request: HostEffectRequest = managed_host_effect_request(controller)
            if request.kind != HostEffectKind.None:
                return managed_random_effect_replay_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST)) if not request.valid
                return managed_random_effect_replay_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST)) if request.kind != HostEffectKind.RandomU64
                preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.RandomU64)
                return managed_random_effect_replay_failure(preflight) if not DebuggerErrors::error_is_ok(preflight)
                candidate_state: mutable DebuggerManagedState::State = controller.state
                replay: mutable DebuggerEffects::RandomEffectReplay = DebuggerManagedState::state_replay_random_effect(candidate_state, request.call_site, request.call_site, request.invocation, request_hash)
                if not replay.accepted:
                    controller.state <- candidate_state
                    return replay
                failure: DebuggerErrors::DebuggerError = managed_commit_host_effect(controller, candidate_state, replay.value, HostEffectKind.RandomU64)
                return managed_random_effect_replay_failure(failure) if not DebuggerErrors::error_is_ok(failure)
                return replay
            identity: ManagedEffectIdentity = managed_active_effect_identity(controller)
            replay: mutable DebuggerEffects::RandomEffectReplay = DebuggerManagedState::state_replay_random_effect(controller.state, identity.call_site, identity.call_site, identity.invocation, request_hash)
            if replay.accepted:
                _ = managed_side_checkpoint_capture_current(controller)
            return replay

        def managed_record_console_output(controller: mutable ManagedController&, request_hash: u64) -> DebuggerErrors::DebuggerError:
            request: HostEffectRequest = managed_host_effect_request(controller)
            if request.kind != HostEffectKind.None:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if not request.valid
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if request.kind != HostEffectKind.ConsoleOutput or request.request_hash != request_hash
                preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.ConsoleOutput)
                return preflight if not DebuggerErrors::error_is_ok(preflight)
                candidate_state: mutable DebuggerManagedState::State = controller.state
                failure: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_console_output(candidate_state, request.call_site, request.invocation, request_hash, HostEffectOutput::CONSOLE_OUTPUT_RESULT_HASH, request.payload.u8())
                return failure if not DebuggerErrors::error_is_ok(failure)
                return managed_commit_host_effect(controller, candidate_state, HostEffectOutput::CONSOLE_OUTPUT_TRANSFERRED_BITS, HostEffectKind.ConsoleOutput)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST)

        def managed_replay_console_output(controller: mutable ManagedController&, request_hash: u64) -> DebuggerEffects::EffectReplay:
            request: HostEffectRequest = managed_host_effect_request(controller)
            if request.kind != HostEffectKind.None:
                return managed_console_output_replay_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST)) if not request.valid or request.kind != HostEffectKind.ConsoleOutput or request.request_hash != request_hash
                preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.ConsoleOutput)
                return managed_console_output_replay_failure(preflight) if not DebuggerErrors::error_is_ok(preflight)
                candidate_state: mutable DebuggerManagedState::State = controller.state
                replay: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_console_output(candidate_state, request.call_site, request.invocation, request_hash, request.payload.u8())
                if not replay.accepted:
                    controller.state <- candidate_state
                    return replay
                failure: DebuggerErrors::DebuggerError = managed_commit_host_effect(controller, candidate_state, replay.result_value.u64(), HostEffectKind.ConsoleOutput)
                return managed_console_output_replay_failure(failure) if not DebuggerErrors::error_is_ok(failure)
                return replay
            return managed_console_output_replay_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST))

        def managed_record_console_input(controller: mutable ManagedController&, request_hash: u64, result_hash: u64, value: i64) -> DebuggerErrors::DebuggerError:
            request: HostEffectRequest = managed_host_effect_request(controller)
            if request.kind != HostEffectKind.None:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if not request.valid
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if request.kind != HostEffectKind.ConsoleInput or request.request_hash != request_hash
                preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.ConsoleInput)
                return preflight if not DebuggerErrors::error_is_ok(preflight)
                candidate_state: mutable DebuggerManagedState::State = controller.state
                failure: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_console_input(candidate_state, request.call_site, request.invocation, request_hash, result_hash, request.payload.usize(), value)
                return failure if not DebuggerErrors::error_is_ok(failure)
                return managed_commit_host_effect(controller, candidate_state, value.u64(), HostEffectKind.ConsoleInput)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST)

        def managed_replay_console_input(controller: mutable ManagedController&, request_hash: u64) -> DebuggerEffects::EffectReplay:
            request: HostEffectRequest = managed_host_effect_request(controller)
            if request.kind != HostEffectKind.None:
                return managed_console_input_replay_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST)) if not request.valid or request.kind != HostEffectKind.ConsoleInput or request.request_hash != request_hash
                preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.ConsoleInput)
                return managed_console_input_replay_failure(preflight) if not DebuggerErrors::error_is_ok(preflight)
                candidate_state: mutable DebuggerManagedState::State = controller.state
                replay: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_console_input(candidate_state, request.call_site, request.invocation, request_hash, request.payload.usize())
                if not replay.accepted:
                    controller.state <- candidate_state
                    return replay
                failure: DebuggerErrors::DebuggerError = managed_commit_host_effect(controller, candidate_state, replay.result_value.u64(), HostEffectKind.ConsoleInput)
                return managed_console_input_replay_failure(failure) if not DebuggerErrors::error_is_ok(failure)
                return replay
            return managed_console_input_replay_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST))

        def managed_record_virtual_file_read(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            request: HostEffectRequest = managed_host_effect_request(controller)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if not request.valid or request.kind != HostEffectKind.VirtualFileReadByte
            preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, HostEffectKind.VirtualFileReadByte)
            return preflight if not DebuggerErrors::error_is_ok(preflight)
            candidate_state: mutable DebuggerManagedState::State = controller.state
            output: mutable u8[VirtualFileInput::REQUESTED_BYTES] = zeroed
            read: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(candidate_state.resources, DebuggerIdentity::debug_id(request.payload), output[VirtualFileInput::FIRST_BYTE_INDEX], VirtualFileInput::REQUESTED_BYTES)
            return read.failure if not DebuggerErrors::error_is_ok(read.failure)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENGINE_FAULT) if (read.eof and read.transferred != 0) or (not read.eof and read.transferred != VirtualFileInput::REQUESTED_BYTES)
            result_bits: u64 = VirtualFileInput::EOF_RESULT_BITS if read.eof else output[VirtualFileInput::FIRST_BYTE_INDEX].u64()
            return managed_commit_host_effect(controller, candidate_state, result_bits, HostEffectKind.VirtualFileReadByte)

        def managed_initialize(controller: mutable ManagedController&, session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&, recording: DebuggerIdentity::DebugId) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if not controller.side_history_initialized:
                storage: mutable heap void&? = malloc(size_of(DebuggerFullCheckpoint::ManagedCheckpoint) * DebuggerReplayEngine::Limits::HISTORY_BOUNDARY_CAPACITY)
                if storage == null:
                    panic("managed history allocation failed")
                trusted Unsafe.PointerCast:
                    controller.side_history <- storage
                controller.side_history_initialized <- HistoryStorage::SIDE_HISTORY_INITIALIZED
            controller.session <- session
            DebuggerReplayEngine::replay_engine_initialize(controller.engine, image, recording)
            # Configuration created before launch must already carry the
            # recording identity, not the unrelated editor session identity.
            controller.side_history_count <- Event::INITIAL_INDEX
            controller.side_history_first_event <- Event::INITIAL_INDEX
            DebuggerManagedState::state_initialize(controller.state)
            controller.last_error <- DebuggerErrors::no_error()
            # These fixed buffers are read only below their active lengths.
            # Reset the lengths and keep the existing storage instead of
            # clearing kilobytes that cannot be observed after initialization.
            controller.source_path_root_length <- SourcePath::ROOT_DISABLED_LENGTH
            controller.has_last_breakpoint_stop <- false
            controller.last_breakpoint_event <- Event::INITIAL_INDEX.u64()
            controller.last_breakpoint_instruction <- Identity::ENGINE_MANAGED_IDENTITY_NO_INSTRUCTION
            controller.last_breakpoint_branch <- DebuggerIdentity::debug_id(Identity::NO_BRANCH)
            controller.log_output_length <- Event::INITIAL_INDEX
            managed_sync_position(controller)

        # Mount immutable launch inputs before the first guest instruction.
        # Updating boundary zero keeps reverse/seek and replay aligned with the
        # exact bytes the editor adapter supplied for this recording.
        def managed_resource_mount(controller: mutable ManagedController&, path: DebuggerIdentity::DebugId, writable: bool, generation: u64, bytes: u8&, length: usize) -> DebuggerVirtualResources::ResourceOpenResult:
            result: mutable DebuggerVirtualResources::ResourceOpenResult = zeroed
            result.handle <- DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID)
            result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
            session_snapshot: DebuggerSession::Session = controller.session
            machine_snapshot: DebuggerEDIR::Machine = controller.engine.machine
            event_count: usize = controller.engine.event_count
            session_state: DebuggerSession::SessionState = session_snapshot.state
            program_counter: u64 = machine_snapshot.program_counter
            machine_steps: u64 = machine_snapshot.steps
            machine_halted: bool = machine_snapshot.halted
            machine_faulted: bool = machine_snapshot.faulted
            return result if session_state != DebuggerSession::SessionState.Created and session_state != DebuggerSession::SessionState.Configuring
            return result if event_count != Event::INITIAL_INDEX
            return result if program_counter != Event::INITIAL_INDEX.u64()
            return result if machine_steps != Event::INITIAL_INDEX.u64()
            return result if machine_halted or machine_faulted
            candidate_state: mutable DebuggerManagedState::State = controller.state
            result <- DebuggerVirtualResources::resources_mount(candidate_state.resources, path, writable, generation, bytes, length)
            return result if not result.accepted
            original_state: DebuggerManagedState::State = controller.state
            original_history_count: usize = controller.side_history_count
            original_checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = managed_side_checkpoint_at(controller, Event::INITIAL_INDEX)
            controller.state <- candidate_state
            if not managed_side_checkpoint_capture_current(controller):
                controller.state <- original_state
                controller.side_history_count <- original_history_count
                managed_side_checkpoint_store(controller, Event::INITIAL_INDEX, original_checkpoint)
                result.accepted <- false
                result.handle <- DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID)
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            return result

        def managed_sync_position(controller: mutable ManagedController&) -> void:
            controller.session.position <- DebuggerReplayEngine::replay_engine_position(controller.engine)
            controller.session.retained_last <- controller.session.position.event if controller.session.position.event > controller.session.retained_last
            _ = managed_side_checkpoint_capture_current(controller)

        def managed_refresh_values(controller: mutable ManagedController&) -> void:
            DebuggerManagedState::state_reset_values(controller.state, controller.session.stop_generation)
            available: usize = controller.engine.image.program.local_count.usize() if controller.engine.image.program.local_count <= Value::ENGINE_MANAGED_VALUE_MAX_LOCALS.u64() else Value::ENGINE_MANAGED_VALUE_MAX_LOCALS
            for index in 0..<available:
                name: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(index.u64() + Value::NAME_OFFSET)
                type_id: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Value::TYPE_ID)
                if controller.engine.machine.locals_initialized[index]:
                    DebuggerValueStore::value_store_add_scalar(controller.state.values, name, type_id, controller.engine.machine.locals[index])
                else:
                    DebuggerValueStore::value_store_add_uninitialized(controller.state.values, name, type_id)
            for index in 0..<Value::ENGINE_MANAGED_VALUE_MAX_GLOBALS:
                global_name: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(index.u64() + Value::GLOBAL_NAME_OFFSET)
                global_type_id: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Value::TYPE_ID)
                if controller.engine.machine.globals_initialized[index]:
                    DebuggerValueStore::value_store_add_scalar(controller.state.values, global_name, global_type_id, controller.engine.machine.globals[index])
                else:
                    DebuggerValueStore::value_store_add_uninitialized(controller.state.values, global_name, global_type_id)

        def managed_source_position_matches(left: DebuggerIdentity::SourceSpan, right: DebuggerIdentity::SourceSpan) -> bool:
            # A missing span cannot define a source-level step boundary.
            return false if not DebuggerMetadata::source_span_is_valid(left) or not DebuggerMetadata::source_span_is_valid(right)
            return left.file.value == right.file.value and left.start_byte == right.start_byte and left.end_byte == right.end_byte and left.start_line == right.start_line and left.start_column == right.start_column and left.end_line == right.end_line and left.end_column == right.end_column and left.discriminator == right.discriminator

        def managed_current_source(controller: mutable ManagedController&) -> DebuggerIdentity::SourceSpan:
            return zeroed if controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count
            return controller.engine.image.instructions[controller.engine.machine.program_counter.usize()].source

        def managed_add_condition_bindings(controller: mutable ManagedController&, environment: mutable DebuggerExpressionParser::ExpressionEnvironment&, globals: bool) -> bool:
            count: mutable usize = Value::ENGINE_MANAGED_VALUE_MAX_LOCALS if not globals else Value::ENGINE_MANAGED_VALUE_MAX_GLOBALS
            count <- controller.engine.image.program.local_count.usize() if not globals and controller.engine.image.program.local_count < count.u64()
            prefix: cstr = ConditionBinding::GLOBAL_PREFIX if globals else ConditionBinding::LOCAL_PREFIX
            prefix_length: usize = ConditionBinding::GLOBAL_PREFIX_LENGTH if globals else ConditionBinding::LOCAL_PREFIX_LENGTH
            for index in ConditionBinding::FIRST_INDEX..<count:
                name: mutable u8[ConditionBinding::NAME_BUFFER_CAPACITY] = zeroed
                for prefix_index in ConditionBinding::FIRST_INDEX..<prefix_length:
                    name[prefix_index] <- prefix[prefix_index].u8()
                digit_count: usize = ConditionBinding::MAX_INDEX_DIGITS if index >= ConditionBinding::DECIMAL_BASE else ConditionBinding::SINGLE_INDEX_DIGIT_COUNT
                if digit_count == ConditionBinding::MAX_INDEX_DIGITS:
                    name[prefix_length + ConditionBinding::FIRST_DIGIT_INDEX] <- ConditionBinding::ASCII_ZERO + (index / ConditionBinding::DECIMAL_BASE).u8()
                    name[prefix_length + ConditionBinding::SECOND_DIGIT_INDEX] <- ConditionBinding::ASCII_ZERO + (index % ConditionBinding::DECIMAL_BASE).u8()
                else:
                    name[prefix_length] <- ConditionBinding::ASCII_ZERO + index.u8()
                value: i64 = controller.engine.machine.globals[index] if globals else controller.engine.machine.locals[index]
                available: bool = controller.engine.machine.globals_initialized[index] if globals else controller.engine.machine.locals_initialized[index]
                return false if not DebuggerExpressionParser::expression_environment_add(environment, name[ConditionBinding::FIRST_INDEX], prefix_length + digit_count, value, available)
            return true

        def managed_evaluate_expression(controller: mutable ManagedController&, expression: u8&, expression_length: usize) -> DebuggerExpressionParser::ExpressionParseResult:
            environment: mutable DebuggerExpressionParser::ExpressionEnvironment = DebuggerExpressionParser::expression_environment_new()
            if not managed_add_condition_bindings(controller, environment, false) or not managed_add_condition_bindings(controller, environment, true):
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ConditionBinding::ENVIRONMENT_DETAIL)
                return DebuggerExpressionParser::ExpressionParseResult{value: 0, consumed: 0, valid: false, failure: failure}
            return DebuggerExpressionParser::expression_parse_with_environment(expression[ConditionBinding::FIRST_INDEX], expression_length, environment)

        def managed_evaluate_breakpoint_condition(controller: mutable ManagedController&, point: DebuggerBreakpoints::Breakpoint) -> DebuggerExpressionParser::ExpressionParseResult:
            return managed_evaluate_expression(controller, point.condition_expression[ConditionBinding::FIRST_INDEX], point.condition_length)

        def managed_log_output_append(controller: mutable ManagedController&, byte: u8) -> bool:
            return false if controller.log_output_length >= Logpoint::OUTPUT_CAPACITY
            controller.log_output[controller.log_output_length] <- byte
            controller.log_output_length <- controller.log_output_length + Logpoint::BYTE_INCREMENT
            return true

        def managed_log_output_append_signed(controller: mutable ManagedController&, value: i64) -> bool:
            digits: mutable u8[Logpoint::DIGIT_CAPACITY] = zeroed
            magnitude: mutable u64 = value.u64()
            magnitude <- (-(value + 1)).u64() + Logpoint::BYTE_INCREMENT.u64() if value < 0
            digit_count: mutable usize = 0
            while magnitude > 0:
                return false if digit_count >= Logpoint::DIGIT_CAPACITY
                digits[digit_count] <- Logpoint::ASCII_ZERO + (magnitude % Logpoint::DECIMAL_BASE).u8()
                digit_count <- digit_count + Logpoint::BYTE_INCREMENT
                magnitude <- magnitude / Logpoint::DECIMAL_BASE
            digit_count <- Logpoint::BYTE_INCREMENT if digit_count == 0
            digits[Logpoint::FIRST_INDEX] <- Logpoint::ASCII_ZERO if value == ConditionBinding::FALSE_VALUE
            return false if value < 0 and not managed_log_output_append(controller, Logpoint::ASCII_MINUS)
            while digit_count > 0:
                digit_count <- digit_count - Logpoint::BYTE_INCREMENT
                return false if not managed_log_output_append(controller, digits[digit_count])
            return true

        def managed_logpoint_render(controller: mutable ManagedController&, point: DebuggerBreakpoints::Breakpoint) -> DebuggerErrors::DebuggerError:
            output_start: usize = controller.log_output_length
            cursor: mutable usize = Logpoint::FIRST_INDEX
            while cursor < point.log_message_length:
                if point.log_message[cursor] == Logpoint::ASCII_OPEN_BRACE:
                    expression_start: usize = cursor + Logpoint::BYTE_INCREMENT
                    expression_end: mutable usize = expression_start
                    while expression_end < point.log_message_length and point.log_message[expression_end] != Logpoint::ASCII_CLOSE_BRACE:
                        expression_end <- expression_end + Logpoint::BYTE_INCREMENT
                    if expression_end < point.log_message_length:
                        expression_length: usize = expression_end - expression_start
                        if expression_length == 0:
                            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Logpoint::EMPTY_EXPRESSION_DETAIL)
                        evaluated: DebuggerExpressionParser::ExpressionParseResult = managed_evaluate_expression(controller, point.log_message[expression_start], expression_length)
                        return evaluated.failure if not evaluated.valid
                        return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Logpoint::OUTPUT_LIMIT_DETAIL) if not managed_log_output_append_signed(controller, evaluated.value)
                        cursor <- expression_end + Logpoint::BYTE_INCREMENT
                        continue
                if not managed_log_output_append(controller, point.log_message[cursor]):
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Logpoint::OUTPUT_LIMIT_DETAIL)
                cursor <- cursor + Logpoint::BYTE_INCREMENT
            if controller.log_output_length == output_start or controller.log_output[controller.log_output_length - Logpoint::BYTE_INCREMENT] != Logpoint::LINE_FEED:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Logpoint::OUTPUT_LIMIT_DETAIL) if not managed_log_output_append(controller, Logpoint::LINE_FEED)
            return DebuggerErrors::no_error()

        def managed_function_breakpoint_matches(controller: mutable ManagedController&, point: DebuggerBreakpoints::Breakpoint&, instruction: u64) -> bool:
            return false if point.function_name_length == DebuggerBreakpoints::breakpoint_empty_function_name_length() or controller.engine.image.function_count > DebuggerEDIR::function_capacity()
            for function_index in 0..<controller.engine.image.function_count:
                function: DebuggerEDIR::FunctionDescriptor = controller.engine.image.functions[function_index]
                continue if function.entry_instruction != instruction or function.name_length != point.function_name_length
                name_matches: mutable bool = true
                for name_index in 0..<point.function_name_length:
                    name_matches <- false if function.name_bytes[name_index] != point.function_name[name_index]
                return true if name_matches
            return false

        def managed_breakpoint_position_matches(controller: mutable ManagedController&, point: DebuggerBreakpoints::Breakpoint&, table: DebuggerBreakpointManager::BreakpointTable&, index: usize, branch: DebuggerIdentity::DebugId, source: DebuggerIdentity::SourceSpan, instruction: u64) -> bool:
            source_match: bool = point.kind == DebuggerBreakpoints::BreakpointKind.Source and table.resolved_instructions[index] == instruction and DebuggerMetadata::source_span_contains(source, point.source)
            function_match: bool = point.kind == DebuggerBreakpoints::BreakpointKind.Function and managed_function_breakpoint_matches(controller, point, instruction)
            return point.status == DebuggerBreakpoints::BreakpointStatus.Verified and (source_match or function_match) and DebuggerBreakpoints::breakpoint_matches_branch(point, branch)

        def managed_breakpoint_would_stop_at_instruction(controller: mutable ManagedController&, branch: DebuggerIdentity::DebugId, source: DebuggerIdentity::SourceSpan, instruction: u64) -> bool:
            return false if controller.state.breakpoints.count > DebuggerBreakpointManager::breakpoint_table_capacity()
            for index in 0..<controller.state.breakpoints.count:
                point: DebuggerBreakpoints::Breakpoint = controller.state.breakpoints.points[index]
                if managed_breakpoint_position_matches(controller, point, controller.state.breakpoints, index, branch, source, instruction):
                    observed: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::breakpoint_observe_hit(point, branch)
                    if DebuggerBreakpoints::breakpoint_should_stop(observed, branch):
                        return true if observed.condition_length == 0
                        evaluated: DebuggerExpressionParser::ExpressionParseResult = managed_evaluate_breakpoint_condition(controller, observed)
                        if not evaluated.valid:
                            controller.state.breakpoints.points[index].status <- DebuggerBreakpoints::BreakpointStatus.Disabled if evaluated.failure.code == DebuggerErrors::ErrorCode.InvalidArgument
                            controller.last_error <- evaluated.failure
                            return true
                        return true if evaluated.value != ConditionBinding::FALSE_VALUE
            return false

        def managed_compound_breakpoint_should_stop(controller: mutable ManagedController&, initial_source: DebuggerIdentity::SourceSpan) -> bool:
            current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            return false if managed_source_position_matches(initial_source, current_source)
            return managed_breakpoint_should_stop(controller)

        def managed_breakpoint_should_stop(controller: mutable ManagedController&) -> bool:
            return false if controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count
            instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
            event_branch: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64())
            return false if controller.state.breakpoints.count > DebuggerBreakpointManager::breakpoint_table_capacity()
            should_stop: mutable bool = false
            for index in 0..<controller.state.breakpoints.count:
                point: DebuggerBreakpoints::Breakpoint = controller.state.breakpoints.points[index]
                if managed_breakpoint_position_matches(controller, point, controller.state.breakpoints, index, event_branch, instruction.source, controller.engine.machine.program_counter):
                    observed: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::breakpoint_observe_hit(point, event_branch)
                    controller.state.breakpoints.points[index] <- observed
                    if DebuggerBreakpoints::breakpoint_hit_policy_matches(observed, event_branch):
                        condition_matches: mutable bool = true
                        if observed.condition_length > 0:
                            evaluated: DebuggerExpressionParser::ExpressionParseResult = managed_evaluate_breakpoint_condition(controller, observed)
                            if not evaluated.valid:
                                controller.state.breakpoints.points[index].status <- DebuggerBreakpoints::BreakpointStatus.Disabled if evaluated.failure.code == DebuggerErrors::ErrorCode.InvalidArgument
                                controller.last_error <- evaluated.failure
                                should_stop <- true
                                break
                            condition_matches <- evaluated.value != ConditionBinding::FALSE_VALUE
                        if condition_matches:
                            if observed.logpoint:
                                log_failure: DebuggerErrors::DebuggerError = managed_logpoint_render(controller, observed)
                                if not DebuggerErrors::error_is_ok(log_failure):
                                    controller.last_error <- log_failure
                                    should_stop <- true
                                    break
                            else:
                                should_stop <- true
            if should_stop:
                controller.has_last_breakpoint_stop <- true
                controller.last_breakpoint_event <- controller.engine.event_count.u64()
                controller.last_breakpoint_instruction <- controller.engine.machine.program_counter
                controller.last_breakpoint_branch <- event_branch
            return should_stop

        def managed_launch(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or controller.engine.machine.faulted
            controller.session <- DebuggerSession::session_launch(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_pause(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            controller.session <- DebuggerSession::session_pause(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_continue(controller: mutable ManagedController&, max_steps: u64) -> DebuggerErrors::DebuggerError:
            controller.log_output_length <- Logpoint::FIRST_INDEX
            # Continue checks its current position except when that exact event
            # and instruction already stopped on a breakpoint. This also lets
            # reverse navigation rediscover breakpoints at event zero.
            current_branch: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64())
            repeat_breakpoint_position: bool = controller.has_last_breakpoint_stop and controller.last_breakpoint_event == controller.engine.event_count.u64() and controller.last_breakpoint_instruction == controller.engine.machine.program_counter and controller.last_breakpoint_branch.value == current_branch.value
            if controller.session.state != DebuggerSession::SessionState.Running:
                controller.session <- DebuggerSession::session_resume(controller.session)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            controller.last_error <- DebuggerErrors::no_error()
            controller.engine.engine_error <- DebuggerReplayEngine::EngineError.None if not controller.engine.machine.faulted
            start: u64 = controller.engine.event_count.u64()
            hit_breakpoint: mutable bool = false
            host_effect_pending: mutable bool = false
            first_iteration: mutable bool = true
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count.u64() - start < max_steps:
                # Skip the exact position already reported as a breakpoint,
                # but allow breakpoints after reverse navigation to be found.
                if (not first_iteration or not repeat_breakpoint_position) and managed_breakpoint_should_stop(controller):
                    hit_breakpoint <- true
                    break
                if managed_host_effect_is_pending(controller):
                    host_effect_pending <- true
                    break
                pending_request: HostEffectRequest = managed_host_effect_request(controller)
                if pending_request.kind == HostEffectKind.VirtualFileReadByte:
                    resource_failure: DebuggerErrors::DebuggerError = managed_record_virtual_file_read(controller)
                    if not DebuggerErrors::error_is_ok(resource_failure):
                        controller.last_error <- resource_failure
                        break
                else:
                    DebuggerReplayEngine::replay_engine_step(controller.engine)
                    _ = managed_side_checkpoint_capture_current(controller)
                first_iteration <- false
                break if controller.engine.engine_error != DebuggerReplayEngine::EngineError.None
            if not hit_breakpoint and not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count.u64() - start >= max_steps:
                controller.engine.engine_error <- DebuggerReplayEngine::EngineError.StepLimit
            managed_sync_position(controller)
            controller.session <- DebuggerSession::session_stop(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            managed_sync_position(controller)
            managed_refresh_values(controller)
            pending_request: HostEffectRequest = managed_host_effect_request(controller) if not hit_breakpoint else HostEffectRequest{kind: HostEffectKind.None, call_site: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), invocation: DebuggerIdentity::debug_id(ManagedEffectIdentityDefaults::NO_ID), request_hash: HostEffectRequestHash::NO_REQUEST, payload: ManagedEffectIdentityDefaults::NO_ID, valid: false}
            host_effect_pending <- managed_host_effect_requires_provider(pending_request.kind)
            if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryFull or (controller.engine.engine_error == DebuggerReplayEngine::EngineError.StepLimit and controller.engine.event_count >= DebuggerReplayEngine::replay_engine_history_capacity()):
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::HISTORY)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if host_effect_pending and not pending_request.valid
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HOST_EFFECT_REQUEST) if host_effect_pending
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable or controller.engine.engine_error == DebuggerReplayEngine::EngineError.StepLimit
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault
            return controller.last_error if not DebuggerErrors::error_is_ok(controller.last_error)
            return DebuggerErrors::no_error()

        def managed_step(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            original_machine: DebuggerEDIR::Machine = controller.engine.machine
            original_engine_error: DebuggerReplayEngine::EngineError = controller.engine.engine_error
            before_event: usize = controller.engine.event_count
            next_session: DebuggerSession::Session = DebuggerSession::session_step(controller.session)
            if next_session.last_error != DebuggerSession::SessionError.None:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if next_session.last_error == DebuggerSession::SessionError.HistoryUnavailable
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if next_session.last_error == DebuggerSession::SessionError.Unsupported
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
            pending_request: HostEffectRequest = managed_host_effect_request(controller)
            if pending_request.kind == HostEffectKind.VirtualFileReadByte:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if not pending_request.valid
                resource_failure: DebuggerErrors::DebuggerError = managed_record_virtual_file_read(controller)
                return resource_failure if not DebuggerErrors::error_is_ok(resource_failure)
            elif pending_request.kind != HostEffectKind.None:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if not pending_request.valid
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HOST_EFFECT_REQUEST)
            else:
                DebuggerReplayEngine::replay_engine_step(controller.engine)
            if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault:
                # A faulting EDIR instruction is still recorded as an event.
                # Keep the session coordinate and generation-scoped handles in
                # sync with that committed state change.
                if controller.engine.event_count > before_event:
                    controller.session <- next_session
                    if controller.session.last_error != DebuggerSession::SessionError.None:
                        controller.engine.machine <- original_machine
                        controller.engine.event_count <- before_event
                        controller.engine.engine_error <- original_engine_error
                        return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
                    managed_sync_position(controller)
                    managed_refresh_values(controller)
                else:
                    managed_sync_position(controller)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count == before_event
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable
            controller.session <- next_session
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryFull
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault
            return DebuggerErrors::no_error()

        # Integration layers can consume this typed result without depending
        # on private error-detail values to recognize a host-provider yield.
        def managed_continue_with_outcome(controller: mutable ManagedController&, max_steps: u64) -> ExecutionOutcome:
            failure: DebuggerErrors::DebuggerError = managed_continue(controller, max_steps)
            return managed_execution_outcome(controller, failure)

        def managed_step_with_outcome(controller: mutable ManagedController&) -> ExecutionOutcome:
            failure: DebuggerErrors::DebuggerError = managed_step(controller)
            return managed_execution_outcome(controller, failure)

        def managed_step_into_with_outcome(controller: mutable ManagedController&) -> ExecutionOutcome:
            controller.log_output_length <- Logpoint::FIRST_INDEX
            controller.last_error <- DebuggerErrors::no_error()
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if not DebuggerSession::session_can_inspect(controller.session):
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
                return managed_execution_outcome(controller, failure)
            initial_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            initial_depth: usize = controller.engine.machine.return_stack_pointer
            initial_event: usize = controller.engine.event_count
            reached_boundary: mutable bool = false
            failure <- managed_step(controller)
            return managed_execution_outcome(controller, failure) if not DebuggerErrors::error_is_ok(failure)
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event < Step::COMPOUND_LIMIT:
                current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
                entered_callee: bool = controller.engine.machine.return_stack_pointer > initial_depth
                source_changed: bool = not managed_source_position_matches(initial_source, current_source)
                if entered_callee or source_changed:
                    reached_boundary <- true
                    _ = managed_breakpoint_should_stop(controller)
                    break
                failure <- managed_step(controller)
                return managed_execution_outcome(controller, failure) if not DebuggerErrors::error_is_ok(failure)
            if not reached_boundary and not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event >= Step::COMPOUND_LIMIT:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            failure <- controller.last_error if DebuggerErrors::error_is_ok(failure) and not DebuggerErrors::error_is_ok(controller.last_error)
            return managed_execution_outcome(controller, failure)

        def managed_step_over_with_outcome(controller: mutable ManagedController&) -> ExecutionOutcome:
            controller.log_output_length <- Logpoint::FIRST_INDEX
            controller.last_error <- DebuggerErrors::no_error()
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if not DebuggerSession::session_can_inspect(controller.session):
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
                return managed_execution_outcome(controller, failure)
            if controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count:
                failure <- managed_step(controller)
                return managed_execution_outcome(controller, failure)
            initial_instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
            initial_source: DebuggerIdentity::SourceSpan = initial_instruction.source
            initial_depth: usize = controller.engine.machine.return_stack_pointer
            initial_event: usize = controller.engine.event_count
            hit_breakpoint: mutable bool = false
            failure <- managed_step(controller)
            return managed_execution_outcome(controller, failure) if not DebuggerErrors::error_is_ok(failure)
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event < Step::COMPOUND_LIMIT:
                current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
                call_is_active: bool = initial_instruction.opcode == DebuggerEDIR::Opcode.Call and controller.engine.machine.return_stack_pointer > initial_depth
                same_source_position: bool = managed_source_position_matches(initial_source, current_source)
                if managed_compound_breakpoint_should_stop(controller, initial_source):
                    hit_breakpoint <- true
                    break
                break if not call_is_active and not same_source_position
                failure <- managed_step(controller)
                return managed_execution_outcome(controller, failure) if not DebuggerErrors::error_is_ok(failure)
            call_is_active_after_limit: bool = initial_instruction.opcode == DebuggerEDIR::Opcode.Call and controller.engine.machine.return_stack_pointer > initial_depth
            source_position_unchanged_after_limit: bool = managed_source_position_matches(initial_source, managed_current_source(controller))
            if not hit_breakpoint and not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event >= Step::COMPOUND_LIMIT and (call_is_active_after_limit or source_position_unchanged_after_limit):
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            failure <- controller.last_error if DebuggerErrors::error_is_ok(failure) and not DebuggerErrors::error_is_ok(controller.last_error)
            return managed_execution_outcome(controller, failure)

        def managed_step_out_with_outcome(controller: mutable ManagedController&) -> ExecutionOutcome:
            controller.log_output_length <- Logpoint::FIRST_INDEX
            controller.last_error <- DebuggerErrors::no_error()
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if not DebuggerSession::session_can_inspect(controller.session):
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
                return managed_execution_outcome(controller, failure)
            initial_depth: usize = controller.engine.machine.return_stack_pointer
            initial_event: usize = controller.engine.event_count
            initial_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            hit_breakpoint: mutable bool = false
            failure <- managed_step(controller)
            return managed_execution_outcome(controller, failure) if not DebuggerErrors::error_is_ok(failure)
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event < Step::COMPOUND_LIMIT:
                if managed_compound_breakpoint_should_stop(controller, initial_source):
                    hit_breakpoint <- true
                    break
                break if initial_depth > 0 and controller.engine.machine.return_stack_pointer < initial_depth
                failure <- managed_step(controller)
                return managed_execution_outcome(controller, failure) if not DebuggerErrors::error_is_ok(failure)
            frame_has_not_returned: bool = initial_depth == 0 or controller.engine.machine.return_stack_pointer >= initial_depth
            if not hit_breakpoint and not controller.engine.machine.halted and not controller.engine.machine.faulted and frame_has_not_returned and controller.engine.event_count - initial_event >= Step::COMPOUND_LIMIT:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            failure <- controller.last_error if DebuggerErrors::error_is_ok(failure) and not DebuggerErrors::error_is_ok(controller.last_error)
            return managed_execution_outcome(controller, failure)

        def managed_step_into(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            controller.log_output_length <- Logpoint::FIRST_INDEX
            controller.last_error <- DebuggerErrors::no_error()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            initial_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            initial_depth: usize = controller.engine.machine.return_stack_pointer
            initial_event: usize = controller.engine.event_count
            reached_boundary: mutable bool = false
            failure: mutable DebuggerErrors::DebuggerError = managed_step(controller)
            return failure if not DebuggerErrors::error_is_ok(failure)
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event < Step::COMPOUND_LIMIT:
                current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
                entered_callee: bool = controller.engine.machine.return_stack_pointer > initial_depth
                source_changed: bool = not managed_source_position_matches(initial_source, current_source)
                if entered_callee or source_changed:
                    reached_boundary <- true
                    _ = managed_breakpoint_should_stop(controller)
                    break
                failure <- managed_step(controller)
                return failure if not DebuggerErrors::error_is_ok(failure)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not reached_boundary and not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event >= Step::COMPOUND_LIMIT
            return controller.last_error if not DebuggerErrors::error_is_ok(controller.last_error)
            return DebuggerErrors::no_error()

        def managed_step_over(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            controller.log_output_length <- Logpoint::FIRST_INDEX
            controller.last_error <- DebuggerErrors::no_error()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            return managed_step(controller) if controller.engine.machine.program_counter >= controller.engine.image.program.instruction_count
            initial_instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
            initial_source: DebuggerIdentity::SourceSpan = initial_instruction.source
            initial_depth: usize = controller.engine.machine.return_stack_pointer
            initial_event: usize = controller.engine.event_count
            hit_breakpoint: mutable bool = false
            failure: mutable DebuggerErrors::DebuggerError = managed_step(controller)
            return failure if not DebuggerErrors::error_is_ok(failure)
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event < Step::COMPOUND_LIMIT:
                current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
                call_is_active: bool = initial_instruction.opcode == DebuggerEDIR::Opcode.Call and controller.engine.machine.return_stack_pointer > initial_depth
                same_source_position: bool = managed_source_position_matches(initial_source, current_source)
                if managed_compound_breakpoint_should_stop(controller, initial_source):
                    hit_breakpoint <- true
                    break
                # A breakpoint at the destination boundary takes precedence
                # over completing the source step at that same position.
                # Stay in the original source span, or in a called frame,
                # until a boundary or breakpoint.
                break if not call_is_active and not same_source_position
                failure <- managed_step(controller)
                return failure if not DebuggerErrors::error_is_ok(failure)
            call_is_active_after_limit: bool = initial_instruction.opcode == DebuggerEDIR::Opcode.Call and controller.engine.machine.return_stack_pointer > initial_depth
            source_position_unchanged_after_limit: bool = managed_source_position_matches(initial_source, managed_current_source(controller))
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not hit_breakpoint and not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event >= Step::COMPOUND_LIMIT and (call_is_active_after_limit or source_position_unchanged_after_limit)
            return controller.last_error if not DebuggerErrors::error_is_ok(controller.last_error)
            return DebuggerErrors::no_error()

        def managed_step_out(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            controller.log_output_length <- Logpoint::FIRST_INDEX
            controller.last_error <- DebuggerErrors::no_error()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            initial_depth: usize = controller.engine.machine.return_stack_pointer
            initial_event: usize = controller.engine.event_count
            initial_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            hit_breakpoint: mutable bool = false
            failure: mutable DebuggerErrors::DebuggerError = managed_step(controller)
            return failure if not DebuggerErrors::error_is_ok(failure)
            while not controller.engine.machine.halted and not controller.engine.machine.faulted and controller.engine.event_count - initial_event < Step::COMPOUND_LIMIT:
                if managed_compound_breakpoint_should_stop(controller, initial_source):
                    hit_breakpoint <- true
                    break
                break if initial_depth > 0 and controller.engine.machine.return_stack_pointer < initial_depth
                failure <- managed_step(controller)
                return failure if not DebuggerErrors::error_is_ok(failure)
            frame_has_not_returned: bool = initial_depth == 0 or controller.engine.machine.return_stack_pointer >= initial_depth
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not hit_breakpoint and not controller.engine.machine.halted and not controller.engine.machine.faulted and frame_has_not_returned and controller.engine.event_count - initial_event >= Step::COMPOUND_LIMIT
            return controller.last_error if not DebuggerErrors::error_is_ok(controller.last_error)
            return DebuggerErrors::no_error()

    private:
        def managed_execution_outcome(controller: ManagedController&, failure: DebuggerErrors::DebuggerError) -> ExecutionOutcome:
            request: HostEffectRequest = managed_host_effect_request(controller)
            current_branch: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64())
            breakpoint_reported_here: bool = controller.has_last_breakpoint_stop and controller.last_breakpoint_event == controller.engine.event_count.u64() and controller.last_breakpoint_instruction == controller.engine.machine.program_counter and controller.last_breakpoint_branch.value == current_branch.value
            kind: mutable ExecutionOutcomeKind = ExecutionOutcomeKind.Completed
            kind <- ExecutionOutcomeKind.AwaitingHostEffect if request.valid and managed_host_effect_requires_provider(request.kind) and (failure.detail == Detail::HOST_EFFECT_REQUEST or not breakpoint_reported_here)
            kind <- ExecutionOutcomeKind.Failed if not DebuggerErrors::error_is_ok(failure) and kind != ExecutionOutcomeKind.AwaitingHostEffect
            return ExecutionOutcome{kind: kind, position: DebuggerReplayEngine::replay_engine_position(controller.engine), host_effect: request, failure: failure}

        def managed_clock_effect_replay_failure(failure: DebuggerErrors::DebuggerError) -> DebuggerEffects::EffectReplay:
            return DebuggerEffects::EffectReplay{accepted: false, result_hash: HostEffectReplayDefaults::NO_RESULT_HASH, result_value: HostEffectReplayDefaults::NO_CLOCK_VALUE, suppress_external_write: HostEffectReplayDefaults::DO_NOT_SUPPRESS_EXTERNAL_WRITE, failure: failure}

        def managed_random_effect_replay_failure(failure: DebuggerErrors::DebuggerError) -> DebuggerEffects::RandomEffectReplay:
            return DebuggerEffects::RandomEffectReplay{accepted: false, result_hash: HostEffectReplayDefaults::NO_RESULT_HASH, value: HostEffectReplayDefaults::NO_RANDOM_VALUE, suppress_external_write: HostEffectReplayDefaults::DO_NOT_SUPPRESS_EXTERNAL_WRITE, failure: failure}

        def managed_console_output_replay_failure(failure: DebuggerErrors::DebuggerError) -> DebuggerEffects::EffectReplay:
            return DebuggerEffects::EffectReplay{accepted: false, result_hash: HostEffectReplayDefaults::NO_RESULT_HASH, result_value: HostEffectReplayDefaults::NO_CLOCK_VALUE, suppress_external_write: HostEffectReplayDefaults::DO_NOT_SUPPRESS_EXTERNAL_WRITE, failure: failure}

        def managed_console_input_replay_failure(failure: DebuggerErrors::DebuggerError) -> DebuggerEffects::EffectReplay:
            return DebuggerEffects::EffectReplay{accepted: false, result_hash: HostEffectReplayDefaults::NO_RESULT_HASH, result_value: HostEffectReplayDefaults::NO_CLOCK_VALUE, suppress_external_write: HostEffectReplayDefaults::DO_NOT_SUPPRESS_EXTERNAL_WRITE, failure: failure}

        def managed_host_effect_preflight(controller: mutable ManagedController&, kind: HostEffectKind) -> DebuggerErrors::DebuggerError:
            running_virtual_read: bool = kind == HostEffectKind.VirtualFileReadByte and controller.session.state == DebuggerSession::SessionState.Running
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session) and not running_virtual_read
            request: HostEffectRequest = managed_host_effect_request(controller)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HOST_EFFECT_REQUEST) if not request.valid or request.kind != kind
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::HISTORY) if controller.engine.event_count >= DebuggerReplayEngine::replay_engine_history_capacity()
            verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(controller.engine.image)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT) if not verification.valid
            instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
            candidate_machine: mutable DebuggerEDIR::Machine = controller.engine.machine
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerEDIR::machine_step_effect_result(candidate_machine, instruction, ManagedEffectStep::NO_RESULT_BITS)
            if not running_virtual_read:
                next_session: DebuggerSession::Session = DebuggerSession::session_step(controller.session)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if next_session.last_error == DebuggerSession::SessionError.HistoryUnavailable
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if next_session.last_error == DebuggerSession::SessionError.Unsupported
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if next_session.last_error != DebuggerSession::SessionError.None
            return DebuggerErrors::no_error()

        def managed_restore_host_effect_engine_boundary(controller: mutable ManagedController&, event: usize, machine: DebuggerEDIR::Machine, engine_error: DebuggerReplayEngine::EngineError, snapshot: DebuggerCheckpoint::MachineSnapshot, envelope: DebuggerEvents::EventEnvelope, result_bits: u64, result_recorded: bool) -> void:
            controller.engine.machine <- machine
            controller.engine.event_count <- event
            controller.engine.engine_error <- engine_error
            controller.engine.history[event] <- snapshot
            controller.engine.events[event] <- envelope
            controller.engine.effect_result_bits[event] <- result_bits
            controller.engine.effect_result_recorded[event] <- result_recorded

        def managed_commit_host_effect(controller: mutable ManagedController&, candidate_state: DebuggerManagedState::State, result_bits: u64, kind: HostEffectKind) -> DebuggerErrors::DebuggerError:
            preflight: DebuggerErrors::DebuggerError = managed_host_effect_preflight(controller, kind)
            return preflight if not DebuggerErrors::error_is_ok(preflight)
            original_state: DebuggerManagedState::State = controller.state
            original_session: DebuggerSession::Session = controller.session
            original_machine: DebuggerEDIR::Machine = controller.engine.machine
            original_event_count: usize = controller.engine.event_count
            original_engine_error: DebuggerReplayEngine::EngineError = controller.engine.engine_error
            original_snapshot: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[original_event_count]
            original_event: DebuggerEvents::EventEnvelope = controller.engine.events[original_event_count]
            original_result_bits: u64 = controller.engine.effect_result_bits[original_event_count]
            original_result_recorded: bool = controller.engine.effect_result_recorded[original_event_count]
            engine_error: DebuggerReplayEngine::EngineError = DebuggerReplayEngine::replay_engine_step_effect_result(controller.engine, result_bits)
            if engine_error != DebuggerReplayEngine::EngineError.None:
                managed_restore_host_effect_engine_boundary(controller, original_event_count, original_machine, original_engine_error, original_snapshot, original_event, original_result_bits, original_result_recorded)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::HISTORY) if engine_error == DebuggerReplayEngine::EngineError.HistoryFull
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT)
            running_virtual_read: bool = kind == HostEffectKind.VirtualFileReadByte and controller.session.state == DebuggerSession::SessionState.Running
            next_session: mutable DebuggerSession::Session = controller.session
            if not running_virtual_read:
                next_session <- DebuggerSession::session_step(controller.session)
                if next_session.last_error != DebuggerSession::SessionError.None:
                    managed_restore_host_effect_engine_boundary(controller, original_event_count, original_machine, original_engine_error, original_snapshot, original_event, original_result_bits, original_result_recorded)
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT)
            controller.state <- candidate_state
            controller.session <- next_session
            controller.session.position <- DebuggerReplayEngine::replay_engine_position(controller.engine)
            controller.session.retained_last <- controller.session.position.event if controller.session.position.event > controller.session.retained_last
            managed_refresh_values(controller)
            if not managed_side_checkpoint_capture_current(controller):
                controller.state <- original_state
                controller.session <- original_session
                managed_restore_host_effect_engine_boundary(controller, original_event_count, original_machine, original_engine_error, original_snapshot, original_event, original_result_bits, original_result_recorded)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            return DebuggerErrors::no_error()

        # Engine history stores VM snapshots only. Until side-effect state is
        # restored at the same event boundary, moving the VM alone would
        # expose a mixed historical state to clients.
        def managed_history_has_unaligned_side_state(controller: mutable ManagedController&) -> bool:
            return true if not DebuggerManagedState::state_replay_is_exact(controller.state)
            return not managed_side_checkpoint_matches_current(controller)

        def managed_reverse_snapshot_is_valid(controller: mutable ManagedController&, event: usize) -> bool:
            return false if event >= controller.engine.event_count or event >= DebuggerReplayEngine::replay_engine_history_capacity()
            snapshot: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[event]
            return false if snapshot.id.value != event.u64() + Reverse::SNAPSHOT_ID_INCREMENT or snapshot.event != event.u64()
            return false if snapshot.program_counter >= controller.engine.image.program.instruction_count or snapshot.halted or snapshot.faulted
            return false if not DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
            return snapshot.state_hash == DebuggerCheckpoint::snapshot_state_hash(snapshot)

        def managed_reverse_snapshot_is_currently_same_frame(snapshot: DebuggerCheckpoint::MachineSnapshot&, frame_depth: usize, return_address: u64) -> bool:
            return false if snapshot.return_stack_pointer != frame_depth
            return true if frame_depth == Reverse::TOP_LEVEL_FRAME_DEPTH
            return snapshot.return_stack[frame_depth - Reverse::FRAME_DEPTH_INCREMENT] == return_address

        # The pre-call snapshot and the immediately following snapshot identify
        # one dynamic invocation. Stack depth distinguishes recursive calls to
        # the same EDIR instruction; the return address ties the active frame
        # to that call instead of matching by function or target PC alone.
        def managed_reverse_call_entry_matches(controller: mutable ManagedController&, event: usize, frame_depth: usize, return_address: u64) -> bool:
            return false if frame_depth == Reverse::TOP_LEVEL_FRAME_DEPTH or not managed_reverse_snapshot_is_valid(controller, event)
            before: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[event]
            return false if before.return_stack_pointer != frame_depth - Reverse::FRAME_DEPTH_INCREMENT
            instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[before.program_counter.usize()]
            return false if instruction.opcode != DebuggerEDIR::Opcode.Call or instruction.a < Reverse::MINIMUM_CALL_TARGET
            return false if before.program_counter + Reverse::CALL_RETURN_INCREMENT != return_address
            if event == controller.engine.event_count - Reverse::PREVIOUS_EVENT_INCREMENT:
                return false if controller.engine.machine.return_stack_pointer != frame_depth or controller.engine.machine.program_counter != instruction.a.u64()
                return controller.engine.machine.return_stack[frame_depth - Reverse::FRAME_DEPTH_INCREMENT] == return_address
            after_event: usize = event + Reverse::PREVIOUS_EVENT_INCREMENT
            return false if not managed_reverse_snapshot_is_valid(controller, after_event)
            after: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[after_event]
            return false if after.return_stack_pointer != frame_depth or after.program_counter != instruction.a.u64()
            return after.return_stack[frame_depth - Reverse::FRAME_DEPTH_INCREMENT] == return_address

    public:
        def managed_reverse_step_over(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count == Event::INITIAL_INDEX
            current_event: usize = controller.engine.event_count
            current_machine: DebuggerEDIR::Machine = controller.engine.machine
            current_snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(current_machine, DebuggerIdentity::debug_id(current_event.u64() + Reverse::SNAPSHOT_ID_INCREMENT), current_event.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not DebuggerCheckpoint::snapshot_shape_is_valid(current_snapshot) or current_snapshot.state_hash != DebuggerCheckpoint::snapshot_state_hash(current_snapshot)
            selected_depth: usize = current_machine.return_stack_pointer
            selected_return_address: mutable u64 = Reverse::NO_RETURN_ADDRESS
            if selected_depth > Reverse::TOP_LEVEL_FRAME_DEPTH:
                selected_return_address <- current_machine.return_stack[selected_depth - Reverse::FRAME_DEPTH_INCREMENT]
            current_source: DebuggerIdentity::SourceSpan = managed_current_source(controller)
            event: mutable usize = current_event
            while event > Event::INITIAL_INDEX:
                event <- event - Reverse::PREVIOUS_EVENT_INCREMENT
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not managed_reverse_snapshot_is_valid(controller, event)
                candidate: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[event]
                call_entry_matches: bool = managed_reverse_call_entry_matches(controller, event, selected_depth, selected_return_address)
                if candidate.return_stack_pointer < selected_depth:
                    return managed_seek(controller, event) if call_entry_matches
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
                if managed_reverse_snapshot_is_currently_same_frame(candidate, selected_depth, selected_return_address):
                    candidate_instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[candidate.program_counter.usize()]
                    if not managed_source_position_matches(current_source, candidate_instruction.source):
                        return managed_seek(controller, event)
                return managed_seek(controller, event) if call_entry_matches
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)

        def managed_reverse_step_out(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count == Event::INITIAL_INDEX
            current_event: usize = controller.engine.event_count
            current_machine: DebuggerEDIR::Machine = controller.engine.machine
            current_snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(current_machine, DebuggerIdentity::debug_id(current_event.u64() + Reverse::SNAPSHOT_ID_INCREMENT), current_event.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not DebuggerCheckpoint::snapshot_shape_is_valid(current_snapshot) or current_snapshot.state_hash != DebuggerCheckpoint::snapshot_state_hash(current_snapshot)
            selected_depth: usize = current_machine.return_stack_pointer
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if selected_depth == Reverse::TOP_LEVEL_FRAME_DEPTH
            selected_return_address: u64 = current_machine.return_stack[selected_depth - Reverse::FRAME_DEPTH_INCREMENT]
            event: mutable usize = current_event
            while event > Event::INITIAL_INDEX:
                event <- event - Reverse::PREVIOUS_EVENT_INCREMENT
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not managed_reverse_snapshot_is_valid(controller, event)
                candidate: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[event]
                call_entry_matches: bool = managed_reverse_call_entry_matches(controller, event, selected_depth, selected_return_address)
                return managed_seek(controller, event) if call_entry_matches
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if candidate.return_stack_pointer < selected_depth
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)

        def managed_reverse_continue(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            controller.last_error <- DebuggerErrors::no_error()
            steps: mutable u64 = 0
            while controller.engine.event_count > 0 and steps < Step::COMPOUND_LIMIT:
                failure: DebuggerErrors::DebuggerError = managed_reverse_step(controller)
                return failure if not DebuggerErrors::error_is_ok(failure)
                steps <- steps + 1
                if controller.engine.machine.program_counter < controller.engine.image.program.instruction_count:
                    instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[controller.engine.machine.program_counter.usize()]
                    event_branch: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64())
                    if managed_breakpoint_would_stop_at_instruction(controller, event_branch, instruction.source, controller.engine.machine.program_counter):
                        controller.has_last_breakpoint_stop <- true
                        controller.last_breakpoint_event <- controller.engine.event_count.u64()
                        controller.last_breakpoint_instruction <- controller.engine.machine.program_counter
                        controller.last_breakpoint_branch <- event_branch
                        return controller.last_error if not DebuggerErrors::error_is_ok(controller.last_error)
                        return DebuggerErrors::no_error()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count > 0
            return DebuggerErrors::no_error()

        def managed_reverse_step(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if controller.engine.event_count == Event::INITIAL_INDEX
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if managed_history_has_unaligned_side_state(controller)
            original_machine: DebuggerEDIR::Machine = controller.engine.machine
            original_event_count: usize = controller.engine.event_count
            original_engine_error: DebuggerReplayEngine::EngineError = controller.engine.engine_error
            target_event: usize = original_event_count - Reverse::PREVIOUS_EVENT_INCREMENT
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not managed_side_checkpoint_is_valid(controller, target_event)
            next_session: DebuggerSession::Session = DebuggerSession::session_reverse_step(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if next_session.last_error == DebuggerSession::SessionError.HistoryUnavailable
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if next_session.last_error == DebuggerSession::SessionError.Unsupported
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if next_session.last_error != DebuggerSession::SessionError.None
            DebuggerReplayEngine::replay_engine_reverse_one(controller.engine)
            if controller.engine.engine_error != DebuggerReplayEngine::EngineError.None:
                controller.engine.machine <- original_machine
                controller.engine.event_count <- original_event_count
                controller.engine.engine_error <- original_engine_error
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            if managed_side_checkpoint_at(controller, target_event).state_hash != DebuggerReplayEngine::replay_engine_state_hash(controller.engine):
                controller.engine.machine <- original_machine
                controller.engine.event_count <- original_event_count
                controller.engine.engine_error <- original_engine_error
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::HISTORY)
            failure: mutable DebuggerErrors::DebuggerError = managed_side_checkpoint_restore(controller, target_event)
            if not DebuggerErrors::error_is_ok(failure):
                controller.engine.machine <- original_machine
                controller.engine.event_count <- original_event_count
                controller.engine.engine_error <- original_engine_error
                return failure
            controller.session <- next_session
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_seek(controller: mutable ManagedController&, event: usize) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if managed_history_has_unaligned_side_state(controller)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if event.u64() != controller.session.position.event and controller.session.capabilities.history != DebuggerCapabilities::HistoryKind.Exact
            original_machine: DebuggerEDIR::Machine = controller.engine.machine
            original_event_count: usize = controller.engine.event_count
            original_engine_error: DebuggerReplayEngine::EngineError = controller.engine.engine_error
            next_session: mutable DebuggerSession::Session = controller.session
            next_session.retained_last <- event.u64() if event.u64() > next_session.retained_last
            next_session <- DebuggerSession::session_seek(next_session, event.u64())
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if next_session.last_error == DebuggerSession::SessionError.Unsupported
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if next_session.last_error == DebuggerSession::SessionError.HistoryUnavailable
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::ENGINE_FAULT) if next_session.last_error != DebuggerSession::SessionError.None
            if event != original_event_count and not managed_side_checkpoint_is_valid(controller, event):
                if event > original_event_count:
                    preview_error: DebuggerReplayEngine::EngineError = DebuggerReplayEngine::replay_engine_seek_preview(controller.engine, event)
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT) if preview_error == DebuggerReplayEngine::EngineError.ExecutionFault
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            DebuggerReplayEngine::replay_engine_seek(controller.engine, event)
            if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault:
                # Restore the caller-visible engine state before surfacing the
                # failed speculative seek as a divergence.
                controller.engine.machine <- original_machine
                controller.engine.event_count <- original_event_count
                controller.engine.engine_error <- original_engine_error
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ENGINE_FAULT)
            if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable:
                controller.engine.machine <- original_machine
                controller.engine.event_count <- original_event_count
                controller.engine.engine_error <- original_engine_error
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            if event != original_event_count:
                if not managed_side_checkpoint_is_valid(controller, event):
                    controller.engine.machine <- original_machine
                    controller.engine.event_count <- original_event_count
                    controller.engine.engine_error <- original_engine_error
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
                if managed_side_checkpoint_at(controller, event).state_hash != DebuggerReplayEngine::replay_engine_state_hash(controller.engine):
                    controller.engine.machine <- original_machine
                    controller.engine.event_count <- original_event_count
                    controller.engine.engine_error <- original_engine_error
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::HISTORY)
                failure: mutable DebuggerErrors::DebuggerError = managed_side_checkpoint_restore(controller, event)
                if not DebuggerErrors::error_is_ok(failure):
                    controller.engine.machine <- original_machine
                    controller.engine.event_count <- original_event_count
                    controller.engine.engine_error <- original_engine_error
                    return failure
            # Commit the preflighted session only after the engine reached the
            # requested boundary. This keeps an unsuccessful seek atomic.
            controller.session <- next_session
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_replace_source_breakpoints(controller: mutable ManagedController&, source: DebuggerIdentity::DebugId, lines: u32&, requested_count: usize) -> DebuggerBreakpointManager::BreakpointReplacement:
            columns: mutable u32[SourceBreakpoint::ENGINE_MANAGED_SOURCE_BREAKPOINT_CAPACITY] = zeroed
            has_columns: mutable bool[SourceBreakpoint::ENGINE_MANAGED_SOURCE_BREAKPOINT_CAPACITY] = zeroed
            return managed_replace_source_breakpoints_with_columns(controller, source, lines, columns[SourceBreakpoint::ENGINE_MANAGED_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], has_columns[SourceBreakpoint::ENGINE_MANAGED_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], requested_count)

        def managed_replace_source_breakpoints_with_columns(controller: mutable ManagedController&, source: DebuggerIdentity::DebugId, lines: u32&, columns: u32&, has_columns: bool&, requested_count: usize) -> DebuggerBreakpointManager::BreakpointReplacement:
            return zeroed if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or controller.engine.machine.faulted
            replacement: mutable DebuggerBreakpointManager::BreakpointReplacement = DebuggerBreakpointManager::breakpoint_table_replace_source_with_columns(controller.state.breakpoints, source, controller.engine.branch, lines, columns, has_columns, requested_count)
            return replacement if not replacement.accepted
            for request_index in 0..<replacement.count:
                requested_line: u32 = replacement.results[request_index].line
                requested_column: u32 = replacement.results[request_index].column
                has_requested_column: bool = replacement.results[request_index].has_column
                resolved: mutable bool = false
                resolved_column: mutable u32 = SourceBreakpoint::ENGINE_MANAGED_SOURCE_BREAKPOINT_NO_COLUMN
                resolved_instruction: mutable u64 = Identity::ENGINE_MANAGED_IDENTITY_NO_INSTRUCTION
                for instruction_index in 0..<controller.engine.image.program.instruction_count.usize():
                    span: DebuggerIdentity::SourceSpan = controller.engine.image.instructions[instruction_index].source
                    if DebuggerMetadata::source_span_is_valid(span) and span.file.value == source.value and requested_line >= span.start_line and requested_line <= span.end_line:
                        candidate_column: mutable u32 = SourceBreakpoint::ENGINE_MANAGED_SOURCE_BREAKPOINT_NO_COLUMN
                        candidate_column <- requested_column if has_requested_column
                        candidate_column <- span.start_column if not has_requested_column and requested_line == span.start_line
                        candidate_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: source, line: requested_line, column: candidate_column, discriminator: 0}
                        if DebuggerMetadata::source_span_contains(span, candidate_location) and (not resolved or (not has_requested_column and candidate_column < resolved_column)):
                            resolved <- true
                            resolved_column <- candidate_column
                            resolved_instruction <- instruction_index.u64()
                if resolved:
                    for breakpoint_index in 0..<controller.state.breakpoints.count:
                        if controller.state.breakpoints.points[breakpoint_index].id.value == replacement.results[request_index].id.value:
                            controller.state.breakpoints.points[breakpoint_index].source.column <- resolved_column
                            replacement.results[request_index].column <- resolved_column if not has_requested_column
                    DebuggerBreakpointManager::breakpoint_table_resolve_at_instruction(controller.state.breakpoints, replacement.results[request_index].id, resolved_instruction)
                    replacement.results[request_index].verified <- true
            return replacement

        def managed_replace_function_breakpoints(controller: mutable ManagedController&, names: u8&, text_length: usize, name_offsets: usize&, name_lengths: usize&, requested_count: usize) -> DebuggerBreakpointManager::BreakpointReplacement:
            replacement: mutable DebuggerBreakpointManager::BreakpointReplacement = zeroed
            return replacement if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or controller.engine.machine.faulted
            return replacement if not DebuggerBreakpointManager::breakpoint_table_is_valid(controller.state.breakpoints)
            return replacement if requested_count > DebuggerBreakpointManager::breakpoint_table_capacity()
            original_count: usize = controller.state.breakpoints.count
            retained_count: mutable usize = FunctionBreakpoint::NO_TEXT_BYTES
            for index in 0..<original_count:
                retained_count <- retained_count + FunctionBreakpoint::COUNT_INCREMENT if controller.state.breakpoints.points[index].kind != DebuggerBreakpoints::BreakpointKind.Function
            return replacement if retained_count > DebuggerBreakpointManager::breakpoint_table_capacity() or requested_count > DebuggerBreakpointManager::breakpoint_table_capacity() - retained_count
            return replacement if not DebuggerBreakpointManager::breakpoint_table_can_allocate_ids(controller.state.breakpoints, requested_count)
            for request_index in 0..<requested_count:
                return replacement if name_lengths[request_index] == FunctionBreakpoint::NO_TEXT_BYTES or name_lengths[request_index] > DebuggerBreakpoints::breakpoint_function_name_capacity()
                return replacement if name_offsets[request_index] > text_length or name_lengths[request_index] > text_length - name_offsets[request_index]
                preflight: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(controller.engine.image, names[name_offsets[request_index]], name_lengths[request_index])
                return replacement if preflight.status == DebuggerMetadata::BreakpointResolution.Invalid
            controller.state.breakpoints.count <- FunctionBreakpoint::NO_TEXT_BYTES
            for index in 0..<original_count:
                point: DebuggerBreakpoints::Breakpoint = controller.state.breakpoints.points[index]
                if point.kind != DebuggerBreakpoints::BreakpointKind.Function:
                    controller.state.breakpoints.points[controller.state.breakpoints.count] <- point
                    controller.state.breakpoints.resolved_instructions[controller.state.breakpoints.count] <- controller.state.breakpoints.resolved_instructions[index]
                    controller.state.breakpoints.count <- controller.state.breakpoints.count + FunctionBreakpoint::COUNT_INCREMENT
            for request_index in 0..<requested_count:
                name_offset: usize = name_offsets[request_index]
                name_length: usize = name_lengths[request_index]
                resolution: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(controller.engine.image, names[name_offset], name_length)
                breakpoint_id: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(controller.state.breakpoints.next_id)
                point: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::Breakpoint{
                    id: breakpoint_id,
                    branch: controller.engine.branch,
                    kind: DebuggerBreakpoints::BreakpointKind.Function,
                    status: DebuggerBreakpoints::BreakpointStatus.Pending,
                    source: zeroed,
                    condition: DebuggerIdentity::debug_id(FunctionBreakpoint::NO_BREAKPOINT_ID),
                    condition_expression: zeroed,
                    condition_length: FunctionBreakpoint::NO_CONDITION_LENGTH,
                    function_name: zeroed,
                    function_name_length: name_length,
                    log_message: zeroed,
                    log_message_length: FunctionBreakpoint::NO_TEXT_BYTES,
                    hit_target: FunctionBreakpoint::NO_HIT_TARGET,
                    hit_count: FunctionBreakpoint::NO_HIT_COUNT,
                    hit_stride: FunctionBreakpoint::DEFAULT_HIT_STRIDE,
                    task: DebuggerIdentity::debug_id(FunctionBreakpoint::NO_TASK),
                    logpoint: false,
                    temporary: false
                }
                for name_index in 0..<name_length:
                    point.function_name[name_index] <- names[name_offset + name_index]
                table_index: usize = controller.state.breakpoints.count
                controller.state.breakpoints.points[table_index] <- point
                controller.state.breakpoints.resolved_instructions[table_index] <- Identity::ENGINE_MANAGED_IDENTITY_NO_INSTRUCTION
                replacement.results[request_index] <- DebuggerBreakpointManager::BreakpointResult{id: breakpoint_id, line: FunctionBreakpoint::NO_SOURCE_LINE, column: FunctionBreakpoint::NO_SOURCE_COLUMN, has_column: false, verified: false}
                if resolution.matched > FunctionBreakpoint::NO_TEXT_BYTES:
                    controller.state.breakpoints.points[table_index].status <- DebuggerBreakpoints::BreakpointStatus.Verified
                    controller.state.breakpoints.resolved_instructions[table_index] <- resolution.instruction
                    replacement.results[request_index].verified <- true
                controller.state.breakpoints.count <- controller.state.breakpoints.count + FunctionBreakpoint::COUNT_INCREMENT
                controller.state.breakpoints.next_id <- controller.state.breakpoints.next_id + FunctionBreakpoint::ID_INCREMENT
            replacement.count <- requested_count
            replacement.accepted <- true
            return replacement

        def managed_source_root_is_valid(root: u8&, root_length: usize) -> bool:
            return false if root_length < SourcePath::ROOT_MINIMUM_LENGTH or root_length > DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
            return false if not DebuggerMetadata::source_path_utf8_is_valid(root, root_length)
            windows_drive_root: bool = root_length >= SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH and root[SourcePath::ROOT_COLON_INDEX] == SourcePath::ROOT_COLON and (root[SourcePath::ROOT_SLASH_INDEX] == SourcePath::SLASH or root[SourcePath::ROOT_SLASH_INDEX] == SourcePath::BACKSLASH)
            windows_unc_root: bool = root_length >= SourcePath::UNC_PREFIX_LENGTH and (root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::SLASH or root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::BACKSLASH) and (root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::SLASH or root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::BACKSLASH)
            rooted_path: bool = root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::SLASH or root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::BACKSLASH
            return false if not rooted_path and not windows_drive_root
            segment_start: mutable usize = SourcePath::ROOT_MINIMUM_LENGTH if rooted_path else SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH
            segment_start <- SourcePath::UNC_PREFIX_LENGTH if windows_unc_root
            return true if root_length == segment_start and not windows_unc_root
            unc_separator_count: mutable usize = 0
            for index in segment_start..<root_length:
                return false if root[index] <= SourcePath::ASCII_CONTROL_MAX or root[index] == SourcePath::ENGINE_MANAGED_SOURCE_PATH_ASCII_DELETE
                if root[index] == SourcePath::SLASH or root[index] == SourcePath::BACKSLASH:
                    segment_length: usize = index - segment_start
                    return false if segment_length == 0 or (segment_length == SourcePath::SINGLE_DOT_SEGMENT_LENGTH and root[segment_start] == SourcePath::DOT)
                    return false if segment_length == SourcePath::PARENT_SEGMENT_LENGTH and root[segment_start] == SourcePath::DOT and root[segment_start + SourcePath::TRAILING_BYTE_OFFSET] == SourcePath::DOT
                    unc_separator_count <- unc_separator_count + SourcePath::UNC_SEPARATOR_INCREMENT if windows_unc_root
                    segment_start <- index + SourcePath::TRAILING_BYTE_OFFSET
            final_segment_length: usize = root_length - segment_start
            return false if final_segment_length == 0 or (final_segment_length == SourcePath::SINGLE_DOT_SEGMENT_LENGTH and root[segment_start] == SourcePath::DOT)
            return false if final_segment_length == SourcePath::PARENT_SEGMENT_LENGTH and root[segment_start] == SourcePath::DOT and root[segment_start + SourcePath::TRAILING_BYTE_OFFSET] == SourcePath::DOT
            return false if windows_unc_root and unc_separator_count < SourcePath::UNC_MINIMUM_SEPARATORS
            return true

        def managed_source_path_root_is_valid(root: u8&, root_length: usize) -> bool:
            return false if root_length < SourcePath::ROOT_MINIMUM_LENGTH or root_length > DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
            windows_drive_root: bool = root_length >= SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH and root[SourcePath::ROOT_COLON_INDEX] == SourcePath::ROOT_COLON and (root[SourcePath::ROOT_SLASH_INDEX] == SourcePath::SLASH or root[SourcePath::ROOT_SLASH_INDEX] == SourcePath::BACKSLASH)
            windows_unc_root: bool = root_length >= SourcePath::UNC_PREFIX_LENGTH and (root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::SLASH or root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::BACKSLASH) and (root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::SLASH or root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::BACKSLASH)
            minimum_root_length: mutable usize = SourcePath::ROOT_MINIMUM_LENGTH if not windows_drive_root else SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH
            minimum_root_length <- SourcePath::UNC_PREFIX_LENGTH if windows_unc_root
            normalized_length: mutable usize = root_length
            while normalized_length > minimum_root_length and (root[normalized_length - SourcePath::TRAILING_BYTE_OFFSET] == SourcePath::SLASH or root[normalized_length - SourcePath::TRAILING_BYTE_OFFSET] == SourcePath::BACKSLASH):
                normalized_length <- normalized_length - SourcePath::TRAILING_BYTE_OFFSET
            return managed_source_root_is_valid(root, normalized_length)

        def managed_set_source_path_root(controller: mutable ManagedController&, root: u8&, root_length: usize) -> bool:
            return false if root_length == SourcePath::ROOT_DISABLED_LENGTH or root_length > DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
            candidate_root: mutable u8[DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY] = zeroed
            normalized_length: mutable usize = root_length
            for index in 0..<root_length:
                candidate_root[index] <- SourcePath::SLASH if root[index] == SourcePath::BACKSLASH else root[index]
            windows_drive_root: bool = normalized_length >= SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH and candidate_root[SourcePath::ROOT_COLON_INDEX] == SourcePath::ROOT_COLON and candidate_root[SourcePath::ROOT_SLASH_INDEX] == SourcePath::SLASH
            windows_unc_root: bool = normalized_length >= SourcePath::UNC_PREFIX_LENGTH and candidate_root[SourcePath::ROOT_INITIAL_INDEX] == SourcePath::SLASH and candidate_root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::SLASH
            return false if candidate_root[SourcePath::ROOT_INITIAL_INDEX] != SourcePath::SLASH and not windows_drive_root
            minimum_root_length: mutable usize = SourcePath::WINDOWS_ROOT_MINIMUM_LENGTH if windows_drive_root else SourcePath::ROOT_MINIMUM_LENGTH
            minimum_root_length <- SourcePath::UNC_PREFIX_LENGTH if windows_unc_root
            while normalized_length > minimum_root_length and candidate_root[normalized_length - SourcePath::TRAILING_BYTE_OFFSET] == SourcePath::SLASH:
                normalized_length <- normalized_length - SourcePath::TRAILING_BYTE_OFFSET
            return false if not managed_source_root_is_valid(candidate_root[0], normalized_length)
            for index in 0..<normalized_length:
                controller.source_path_root[index] <- candidate_root[index]
            controller.source_path_root_length <- normalized_length
            return true

        def managed_source_root_is_windows(root: u8&, root_length: usize) -> bool:
            return root[SourcePath::ROOT_INITIAL_INDEX] != SourcePath::SLASH or (root_length >= SourcePath::UNC_PREFIX_LENGTH and root[SourcePath::UNC_SECOND_SLASH_INDEX] == SourcePath::SLASH)

        def managed_source_path_ascii_lower(byte: u8) -> u8:
            return byte + SourcePath::ASCII_CASE_OFFSET if byte >= SourcePath::ENGINE_MANAGED_SOURCE_PATH_ASCII_UPPER_A and byte <= SourcePath::ENGINE_MANAGED_SOURCE_PATH_ASCII_UPPER_Z
            return byte

        def managed_source_path_byte_matches(client_byte: u8, metadata_byte: u8, windows_path: bool) -> bool:
            return true if client_byte == metadata_byte
            return managed_source_path_ascii_lower(client_byte) == managed_source_path_ascii_lower(metadata_byte) if windows_path
            return false

        def managed_source_file_id_for_path(controller: mutable ManagedController&, path: u8&, path_length: usize) -> DebuggerIdentity::DebugId:
            return DebuggerIdentity::debug_id(Identity::NO_SOURCE_FILE) if path_length == SourcePath::MANAGED_SOURCE_PATH_EMPTY_LENGTH or path_length > DebuggerMetadataSourcePath::MAPPED_SOURCE_PATH_CAPACITY
            return DebuggerIdentity::debug_id(Identity::NO_SOURCE_FILE) if controller.engine.image.source_file_count > DebuggerEDIR::source_file_capacity()
            matched_id: mutable DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Identity::NO_SOURCE_FILE)
            relative_start: mutable usize = 0
            relative_length: mutable usize = path_length
            windows_path: mutable bool = false
            if controller.source_path_root_length > SourcePath::ROOT_DISABLED_LENGTH:
                root_length: usize = controller.source_path_root_length
                windows_path <- managed_source_root_is_windows(controller.source_path_root[0], root_length)
                same_root: mutable bool = path_length > root_length
                if path_length >= root_length:
                    for byte_index in 0..<root_length:
                        client_byte: u8 = SourcePath::SLASH if path[byte_index] == SourcePath::BACKSLASH else path[byte_index]
                        same_root <- false if not managed_source_path_byte_matches(client_byte, controller.source_path_root[byte_index], windows_path)
                else:
                    same_root <- false
                root_has_separator: bool = controller.source_path_root[root_length - 1] == SourcePath::SLASH
                if same_root:
                    if root_has_separator:
                        relative_start <- root_length
                        relative_length <- path_length - root_length
                    else:
                        if path[root_length] == SourcePath::SLASH or path[root_length] == SourcePath::BACKSLASH:
                            relative_start <- root_length + 1
                            relative_length <- path_length - relative_start
            for file_index in 0..<controller.engine.image.source_file_count:
                file: DebuggerMetadata::SourceFile = controller.engine.image.source_files[file_index]
                continue if file.path_length != relative_length
                same_path: mutable bool = true
                for byte_index in 0..<relative_length:
                    client_byte: u8 = SourcePath::SLASH if path[relative_start + byte_index] == SourcePath::BACKSLASH else path[relative_start + byte_index]
                    same_path <- false if not managed_source_path_byte_matches(client_byte, file.path_bytes[byte_index], windows_path)
                if same_path:
                    return DebuggerIdentity::debug_id(Identity::NO_SOURCE_FILE) if matched_id.value != Identity::NO_SOURCE_FILE
                    matched_id <- file.id
            return matched_id

        def managed_source_file_id_is_known(controller: mutable ManagedController&, file_id: DebuggerIdentity::DebugId) -> bool:
            return false if file_id.value == Identity::NO_SOURCE_FILE or controller.engine.image.source_file_count > DebuggerEDIR::source_file_capacity()
            for file_index in 0..<controller.engine.image.source_file_count:
                return true if controller.engine.image.source_files[file_index].id.value == file_id.value
            return false

        def managed_set_source_breakpoint(controller: mutable ManagedController&, location: DebuggerMetadata::SourceLocation) -> DebuggerIdentity::DebugId:
            return DebuggerIdentity::debug_id(0) if not DebuggerMetadata::source_location_is_valid(location) or controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or controller.engine.machine.faulted
            point: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::Breakpoint{
                id: DebuggerIdentity::debug_id(0),
                branch: controller.engine.branch,
                kind: DebuggerBreakpoints::BreakpointKind.Source,
                status: DebuggerBreakpoints::BreakpointStatus.Pending,
                source: location,
                condition: DebuggerIdentity::debug_id(0),
                condition_expression: zeroed,
                condition_length: 0,
                function_name: zeroed,
                function_name_length: DebuggerBreakpoints::breakpoint_empty_function_name_length(),
                log_message: zeroed,
                log_message_length: 0,
                hit_target: 0,
                hit_count: 0,
                hit_stride: Value::NAME_OFFSET,
                task: DebuggerIdentity::debug_id(0),
                logpoint: false,
                temporary: false
            }
            next_id: u64 = controller.state.breakpoints.next_id
            added: bool = DebuggerBreakpointManager::breakpoint_table_add(controller.state.breakpoints, point)
            return DebuggerIdentity::debug_id(0) if not added
            for instruction_index in 0..<controller.engine.image.program.instruction_count.usize():
                span: DebuggerIdentity::SourceSpan = controller.engine.image.instructions[instruction_index].source
                if DebuggerMetadata::source_span_contains(span, location):
                    DebuggerBreakpointManager::breakpoint_table_resolve_at_instruction(controller.state.breakpoints, DebuggerIdentity::debug_id(next_id), instruction_index.u64())
                    break
            return DebuggerIdentity::debug_id(next_id)

        def managed_values(controller: mutable ManagedController&) -> DebuggerValueStore::ValueStore:
            return controller.state.values

        def managed_checkpoint(controller: mutable ManagedController&) -> DebuggerTraceBinary::ByteWriter:
            checkpoint_id: u64 = Checkpoint::ENGINE_MANAGED_CHECKPOINT_MAX_ID if controller.engine.event_count.u64() == Checkpoint::ENGINE_MANAGED_CHECKPOINT_MAX_ID else controller.engine.event_count.u64() + Checkpoint::ENGINE_MANAGED_CHECKPOINT_ID_OFFSET
            snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(controller.engine.machine, DebuggerIdentity::debug_id(checkpoint_id), controller.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))
            return DebuggerCheckpointCodec::checkpoint_encode(snapshot)

        def managed_full_checkpoint(controller: mutable ManagedController&) -> DebuggerFullCheckpoint::ManagedCheckpoint:
            image_fingerprint: DebuggerEDIRCodec::ArtifactFingerprint = DebuggerEDIRCodec::artifact_fingerprint(controller.engine.image)
            checkpoint_event: u64 = controller.engine.event_count.u64()
            # A child branch owns only the suffix after its fork. The timeline
            # coordinate before that fork still belongs to the ancestor, even
            # while the child remains the selected resumable branch.
            checkpoint_branch: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_branch_at(controller.engine, checkpoint_event)
            return DebuggerManagedState::state_capture(controller.state, controller.engine.machine, controller.session.build, image_fingerprint, controller.engine.recording, checkpoint_branch, checkpoint_event, DebuggerReplayEngine::replay_engine_state_hash(controller.engine))

        def managed_restore_full_checkpoint(controller: mutable ManagedController&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&) -> DebuggerErrors::DebuggerError:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::HISTORY) if not DebuggerSession::session_can_inspect(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, RestoreIdentityDetail::BUILD_MISMATCH) if not managed_build_identity_matches(checkpoint.build, controller.session.build)
            image_fingerprint: DebuggerEDIRCodec::ArtifactFingerprint = DebuggerEDIRCodec::artifact_fingerprint(controller.engine.image)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, RestoreIdentityDetail::IMAGE_MISMATCH) if not image_fingerprint.valid or checkpoint.image_fingerprint != image_fingerprint.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::ENGINE_FAULT) if checkpoint.recording.value != controller.engine.recording.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::HISTORY) if checkpoint.branch.value != DebuggerReplayEngine::replay_engine_branch_at(controller.engine, checkpoint.event).value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::ENGINE_FAULT) if checkpoint.machine.program_counter > controller.engine.image.program.instruction_count
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::ENGINE_FAULT) if checkpoint.machine.program_counter == controller.engine.image.program.instruction_count and not checkpoint.machine.halted
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if checkpoint.event > controller.engine.event_count.u64()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED) if checkpoint.event != controller.session.position.event and controller.session.capabilities.history != DebuggerCapabilities::HistoryKind.Exact
            expected_machine: mutable DebuggerEDIR::Machine = zeroed
            # History entries are pre-instruction snapshots. When the target
            # boundary has already been executed, its snapshot is authoritative
            # and includes any intervention installed at that boundary. A
            # checkpoint at the live boundary has no snapshot yet, so rebuild
            # it from the preceding snapshot, execute that instruction, and
            # then apply the live-boundary intervention before comparing state.
            if checkpoint.event < controller.engine.event_count.u64():
                historical_index: usize = checkpoint.event.usize()
                historical_snapshot: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[historical_index]
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if not DebuggerReplayEngine::replay_engine_snapshot_is_valid(controller.engine, historical_index, historical_snapshot)
                expected_machine <- DebuggerCheckpoint::snapshot_restore(historical_snapshot)
            else:
                if checkpoint.event == Event::INITIAL_INDEX.u64():
                    expected_machine <- DebuggerEDIR::machine_new()
                    if not DebuggerEDIR::verify_image(controller.engine.image).valid:
                        expected_machine.faulted <- true
                        expected_machine.halted <- true
                else:
                    previous_index: usize = checkpoint.event.usize() - Event::PREVIOUS_OFFSET
                    previous_snapshot: DebuggerCheckpoint::MachineSnapshot = controller.engine.history[previous_index]
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if not DebuggerReplayEngine::replay_engine_snapshot_is_valid(controller.engine, previous_index, previous_snapshot)
                    expected_machine <- DebuggerCheckpoint::snapshot_restore(previous_snapshot)
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if expected_machine.program_counter >= controller.engine.image.program.instruction_count
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if not DebuggerReplayEngine::replay_engine_apply_interventions_to_machine(controller.engine, expected_machine, previous_index.u64())
                    previous_instruction: DebuggerEDIR::Instruction = controller.engine.image.instructions[expected_machine.program_counter.usize()]
                    if DebuggerEDIR::opcode_is_host_effect(previous_instruction.opcode):
                        return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if not controller.engine.effect_result_recorded[previous_index]
                        return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if not DebuggerEDIR::machine_step_effect_result(expected_machine, previous_instruction, controller.engine.effect_result_bits[previous_index])
                    else:
                        return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if controller.engine.effect_result_recorded[previous_index]
                        DebuggerEDIR::machine_step_in_place(expected_machine, previous_instruction)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::HISTORY) if not DebuggerReplayEngine::replay_engine_apply_interventions_to_machine(controller.engine, expected_machine, checkpoint.event)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::HISTORY) if not DebuggerCheckpoint::snapshot_matches_machine(checkpoint.machine, expected_machine)
            restored_session: DebuggerSession::Session = DebuggerSession::session_seek(controller.session, checkpoint.event)
            if restored_session.last_error == DebuggerSession::SessionError.HistoryUnavailable:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY)
            if restored_session.last_error == DebuggerSession::SessionError.Unsupported:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::ENGINE_MANAGED_DETAIL_UNSUPPORTED)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::HISTORY) if restored_session.last_error != DebuggerSession::SessionError.None
            preserve_side_history_prefix: bool = managed_side_checkpoint_is_valid(controller, checkpoint.event.usize()) and managed_side_checkpoint_at(controller, checkpoint.event.usize()).side_state_hash == checkpoint.side_state_hash
            failure <- DebuggerManagedState::state_restore(controller.state, checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            restored: DebuggerEDIR::Machine = DebuggerFullCheckpoint::full_checkpoint_restore_machine(checkpoint)
            controller.engine.machine <- restored
            controller.engine.event_count <- checkpoint.event.usize()
            controller.engine.engine_error <- DebuggerReplayEngine::EngineError.None
            controller.session <- restored_session
            if not preserve_side_history_prefix:
                controller.side_history_first_event <- checkpoint.event.usize()
                controller.side_history_count <- checkpoint.event.usize()
            managed_sync_position(controller)
            managed_refresh_values(controller)
            return DebuggerErrors::no_error()

        def managed_create_branch(controller: mutable ManagedController&) -> DebuggerIdentity::DebugId:
            original_next_branch_id: u64 = controller.engine.next_branch_id
            parent_branch: DebuggerIdentity::DebugId = controller.engine.branch
            fork_event: u64 = controller.engine.event_count.u64()
            state_hash: u64 = DebuggerReplayEngine::replay_engine_state_hash(controller.engine)
            branch_value: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(controller.engine)
            return DebuggerIdentity::debug_id(0) if branch_value.value == 0
            if controller.state.branches.next_id != branch_value.value:
                controller.engine.next_branch_id <- original_next_branch_id
                return DebuggerIdentity::debug_id(0)
            forked: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(controller.engine, branch_value)
            if forked.branch.value != branch_value.value or forked.engine_error != DebuggerReplayEngine::EngineError.None:
                controller.engine.next_branch_id <- original_next_branch_id
                return DebuggerIdentity::debug_id(0)
            previous_branch_count: usize = controller.state.branches.count
            previous_branch_next_id: u64 = controller.state.branches.next_id
            created_branch: DebuggerIdentity::DebugId = DebuggerBranches::branches_fork(controller.state.branches, parent_branch, fork_event, state_hash)
            if created_branch.value != branch_value.value:
                controller.state.branches.count <- previous_branch_count
                controller.state.branches.next_id <- previous_branch_next_id
                controller.engine.next_branch_id <- original_next_branch_id
                return DebuggerIdentity::debug_id(0)
            forked.next_branch_id <- controller.engine.next_branch_id
            controller.engine <- forked
            managed_sync_position(controller)
            return DebuggerIdentity::debug_id(branch_value.value)

        def managed_add_intervention(controller: mutable ManagedController&, branch: DebuggerIdentity::DebugId, intervention: DebuggerBranches::Intervention) -> DebuggerErrors::DebuggerError:
            added: bool = DebuggerBranches::branches_add_intervention(controller.state.branches, branch, intervention)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HISTORY) if not added
            return DebuggerErrors::no_error()

        def managed_is_exact(controller: mutable ManagedController&) -> bool:
            return false if not DebuggerReplayEngine::replay_engine_is_exact(controller.engine)
            return DebuggerManagedState::state_replay_is_exact(controller.state)

        # Report what the managed engine can safely navigate from this stop.
        # Machine history alone is insufficient while effect, resource,
        # adapter, or scheduler state has no matching historical snapshot.
        def managed_history_eligibility(controller: mutable ManagedController&) -> DebuggerTimeline::HistoryEligibility:
            eligibility: mutable DebuggerTimeline::HistoryEligibility = DebuggerTimeline::history_eligibility_for_capabilities(controller.session.capabilities)
            return eligibility if eligibility.reason == DebuggerTimeline::HistoryEligibilityReason.UnsupportedHistory
            if not DebuggerSession::session_can_inspect(controller.session):
                eligibility.reason <- DebuggerTimeline::HistoryEligibilityReason.SessionNotStopped
                return eligibility
            if managed_history_has_unaligned_side_state(controller):
                eligibility.reason <- DebuggerTimeline::HistoryEligibilityReason.SideStateUnaligned
                return eligibility
            if not managed_is_exact(controller):
                eligibility.reason <- DebuggerTimeline::HistoryEligibilityReason.StateNotExact
                return eligibility
            current_event: u64 = controller.engine.event_count.u64()
            retained_first: u64 = controller.session.retained_first
            retained_last: u64 = controller.session.retained_last
            previous_event: usize = controller.engine.event_count - Reverse::PREVIOUS_EVENT_INCREMENT if controller.engine.event_count > Event::INITIAL_INDEX else Event::INITIAL_INDEX
            eligibility.can_reverse <- current_event > retained_first and managed_reverse_snapshot_is_valid(controller, previous_event) and managed_side_checkpoint_is_valid(controller, previous_event)
            eligibility.can_seek <- eligibility.can_reverse
            if not eligibility.can_seek and controller.session.has_retained_history and current_event < retained_last:
                eligibility.can_seek <- managed_side_checkpoint_is_valid(controller, retained_last.usize())
            eligibility.reason <- DebuggerTimeline::HistoryEligibilityReason.Ready if eligibility.can_reverse or eligibility.can_seek
            return eligibility

        def managed_fork(controller: mutable ManagedController&, branch: DebuggerIdentity::DebugId) -> DebuggerReplayEngine::ReplayEngine:
            return DebuggerReplayEngine::replay_engine_fork(controller.engine, branch)

        def managed_intervene_accumulator(controller: mutable DebuggerReplayEngine::ReplayEngine&, value: i64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::HISTORY) if not DebuggerReplayEngine::replay_engine_set_accumulator(controller, value)
            return DebuggerErrors::no_error()
