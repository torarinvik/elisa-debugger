# Managed execution facade.  It owns the EDIR replay engine and keeps the
# provider-neutral session position synchronized for every editor adapter.

include "./provider.elisa"
include "../core/session.elisa"
include "../core/errors.elisa"
include "../replay/engine.elisa"
include "../replay/checkpoint_codec.elisa"
include "./state.elisa"

module DebuggerManagedEngine:
    private:
        const DETAIL_ENGINE_FAULT: u32 = 1
        const DETAIL_HISTORY: u32 = 2
        const DETAIL_UNSUPPORTED: u32 = 3
        const CHECKPOINT_ID_OFFSET: u64 = 1
        const MAX_CHECKPOINT_ID: u64 = 18446744073709551615

    public:
        struct ManagedController:
            session: mutable DebuggerSession::Session
            engine: mutable DebuggerReplayEngine::ReplayEngine
            state: mutable DebuggerManagedState::State
            last_error: mutable DebuggerErrors::DebuggerError

        def managed_new(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage, recording: DebuggerIdentity::DebugId) -> ManagedController:
            return ManagedController{session: session, engine: DebuggerReplayEngine::replay_engine_new(image, recording), state: DebuggerManagedState::state_new(), last_error: DebuggerErrors::no_error()}

        def managed_sync_position(controller: mutable ManagedController&) -> void:
            controller.session.position <- DebuggerReplayEngine::replay_engine_position(controller.engine)

        def managed_launch(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, DETAIL_ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or controller.engine.machine.faulted
            controller.session <- DebuggerSession::session_launch(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            managed_sync_position(controller)
            return DebuggerErrors::no_error()

        def managed_pause(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            controller.session <- DebuggerSession::session_pause(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            managed_sync_position(controller)
            return DebuggerErrors::no_error()

        def managed_continue(controller: mutable ManagedController&, max_steps: u64) -> DebuggerErrors::DebuggerError:
            controller.session <- DebuggerSession::session_resume(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            DebuggerReplayEngine::replay_engine_run(controller.engine, max_steps)
            managed_sync_position(controller)
            controller.session <- DebuggerSession::session_stop(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT) if controller.session.last_error != DebuggerSession::SessionError.None
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryFull or controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable or controller.engine.engine_error == DebuggerReplayEngine::EngineError.StepLimit
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, DETAIL_ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault
            return DebuggerErrors::no_error()

        def managed_step(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            original_engine: DebuggerReplayEngine::ReplayEngine = controller.engine
            original_session: DebuggerSession::Session = controller.session
            before_event: usize = controller.engine.event_count
            DebuggerReplayEngine::replay_engine_step(controller.engine)
            if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault:
                managed_sync_position(controller)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, DETAIL_ENGINE_FAULT)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if controller.engine.event_count == before_event
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable
            controller.session <- DebuggerSession::session_step(controller.session)
            if controller.session.last_error != DebuggerSession::SessionError.None:
                session_failure: DebuggerSession::SessionError = controller.session.last_error
                controller.engine <- original_engine
                controller.session <- original_session
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if session_failure == DebuggerSession::SessionError.HistoryUnavailable
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT)
            managed_sync_position(controller)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryFull
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, DETAIL_ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault
            return DebuggerErrors::no_error()

        def managed_reverse_step(controller: mutable ManagedController&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT) if not DebuggerSession::session_can_reverse(controller.session)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if controller.engine.event_count == 0
            original_engine: DebuggerReplayEngine::ReplayEngine = controller.engine
            original_session: DebuggerSession::Session = controller.session
            DebuggerReplayEngine::replay_engine_reverse_one(controller.engine)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable
            controller.session <- DebuggerSession::session_reverse_step(controller.session)
            if controller.session.last_error != DebuggerSession::SessionError.None:
                session_failure: DebuggerSession::SessionError = controller.session.last_error
                controller.engine <- original_engine
                controller.session <- original_session
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if session_failure == DebuggerSession::SessionError.HistoryUnavailable
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT)
            managed_sync_position(controller)
            return DebuggerErrors::no_error()

        def managed_seek(controller: mutable ManagedController&, event: usize) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT) if not DebuggerSession::session_can_inspect(controller.session)
            original_engine: DebuggerReplayEngine::ReplayEngine = controller.engine
            original_session: DebuggerSession::Session = controller.session
            DebuggerReplayEngine::replay_engine_seek(controller.engine, event)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, DETAIL_ENGINE_FAULT) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if controller.engine.engine_error == DebuggerReplayEngine::EngineError.HistoryUnavailable
            controller.session <- DebuggerSession::session_seek(controller.session, event.u64())
            if controller.session.last_error != DebuggerSession::SessionError.None:
                session_failure: DebuggerSession::SessionError = controller.session.last_error
                controller.engine <- original_engine
                controller.session <- original_session
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if session_failure == DebuggerSession::SessionError.Unsupported
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_ENGINE_FAULT)
            managed_sync_position(controller)
            return DebuggerErrors::no_error()

        def managed_checkpoint(controller: mutable ManagedController&) -> DebuggerTraceBinary::ByteWriter:
            checkpoint_id: u64 = MAX_CHECKPOINT_ID if controller.engine.event_count.u64() == MAX_CHECKPOINT_ID else controller.engine.event_count.u64() + CHECKPOINT_ID_OFFSET
            snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(controller.engine.machine, DebuggerIdentity::debug_id(checkpoint_id), controller.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))
            return DebuggerCheckpointCodec::checkpoint_encode(snapshot)

        def managed_full_checkpoint(controller: mutable ManagedController&) -> DebuggerFullCheckpoint::ManagedCheckpoint:
            return DebuggerManagedState::state_capture(controller.state, controller.engine.machine, controller.engine.recording, controller.engine.branch, controller.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))

        def managed_restore_full_checkpoint(controller: mutable ManagedController&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> DebuggerErrors::DebuggerError:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_ENGINE_FAULT) if checkpoint.recording.value != controller.engine.recording.value
            failure <- DebuggerManagedState::state_restore(controller.state, checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            restored: DebuggerEDIR::Machine = DebuggerFullCheckpoint::full_checkpoint_restore_machine(checkpoint)
            controller.engine.machine <- restored
            controller.engine.event_count <- checkpoint.event.usize()
            controller.engine.branch <- checkpoint.branch
            controller.engine.engine_error <- DebuggerReplayEngine::EngineError.None
            managed_sync_position(controller)
            return DebuggerErrors::no_error()

        def managed_create_branch(controller: mutable ManagedController&) -> DebuggerIdentity::DebugId:
            branch_value: u64 = controller.state.branches.next_id
            return DebuggerIdentity::debug_id(0) if branch_value == 0
            updated: DebuggerBranches::BranchStore = DebuggerBranches::branches_fork(controller.state.branches, controller.engine.branch, controller.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(controller.engine))
            return DebuggerIdentity::debug_id(0) if updated.count == controller.state.branches.count
            controller.state.branches <- updated
            return DebuggerIdentity::debug_id(branch_value)

        def managed_add_intervention(controller: mutable ManagedController&, branch: DebuggerIdentity::DebugId, intervention: DebuggerBranches::Intervention) -> DebuggerErrors::DebuggerError:
            updated: DebuggerBranches::BranchStore = DebuggerBranches::branches_add_intervention(controller.state.branches, branch, intervention)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_HISTORY) if updated.count != controller.state.branches.count
            controller.state.branches <- updated
            return DebuggerErrors::no_error()

        def managed_is_exact(controller: mutable ManagedController&) -> bool:
            return DebuggerReplayEngine::replay_engine_is_exact(controller.engine)

        def managed_fork(controller: mutable ManagedController&, branch: DebuggerIdentity::DebugId) -> DebuggerReplayEngine::ReplayEngine:
            return DebuggerReplayEngine::replay_engine_fork(controller.engine, branch)

        def managed_intervene_accumulator(controller: mutable DebuggerReplayEngine::ReplayEngine&, value: i64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_HISTORY) if not DebuggerReplayEngine::replay_engine_set_accumulator(controller, value)
            return DebuggerErrors::no_error()
