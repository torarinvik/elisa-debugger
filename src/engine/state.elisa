# Managed logical state shared by replay, checkpoint, and branch operations.
# Keeping these components behind one public value prevents protocol adapters
# from reaching into individual replay providers or duplicating restore rules.

include "../replay/full_checkpoint.elisa"
include "../replay/branches.elisa"
include "../replay/effects.elisa"
include "../replay/resources.elisa"
include "../concurrency/checkpoint.elisa"
include "../concurrency/runtime.elisa"
include "../core/errors.elisa"
include "../core/identity.elisa"
include "../vm/edir.elisa"

module DebuggerManagedState:
    public:
        struct State:
            tasks: mutable DebuggerConcurrencyRuntime::TaskRuntime
            effects: mutable DebuggerEffects::EffectOracle
            resources: mutable DebuggerVirtualResources::ResourceStore
            branches: mutable DebuggerBranches::BranchStore

        def state_new() -> State:
            return State{
                tasks: DebuggerConcurrencyRuntime::runtime_new(false),
                effects: DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Recording),
                resources: DebuggerVirtualResources::resources_new(DebuggerVirtualResources::ResourceMode.Recording),
                branches: DebuggerBranches::branches_new()
            }

        def state_capture(state: mutable State&, machine: DebuggerEDIR::Machine, recording: DebuggerIdentity::DebugId, branch: DebuggerIdentity::DebugId, event: u64, state_hash: u64) -> DebuggerFullCheckpoint::ManagedCheckpoint:
            tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(state.tasks)
            return DebuggerFullCheckpoint::full_checkpoint_capture(machine, tasks, state.effects, state.resources, recording, branch, event, state_hash)

        def state_restore(state: mutable State&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> DebuggerErrors::DebuggerError:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            failure <- DebuggerFullCheckpoint::full_checkpoint_restore_tasks(state.tasks, checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            state.effects <- DebuggerFullCheckpoint::full_checkpoint_effects(checkpoint)
            state.resources <- DebuggerFullCheckpoint::full_checkpoint_resources(checkpoint)
            return DebuggerErrors::no_error()

        def state_is_valid(state: mutable State&) -> bool:
            tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(state.tasks)
            return DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(tasks) and DebuggerEffects::effect_oracle_is_exact(state.effects) and DebuggerVirtualResources::resources_is_valid(state.resources)
