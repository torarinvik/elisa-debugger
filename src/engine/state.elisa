# Managed logical state shared by replay, checkpoint, and branch operations.
# Keeping these components behind one public value prevents protocol adapters
# from reaching into individual replay providers or duplicating restore rules.

include "../replay/full_checkpoint.elisa"
include "../replay/branches.elisa"
include "../replay/effects.elisa"
include "../replay/resources.elisa"
include "../replay/adapters.elisa"
include "../concurrency/checkpoint.elisa"
include "../concurrency/runtime.elisa"
include "../breakpoint/manager.elisa"
include "../breakpoint/watchpoint.elisa"
include "../inspect/store.elisa"
include "../core/errors.elisa"
include "../core/identity.elisa"
include "../vm/edir.elisa"
include "../vm/edir_codec.elisa"

module DebuggerManagedState:
    private:
        const module StateDefaults:
            INITIAL_VALUE_GENERATION: u64 = 0

        const module StateDetail:
            REPLAY_STATE: u32 = 1
            RESOURCE_OVERFLOW: u32 = 2
            SIDE_EFFECT_BRIDGE_ATOMICITY: u32 = 3

        const module BridgeDefaults:
            COUNT_INCREMENT: usize = 1
            EMPTY_HASH: u64 = 0
            EMPTY_VALUE: i64 = 0
            NO_WRITE_SUPPRESSION: bool = false
            INITIAL_ACCEPTED: bool = false

    public:
        struct State:
            tasks: mutable DebuggerConcurrencyRuntime::TaskRuntime
            effects: mutable DebuggerEffects::EffectOracle
            resources: mutable DebuggerVirtualResources::ResourceStore
            adapters: mutable DebuggerReplayAdapters::AdapterSnapshot
            branches: mutable DebuggerBranches::BranchStore
            breakpoints: mutable DebuggerBreakpointManager::BreakpointTable
            watchpoints: mutable DebuggerWatchpoints::WatchpointTable
            values: mutable DebuggerValueStore::ValueStore

    private:
        def state_side_effect_modes_are_coherent(state: State&) -> bool:
            return state.resources.mode == DebuggerVirtualResources::ResourceMode.Recording and state.adapters.clock.mode == DebuggerReplayAdapters::AdapterMode.Recording if state.effects.mode == DebuggerEffects::EffectMode.Recording
            return state.resources.mode == DebuggerVirtualResources::ResourceMode.Replaying and state.adapters.clock.mode == DebuggerReplayAdapters::AdapterMode.Replaying if state.effects.mode == DebuggerEffects::EffectMode.Replaying
            return state.resources.mode == DebuggerVirtualResources::ResourceMode.Branch and state.adapters.clock.mode == DebuggerReplayAdapters::AdapterMode.Branch if state.effects.mode == DebuggerEffects::EffectMode.Virtualized
            return false

        def state_clock_effect_bridge_failure(state: mutable State&, failure: DebuggerErrors::DebuggerError) -> void:
            state.effects.exactness <- DebuggerEffects::Exactness.Diverged if failure.code == DebuggerErrors::ErrorCode.Diverged
            state.effects.exactness <- DebuggerEffects::Exactness.Incomplete if failure.code != DebuggerErrors::ErrorCode.Diverged
            state.effects.last_error <- failure
            state.adapters.clock.exact <- false
            state.adapters.clock.last_error <- failure

        def state_clock_effect_replay_failure(failure: DebuggerErrors::DebuggerError) -> DebuggerEffects::EffectReplay:
            return DebuggerEffects::EffectReplay{accepted: BridgeDefaults::INITIAL_ACCEPTED, result_hash: BridgeDefaults::EMPTY_HASH, result_value: BridgeDefaults::EMPTY_VALUE, suppress_external_write: BridgeDefaults::NO_WRITE_SUPPRESSION, failure: failure}

        def state_random_effect_bridge_failure(state: mutable State&, failure: DebuggerErrors::DebuggerError) -> void:
            state.effects.exactness <- DebuggerEffects::Exactness.Diverged if failure.code == DebuggerErrors::ErrorCode.Diverged
            state.effects.exactness <- DebuggerEffects::Exactness.Incomplete if failure.code != DebuggerErrors::ErrorCode.Diverged
            state.effects.last_error <- failure
            state.adapters.random.exact <- false
            state.adapters.random.last_error <- failure

        def state_random_effect_replay_failure(failure: DebuggerErrors::DebuggerError) -> DebuggerEffects::RandomEffectReplay:
            return DebuggerEffects::RandomEffectReplay{accepted: BridgeDefaults::INITIAL_ACCEPTED, result_hash: BridgeDefaults::EMPTY_HASH, value: BridgeDefaults::EMPTY_HASH, suppress_external_write: BridgeDefaults::NO_WRITE_SUPPRESSION, failure: failure}

    public:
        def state_initialize(state: mutable State&) -> void:
            DebuggerConcurrencyRuntime::runtime_initialize(state.tasks, false)
            DebuggerEffects::effect_oracle_initialize(state.effects, DebuggerEffects::EffectMode.Recording)
            DebuggerVirtualResources::resources_initialize(state.resources, DebuggerVirtualResources::ResourceMode.Recording)
            DebuggerReplayAdapters::adapter_snapshot_initialize_recording(state.adapters)
            DebuggerBranches::branches_initialize(state.branches)
            DebuggerBreakpointManager::breakpoint_table_initialize(state.breakpoints)
            DebuggerWatchpoints::watchpoints_initialize(state.watchpoints)
            DebuggerValueStore::value_store_initialize(state.values, StateDefaults::INITIAL_VALUE_GENERATION)

        def state_reset_values(state: mutable State&, generation: u64) -> void:
            DebuggerValueStore::value_store_initialize(state.values, generation)

        def state_capture(state: mutable State&, machine: DebuggerEDIR::Machine&, build: DebuggerIdentity::BuildIdentity, image_fingerprint: DebuggerEDIRCodec::ArtifactFingerprint, recording: DebuggerIdentity::DebugId, branch: DebuggerIdentity::DebugId, event: u64, state_hash: u64) -> DebuggerFullCheckpoint::ManagedCheckpoint:
            tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(state.tasks)
            return DebuggerFullCheckpoint::full_checkpoint_capture_with_adapters(machine, tasks, state.effects, state.resources, state.adapters, recording, branch, event, state_hash, build, image_fingerprint.value, image_fingerprint.valid)

        def state_restore(state: mutable State&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&) -> DebuggerErrors::DebuggerError:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            failure <- DebuggerFullCheckpoint::full_checkpoint_restore_tasks(state.tasks, checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            failure <- DebuggerFullCheckpoint::full_checkpoint_restore_effects(state.effects, checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            state.resources <- DebuggerFullCheckpoint::full_checkpoint_resources(checkpoint)
            failure <- DebuggerFullCheckpoint::full_checkpoint_restore_adapters(state.adapters, checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            return DebuggerErrors::no_error()

        def state_is_valid(state: mutable State&) -> bool:
            tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(state.tasks)
            return DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(tasks) and DebuggerEffects::effect_oracle_is_exact(state.effects) and DebuggerVirtualResources::resources_is_valid(state.resources) and DebuggerReplayAdapters::adapter_snapshot_is_valid(state.adapters) and DebuggerBranches::branches_is_valid(state.branches) and DebuggerBreakpointManager::breakpoint_table_is_valid(state.breakpoints) and DebuggerWatchpoints::watchpoints_is_valid(state.watchpoints) and DebuggerValueStore::value_store_is_valid(state.values)

        def state_replay_is_exact(state: mutable State&) -> bool:
            return false if not state_is_valid(state) or not DebuggerVirtualResources::resources_is_exact(state.resources)
            return state_side_effect_modes_are_coherent(state)

        # The managed state owns both records for a clock effect. Prepare both
        # mutations on local copies so a capacity or validation failure cannot
        # leave the effect oracle and adapter journal describing different calls.
        def state_record_clock_effect(state: mutable State&, call_site: DebuggerIdentity::DebugId, adapter_source: DebuggerIdentity::DebugId, invocation: DebuggerIdentity::DebugId, request_hash: u64, result_hash: u64, value: i64) -> DebuggerErrors::DebuggerError:
            if not state_replay_is_exact(state) or state.effects.mode != DebuggerEffects::EffectMode.Recording or state.resources.mode != DebuggerVirtualResources::ResourceMode.Recording or state.adapters.clock.mode != DebuggerReplayAdapters::AdapterMode.Recording:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY)
            effect_candidate: mutable DebuggerEffects::EffectOracle = state.effects
            clock_candidate: mutable DebuggerReplayAdapters::Clock = state.adapters.clock
            previous_effect_count: usize = effect_candidate.count
            previous_clock_count: usize = clock_candidate.count
            DebuggerEffects::effect_oracle_record_in_invocation(effect_candidate, DebuggerEffects::EffectKind.Clock, call_site, invocation, request_hash, result_hash, value)
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if effect_candidate.count != previous_effect_count + BridgeDefaults::COUNT_INCREMENT or effect_candidate.exactness != DebuggerEffects::Exactness.Exact or not DebuggerErrors::error_is_ok(effect_candidate.last_error):
                failure <- effect_candidate.last_error if not DebuggerErrors::error_is_ok(effect_candidate.last_error)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY) if DebuggerErrors::error_is_ok(failure)
                state_clock_effect_bridge_failure(state, failure)
                return failure
            failure <- DebuggerReplayAdapters::clock_record_in_invocation(clock_candidate, adapter_source, invocation, value.u64())
            if not DebuggerErrors::error_is_ok(failure) or clock_candidate.count != previous_clock_count + BridgeDefaults::COUNT_INCREMENT:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY) if DebuggerErrors::error_is_ok(failure)
                state_clock_effect_bridge_failure(state, failure)
                return failure
            state.effects <- effect_candidate
            state.adapters.clock <- clock_candidate
            return DebuggerErrors::no_error()

        # Replay consumes the generic effect and typed clock sample as one
        # transaction. A mismatched value or identity does not advance either
        # durable cursor and permanently marks the managed recording inexact.
        def state_replay_clock_effect(state: mutable State&, call_site: DebuggerIdentity::DebugId, adapter_source: DebuggerIdentity::DebugId, invocation: DebuggerIdentity::DebugId, request_hash: u64) -> DebuggerEffects::EffectReplay:
            if not state_replay_is_exact(state) or state.effects.mode != DebuggerEffects::EffectMode.Replaying or state.resources.mode != DebuggerVirtualResources::ResourceMode.Replaying or state.adapters.clock.mode != DebuggerReplayAdapters::AdapterMode.Replaying:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY)
                return state_clock_effect_replay_failure(failure)
            effect_candidate: mutable DebuggerEffects::EffectOracle = state.effects
            clock_candidate: mutable DebuggerReplayAdapters::Clock = state.adapters.clock
            effect_reply: DebuggerEffects::EffectReplay = DebuggerEffects::effect_oracle_replay_result_in_invocation(effect_candidate, DebuggerEffects::EffectKind.Clock, call_site, invocation, request_hash)
            if not effect_reply.accepted:
                state_clock_effect_bridge_failure(state, effect_reply.failure)
                return effect_reply
            clock_reply: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read_in_invocation(clock_candidate, adapter_source, invocation)
            if not clock_reply.accepted:
                state_clock_effect_bridge_failure(state, clock_reply.failure)
                return state_clock_effect_replay_failure(clock_reply.failure)
            if effect_reply.result_value.u64() != clock_reply.value:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY)
                state_clock_effect_bridge_failure(state, failure)
                return state_clock_effect_replay_failure(failure)
            state.effects <- effect_candidate
            state.adapters.clock <- clock_candidate
            return effect_reply

        # Random values use the same transaction boundary as clock samples,
        # while preserving their full unsigned 64-bit result representation.
        def state_record_random_effect(state: mutable State&, call_site: DebuggerIdentity::DebugId, adapter_source: DebuggerIdentity::DebugId, invocation: DebuggerIdentity::DebugId, request_hash: u64, result_hash: u64, value: u64) -> DebuggerErrors::DebuggerError:
            if not state_replay_is_exact(state) or state.effects.mode != DebuggerEffects::EffectMode.Recording or state.resources.mode != DebuggerVirtualResources::ResourceMode.Recording or state.adapters.random.mode != DebuggerReplayAdapters::AdapterMode.Recording:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY)
            effect_candidate: mutable DebuggerEffects::EffectOracle = state.effects
            random_candidate: mutable DebuggerReplayAdapters::Random = state.adapters.random
            previous_effect_count: usize = effect_candidate.count
            previous_random_count: usize = random_candidate.count
            DebuggerEffects::effect_oracle_record_random_in_invocation(effect_candidate, call_site, invocation, request_hash, result_hash, value)
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if effect_candidate.count != previous_effect_count + BridgeDefaults::COUNT_INCREMENT or effect_candidate.exactness != DebuggerEffects::Exactness.Exact or not DebuggerErrors::error_is_ok(effect_candidate.last_error):
                failure <- effect_candidate.last_error if not DebuggerErrors::error_is_ok(effect_candidate.last_error)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY) if DebuggerErrors::error_is_ok(failure)
                state_random_effect_bridge_failure(state, failure)
                return failure
            failure <- DebuggerReplayAdapters::random_record_in_invocation(random_candidate, adapter_source, invocation, value)
            if not DebuggerErrors::error_is_ok(failure) or random_candidate.count != previous_random_count + BridgeDefaults::COUNT_INCREMENT:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY) if DebuggerErrors::error_is_ok(failure)
                state_random_effect_bridge_failure(state, failure)
                return failure
            state.effects <- effect_candidate
            state.adapters.random <- random_candidate
            return DebuggerErrors::no_error()

        def state_replay_random_effect(state: mutable State&, call_site: DebuggerIdentity::DebugId, adapter_source: DebuggerIdentity::DebugId, invocation: DebuggerIdentity::DebugId, request_hash: u64) -> DebuggerEffects::RandomEffectReplay:
            if not state_replay_is_exact(state) or state.effects.mode != DebuggerEffects::EffectMode.Replaying or state.resources.mode != DebuggerVirtualResources::ResourceMode.Replaying or state.adapters.random.mode != DebuggerReplayAdapters::AdapterMode.Replaying:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY)
                return state_random_effect_replay_failure(failure)
            effect_candidate: mutable DebuggerEffects::EffectOracle = state.effects
            random_candidate: mutable DebuggerReplayAdapters::Random = state.adapters.random
            effect_reply: DebuggerEffects::EffectReplay = DebuggerEffects::effect_oracle_replay_result_in_invocation(effect_candidate, DebuggerEffects::EffectKind.Random, call_site, invocation, request_hash)
            if not effect_reply.accepted:
                state_random_effect_bridge_failure(state, effect_reply.failure)
                return state_random_effect_replay_failure(effect_reply.failure)
            random_reply: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read_in_invocation(random_candidate, adapter_source, invocation)
            if not random_reply.accepted:
                state_random_effect_bridge_failure(state, random_reply.failure)
                return state_random_effect_replay_failure(random_reply.failure)
            if effect_reply.result_value.u64() != random_reply.value:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, StateDetail::SIDE_EFFECT_BRIDGE_ATOMICITY)
                state_random_effect_bridge_failure(state, failure)
                return state_random_effect_replay_failure(failure)
            state.effects <- effect_candidate
            state.adapters.random <- random_candidate
            return DebuggerEffects::RandomEffectReplay{accepted: true, result_hash: effect_reply.result_hash, value: random_reply.value, suppress_external_write: effect_reply.suppress_external_write, failure: DebuggerErrors::no_error()}

        def state_begin_side_effect_replay(state: mutable State&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, StateDetail::RESOURCE_OVERFLOW) if state.resources.operation_overflowed
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, false, StateDetail::REPLAY_STATE) if not state_replay_is_exact(state)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, StateDetail::REPLAY_STATE) if state.effects.mode != DebuggerEffects::EffectMode.Recording
            failure: mutable DebuggerErrors::DebuggerError = DebuggerEffects::effect_oracle_begin_replay(state.effects)
            return failure if not DebuggerErrors::error_is_ok(failure)
            failure <- DebuggerVirtualResources::resources_replay_restart(state.resources)
            return failure if not DebuggerErrors::error_is_ok(failure)
            failure <- DebuggerReplayAdapters::adapter_snapshot_begin_replay(state.adapters)
            return failure if not DebuggerErrors::error_is_ok(failure)
            return DebuggerErrors::no_error()
