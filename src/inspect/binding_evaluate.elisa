# Binding evaluation adapter.  It keeps value-store ownership out of the
# expression grammar while preserving generation and unavailable states.

include "./evaluate.elisa"
include "./store.elisa"

module DebuggerBindingEvaluate:
    private:
        const DETAIL_BINDING: u32 = 1
        const EVALUATION_ZERO: i64 = 0
        const EVALUATION_BUDGET_ZERO: usize = 0
        const EVALUATION_COST_LITERAL: usize = 1
        const EVALUATION_I64_MAX: u64 = 9223372036854775807

    public:
        def evaluate_binding(store: mutable DebuggerValueStore::ValueStore&, handle: DebuggerValues::ValueHandle, budget: usize) -> DebuggerEvaluate::Evaluation:
            return DebuggerEvaluate::Evaluation{value: EVALUATION_ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, DETAIL_BINDING), consumed: budget} if budget == EVALUATION_BUDGET_ZERO
            node: DebuggerValueStore::ValueNode = DebuggerValueStore::value_store_read(store, handle)
            return DebuggerEvaluate::Evaluation{value: EVALUATION_ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_BINDING), consumed: EVALUATION_COST_LITERAL} if node.state != DebuggerValues::ValueState.Available
            return DebuggerEvaluate::evaluate_literal(node.signed_value) if node.kind == DebuggerValues::ValueKind.Signed or node.kind == DebuggerValues::ValueKind.Boolean
            return DebuggerEvaluate::Evaluation{value: EVALUATION_ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_BINDING), consumed: EVALUATION_COST_LITERAL} if node.kind == DebuggerValues::ValueKind.Unsigned and node.unsigned_value > EVALUATION_I64_MAX
            return DebuggerEvaluate::Evaluation{value: node.unsigned_value.i64(), failure: DebuggerErrors::no_error(), consumed: EVALUATION_COST_LITERAL} if node.kind == DebuggerValues::ValueKind.Unsigned
            return DebuggerEvaluate::Evaluation{value: EVALUATION_ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_BINDING), consumed: EVALUATION_COST_LITERAL}
