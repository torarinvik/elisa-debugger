# Binding evaluation adapter.  It keeps value-store ownership out of the
# expression grammar while preserving generation and unavailable states.

include "./evaluate.elisa"
include "./store.elisa"

module DebuggerBindingEvaluate:
    private:
        const module Detail:
            INSPECT_BINDING_EVALUATE_DETAIL_BINDING: u32 = 1

        const module Evaluation:
            ZERO: i64 = 0
            BUDGET_ZERO: usize = 0
            INSPECT_BINDING_EVALUATE_EVALUATION_COST_LITERAL: usize = 1
            INSPECT_BINDING_EVALUATE_EVALUATION_I64_MAX: u64 = 9223372036854775807


    public:
        def evaluate_binding(store: mutable DebuggerValueStore::ValueStore&, handle: DebuggerValues::ValueHandle, budget: usize) -> DebuggerEvaluate::Evaluation:
            return DebuggerEvaluate::Evaluation{value: Evaluation::ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Detail::INSPECT_BINDING_EVALUATE_DETAIL_BINDING), consumed: budget} if budget == Evaluation::BUDGET_ZERO
            node: DebuggerValueStore::ValueNode = DebuggerValueStore::value_store_read(store, handle)
            return DebuggerEvaluate::Evaluation{value: Evaluation::ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::INSPECT_BINDING_EVALUATE_DETAIL_BINDING), consumed: Evaluation::INSPECT_BINDING_EVALUATE_EVALUATION_COST_LITERAL} if node.state == DebuggerValues::ValueState.Invalid
            return DebuggerEvaluate::Evaluation{value: Evaluation::ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::INSPECT_BINDING_EVALUATE_DETAIL_BINDING), consumed: Evaluation::INSPECT_BINDING_EVALUATE_EVALUATION_COST_LITERAL} if node.state != DebuggerValues::ValueState.Available
            return DebuggerEvaluate::evaluate_literal(node.signed_value) if node.kind == DebuggerValues::ValueKind.Signed or node.kind == DebuggerValues::ValueKind.Boolean
            return DebuggerEvaluate::Evaluation{value: Evaluation::ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::INSPECT_BINDING_EVALUATE_DETAIL_BINDING), consumed: Evaluation::INSPECT_BINDING_EVALUATE_EVALUATION_COST_LITERAL} if node.kind == DebuggerValues::ValueKind.Unsigned and node.unsigned_value > Evaluation::INSPECT_BINDING_EVALUATE_EVALUATION_I64_MAX
            return DebuggerEvaluate::Evaluation{value: node.unsigned_value.i64(), failure: DebuggerErrors::no_error(), consumed: Evaluation::INSPECT_BINDING_EVALUATE_EVALUATION_COST_LITERAL} if node.kind == DebuggerValues::ValueKind.Unsigned
            return DebuggerEvaluate::Evaluation{value: Evaluation::ZERO, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::INSPECT_BINDING_EVALUATE_DETAIL_BINDING), consumed: Evaluation::INSPECT_BINDING_EVALUATE_EVALUATION_COST_LITERAL}

        # Resolve binding expressions against the stop-scoped value store. All
        # other expression kinds retain the pure arithmetic evaluator.
        def evaluate_expression_with_store(expression: DebuggerEvaluate::Expression, store: mutable DebuggerValueStore::ValueStore&, budget: usize) -> DebuggerEvaluate::Evaluation:
            return evaluate_binding(store, expression.binding, budget) if expression.kind == DebuggerEvaluate::EvaluationKind.Binding
            return DebuggerEvaluate::evaluate_expression(expression, budget)
