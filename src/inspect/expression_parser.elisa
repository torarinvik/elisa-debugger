# Bounded, side-effect-free arithmetic expressions for debugger adapters.
#
# The parser accepts decimal integer literals, bounded identifiers, whitespace,
# unary minus, the four arithmetic operators, and parentheses. Identifiers are
# resolved only against an explicit immutable binding environment. The parser
# has no access to a machine, value store, process, or replay state.

include "./evaluate.elisa"
include "../core/errors.elisa"
include "../core/expression_limits.elisa"

module DebuggerExpressionParser:
    private:
        const module ExpressionParserBounds:
            MAX_SOURCE_BYTES: usize = DebuggerExpressionLimits::Source::MAX_EXPRESSION_BYTES
            MAX_NESTING_DEPTH: usize = 32
            MAX_OPERAND_COUNT: usize = 32
            MAX_BINDINGS: usize = 48
            MAX_IDENTIFIER_BYTES: usize = 32
            EMPTY_IDENTIFIER_BYTES: usize = 0
            ROOT_DEPTH: usize = 0

        const module ExpressionParserCursor:
            FIRST_INDEX: usize = 0
            INCREMENT: usize = 1

        const module ExpressionParserComparison:
            NO_OPERATOR_WIDTH: usize = 0
            TWO_CHARACTER_OPERATOR_WIDTH: usize = ExpressionParserCursor::INCREMENT + ExpressionParserCursor::INCREMENT

        const module ExpressionParserCharacter:
            ASCII_SPACE: u8 = 32
            ASCII_TAB: u8 = 9
            ASCII_LINE_FEED: u8 = 10
            ASCII_CARRIAGE_RETURN: u8 = 13
            ASCII_ZERO: u8 = 48
            ASCII_NINE: u8 = 57
            ASCII_PLUS: u8 = 43
            ASCII_MINUS: u8 = 45
            ASCII_MULTIPLY: u8 = 42
            ASCII_DIVIDE: u8 = 47
            ASCII_LESS_THAN: u8 = 60
            ASCII_EQUALS: u8 = 61
            ASCII_GREATER_THAN: u8 = 62
            ASCII_EXCLAMATION: u8 = 33
            ASCII_OPEN_PARENTHESIS: u8 = 40
            ASCII_CLOSE_PARENTHESIS: u8 = 41
            ASCII_UNDERSCORE: u8 = 95
            ASCII_UPPER_A: u8 = 65
            ASCII_UPPER_Z: u8 = 90
            ASCII_LOWER_A: u8 = 97
            ASCII_LOWER_Z: u8 = 122

        const module ExpressionParserArithmetic:
            DECIMAL_BASE: u64 = 10
            I64_MAX_LITERAL_MAGNITUDE: u64 = 9223372036854775807
            I64_MIN_LITERAL_MAGNITUDE: u64 = 9223372036854775808
            I64_MIN: i64 = -9223372036854775807 - 1
            EVALUATION_BUDGET: usize = 2
            ZERO: i64 = 0

        const module ExpressionParserDetail:
            EMPTY_INPUT: u32 = 1
            EXPECTED_VALUE: u32 = 2
            EXPECTED_CLOSE_PARENTHESIS: u32 = 3
            TRAILING_INPUT: u32 = 4
            LITERAL_OVERFLOW: u32 = 5
            SOURCE_TOO_LONG: u32 = 6
            NESTING_LIMIT: u32 = 7
            OPERAND_LIMIT: u32 = 8
            UNKNOWN_BINDING: u32 = 9
            UNAVAILABLE_BINDING: u32 = 10
            INVALID_ENVIRONMENT: u32 = 11

        def identifier_start_is_valid(byte: u8) -> bool:
            return byte == ExpressionParserCharacter::ASCII_UNDERSCORE or (byte >= ExpressionParserCharacter::ASCII_UPPER_A and byte <= ExpressionParserCharacter::ASCII_UPPER_Z) or (byte >= ExpressionParserCharacter::ASCII_LOWER_A and byte <= ExpressionParserCharacter::ASCII_LOWER_Z)

        def identifier_continue_is_valid(byte: u8) -> bool:
            return identifier_start_is_valid(byte) or (byte >= ExpressionParserCharacter::ASCII_ZERO and byte <= ExpressionParserCharacter::ASCII_NINE)

        def binding_name_matches(binding: ExpressionBinding, bytes: u8&, start: usize, length: usize) -> bool:
            return false if binding.name_length != length
            for index in ExpressionParserCursor::FIRST_INDEX..<length:
                return false if binding.name[index] != bytes[start + index]
            return true

        def environment_is_valid(environment: ExpressionEnvironment) -> bool:
            return false if environment.count > ExpressionParserBounds::MAX_BINDINGS
            for index in ExpressionParserCursor::FIRST_INDEX..<environment.count:
                binding: ExpressionBinding = environment.bindings[index]
                return false if binding.name_length == ExpressionParserBounds::EMPTY_IDENTIFIER_BYTES or binding.name_length > ExpressionParserBounds::MAX_IDENTIFIER_BYTES or not identifier_start_is_valid(binding.name[ExpressionParserCursor::FIRST_INDEX])
                for character_index in ExpressionParserCursor::INCREMENT..<binding.name_length:
                    return false if not identifier_continue_is_valid(binding.name[character_index])
                for previous in ExpressionParserCursor::FIRST_INDEX..<index:
                    return false if environment.bindings[previous].name_length == binding.name_length and expression_binding_names_equal(environment.bindings[previous], binding)
            return true

        def expression_binding_names_equal(left: ExpressionBinding, right: ExpressionBinding) -> bool:
            return false if left.name_length != right.name_length
            for index in ExpressionParserCursor::FIRST_INDEX..<left.name_length:
                return false if left.name[index] != right.name[index]
            return true

        def parse_identifier(bytes: u8&, length: usize, position: mutable usize&, operands: mutable usize&, environment: ExpressionEnvironment) -> ExpressionParserNode:
            start: usize = position
            position <- position + ExpressionParserCursor::INCREMENT
            while position < length and identifier_continue_is_valid(bytes[position]):
                position <- position + ExpressionParserCursor::INCREMENT
            name_length: usize = position - start
            return invalid_node(DebuggerErrors::ErrorCode.ResourceLimit, true, ExpressionParserDetail::OPERAND_LIMIT) if operands >= ExpressionParserBounds::MAX_OPERAND_COUNT
            operands <- operands + ExpressionParserCursor::INCREMENT
            for index in ExpressionParserCursor::FIRST_INDEX..<environment.count:
                binding: ExpressionBinding = environment.bindings[index]
                if binding_name_matches(binding, bytes, start, name_length):
                    return invalid_node(DebuggerErrors::ErrorCode.Unavailable, true, ExpressionParserDetail::UNAVAILABLE_BINDING) if not binding.available
                    return valid_node(binding.value)
            return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::UNKNOWN_BINDING)

        struct ExpressionParserNode:
            value: mutable i64
            valid: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def invalid_node(code: DebuggerErrors::ErrorCode, retryable: bool, detail: u32) -> ExpressionParserNode:
            return ExpressionParserNode{value: ExpressionParserArithmetic::ZERO, valid: false, failure: DebuggerErrors::make_error(code, retryable, detail)}

        def valid_node(value: i64) -> ExpressionParserNode:
            return ExpressionParserNode{value: value, valid: true, failure: DebuggerErrors::no_error()}

        def is_whitespace(byte: u8) -> bool:
            return byte == ExpressionParserCharacter::ASCII_SPACE or byte == ExpressionParserCharacter::ASCII_TAB or byte == ExpressionParserCharacter::ASCII_LINE_FEED or byte == ExpressionParserCharacter::ASCII_CARRIAGE_RETURN

        def skip_whitespace(bytes: u8&, length: usize, position: mutable usize&) -> void:
            while position < length and is_whitespace(bytes[position]):
                position <- position + ExpressionParserCursor::INCREMENT

        def apply_binary(kind: DebuggerEvaluate::EvaluationKind, left: i64, right: i64) -> ExpressionParserNode:
            expression: DebuggerEvaluate::Expression = DebuggerEvaluate::Expression{kind: kind, left: left, right: right, binding: zeroed}
            evaluation: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(expression, ExpressionParserArithmetic::EVALUATION_BUDGET)
            return invalid_node(evaluation.failure.code, evaluation.failure.retryable, evaluation.failure.detail) if not DebuggerErrors::error_is_ok(evaluation.failure)
            return valid_node(evaluation.value)

        def parse_integer_literal(bytes: u8&, length: usize, position: mutable usize&, operands: mutable usize&, negative: bool) -> ExpressionParserNode:
            return invalid_node(DebuggerErrors::ErrorCode.ResourceLimit, true, ExpressionParserDetail::OPERAND_LIMIT) if operands >= ExpressionParserBounds::MAX_OPERAND_COUNT
            maximum: u64 = ExpressionParserArithmetic::I64_MIN_LITERAL_MAGNITUDE if negative else ExpressionParserArithmetic::I64_MAX_LITERAL_MAGNITUDE
            magnitude: mutable u64 = 0
            while position < length and bytes[position] >= ExpressionParserCharacter::ASCII_ZERO and bytes[position] <= ExpressionParserCharacter::ASCII_NINE:
                digit: u64 = (bytes[position] - ExpressionParserCharacter::ASCII_ZERO).u64()
                return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::LITERAL_OVERFLOW) if magnitude > (maximum - digit) / ExpressionParserArithmetic::DECIMAL_BASE
                magnitude <- magnitude * ExpressionParserArithmetic::DECIMAL_BASE + digit
                position <- position + ExpressionParserCursor::INCREMENT
            operands <- operands + ExpressionParserCursor::INCREMENT
            signed_value: mutable i64 = ExpressionParserArithmetic::ZERO
            signed_value <- ExpressionParserArithmetic::I64_MIN if negative and magnitude == ExpressionParserArithmetic::I64_MIN_LITERAL_MAGNITUDE
            signed_value <- -magnitude.i64() if negative and magnitude != ExpressionParserArithmetic::I64_MIN_LITERAL_MAGNITUDE
            signed_value <- magnitude.i64() if not negative
            return valid_node(signed_value)

        def parse_additive(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&, environment: ExpressionEnvironment) -> ExpressionParserNode:
            left: mutable ExpressionParserNode = parse_multiplicative(bytes, length, position, depth, operands, environment)
            return left if not left.valid
            while true:
                skip_whitespace(bytes, length, position)
                return left if position >= length or (bytes[position] != ExpressionParserCharacter::ASCII_PLUS and bytes[position] != ExpressionParserCharacter::ASCII_MINUS)
                operator: u8 = bytes[position]
                position <- position + ExpressionParserCursor::INCREMENT
                right: ExpressionParserNode = parse_multiplicative(bytes, length, position, depth, operands, environment)
                return right if not right.valid
                combined: mutable ExpressionParserNode = valid_node(ExpressionParserArithmetic::ZERO)
                combined <- apply_binary(DebuggerEvaluate::EvaluationKind.Add, left.value, right.value) if operator == ExpressionParserCharacter::ASCII_PLUS
                combined <- apply_binary(DebuggerEvaluate::EvaluationKind.Subtract, left.value, right.value) if operator == ExpressionParserCharacter::ASCII_MINUS
                return combined if not combined.valid
                left <- combined
            return left

        def comparison_operator_at(bytes: u8&, length: usize, position: usize) -> DebuggerEvaluate::EvaluationKind:
            return DebuggerEvaluate::EvaluationKind.CompareEqual if position + ExpressionParserCursor::INCREMENT < length and bytes[position] == ExpressionParserCharacter::ASCII_EQUALS and bytes[position + ExpressionParserCursor::INCREMENT] == ExpressionParserCharacter::ASCII_EQUALS
            return DebuggerEvaluate::EvaluationKind.CompareNotEqual if position + ExpressionParserCursor::INCREMENT < length and bytes[position] == ExpressionParserCharacter::ASCII_EXCLAMATION and bytes[position + ExpressionParserCursor::INCREMENT] == ExpressionParserCharacter::ASCII_EQUALS
            return DebuggerEvaluate::EvaluationKind.CompareLessOrEqual if position + ExpressionParserCursor::INCREMENT < length and bytes[position] == ExpressionParserCharacter::ASCII_LESS_THAN and bytes[position + ExpressionParserCursor::INCREMENT] == ExpressionParserCharacter::ASCII_EQUALS
            return DebuggerEvaluate::EvaluationKind.CompareGreaterOrEqual if position + ExpressionParserCursor::INCREMENT < length and bytes[position] == ExpressionParserCharacter::ASCII_GREATER_THAN and bytes[position + ExpressionParserCursor::INCREMENT] == ExpressionParserCharacter::ASCII_EQUALS
            return DebuggerEvaluate::EvaluationKind.CompareLess if bytes[position] == ExpressionParserCharacter::ASCII_LESS_THAN
            return DebuggerEvaluate::EvaluationKind.CompareGreater if bytes[position] == ExpressionParserCharacter::ASCII_GREATER_THAN
            return DebuggerEvaluate::EvaluationKind.Unsupported

        def comparison_operator_width(kind: DebuggerEvaluate::EvaluationKind) -> usize:
            return ExpressionParserCursor::INCREMENT if kind == DebuggerEvaluate::EvaluationKind.CompareLess or kind == DebuggerEvaluate::EvaluationKind.CompareGreater
            return ExpressionParserComparison::TWO_CHARACTER_OPERATOR_WIDTH if kind != DebuggerEvaluate::EvaluationKind.Unsupported
            return ExpressionParserComparison::NO_OPERATOR_WIDTH

        def parse_comparison(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&, environment: ExpressionEnvironment) -> ExpressionParserNode:
            left: mutable ExpressionParserNode = parse_additive(bytes, length, position, depth, operands, environment)
            return left if not left.valid
            while true:
                skip_whitespace(bytes, length, position)
                return left if position >= length
                operator: DebuggerEvaluate::EvaluationKind = comparison_operator_at(bytes, length, position)
                return left if operator == DebuggerEvaluate::EvaluationKind.Unsupported
                position <- position + comparison_operator_width(operator)
                right: ExpressionParserNode = parse_additive(bytes, length, position, depth, operands, environment)
                return right if not right.valid
                combined: ExpressionParserNode = apply_binary(operator, left.value, right.value)
                return combined if not combined.valid
                left <- combined
            return left

        def parse_equality(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&, environment: ExpressionEnvironment) -> ExpressionParserNode:
            left: mutable ExpressionParserNode = parse_comparison(bytes, length, position, depth, operands, environment)
            return left if not left.valid
            while true:
                skip_whitespace(bytes, length, position)
                return left if position >= length
                operator: DebuggerEvaluate::EvaluationKind = comparison_operator_at(bytes, length, position)
                return left if operator != DebuggerEvaluate::EvaluationKind.CompareEqual and operator != DebuggerEvaluate::EvaluationKind.CompareNotEqual
                position <- position + comparison_operator_width(operator)
                right: ExpressionParserNode = parse_comparison(bytes, length, position, depth, operands, environment)
                return right if not right.valid
                combined: ExpressionParserNode = apply_binary(operator, left.value, right.value)
                return combined if not combined.valid
                left <- combined
            return left

        def parse_multiplicative(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&, environment: ExpressionEnvironment) -> ExpressionParserNode:
            left: mutable ExpressionParserNode = parse_unary(bytes, length, position, depth, operands, environment)
            return left if not left.valid
            while true:
                skip_whitespace(bytes, length, position)
                return left if position >= length or (bytes[position] != ExpressionParserCharacter::ASCII_MULTIPLY and bytes[position] != ExpressionParserCharacter::ASCII_DIVIDE)
                operator: u8 = bytes[position]
                position <- position + ExpressionParserCursor::INCREMENT
                right: ExpressionParserNode = parse_unary(bytes, length, position, depth, operands, environment)
                return right if not right.valid
                combined: mutable ExpressionParserNode = valid_node(ExpressionParserArithmetic::ZERO)
                combined <- apply_binary(DebuggerEvaluate::EvaluationKind.Multiply, left.value, right.value) if operator == ExpressionParserCharacter::ASCII_MULTIPLY
                combined <- apply_binary(DebuggerEvaluate::EvaluationKind.Divide, left.value, right.value) if operator == ExpressionParserCharacter::ASCII_DIVIDE
                return combined if not combined.valid
                left <- combined
            return left

        def parse_unary(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&, environment: ExpressionEnvironment) -> ExpressionParserNode:
            skip_whitespace(bytes, length, position)
            if position < length and bytes[position] == ExpressionParserCharacter::ASCII_MINUS:
                position <- position + ExpressionParserCursor::INCREMENT
                skip_whitespace(bytes, length, position)
                if position < length and bytes[position] >= ExpressionParserCharacter::ASCII_ZERO and bytes[position] <= ExpressionParserCharacter::ASCII_NINE:
                    return parse_integer_literal(bytes, length, position, operands, true)
                operand: ExpressionParserNode = parse_unary(bytes, length, position, depth, operands, environment)
                return operand if not operand.valid
                return apply_binary(DebuggerEvaluate::EvaluationKind.Negate, operand.value, ExpressionParserArithmetic::ZERO)
            return parse_primary(bytes, length, position, depth, operands, environment)

        def parse_primary(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&, environment: ExpressionEnvironment) -> ExpressionParserNode:
            skip_whitespace(bytes, length, position)
            return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::EXPECTED_VALUE) if position >= length
            if bytes[position] == ExpressionParserCharacter::ASCII_OPEN_PARENTHESIS:
                return invalid_node(DebuggerErrors::ErrorCode.ResourceLimit, true, ExpressionParserDetail::NESTING_LIMIT) if depth >= ExpressionParserBounds::MAX_NESTING_DEPTH
                position <- position + ExpressionParserCursor::INCREMENT
                nested: ExpressionParserNode = parse_equality(bytes, length, position, depth + ExpressionParserCursor::INCREMENT, operands, environment)
                return nested if not nested.valid
                skip_whitespace(bytes, length, position)
                return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::EXPECTED_CLOSE_PARENTHESIS) if position >= length or bytes[position] != ExpressionParserCharacter::ASCII_CLOSE_PARENTHESIS
                position <- position + ExpressionParserCursor::INCREMENT
                return nested
            return parse_integer_literal(bytes, length, position, operands, false) if bytes[position] >= ExpressionParserCharacter::ASCII_ZERO and bytes[position] <= ExpressionParserCharacter::ASCII_NINE
            return parse_identifier(bytes, length, position, operands, environment) if identifier_start_is_valid(bytes[position])
            return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::EXPECTED_VALUE)

        def parse_failure(value: DebuggerErrors::DebuggerError, consumed: usize) -> ExpressionParseResult:
            return ExpressionParseResult{value: ExpressionParserArithmetic::ZERO, consumed: consumed, valid: false, failure: value}

        def expression_parse_internal(bytes: u8&, length: usize, environment: ExpressionEnvironment) -> ExpressionParseResult:
            return parse_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ExpressionParserDetail::INVALID_ENVIRONMENT), ExpressionParserBounds::ROOT_DEPTH) if not environment_is_valid(environment)
            return parse_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ExpressionParserDetail::SOURCE_TOO_LONG), ExpressionParserBounds::MAX_SOURCE_BYTES) if length > ExpressionParserBounds::MAX_SOURCE_BYTES
            position: mutable usize = 0
            operands: mutable usize = 0
            skip_whitespace(bytes, length, position)
            return parse_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::EMPTY_INPUT), position) if position >= length
            expression: ExpressionParserNode = parse_equality(bytes, length, position, ExpressionParserBounds::ROOT_DEPTH, operands, environment)
            return parse_failure(expression.failure, position) if not expression.valid
            skip_whitespace(bytes, length, position)
            return parse_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::TRAILING_INPUT), position) if position != length
            return ExpressionParseResult{value: expression.value, consumed: position, valid: true, failure: DebuggerErrors::no_error()}

    public:
        struct ExpressionBinding:
            name: mutable u8[ExpressionParserBounds::MAX_IDENTIFIER_BYTES]
            name_length: mutable usize
            value: mutable i64
            available: mutable bool

        struct ExpressionEnvironment:
            bindings: mutable ExpressionBinding[ExpressionParserBounds::MAX_BINDINGS]
            count: mutable usize

        struct ExpressionParseResult:
            value: mutable i64
            consumed: mutable usize
            valid: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def expression_environment_new() -> ExpressionEnvironment:
            return zeroed

        def expression_environment_add(environment: mutable ExpressionEnvironment&, name: u8&, name_length: usize, value: i64, available: bool) -> bool:
            return false if environment.count >= ExpressionParserBounds::MAX_BINDINGS or name_length == ExpressionParserBounds::EMPTY_IDENTIFIER_BYTES or name_length > ExpressionParserBounds::MAX_IDENTIFIER_BYTES or not identifier_start_is_valid(name[ExpressionParserCursor::FIRST_INDEX])
            for index in ExpressionParserCursor::INCREMENT..<name_length:
                return false if not identifier_continue_is_valid(name[index])
            for index in ExpressionParserCursor::FIRST_INDEX..<environment.count:
                return false if binding_name_matches(environment.bindings[index], name, ExpressionParserCursor::FIRST_INDEX, name_length)
            binding: mutable ExpressionBinding = zeroed
            for index in ExpressionParserCursor::FIRST_INDEX..<name_length:
                binding.name[index] <- name[index]
            binding.name_length <- name_length
            binding.value <- value
            binding.available <- available
            environment.bindings[environment.count] <- binding
            environment.count <- environment.count + ExpressionParserCursor::INCREMENT
            return true

        def expression_parse(bytes: u8&, length: usize) -> ExpressionParseResult:
            environment: ExpressionEnvironment = expression_environment_new()
            return expression_parse_internal(bytes, length, environment)

        def expression_parse_with_environment(bytes: u8&, length: usize, environment: ExpressionEnvironment) -> ExpressionParseResult:
            return expression_parse_internal(bytes, length, environment)
