# Bounded, side-effect-free arithmetic expressions for debugger adapters.
#
# The parser intentionally accepts only decimal integer literals, whitespace,
# unary minus, the four arithmetic operators, and parentheses. It evaluates
# each checked operation immediately through the pure AST evaluator, so this
# module has no access to a machine, value store, process, or replay state.

include "./evaluate.elisa"
include "../core/errors.elisa"

module DebuggerExpressionParser:
    private:
        const module ExpressionParserBounds:
            MAX_SOURCE_BYTES: usize = 256
            MAX_NESTING_DEPTH: usize = 32
            MAX_OPERAND_COUNT: usize = 32
            ROOT_DEPTH: usize = 0

        const module ExpressionParserCursor:
            INCREMENT: usize = 1

        const module ExpressionParserCharacter:
            ASCII_SPACE: u8 = 32
            ASCII_TAB: u8 = 9
            ASCII_LINE_FEED: u8 = 10
            ASCII_CARRIAGE_RETURN: u8 = 13
            ASCII_ZERO: u8 = 48
            ASCII_NINE: u8 = 57
            ASCII_PLUS: u8 = 43
            ASCII_MINUS: u8 = 45
            ASCII_MULTIPLY: u8 = 42
            ASCII_DIVIDE: u8 = 47
            ASCII_OPEN_PARENTHESIS: u8 = 40
            ASCII_CLOSE_PARENTHESIS: u8 = 41

        const module ExpressionParserArithmetic:
            DECIMAL_BASE: i64 = 10
            I64_MAX: i64 = 9223372036854775807
            EVALUATION_BUDGET: usize = 2
            ZERO: i64 = 0

        const module ExpressionParserDetail:
            EMPTY_INPUT: u32 = 1
            EXPECTED_VALUE: u32 = 2
            EXPECTED_CLOSE_PARENTHESIS: u32 = 3
            TRAILING_INPUT: u32 = 4
            LITERAL_OVERFLOW: u32 = 5
            SOURCE_TOO_LONG: u32 = 6
            NESTING_LIMIT: u32 = 7
            OPERAND_LIMIT: u32 = 8

        struct ExpressionParserNode:
            value: mutable i64
            valid: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def invalid_node(code: DebuggerErrors::ErrorCode, retryable: bool, detail: u32) -> ExpressionParserNode:
            return ExpressionParserNode{value: ExpressionParserArithmetic::ZERO, valid: false, failure: DebuggerErrors::make_error(code, retryable, detail)}

        def valid_node(value: i64) -> ExpressionParserNode:
            return ExpressionParserNode{value: value, valid: true, failure: DebuggerErrors::no_error()}

        def is_whitespace(byte: u8) -> bool:
            return byte == ExpressionParserCharacter::ASCII_SPACE or byte == ExpressionParserCharacter::ASCII_TAB or byte == ExpressionParserCharacter::ASCII_LINE_FEED or byte == ExpressionParserCharacter::ASCII_CARRIAGE_RETURN

        def skip_whitespace(bytes: u8&, length: usize, position: mutable usize&) -> void:
            while position < length and is_whitespace(bytes[position]):
                position <- position + ExpressionParserCursor::INCREMENT

        def apply_binary(kind: DebuggerEvaluate::EvaluationKind, left: i64, right: i64) -> ExpressionParserNode:
            expression: DebuggerEvaluate::Expression = DebuggerEvaluate::Expression{kind: kind, left: left, right: right, binding: zeroed}
            evaluation: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(expression, ExpressionParserArithmetic::EVALUATION_BUDGET)
            return invalid_node(evaluation.failure.code, evaluation.failure.retryable, evaluation.failure.detail) if not DebuggerErrors::error_is_ok(evaluation.failure)
            return valid_node(evaluation.value)

        def parse_additive(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&) -> ExpressionParserNode:
            left: mutable ExpressionParserNode = parse_multiplicative(bytes, length, position, depth, operands)
            return left if not left.valid
            while true:
                skip_whitespace(bytes, length, position)
                return left if position >= length or (bytes[position] != ExpressionParserCharacter::ASCII_PLUS and bytes[position] != ExpressionParserCharacter::ASCII_MINUS)
                operator: u8 = bytes[position]
                position <- position + ExpressionParserCursor::INCREMENT
                right: ExpressionParserNode = parse_multiplicative(bytes, length, position, depth, operands)
                return right if not right.valid
                combined: mutable ExpressionParserNode = valid_node(ExpressionParserArithmetic::ZERO)
                combined <- apply_binary(DebuggerEvaluate::EvaluationKind.Add, left.value, right.value) if operator == ExpressionParserCharacter::ASCII_PLUS
                combined <- apply_binary(DebuggerEvaluate::EvaluationKind.Subtract, left.value, right.value) if operator == ExpressionParserCharacter::ASCII_MINUS
                return combined if not combined.valid
                left <- combined
            return left

        def parse_multiplicative(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&) -> ExpressionParserNode:
            left: mutable ExpressionParserNode = parse_unary(bytes, length, position, depth, operands)
            return left if not left.valid
            while true:
                skip_whitespace(bytes, length, position)
                return left if position >= length or (bytes[position] != ExpressionParserCharacter::ASCII_MULTIPLY and bytes[position] != ExpressionParserCharacter::ASCII_DIVIDE)
                operator: u8 = bytes[position]
                position <- position + ExpressionParserCursor::INCREMENT
                right: ExpressionParserNode = parse_unary(bytes, length, position, depth, operands)
                return right if not right.valid
                combined: mutable ExpressionParserNode = valid_node(ExpressionParserArithmetic::ZERO)
                combined <- apply_binary(DebuggerEvaluate::EvaluationKind.Multiply, left.value, right.value) if operator == ExpressionParserCharacter::ASCII_MULTIPLY
                combined <- apply_binary(DebuggerEvaluate::EvaluationKind.Divide, left.value, right.value) if operator == ExpressionParserCharacter::ASCII_DIVIDE
                return combined if not combined.valid
                left <- combined
            return left

        def parse_unary(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&) -> ExpressionParserNode:
            skip_whitespace(bytes, length, position)
            if position < length and bytes[position] == ExpressionParserCharacter::ASCII_MINUS:
                position <- position + ExpressionParserCursor::INCREMENT
                operand: ExpressionParserNode = parse_unary(bytes, length, position, depth, operands)
                return operand if not operand.valid
                return apply_binary(DebuggerEvaluate::EvaluationKind.Negate, operand.value, ExpressionParserArithmetic::ZERO)
            return parse_primary(bytes, length, position, depth, operands)

        def parse_primary(bytes: u8&, length: usize, position: mutable usize&, depth: usize, operands: mutable usize&) -> ExpressionParserNode:
            skip_whitespace(bytes, length, position)
            return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::EXPECTED_VALUE) if position >= length
            if bytes[position] == ExpressionParserCharacter::ASCII_OPEN_PARENTHESIS:
                return invalid_node(DebuggerErrors::ErrorCode.ResourceLimit, true, ExpressionParserDetail::NESTING_LIMIT) if depth >= ExpressionParserBounds::MAX_NESTING_DEPTH
                position <- position + ExpressionParserCursor::INCREMENT
                nested: ExpressionParserNode = parse_additive(bytes, length, position, depth + ExpressionParserCursor::INCREMENT, operands)
                return nested if not nested.valid
                skip_whitespace(bytes, length, position)
                return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::EXPECTED_CLOSE_PARENTHESIS) if position >= length or bytes[position] != ExpressionParserCharacter::ASCII_CLOSE_PARENTHESIS
                position <- position + ExpressionParserCursor::INCREMENT
                return nested
            return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::EXPECTED_VALUE) if bytes[position] < ExpressionParserCharacter::ASCII_ZERO or bytes[position] > ExpressionParserCharacter::ASCII_NINE
            return invalid_node(DebuggerErrors::ErrorCode.ResourceLimit, true, ExpressionParserDetail::OPERAND_LIMIT) if operands >= ExpressionParserBounds::MAX_OPERAND_COUNT
            value: mutable i64 = ExpressionParserArithmetic::ZERO
            while position < length and bytes[position] >= ExpressionParserCharacter::ASCII_ZERO and bytes[position] <= ExpressionParserCharacter::ASCII_NINE:
                digit: i64 = (bytes[position] - ExpressionParserCharacter::ASCII_ZERO).i64()
                return invalid_node(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::LITERAL_OVERFLOW) if value > (ExpressionParserArithmetic::I64_MAX - digit) / ExpressionParserArithmetic::DECIMAL_BASE
                value <- value * ExpressionParserArithmetic::DECIMAL_BASE + digit
                position <- position + ExpressionParserCursor::INCREMENT
            operands <- operands + ExpressionParserCursor::INCREMENT
            return valid_node(value)

        def parse_failure(value: DebuggerErrors::DebuggerError, consumed: usize) -> ExpressionParseResult:
            return ExpressionParseResult{value: ExpressionParserArithmetic::ZERO, consumed: consumed, valid: false, failure: value}

    public:
        struct ExpressionParseResult:
            value: mutable i64
            consumed: mutable usize
            valid: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def expression_parse(bytes: u8&, length: usize) -> ExpressionParseResult:
            return parse_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ExpressionParserDetail::SOURCE_TOO_LONG), ExpressionParserBounds::MAX_SOURCE_BYTES) if length > ExpressionParserBounds::MAX_SOURCE_BYTES
            position: mutable usize = 0
            operands: mutable usize = 0
            skip_whitespace(bytes, length, position)
            return parse_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::EMPTY_INPUT), position) if position >= length
            expression: ExpressionParserNode = parse_additive(bytes, length, position, ExpressionParserBounds::ROOT_DEPTH, operands)
            return parse_failure(expression.failure, position) if not expression.valid
            skip_whitespace(bytes, length, position)
            return parse_failure(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ExpressionParserDetail::TRAILING_INPUT), position) if position != length
            return ExpressionParseResult{value: expression.value, consumed: position, valid: true, failure: DebuggerErrors::no_error()}
