# Native and managed location descriptors.  A value is unavailable when none
# of its pieces are live at the selected position; stale memory is never used.

module DebuggerLocations:
    public:
        enum LocationKind:
            Unavailable
            Constant
            Register
            Stack
            Heap
            Composite

        struct Location:
            kind: mutable LocationKind
            register: mutable u32
            offset: mutable i64
            size: mutable u64
            lifetime_start: mutable u64
            lifetime_end: mutable u64

        def unavailable_location() -> Location:
            return Location{kind: LocationKind.Unavailable, register: 0, offset: 0, size: 0, lifetime_start: 0, lifetime_end: 0}

        def location_is_live(location: Location, event: u64) -> bool:
            return location.kind != LocationKind.Unavailable and event >= location.lifetime_start and (location.lifetime_end == 0 or event < location.lifetime_end)

        def location_is_addressable(location: Location) -> bool:
            return location.kind == LocationKind.Stack or location.kind == LocationKind.Heap
