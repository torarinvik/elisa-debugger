# Provider-neutral managed inspection.  Adapters can expose these bounded
# snapshots through DAP, the session service, or a CLI without reading VM
# internals or inventing handles in the host language.

include "../replay/engine.elisa"
include "../core/identity.elisa"

module DebuggerManagedInspection:
    private:
        const module Bounds:
            MAX_FRAME_ID: u64 = 18446744073709551615

        const module First:
            INSPECT_MANAGED_FIRST_LOCAL_INDEX: usize = 0

        const module Frame:
            INSPECT_MANAGED_FRAME_ID_OFFSET: u64 = 1
            INSPECT_MANAGED_FIRST_FRAME_INDEX: usize = 0

        const module Global:
            INSPECT_MANAGED_GLOBAL_PAGE_CAPACITY: usize = 16
            FIRST_GLOBAL_INDEX: usize = 0
            UNBOUNDED_GLOBAL_REQUEST: usize = 0

        const module Local:
            INSPECT_MANAGED_LOCAL_PAGE_CAPACITY: usize = 32
            UNBOUNDED_LOCAL_REQUEST: usize = 0

        const module Sentinel:
            NEXT_LOCAL: usize = 0


        def frame_id_for_instruction(program_counter: u64) -> DebuggerIdentity::DebugId:
            return DebuggerIdentity::debug_id(Bounds::MAX_FRAME_ID) if program_counter == Bounds::MAX_FRAME_ID
            return DebuggerIdentity::debug_id(program_counter + Frame::INSPECT_MANAGED_FRAME_ID_OFFSET)

    public:
        def local_page_capacity() -> usize:
            return Local::INSPECT_MANAGED_LOCAL_PAGE_CAPACITY

        struct FrameSnapshot:
            id: mutable DebuggerIdentity::DebugId
            instruction: mutable DebuggerIdentity::DebugId
            event: mutable u64
            accumulator: mutable i64
            result: mutable i64
            return_depth: mutable usize

        struct LocalSnapshot:
            index: mutable usize
            value: mutable i64
            available: mutable bool

        struct LocalPage:
            entries: mutable LocalSnapshot[Local::INSPECT_MANAGED_LOCAL_PAGE_CAPACITY]
            count: mutable usize
            next: mutable usize
            complete: mutable bool


        def current_frame(engine: mutable DebuggerReplayEngine::ReplayEngine&) -> FrameSnapshot:
            return FrameSnapshot{id: frame_id_for_instruction(engine.machine.program_counter), instruction: DebuggerIdentity::debug_id(engine.machine.program_counter), event: engine.event_count.u64(), accumulator: engine.machine.accumulator, result: engine.machine.result, return_depth: engine.machine.return_stack_pointer}

        def locals_page_for_frame(engine: mutable DebuggerReplayEngine::ReplayEngine&, frame_index: usize, offset: usize, requested: usize) -> LocalPage:
            page: mutable LocalPage = zeroed
            if engine.machine.return_stack_pointer > DebuggerEDIR::call_depth_capacity() or frame_index > engine.machine.return_stack_pointer:
                page.complete <- true
                return page
            limit: mutable usize = requested
            limit <- Local::INSPECT_MANAGED_LOCAL_PAGE_CAPACITY if requested == Local::UNBOUNDED_LOCAL_REQUEST or requested > Local::INSPECT_MANAGED_LOCAL_PAGE_CAPACITY
            available: usize = engine.image.program.local_count.usize() if engine.image.program.local_count <= Local::INSPECT_MANAGED_LOCAL_PAGE_CAPACITY.u64() else Local::INSPECT_MANAGED_LOCAL_PAGE_CAPACITY
            if offset >= available:
                page.next <- Sentinel::NEXT_LOCAL
                page.complete <- true
                return page
            remaining: usize = available - offset
            count: usize = limit if limit < remaining else remaining
            for index in First::INSPECT_MANAGED_FIRST_LOCAL_INDEX..<count:
                local_index: usize = offset + index
                if frame_index == Frame::INSPECT_MANAGED_FIRST_FRAME_INDEX:
                    page.entries[index] <- LocalSnapshot{index: local_index, value: engine.machine.locals[local_index], available: engine.machine.locals_initialized[local_index]}
                else:
                    frame_depth: usize = engine.machine.return_stack_pointer - frame_index
                    slot: usize = DebuggerEDIR::frame_local_slot(frame_depth, local_index)
                    page.entries[index] <- LocalSnapshot{index: local_index, value: engine.machine.frame_locals[slot], available: engine.machine.frame_locals_initialized[slot]}
            page.count <- count
            page.next <- offset + count if offset + count < available else Sentinel::NEXT_LOCAL
            page.complete <- page.next == Sentinel::NEXT_LOCAL
            return page

        def locals_page(engine: mutable DebuggerReplayEngine::ReplayEngine&, offset: usize, requested: usize) -> LocalPage:
            return locals_page_for_frame(engine, Frame::INSPECT_MANAGED_FIRST_FRAME_INDEX, offset, requested)

        def globals_page(engine: mutable DebuggerReplayEngine::ReplayEngine&, offset: usize, requested: usize) -> LocalPage:
            page: mutable LocalPage = zeroed
            limit: mutable usize = requested
            limit <- Global::INSPECT_MANAGED_GLOBAL_PAGE_CAPACITY if requested == Global::UNBOUNDED_GLOBAL_REQUEST or requested > Global::INSPECT_MANAGED_GLOBAL_PAGE_CAPACITY
            if offset >= Global::INSPECT_MANAGED_GLOBAL_PAGE_CAPACITY:
                page.next <- Sentinel::NEXT_LOCAL
                page.complete <- true
                return page
            remaining: usize = Global::INSPECT_MANAGED_GLOBAL_PAGE_CAPACITY - offset
            count: usize = limit if limit < remaining else remaining
            for index in Global::FIRST_GLOBAL_INDEX..<count:
                global_index: usize = offset + index
                page.entries[index] <- LocalSnapshot{index: global_index, value: engine.machine.globals[global_index], available: engine.machine.globals_initialized[global_index]}
            page.count <- count
            page.next <- offset + count if offset + count < Global::INSPECT_MANAGED_GLOBAL_PAGE_CAPACITY else Sentinel::NEXT_LOCAL
            page.complete <- page.next == Sentinel::NEXT_LOCAL
            return page

        def frame_is_current(frame: FrameSnapshot, engine: DebuggerReplayEngine::ReplayEngine) -> bool:
            return frame.id.value == frame_id_for_instruction(engine.machine.program_counter).value and frame.event == engine.event_count.u64() and frame.instruction.value == engine.machine.program_counter and frame.accumulator == engine.machine.accumulator and frame.result == engine.machine.result and frame.return_depth == engine.machine.return_stack_pointer
