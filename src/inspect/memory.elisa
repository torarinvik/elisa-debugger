# Bounded managed-memory inspection.  Addresses are logical byte offsets into
# initialized EDIR storage; host pointers are never exposed through the API.

include "../vm/edir.elisa"
include "../core/errors.elisa"

module DebuggerMemory:
    private:
        const MEMORY_CELL_CAPACITY: usize = 64
        const MEMORY_CELL_BYTES: usize = 8
        const MEMORY_CALL_DEPTH_CAPACITY: usize = 16
        const MEMORY_READ_CAPACITY: usize = 64
        const MEMORY_MAX_BYTES: u64 = MEMORY_CELL_CAPACITY.u64() * MEMORY_CELL_BYTES.u64()
        const MEMORY_BYTE_BITS: u64 = 8
        const MEMORY_BYTE_MASK: u64 = 255
        const DETAIL_ADDRESS: u32 = 1
        const DETAIL_LENGTH: u32 = 2
        const DETAIL_UNINITIALIZED: u32 = 3
        const DETAIL_MACHINE: u32 = 4

    public:
        enum MemoryState:
            Available
            Unavailable
            Invalid

        struct MemoryRead:
            address: mutable u64
            bytes: mutable u8[MEMORY_READ_CAPACITY]
            length: mutable usize
            state: mutable MemoryState
            failure: mutable DebuggerErrors::DebuggerError

        def memory_read_invalid(address: u64, state: MemoryState, failure: DebuggerErrors::DebuggerError) -> MemoryRead:
            return MemoryRead{address: address, bytes: zeroed, length: 0, state: state, failure: failure}

        def memory_read_managed(machine: DebuggerEDIR::Machine, address: u64, length: usize) -> MemoryRead:
            return memory_read_invalid(address, MemoryState.Invalid, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, DETAIL_LENGTH)) if length > MEMORY_READ_CAPACITY
            return memory_read_invalid(address, MemoryState.Invalid, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_ADDRESS)) if address > MEMORY_MAX_BYTES
            return memory_read_invalid(address, MemoryState.Invalid, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_ADDRESS)) if length.u64() > MEMORY_MAX_BYTES - address
            return memory_read_invalid(address, MemoryState.Invalid, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_MACHINE)) if machine.heap_next > MEMORY_CELL_CAPACITY or machine.return_stack_pointer > MEMORY_CALL_DEPTH_CAPACITY
            for offset in 0..<length:
                absolute: u64 = address + offset.u64()
                cell: usize = (absolute / MEMORY_CELL_BYTES.u64()).usize()
                return memory_read_invalid(address, MemoryState.Unavailable, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNINITIALIZED)) if not machine.memory_initialized[cell]
            result: mutable MemoryRead = MemoryRead{address: address, bytes: zeroed, length: length, state: MemoryState.Available, failure: DebuggerErrors::no_error()}
            for offset in 0..<length:
                absolute: u64 = address + offset.u64()
                cell: usize = (absolute / MEMORY_CELL_BYTES.u64()).usize()
                shift: u64 = (absolute % MEMORY_CELL_BYTES.u64()) * MEMORY_BYTE_BITS
                result.bytes[offset] <- ((machine.memory[cell].u64() >> shift) & MEMORY_BYTE_MASK).u8()
            return result

        def memory_read_is_available(read: MemoryRead) -> bool:
            return read.state == MemoryState.Available and read.length <= MEMORY_READ_CAPACITY and DebuggerErrors::error_is_ok(read.failure)
