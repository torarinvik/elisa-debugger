# Source/debug metadata is content-addressed and retains include provenance.

include "../core/identity.elisa"

module DebuggerMetadata:
    private:
        const SOURCE_NO_FILE: u64 = 0
        const SOURCE_NO_LINE: u32 = 0

    public:
        struct SourceFile:
            id: mutable DebuggerIdentity::DebugId
            logical_path: mutable DebuggerIdentity::DebugId
            content: mutable DebuggerIdentity::DebugId
            line_count: mutable u64
            embedded: mutable bool

        struct FunctionInfo:
            id: mutable DebuggerIdentity::DebugId
            source: mutable DebuggerIdentity::SourceSpan
            name: mutable DebuggerIdentity::DebugId
            inline_parent: mutable DebuggerIdentity::DebugId
            generic_instance: mutable DebuggerIdentity::DebugId

        enum BreakpointResolution:
            Unresolved
            Resolved
            PartiallyResolved
            Invalid

        struct SourceLocation:
            file: mutable DebuggerIdentity::DebugId
            line: mutable u32
            column: mutable u32
            discriminator: mutable u32

        def source_span_contains(span: DebuggerIdentity::SourceSpan, location: SourceLocation) -> bool:
            return false if not source_span_is_valid(span) or not source_location_is_valid(location)
            return false if span.start_line == span.end_line and span.end_column < span.start_column
            return false if span.file.value != location.file.value
            return false if span.discriminator != 0 and location.discriminator != 0 and span.discriminator != location.discriminator
            return false if location.line < span.start_line or location.line > span.end_line
            return false if location.line == span.start_line and location.column < span.start_column
            return false if location.line == span.end_line and location.column >= span.end_column
            return true

        def source_span_is_valid(span: DebuggerIdentity::SourceSpan) -> bool:
            return false if span.file.value == SOURCE_NO_FILE or span.start_line == SOURCE_NO_LINE or span.end_line == SOURCE_NO_LINE
            return false if span.end_byte < span.start_byte or span.end_line < span.start_line
            return false if span.start_line == span.end_line and span.end_column < span.start_column
            return true

        def source_location_is_valid(location: SourceLocation) -> bool:
            return location.file.value != SOURCE_NO_FILE and location.line != SOURCE_NO_LINE

        def source_file_is_valid(file: SourceFile) -> bool:
            return file.id.value != SOURCE_NO_FILE and file.logical_path.value != SOURCE_NO_FILE and file.content.value != SOURCE_NO_FILE and file.line_count > 0

        def function_info_is_valid(function: FunctionInfo) -> bool:
            return function.id.value != SOURCE_NO_FILE and source_span_is_valid(function.source)
