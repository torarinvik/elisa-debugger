# Source/debug metadata is content-addressed and retains include provenance.

include "../core/identity.elisa"

const module DebuggerMetadataSourcePath:
    SOURCE_PATH_CAPACITY: usize = 1024
    SOURCE_PATH_SEPARATOR_COUNT: usize = 1
    MAPPED_SOURCE_PATH_CAPACITY: usize = SOURCE_PATH_CAPACITY * 2 + SOURCE_PATH_SEPARATOR_COUNT

module DebuggerMetadata:
    private:
        const module Mapped:
            METADATA_SOURCE_MAPPED_SOURCE_PATH_CAPACITY: usize = DebuggerMetadataSourcePath::MAPPED_SOURCE_PATH_CAPACITY

        const module Source:
            NO_FILE: u64 = 0
            METADATA_SOURCE_NO_LINE: u32 = 0
            PATH_EMPTY: usize = 0
            PATH_ASCII_MAX: u64 = 127
            PATH_UTF8_CONTINUATION_BASE: u64 = 128
            PATH_UTF8_CONTINUATION_MAX: u64 = 191
            PATH_UTF8_CONTINUATION_MASK: u64 = 63
            PATH_UTF8_SHIFT: u64 = 6
            PATH_UTF8_FIRST_TWO_MASK: u64 = 31
            PATH_UTF8_FIRST_THREE_MASK: u64 = 15
            PATH_UTF8_FIRST_FOUR_MASK: u64 = 7
            PATH_UTF8_TWO_BYTE_START: u64 = 194
            PATH_UTF8_TWO_BYTE_END: u64 = 223
            PATH_UTF8_THREE_BYTE_START: u64 = 224
            PATH_UTF8_THREE_BYTE_END: u64 = 239
            PATH_UTF8_FOUR_BYTE_START: u64 = 240
            PATH_UTF8_FOUR_BYTE_END: u64 = 244
            PATH_UTF8_TWO_BYTE_MIN: u64 = 128
            PATH_UTF8_THREE_BYTE_MIN: u64 = 2048
            PATH_UTF8_FOUR_BYTE_MIN: u64 = 65536
            PATH_UNICODE_MAX: u64 = 1114111
            PATH_SURROGATE_START: u64 = 55296
            PATH_SURROGATE_END: u64 = 57343
            PATH_ASCII_CONTROL_MAX: u64 = 31
            PATH_DELETE: u64 = 127
            PATH_C1_CONTROL_MAX: u64 = 159
            PATH_SLASH: u8 = 47
            PATH_BACKSLASH: u8 = 92
            PATH_COLON: u8 = 58
            PATH_DOT: u8 = 46
            PATH_SPACE: u8 = 32
            PATH_UPPER_A: u8 = 65
            PATH_UPPER_Z: u8 = 90
            PATH_LOWER_A: u8 = 97
            PATH_LOWER_Z: u8 = 122
            PATH_SINGLE_DOT_LENGTH: usize = 1
            PATH_PARENT_SEGMENT_LENGTH: usize = 2
            METADATA_SOURCE_PATH_CAPACITY: usize = DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
            PATH_SEPARATOR_COUNT: usize = DebuggerMetadataSourcePath::SOURCE_PATH_SEPARATOR_COUNT


    public:

        struct SourceFile:
            id: mutable DebuggerIdentity::DebugId
            logical_path: mutable DebuggerIdentity::DebugId
            content: mutable DebuggerIdentity::DebugId
            line_count: mutable u64
            path_bytes: mutable u8[Source::METADATA_SOURCE_PATH_CAPACITY]
            path_length: mutable usize

        struct FunctionInfo:
            id: mutable DebuggerIdentity::DebugId
            source: mutable DebuggerIdentity::SourceSpan
            name: mutable DebuggerIdentity::DebugId
            inline_parent: mutable DebuggerIdentity::DebugId
            generic_instance: mutable DebuggerIdentity::DebugId

        enum BreakpointResolution:
            Unresolved
            Resolved
            PartiallyResolved
            Invalid

        struct SourceLocation:
            file: mutable DebuggerIdentity::DebugId
            line: mutable u32
            column: mutable u32
            discriminator: mutable u32

        def source_span_contains(span: DebuggerIdentity::SourceSpan, location: SourceLocation) -> bool:
            return false if not source_span_is_valid(span) or not source_location_is_valid(location)
            return false if span.start_line == span.end_line and span.end_column < span.start_column
            return false if span.file.value != location.file.value
            return false if span.discriminator != 0 and location.discriminator != 0 and span.discriminator != location.discriminator
            return false if location.line < span.start_line or location.line > span.end_line
            return false if location.line == span.start_line and location.column < span.start_column
            return false if location.line == span.end_line and location.column >= span.end_column
            return true

        def source_span_is_valid(span: DebuggerIdentity::SourceSpan) -> bool:
            return false if span.file.value == Source::NO_FILE or span.start_line == Source::METADATA_SOURCE_NO_LINE or span.end_line == Source::METADATA_SOURCE_NO_LINE
            return false if span.end_byte < span.start_byte or span.end_line < span.start_line
            return false if span.start_line == span.end_line and span.end_column < span.start_column
            return true

        def source_location_is_valid(location: SourceLocation) -> bool:
            return location.file.value != Source::NO_FILE and location.line != Source::METADATA_SOURCE_NO_LINE

        def source_path_capacity() -> usize:
            return Source::METADATA_SOURCE_PATH_CAPACITY

        def metadata_text_utf8_is_valid(bytes: u8&, text_length: usize, maximum_length: usize) -> bool:
            return false if text_length > maximum_length
            index: mutable usize = 0
            while index < text_length:
                first: u64 = bytes[index].u64()
                sequence_length: mutable usize = 1
                minimum_codepoint: mutable u64 = 0
                codepoint: mutable u64 = first
                if first > Source::PATH_ASCII_MAX:
                    if first >= Source::PATH_UTF8_TWO_BYTE_START and first <= Source::PATH_UTF8_TWO_BYTE_END:
                        sequence_length <- 2
                        minimum_codepoint <- Source::PATH_UTF8_TWO_BYTE_MIN
                        codepoint <- first & Source::PATH_UTF8_FIRST_TWO_MASK
                    if first >= Source::PATH_UTF8_THREE_BYTE_START and first <= Source::PATH_UTF8_THREE_BYTE_END:
                        sequence_length <- 3
                        minimum_codepoint <- Source::PATH_UTF8_THREE_BYTE_MIN
                        codepoint <- first & Source::PATH_UTF8_FIRST_THREE_MASK
                    if first >= Source::PATH_UTF8_FOUR_BYTE_START and first <= Source::PATH_UTF8_FOUR_BYTE_END:
                        sequence_length <- 4
                        minimum_codepoint <- Source::PATH_UTF8_FOUR_BYTE_MIN
                        codepoint <- first & Source::PATH_UTF8_FIRST_FOUR_MASK
                    return false if sequence_length == 1 or sequence_length > text_length - index
                    for continuation_index in 1..<sequence_length:
                        continuation: u64 = bytes[index + continuation_index].u64()
                        return false if continuation < Source::PATH_UTF8_CONTINUATION_BASE or continuation > Source::PATH_UTF8_CONTINUATION_MAX
                        codepoint <- (codepoint << Source::PATH_UTF8_SHIFT) | (continuation & Source::PATH_UTF8_CONTINUATION_MASK)
                    return false if codepoint < minimum_codepoint or codepoint > Source::PATH_UNICODE_MAX
                    return false if codepoint >= Source::PATH_SURROGATE_START and codepoint <= Source::PATH_SURROGATE_END
                return false if codepoint <= Source::PATH_ASCII_CONTROL_MAX or codepoint >= Source::PATH_DELETE and codepoint <= Source::PATH_C1_CONTROL_MAX
                index <- index + sequence_length
            return true

        def source_path_utf8_is_valid(bytes: u8&, path_length: usize) -> bool:
            return metadata_text_utf8_is_valid(bytes, path_length, Source::METADATA_SOURCE_PATH_CAPACITY)

        def source_path_has_drive_prefix(file: SourceFile) -> bool:
            return false if file.path_length <= Source::PATH_SINGLE_DOT_LENGTH
            if file.path_length > Source::PATH_SINGLE_DOT_LENGTH and file.path_bytes[Source::PATH_SINGLE_DOT_LENGTH] == Source::PATH_COLON:
                first: u8 = file.path_bytes[0]
                return first >= Source::PATH_UPPER_A and first <= Source::PATH_UPPER_Z or first >= Source::PATH_LOWER_A and first <= Source::PATH_LOWER_Z
            return false

        def source_path_segment_is_parent(file: SourceFile, start: usize, end: usize) -> bool:
            return false if end - start < Source::PATH_PARENT_SEGMENT_LENGTH
            return false if file.path_bytes[start] != Source::PATH_DOT or file.path_bytes[start + 1] != Source::PATH_DOT
            return true if end - start == Source::PATH_PARENT_SEGMENT_LENGTH
            padded_parent: mutable bool = true
            has_trailing_space: mutable bool = false
            for index in start + Source::PATH_PARENT_SEGMENT_LENGTH..<end:
                byte: u8 = file.path_bytes[index]
                padded_parent <- false if byte != Source::PATH_DOT and byte != Source::PATH_SPACE
                has_trailing_space <- true if byte == Source::PATH_SPACE
            return padded_parent and has_trailing_space

        def source_path_segments_are_normalized(file: SourceFile) -> bool:
            return false if file.path_bytes[0] == Source::PATH_SLASH or file.path_bytes[file.path_length - 1] == Source::PATH_SLASH or source_path_has_drive_prefix(file)
            segment_start: mutable usize = 0
            for index in 0..<file.path_length:
                byte: u8 = file.path_bytes[index]
                return false if byte == Source::PATH_BACKSLASH
                if byte == Source::PATH_SLASH:
                    segment_length: usize = index - segment_start
                    return false if segment_length == Source::PATH_EMPTY
                    return false if segment_length == Source::PATH_SINGLE_DOT_LENGTH and file.path_bytes[segment_start] == Source::PATH_DOT
                    return false if source_path_segment_is_parent(file, segment_start, index)
                    segment_start <- index + 1
            final_segment_length: usize = file.path_length - segment_start
            return false if final_segment_length == Source::PATH_EMPTY
            return false if final_segment_length == Source::PATH_SINGLE_DOT_LENGTH and file.path_bytes[segment_start] == Source::PATH_DOT
            return false if source_path_segment_is_parent(file, segment_start, file.path_length)
            return true

        def source_file_path_is_valid(file: SourceFile) -> bool:
            return false if file.path_length == Source::PATH_EMPTY or file.path_length > Source::METADATA_SOURCE_PATH_CAPACITY
            return source_path_utf8_is_valid(file.path_bytes[0], file.path_length) and source_path_segments_are_normalized(file)

        def source_file_paths_equal(left: SourceFile, right: SourceFile) -> bool:
            return false if left.path_length != right.path_length
            return false if left.path_length > Source::METADATA_SOURCE_PATH_CAPACITY or right.path_length > Source::METADATA_SOURCE_PATH_CAPACITY
            for index in 0..<left.path_length:
                return false if left.path_bytes[index] != right.path_bytes[index]
            return true

        def source_file_is_valid(file: SourceFile) -> bool:
            return file.id.value != Source::NO_FILE and file.logical_path.value != Source::NO_FILE and file.content.value != Source::NO_FILE and file.line_count > 0 and source_file_path_is_valid(file)

        def function_info_is_valid(function: FunctionInfo) -> bool:
            return function.id.value != Source::NO_FILE and function.name.value != Source::NO_FILE and source_span_is_valid(function.source)
