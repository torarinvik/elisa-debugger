# Compact, bounded source metadata tables for adapters and breakpoint rebinding.
# IDs are content identities; client/server path mappings affect lookup only.

include "./source.elisa"
include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerSourceStore:
    private:
        const module Detail:
            METADATA_SOURCE_STORE_DETAIL_CAPACITY: u32 = 1
            METADATA_SOURCE_STORE_DETAIL_SOURCE: u32 = 2
            FUNCTION: u32 = 3
            MAPPING: u32 = 4

        const module Function:
            METADATA_SOURCE_STORE_FUNCTION_CAPACITY: usize = 32

        const module Path:
            MAPPING_CAPACITY: usize = 8

        const module Sentinel:
            SOURCE_INDEX: usize = Source::METADATA_SOURCE_STORE_FILE_CAPACITY
            FUNCTION_INDEX: usize = Function::METADATA_SOURCE_STORE_FUNCTION_CAPACITY
            METADATA_SOURCE_STORE_SENTINEL_ID: u64 = 0

        const module Source:
            METADATA_SOURCE_STORE_FILE_CAPACITY: usize = 16


    public:
        struct PathMapping:
            client_root: mutable DebuggerIdentity::DebugId
            server_root: mutable DebuggerIdentity::DebugId

        struct SourceStore:
            files: mutable DebuggerMetadata::SourceFile[Source::METADATA_SOURCE_STORE_FILE_CAPACITY]
            file_count: mutable usize
            functions: mutable DebuggerMetadata::FunctionInfo[Function::METADATA_SOURCE_STORE_FUNCTION_CAPACITY]
            function_sources: mutable DebuggerIdentity::DebugId[Function::METADATA_SOURCE_STORE_FUNCTION_CAPACITY]
            function_count: mutable usize
            mappings: mutable PathMapping[Path::MAPPING_CAPACITY]
            mapping_count: mutable usize

        def source_store_new() -> SourceStore:
            return zeroed

        def source_store_find_index(store: mutable SourceStore&, file_id: DebuggerIdentity::DebugId) -> usize:
            return Sentinel::SOURCE_INDEX if store.file_count > Source::METADATA_SOURCE_STORE_FILE_CAPACITY
            for index in 0..<store.file_count:
                return index if store.files[index].id.value == file_id.value
            return Sentinel::SOURCE_INDEX

        def source_store_add_file(store: mutable SourceStore&, file: DebuggerMetadata::SourceFile) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::METADATA_SOURCE_STORE_DETAIL_CAPACITY) if store.file_count > Source::METADATA_SOURCE_STORE_FILE_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::METADATA_SOURCE_STORE_DETAIL_CAPACITY) if store.file_count >= Source::METADATA_SOURCE_STORE_FILE_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::METADATA_SOURCE_STORE_DETAIL_SOURCE) if not DebuggerMetadata::source_file_is_valid(file)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::METADATA_SOURCE_STORE_DETAIL_SOURCE) if source_store_find_index(store, file.id) != Sentinel::SOURCE_INDEX
            for index in 0..<store.file_count:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::METADATA_SOURCE_STORE_DETAIL_SOURCE) if store.files[index].logical_path.value == file.logical_path.value
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::METADATA_SOURCE_STORE_DETAIL_SOURCE) if DebuggerMetadata::source_file_paths_equal(store.files[index], file)
            store.files[store.file_count] <- file
            store.file_count <- store.file_count + 1
            return DebuggerErrors::no_error()

        def source_store_find_function_index(store: mutable SourceStore&, function_id: DebuggerIdentity::DebugId) -> usize:
            return Sentinel::FUNCTION_INDEX if store.function_count > Function::METADATA_SOURCE_STORE_FUNCTION_CAPACITY
            for index in 0..<store.function_count:
                return index if store.functions[index].id.value == function_id.value
            return Sentinel::FUNCTION_INDEX

        def source_span_fits_file(store: mutable SourceStore&, span: DebuggerIdentity::SourceSpan) -> bool:
            file_index: usize = source_store_find_index(store, span.file)
            return false if file_index == Sentinel::SOURCE_INDEX
            return span.end_line.u64() <= store.files[file_index].line_count

        def source_store_add_function(store: mutable SourceStore&, file_id: DebuggerIdentity::DebugId, function: DebuggerMetadata::FunctionInfo) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::METADATA_SOURCE_STORE_DETAIL_CAPACITY) if store.function_count > Function::METADATA_SOURCE_STORE_FUNCTION_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::FUNCTION) if store.function_count >= Function::METADATA_SOURCE_STORE_FUNCTION_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::METADATA_SOURCE_STORE_DETAIL_SOURCE) if source_store_find_index(store, file_id) == Sentinel::SOURCE_INDEX
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::FUNCTION) if not DebuggerMetadata::function_info_is_valid(function)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::FUNCTION) if function.source.file.value != file_id.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::METADATA_SOURCE_STORE_DETAIL_SOURCE) if not source_span_fits_file(store, function.source)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::FUNCTION) if source_store_find_function_index(store, function.id) != Sentinel::FUNCTION_INDEX
            store.functions[store.function_count] <- function
            store.function_sources[store.function_count] <- file_id
            store.function_count <- store.function_count + 1
            return DebuggerErrors::no_error()

        def source_store_add_mapping(store: mutable SourceStore&, mapping: PathMapping) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::METADATA_SOURCE_STORE_DETAIL_CAPACITY) if store.mapping_count > Path::MAPPING_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::MAPPING) if store.mapping_count >= Path::MAPPING_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::MAPPING) if mapping.client_root.value == Sentinel::METADATA_SOURCE_STORE_SENTINEL_ID or mapping.server_root.value == Sentinel::METADATA_SOURCE_STORE_SENTINEL_ID
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::MAPPING) if source_store_find_index(store, mapping.server_root) == Sentinel::SOURCE_INDEX
            for index in 0..<store.mapping_count:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::MAPPING) if store.mappings[index].client_root.value == mapping.client_root.value
            store.mappings[store.mapping_count] <- mapping
            store.mapping_count <- store.mapping_count + 1
            return DebuggerErrors::no_error()

        def source_store_find_file(store: mutable SourceStore&, file_id: DebuggerIdentity::DebugId) -> DebuggerMetadata::SourceFile:
            result: mutable DebuggerMetadata::SourceFile = zeroed
            index: usize = source_store_find_index(store, file_id)
            return result if index == Sentinel::SOURCE_INDEX
            return store.files[index]

        def source_store_find_function(store: mutable SourceStore&, function_id: DebuggerIdentity::DebugId) -> DebuggerMetadata::FunctionInfo:
            result: mutable DebuggerMetadata::FunctionInfo = zeroed
            index: usize = source_store_find_function_index(store, function_id)
            return result if index == Sentinel::FUNCTION_INDEX
            return store.functions[index]

        def source_store_resolve_client_file(store: mutable SourceStore&, client_file: DebuggerIdentity::DebugId) -> DebuggerIdentity::DebugId:
            return client_file if source_store_find_index(store, client_file) != Sentinel::SOURCE_INDEX
            return DebuggerIdentity::debug_id(Sentinel::METADATA_SOURCE_STORE_SENTINEL_ID) if store.mapping_count > Path::MAPPING_CAPACITY
            for index in 0..<store.mapping_count:
                mapping: PathMapping = store.mappings[index]
                return mapping.server_root if mapping.client_root.value == client_file.value and source_store_find_index(store, mapping.server_root) != Sentinel::SOURCE_INDEX
            return DebuggerIdentity::debug_id(Sentinel::METADATA_SOURCE_STORE_SENTINEL_ID)

        def source_store_is_valid(store: mutable SourceStore&) -> bool:
            return false if store.file_count > Source::METADATA_SOURCE_STORE_FILE_CAPACITY or store.function_count > Function::METADATA_SOURCE_STORE_FUNCTION_CAPACITY or store.mapping_count > Path::MAPPING_CAPACITY
            for index in 0..<store.file_count:
                return false if not DebuggerMetadata::source_file_is_valid(store.files[index])
                for previous in 0..<index:
                    return false if store.files[previous].id.value == store.files[index].id.value
                    return false if store.files[previous].logical_path.value == store.files[index].logical_path.value
                    return false if DebuggerMetadata::source_file_paths_equal(store.files[previous], store.files[index])
            for index in 0..<store.function_count:
                return false if not DebuggerMetadata::function_info_is_valid(store.functions[index])
                return false if store.function_sources[index].value == Sentinel::METADATA_SOURCE_STORE_SENTINEL_ID
                return false if source_store_find_index(store, store.function_sources[index]) == Sentinel::SOURCE_INDEX
                return false if store.functions[index].source.file.value != store.function_sources[index].value
                return false if not source_span_fits_file(store, store.functions[index].source)
                for previous in 0..<index:
                    return false if store.functions[previous].id.value == store.functions[index].id.value
            for index in 0..<store.mapping_count:
                return false if store.mappings[index].client_root.value == Sentinel::METADATA_SOURCE_STORE_SENTINEL_ID or store.mappings[index].server_root.value == Sentinel::METADATA_SOURCE_STORE_SENTINEL_ID
                return false if source_store_find_index(store, store.mappings[index].server_root) == Sentinel::SOURCE_INDEX
                for previous in 0..<index:
                    return false if store.mappings[previous].client_root.value == store.mappings[index].client_root.value
            return true
