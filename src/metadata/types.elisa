# Versioned type/scope metadata used by managed and native value inspection.
# IDs are content-addressed; storage is bounded and cycle-aware at query time.

include "../core/identity.elisa"

module DebuggerTypeMetadata:
    private:
        const TYPE_CAPACITY: usize = 512
        const SCOPE_CAPACITY: usize = 512
        const BINDING_CAPACITY: usize = 1024

    public:
        enum TypeKind:
            Void
            Scalar
            Enum
            Struct
            Array
            View
            Optional
            ErrorUnion
            Reference
            Function
            Closure
            Unknown

        struct TypeInfo:
            id: mutable DebuggerIdentity::DebugId
            kind: mutable TypeKind
            name: mutable DebuggerIdentity::DebugId
            size: mutable u64
            alignment: mutable u64
            child_count: mutable u64
            pointee: mutable DebuggerIdentity::DebugId
            flags: mutable u32

        struct ScopeInfo:
            id: mutable DebuggerIdentity::DebugId
            parent: mutable DebuggerIdentity::DebugId
            function: mutable DebuggerIdentity::DebugId
            start_event: mutable u64
            end_event: mutable u64

        struct BindingInfo:
            id: mutable DebuggerIdentity::BindingIdentity
            name: mutable DebuggerIdentity::DebugId
            type_id: mutable DebuggerIdentity::DebugId
            scope: mutable DebuggerIdentity::DebugId
            lifetime_start: mutable u64
            lifetime_end: mutable u64

        struct MetadataStore:
            types: mutable TypeInfo[TYPE_CAPACITY]
            type_count: mutable usize
            scopes: mutable ScopeInfo[SCOPE_CAPACITY]
            scope_count: mutable usize
            bindings: mutable BindingInfo[BINDING_CAPACITY]
            binding_count: mutable usize

        def metadata_new() -> MetadataStore:
            store: mutable MetadataStore = zeroed
            return store

        def metadata_add_type(store: MetadataStore, info: TypeInfo) -> MetadataStore:
            updated: mutable MetadataStore = store
            return updated if store.type_count >= TYPE_CAPACITY
            updated.types[store.type_count] <- info
            updated.type_count <- store.type_count + 1
            return updated

        def metadata_add_scope(store: MetadataStore, info: ScopeInfo) -> MetadataStore:
            updated: mutable MetadataStore = store
            return updated if store.scope_count >= SCOPE_CAPACITY
            updated.scopes[store.scope_count] <- info
            updated.scope_count <- store.scope_count + 1
            return updated

        def metadata_add_binding(store: MetadataStore, info: BindingInfo) -> MetadataStore:
            updated: mutable MetadataStore = store
            return updated if store.binding_count >= BINDING_CAPACITY
            updated.bindings[store.binding_count] <- info
            updated.binding_count <- store.binding_count + 1
            return updated

        def metadata_find_type(store: MetadataStore, id: DebuggerIdentity::DebugId) -> TypeInfo:
            result: mutable TypeInfo = zeroed
            for index in 0..<store.type_count:
                return store.types[index] if store.types[index].id.value == id.value
            return result

        def metadata_find_scope(store: MetadataStore, id: DebuggerIdentity::DebugId) -> ScopeInfo:
            result: mutable ScopeInfo = zeroed
            for index in 0..<store.scope_count:
                return store.scopes[index] if store.scopes[index].id.value == id.value
            return result

        def metadata_find_binding(store: MetadataStore, id: DebuggerIdentity::BindingIdentity) -> BindingInfo:
            result: mutable BindingInfo = zeroed
            for index in 0..<store.binding_count:
                candidate: BindingInfo = store.bindings[index]
                candidate_id: DebuggerIdentity::BindingIdentity = candidate.id
                if DebuggerIdentity::binding_identity_equal(candidate_id, id):
                    result.id <- candidate.id
                    result.name <- candidate.name
                    result.type_id <- candidate.type_id
                    result.scope <- candidate.scope
                    result.lifetime_start <- candidate.lifetime_start
                    result.lifetime_end <- candidate.lifetime_end
                    return result
            return result

        def metadata_scope_is_active(scope: ScopeInfo, event: u64) -> bool:
            return false if DebuggerIdentity::debug_id_is_zero(scope.id)
            return event >= scope.start_event and (scope.end_event == 0 or event < scope.end_event)

        def metadata_binding_is_live(binding: BindingInfo, event: u64) -> bool:
            return false if DebuggerIdentity::debug_id_is_zero(binding.id.declaration)
            return event >= binding.lifetime_start and (binding.lifetime_end == 0 or event < binding.lifetime_end)
