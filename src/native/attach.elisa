# Native attach/postmortem data model.  Platform bindings fill machine bytes at
# this boundary; durable state remains explicit and never stores raw pointers.

include "../platform/process.elisa"
include "../native/symbols.elisa"
include "../core/errors.elisa"
include "../core/identity.elisa"

module DebuggerNativeAttach:
    private:
        const module Capacity:
            REGISTER_CAPACITY: usize = 32
            FRAME_CAPACITY: usize = 32
            BREAKPOINT_CAPACITY: usize = 128
            NATIVE_ATTACH_CAPACITY_MEMORY_CAPACITY: usize = 4096

        const module Detail:
            DETAIL_PROCESS: u32 = 1
            DETAIL_REGISTER: u32 = 2
            DETAIL_BREAKPOINT: u32 = 3
            DETAIL_MEMORY: u32 = 4
            NATIVE_ATTACH_DETAIL_DETAIL_ADDRESS: u32 = 5

        const module Identity:
            NATIVE_ATTACH_IDENTITY_NO_ID: u64 = 0
            MAX_BREAKPOINT_ID: u64 = 18446744073709551615


    public:
        struct Register:
            id: mutable DebuggerIdentity::DebugId
            value: mutable u64
            valid: mutable bool

        struct UnwindFrame:
            depth: mutable u32
            instruction_pointer: mutable u64
            stack_pointer: mutable u64
            function: mutable DebuggerIdentity::DebugId
            source: mutable DebuggerIdentity::SourceSpan
            complete: mutable bool

        struct SoftwareBreakpoint:
            id: mutable DebuggerIdentity::DebugId
            address: mutable u64
            original_byte: mutable u8
            enabled: mutable bool

        struct AttachSession:
            process: mutable DebuggerProcess::ProcessHandle
            registers: mutable Register[Capacity::REGISTER_CAPACITY]
            register_count: mutable usize
            frames: mutable UnwindFrame[Capacity::FRAME_CAPACITY]
            frame_count: mutable usize
            breakpoints: mutable SoftwareBreakpoint[Capacity::BREAKPOINT_CAPACITY]
            breakpoint_count: mutable usize
            next_breakpoint: mutable u64
            load_bias: mutable i64
            last_error: mutable DebuggerErrors::DebuggerError

        struct AttachMemory:
            address: mutable u64
            bytes: mutable u8[Capacity::NATIVE_ATTACH_CAPACITY_MEMORY_CAPACITY]
            length: mutable usize
            complete: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def attach_new(process: DebuggerProcess::ProcessHandle) -> AttachSession:
            return AttachSession{process: process, registers: zeroed, register_count: 0, frames: zeroed, frame_count: 0, breakpoints: zeroed, breakpoint_count: 0, next_breakpoint: 1, load_bias: 0, last_error: DebuggerErrors::no_error()}

        def attach_memory_capacity() -> usize:
            return Capacity::NATIVE_ATTACH_CAPACITY_MEMORY_CAPACITY

        def attach_is_stopped(session: AttachSession) -> bool:
            return DebuggerProcess::process_is_valid(session.process) and session.process.state == DebuggerProcess::ProcessState.Stopped and DebuggerErrors::error_is_ok(session.last_error)

        def attach_set_load_bias(session: AttachSession, bias: i64) -> AttachSession:
            updated: mutable AttachSession = session
            return updated if not DebuggerProcess::process_is_valid(session.process)
            updated.load_bias <- bias
            return updated

        def attach_add_register(session: AttachSession, register: Register) -> AttachSession:
            updated: mutable AttachSession = session
            return updated if session.register_count >= Capacity::REGISTER_CAPACITY or register.id.value == Identity::NATIVE_ATTACH_IDENTITY_NO_ID or not register.valid
            for index in 0..<session.register_count:
                return updated if session.registers[index].id.value == register.id.value
            updated.registers[session.register_count] <- register
            updated.register_count <- session.register_count + 1
            return updated

        def attach_add_frame(session: AttachSession, frame: UnwindFrame) -> AttachSession:
            updated: mutable AttachSession = session
            return updated if session.frame_count >= Capacity::FRAME_CAPACITY or frame.depth.u64() >= Capacity::FRAME_CAPACITY.u64()
            for index in 0..<session.frame_count:
                return updated if session.frames[index].depth == frame.depth
            updated.frames[session.frame_count] <- frame
            updated.frame_count <- session.frame_count + 1
            return updated

        def attach_add_breakpoint(session: AttachSession, address: u64, original_byte: u8) -> AttachSession:
            updated: mutable AttachSession = session
            return updated if not attach_is_stopped(session) or session.breakpoint_count >= Capacity::BREAKPOINT_CAPACITY or address == 0 or session.next_breakpoint == 0 or session.next_breakpoint == Identity::MAX_BREAKPOINT_ID
            for index in 0..<session.breakpoint_count:
                return updated if session.breakpoints[index].address == address
            updated.breakpoints[session.breakpoint_count] <- SoftwareBreakpoint{id: DebuggerIdentity::debug_id(session.next_breakpoint), address: address, original_byte: original_byte, enabled: true}
            updated.breakpoint_count <- session.breakpoint_count + 1
            updated.next_breakpoint <- session.next_breakpoint + 1
            return updated

        def attach_remove_breakpoint(session: AttachSession, id: DebuggerIdentity::DebugId) -> AttachSession:
            updated: mutable AttachSession = session
            return updated if not attach_is_stopped(session) or session.breakpoint_count > Capacity::BREAKPOINT_CAPACITY
            for index in 0..<session.breakpoint_count:
                if session.breakpoints[index].id.value == id.value:
                    updated.breakpoints[index] <- session.breakpoints[session.breakpoint_count - 1]
                    updated.breakpoint_count <- session.breakpoint_count - 1
                    return updated
            return updated

        def attach_read_memory(session: AttachSession, address: u64, source: u8&, length: usize) -> AttachMemory:
            result: mutable AttachMemory = zeroed
            result.address <- address
            result.failure <- DebuggerErrors::no_error()
            return AttachMemory{address: address, bytes: result.bytes, length: 0, complete: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::DETAIL_PROCESS)} if not attach_is_stopped(session)
            return AttachMemory{address: address, bytes: result.bytes, length: 0, complete: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::DETAIL_MEMORY)} if length > Capacity::NATIVE_ATTACH_CAPACITY_MEMORY_CAPACITY
            return AttachMemory{address: address, bytes: result.bytes, length: 0, complete: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::NATIVE_ATTACH_DETAIL_DETAIL_ADDRESS)} if not DebuggerProcess::process_memory_range_is_valid(address, length)
            for index in 0..<length:
                result.bytes[index] <- source[index]
            result.length <- length
            result.complete <- true
            return result

        def attach_validate(session: AttachSession) -> bool:
            return false if session.register_count > Capacity::REGISTER_CAPACITY or session.frame_count > Capacity::FRAME_CAPACITY or session.breakpoint_count > Capacity::BREAKPOINT_CAPACITY
            return false if not DebuggerProcess::process_is_valid(session.process)
            return false if session.next_breakpoint == Identity::NATIVE_ATTACH_IDENTITY_NO_ID or session.next_breakpoint > Identity::MAX_BREAKPOINT_ID
            for register_index in 0..<session.register_count:
                return false if session.registers[register_index].id.value == Identity::NATIVE_ATTACH_IDENTITY_NO_ID or not session.registers[register_index].valid
                for previous_register in 0..<register_index:
                    return false if session.registers[previous_register].id.value == session.registers[register_index].id.value
            for frame_index in 0..<session.frame_count:
                return false if session.frames[frame_index].depth.u64() >= Capacity::FRAME_CAPACITY.u64()
                for previous_frame in 0..<frame_index:
                    return false if session.frames[previous_frame].depth == session.frames[frame_index].depth
            for index in 0..<session.breakpoint_count:
                return false if session.breakpoints[index].id.value == Identity::NATIVE_ATTACH_IDENTITY_NO_ID or session.breakpoints[index].address == 0
                return false if session.breakpoints[index].id.value >= session.next_breakpoint
                for previous in 0..<index:
                    return false if session.breakpoints[previous].id.value == session.breakpoints[index].id.value
                    return false if session.breakpoints[previous].address == session.breakpoints[index].address
            return true
