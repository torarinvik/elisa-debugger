# Native provider boundary.  The controller reports honest capability limits
# until a qualified platform agent supplies cooperative stop acknowledgments.

include "../engine/provider.elisa"
include "../core/errors.elisa"
include "../agent/hooks.elisa"

module DebuggerNative:
    private:
        const module Protocol:
            AGENT_PROTOCOL_MAJOR: u32 = 1

        const module Detail:
            DETAIL_AGENT_PROTOCOL: u32 = 1
            DETAIL_AGENT_IDENTITY: u32 = 2
            DETAIL_PROVIDER_KIND: u32 = 3
            NATIVE_CONTROLLER_DETAIL_DETAIL_STATE: u32 = 4
            DETAIL_AGENT_BUFFER: u32 = 5

        const module Crash:
            CRASH_DETAIL_NONE: u32 = 0


    public:
        enum NativeStopStatus:
            Detached
            Attached
            Pausing
            Stopped
            Crashed
            AgentFailed
            Unsupported

        struct AgentIdentity:
            protocol_major: mutable u32
            build: mutable u64
            target: mutable u64

        struct NativeController:
            agent: mutable AgentIdentity
            agent_buffer: mutable DebuggerAgent::AgentBuffer
            status: mutable NativeStopStatus
            provider: mutable DebuggerEngine::Provider
            crash_detail: mutable u32
            last_error: mutable DebuggerErrors::DebuggerError

        def native_controller_new(provider: DebuggerEngine::Provider) -> NativeController:
            return NativeController{agent: AgentIdentity{protocol_major: 0, build: 0, target: 0}, agent_buffer: DebuggerAgent::agent_buffer_new(), status: NativeStopStatus.Detached, provider: provider, crash_detail: Crash::CRASH_DETAIL_NONE, last_error: DebuggerErrors::no_error()}

        def native_attach(controller: NativeController, agent: AgentIdentity) -> NativeController:
            updated: mutable NativeController = controller
            if controller.status != NativeStopStatus.Detached:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            if controller.provider.kind != DebuggerCapabilities::EngineKind.InstrumentedNative and controller.provider.kind != DebuggerCapabilities::EngineKind.AttachedNative:
                updated.status <- NativeStopStatus.Unsupported
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::DETAIL_PROVIDER_KIND)
                return updated
            if agent.protocol_major != Protocol::AGENT_PROTOCOL_MAJOR:
                updated.status <- NativeStopStatus.Unsupported
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::DETAIL_AGENT_PROTOCOL)
                return updated
            if agent.build == 0 or agent.target == 0:
                updated.status <- NativeStopStatus.Unsupported
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::DETAIL_AGENT_IDENTITY)
                return updated
            updated.agent <- agent
            updated.agent_buffer <- DebuggerAgent::agent_buffer_new()
            updated.status <- NativeStopStatus.Attached
            updated.crash_detail <- Crash::CRASH_DETAIL_NONE
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        # Preserve target faults separately from controller/agent transport
        # failure. A crashed target can still expose its captured stop state.
        def native_target_crashed(controller: NativeController, detail: u32) -> NativeController:
            updated: mutable NativeController = controller
            if controller.status != NativeStopStatus.Attached and controller.status != NativeStopStatus.Pausing and controller.status != NativeStopStatus.Stopped and controller.status != NativeStopStatus.AgentFailed:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            updated.status <- NativeStopStatus.Crashed
            updated.agent_buffer <- DebuggerAgent::agent_acknowledge_stop(DebuggerAgent::agent_request_stop(controller.agent_buffer))
            updated.crash_detail <- detail
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        # An agent transport failure makes live target state unsafe to inspect;
        # it must not be surfaced as a target crash or a successful stop.
        def native_agent_failed(controller: NativeController, detail: u32) -> NativeController:
            updated: mutable NativeController = controller
            if controller.status != NativeStopStatus.Attached and controller.status != NativeStopStatus.Pausing and controller.status != NativeStopStatus.Stopped:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            updated.status <- NativeStopStatus.AgentFailed
            updated.agent_buffer <- DebuggerAgent::agent_request_stop(controller.agent_buffer)
            updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, false, detail)
            return updated

        def native_pause(controller: NativeController) -> NativeController:
            updated: mutable NativeController = controller
            if controller.status != NativeStopStatus.Attached:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            updated.status <- NativeStopStatus.Pausing
            updated.agent_buffer <- DebuggerAgent::agent_request_stop(controller.agent_buffer)
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        # The target agent must explicitly acknowledge a cooperative stop
        # before the controller exposes a stopped inspection state.
        def native_acknowledge_pause(controller: NativeController) -> NativeController:
            updated: mutable NativeController = controller
            if controller.status != NativeStopStatus.Pausing:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            updated.agent_buffer <- DebuggerAgent::agent_acknowledge_stop(controller.agent_buffer)
            return native_agent_failed(updated, Detail::DETAIL_AGENT_BUFFER) if not DebuggerAgent::agent_stop_is_acknowledged(updated.agent_buffer)
            updated.status <- NativeStopStatus.Stopped
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        def native_resume(controller: NativeController) -> NativeController:
            updated: mutable NativeController = controller
            if controller.status != NativeStopStatus.Stopped:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            updated.agent_buffer <- DebuggerAgent::agent_resume(controller.agent_buffer)
            return native_agent_failed(updated, Detail::DETAIL_AGENT_BUFFER) if not DebuggerAgent::agent_can_resume(updated.agent_buffer)
            updated.status <- NativeStopStatus.Attached
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        def native_detach(controller: NativeController) -> NativeController:
            updated: mutable NativeController = controller
            if controller.status == NativeStopStatus.Detached:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            if controller.status == NativeStopStatus.Pausing:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, true, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            if controller.status == NativeStopStatus.Unsupported:
                return updated
            if controller.status == NativeStopStatus.AgentFailed:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, false, controller.last_error.detail)
                return updated
            updated.status <- NativeStopStatus.Detached
            updated.agent_buffer <- DebuggerAgent::agent_resume(controller.agent_buffer)
            updated.agent.protocol_major <- 0
            updated.agent.build <- 0
            updated.agent.target <- 0
            updated.crash_detail <- Crash::CRASH_DETAIL_NONE
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        def native_can_inspect(controller: NativeController) -> bool:
            return false if controller.status != NativeStopStatus.Stopped and controller.status != NativeStopStatus.Crashed
            return DebuggerErrors::error_is_ok(controller.last_error) or controller.last_error.code == DebuggerErrors::ErrorCode.InvalidState

        # Agent events are accepted only while the target is live. A malformed
        # ordinal, unknown kind, or full buffer makes the live state unsafe to
        # inspect and is reported as an agent transport failure.
        def native_publish_agent_event(controller: NativeController, event: DebuggerAgent::AgentEvent) -> NativeController:
            updated: mutable NativeController = controller
            if controller.status != NativeStopStatus.Attached and controller.status != NativeStopStatus.Pausing:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::NATIVE_CONTROLLER_DETAIL_DETAIL_STATE)
                return updated
            updated.agent_buffer <- DebuggerAgent::agent_publish(controller.agent_buffer, event)
            if not DebuggerAgent::agent_is_exact(updated.agent_buffer):
                updated.status <- NativeStopStatus.AgentFailed
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, false, Detail::DETAIL_AGENT_BUFFER)
                return updated
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        def native_agent_is_exact(controller: NativeController) -> bool:
            return DebuggerAgent::agent_is_exact(controller.agent_buffer) and controller.status != NativeStopStatus.AgentFailed

        def native_agent_event_count(controller: NativeController) -> usize:
            return DebuggerAgent::agent_event_count(controller.agent_buffer)

        def native_exact_replay_error() -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::DETAIL_AGENT_PROTOCOL)
