# Minimal, bounds-checked ELF header reader for native artifact discovery.
# Section and symbol decoding remain separate so malformed files fail before
# any offset is trusted.

module DebuggerNativeElf:
    private:
        const ELF_HEADER_BYTES: usize = 64
        const ELF_MAGIC_0: u8 = 127
        const ELF_MAGIC_1: u8 = 69
        const ELF_MAGIC_2: u8 = 76
        const ELF_MAGIC_3: u8 = 70
        const ELF_CLASS_64: u8 = 2
        const ELF_DATA_LITTLE: u8 = 1
        const ELF_VERSION_CURRENT: u8 = 1
        const ELF_HEADER_SIZE_64: u16 = 64
        const ELF_PROGRAM_ENTRY_SIZE_64: u16 = 56
        const ELF_SECTION_ENTRY_SIZE_64: u16 = 64
        const ELF_BYTE_BITS: u64 = 8
        const ELF_TYPE_OFFSET: usize = 16
        const ELF_MACHINE_OFFSET: usize = 18
        const ELF_ENTRY_OFFSET: usize = 24
        const ELF_PROGRAM_OFFSET: usize = 32
        const ELF_SECTION_OFFSET: usize = 40
        const ELF_HEADER_SIZE_OFFSET: usize = 52
        const ELF_PROGRAM_SIZE_OFFSET: usize = 54
        const ELF_PROGRAM_COUNT_OFFSET: usize = 56
        const ELF_SECTION_SIZE_OFFSET: usize = 58
        const ELF_SECTION_COUNT_OFFSET: usize = 60
        const ELF_TYPE_EXECUTABLE: u16 = 2
        const ELF_TYPE_SHARED: u16 = 3
        const ELF_MACHINE_X86_64: u16 = 62
        const ELF_MACHINE_AARCH64: u16 = 183

    public:
        enum ElfMachine:
            Unknown
            X86_64
            AArch64

        struct ElfHeader:
            valid: mutable bool
            executable: mutable bool
            machine: mutable ElfMachine
            entry: mutable u64
            program_header_offset: mutable u64
            section_header_offset: mutable u64
            program_header_count: mutable u16
            section_header_count: mutable u16
            program_header_size: mutable u16
            section_header_size: mutable u16

        def read_u16(bytes: u8&, offset: usize) -> u16:
            return bytes[offset].u16() | (bytes[offset + 1].u16() << ELF_BYTE_BITS)

        def read_u64(bytes: u8&, offset: usize) -> u64:
            value: mutable u64 = 0
            for index in 0..<8:
                value <- value | (bytes[offset + index].u64() << (index.u64() * ELF_BYTE_BITS))
            return value

        def table_fits(offset: u64, entry_size: u16, count: u16, length: usize) -> bool:
            return false if offset > length.u64()
            return true if count == 0
            return false if entry_size == 0
            return count.u64() <= (length.u64() - offset) / entry_size.u64()

        def elf_parse(bytes: u8&, length: usize) -> ElfHeader:
            result: mutable ElfHeader = zeroed
            return result if length < ELF_HEADER_BYTES
            return result if bytes[0] != ELF_MAGIC_0 or bytes[1] != ELF_MAGIC_1 or bytes[2] != ELF_MAGIC_2 or bytes[3] != ELF_MAGIC_3
            return result if bytes[4] != ELF_CLASS_64 or bytes[5] != ELF_DATA_LITTLE or bytes[6] != ELF_VERSION_CURRENT
            kind: u16 = read_u16(bytes, ELF_TYPE_OFFSET)
            machine_code: u16 = read_u16(bytes, ELF_MACHINE_OFFSET)
            header_size: u16 = read_u16(bytes, ELF_HEADER_SIZE_OFFSET)
            program_offset: u64 = read_u64(bytes, ELF_PROGRAM_OFFSET)
            section_offset: u64 = read_u64(bytes, ELF_SECTION_OFFSET)
            program_size: u16 = read_u16(bytes, ELF_PROGRAM_SIZE_OFFSET)
            program_count: u16 = read_u16(bytes, ELF_PROGRAM_COUNT_OFFSET)
            section_size: u16 = read_u16(bytes, ELF_SECTION_SIZE_OFFSET)
            section_count: u16 = read_u16(bytes, ELF_SECTION_COUNT_OFFSET)
            return result if kind != ELF_TYPE_EXECUTABLE and kind != ELF_TYPE_SHARED
            return result if machine_code != ELF_MACHINE_X86_64 and machine_code != ELF_MACHINE_AARCH64
            return result if header_size != ELF_HEADER_SIZE_64
            return result if program_count > 0 and program_size != ELF_PROGRAM_ENTRY_SIZE_64
            return result if section_count > 0 and section_size != ELF_SECTION_ENTRY_SIZE_64
            return result if not table_fits(program_offset, program_size, program_count, length) or not table_fits(section_offset, section_size, section_count, length)
            result.valid <- true
            result.executable <- kind == ELF_TYPE_EXECUTABLE
            result.machine <- ElfMachine.X86_64 if machine_code == ELF_MACHINE_X86_64 else ElfMachine.AArch64
            result.entry <- read_u64(bytes, ELF_ENTRY_OFFSET)
            result.program_header_offset <- program_offset
            result.section_header_offset <- section_offset
            result.program_header_size <- program_size
            result.program_header_count <- program_count
            result.section_header_size <- section_size
            result.section_header_count <- section_count
            return result

        def elf_machine_is_supported(header: ElfHeader) -> bool:
            return header.valid and header.machine != ElfMachine.Unknown
