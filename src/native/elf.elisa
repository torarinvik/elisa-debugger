# Minimal, bounds-checked ELF header reader for native artifact discovery.
# Section and symbol decoding remain separate so malformed files fail before
# any offset is trusted.

module DebuggerNativeElf:
    private:
        const ELF_HEADER_BYTES: usize = 64
        const ELF_MAGIC_0: u8 = 127
        const ELF_MAGIC_1: u8 = 69
        const ELF_MAGIC_2: u8 = 76
        const ELF_MAGIC_3: u8 = 70
        const ELF_CLASS_64: u8 = 2
        const ELF_DATA_LITTLE: u8 = 1
        const ELF_VERSION_CURRENT: u8 = 1
        const ELF_HEADER_SIZE_64: u16 = 64
        const ELF_PROGRAM_ENTRY_SIZE_64: u16 = 56
        const ELF_SECTION_ENTRY_SIZE_64: u16 = 64
        const ELF_BYTE_BITS: u64 = 8
        const ELF_TYPE_OFFSET: usize = 16
        const ELF_MACHINE_OFFSET: usize = 18
        const ELF_ENTRY_OFFSET: usize = 24
        const ELF_PROGRAM_OFFSET: usize = 32
        const ELF_SECTION_OFFSET: usize = 40
        const ELF_HEADER_SIZE_OFFSET: usize = 52
        const ELF_PROGRAM_SIZE_OFFSET: usize = 54
        const ELF_PROGRAM_COUNT_OFFSET: usize = 56
        const ELF_SECTION_SIZE_OFFSET: usize = 58
        const ELF_SECTION_COUNT_OFFSET: usize = 60
        const ELF_PROGRAM_TYPE_OFFSET: usize = 0
        const ELF_PROGRAM_FLAGS_OFFSET: usize = 4
        const ELF_PROGRAM_OFFSET_FIELD: usize = 8
        const ELF_PROGRAM_VIRTUAL_ADDRESS_OFFSET: usize = 16
        const ELF_PROGRAM_FILE_SIZE_OFFSET: usize = 32
        const ELF_PROGRAM_MEMORY_SIZE_OFFSET: usize = 40
        const ELF_PROGRAM_ALIGN_OFFSET: usize = 48
        const ELF_SECTION_NAME_OFFSET: usize = 0
        const ELF_SECTION_TYPE_OFFSET: usize = 4
        const ELF_SECTION_FLAGS_OFFSET: usize = 8
        const ELF_SECTION_ADDRESS_OFFSET: usize = 16
        const ELF_SECTION_OFFSET_FIELD: usize = 24
        const ELF_SECTION_SIZE_FIELD: usize = 32
        const ELF_SECTION_LINK_OFFSET: usize = 40
        const ELF_SECTION_INFO_OFFSET: usize = 44
        const ELF_SECTION_ALIGNMENT_OFFSET: usize = 48
        const ELF_SECTION_ENTRY_SIZE_OFFSET: usize = 56
        const ELF_TYPE_EXECUTABLE: u16 = 2
        const ELF_TYPE_SHARED: u16 = 3
        const ELF_MACHINE_X86_64: u16 = 62
        const ELF_MACHINE_AARCH64: u16 = 183

    public:
        enum ElfMachine:
            Unknown
            X86_64
            AArch64

        struct ElfHeader:
            valid: mutable bool
            executable: mutable bool
            machine: mutable ElfMachine
            entry: mutable u64
            program_header_offset: mutable u64
            section_header_offset: mutable u64
            program_header_count: mutable u16
            section_header_count: mutable u16
            program_header_size: mutable u16
            section_header_size: mutable u16

        struct ElfProgramHeader:
            valid: mutable bool
            kind: mutable u32
            flags: mutable u32
            offset: mutable u64
            virtual_address: mutable u64
            file_size: mutable u64
            memory_size: mutable u64
            alignment: mutable u64

        struct ElfSectionHeader:
            valid: mutable bool
            name: mutable u32
            kind: mutable u32
            flags: mutable u64
            address: mutable u64
            offset: mutable u64
            size: mutable u64
            link: mutable u32
            info: mutable u32
            alignment: mutable u64
            entry_size: mutable u64

        def read_u16(bytes: u8&, offset: usize) -> u16:
            return bytes[offset].u16() | (bytes[offset + 1].u16() << ELF_BYTE_BITS)

        def read_u32(bytes: u8&, offset: usize) -> u32:
            return bytes[offset].u32() | (bytes[offset + 1].u32() << ELF_BYTE_BITS) | (bytes[offset + 2].u32() << (ELF_BYTE_BITS * 2)) | (bytes[offset + 3].u32() << (ELF_BYTE_BITS * 3))

        def read_u64(bytes: u8&, offset: usize) -> u64:
            value: mutable u64 = 0
            for index in 0..<8:
                value <- value | (bytes[offset + index].u64() << (index.u64() * ELF_BYTE_BITS))
            return value

        def table_fits(offset: u64, entry_size: u16, count: u16, length: usize) -> bool:
            return false if offset > length.u64()
            return true if count == 0
            return false if entry_size == 0
            return count.u64() <= (length.u64() - offset) / entry_size.u64()

        def elf_parse(bytes: u8&, length: usize) -> ElfHeader:
            result: mutable ElfHeader = zeroed
            return result if length < ELF_HEADER_BYTES
            return result if bytes[0] != ELF_MAGIC_0 or bytes[1] != ELF_MAGIC_1 or bytes[2] != ELF_MAGIC_2 or bytes[3] != ELF_MAGIC_3
            return result if bytes[4] != ELF_CLASS_64 or bytes[5] != ELF_DATA_LITTLE or bytes[6] != ELF_VERSION_CURRENT
            kind: u16 = read_u16(bytes, ELF_TYPE_OFFSET)
            machine_code: u16 = read_u16(bytes, ELF_MACHINE_OFFSET)
            header_size: u16 = read_u16(bytes, ELF_HEADER_SIZE_OFFSET)
            program_offset: u64 = read_u64(bytes, ELF_PROGRAM_OFFSET)
            section_offset: u64 = read_u64(bytes, ELF_SECTION_OFFSET)
            program_size: u16 = read_u16(bytes, ELF_PROGRAM_SIZE_OFFSET)
            program_count: u16 = read_u16(bytes, ELF_PROGRAM_COUNT_OFFSET)
            section_size: u16 = read_u16(bytes, ELF_SECTION_SIZE_OFFSET)
            section_count: u16 = read_u16(bytes, ELF_SECTION_COUNT_OFFSET)
            return result if kind != ELF_TYPE_EXECUTABLE and kind != ELF_TYPE_SHARED
            return result if machine_code != ELF_MACHINE_X86_64 and machine_code != ELF_MACHINE_AARCH64
            return result if header_size != ELF_HEADER_SIZE_64
            return result if program_count > 0 and program_size != ELF_PROGRAM_ENTRY_SIZE_64
            return result if section_count > 0 and section_size != ELF_SECTION_ENTRY_SIZE_64
            return result if not table_fits(program_offset, program_size, program_count, length) or not table_fits(section_offset, section_size, section_count, length)
            result.valid <- true
            result.executable <- kind == ELF_TYPE_EXECUTABLE
            result.machine <- ElfMachine.X86_64 if machine_code == ELF_MACHINE_X86_64 else ElfMachine.AArch64
            result.entry <- read_u64(bytes, ELF_ENTRY_OFFSET)
            result.program_header_offset <- program_offset
            result.section_header_offset <- section_offset
            result.program_header_size <- program_size
            result.program_header_count <- program_count
            result.section_header_size <- section_size
            result.section_header_count <- section_count
            return result

        def elf_machine_is_supported(header: ElfHeader) -> bool:
            return header.valid and header.machine != ElfMachine.Unknown

        def elf_program_header(bytes: u8&, length: usize, header: ElfHeader, index: usize) -> ElfProgramHeader:
            result: mutable ElfProgramHeader = zeroed
            return result if not header.valid or header.program_header_count == 0 or index >= header.program_header_count.usize()
            return result if header.program_header_size != ELF_PROGRAM_ENTRY_SIZE_64
            return result if header.program_header_offset > length.u64()
            table_offset: u64 = header.program_header_offset + index.u64() * header.program_header_size.u64()
            return result if table_offset < header.program_header_offset or table_offset > length.u64() or length.u64() - table_offset < ELF_PROGRAM_ENTRY_SIZE_64.u64()
            offset: usize = table_offset.usize()
            result.kind <- read_u32(bytes, offset + ELF_PROGRAM_TYPE_OFFSET)
            result.flags <- read_u32(bytes, offset + ELF_PROGRAM_FLAGS_OFFSET)
            result.offset <- read_u64(bytes, offset + ELF_PROGRAM_OFFSET_FIELD)
            result.virtual_address <- read_u64(bytes, offset + ELF_PROGRAM_VIRTUAL_ADDRESS_OFFSET)
            result.file_size <- read_u64(bytes, offset + ELF_PROGRAM_FILE_SIZE_OFFSET)
            result.memory_size <- read_u64(bytes, offset + ELF_PROGRAM_MEMORY_SIZE_OFFSET)
            result.alignment <- read_u64(bytes, offset + ELF_PROGRAM_ALIGN_OFFSET)
            if result.offset > length.u64() or result.file_size > length.u64() - result.offset or result.memory_size < result.file_size:
                return result
            result.valid <- true
            return result

        def elf_section_header(bytes: u8&, length: usize, header: ElfHeader, index: usize) -> ElfSectionHeader:
            result: mutable ElfSectionHeader = zeroed
            return result if not header.valid or header.section_header_count == 0 or index >= header.section_header_count.usize()
            return result if header.section_header_size != ELF_SECTION_ENTRY_SIZE_64 or header.section_header_offset > length.u64()
            table_offset: u64 = header.section_header_offset + index.u64() * header.section_header_size.u64()
            return result if table_offset < header.section_header_offset or table_offset > length.u64() or length.u64() - table_offset < ELF_SECTION_ENTRY_SIZE_64.u64()
            offset: usize = table_offset.usize()
            result.name <- read_u32(bytes, offset + ELF_SECTION_NAME_OFFSET)
            result.kind <- read_u32(bytes, offset + ELF_SECTION_TYPE_OFFSET)
            result.flags <- read_u64(bytes, offset + ELF_SECTION_FLAGS_OFFSET)
            result.address <- read_u64(bytes, offset + ELF_SECTION_ADDRESS_OFFSET)
            result.offset <- read_u64(bytes, offset + ELF_SECTION_OFFSET_FIELD)
            result.size <- read_u64(bytes, offset + ELF_SECTION_SIZE_FIELD)
            result.link <- read_u32(bytes, offset + ELF_SECTION_LINK_OFFSET)
            result.info <- read_u32(bytes, offset + ELF_SECTION_INFO_OFFSET)
            result.alignment <- read_u64(bytes, offset + ELF_SECTION_ALIGNMENT_OFFSET)
            result.entry_size <- read_u64(bytes, offset + ELF_SECTION_ENTRY_SIZE_OFFSET)
            return result if result.offset > length.u64() or result.size > length.u64() - result.offset
            result.valid <- true
            return result
