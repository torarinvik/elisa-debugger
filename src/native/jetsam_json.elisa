# Internal JSON primitives shared by native postmortem artifact readers.
# This surface exposes bounded lookups and typed scalar results only; parser
# state, delimiters, and grammar helpers remain private to this module.

module DebuggerNativeJetsamJSON:
    private:
        const module Limits:
            NO_INDEX: usize = 18446744073709551615
            MAX_NESTING: usize = 64

        const module Ascii:
            QUOTE: u8 = 34
            JETSAM_JSON_ASCII_BACKSLASH: u8 = 92
            JETSAM_JSON_ASCII_SPACE: u8 = 32
            TAB: u8 = 9
            LF: u8 = 10
            CR: u8 = 13
            JETSAM_JSON_ASCII_ZERO: u8 = 48
            NINE: u8 = 57
            COMMA: u8 = 44
            JETSAM_JSON_ASCII_COLON: u8 = 58
            JETSAM_JSON_ASCII_OBJECT_OPEN: u8 = 123
            OBJECT_CLOSE: u8 = 125
            JETSAM_JSON_ASCII_ARRAY_OPEN: u8 = 91
            JETSAM_JSON_ASCII_ARRAY_CLOSE: u8 = 93
            JETSAM_JSON_ASCII_SLASH: u8 = 47
            LOWER_B: u8 = 98
            LOWER_E: u8 = 101
            LOWER_F: u8 = 102
            LOWER_N: u8 = 110
            LOWER_R: u8 = 114
            LOWER_T: u8 = 116
            LOWER_U: u8 = 117
            JETSAM_JSON_ASCII_LOWER_A: u8 = 97
            LOWER_L: u8 = 108
            LOWER_S: u8 = 115
            MINUS: u8 = 45
            PLUS: u8 = 43
            PERIOD: u8 = 46
            UPPER_E: u8 = 69
            HEX_UPPER_A: u8 = 65
            HEX_UPPER_F: u8 = 70
            HEX_LOWER_A: u8 = 97
            HEX_LOWER_F: u8 = 102

        const module Number:
            UINT_MAX: u64 = 18446744073709551615
            DECIMAL_BASE: u64 = 10

        const module Hash:
            SEED: u64 = 14695981039346656037
            JETSAM_JSON_HASH_PRIME: u64 = 1099511628211

    public:
        struct FieldLookup:
            valid: mutable bool
            found: mutable bool
            start: mutable usize

        struct NumberResult:
            valid: mutable bool
            value: mutable u64

        struct StringHash:
            valid: mutable bool
            value: mutable u64

    private:
        def is_whitespace(byte: u8) -> bool:
            return byte == Ascii::JETSAM_JSON_ASCII_SPACE or byte == Ascii::TAB or byte == Ascii::LF or byte == Ascii::CR

        def skip_whitespace(bytes: u8&, length: usize, start: usize) -> usize:
            index: mutable usize = start
            while index < length and is_whitespace(bytes[index]):
                index <- index + 1
            return index

        def hex_digit(byte: u8) -> bool:
            return byte >= Ascii::JETSAM_JSON_ASCII_ZERO and byte <= Ascii::NINE or byte >= Ascii::HEX_UPPER_A and byte <= Ascii::HEX_UPPER_F or byte >= Ascii::HEX_LOWER_A and byte <= Ascii::HEX_LOWER_F

        def json_string_end(bytes: u8&, length: usize, start: usize) -> usize:
            return Limits::NO_INDEX if start >= length or bytes[start] != Ascii::QUOTE
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = bytes[index]
                if byte == Ascii::QUOTE:
                    return index + 1
                if byte == Ascii::JETSAM_JSON_ASCII_BACKSLASH:
                    index <- index + 1
                    return Limits::NO_INDEX if index >= length
                    escaped: u8 = bytes[index]
                    if escaped == Ascii::LOWER_U:
                        return Limits::NO_INDEX if length - index <= 4
                        for digit in 1..<5:
                            return Limits::NO_INDEX if not hex_digit(bytes[index + digit])
                        index <- index + 4
                    else:
                        return Limits::NO_INDEX if escaped != Ascii::QUOTE and escaped != Ascii::JETSAM_JSON_ASCII_BACKSLASH and escaped != Ascii::JETSAM_JSON_ASCII_SLASH and escaped != Ascii::LOWER_B and escaped != Ascii::LOWER_F and escaped != Ascii::LOWER_N and escaped != Ascii::LOWER_R and escaped != Ascii::LOWER_T
                else:
                    return Limits::NO_INDEX if byte < 32
                index <- index + 1
            return Limits::NO_INDEX

        def primitive_end(bytes: u8&, length: usize, start: usize) -> usize:
            return Limits::NO_INDEX if start >= length
            first: u8 = bytes[start]
            if first == Ascii::LOWER_T:
                return Limits::NO_INDEX if length - start < 4 or bytes[start + 1] != Ascii::LOWER_R or bytes[start + 2] != Ascii::LOWER_U or bytes[start + 3] != Ascii::LOWER_E
                return primitive_suffix(bytes, length, start + 4)
            if first == Ascii::LOWER_F:
                return Limits::NO_INDEX if length - start < 5 or bytes[start + 1] != Ascii::JETSAM_JSON_ASCII_LOWER_A or bytes[start + 2] != Ascii::LOWER_L or bytes[start + 3] != Ascii::LOWER_S or bytes[start + 4] != Ascii::LOWER_E
                return primitive_suffix(bytes, length, start + 5)
            if first == Ascii::LOWER_N:
                return Limits::NO_INDEX if length - start < 4 or bytes[start + 1] != Ascii::LOWER_U or bytes[start + 2] != Ascii::LOWER_L or bytes[start + 3] != Ascii::LOWER_L
                return primitive_suffix(bytes, length, start + 4)
            index: mutable usize = start
            index <- index + 1 if index < length and bytes[index] == Ascii::MINUS
            return Limits::NO_INDEX if index >= length
            if bytes[index] == Ascii::JETSAM_JSON_ASCII_ZERO:
                index <- index + 1
                return Limits::NO_INDEX if index < length and bytes[index] >= Ascii::JETSAM_JSON_ASCII_ZERO and bytes[index] <= Ascii::NINE
            else:
                return Limits::NO_INDEX if bytes[index] < 49 or bytes[index] > Ascii::NINE
                while index < length and bytes[index] >= Ascii::JETSAM_JSON_ASCII_ZERO and bytes[index] <= Ascii::NINE:
                    index <- index + 1
            if index < length and bytes[index] == Ascii::PERIOD:
                index <- index + 1
                return Limits::NO_INDEX if index >= length or bytes[index] < Ascii::JETSAM_JSON_ASCII_ZERO or bytes[index] > Ascii::NINE
                while index < length and bytes[index] >= Ascii::JETSAM_JSON_ASCII_ZERO and bytes[index] <= Ascii::NINE:
                    index <- index + 1
            if index < length and (bytes[index] == Ascii::LOWER_E or bytes[index] == Ascii::UPPER_E):
                index <- index + 1
                index <- index + 1 if index < length and (bytes[index] == Ascii::PLUS or bytes[index] == Ascii::MINUS)
                return Limits::NO_INDEX if index >= length or bytes[index] < Ascii::JETSAM_JSON_ASCII_ZERO or bytes[index] > Ascii::NINE
                while index < length and bytes[index] >= Ascii::JETSAM_JSON_ASCII_ZERO and bytes[index] <= Ascii::NINE:
                    index <- index + 1
            return primitive_suffix(bytes, length, index)

        def primitive_suffix(bytes: u8&, length: usize, end: usize) -> usize:
            return end if end == length
            byte: u8 = bytes[end]
            return end if is_whitespace(byte) or byte == Ascii::COMMA or byte == Ascii::OBJECT_CLOSE or byte == Ascii::JETSAM_JSON_ASCII_ARRAY_CLOSE
            return Limits::NO_INDEX

        def value_end(bytes: u8&, length: usize, start: usize) -> usize:
            return Limits::NO_INDEX if start >= length
            return json_string_end(bytes, length, start) if bytes[start] == Ascii::QUOTE
            return primitive_end(bytes, length, start) if bytes[start] != Ascii::JETSAM_JSON_ASCII_OBJECT_OPEN and bytes[start] != Ascii::JETSAM_JSON_ASCII_ARRAY_OPEN
            delimiters: mutable u8[Limits::MAX_NESTING] = zeroed
            states: mutable u8[Limits::MAX_NESTING] = zeroed
            delimiters[0] <- bytes[start]
            depth: mutable usize = 1
            index: mutable usize = start + 1
            while index < length:
                index <- skip_whitespace(bytes, length, index)
                return Limits::NO_INDEX if index >= length
                opener: u8 = delimiters[depth - 1]
                state: u8 = states[depth - 1]
                if opener == Ascii::JETSAM_JSON_ASCII_OBJECT_OPEN:
                    if state == 0 or state == 4:
                        if state == 0 and bytes[index] == Ascii::OBJECT_CLOSE:
                            depth <- depth - 1
                            index <- index + 1
                            return index if depth == 0
                            continue
                        return Limits::NO_INDEX if bytes[index] != Ascii::QUOTE
                        key_end: usize = json_string_end(bytes, length, index)
                        return Limits::NO_INDEX if key_end == Limits::NO_INDEX
                        states[depth - 1] <- 1
                        index <- key_end
                    else:
                        if state == 1:
                            return Limits::NO_INDEX if bytes[index] != Ascii::JETSAM_JSON_ASCII_COLON
                            states[depth - 1] <- 2
                            index <- index + 1
                        else:
                            if state == 2:
                                states[depth - 1] <- 3
                                if bytes[index] == Ascii::QUOTE:
                                    value_string_end: usize = json_string_end(bytes, length, index)
                                    return Limits::NO_INDEX if value_string_end == Limits::NO_INDEX
                                    index <- value_string_end
                                else:
                                    if bytes[index] == Ascii::JETSAM_JSON_ASCII_OBJECT_OPEN or bytes[index] == Ascii::JETSAM_JSON_ASCII_ARRAY_OPEN:
                                        return Limits::NO_INDEX if depth >= Limits::MAX_NESTING
                                        delimiters[depth] <- bytes[index]
                                        states[depth] <- 0
                                        depth <- depth + 1
                                        index <- index + 1
                                    else:
                                        value_primitive_end: usize = primitive_end(bytes, length, index)
                                        return Limits::NO_INDEX if value_primitive_end == Limits::NO_INDEX
                                        index <- value_primitive_end
                            else:
                                if bytes[index] == Ascii::COMMA:
                                    states[depth - 1] <- 4
                                    index <- index + 1
                                else:
                                    return Limits::NO_INDEX if bytes[index] != Ascii::OBJECT_CLOSE
                                    depth <- depth - 1
                                    index <- index + 1
                                    return index if depth == 0
                else:
                    if state == 0 or state == 2:
                        if state == 0 and bytes[index] == Ascii::JETSAM_JSON_ASCII_ARRAY_CLOSE:
                            depth <- depth - 1
                            index <- index + 1
                            return index if depth == 0
                            continue
                        return Limits::NO_INDEX if state == 2 and bytes[index] == Ascii::JETSAM_JSON_ASCII_ARRAY_CLOSE
                        states[depth - 1] <- 1
                        if bytes[index] == Ascii::QUOTE:
                            value_string_end: usize = json_string_end(bytes, length, index)
                            return Limits::NO_INDEX if value_string_end == Limits::NO_INDEX
                            index <- value_string_end
                        else:
                            if bytes[index] == Ascii::JETSAM_JSON_ASCII_OBJECT_OPEN or bytes[index] == Ascii::JETSAM_JSON_ASCII_ARRAY_OPEN:
                                return Limits::NO_INDEX if depth >= Limits::MAX_NESTING
                                delimiters[depth] <- bytes[index]
                                states[depth] <- 0
                                depth <- depth + 1
                                index <- index + 1
                            else:
                                value_primitive_end: usize = primitive_end(bytes, length, index)
                                return Limits::NO_INDEX if value_primitive_end == Limits::NO_INDEX
                                index <- value_primitive_end
                    else:
                        if bytes[index] == Ascii::COMMA:
                            states[depth - 1] <- 2
                            index <- index + 1
                        else:
                            return Limits::NO_INDEX if bytes[index] != Ascii::JETSAM_JSON_ASCII_ARRAY_CLOSE
                            depth <- depth - 1
                            index <- index + 1
                            return index if depth == 0
            return Limits::NO_INDEX

        def cstr_length(value: cstr) -> usize:
            index: mutable usize = 0
            while value[index] != 0:
                index <- index + 1
            return index

        def json_key_matches(bytes: u8&, start: usize, end: usize, expected: cstr) -> bool:
            expected_length: usize = cstr_length(expected)
            return false if end - start != expected_length + 2
            return false if bytes[start] != Ascii::QUOTE or bytes[end - 1] != Ascii::QUOTE
            for index in 0..<expected_length:
                return false if bytes[start + index + 1] != expected[index].u8()
            return true

        def object_field(bytes: u8&, length: usize, object_start: usize, expected: cstr) -> FieldLookup:
            if object_start >= length or bytes[object_start] != Ascii::JETSAM_JSON_ASCII_OBJECT_OPEN:
                return FieldLookup{valid: false, found: false, start: Limits::NO_INDEX}
            index: mutable usize = object_start + 1
            result: mutable FieldLookup = FieldLookup{valid: true, found: false, start: Limits::NO_INDEX}
            while index < length:
                index <- skip_whitespace(bytes, length, index)
                index <- index + 1 if index < length and bytes[index] == Ascii::COMMA
                index <- skip_whitespace(bytes, length, index)
                return result if index < length and bytes[index] == Ascii::OBJECT_CLOSE
                return FieldLookup{valid: false, found: false, start: Limits::NO_INDEX} if index >= length
                key_start: usize = index
                key_end: usize = json_string_end(bytes, length, key_start)
                return FieldLookup{valid: false, found: false, start: Limits::NO_INDEX} if key_end == Limits::NO_INDEX
                index <- skip_whitespace(bytes, length, key_end)
                return FieldLookup{valid: false, found: false, start: Limits::NO_INDEX} if index >= length or bytes[index] != Ascii::JETSAM_JSON_ASCII_COLON
                value_start: usize = skip_whitespace(bytes, length, index + 1)
                field_end: usize = value_end(bytes, length, value_start)
                return FieldLookup{valid: false, found: false, start: Limits::NO_INDEX} if field_end == Limits::NO_INDEX
                if json_key_matches(bytes, key_start, key_end, expected):
                    return FieldLookup{valid: false, found: false, start: Limits::NO_INDEX} if result.found
                    result.found <- true
                    result.start <- value_start
                index <- skip_whitespace(bytes, length, field_end)
                return result if index < length and bytes[index] == Ascii::OBJECT_CLOSE
                return FieldLookup{valid: false, found: false, start: Limits::NO_INDEX} if index >= length or bytes[index] != Ascii::COMMA
                index <- index + 1
            return FieldLookup{valid: false, found: false, start: Limits::NO_INDEX}

        def parse_unsigned(bytes: u8&, length: usize, start: usize) -> NumberResult:
            return NumberResult{valid: false, value: 0} if start >= length or bytes[start] < Ascii::JETSAM_JSON_ASCII_ZERO or bytes[start] > Ascii::NINE
            return NumberResult{valid: false, value: 0} if bytes[start] == Ascii::JETSAM_JSON_ASCII_ZERO and start + 1 < length and bytes[start + 1] >= Ascii::JETSAM_JSON_ASCII_ZERO and bytes[start + 1] <= Ascii::NINE
            index: mutable usize = start
            value: mutable u64 = 0
            while index < length and bytes[index] >= Ascii::JETSAM_JSON_ASCII_ZERO and bytes[index] <= Ascii::NINE:
                digit: u64 = (bytes[index] - Ascii::JETSAM_JSON_ASCII_ZERO).u64()
                return NumberResult{valid: false, value: 0} if value > (Number::UINT_MAX - digit) / Number::DECIMAL_BASE
                value <- value * Number::DECIMAL_BASE + digit
                index <- index + 1
            return NumberResult{valid: false, value: 0} if index < length and not is_whitespace(bytes[index]) and bytes[index] != Ascii::COMMA and bytes[index] != Ascii::OBJECT_CLOSE and bytes[index] != Ascii::JETSAM_JSON_ASCII_ARRAY_CLOSE
            return NumberResult{valid: true, value: value}

        def power_of_ten(exponent: u32) -> NumberResult:
            value: mutable u64 = 1
            for _ in 0..<exponent:
                return NumberResult{valid: false, value: 0} if value > Number::UINT_MAX / Number::DECIMAL_BASE
                value <- value * Number::DECIMAL_BASE
            return NumberResult{valid: true, value: value}

        def parse_cpu_time(bytes: u8&, start: usize, end: usize) -> NumberResult:
            return NumberResult{valid: false, value: 0} if start >= end
            index: mutable usize = start
            mantissa: mutable u64 = 0
            significant_digits: mutable u32 = 0
            fractional_digits: mutable u32 = 0
            integer_digits: mutable u32 = 0
            dropped_integer_digits: mutable u32 = 0
            seen_decimal: mutable bool = false
            seen_digit: mutable bool = false
            seen_nonzero: mutable bool = false
            integer_leading_zero: mutable bool = false
            while index < end and bytes[index] != 101 and bytes[index] != 69:
                byte: u8 = bytes[index]
                if byte == 46:
                    return NumberResult{valid: false, value: 0} if seen_decimal or integer_digits == 0
                    seen_decimal <- true
                else:
                    return NumberResult{valid: false, value: 0} if byte < Ascii::JETSAM_JSON_ASCII_ZERO or byte > Ascii::NINE
                    seen_digit <- true
                    digit: u64 = (byte - Ascii::JETSAM_JSON_ASCII_ZERO).u64()
                    if not seen_decimal:
                        return NumberResult{valid: false, value: 0} if integer_leading_zero
                        integer_leading_zero <- digit == 0 and integer_digits == 0
                        integer_digits <- integer_digits + 1
                    if digit != 0:
                        seen_nonzero <- true
                    if not seen_nonzero:
                        fractional_digits <- fractional_digits + 1 if seen_decimal
                        index <- index + 1
                        continue
                    if significant_digits < 18:
                        return NumberResult{valid: false, value: 0} if mantissa > (Number::UINT_MAX - digit) / Number::DECIMAL_BASE
                        mantissa <- mantissa * Number::DECIMAL_BASE + digit
                        significant_digits <- significant_digits + 1
                    else:
                        dropped_integer_digits <- dropped_integer_digits + 1 if not seen_decimal
                    fractional_digits <- fractional_digits + 1 if seen_decimal
                index <- index + 1
            return NumberResult{valid: false, value: 0} if not seen_digit or integer_digits == 0 or seen_decimal and fractional_digits == 0
            exponent: mutable i64 = 0
            if index < end:
                index <- index + 1
                exponent_negative: mutable bool = false
                if index < end and (bytes[index] == 43 or bytes[index] == 45):
                    exponent_negative <- bytes[index] == 45
                    index <- index + 1
                return NumberResult{valid: false, value: 0} if index >= end
                while index < end:
                    return NumberResult{valid: false, value: 0} if bytes[index] < Ascii::JETSAM_JSON_ASCII_ZERO or bytes[index] > Ascii::NINE
                    exponent <- exponent * 10 + (bytes[index] - Ascii::JETSAM_JSON_ASCII_ZERO).i64()
                    return NumberResult{valid: false, value: 0} if exponent > 18
                    index <- index + 1
                exponent <- 0 - exponent if exponent_negative
            scale: i64 = fractional_digits.i64() - dropped_integer_digits.i64() - exponent - 6
            if scale > 0:
                return NumberResult{valid: true, value: 0} if scale > 19
                divisor: NumberResult = power_of_ten(scale.u32())
                return NumberResult{valid: false, value: 0} if not divisor.valid
                mantissa <- mantissa / divisor.value
            else:
                return NumberResult{valid: false, value: 0} if scale < -19
                multiplier: NumberResult = power_of_ten((0 - scale).u32())
                return NumberResult{valid: false, value: 0} if not multiplier.valid or mantissa > Number::UINT_MAX / multiplier.value
                mantissa <- mantissa * multiplier.value
            return NumberResult{valid: true, value: mantissa}

        def hash_json_string(bytes: u8&, length: usize, start: usize) -> StringHash:
            end: usize = json_string_end(bytes, length, start)
            return StringHash{valid: false, value: 0} if end == Limits::NO_INDEX
            hash: mutable u64 = Hash::SEED
            for index in start + 1..<end - 1:
                hash <- (hash ^ bytes[index].u64()) * Hash::JETSAM_JSON_HASH_PRIME
            return StringHash{valid: true, value: hash}

    public:
        def json_no_index() -> usize:
            return Limits::NO_INDEX

        def json_skip_whitespace(bytes: u8&, length: usize, start: usize) -> usize:
            return skip_whitespace(bytes, length, start)

        def json_value_end(bytes: u8&, length: usize, start: usize) -> usize:
            return value_end(bytes, length, start)

        def json_object_field(bytes: u8&, length: usize, object_start: usize, expected: cstr) -> FieldLookup:
            return object_field(bytes, length, object_start, expected)

        def json_parse_unsigned(bytes: u8&, length: usize, start: usize) -> NumberResult:
            return parse_unsigned(bytes, length, start)

        def json_parse_cpu_time(bytes: u8&, start: usize, end: usize) -> NumberResult:
            return parse_cpu_time(bytes, start, end)

        def json_hash_string(bytes: u8&, length: usize, start: usize) -> StringHash:
            return hash_json_string(bytes, length, start)
