# Minimal, bounds-checked Mach-O 64-bit header reader for native artifacts.
# Load-command decoding remains separate and is reached only after this header
# has established a safe command-table range.

module DebuggerNativeMachO:
    private:
        const MACHO_HEADER_BYTES: usize = 32
        const MACHO_MAGIC_64: u32 = 4277009103
        const MACHO_CPU_X86_64: u32 = 16777223
        const MACHO_CPU_ARM64: u32 = 16777228
        const MACHO_SUBTYPE_BASE_MASK: u32 = 16777215
        const MACHO_SUBTYPE_X86_64_ALL: u32 = 3
        const MACHO_SUBTYPE_ARM64_ALL: u32 = 0
        const MACHO_SUBTYPE_ARM64E: u32 = 2
        const MACHO_FILE_EXECUTE: u32 = 2
        const MACHO_FILE_DYLIB: u32 = 6
        const MACHO_MAX_COMMAND_BYTES: usize = 1048576
        const MACHO_MIN_COMMAND_BYTES: usize = 8
        const MACHO_COMMAND_HEADER_BYTES: usize = 8
        const MACHO_BYTE_BITS: u32 = 8
        const MACHO_CPU_OFFSET: usize = 4
        const MACHO_SUBTYPE_OFFSET: usize = 8
        const MACHO_FILE_TYPE_OFFSET: usize = 12
        const MACHO_COMMAND_COUNT_OFFSET: usize = 16
        const MACHO_COMMAND_BYTES_OFFSET: usize = 20
        const MACHO_FLAGS_OFFSET: usize = 24
        const MACHO_RESERVED_OFFSET: usize = 28
        const MACHO_COMMAND_KIND_OFFSET: usize = 0
        const MACHO_COMMAND_SIZE_OFFSET: usize = 4
        const MACHO_UUID_COMMAND_KIND: u32 = 27
        const MACHO_UUID_COMMAND_BYTES: usize = 24
        const MACHO_UUID_OFFSET: usize = 8
        const MACHO_SYMBOL_TABLE_COMMAND_KIND: u32 = 2
        const MACHO_SYMBOL_TABLE_COMMAND_BYTES: usize = 24
        const MACHO_SYMBOL_TABLE_OFFSET: usize = 8
        const MACHO_SYMBOL_COUNT_OFFSET: usize = 12
        const MACHO_STRING_TABLE_OFFSET: usize = 16
        const MACHO_STRING_TABLE_SIZE_OFFSET: usize = 20
        const MACHO_NLIST_BYTES: usize = 16
        const MACHO_NLIST_NAME_OFFSET: usize = 0
        const MACHO_NLIST_TYPE_OFFSET: usize = 4
        const MACHO_NLIST_SECTION_OFFSET: usize = 5
        const MACHO_NLIST_DESCRIPTION_OFFSET: usize = 6
        const MACHO_NLIST_VALUE_OFFSET: usize = 8
        const MACHO_SYMBOL_NAME_CAPACITY: usize = 64

    public:
        enum MachOMachine:
            Unknown
            X86_64
            AArch64

        struct MachOHeader:
            valid: mutable bool
            executable: mutable bool
            machine: mutable MachOMachine
            command_count: mutable u32
            command_bytes: mutable u32
            flags: mutable u32

        struct MachOCommand:
            valid: mutable bool
            kind: mutable u32
            size: mutable u32
            offset: mutable usize

        struct MachOUuid:
            valid: mutable bool
            bytes: mutable u8[16]

        struct MachOSymbol:
            valid: mutable bool
            name_offset: mutable u32
            symbol_type: mutable u8
            section: mutable u8
            description: mutable u16
            value: mutable u64

        struct MachOSymbolName:
            valid: mutable bool
            truncated: mutable bool
            length: mutable usize
            bytes: mutable u8[MACHO_SYMBOL_NAME_CAPACITY]

        def read_u32(bytes: u8&, offset: usize) -> u32:
            return bytes[offset].u32() | (bytes[offset + 1].u32() << MACHO_BYTE_BITS) | (bytes[offset + 2].u32() << (MACHO_BYTE_BITS * 2)) | (bytes[offset + 3].u32() << (MACHO_BYTE_BITS * 3))

        def read_u16(bytes: u8&, offset: usize) -> u16:
            return bytes[offset].u16() | (bytes[offset + 1].u16() << MACHO_BYTE_BITS)

        def read_u64(bytes: u8&, offset: usize) -> u64:
            value: mutable u64 = 0
            for index in 0..<8:
                value <- value | (bytes[offset + index].u64() << (index.u64() * MACHO_BYTE_BITS.u64()))
            return value

        def macho_parse(bytes: u8&, length: usize) -> MachOHeader:
            result: mutable MachOHeader = zeroed
            return result if length < MACHO_HEADER_BYTES
            return result if read_u32(bytes, 0) != MACHO_MAGIC_64
            cpu: u32 = read_u32(bytes, MACHO_CPU_OFFSET)
            subtype: u32 = read_u32(bytes, MACHO_SUBTYPE_OFFSET) & MACHO_SUBTYPE_BASE_MASK
            file_type: u32 = read_u32(bytes, MACHO_FILE_TYPE_OFFSET)
            command_count: u32 = read_u32(bytes, MACHO_COMMAND_COUNT_OFFSET)
            command_bytes: u32 = read_u32(bytes, MACHO_COMMAND_BYTES_OFFSET)
            reserved: u32 = read_u32(bytes, MACHO_RESERVED_OFFSET)
            return result if cpu != MACHO_CPU_X86_64 and cpu != MACHO_CPU_ARM64
            return result if cpu == MACHO_CPU_X86_64 and subtype != MACHO_SUBTYPE_X86_64_ALL
            return result if cpu == MACHO_CPU_ARM64 and subtype != MACHO_SUBTYPE_ARM64_ALL and subtype != MACHO_SUBTYPE_ARM64E
            return result if file_type != MACHO_FILE_EXECUTE and file_type != MACHO_FILE_DYLIB
            return result if command_count == 0 and command_bytes != 0
            return result if command_count > 0 and command_bytes.usize() < command_count.usize() * MACHO_MIN_COMMAND_BYTES
            return result if command_bytes.usize() > MACHO_MAX_COMMAND_BYTES or command_bytes.usize() > length - MACHO_HEADER_BYTES
            return result if reserved != 0
            result.valid <- true
            result.executable <- file_type == MACHO_FILE_EXECUTE
            result.machine <- MachOMachine.X86_64 if cpu == MACHO_CPU_X86_64 else MachOMachine.AArch64
            result.command_count <- command_count
            result.command_bytes <- command_bytes
            result.flags <- read_u32(bytes, MACHO_FLAGS_OFFSET)
            return result

        def macho_machine_is_supported(header: MachOHeader) -> bool:
            return header.valid and header.machine != MachOMachine.Unknown

        def macho_commands_are_valid(header: MachOHeader, bytes: u8&, length: usize) -> bool:
            return false if not header.valid or length < MACHO_HEADER_BYTES or header.command_bytes.usize() > length - MACHO_HEADER_BYTES
            cursor: mutable usize = MACHO_HEADER_BYTES
            limit: usize = MACHO_HEADER_BYTES + header.command_bytes.usize()
            for index in 0..<header.command_count:
                return false if cursor > limit or limit - cursor < MACHO_COMMAND_HEADER_BYTES
                command_size: usize = read_u32(bytes, cursor + 4).usize()
                return false if command_size < MACHO_COMMAND_HEADER_BYTES or command_size > limit - cursor
                cursor <- cursor + command_size
            return cursor == limit

        def macho_command(header: MachOHeader, bytes: u8&, length: usize, index: usize) -> MachOCommand:
            result: mutable MachOCommand = zeroed
            return result if not header.valid or length < MACHO_HEADER_BYTES or index >= header.command_count.usize() or header.command_bytes.usize() > length - MACHO_HEADER_BYTES
            cursor: mutable usize = MACHO_HEADER_BYTES
            limit: usize = MACHO_HEADER_BYTES + header.command_bytes.usize()
            for command_index in 0..<header.command_count:
                return result if cursor > limit or limit - cursor < MACHO_COMMAND_HEADER_BYTES
                command_size: usize = read_u32(bytes, cursor + MACHO_COMMAND_SIZE_OFFSET).usize()
                return result if command_size < MACHO_COMMAND_HEADER_BYTES or command_size > limit - cursor
                if command_index.usize() == index:
                    result.valid <- true
                    result.kind <- read_u32(bytes, cursor + MACHO_COMMAND_KIND_OFFSET)
                    result.size <- command_size.u32()
                    result.offset <- cursor
                    return result
                cursor <- cursor + command_size
            return result

        def macho_uuid(header: MachOHeader, bytes: u8&, length: usize) -> MachOUuid:
            result: mutable MachOUuid = zeroed
            return result if not header.valid or not macho_commands_are_valid(header, bytes, length)
            for index in 0..<header.command_count.usize():
                command: MachOCommand = macho_command(header, bytes, length, index)
                return result if not command.valid
                if command.kind == MACHO_UUID_COMMAND_KIND:
                    return result if command.size.usize() < MACHO_UUID_COMMAND_BYTES
                    for byte_index in 0..<16:
                        result.bytes[byte_index] <- bytes[command.offset + MACHO_UUID_OFFSET + byte_index]
                    result.valid <- true
                    return result
            return result

        def macho_symbol(header: MachOHeader, bytes: u8&, length: usize, symbol_index: usize) -> MachOSymbol:
            result: mutable MachOSymbol = zeroed
            return result if not header.valid or not macho_commands_are_valid(header, bytes, length)
            for command_index in 0..<header.command_count.usize():
                command: MachOCommand = macho_command(header, bytes, length, command_index)
                return result if not command.valid
                continue if command.kind != MACHO_SYMBOL_TABLE_COMMAND_KIND
                return result if command.size.usize() < MACHO_SYMBOL_TABLE_COMMAND_BYTES
                symbol_offset: u64 = read_u32(bytes, command.offset + MACHO_SYMBOL_TABLE_OFFSET).u64()
                symbol_count: u64 = read_u32(bytes, command.offset + MACHO_SYMBOL_COUNT_OFFSET).u64()
                string_offset: u64 = read_u32(bytes, command.offset + MACHO_STRING_TABLE_OFFSET).u64()
                string_size: u64 = read_u32(bytes, command.offset + MACHO_STRING_TABLE_SIZE_OFFSET).u64()
                return result if symbol_index.u64() >= symbol_count or symbol_offset > length.u64() or symbol_count > (length.u64() - symbol_offset) / MACHO_NLIST_BYTES.u64()
                return result if string_offset > length.u64() or string_size > length.u64() - string_offset
                entry_offset: u64 = symbol_offset + symbol_index.u64() * MACHO_NLIST_BYTES.u64()
                return result if entry_offset < symbol_offset or entry_offset > length.u64() or length.u64() - entry_offset < MACHO_NLIST_BYTES.u64()
                offset: usize = entry_offset.usize()
                result.name_offset <- read_u32(bytes, offset + MACHO_NLIST_NAME_OFFSET)
                result.symbol_type <- bytes[offset + MACHO_NLIST_TYPE_OFFSET]
                result.section <- bytes[offset + MACHO_NLIST_SECTION_OFFSET]
                result.description <- read_u16(bytes, offset + MACHO_NLIST_DESCRIPTION_OFFSET)
                result.value <- read_u64(bytes, offset + MACHO_NLIST_VALUE_OFFSET)
                result.valid <- true
                return result
            return result

        def macho_symbol_name(header: MachOHeader, bytes: u8&, length: usize, symbol_index: usize) -> MachOSymbolName:
            result: mutable MachOSymbolName = zeroed
            return result if not header.valid or not macho_commands_are_valid(header, bytes, length)
            for command_index in 0..<header.command_count.usize():
                command: MachOCommand = macho_command(header, bytes, length, command_index)
                return result if not command.valid
                continue if command.kind != MACHO_SYMBOL_TABLE_COMMAND_KIND
                return result if command.size.usize() < MACHO_SYMBOL_TABLE_COMMAND_BYTES
                symbol_offset: u64 = read_u32(bytes, command.offset + MACHO_SYMBOL_TABLE_OFFSET).u64()
                symbol_count: u64 = read_u32(bytes, command.offset + MACHO_SYMBOL_COUNT_OFFSET).u64()
                string_offset: u64 = read_u32(bytes, command.offset + MACHO_STRING_TABLE_OFFSET).u64()
                string_size: u64 = read_u32(bytes, command.offset + MACHO_STRING_TABLE_SIZE_OFFSET).u64()
                return result if symbol_index.u64() >= symbol_count or symbol_offset > length.u64() or symbol_count > (length.u64() - symbol_offset) / MACHO_NLIST_BYTES.u64()
                return result if string_offset > length.u64() or string_size > length.u64() - string_offset
                symbol_name_offset: u64 = read_u32(bytes, (symbol_offset + symbol_index.u64() * MACHO_NLIST_BYTES.u64()).usize() + MACHO_NLIST_NAME_OFFSET).u64()
                return result if symbol_name_offset >= string_size or string_offset + symbol_name_offset < string_offset or string_offset + symbol_name_offset >= length.u64()
                start: u64 = string_offset + symbol_name_offset
                available: u64 = string_size - symbol_name_offset
                for index in 0..<available.usize():
                    value: u8 = bytes[start.usize() + index]
                    if value == 0 and index == 0:
                        result.valid <- true
                        result.length <- 0
                        return result
                    if value == 0:
                        result.valid <- true
                        result.length <- MACHO_SYMBOL_NAME_CAPACITY if index > MACHO_SYMBOL_NAME_CAPACITY else index
                        result.truncated <- index > MACHO_SYMBOL_NAME_CAPACITY
                        return result
                    if index < MACHO_SYMBOL_NAME_CAPACITY:
                        result.bytes[index] <- value
                    else:
                        result.truncated <- true
                result.truncated <- true
                return result
            return result
