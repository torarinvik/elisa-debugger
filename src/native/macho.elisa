# Minimal, bounds-checked Mach-O 64-bit header reader for native artifacts.
# Load-command decoding remains separate and is reached only after this header
# has established a safe command-table range.

module DebuggerNativeMachO:
    private:
        const module Header:
            MACHO_HEADER_BYTES: usize = 32
            MACHO_COMMAND_COUNT_OFFSET: usize = 16
            MACHO_COMMAND_BYTES_OFFSET: usize = 20
            NATIVE_MACHO_HEADER_MACHO_CPU_OFFSET: usize = 4
            NATIVE_MACHO_HEADER_MACHO_SUBTYPE_OFFSET: usize = 8
            NATIVE_MACHO_HEADER_MACHO_FILE_TYPE_OFFSET: usize = 12
            MACHO_FLAGS_OFFSET: usize = 24
            MACHO_RESERVED_OFFSET: usize = 28

        const module Format:
            MACHO_MAGIC_64: u32 = 4277009103
            MACHO_CPU_X86_64: u32 = 16777223
            MACHO_CPU_ARM64: u32 = 16777228
            MACHO_SUBTYPE_BASE_MASK: u32 = 16777215
            MACHO_SUBTYPE_X86_64_ALL: u32 = 3
            MACHO_SUBTYPE_ARM64_ALL: u32 = 0
            MACHO_SUBTYPE_ARM64E: u32 = 2
            MACHO_FILE_EXECUTE: u32 = 2
            MACHO_FILE_DYLIB: u32 = 6
            MACHO_FILE_DSYM: u32 = 10
            MACHO_BYTE_BITS: u32 = 8

        const module LoadCommand:
            MACHO_MAX_COMMAND_BYTES: usize = 1048576
            MACHO_MIN_COMMAND_BYTES: usize = 8
            MACHO_COMMAND_HEADER_BYTES: usize = 8
            MACHO_COMMAND_KIND_OFFSET: usize = 0
            MACHO_COMMAND_SIZE_OFFSET: usize = 4
            MACHO_SEGMENT_64_KIND: u32 = 25

        const module Segment:
            MACHO_SEGMENT_64_COMMAND_BYTES: usize = 72
            MACHO_SEGMENT_64_SECTION_COUNT_OFFSET: usize = 64

        const module Section:
            MACHO_SECTION_64_BYTES: usize = 80
            MACHO_SECTION_64_NAME_OFFSET: usize = 0
            MACHO_SECTION_64_SEGMENT_NAME_OFFSET: usize = 16
            MACHO_SECTION_64_ADDRESS_OFFSET: usize = 32
            MACHO_SECTION_64_SIZE_OFFSET: usize = 40
            MACHO_SECTION_64_FILE_OFFSET: usize = 48
            MACHO_SECTION_64_FLAGS_OFFSET: usize = 64
            MACHO_SECTION_NAME_BYTES: usize = 16
            MACHO_SECTION_KIND_MASK: u32 = 255
            MACHO_SECTION_ZERO_FILL: u32 = 1
            MACHO_SECTION_GB_ZERO_FILL: u32 = 12
            MACHO_SECTION_THREAD_ZERO_FILL: u32 = 18
            MACHO_SECTION_MAX_U64: u64 = 18446744073709551615

        const module Uuid:
            MACHO_UUID_COMMAND_KIND: u32 = 27
            MACHO_UUID_COMMAND_BYTES: usize = 24
            MACHO_UUID_OFFSET: usize = 8

        const module SymbolTable:
            MACHO_SYMBOL_TABLE_COMMAND_KIND: u32 = 2
            MACHO_SYMBOL_TABLE_COMMAND_BYTES: usize = 24
            NATIVE_MACHO_SYMBOL_TABLE_MACHO_SYMBOL_TABLE_OFFSET: usize = 8
            MACHO_SYMBOL_COUNT_OFFSET: usize = 12
            NATIVE_MACHO_SYMBOL_TABLE_MACHO_STRING_TABLE_OFFSET: usize = 16
            MACHO_STRING_TABLE_SIZE_OFFSET: usize = 20

        const module Symbol:
            MACHO_NLIST_BYTES: usize = 16
            MACHO_NLIST_NAME_OFFSET: usize = 0
            MACHO_NLIST_TYPE_OFFSET: usize = 4
            MACHO_NLIST_SECTION_OFFSET: usize = 5
            MACHO_NLIST_DESCRIPTION_OFFSET: usize = 6
            MACHO_NLIST_VALUE_OFFSET: usize = 8
            MACHO_SYMBOL_NAME_CAPACITY: usize = 64


    public:
        enum MachOMachine:
            Unknown
            X86_64
            AArch64

        struct MachOHeader:
            valid: mutable bool
            executable: mutable bool
            debug_symbols: mutable bool
            machine: mutable MachOMachine
            command_count: mutable u32
            command_bytes: mutable u32
            flags: mutable u32

        struct MachOCommand:
            valid: mutable bool
            kind: mutable u32
            size: mutable u32
            offset: mutable usize

        struct MachOUuid:
            valid: mutable bool
            bytes: mutable u8[16]

        struct MachOSymbol:
            valid: mutable bool
            name_offset: mutable u32
            symbol_type: mutable u8
            section: mutable u8
            description: mutable u16
            value: mutable u64

        struct MachOSymbolName:
            valid: mutable bool
            truncated: mutable bool
            length: mutable usize
            bytes: mutable u8[Symbol::MACHO_SYMBOL_NAME_CAPACITY]

        struct MachOSection:
            valid: mutable bool
            file_backed: mutable bool
            name: mutable u8[Section::MACHO_SECTION_NAME_BYTES]
            segment_name: mutable u8[Section::MACHO_SECTION_NAME_BYTES]
            address: mutable u64
            size: mutable u64
            file_offset: mutable u32
            flags: mutable u32

    private:
        def read_u32(bytes: u8&, offset: usize) -> u32:
            return bytes[offset].u32() | (bytes[offset + 1].u32() << Format::MACHO_BYTE_BITS) | (bytes[offset + 2].u32() << (Format::MACHO_BYTE_BITS * 2)) | (bytes[offset + 3].u32() << (Format::MACHO_BYTE_BITS * 3))

        def read_u16(bytes: u8&, offset: usize) -> u16:
            return bytes[offset].u16() | (bytes[offset + 1].u16() << Format::MACHO_BYTE_BITS)

        def read_u64(bytes: u8&, offset: usize) -> u64:
            value: mutable u64 = 0
            for index in 0..<8:
                value <- value | (bytes[offset + index].u64() << (index.u64() * Format::MACHO_BYTE_BITS.u64()))
            return value

    public:
        def macho_parse(bytes: u8&, length: usize) -> MachOHeader:
            result: mutable MachOHeader = zeroed
            return result if length < Header::MACHO_HEADER_BYTES
            return result if read_u32(bytes, 0) != Format::MACHO_MAGIC_64
            cpu: u32 = read_u32(bytes, Header::NATIVE_MACHO_HEADER_MACHO_CPU_OFFSET)
            subtype: u32 = read_u32(bytes, Header::NATIVE_MACHO_HEADER_MACHO_SUBTYPE_OFFSET) & Format::MACHO_SUBTYPE_BASE_MASK
            file_type: u32 = read_u32(bytes, Header::NATIVE_MACHO_HEADER_MACHO_FILE_TYPE_OFFSET)
            command_count: u32 = read_u32(bytes, Header::MACHO_COMMAND_COUNT_OFFSET)
            command_bytes: u32 = read_u32(bytes, Header::MACHO_COMMAND_BYTES_OFFSET)
            reserved: u32 = read_u32(bytes, Header::MACHO_RESERVED_OFFSET)
            return result if cpu != Format::MACHO_CPU_X86_64 and cpu != Format::MACHO_CPU_ARM64
            return result if cpu == Format::MACHO_CPU_X86_64 and subtype != Format::MACHO_SUBTYPE_X86_64_ALL
            return result if cpu == Format::MACHO_CPU_ARM64 and subtype != Format::MACHO_SUBTYPE_ARM64_ALL and subtype != Format::MACHO_SUBTYPE_ARM64E
            return result if file_type != Format::MACHO_FILE_EXECUTE and file_type != Format::MACHO_FILE_DYLIB and file_type != Format::MACHO_FILE_DSYM
            return result if command_count == 0 and command_bytes != 0
            return result if command_count > 0 and command_bytes.usize() < command_count.usize() * LoadCommand::MACHO_MIN_COMMAND_BYTES
            return result if command_bytes.usize() > LoadCommand::MACHO_MAX_COMMAND_BYTES or command_bytes.usize() > length - Header::MACHO_HEADER_BYTES
            return result if reserved != 0
            result.valid <- true
            result.executable <- file_type == Format::MACHO_FILE_EXECUTE
            result.debug_symbols <- file_type == Format::MACHO_FILE_DSYM
            result.machine <- MachOMachine.X86_64 if cpu == Format::MACHO_CPU_X86_64 else MachOMachine.AArch64
            result.command_count <- command_count
            result.command_bytes <- command_bytes
            result.flags <- read_u32(bytes, Header::MACHO_FLAGS_OFFSET)
            return result

        def macho_machine_is_supported(header: MachOHeader) -> bool:
            return header.valid and header.machine != MachOMachine.Unknown

        def macho_commands_are_valid(header: MachOHeader, bytes: u8&, length: usize) -> bool:
            return false if not header.valid or length < Header::MACHO_HEADER_BYTES or header.command_bytes.usize() > length - Header::MACHO_HEADER_BYTES
            cursor: mutable usize = Header::MACHO_HEADER_BYTES
            limit: usize = Header::MACHO_HEADER_BYTES + header.command_bytes.usize()
            for index in 0..<header.command_count:
                return false if cursor > limit or limit - cursor < LoadCommand::MACHO_COMMAND_HEADER_BYTES
                command_size: usize = read_u32(bytes, cursor + 4).usize()
                return false if command_size < LoadCommand::MACHO_COMMAND_HEADER_BYTES or command_size > limit - cursor
                cursor <- cursor + command_size
            return cursor == limit

        def macho_command(header: MachOHeader, bytes: u8&, length: usize, index: usize) -> MachOCommand:
            result: mutable MachOCommand = zeroed
            return result if not header.valid or length < Header::MACHO_HEADER_BYTES or index >= header.command_count.usize() or header.command_bytes.usize() > length - Header::MACHO_HEADER_BYTES
            cursor: mutable usize = Header::MACHO_HEADER_BYTES
            limit: usize = Header::MACHO_HEADER_BYTES + header.command_bytes.usize()
            for command_index in 0..<header.command_count:
                return result if cursor > limit or limit - cursor < LoadCommand::MACHO_COMMAND_HEADER_BYTES
                command_size: usize = read_u32(bytes, cursor + LoadCommand::MACHO_COMMAND_SIZE_OFFSET).usize()
                return result if command_size < LoadCommand::MACHO_COMMAND_HEADER_BYTES or command_size > limit - cursor
                if command_index.usize() == index:
                    result.valid <- true
                    result.kind <- read_u32(bytes, cursor + LoadCommand::MACHO_COMMAND_KIND_OFFSET)
                    result.size <- command_size.u32()
                    result.offset <- cursor
                    return result
                cursor <- cursor + command_size
            return result

    private:
        def macho_segments_are_valid(header: MachOHeader, bytes: u8&, length: usize) -> bool:
            return false if not header.valid or not macho_commands_are_valid(header, bytes, length)
            cursor: mutable usize = Header::MACHO_HEADER_BYTES
            for command_index in 0..<header.command_count.usize():
                command_size: usize = read_u32(bytes, cursor + LoadCommand::MACHO_COMMAND_SIZE_OFFSET).usize()
                command_kind: u32 = read_u32(bytes, cursor + LoadCommand::MACHO_COMMAND_KIND_OFFSET)
                if command_kind == LoadCommand::MACHO_SEGMENT_64_KIND:
                    return false if command_size < Segment::MACHO_SEGMENT_64_COMMAND_BYTES
                    section_count: usize = read_u32(bytes, cursor + Segment::MACHO_SEGMENT_64_SECTION_COUNT_OFFSET).usize()
                    return false if section_count > (command_size - Segment::MACHO_SEGMENT_64_COMMAND_BYTES) / Section::MACHO_SECTION_64_BYTES
                    return false if Segment::MACHO_SEGMENT_64_COMMAND_BYTES + section_count * Section::MACHO_SECTION_64_BYTES != command_size
                cursor <- cursor + command_size
            return true

        def macho_section_from_bytes(bytes: u8&, length: usize, section_offset: usize) -> MachOSection:
            result: mutable MachOSection = zeroed
            return result if section_offset > length or length - section_offset < Section::MACHO_SECTION_64_BYTES
            for index in 0..<Section::MACHO_SECTION_NAME_BYTES:
                result.name[index] <- bytes[section_offset + Section::MACHO_SECTION_64_NAME_OFFSET + index]
                result.segment_name[index] <- bytes[section_offset + Section::MACHO_SECTION_64_SEGMENT_NAME_OFFSET + index]
            result.address <- read_u64(bytes, section_offset + Section::MACHO_SECTION_64_ADDRESS_OFFSET)
            result.size <- read_u64(bytes, section_offset + Section::MACHO_SECTION_64_SIZE_OFFSET)
            result.file_offset <- read_u32(bytes, section_offset + Section::MACHO_SECTION_64_FILE_OFFSET)
            result.flags <- read_u32(bytes, section_offset + Section::MACHO_SECTION_64_FLAGS_OFFSET)
            return result if result.address > Section::MACHO_SECTION_MAX_U64 - result.size
            section_kind: u32 = result.flags & Section::MACHO_SECTION_KIND_MASK
            result.file_backed <- section_kind != Section::MACHO_SECTION_ZERO_FILL and section_kind != Section::MACHO_SECTION_GB_ZERO_FILL and section_kind != Section::MACHO_SECTION_THREAD_ZERO_FILL
            if result.file_backed:
                return result if result.file_offset.usize() > length
                return result if result.size > (length - result.file_offset.usize()).u64()
            result.valid <- true
            return result

        def macho_section_name_matches(section: MachOSection, expected_name: u8&, expected_length: usize) -> bool:
            return false if not section.valid or expected_length == 0 or expected_length > Section::MACHO_SECTION_NAME_BYTES
            for index in 0..<expected_length:
                return false if section.name[index] != expected_name[index]
            return true if expected_length == Section::MACHO_SECTION_NAME_BYTES
            return section.name[expected_length] == 0

    public:
        def macho_section(header: MachOHeader, bytes: u8&, length: usize, section_index: usize) -> MachOSection:
            result: MachOSection = zeroed
            return result if not macho_segments_are_valid(header, bytes, length)
            cursor: mutable usize = Header::MACHO_HEADER_BYTES
            current_section: mutable usize = 0
            for command_index in 0..<header.command_count.usize():
                command_size: usize = read_u32(bytes, cursor + LoadCommand::MACHO_COMMAND_SIZE_OFFSET).usize()
                command_kind: u32 = read_u32(bytes, cursor + LoadCommand::MACHO_COMMAND_KIND_OFFSET)
                if command_kind == LoadCommand::MACHO_SEGMENT_64_KIND:
                    section_count: usize = read_u32(bytes, cursor + Segment::MACHO_SEGMENT_64_SECTION_COUNT_OFFSET).usize()
                    for local_index in 0..<section_count:
                        if current_section == section_index:
                            section_offset: usize = cursor + Segment::MACHO_SEGMENT_64_COMMAND_BYTES + local_index * Section::MACHO_SECTION_64_BYTES
                            return macho_section_from_bytes(bytes, length, section_offset)
                        current_section <- current_section + 1
                cursor <- cursor + command_size
            return result

        def macho_find_section(header: MachOHeader, bytes: u8&, length: usize, expected_name: u8&, expected_length: usize) -> MachOSection:
            result: mutable MachOSection = zeroed
            return result if expected_length == 0 or expected_length > Section::MACHO_SECTION_NAME_BYTES or not macho_segments_are_valid(header, bytes, length)
            cursor: mutable usize = Header::MACHO_HEADER_BYTES
            found: mutable bool = false
            for command_index in 0..<header.command_count.usize():
                command_size: usize = read_u32(bytes, cursor + LoadCommand::MACHO_COMMAND_SIZE_OFFSET).usize()
                command_kind: u32 = read_u32(bytes, cursor + LoadCommand::MACHO_COMMAND_KIND_OFFSET)
                if command_kind == LoadCommand::MACHO_SEGMENT_64_KIND:
                    section_count: usize = read_u32(bytes, cursor + Segment::MACHO_SEGMENT_64_SECTION_COUNT_OFFSET).usize()
                    for local_index in 0..<section_count:
                        section_offset: usize = cursor + Segment::MACHO_SEGMENT_64_COMMAND_BYTES + local_index * Section::MACHO_SECTION_64_BYTES
                        section: MachOSection = macho_section_from_bytes(bytes, length, section_offset)
                        return zeroed if not section.valid
                        if not found and macho_section_name_matches(section, expected_name, expected_length):
                            result <- section
                            found <- true
                cursor <- cursor + command_size
            return result

        def macho_uuid(header: MachOHeader, bytes: u8&, length: usize) -> MachOUuid:
            result: mutable MachOUuid = zeroed
            return result if not header.valid or not macho_commands_are_valid(header, bytes, length)
            for index in 0..<header.command_count.usize():
                command: MachOCommand = macho_command(header, bytes, length, index)
                return result if not command.valid
                if command.kind == Uuid::MACHO_UUID_COMMAND_KIND:
                    return result if command.size.usize() < Uuid::MACHO_UUID_COMMAND_BYTES
                    for byte_index in 0..<16:
                        result.bytes[byte_index] <- bytes[command.offset + Uuid::MACHO_UUID_OFFSET + byte_index]
                    result.valid <- true
                    return result
            return result

        def macho_symbol(header: MachOHeader, bytes: u8&, length: usize, symbol_index: usize) -> MachOSymbol:
            result: mutable MachOSymbol = zeroed
            return result if not header.valid or not macho_commands_are_valid(header, bytes, length)
            for command_index in 0..<header.command_count.usize():
                command: MachOCommand = macho_command(header, bytes, length, command_index)
                return result if not command.valid
                continue if command.kind != SymbolTable::MACHO_SYMBOL_TABLE_COMMAND_KIND
                return result if command.size.usize() < SymbolTable::MACHO_SYMBOL_TABLE_COMMAND_BYTES
                symbol_offset: u64 = read_u32(bytes, command.offset + SymbolTable::NATIVE_MACHO_SYMBOL_TABLE_MACHO_SYMBOL_TABLE_OFFSET).u64()
                symbol_count: u64 = read_u32(bytes, command.offset + SymbolTable::MACHO_SYMBOL_COUNT_OFFSET).u64()
                string_offset: u64 = read_u32(bytes, command.offset + SymbolTable::NATIVE_MACHO_SYMBOL_TABLE_MACHO_STRING_TABLE_OFFSET).u64()
                string_size: u64 = read_u32(bytes, command.offset + SymbolTable::MACHO_STRING_TABLE_SIZE_OFFSET).u64()
                return result if symbol_index.u64() >= symbol_count or symbol_offset > length.u64() or symbol_count > (length.u64() - symbol_offset) / Symbol::MACHO_NLIST_BYTES.u64()
                return result if string_offset > length.u64() or string_size > length.u64() - string_offset
                entry_offset: u64 = symbol_offset + symbol_index.u64() * Symbol::MACHO_NLIST_BYTES.u64()
                return result if entry_offset < symbol_offset or entry_offset > length.u64() or length.u64() - entry_offset < Symbol::MACHO_NLIST_BYTES.u64()
                offset: usize = entry_offset.usize()
                result.name_offset <- read_u32(bytes, offset + Symbol::MACHO_NLIST_NAME_OFFSET)
                result.symbol_type <- bytes[offset + Symbol::MACHO_NLIST_TYPE_OFFSET]
                result.section <- bytes[offset + Symbol::MACHO_NLIST_SECTION_OFFSET]
                result.description <- read_u16(bytes, offset + Symbol::MACHO_NLIST_DESCRIPTION_OFFSET)
                result.value <- read_u64(bytes, offset + Symbol::MACHO_NLIST_VALUE_OFFSET)
                result.valid <- true
                return result
            return result

        def macho_symbol_name(header: MachOHeader, bytes: u8&, length: usize, symbol_index: usize) -> MachOSymbolName:
            result: mutable MachOSymbolName = zeroed
            return result if not header.valid or not macho_commands_are_valid(header, bytes, length)
            for command_index in 0..<header.command_count.usize():
                command: MachOCommand = macho_command(header, bytes, length, command_index)
                return result if not command.valid
                continue if command.kind != SymbolTable::MACHO_SYMBOL_TABLE_COMMAND_KIND
                return result if command.size.usize() < SymbolTable::MACHO_SYMBOL_TABLE_COMMAND_BYTES
                symbol_offset: u64 = read_u32(bytes, command.offset + SymbolTable::NATIVE_MACHO_SYMBOL_TABLE_MACHO_SYMBOL_TABLE_OFFSET).u64()
                symbol_count: u64 = read_u32(bytes, command.offset + SymbolTable::MACHO_SYMBOL_COUNT_OFFSET).u64()
                string_offset: u64 = read_u32(bytes, command.offset + SymbolTable::NATIVE_MACHO_SYMBOL_TABLE_MACHO_STRING_TABLE_OFFSET).u64()
                string_size: u64 = read_u32(bytes, command.offset + SymbolTable::MACHO_STRING_TABLE_SIZE_OFFSET).u64()
                return result if symbol_index.u64() >= symbol_count or symbol_offset > length.u64() or symbol_count > (length.u64() - symbol_offset) / Symbol::MACHO_NLIST_BYTES.u64()
                return result if string_offset > length.u64() or string_size > length.u64() - string_offset
                symbol_name_offset: u64 = read_u32(bytes, (symbol_offset + symbol_index.u64() * Symbol::MACHO_NLIST_BYTES.u64()).usize() + Symbol::MACHO_NLIST_NAME_OFFSET).u64()
                return result if symbol_name_offset >= string_size or string_offset + symbol_name_offset < string_offset or string_offset + symbol_name_offset >= length.u64()
                start: u64 = string_offset + symbol_name_offset
                available: u64 = string_size - symbol_name_offset
                for index in 0..<available.usize():
                    value: u8 = bytes[start.usize() + index]
                    if value == 0 and index == 0:
                        result.valid <- true
                        result.length <- 0
                        return result
                    if value == 0:
                        result.valid <- true
                        result.length <- Symbol::MACHO_SYMBOL_NAME_CAPACITY if index > Symbol::MACHO_SYMBOL_NAME_CAPACITY else index
                        result.truncated <- index > Symbol::MACHO_SYMBOL_NAME_CAPACITY
                        return result
                    if index < Symbol::MACHO_SYMBOL_NAME_CAPACITY:
                        result.bytes[index] <- value
                    else:
                        result.truncated <- true
                result.truncated <- true
                return result
            return result
