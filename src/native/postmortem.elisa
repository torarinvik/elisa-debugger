# Postmortem artifacts are inspect-only.  A core file cannot be advertised as
# a resumable checkpoint or as prior execution history.

include "../core/errors.elisa"
include "../core/identity.elisa"

module DebuggerPostmortem:
    public:
        enum ArtifactKind:
            Unknown
            Core
            CrashReport
            Minidump

        enum ArtifactState:
            Missing
            Loading
            Ready
            Corrupt

        struct PostmortemArtifact:
            kind: mutable ArtifactKind
            state: mutable ArtifactState
            build: mutable DebuggerIdentity::DebugId
            pointer_bits: mutable u32
            thread_count: mutable u64
            resumable: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def postmortem_new(kind: ArtifactKind, build: DebuggerIdentity::DebugId) -> PostmortemArtifact:
            return PostmortemArtifact{kind: kind, state: ArtifactState.Loading, build: build, pointer_bits: 0, thread_count: 0, resumable: false, failure: DebuggerErrors::no_error()}

        def postmortem_mark_ready(artifact: PostmortemArtifact, pointer_bits: u32, thread_count: u64) -> PostmortemArtifact:
            updated: mutable PostmortemArtifact = artifact
            return updated if artifact.state == ArtifactState.Corrupt
            shape: DebuggerErrors::DebuggerError = postmortem_validate_shape(pointer_bits, thread_count)
            if not DebuggerErrors::error_is_ok(shape):
                updated.state <- ArtifactState.Corrupt
                updated.failure <- shape
                return updated
            updated.state <- ArtifactState.Ready
            updated.pointer_bits <- pointer_bits
            updated.thread_count <- thread_count
            updated.resumable <- false
            return updated

        def postmortem_mark_corrupt(artifact: PostmortemArtifact, detail: u32) -> PostmortemArtifact:
            updated: mutable PostmortemArtifact = artifact
            updated.state <- ArtifactState.Corrupt
            updated.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, detail)
            return updated

        def postmortem_can_inspect(artifact: PostmortemArtifact) -> bool:
            return artifact.state == ArtifactState.Ready and DebuggerErrors::error_is_ok(postmortem_validate_shape(artifact.pointer_bits, artifact.thread_count))

        def postmortem_validate_shape(pointer_bits: u32, thread_count: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, pointer_bits) if pointer_bits != 32 and pointer_bits != 64
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, thread_count.u32()) if thread_count == 0
            return DebuggerErrors::no_error()

        def postmortem_mark_crashed(artifact: PostmortemArtifact, pointer_bits: u32, thread_count: u64) -> PostmortemArtifact:
            updated: mutable PostmortemArtifact = artifact
            return updated if artifact.state == ArtifactState.Corrupt
            shape: DebuggerErrors::DebuggerError = postmortem_validate_shape(pointer_bits, thread_count)
            if not DebuggerErrors::error_is_ok(shape):
                updated.state <- ArtifactState.Corrupt
                updated.failure <- shape
                return updated
            updated.state <- ArtifactState.Ready
            updated.pointer_bits <- pointer_bits
            updated.thread_count <- thread_count
            updated.resumable <- false
            return updated
