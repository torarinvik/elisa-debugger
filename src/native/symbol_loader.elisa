# Convert validated object-file symbols into the provider-neutral symbol table.
# The loader accepts parsed records only; format readers remain responsible for
# all byte and table bounds.

include "./symbols.elisa"
include "./elf.elisa"
include "./macho.elisa"

module DebuggerNativeSymbolLoader:
    private:
        const module Hash:
            NATIVE_SYMBOL_LOADER_HASH_SYMBOL_HASH_PRIME: u64 = 1099511628211
            SYMBOL_ID_NONZERO_MASK: u64 = 1

        const module Capacity:
            SYMBOL_SECTION_MAX: usize = 512
            SYMBOL_TABLE_CAPACITY: usize = 512

        const module Elf:
            ELF_SYMBOL_SECTION_KIND: u32 = 2
            ELF_DYNAMIC_SYMBOL_SECTION_KIND: u32 = 11
            NATIVE_SYMBOL_LOADER_ELF_ELF_SYMBOL_ENTRY_BYTES: u64 = 24
            ELF_UNDEFINED_SECTION_INDEX: u16 = 0

        const module MachO:
            MACHO_SYMBOL_MAX: usize = 512
            MACHO_SYMBOL_TYPE_MASK: u8 = 14
            MACHO_SYMBOL_STAB_MASK: u8 = 224
            MACHO_SYMBOL_ABSOLUTE_KIND: u8 = 2
            MACHO_SYMBOL_SECTION_KIND: u8 = 14


        def record_id(name: DebuggerNativeElf::ElfSymbolName, address: u64, size: u64) -> DebuggerIdentity::DebugId:
            hash: mutable u64 = DebuggerNativeSymbols::symbol_name_id(name.bytes[0], name.length).value
            hash <- (hash ^ address) * Hash::NATIVE_SYMBOL_LOADER_HASH_SYMBOL_HASH_PRIME
            hash <- (hash ^ size) * Hash::NATIVE_SYMBOL_LOADER_HASH_SYMBOL_HASH_PRIME
            hash <- hash | Hash::SYMBOL_ID_NONZERO_MASK
            return DebuggerIdentity::debug_id(hash)

        def symbol_table_has_record(table: DebuggerNativeSymbols::SymbolTable, id: DebuggerIdentity::DebugId, address: u64, size: u64, name: DebuggerIdentity::DebugId) -> bool:
            return false if table.count > Capacity::SYMBOL_TABLE_CAPACITY
            for index in 0..<table.count:
                candidate: DebuggerNativeSymbols::Symbol = table.symbols[index]
                if candidate.id.value == id.value:
                    return candidate.address == address and candidate.size == size and candidate.name.value == name.value
            return false

        def elf_symbol_is_addressable(symbol: DebuggerNativeElf::ElfSymbol, name: DebuggerNativeElf::ElfSymbolName) -> bool:
            return false if symbol.section_index == Elf::ELF_UNDEFINED_SECTION_INDEX or symbol.size == 0 or name.length == 0
            return true

        def macho_symbol_is_addressable(symbol: DebuggerNativeMachO::MachOSymbol, name: DebuggerNativeMachO::MachOSymbolName, size: u64) -> bool:
            return false if size == 0 or name.length == 0 or (symbol.symbol_type & MachO::MACHO_SYMBOL_STAB_MASK) != 0
            symbol_kind: u8 = symbol.symbol_type & MachO::MACHO_SYMBOL_TYPE_MASK
            return symbol_kind == MachO::MACHO_SYMBOL_ABSOLUTE_KIND or symbol_kind == MachO::MACHO_SYMBOL_SECTION_KIND

    public:
        def load_elf_section(table: DebuggerNativeSymbols::SymbolTable, bytes: u8&, length: usize, header: DebuggerNativeElf::ElfHeader, section_index: usize, source: DebuggerIdentity::SourceSpan) -> DebuggerNativeSymbols::SymbolTable:
            original: DebuggerNativeSymbols::SymbolTable = table
            return original if not header.valid or section_index >= header.section_header_count.usize()
            section: DebuggerNativeElf::ElfSectionHeader = DebuggerNativeElf::elf_section_header(bytes, length, header, section_index)
            return original if not section.valid or (section.kind != Elf::ELF_SYMBOL_SECTION_KIND and section.kind != Elf::ELF_DYNAMIC_SYMBOL_SECTION_KIND) or section.entry_size != Elf::NATIVE_SYMBOL_LOADER_ELF_ELF_SYMBOL_ENTRY_BYTES or section.size / section.entry_size > Capacity::SYMBOL_SECTION_MAX
            symbol_count: usize = (section.size / section.entry_size).usize()
            return original if table.count > Capacity::SYMBOL_TABLE_CAPACITY
            updated: mutable DebuggerNativeSymbols::SymbolTable = table
            for index in 0..<symbol_count:
                symbol: DebuggerNativeElf::ElfSymbol = DebuggerNativeElf::elf_symbol(bytes, length, header, section_index, index)
                name: DebuggerNativeElf::ElfSymbolName = DebuggerNativeElf::elf_symbol_name(bytes, length, header, section_index, index)
                return original if not symbol.valid or not name.valid
                continue if name.truncated
                continue if not elf_symbol_is_addressable(symbol, name)
                name_id: DebuggerIdentity::DebugId = DebuggerNativeSymbols::symbol_name_id(name.bytes[0], name.length)
                identity: DebuggerIdentity::DebugId = record_id(name, symbol.value, symbol.size)
                continue if symbol_table_has_record(updated, identity, symbol.value, symbol.size, name_id)
                next: DebuggerNativeSymbols::SymbolTable = add_elf_symbol(updated, symbol, name, source)
                return original if next.count != updated.count + 1
                updated <- next
            return updated

        def add_elf_symbol(table: DebuggerNativeSymbols::SymbolTable, symbol: DebuggerNativeElf::ElfSymbol, name: DebuggerNativeElf::ElfSymbolName, source: DebuggerIdentity::SourceSpan) -> DebuggerNativeSymbols::SymbolTable:
            return table if not symbol.valid or not name.valid or name.truncated or not elf_symbol_is_addressable(symbol, name)
            identity: DebuggerIdentity::DebugId = record_id(name, symbol.value, symbol.size)
            return DebuggerNativeSymbols::symbols_add(table, DebuggerNativeSymbols::Symbol{id: identity, address: symbol.value, size: symbol.size, name: DebuggerNativeSymbols::symbol_name_id(name.bytes[0], name.length), source: source})

        def load_macho_symbols(table: DebuggerNativeSymbols::SymbolTable, bytes: u8&, length: usize, header: DebuggerNativeMachO::MachOHeader, symbol_count: usize, sizes: u64&, size_count: usize, source: DebuggerIdentity::SourceSpan) -> DebuggerNativeSymbols::SymbolTable:
            original: DebuggerNativeSymbols::SymbolTable = table
            return original if not header.valid or symbol_count > MachO::MACHO_SYMBOL_MAX or size_count < symbol_count
            return original if table.count > Capacity::SYMBOL_TABLE_CAPACITY
            updated: mutable DebuggerNativeSymbols::SymbolTable = table
            for index in 0..<symbol_count:
                symbol: DebuggerNativeMachO::MachOSymbol = DebuggerNativeMachO::macho_symbol(header, bytes, length, index)
                name: DebuggerNativeMachO::MachOSymbolName = DebuggerNativeMachO::macho_symbol_name(header, bytes, length, index)
                return original if not symbol.valid or not name.valid
                continue if name.truncated
                continue if not macho_symbol_is_addressable(symbol, name, sizes[index])
                name_id: DebuggerIdentity::DebugId = DebuggerNativeSymbols::symbol_name_id(name.bytes[0], name.length)
                identity_hash: mutable u64 = name_id.value
                identity_hash <- (identity_hash ^ symbol.value) * Hash::NATIVE_SYMBOL_LOADER_HASH_SYMBOL_HASH_PRIME
                identity_hash <- (identity_hash ^ sizes[index]) * Hash::NATIVE_SYMBOL_LOADER_HASH_SYMBOL_HASH_PRIME
                identity: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(identity_hash | Hash::SYMBOL_ID_NONZERO_MASK)
                continue if symbol_table_has_record(updated, identity, symbol.value, sizes[index], name_id)
                next: DebuggerNativeSymbols::SymbolTable = add_macho_symbol(updated, symbol, name, sizes[index], source)
                return original if next.count != updated.count + 1
                updated <- next
            return updated

        def add_macho_symbol(table: DebuggerNativeSymbols::SymbolTable, symbol: DebuggerNativeMachO::MachOSymbol, name: DebuggerNativeMachO::MachOSymbolName, size: u64, source: DebuggerIdentity::SourceSpan) -> DebuggerNativeSymbols::SymbolTable:
            return table if not symbol.valid or not name.valid or name.truncated or not macho_symbol_is_addressable(symbol, name, size)
            name_id: DebuggerIdentity::DebugId = DebuggerNativeSymbols::symbol_name_id(name.bytes[0], name.length)
            hash: mutable u64 = name_id.value
            hash <- (hash ^ symbol.value) * Hash::NATIVE_SYMBOL_LOADER_HASH_SYMBOL_HASH_PRIME
            hash <- (hash ^ size) * Hash::NATIVE_SYMBOL_LOADER_HASH_SYMBOL_HASH_PRIME
            identity: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(hash | Hash::SYMBOL_ID_NONZERO_MASK)
            return DebuggerNativeSymbols::symbols_add(table, DebuggerNativeSymbols::Symbol{id: identity, address: symbol.value, size: size, name: name_id, source: source})
