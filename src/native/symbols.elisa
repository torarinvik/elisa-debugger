# Content-addressed native symbols and source ranges.  Raw addresses are
# session-local attributes; durable identities remain DebugId values.

include "../core/identity.elisa"
include "../metadata/source.elisa"

module DebuggerNativeSymbols:
    private:
        const module Capacity:
            SYMBOL_CAPACITY: usize = 512
            SYMBOL_NAME_MAX_BYTES: usize = 256

        const module Identity:
            SYMBOL_NO_ID: u64 = 0
            SYMBOL_NO_SIZE: u64 = 0
            SYMBOL_MAX_SIZE: u64 = 18446744073709551615
            SYMBOL_MAX_ADDRESS: u64 = 18446744073709551615

        const module Hash:
            SYMBOL_HASH_OFFSET_BASIS: u64 = 1469598103934665603
            NATIVE_SYMBOLS_HASH_SYMBOL_HASH_PRIME: u64 = 1099511628211


        def symbol_source_is_valid(source: DebuggerIdentity::SourceSpan) -> bool:
            return true if source.file.value == Identity::SYMBOL_NO_ID and source.start_byte == 0 and source.end_byte == 0 and source.start_line == 0 and source.start_column == 0 and source.end_line == 0 and source.end_column == 0 and source.discriminator == 0
            return DebuggerMetadata::source_span_is_valid(source)

    public:
        struct Symbol:
            id: mutable DebuggerIdentity::DebugId
            address: mutable u64
            size: mutable u64
            name: mutable DebuggerIdentity::DebugId
            source: mutable DebuggerIdentity::SourceSpan

        struct SymbolTable:
            symbols: mutable Symbol[Capacity::SYMBOL_CAPACITY]
            count: mutable usize
            load_bias: mutable u64

        def symbols_new() -> SymbolTable:
            table: mutable SymbolTable = zeroed
            table.count <- 0
            table.load_bias <- 0
            return table

        def symbols_set_load_bias(table: mutable SymbolTable&, load_bias: u64) -> void:
            table.load_bias <- load_bias

        def symbol_name_id(bytes: u8&, length: usize) -> DebuggerIdentity::DebugId:
            return DebuggerIdentity::debug_id(Identity::SYMBOL_NO_ID) if length == 0 or length > Capacity::SYMBOL_NAME_MAX_BYTES
            hash: mutable u64 = Hash::SYMBOL_HASH_OFFSET_BASIS
            for index in 0..<length:
                hash <- (hash ^ bytes[index].u64()) * Hash::NATIVE_SYMBOLS_HASH_SYMBOL_HASH_PRIME
            return DebuggerIdentity::debug_id(Identity::SYMBOL_NO_ID) if hash == Identity::SYMBOL_NO_ID
            return DebuggerIdentity::debug_id(hash)

        def symbols_add(table: SymbolTable, symbol: Symbol) -> SymbolTable:
            updated: mutable SymbolTable = table
            return updated if table.count >= Capacity::SYMBOL_CAPACITY or symbol.id.value == Identity::SYMBOL_NO_ID or symbol.name.value == Identity::SYMBOL_NO_ID or symbol.size == Identity::SYMBOL_NO_SIZE or symbol.address > Identity::SYMBOL_MAX_ADDRESS - symbol.size or not symbol_source_is_valid(symbol.source)
            for index in 0..<table.count:
                return updated if table.symbols[index].id.value == symbol.id.value
            updated.symbols[table.count] <- symbol
            updated.count <- table.count + 1
            return updated

        def symbols_is_valid(table: SymbolTable) -> bool:
            return false if table.count > Capacity::SYMBOL_CAPACITY
            for index in 0..<table.count:
                return false if table.symbols[index].id.value == Identity::SYMBOL_NO_ID or table.symbols[index].name.value == Identity::SYMBOL_NO_ID or table.symbols[index].size == Identity::SYMBOL_NO_SIZE or table.symbols[index].address > Identity::SYMBOL_MAX_ADDRESS - table.symbols[index].size or not symbol_source_is_valid(table.symbols[index].source)
                for previous in 0..<index:
                    return false if table.symbols[previous].id.value == table.symbols[index].id.value
            return true

        def symbols_find(table: SymbolTable, address: u64) -> Symbol:
            result: mutable Symbol = zeroed
            return result if table.count > Capacity::SYMBOL_CAPACITY
            return result if address < table.load_bias
            relative: u64 = address - table.load_bias
            best_size: mutable u64 = Identity::SYMBOL_MAX_SIZE
            for index in 0..<table.count:
                candidate: Symbol = table.symbols[index]
                if relative >= candidate.address and relative - candidate.address < candidate.size and candidate.size <= best_size:
                    result <- candidate
                    best_size <- candidate.size
            return result
