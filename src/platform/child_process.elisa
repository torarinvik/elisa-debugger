# Direct POSIX child launch boundary. Arguments are passed as an argv vector;
# this module never constructs or evaluates a shell command.

@link_name("posix_spawn")
extern debugger_posix_spawn(pid: mutable i32&, path: cstr, file_actions: mutable void&&?, attributes: mutable void&&?, argv: mutable cstr&&, environment: mutable cstr&&) -> i32 can[Blocking.IO, Unsafe.PointerCast]
@link_name("posix_spawn_file_actions_init")
extern debugger_posix_spawn_actions_init(actions: mutable void&&?) -> i32 can[Unsafe.PointerCast]
@link_name("posix_spawn_file_actions_adddup2")
extern debugger_posix_spawn_actions_adddup2(actions: mutable void&&?, source_fd: i32, target_fd: i32) -> i32 can[Unsafe.PointerCast]
@link_name("posix_spawn_file_actions_addclose")
extern debugger_posix_spawn_actions_addclose(actions: mutable void&&?, fd: i32) -> i32 can[Unsafe.PointerCast]
@link_name("posix_spawn_file_actions_destroy")
extern debugger_posix_spawn_actions_destroy(actions: mutable void&&?) -> i32 can[Unsafe.PointerCast]
@link_name("pipe")
extern debugger_pipe(descriptors: mutable i32&) -> i32 can[Blocking.IO]
@link_name("read")
extern debugger_read(fd: i32, buffer: void&, count: usize) -> isize can[Blocking.IO]
@link_name("close")
extern debugger_close(fd: i32) -> i32 can[Blocking.IO]
@link_name("waitpid")
extern debugger_waitpid(pid: i32, status: mutable i32&, options: i32) -> i32 can[Blocking.IO]
@link_name("environ")
extern debugger_environ: mutable cstr&&

static if ELISA_TARGET_OS_MACOS:
    @link_name("__error")
    extern debugger_process_errno_location() -> mutable i32&
static elif ELISA_TARGET_OS_LINUX:
    @link_name("__errno_location")
    extern debugger_process_errno_location() -> mutable i32&

module DebuggerHostProcess:
    private:
        const module Capture:
            PROCESS_OUTPUT_CAPACITY: usize = 4096
            PROCESS_READ_CHUNK_BYTES: usize = 512
            PROCESS_OUTPUT_LENGTH_INCREMENT: usize = 1

        const module Descriptor:
            PROCESS_DESCRIPTOR_COUNT: usize = 2
            PROCESS_READ_DESCRIPTOR_INDEX: usize = 0
            PROCESS_WRITE_DESCRIPTOR_INDEX: usize = 1

        const module Stream:
            PROCESS_STDOUT_FD: i32 = 1
            PROCESS_STDERR_FD: i32 = 2

        const module Wait:
            PROCESS_WAIT_OPTIONS: i32 = 0
            PROCESS_WAIT_EXITED_MASK: i32 = 127
            PROCESS_WAIT_SIGNALED_STOPPED: i32 = 127
            PROCESS_WAIT_EXIT_CODE_SHIFT: i32 = 8
            PROCESS_WAIT_EXIT_CODE_MASK: i32 = 255
            PROCESS_INTERRUPTED_ERROR_CODE: i32 = 4

        const module Status:
            PROCESS_SYSCALL_FAILURE: i32 = -1
            PROCESS_INITIAL_CHILD_PID: i32 = 0
            PROCESS_INITIAL_WAIT_STATUS: i32 = 0
            PROCESS_READ_EOF: isize = 0
            PROCESS_NO_SIGNAL: i32 = 0
            PROCESS_STATUS_SUCCESS: i32 = 0


    public:
        enum SpawnFailure:
            None
            InvalidArgument
            PipeCreation
            DescriptorUnavailable
            FileActions
            SpawnRejected
            OutputRead
            WaitFailed

        struct SpawnResult:
            output_length: mutable usize
            output_truncated: mutable bool
            child_spawned: mutable bool
            child_reaped: mutable bool
            exit_code: mutable i32
            terminated_by_signal: mutable bool
            signal_number: mutable i32
            wait_status: mutable i32
            system_error: mutable i32
            failure: mutable SpawnFailure

        def spawn_output_capacity() -> usize:
            return Capture::PROCESS_OUTPUT_CAPACITY

        def process_last_error() -> i32 can[Unsafe.PointerCast]:
            return debugger_process_errno_location()[0]

        # `argv` must be a null-terminated vector of C strings. `path` is passed
        # directly to posix_spawn. stdout and stderr share one bounded capture.
        # `output` must address at least `output_capacity` writable bytes; that
        # capacity is capped here so excess child output is drained and discarded.
        def spawn_capture(path: cstr, argv: mutable cstr&&, output: mutable u8&, output_capacity: usize) -> SpawnResult can[Blocking.IO, Unsafe.PointerCast]:
            result: mutable SpawnResult = zeroed
            result.failure <- SpawnFailure.None
            result.exit_code <- Status::PROCESS_STATUS_SUCCESS
            result.signal_number <- Status::PROCESS_NO_SIGNAL
            if path[0].u8() == 0 or output_capacity > Capture::PROCESS_OUTPUT_CAPACITY:
                result.failure <- SpawnFailure.InvalidArgument
                return result

            descriptors: mutable i32[Descriptor::PROCESS_DESCRIPTOR_COUNT] = zeroed
            pipe_status: i32 = debugger_pipe(&descriptors[Descriptor::PROCESS_READ_DESCRIPTOR_INDEX]) can Blocking.IO
            if pipe_status != Status::PROCESS_STATUS_SUCCESS:
                result.failure <- SpawnFailure.PipeCreation
                result.system_error <- process_last_error() can Unsafe.PointerCast
                return result
            read_fd: i32 = descriptors[Descriptor::PROCESS_READ_DESCRIPTOR_INDEX]
            write_fd: i32 = descriptors[Descriptor::PROCESS_WRITE_DESCRIPTOR_INDEX]
            if read_fd <= Stream::PROCESS_STDERR_FD or write_fd <= Stream::PROCESS_STDERR_FD:
                result.failure <- SpawnFailure.DescriptorUnavailable
                _ = debugger_close(read_fd) can Blocking.IO
                _ = debugger_close(write_fd) can Blocking.IO
                return result

            actions: mutable void&? = null
            actions_pointer: mutable void&&? = (&actions).cast[mutable void&&?] can Unsafe.PointerCast
            action_status: mutable i32 = debugger_posix_spawn_actions_init(actions_pointer) can Unsafe.PointerCast
            if action_status != Status::PROCESS_STATUS_SUCCESS:
                result.failure <- SpawnFailure.FileActions
                result.system_error <- action_status
                _ = debugger_close(read_fd) can Blocking.IO
                _ = debugger_close(write_fd) can Blocking.IO
                return result
            action_status <- debugger_posix_spawn_actions_adddup2(actions_pointer, write_fd, Stream::PROCESS_STDOUT_FD) can Unsafe.PointerCast
            action_status <- debugger_posix_spawn_actions_adddup2(actions_pointer, write_fd, Stream::PROCESS_STDERR_FD) can Unsafe.PointerCast if action_status == Status::PROCESS_STATUS_SUCCESS
            action_status <- debugger_posix_spawn_actions_addclose(actions_pointer, read_fd) can Unsafe.PointerCast if action_status == Status::PROCESS_STATUS_SUCCESS
            action_status <- debugger_posix_spawn_actions_addclose(actions_pointer, write_fd) can Unsafe.PointerCast if action_status == Status::PROCESS_STATUS_SUCCESS
            if action_status != Status::PROCESS_STATUS_SUCCESS:
                result.failure <- SpawnFailure.FileActions
                result.system_error <- action_status
                _ = debugger_posix_spawn_actions_destroy(actions_pointer) can Unsafe.PointerCast
                _ = debugger_close(read_fd) can Blocking.IO
                _ = debugger_close(write_fd) can Blocking.IO
                return result
            child_pid: mutable i32 = Status::PROCESS_INITIAL_CHILD_PID
            argument_vector: cstr = argv.cast[cstr] can Unsafe.PointerCast
            spawn_status: i32 = debugger_posix_spawn(&child_pid, path, actions_pointer, null, argument_vector, debugger_environ) can Blocking.IO, Unsafe.PointerCast
            _ = debugger_posix_spawn_actions_destroy(actions_pointer) can Unsafe.PointerCast
            _ = debugger_close(write_fd) can Blocking.IO
            if spawn_status != Status::PROCESS_STATUS_SUCCESS:
                result.failure <- SpawnFailure.SpawnRejected
                result.system_error <- spawn_status
                _ = debugger_close(read_fd) can Blocking.IO
                return result

            result.child_spawned <- true
            read_buffer: mutable u8[Capture::PROCESS_READ_CHUNK_BYTES] = zeroed
            capture_open: mutable bool = true
            while capture_open:
                read_count: isize = debugger_read(read_fd, (&read_buffer[0]).cast[void&], Capture::PROCESS_READ_CHUNK_BYTES) can Blocking.IO
                if read_count == Status::PROCESS_READ_EOF:
                    capture_open <- false
                elif read_count < 0.isize():
                    read_error: i32 = process_last_error() can Unsafe.PointerCast
                    if read_error != Wait::PROCESS_INTERRUPTED_ERROR_CODE:
                        result.failure <- SpawnFailure.OutputRead
                        result.system_error <- read_error
                        capture_open <- false
                else:
                    received: usize = read_count.usize()
                    for index in 0..<received:
                        if result.output_length < output_capacity:
                            output[result.output_length] <- read_buffer[index]
                            result.output_length <- result.output_length + Capture::PROCESS_OUTPUT_LENGTH_INCREMENT
                        else:
                            result.output_truncated <- true
            _ = debugger_close(read_fd) can Blocking.IO

            raw_status: mutable i32 = Status::PROCESS_INITIAL_WAIT_STATUS
            waited_pid: mutable i32 = Status::PROCESS_SYSCALL_FAILURE
            wait_open: mutable bool = true
            while wait_open:
                waited_pid <- debugger_waitpid(child_pid, &raw_status, Wait::PROCESS_WAIT_OPTIONS) can Blocking.IO
                if waited_pid == child_pid:
                    wait_open <- false
                elif waited_pid >= 0:
                    result.failure <- SpawnFailure.WaitFailed
                    wait_open <- false
                else:
                    wait_error: i32 = process_last_error() can Unsafe.PointerCast
                    if wait_error != Wait::PROCESS_INTERRUPTED_ERROR_CODE:
                        result.failure <- SpawnFailure.WaitFailed
                        result.system_error <- wait_error
                        wait_open <- false
            if waited_pid != child_pid:
                return result
            result.child_reaped <- true
            result.wait_status <- raw_status
            terminating_signal: i32 = raw_status & Wait::PROCESS_WAIT_EXITED_MASK
            if terminating_signal == Status::PROCESS_NO_SIGNAL:
                result.exit_code <- (raw_status >> Wait::PROCESS_WAIT_EXIT_CODE_SHIFT) & Wait::PROCESS_WAIT_EXIT_CODE_MASK
            elif terminating_signal != Wait::PROCESS_WAIT_SIGNALED_STOPPED:
                result.terminated_by_signal <- true
                result.signal_number <- terminating_signal
            else:
                result.failure <- SpawnFailure.WaitFailed
            return result
