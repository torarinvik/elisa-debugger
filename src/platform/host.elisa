# Platform-neutral host facts.  Concrete Darwin/Linux FFI bindings can satisfy
# this contract without leaking OS constants into the core session model.

module DebuggerPlatform:
    private:
        const module Host:
            OPERATING_SYSTEM_MAX: u16 = 3
            ARCHITECTURE_MAX: u16 = 2
            PLATFORM_HOST_HOST_POINTER_BITS: u32 = 64


    public:
        enum OperatingSystem:
            Unknown
            MacOS
            Linux
            Windows

        enum Architecture:
            Unknown
            Arm64
            X86_64

        struct HostTarget:
            operating_system: mutable OperatingSystem
            architecture: mutable Architecture
            pointer_bits: mutable u32
            page_size: mutable u64

        def unknown_host() -> HostTarget:
            return HostTarget{operating_system: OperatingSystem.Unknown, architecture: Architecture.Unknown, pointer_bits: 0, page_size: 0}

        def host_is_supported(host: HostTarget) -> bool:
            return host.operating_system.u16() <= Host::OPERATING_SYSTEM_MAX and host.architecture.u16() <= Host::ARCHITECTURE_MAX and host.pointer_bits == Host::PLATFORM_HOST_HOST_POINTER_BITS and host.page_size > 0 and host.operating_system != OperatingSystem.Unknown and host.architecture != Architecture.Unknown
