# Process-control model for native attach/launch providers.  Platform FFI
# bindings populate these handles; core logic remains independent of PIDs.

include "../core/errors.elisa"

module DebuggerProcess:
    private:
        const INVALID_HANDLE: u64 = 0
        const MEMORY_READ_LIMIT: usize = 4096
        const PROCESS_STATE_MAX: u16 = 6

    public:
        enum ProcessState:
            Unknown
            Launching
            Running
            Stopped
            Exited
            Detached
            Crashed

        struct ProcessHandle:
            pid: mutable u64
            start_identity: mutable u64
            state: mutable ProcessState
            owned: mutable bool

        struct MemoryRead:
            address: mutable u64
            bytes: mutable u8[MEMORY_READ_LIMIT]
            length: mutable usize
            complete: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def invalid_process() -> ProcessHandle:
            return ProcessHandle{pid: INVALID_HANDLE, start_identity: INVALID_HANDLE, state: ProcessState.Unknown, owned: false}

        def process_attach(pid: u64, start_identity: u64) -> ProcessHandle:
            return invalid_process() if pid == INVALID_HANDLE or start_identity == INVALID_HANDLE
            return ProcessHandle{pid: pid, start_identity: start_identity, state: ProcessState.Stopped, owned: false}

        def process_launch(pid: u64, start_identity: u64) -> ProcessHandle:
            return invalid_process() if pid == INVALID_HANDLE or start_identity == INVALID_HANDLE
            return ProcessHandle{pid: pid, start_identity: start_identity, state: ProcessState.Running, owned: true}

        def process_is_valid(process: ProcessHandle) -> bool:
            return process.state.u16() <= PROCESS_STATE_MAX and process.pid != INVALID_HANDLE and process.start_identity != INVALID_HANDLE and process.state != ProcessState.Unknown and process.state != ProcessState.Detached

        def process_identity_matches(process: ProcessHandle, pid: u64, start_identity: u64) -> bool:
            return process_is_valid(process) and process.pid == pid and process.start_identity == start_identity

        def process_can_control(process: ProcessHandle, pid: u64, start_identity: u64) -> bool:
            return process_identity_matches(process, pid, start_identity) and process.state != ProcessState.Exited and process.state != ProcessState.Crashed

        def process_terminate(process: ProcessHandle, pid: u64, start_identity: u64) -> ProcessHandle:
            updated: mutable ProcessHandle = process
            return updated if not process.owned or not process_identity_matches(process, pid, start_identity)
            return updated if process.state == ProcessState.Exited or process.state == ProcessState.Crashed
            updated.state <- ProcessState.Exited
            return updated

        def process_mark_stopped(process: ProcessHandle) -> ProcessHandle:
            updated: mutable ProcessHandle = process
            updated.state <- ProcessState.Stopped if process_is_valid(process) and process.state != ProcessState.Exited and process.state != ProcessState.Crashed
            return updated

        def process_mark_running(process: ProcessHandle) -> ProcessHandle:
            updated: mutable ProcessHandle = process
            updated.state <- ProcessState.Running if process_is_valid(process) and process.state != ProcessState.Exited and process.state != ProcessState.Crashed
            return updated

        def process_detach(process: ProcessHandle) -> ProcessHandle:
            updated: mutable ProcessHandle = process
            return updated if process.state == ProcessState.Exited or process.state == ProcessState.Crashed
            updated.state <- ProcessState.Detached if process_is_valid(process)
            updated.owned <- false
            return updated

        def process_mark_exited(process: ProcessHandle, crashed: bool) -> ProcessHandle:
            updated: mutable ProcessHandle = process
            return updated if not process_is_valid(process)
            return updated if process.state == ProcessState.Exited or process.state == ProcessState.Crashed
            updated.state <- ProcessState.Crashed if crashed else ProcessState.Exited
            return updated

        def memory_read_invalid(address: u64, detail: u32) -> MemoryRead:
            read: mutable MemoryRead = zeroed
            read.address <- address
            read.length <- 0
            read.complete <- false
            read.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, detail)
            return read

        def memory_read_from_buffer(address: u64, source: u8&, length: usize) -> MemoryRead:
            return memory_read_invalid(address, MEMORY_READ_LIMIT.u32()) if length > MEMORY_READ_LIMIT
            read: mutable MemoryRead = zeroed
            read.address <- address
            read.length <- length
            read.complete <- true
            read.failure <- DebuggerErrors::no_error()
            for index in 0..<length:
                read.bytes[index] <- source[index]
            return read
