# Caller-owned opaque posix_spawn_file_actions_t storage. Darwin needs one
# pointer-sized slot; Linux libc needs 80 bytes on the qualified 64-bit hosts.
# One aligned buffer covers both ABIs. Only libc reads or writes its fields.

module DebuggerSpawnActions:
    private:
        const module Storage:
            WORDS: usize = 10
    public:
        struct FileActions:
            words: mutable u64[Storage::WORDS]

        def file_actions_new() -> FileActions:
            return FileActions{words: zeroed}
