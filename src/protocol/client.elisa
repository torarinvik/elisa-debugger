# Elisa reference client model for editor plugins, test runners, and custom
# tools.  It owns request IDs and stop-generation tokens while transport code
# remains replaceable.

include "./messages.elisa"
include "../core/errors.elisa"

module DebuggerProtocolClient:
    private:
        const CLIENT_PENDING_CAPACITY: usize = 32
        const CLIENT_FIRST_REQUEST_ID: u64 = 1
        const CLIENT_MAX_REQUEST_ID: u64 = 18446744073709551615
        const CLIENT_NO_SESSION: u64 = 0
        const CLIENT_NO_PAGE: u64 = 0
        const DETAIL_PENDING_FULL: u32 = 1
        const DETAIL_UNKNOWN_RESPONSE: u32 = 2
        const DETAIL_PROTOCOL: u32 = 3
        const DETAIL_REQUEST_ID_EXHAUSTED: u32 = 4
        const DETAIL_NOT_READY: u32 = 5
        const DETAIL_PENDING_CORRUPT: u32 = 6

    public:
        enum ClientState:
            Created
            Ready
            Closed
            Failed

        struct ReferenceClient:
            protocol: mutable DebuggerProtocol::ProtocolVersion
            session_id: mutable u64
            next_request_id: mutable u64
            stop_generation: mutable u64
            pending: mutable u64[CLIENT_PENDING_CAPACITY]
            pending_count: mutable usize
            state: mutable ClientState
            last_error: mutable DebuggerErrors::DebuggerError

        def client_new(protocol: DebuggerProtocol::ProtocolVersion) -> ReferenceClient:
            client: mutable ReferenceClient = zeroed
            client.protocol <- protocol
            client.next_request_id <- CLIENT_FIRST_REQUEST_ID
            client.session_id <- CLIENT_NO_SESSION
            client.state <- ClientState.Created
            client.last_error <- DebuggerErrors::no_error()
            return client

        def client_start(client: mutable ReferenceClient&, session_id: u64) -> DebuggerErrors::DebuggerError:
            if client.state != ClientState.Created:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_NOT_READY)
                client.last_error <- failure
                return failure
            if not DebuggerProtocol::protocol_compatible(client.protocol):
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_PROTOCOL)
                client.last_error <- failure
                return failure
            if session_id == CLIENT_NO_SESSION:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_PROTOCOL)
                client.last_error <- failure
                return failure
            client.session_id <- session_id
            client.state <- ClientState.Ready
            client.last_error <- DebuggerErrors::no_error()
            return DebuggerErrors::no_error()

        def client_make_request(client: mutable ReferenceClient&, method: DebuggerProtocol::Method, page_size: u64) -> DebuggerProtocol::RequestEnvelope:
            request: mutable DebuggerProtocol::RequestEnvelope = zeroed
            if client.state != ClientState.Ready:
                client.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_NOT_READY)
                return request
            if not DebuggerProtocol::method_is_valid(method):
                client.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_PROTOCOL)
                return request
            if client.pending_count > CLIENT_PENDING_CAPACITY:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_PENDING_CORRUPT)
                client.state <- ClientState.Failed
                client.last_error <- failure
                return request
            if client.pending_count >= CLIENT_PENDING_CAPACITY:
                client.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, DETAIL_PENDING_FULL)
                return request
            if client.next_request_id == 0 or client.next_request_id > CLIENT_MAX_REQUEST_ID:
                client.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, DETAIL_REQUEST_ID_EXHAUSTED)
                return request
            request.kind <- DebuggerProtocol::MessageKind.Request
            request.method <- method
            request.request_id <- client.next_request_id
            request.session_id <- client.session_id
            request.expected_stop_generation <- client.stop_generation
            request.page_size <- DebuggerProtocol::protocol_bound_page_size(page_size)
            request.target_event <- 0
            client.pending[client.pending_count] <- request.request_id
            client.pending_count <- client.pending_count + 1
            client.next_request_id <- 0 if request.request_id == CLIENT_MAX_REQUEST_ID
            client.next_request_id <- request.request_id + CLIENT_FIRST_REQUEST_ID if request.request_id != CLIENT_MAX_REQUEST_ID
            client.last_error <- DebuggerErrors::no_error()
            return request

        def client_accept(client: mutable ReferenceClient&, response: DebuggerProtocol::ResponseEnvelope) -> DebuggerErrors::DebuggerError:
            found: mutable bool = false
            if client.pending_count > CLIENT_PENDING_CAPACITY:
                capacity_failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_UNKNOWN_RESPONSE)
                client.state <- ClientState.Failed
                client.last_error <- capacity_failure
                return capacity_failure
            if not DebuggerErrors::error_is_well_formed(response.failure) or response.ok and not DebuggerErrors::error_is_ok(response.failure) or not response.ok and DebuggerErrors::error_is_ok(response.failure):
                envelope_failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_PROTOCOL)
                client.state <- ClientState.Failed
                client.last_error <- envelope_failure
                return envelope_failure
            for index in 0..<client.pending_count:
                if client.pending[index] == response.request_id:
                    client.pending[index] <- client.pending[client.pending_count - 1]
                    client.pending_count <- client.pending_count - 1
                    found <- true
                    break
            if not found:
                unknown_response: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_UNKNOWN_RESPONSE)
                client.state <- ClientState.Failed
                client.last_error <- unknown_response
                return unknown_response
            if response.stop_generation < client.stop_generation:
                generation_failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_PROTOCOL)
                client.state <- ClientState.Failed
                client.last_error <- generation_failure
                return generation_failure
            client.stop_generation <- response.stop_generation if response.stop_generation > client.stop_generation
            if response.ok:
                client.last_error <- DebuggerErrors::no_error()
                return DebuggerErrors::no_error()
            client.last_error <- response.failure
            client.state <- ClientState.Failed if response.failure.code == DebuggerErrors::ErrorCode.Corrupt or response.failure.code == DebuggerErrors::ErrorCode.Transport
            return response.failure

        def client_close(client: mutable ReferenceClient&) -> void:
            client.state <- ClientState.Closed
            client.pending_count <- 0

        def client_is_idle(client: ReferenceClient) -> bool:
            return client.pending_count == 0
