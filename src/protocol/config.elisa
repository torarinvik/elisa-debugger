# Versioned launch configuration shared by DAP, the session service, and
# plugin bridges.  Paths are opaque content/path IDs at this boundary.

include "../core/errors.elisa"

module DebuggerProtocolConfig:
    private:
        const module Capacity:
            PROTOCOL_CONFIG_CAPACITY_ARGUMENTS: usize = 64
            ENVIRONMENT: usize = 32
            PATH_MAPPINGS: usize = 32

        const module EnumLimit:
            PROTOCOL_CONFIG_ENUM_LIMIT_ENGINE: u16 = 3
            PROTOCOL_CONFIG_ENUM_LIMIT_RECORDING: u16 = 3

        const module Detail:
            PROTOCOL_CONFIG_DETAIL_PROGRAM: u32 = 1
            PROTOCOL_CONFIG_DETAIL_WORKING_DIRECTORY: u32 = 2
            PROTOCOL_CONFIG_DETAIL_ARGUMENTS: u32 = 3
            PATH_MAPPING: u32 = 4
            PROTOCOL_CONFIG_DETAIL_ENGINE: u32 = 5
            TRACE: u32 = 6

        const module Identifier:
            PROTOCOL_CONFIG_IDENTIFIER_NONE: u64 = 0

    public:
        enum EngineSelection:
            Managed
            InstrumentedNative
            Attach
            Postmortem

        enum RecordingSelection:
            Disabled
            Record
            Replay
            Observational

        struct PathMapping:
            client_root: mutable u64
            server_root: mutable u64

        struct LaunchConfiguration:
            program: mutable u64
            arguments: mutable u64[Capacity::PROTOCOL_CONFIG_CAPACITY_ARGUMENTS]
            argument_count: mutable usize
            arguments_overflowed: mutable bool
            environment: mutable u64[Capacity::ENVIRONMENT]
            environment_count: mutable usize
            environment_overflowed: mutable bool
            working_directory: mutable u64
            compiler: mutable u64
            engine: mutable EngineSelection
            recording: mutable RecordingSelection
            trace: mutable u64
            stop_on_entry: mutable bool
            mappings: mutable PathMapping[Capacity::PATH_MAPPINGS]
            mapping_count: mutable usize
            mappings_overflowed: mutable bool

        def configuration_new() -> LaunchConfiguration:
            return LaunchConfiguration{program: Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE, arguments: zeroed, argument_count: 0, arguments_overflowed: false, environment: zeroed, environment_count: 0, environment_overflowed: false, working_directory: Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE, compiler: Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE, engine: EngineSelection.Managed, recording: RecordingSelection.Disabled, trace: Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE, stop_on_entry: false, mappings: zeroed, mapping_count: 0, mappings_overflowed: false}

        def configuration_add_argument(configuration: LaunchConfiguration, argument: u64) -> LaunchConfiguration:
            updated: mutable LaunchConfiguration = configuration
            if configuration.argument_count >= Capacity::PROTOCOL_CONFIG_CAPACITY_ARGUMENTS or argument == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE:
                updated.arguments_overflowed <- true
                return updated
            updated.arguments[configuration.argument_count] <- argument
            updated.argument_count <- configuration.argument_count + 1
            return updated

        def configuration_add_environment(configuration: LaunchConfiguration, variable: u64) -> LaunchConfiguration:
            updated: mutable LaunchConfiguration = configuration
            if configuration.environment_count >= Capacity::ENVIRONMENT or variable == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE:
                updated.environment_overflowed <- true
                return updated
            updated.environment[configuration.environment_count] <- variable
            updated.environment_count <- configuration.environment_count + 1
            return updated

        def configuration_add_mapping(configuration: LaunchConfiguration, mapping: PathMapping) -> LaunchConfiguration:
            updated: mutable LaunchConfiguration = configuration
            if configuration.mapping_count >= Capacity::PATH_MAPPINGS or mapping.client_root == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE or mapping.server_root == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE:
                updated.mappings_overflowed <- true
                return updated
            updated.mappings[configuration.mapping_count] <- mapping
            updated.mapping_count <- configuration.mapping_count + 1
            return updated

        def configuration_validate(configuration: LaunchConfiguration) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PROTOCOL_CONFIG_DETAIL_PROGRAM) if configuration.program == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PROTOCOL_CONFIG_DETAIL_WORKING_DIRECTORY) if configuration.working_directory == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PROTOCOL_CONFIG_DETAIL_ARGUMENTS) if configuration.arguments_overflowed or configuration.environment_overflowed or configuration.argument_count > Capacity::PROTOCOL_CONFIG_CAPACITY_ARGUMENTS or configuration.environment_count > Capacity::ENVIRONMENT
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PATH_MAPPING) if configuration.mappings_overflowed or configuration.mapping_count > Capacity::PATH_MAPPINGS
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PROTOCOL_CONFIG_DETAIL_ENGINE) if configuration.engine.u16() > EnumLimit::PROTOCOL_CONFIG_ENUM_LIMIT_ENGINE or configuration.recording.u16() > EnumLimit::PROTOCOL_CONFIG_ENUM_LIMIT_RECORDING
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::TRACE) if configuration.recording == RecordingSelection.Replay and configuration.trace == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::TRACE) if configuration.recording == RecordingSelection.Disabled and configuration.trace != Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE
            for index in 0..<configuration.mapping_count:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PATH_MAPPING) if configuration.mappings[index].client_root == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE or configuration.mappings[index].server_root == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE
                for previous in 0..<index:
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PATH_MAPPING) if configuration.mappings[previous].client_root == configuration.mappings[index].client_root
            for index in 0..<configuration.argument_count:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PROTOCOL_CONFIG_DETAIL_ARGUMENTS) if configuration.arguments[index] == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE
            for index in 0..<configuration.environment_count:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::PROTOCOL_CONFIG_DETAIL_ARGUMENTS) if configuration.environment[index] == Identifier::PROTOCOL_CONFIG_IDENTIFIER_NONE
            return DebuggerErrors::no_error()
