# DAP-facing capability projection.  The wire adapter can map this value to
# initialize response fields without knowing provider internals.

include "../core/session.elisa"

module DebuggerDAP:
    public:
        struct AdapterCapabilities:
            supports_configuration_done: mutable bool
            supports_function_breakpoints: mutable bool
            supports_conditional_breakpoints: mutable bool
            supports_hit_conditional_breakpoints: mutable bool
            supports_data_breakpoints: mutable bool
            supports_evaluate_for_hovers: mutable bool
            supports_terminate_request: mutable bool
            supports_restart_request: mutable bool
            supports_step_back: mutable bool
            supports_set_variable: mutable bool
            supports_read_memory: mutable bool
            supports_disassemble_request: mutable bool

        def capabilities_for(session: DebuggerSession::Session) -> AdapterCapabilities:
            return AdapterCapabilities{
                supports_configuration_done: true,
                supports_function_breakpoints: session.capabilities.function_breakpoints,
                supports_conditional_breakpoints: session.capabilities.source_breakpoints,
                supports_hit_conditional_breakpoints: session.capabilities.source_breakpoints,
                supports_data_breakpoints: session.capabilities.data_breakpoints,
                supports_evaluate_for_hovers: session.capabilities.expression_evaluation,
                supports_terminate_request: true,
                supports_restart_request: false,
                supports_step_back: session.capabilities.reverse_execution,
                supports_set_variable: false,
                supports_read_memory: false,
                supports_disassemble_request: session.capabilities.engine == DebuggerCapabilities::EngineKind.InstrumentedNative
            }
