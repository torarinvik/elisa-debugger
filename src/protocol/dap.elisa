# DAP-facing capability projection.  The wire adapter can map this value to
# initialize response fields without knowing provider internals.

include "../core/session.elisa"

module DebuggerDAP:
    private:

        const module EventHistory:
            EVENT_BATCH_CAPACITY: usize = 3

        const module ProcessExit:
            NO_EXIT_CODE: i64 = 0

    public:
        enum RequestKind:
            Other
            Initialize
            Launch
            Continue
            Pause
            Step
            ReverseContinue
            Terminate

        enum EventKind:
            Initialized
            Continued
            Stopped
            Terminated
            Exited

        enum StopReason:
            None
            Step
            Pause
            Breakpoint

        struct AdapterEvent:
            kind: mutable EventKind
            reason: mutable StopReason
            exit_code: mutable i64

        struct EventBatch:
            events: mutable AdapterEvent[EventHistory::EVENT_BATCH_CAPACITY]
            count: mutable usize

        struct AdapterCapabilities:
            supports_configuration_done: mutable bool
            supports_function_breakpoints: mutable bool
            supports_conditional_breakpoints: mutable bool
            supports_hit_conditional_breakpoints: mutable bool
            supports_data_breakpoints: mutable bool
            supports_evaluate_for_hovers: mutable bool
            supports_terminate_request: mutable bool
            supports_restart_request: mutable bool
            supports_step_back: mutable bool
            supports_set_variable: mutable bool
            supports_read_memory: mutable bool
            supports_disassemble_request: mutable bool

        def capabilities_for(session: DebuggerSession::Session) -> AdapterCapabilities:
            return AdapterCapabilities{
                supports_configuration_done: true,
                supports_function_breakpoints: false,
                supports_conditional_breakpoints: false,
                supports_hit_conditional_breakpoints: false,
                supports_data_breakpoints: false,
                supports_evaluate_for_hovers: false,
                supports_terminate_request: session.capabilities.engine == DebuggerCapabilities::EngineKind.Managed,
                supports_restart_request: false,
                supports_step_back: session.capabilities.reverse_execution,
                supports_set_variable: false,
                supports_read_memory: session.capabilities.memory_read,
                supports_disassemble_request: false
            }

        def event_batch_append(batch: mutable EventBatch&, event: AdapterEvent) -> void:
            return if batch.count >= EventHistory::EVENT_BATCH_CAPACITY
            batch.events[batch.count] <- event
            batch.count <- batch.count + 1

        def event_batch_add(batch: mutable EventBatch&, kind: EventKind, reason: StopReason, exit_code: i64) -> void:
            event_batch_append(batch, AdapterEvent{kind: kind, reason: reason, exit_code: exit_code})

        def target_has_exited(session_state: DebuggerSession::SessionState, machine_halted: bool, machine_faulted: bool) -> bool:
            return session_state == DebuggerSession::SessionState.Exited or machine_halted or machine_faulted

        # DAP lifecycle policy is kept separate from wire encoding. This lets
        # adapters and tests agree on event order without depending on JSON or
        # transport framing.
        def events_after_request(request: RequestKind, accepted: bool, session_state: DebuggerSession::SessionState, machine_halted: bool, machine_faulted: bool, exit_code: i64) -> EventBatch:
            batch: mutable EventBatch = zeroed
            return batch if not accepted
            if request == RequestKind.Initialize:
                event_batch_add(batch, EventKind.Initialized, StopReason.None, ProcessExit::NO_EXIT_CODE)
                return batch
            return batch if request == RequestKind.Launch
            if request == RequestKind.Continue:
                event_batch_add(batch, EventKind.Continued, StopReason.None, ProcessExit::NO_EXIT_CODE)
                if target_has_exited(session_state, machine_halted, machine_faulted):
                    event_batch_add(batch, EventKind.Terminated, StopReason.None, ProcessExit::NO_EXIT_CODE)
                    event_batch_add(batch, EventKind.Exited, StopReason.None, exit_code)
                else:
                    # A successful bounded continue that has not exited stopped
                    # at a verified managed breakpoint.
                    event_batch_add(batch, EventKind.Stopped, StopReason.Breakpoint, ProcessExit::NO_EXIT_CODE)
                return batch
            if request == RequestKind.Terminate:
                event_batch_add(batch, EventKind.Terminated, StopReason.None, ProcessExit::NO_EXIT_CODE)
                event_batch_add(batch, EventKind.Exited, StopReason.None, exit_code)
                return batch
            if request == RequestKind.Pause:
                event_batch_add(batch, EventKind.Stopped, StopReason.Pause, ProcessExit::NO_EXIT_CODE)
                return batch
            if request == RequestKind.Step or request == RequestKind.ReverseContinue:
                if target_has_exited(session_state, machine_halted, machine_faulted):
                    event_batch_add(batch, EventKind.Terminated, StopReason.None, ProcessExit::NO_EXIT_CODE)
                    event_batch_add(batch, EventKind.Exited, StopReason.None, exit_code)
                else:
                    reason: StopReason = StopReason.Step if request == RequestKind.Step else StopReason.Breakpoint
                    event_batch_add(batch, EventKind.Stopped, reason, ProcessExit::NO_EXIT_CODE)
            return batch
