# Bounded DAP argument decoding shared by the wire adapter.  It extracts only
# the memory fields needed by readMemory and never treats arbitrary JSON text as
# an address or a length.

module DebuggerDAPPayload:
    private:
        const ASCII_QUOTE: u8 = 34
        const ASCII_COLON: u8 = 58
        const ASCII_COMMA: u8 = 44
        const ASCII_BRACE_OPEN: u8 = 123
        const ASCII_BRACE_CLOSE: u8 = 125
        const ASCII_BRACKET_OPEN: u8 = 91
        const ASCII_BRACKET_CLOSE: u8 = 93
        const ASCII_BACKSLASH: u8 = 92
        const ASCII_SPACE: u8 = 32
        const ASCII_TAB: u8 = 9
        const ASCII_LINE_FEED: u8 = 10
        const ASCII_CARRIAGE_RETURN: u8 = 13
        const ASCII_ZERO: u8 = 48
        const ASCII_ONE: u8 = 49
        const ASCII_NINE: u8 = 57
        const ASCII_MINUS: u8 = 45
        const ASCII_A: u8 = 97
        const ASCII_C: u8 = 99
        const ASCII_E: u8 = 101
        const ASCII_F: u8 = 102
        const ASCII_M: u8 = 109
        const ASCII_N: u8 = 110
        const ASCII_O: u8 = 111
        const ASCII_R: u8 = 114
        const ASCII_UPPER_R: u8 = 82
        const ASCII_T: u8 = 116
        const ASCII_U: u8 = 117
        const ASCII_Y: u8 = 121
        const ASCII_S: u8 = 115
        const ASCII_I: u8 = 105
        const ASCII_L: u8 = 108
        const ASCII_UPPER_S: u8 = 83
        const ASCII_UPPER_A: u8 = 65
        const ASCII_UPPER_F: u8 = 70
        const ASCII_LOWER_X: u8 = 120
        const ASCII_UPPER_X: u8 = 88
        const MEMORY_REFERENCE_FIELD: u8 = 1
        const COUNT_FIELD: u8 = 2
        const OFFSET_FIELD: u8 = 7
        const MEMORY_REFERENCE_LENGTH: usize = 15
        const COUNT_LENGTH: usize = 5
        const OFFSET_LENGTH: usize = 6
        const MEMORY_REFERENCE_MAX_DIGITS: usize = 16
        const MEMORY_COUNT_MAX: u64 = 64
        const MAX_INTEGER: u64 = 18446744073709551615
        const MAX_SIGNED_INTEGER: u64 = 9223372036854775807
        const MIN_SIGNED_INTEGER_MAGNITUDE: u64 = 9223372036854775808
        const NO_INDEX: usize = 18446744073709551615
        const HEX_BASE: u64 = 16
        const DECIMAL_BASE: u64 = 10
        const HEX_PREFIX_LENGTH: usize = 2
        const HEX_DIGIT_OFFSET: u64 = 10
        const FIRST_DIGIT_COUNT: usize = 1
        const PROGRAM_FIELD: u8 = 3
        const ARGUMENTS_FIELD: u8 = 4
        const LINES_START_AT_ONE_FIELD: u8 = 5
        const COLUMNS_START_AT_ONE_FIELD: u8 = 6
        const PROGRAM_PATH_CAPACITY: usize = 1024
        const PROGRAM_FIELD_LENGTH: usize = 7
        const ARGUMENTS_FIELD_LENGTH: usize = 9
        const LINES_START_AT_ONE_FIELD_LENGTH: usize = 13
        const COLUMNS_START_AT_ONE_FIELD_LENGTH: usize = 15
        const JSON_TRUE_LENGTH: usize = 4
        const JSON_FALSE_LENGTH: usize = 5
        const ASCII_P: u8 = 112
        const ASCII_G: u8 = 103
        const ASCII_SLASH: u8 = 47
        const ASCII_BACKSPACE: u8 = 98
        const ASCII_FORM_FEED: u8 = 102
        const ASCII_NEWLINE: u8 = 110
        const ASCII_CARRIAGE_RETURN_ESCAPE: u8 = 114
        const ASCII_ESCAPE_TAB: u8 = 116
        const ASCII_LOWER_U: u8 = 117
        const UNICODE_HEX_DIGITS: usize = 4
        const UNICODE_SURROGATE_HIGH_START: u64 = 55296
        const UNICODE_SURROGATE_HIGH_END: u64 = 56319
        const UNICODE_SURROGATE_LOW_START: u64 = 56320
        const UNICODE_SURROGATE_LOW_END: u64 = 57343
        const UNICODE_SURROGATE_BASE: u64 = 65536
        const UNICODE_SURROGATE_SHIFT: u64 = 10
        const UNICODE_HIGH_SURROGATE_OFFSET: u64 = 55296
        const UNICODE_LOW_SURROGATE_OFFSET: u64 = 56320
        const UNICODE_MAX_CODEPOINT: u64 = 1114111
        const UNICODE_CONTROL_MAX: u64 = 31
        const UNICODE_TWO_BYTE_MAX_EXCLUSIVE: u64 = 2048
        const UNICODE_THREE_BYTE_MAX_EXCLUSIVE: u64 = 65536
        const UTF8_CONTINUATION_BASE: u64 = 128
        const UTF8_TWO_BYTE_BASE: u64 = 192
        const UTF8_THREE_BYTE_BASE: u64 = 224
        const UTF8_FOUR_BYTE_BASE: u64 = 240
        const UTF8_CONTINUATION_MASK: u64 = 63
        const UTF8_FIRST_TWO_MASK: u64 = 31
        const UTF8_FIRST_THREE_MASK: u64 = 15
        const UTF8_FIRST_FOUR_MASK: u64 = 7
        const UTF8_SHIFT: u64 = 6
        const ASCII_DELETE: u64 = 127
        const UTF8_TWO_BYTE_START: u64 = 194
        const UTF8_TWO_BYTE_END: u64 = 223
        const UTF8_THREE_BYTE_START: u64 = 224
        const UTF8_THREE_BYTE_END: u64 = 239
        const UTF8_FOUR_BYTE_START: u64 = 240
        const UTF8_FOUR_BYTE_END: u64 = 244
        const UTF8_CONTINUATION_MIN: u64 = 128
        const UTF8_CONTINUATION_MAX: u64 = 191
        const UTF8_TWO_BYTE_MIN_CODEPOINT: u64 = 128
        const UTF8_THREE_BYTE_MIN_CODEPOINT: u64 = 2048
        const UTF8_FOUR_BYTE_MIN_CODEPOINT: u64 = 65536
        const UTF8_TWO_BYTE_LENGTH: usize = 2
        const UTF8_THREE_BYTE_LENGTH: usize = 3
        const UTF8_FOUR_BYTE_LENGTH: usize = 4
        const UNICODE_SURROGATE_RANGE_START: u64 = 55296
        const UNICODE_SURROGATE_RANGE_END: u64 = 57343

        struct ParsedValue:
            valid: mutable bool
            value: mutable u64
            end: mutable usize

        def invalid_value() -> ParsedValue:
            return ParsedValue{valid: false, value: 0, end: NO_INDEX}

        def is_whitespace(byte: u8) -> bool:
            return byte == ASCII_SPACE or byte == ASCII_TAB or byte == ASCII_LINE_FEED or byte == ASCII_CARRIAGE_RETURN

        def field_length(field: u8) -> usize:
            return LINES_START_AT_ONE_FIELD_LENGTH if field == LINES_START_AT_ONE_FIELD
            return COLUMNS_START_AT_ONE_FIELD_LENGTH if field == COLUMNS_START_AT_ONE_FIELD
            return ARGUMENTS_FIELD_LENGTH if field == ARGUMENTS_FIELD
            return PROGRAM_FIELD_LENGTH if field == PROGRAM_FIELD
            return MEMORY_REFERENCE_LENGTH if field == MEMORY_REFERENCE_FIELD
            return OFFSET_LENGTH if field == OFFSET_FIELD else COUNT_LENGTH

        def field_byte(field: u8, position: usize) -> u8:
            if field == LINES_START_AT_ONE_FIELD:
                return ASCII_L if position == 0
                return ASCII_I if position == 1
                return ASCII_N if position == 2
                return ASCII_E if position == 3
                return ASCII_S if position == 4
                return ASCII_UPPER_S if position == 5
                return ASCII_T if position == 6
                return ASCII_A if position == 7
                return ASCII_R if position == 8
                return ASCII_T if position == 9
                return ASCII_UPPER_A if position == 10
                return ASCII_T if position == 11
                return ASCII_ONE
            if field == COLUMNS_START_AT_ONE_FIELD:
                return ASCII_C if position == 0
                return ASCII_O if position == 1
                return ASCII_L if position == 2
                return ASCII_U if position == 3
                return ASCII_M if position == 4
                return ASCII_N if position == 5
                return ASCII_S if position == 6
                return ASCII_UPPER_S if position == 7
                return ASCII_T if position == 8
                return ASCII_A if position == 9
                return ASCII_R if position == 10
                return ASCII_T if position == 11
                return ASCII_UPPER_A if position == 12
                return ASCII_T if position == 13
                return ASCII_ONE
            if field == ARGUMENTS_FIELD:
                return ASCII_A if position == 0
                return ASCII_R if position == 1
                return ASCII_G if position == 2
                return ASCII_U if position == 3
                return ASCII_M if position == 4
                return ASCII_E if position == 5
                return ASCII_N if position == 6
                return ASCII_T if position == 7
                return ASCII_S
            if field == PROGRAM_FIELD:
                return ASCII_P if position == 0
                return ASCII_R if position == 1
                return ASCII_O if position == 2
                return ASCII_G if position == 3
                return ASCII_R if position == 4
                return ASCII_A if position == 5
                return ASCII_M
            if field == MEMORY_REFERENCE_FIELD:
                return ASCII_M if position == 0
                return ASCII_E if position == 1
                return ASCII_M if position == 2
                return ASCII_O if position == 3
                return ASCII_R if position == 4
                return ASCII_Y if position == 5
                return ASCII_UPPER_R if position == 6
                return ASCII_E if position == 7
                return ASCII_F if position == 8
                return ASCII_E if position == 9
                return ASCII_R if position == 10
                return ASCII_E if position == 11
                return ASCII_N if position == 12
                return ASCII_C if position == 13
                return ASCII_E
            if field == OFFSET_FIELD:
                return ASCII_O if position == 0
                return ASCII_F if position == 1
                return ASCII_F if position == 2
                return ASCII_S if position == 3
                return ASCII_E if position == 4
                return ASCII_T
            return ASCII_C if position == 0
            return ASCII_O if position == 1
            return ASCII_U if position == 2
            return ASCII_N if position == 3
            return ASCII_T

        def field_matches(payload: u8&, index: usize, length: usize, field: u8) -> bool:
            key_length: usize = field_length(field)
            return false if index >= length or payload[index] != ASCII_QUOTE
            decoded_length: mutable usize = 0
            cursor: mutable usize = index + 1
            while cursor < length:
                byte: u8 = payload[cursor]
                return decoded_length == key_length if byte == ASCII_QUOTE
                decoded: mutable u64 = byte.u64()
                if byte == ASCII_BACKSLASH:
                    return false if cursor + 1 >= length
                    escaped: u8 = payload[cursor + 1]
                    if escaped == ASCII_LOWER_U:
                        unicode_value: ParsedValue = parse_unicode_quad(payload, length, cursor + 2)
                        return false if not unicode_value.valid or unicode_value.value >= UTF8_CONTINUATION_BASE
                        decoded <- unicode_value.value
                        cursor <- unicode_value.end
                    else:
                        # Escaped controls cannot equal any supported field
                        # character. Decode the printable JSON escapes exactly.
                        decoded <- escaped.u64() if escaped == ASCII_QUOTE or escaped == ASCII_BACKSLASH or escaped == ASCII_SLASH
                        decoded <- ASCII_SPACE.u64() if escaped == ASCII_BACKSPACE or escaped == ASCII_FORM_FEED or escaped == ASCII_NEWLINE or escaped == ASCII_CARRIAGE_RETURN_ESCAPE or escaped == ASCII_ESCAPE_TAB
                        return false if escaped != ASCII_QUOTE and escaped != ASCII_BACKSLASH and escaped != ASCII_SLASH and escaped != ASCII_BACKSPACE and escaped != ASCII_FORM_FEED and escaped != ASCII_NEWLINE and escaped != ASCII_CARRIAGE_RETURN_ESCAPE and escaped != ASCII_ESCAPE_TAB
                        cursor <- cursor + 2
                else:
                    cursor <- cursor + 1
                return false if decoded_length >= key_length or decoded != field_byte(field, decoded_length).u64()
                decoded_length <- decoded_length + 1
            return false

        def field_value_start(payload: u8&, length: usize, field: u8, start: usize) -> usize:
            return NO_INDEX if start >= length
            in_string: mutable bool = false
            escaped: mutable bool = false
            index: mutable usize = 0
            while index < length:
                byte: u8 = payload[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    else:
                        escaped <- true if byte == ASCII_BACKSLASH
                        in_string <- false if byte == ASCII_QUOTE and not escaped
                    index <- index + 1
                else:
                    if byte == ASCII_QUOTE:
                        key_start: usize = index
                        key_cursor: mutable usize = index + 1
                        key_escaped: mutable bool = false
                        while key_cursor < length:
                            key_byte: u8 = payload[key_cursor]
                            if key_escaped:
                                key_escaped <- false
                            else:
                                if key_byte == ASCII_BACKSLASH:
                                    key_escaped <- true
                                else:
                                    break if key_byte == ASCII_QUOTE
                            key_cursor <- key_cursor + 1
                        return NO_INDEX if key_cursor >= length or key_escaped
                        lookahead: mutable usize = key_cursor + 1
                        while lookahead < length and is_whitespace(payload[lookahead]):
                            lookahead <- lookahead + 1
                        if key_start >= start and field_matches(payload, key_start, length, field) and lookahead < length and payload[lookahead] == ASCII_COLON:
                            lookahead <- lookahead + 1
                            while lookahead < length and is_whitespace(payload[lookahead]):
                                lookahead <- lookahead + 1
                            return lookahead
                        index <- key_cursor + 1
                    else:
                        index <- index + 1
            return NO_INDEX

        def json_string_end(payload: u8&, length: usize, start: usize) -> usize:
            return NO_INDEX if start >= length or payload[start] != ASCII_QUOTE
            escaped: mutable bool = false
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = payload[index]
                if escaped:
                    escaped <- false
                else:
                    if byte == ASCII_BACKSLASH:
                        escaped <- true
                    else:
                        return index + 1 if byte == ASCII_QUOTE
                index <- index + 1
            return NO_INDEX

        def json_value_end(payload: u8&, length: usize, start: usize) -> usize:
            return NO_INDEX if start >= length
            return json_string_end(payload, length, start) if payload[start] == ASCII_QUOTE
            if payload[start] == ASCII_BRACE_OPEN or payload[start] == ASCII_BRACKET_OPEN:
                depth: mutable usize = 0
                in_string: mutable bool = false
                escaped: mutable bool = false
                index: mutable usize = start
                while index < length:
                    byte: u8 = payload[index]
                    if in_string:
                        if escaped:
                            escaped <- false
                        else:
                            if byte == ASCII_BACKSLASH:
                                escaped <- true
                            else:
                                in_string <- false if byte == ASCII_QUOTE
                    else:
                        if byte == ASCII_QUOTE:
                            in_string <- true
                        else:
                            if byte == ASCII_BRACE_OPEN or byte == ASCII_BRACKET_OPEN:
                                depth <- depth + 1
                            else:
                                if byte == ASCII_BRACE_CLOSE or byte == ASCII_BRACKET_CLOSE:
                                    return index + 1 if depth == 1
                                    depth <- depth - 1
                    index <- index + 1
                return NO_INDEX
            index: mutable usize = start
            while index < length:
                byte: u8 = payload[index]
                break if is_whitespace(byte) or byte == ASCII_COMMA or byte == ASCII_BRACE_CLOSE or byte == ASCII_BRACKET_CLOSE
                index <- index + 1
            return NO_INDEX if index == start else index

        def parse_json_boolean(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length
            if payload[start] == ASCII_T:
                return invalid_value() if length - start < JSON_TRUE_LENGTH
                return invalid_value() if payload[start + 1] != ASCII_R or payload[start + 2] != ASCII_U or payload[start + 3] != ASCII_E
                return ParsedValue{valid: true, value: 1, end: start + JSON_TRUE_LENGTH}
            if payload[start] == ASCII_F:
                return invalid_value() if length - start < JSON_FALSE_LENGTH
                return invalid_value() if payload[start + 1] != ASCII_A or payload[start + 2] != ASCII_L or payload[start + 3] != ASCII_S or payload[start + 4] != ASCII_E
                return ParsedValue{valid: true, value: 0, end: start + JSON_FALSE_LENGTH}
            return invalid_value()

        # Reads only direct properties from one object and skips complete
        # nested values, so launch path lookup cannot accept nested decoys.
        def object_field_value_start(payload: u8&, length: usize, object_start: usize, field: u8, occurrence: usize) -> usize:
            return NO_INDEX if object_start >= length or payload[object_start] != ASCII_BRACE_OPEN
            property_index: mutable usize = object_start + 1
            matched: mutable usize = 0
            while property_index < length:
                while property_index < length and (is_whitespace(payload[property_index]) or payload[property_index] == ASCII_COMMA):
                    property_index <- property_index + 1
                return NO_INDEX if property_index >= length or payload[property_index] == ASCII_BRACE_CLOSE
                key_start: usize = property_index
                key_end: usize = json_string_end(payload, length, key_start)
                return NO_INDEX if key_end == NO_INDEX
                property_index <- key_end
                while property_index < length and is_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                return NO_INDEX if property_index >= length or payload[property_index] != ASCII_COLON
                property_index <- property_index + 1
                while property_index < length and is_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                value_start: usize = property_index
                value_end: usize = json_value_end(payload, length, value_start)
                return NO_INDEX if value_end == NO_INDEX
                if field_matches(payload, key_start, length, field):
                    if matched == occurrence:
                        return value_start
                    matched <- matched + 1
                property_index <- value_end
            return NO_INDEX

        def hex_digit(byte: u8) -> ParsedValue:
            return ParsedValue{valid: true, value: (byte - ASCII_ZERO).u64(), end: 0} if byte >= ASCII_ZERO and byte <= ASCII_NINE
            return ParsedValue{valid: true, value: (byte - ASCII_A).u64() + HEX_DIGIT_OFFSET, end: 0} if byte >= ASCII_A and byte <= ASCII_F
            return ParsedValue{valid: true, value: (byte - ASCII_UPPER_A).u64() + HEX_DIGIT_OFFSET, end: 0} if byte >= ASCII_UPPER_A and byte <= ASCII_UPPER_F
            return invalid_value()

        def parse_unicode_quad(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start > length or length - start < UNICODE_HEX_DIGITS
            value: mutable u64 = 0
            for offset in 0..<UNICODE_HEX_DIGITS:
                digit: ParsedValue = hex_digit(payload[start + offset])
                return invalid_value() if not digit.valid
                value <- value * HEX_BASE + digit.value
            return ParsedValue{valid: true, value: value, end: start + UNICODE_HEX_DIGITS}

        def program_path_append(path: mutable ProgramPath&, value: u8) -> bool:
            return false if path.length >= PROGRAM_PATH_CAPACITY
            path.bytes[path.length] <- value
            path.length <- path.length + 1
            return true

        def invalid_program_path() -> ProgramPath:
            return ProgramPath{bytes: zeroed, length: 0, valid: false}

        def program_path_append_codepoint(path: mutable ProgramPath&, value: u64) -> bool:
            return false if value == 0 or value <= UNICODE_CONTROL_MAX or value == ASCII_DELETE
            return false if value > UNICODE_MAX_CODEPOINT
            if value < UTF8_CONTINUATION_BASE:
                return program_path_append(path, value.u8())
            if value < UNICODE_TWO_BYTE_MAX_EXCLUSIVE:
                first: u8 = (UTF8_TWO_BYTE_BASE | (value >> UTF8_SHIFT)).u8()
                second: u8 = (UTF8_CONTINUATION_BASE | (value & UTF8_CONTINUATION_MASK)).u8()
                return false if not program_path_append(path, first)
                return program_path_append(path, second)
            if value < UNICODE_THREE_BYTE_MAX_EXCLUSIVE:
                first: u8 = (UTF8_THREE_BYTE_BASE | (value >> (UTF8_SHIFT * 2))).u8()
                second: u8 = (UTF8_CONTINUATION_BASE | ((value >> UTF8_SHIFT) & UTF8_CONTINUATION_MASK)).u8()
                third: u8 = (UTF8_CONTINUATION_BASE | (value & UTF8_CONTINUATION_MASK)).u8()
                return false if not program_path_append(path, first)
                return false if not program_path_append(path, second)
                return program_path_append(path, third)
            first: u8 = (UTF8_FOUR_BYTE_BASE | (value >> (UTF8_SHIFT * 3))).u8()
            second: u8 = (UTF8_CONTINUATION_BASE | ((value >> (UTF8_SHIFT * 2)) & UTF8_CONTINUATION_MASK)).u8()
            third: u8 = (UTF8_CONTINUATION_BASE | ((value >> UTF8_SHIFT) & UTF8_CONTINUATION_MASK)).u8()
            fourth: u8 = (UTF8_CONTINUATION_BASE | (value & UTF8_CONTINUATION_MASK)).u8()
            return false if not program_path_append(path, first)
            return false if not program_path_append(path, second)
            return false if not program_path_append(path, third)
            return program_path_append(path, fourth)

        def program_path_utf8_is_valid(path: ProgramPath) -> bool:
            index: mutable usize = 0
            while index < path.length:
                first: u64 = path.bytes[index].u64()
                sequence_length: mutable usize = 1
                minimum_codepoint: mutable u64 = 0
                codepoint: mutable u64 = first
                if first >= UTF8_TWO_BYTE_START and first <= UTF8_TWO_BYTE_END:
                    sequence_length <- UTF8_TWO_BYTE_LENGTH
                    minimum_codepoint <- UTF8_TWO_BYTE_MIN_CODEPOINT
                    codepoint <- first & UTF8_FIRST_TWO_MASK
                if first >= UTF8_THREE_BYTE_START and first <= UTF8_THREE_BYTE_END:
                    sequence_length <- UTF8_THREE_BYTE_LENGTH
                    minimum_codepoint <- UTF8_THREE_BYTE_MIN_CODEPOINT
                    codepoint <- first & UTF8_FIRST_THREE_MASK
                if first >= UTF8_FOUR_BYTE_START and first <= UTF8_FOUR_BYTE_END:
                    sequence_length <- UTF8_FOUR_BYTE_LENGTH
                    minimum_codepoint <- UTF8_FOUR_BYTE_MIN_CODEPOINT
                    codepoint <- first & UTF8_FIRST_FOUR_MASK
                if first >= UTF8_CONTINUATION_MIN and sequence_length == 1:
                    return false
                return false if sequence_length > path.length - index
                for offset in 1..<sequence_length:
                    continuation: u64 = path.bytes[index + offset].u64()
                    return false if continuation < UTF8_CONTINUATION_MIN or continuation > UTF8_CONTINUATION_MAX
                    codepoint <- (codepoint << UTF8_SHIFT) | (continuation & UTF8_CONTINUATION_MASK)
                return false if codepoint < minimum_codepoint or codepoint > UNICODE_MAX_CODEPOINT
                return false if codepoint >= UNICODE_SURROGATE_RANGE_START and codepoint <= UNICODE_SURROGATE_RANGE_END
                index <- index + sequence_length
            return true

        def parse_program_path_string(payload: u8&, length: usize, start: usize) -> ProgramPath:
            path: mutable ProgramPath = zeroed
            path.valid <- true
            return invalid_program_path() if start >= length or payload[start] != ASCII_QUOTE
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = payload[index]
                if byte == ASCII_QUOTE:
                    return invalid_program_path() if path.length == 0 or not program_path_utf8_is_valid(path)
                    return path
                if byte == ASCII_BACKSLASH:
                    return invalid_program_path() if index + 1 >= length
                    escaped: u8 = payload[index + 1]
                    if escaped == ASCII_QUOTE or escaped == ASCII_BACKSLASH or escaped == ASCII_SLASH:
                        path.valid <- program_path_append(path, escaped)
                        return invalid_program_path() if not path.valid
                        index <- index + 2
                        continue
                    if escaped == ASCII_LOWER_U:
                        high: ParsedValue = parse_unicode_quad(payload, length, index + 2)
                        return invalid_program_path() if not high.valid
                        codepoint: mutable u64 = high.value
                        index <- high.end
                        if high.value >= UNICODE_SURROGATE_HIGH_START and high.value <= UNICODE_SURROGATE_HIGH_END:
                            return invalid_program_path() if index + 1 >= length or payload[index] != ASCII_BACKSLASH or payload[index + 1] != ASCII_LOWER_U
                            low: ParsedValue = parse_unicode_quad(payload, length, index + 2)
                            return invalid_program_path() if not low.valid or low.value < UNICODE_SURROGATE_LOW_START or low.value > UNICODE_SURROGATE_LOW_END
                            codepoint <- UNICODE_SURROGATE_BASE + ((high.value - UNICODE_HIGH_SURROGATE_OFFSET) << UNICODE_SURROGATE_SHIFT) + (low.value - UNICODE_LOW_SURROGATE_OFFSET)
                            index <- low.end
                        else:
                            return invalid_program_path() if high.value >= UNICODE_SURROGATE_LOW_START and high.value <= UNICODE_SURROGATE_LOW_END
                        path.valid <- program_path_append_codepoint(path, codepoint)
                        return invalid_program_path() if not path.valid
                        continue
                    # Control escapes cannot name a useful portable filesystem path.
                    return invalid_program_path() if escaped == ASCII_BACKSPACE or escaped == ASCII_FORM_FEED or escaped == ASCII_NEWLINE or escaped == ASCII_CARRIAGE_RETURN_ESCAPE or escaped == ASCII_ESCAPE_TAB
                    return invalid_program_path()
                return invalid_program_path() if byte < ASCII_SPACE or byte.u64() == ASCII_DELETE
                path.valid <- program_path_append(path, byte)
                return invalid_program_path() if not path.valid
                index <- index + 1
            return invalid_program_path()

        def parse_memory_reference(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length or payload[start] != ASCII_QUOTE
            index: mutable usize = start + 1
            return invalid_value() if index >= length
            if index + HEX_PREFIX_LENGTH - 1 < length and payload[index] == ASCII_ZERO and (payload[index + 1] == ASCII_LOWER_X or payload[index + 1] == ASCII_UPPER_X):
                index <- index + HEX_PREFIX_LENGTH
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] != ASCII_QUOTE:
                return invalid_value() if payload[index] == ASCII_BACKSLASH
                digit: ParsedValue = hex_digit(payload[index])
                return invalid_value() if not digit.valid or digits >= MEMORY_REFERENCE_MAX_DIGITS or value > (MAX_INTEGER - digit.value) / HEX_BASE
                value <- value * HEX_BASE + digit.value
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if index >= length or digits == 0
            if index + 1 < length:
                delimiter: u8 = payload[index + 1]
                return invalid_value() if not is_whitespace(delimiter) and delimiter != ASCII_COMMA and delimiter != ASCII_BRACE_CLOSE and delimiter != ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index + 1}

        def parse_count(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length or payload[start] < ASCII_ZERO or payload[start] > ASCII_NINE
            index: mutable usize = start
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] >= ASCII_ZERO and payload[index] <= ASCII_NINE:
                return invalid_value() if digits == FIRST_DIGIT_COUNT and value == 0
                digit: u64 = (payload[index] - ASCII_ZERO).u64()
                return invalid_value() if value > (MEMORY_COUNT_MAX - digit) / DECIMAL_BASE
                value <- value * DECIMAL_BASE + digit
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if digits == 0
            if index < length:
                return invalid_value() if not is_whitespace(payload[index]) and payload[index] != ASCII_COMMA and payload[index] != ASCII_BRACE_CLOSE and payload[index] != ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index}

        def parse_signed_offset(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length
            negative: bool = payload[start] == ASCII_MINUS
            index: mutable usize = start + 1 if negative else start
            return invalid_value() if index >= length or payload[index] < ASCII_ZERO or payload[index] > ASCII_NINE
            maximum: u64 = MIN_SIGNED_INTEGER_MAGNITUDE if negative else MAX_SIGNED_INTEGER
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] >= ASCII_ZERO and payload[index] <= ASCII_NINE:
                return invalid_value() if digits == FIRST_DIGIT_COUNT and value == 0
                digit: u64 = (payload[index] - ASCII_ZERO).u64()
                return invalid_value() if value > (maximum - digit) / DECIMAL_BASE
                value <- value * DECIMAL_BASE + digit
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if digits == 0
            if index < length:
                return invalid_value() if not is_whitespace(payload[index]) and payload[index] != ASCII_COMMA and payload[index] != ASCII_BRACE_CLOSE and payload[index] != ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index}

    public:
        struct ProgramPath:
            bytes: mutable u8[PROGRAM_PATH_CAPACITY]
            length: mutable usize
            valid: mutable bool

        struct ClientCoordinates:
            valid: mutable bool
            lines_start_at_one: mutable bool
            columns_start_at_one: mutable bool

        struct MemoryRequest:
            valid: mutable bool
            address: mutable u64
            count: mutable usize

        def memory_request_parse(payload: u8&, length: usize) -> MemoryRequest:
            request: mutable MemoryRequest = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, ARGUMENTS_FIELD, 0)
            return request if arguments == NO_INDEX or object_field_value_start(payload, length, root_start, ARGUMENTS_FIELD, 1) != NO_INDEX
            return request if arguments >= length or payload[arguments] != ASCII_BRACE_OPEN
            first_reference: usize = object_field_value_start(payload, length, arguments, MEMORY_REFERENCE_FIELD, 0)
            first_count: usize = object_field_value_start(payload, length, arguments, COUNT_FIELD, 0)
            first_offset: usize = object_field_value_start(payload, length, arguments, OFFSET_FIELD, 0)
            return request if first_reference == NO_INDEX or first_count == NO_INDEX
            return request if object_field_value_start(payload, length, arguments, MEMORY_REFERENCE_FIELD, 1) != NO_INDEX or object_field_value_start(payload, length, arguments, COUNT_FIELD, 1) != NO_INDEX or object_field_value_start(payload, length, arguments, OFFSET_FIELD, 1) != NO_INDEX
            reference: ParsedValue = parse_memory_reference(payload, length, first_reference)
            count: ParsedValue = parse_count(payload, length, first_count)
            return request if not reference.valid or not count.valid
            address: mutable u64 = reference.value
            if first_offset != NO_INDEX:
                offset: ParsedValue = parse_signed_offset(payload, length, first_offset)
                return request if not offset.valid
                if payload[first_offset] == ASCII_MINUS:
                    return request if offset.value > address
                    address <- address - offset.value
                else:
                    return request if offset.value > MAX_INTEGER - address
                    address <- address + offset.value
            request.valid <- true
            request.address <- address
            request.count <- count.value.usize()
            return request

        def program_path_parse(payload: u8&, length: usize) -> ProgramPath:
            result: mutable ProgramPath = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, ARGUMENTS_FIELD, 0)
            return result if arguments == NO_INDEX or object_field_value_start(payload, length, root_start, ARGUMENTS_FIELD, 1) != NO_INDEX
            return result if arguments >= length or payload[arguments] != ASCII_BRACE_OPEN
            program: usize = object_field_value_start(payload, length, arguments, PROGRAM_FIELD, 0)
            return result if program == NO_INDEX or object_field_value_start(payload, length, arguments, PROGRAM_FIELD, 1) != NO_INDEX
            return parse_program_path_string(payload, length, program)

        def client_coordinates_default() -> ClientCoordinates:
            return ClientCoordinates{valid: true, lines_start_at_one: true, columns_start_at_one: true}

        def client_coordinates_parse(payload: u8&, length: usize) -> ClientCoordinates:
            coordinates: mutable ClientCoordinates = client_coordinates_default()
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, ARGUMENTS_FIELD, 0)
            return coordinates if arguments == NO_INDEX
            return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if object_field_value_start(payload, length, root_start, ARGUMENTS_FIELD, 1) != NO_INDEX
            return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if arguments >= length or payload[arguments] != ASCII_BRACE_OPEN
            lines: usize = object_field_value_start(payload, length, arguments, LINES_START_AT_ONE_FIELD, 0)
            return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if object_field_value_start(payload, length, arguments, LINES_START_AT_ONE_FIELD, 1) != NO_INDEX
            if lines != NO_INDEX:
                line_value: ParsedValue = parse_json_boolean(payload, length, lines)
                return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if not line_value.valid
                coordinates.lines_start_at_one <- line_value.value != 0
            columns: usize = object_field_value_start(payload, length, arguments, COLUMNS_START_AT_ONE_FIELD, 0)
            return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if object_field_value_start(payload, length, arguments, COLUMNS_START_AT_ONE_FIELD, 1) != NO_INDEX
            if columns != NO_INDEX:
                column_value: ParsedValue = parse_json_boolean(payload, length, columns)
                return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if not column_value.valid
                coordinates.columns_start_at_one <- column_value.value != 0
            return coordinates
