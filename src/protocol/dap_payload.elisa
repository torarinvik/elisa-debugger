            ASCII_CARRIAGE_RETURN_ESCAPE: u8 = 114
            ASCII_ESCAPE_TAB: u8 = 116
            ASCII_LOWER_U: u8 = 117
            PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_DELETE: u64 = 127

