                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_S if position == 8
                return Character::ASCII_UPPER_R if position == 9
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 10
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_F if position == 11
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 12
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 13
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 14
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_N if position == 15
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_C if position == 16
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E
            if field == DapFields::START_FIELD:
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_S if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_T if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 3
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_T
            if field == DapFields::ARGUMENTS_FIELD:
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_G if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_U if position == 3
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_M if position == 4
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 5
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_N if position == 6
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_T if position == 7
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_S
            if field == DapFields::PROGRAM_FIELD:
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_P if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_O if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_G if position == 3
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 4
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A if position == 5
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_M
            if field == DapFields::THREAD_ID_FIELD:
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_T if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_H if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 3
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A if position == 4
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_D if position == 5
                return Character::ASCII_UPPER_I if position == 6
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_D
            if field == DapFields::FRAME_ID_FIELD:
                return Character::ASCII_LOWER_F if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_M if position == 3
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 4
                return Character::ASCII_UPPER_I if position == 5
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_D
            if field == DapFields::MEMORY_REFERENCE_FIELD:
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_M if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_M if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_O if position == 3
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 4
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_Y if position == 5
                return Character::ASCII_UPPER_R if position == 6
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 7
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_F if position == 8
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 9
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 10
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 11
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_N if position == 12
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_C if position == 13
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E
            if field == DapFields::OFFSET_FIELD:
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_O if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_F if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_F if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_S if position == 3
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E if position == 4
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_T
            return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_C if position == 0
            return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_O if position == 1
            return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_U if position == 2
            return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_N if position == 3
            return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_T

        def field_matches(payload: u8&, index: usize, length: usize, field: u8) -> bool:
            key_length: usize = field_length(field)
            return false if index >= length or payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            decoded_length: mutable usize = 0
            cursor: mutable usize = index + 1
            while cursor < length:
                byte: u8 = payload[cursor]
                return decoded_length == key_length if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
                decoded: mutable u64 = byte.u64()
                if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                    return false if cursor + 1 >= length
                    escaped: u8 = payload[cursor + 1]
                    if escaped == Character::ASCII_LOWER_U:
                        unicode_value: ParsedValue = parse_unicode_quad(payload, length, cursor + 2)
                        return false if not unicode_value.valid or unicode_value.value >= Utf8::UTF8_CONTINUATION_BASE
                        decoded <- unicode_value.value
                        cursor <- unicode_value.end
                    else:
                        # Escaped controls cannot equal any supported field
                        # character. Decode the printable JSON escapes exactly.
                        decoded <- escaped.u64() if escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE or escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH or escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_SLASH
                        decoded <- Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_SPACE.u64() if escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSPACE or escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_FORM_FEED or escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_NEWLINE or escaped == Character::ASCII_CARRIAGE_RETURN_ESCAPE or escaped == Character::ASCII_ESCAPE_TAB
                        return false if escaped != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE and escaped != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH and escaped != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_SLASH and escaped != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSPACE and escaped != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_FORM_FEED and escaped != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_NEWLINE and escaped != Character::ASCII_CARRIAGE_RETURN_ESCAPE and escaped != Character::ASCII_ESCAPE_TAB
                        cursor <- cursor + 2
                else:
                    cursor <- cursor + 1
                return false if decoded_length >= key_length or decoded != field_byte(field, decoded_length).u64()
                decoded_length <- decoded_length + 1
            return false

        def field_value_start(payload: u8&, length: usize, field: u8, start: usize) -> usize:
            return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if start >= length
            in_string: mutable bool = false
            escaped: mutable bool = false
            index: mutable usize = 0
            while index < length:
                byte: u8 = payload[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    else:
                        escaped <- true if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH
                        in_string <- false if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE and not escaped
                    index <- index + 1
                else:
                    if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                        key_start: usize = index
                        key_cursor: mutable usize = index + 1
                        key_escaped: mutable bool = false
                        while key_cursor < length:
                            key_byte: u8 = payload[key_cursor]
                            if key_escaped:
                                key_escaped <- false
                            else:
                                if key_byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                                    key_escaped <- true
                                else:
                                    break if key_byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
                            key_cursor <- key_cursor + 1
                        return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if key_cursor >= length or key_escaped
                        lookahead: mutable usize = key_cursor + 1
                        while lookahead < length and is_whitespace(payload[lookahead]):
                            lookahead <- lookahead + 1
                        if key_start >= start and field_matches(payload, key_start, length, field) and lookahead < length and payload[lookahead] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COLON:
                            lookahead <- lookahead + 1
                            while lookahead < length and is_whitespace(payload[lookahead]):
                                lookahead <- lookahead + 1
                            return lookahead
                        index <- key_cursor + 1
                    else:
                        index <- index + 1
            return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX

        def json_string_end(payload: u8&, length: usize, start: usize) -> usize:
            return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if start >= length or payload[start] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            escaped: mutable bool = false
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = payload[index]
                if escaped:
                    escaped <- false
                else:
                    if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                        escaped <- true
                    else:
                        return index + 1 if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
                index <- index + 1
            return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX

        def json_value_end(payload: u8&, length: usize, start: usize) -> usize:
            return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if start >= length
            return json_string_end(payload, length, start) if payload[start] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            if payload[start] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN or payload[start] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN:
                delimiters: mutable u8[JsonStructure::MAX_JSON_NESTING] = zeroed
                delimiters[JsonStructure::JSON_ROOT_DELIMITER_INDEX] <- payload[start]
                depth: mutable usize = JsonStructure::JSON_INITIAL_NESTING_DEPTH
                in_string: mutable bool = false
                escaped: mutable bool = false
                index: mutable usize = start + 1
                while index < length:
                    byte: u8 = payload[index]
                    if in_string:
                        if escaped:
                            escaped <- false
                        else:
                            if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                                escaped <- true
                            else:
                                in_string <- false if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
                    else:
                        if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                            in_string <- true
                        else:
                            if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN or byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN:
                                return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if depth >= JsonStructure::MAX_JSON_NESTING
                                delimiters[depth] <- byte
                                depth <- depth + 1
                            else:
                                if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE or byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE:
                                    return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if depth == JsonStructure::JSON_EMPTY_NESTING_DEPTH
                                    opener: u8 = delimiters[depth - 1]
                                    return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if (opener == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN and byte != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE) or (opener == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN and byte != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE)
                                    depth <- depth - 1
                                    return index + 1 if depth == JsonStructure::JSON_EMPTY_NESTING_DEPTH
                    index <- index + 1
                return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            index: mutable usize = start
            while index < length:
                byte: u8 = payload[index]
                break if is_whitespace(byte) or byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA or byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE or byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                index <- index + 1
            return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if index == start else index

        def parse_json_boolean(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length
            if payload[start] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_T:
                return invalid_value() if length - start < JsonStructure::JSON_TRUE_LENGTH
                return invalid_value() if payload[start + 1] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R or payload[start + 2] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_U or payload[start + 3] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E
                true_literal_end: usize = start + JsonStructure::JSON_TRUE_LENGTH
                return invalid_value() if true_literal_end < length and not is_whitespace(payload[true_literal_end]) and payload[true_literal_end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[true_literal_end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[true_literal_end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return ParsedValue{valid: true, value: 1, end: true_literal_end}
            if payload[start] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_F:
                return invalid_value() if length - start < JsonStructure::JSON_FALSE_LENGTH
                return invalid_value() if payload[start + 1] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A or payload[start + 2] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_L or payload[start + 3] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_S or payload[start + 4] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E
                false_literal_end: usize = start + JsonStructure::JSON_FALSE_LENGTH
                return invalid_value() if false_literal_end < length and not is_whitespace(payload[false_literal_end]) and payload[false_literal_end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[false_literal_end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[false_literal_end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return ParsedValue{valid: true, value: 0, end: false_literal_end}
            return invalid_value()

        # Reads only direct properties from one object and skips complete
        # nested values, so launch path lookup cannot accept nested decoys.
        def object_field_value_start(payload: u8&, length: usize, object_start: usize, field: u8, occurrence: usize) -> usize:
            return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if object_start >= length or payload[object_start] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            property_index: mutable usize = object_start + 1
            matched: mutable usize = 0
            while property_index < length:
                while property_index < length and (is_whitespace(payload[property_index]) or payload[property_index] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA):
                    property_index <- property_index + 1
                return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if property_index >= length or payload[property_index] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE
                key_start: usize = property_index
                key_end: usize = json_string_end(payload, length, key_start)
                return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if key_end == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
                property_index <- key_end
                while property_index < length and is_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if property_index >= length or payload[property_index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COLON
                property_index <- property_index + 1
                while property_index < length and is_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                value_start: usize = property_index
                value_end: usize = json_value_end(payload, length, value_start)
                return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX if value_end == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
                if field_matches(payload, key_start, length, field):
                    if matched == occurrence:
                        return value_start
                    matched <- matched + 1
                property_index <- value_end
            return NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX

        def hex_digit(byte: u8) -> ParsedValue:
            return ParsedValue{valid: true, value: (byte - Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO).u64(), end: 0} if byte >= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_NINE
            return ParsedValue{valid: true, value: (byte - Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A).u64() + NumberFormat::HEX_DIGIT_OFFSET, end: 0} if byte >= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A and byte <= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_F
            return ParsedValue{valid: true, value: (byte - Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_UPPER_A).u64() + NumberFormat::HEX_DIGIT_OFFSET, end: 0} if byte >= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_UPPER_A and byte <= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_UPPER_F
            return invalid_value()

        def parse_unicode_quad(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start > length or length - start < Unicode::UNICODE_HEX_DIGITS
            value: mutable u64 = 0
            for offset in 0..<Unicode::UNICODE_HEX_DIGITS:
                digit: ParsedValue = hex_digit(payload[start + offset])
                return invalid_value() if not digit.valid
                value <- value * NumberFormat::HEX_BASE + digit.value
            return ParsedValue{valid: true, value: value, end: start + Unicode::UNICODE_HEX_DIGITS}

        def program_path_append(path: mutable ProgramPath&, value: u8) -> bool:
            return false if path.length >= SourcePaths::PROGRAM_PATH_CAPACITY
            path.bytes[path.length] <- value
            path.length <- path.length + 1
            return true

        def invalid_program_path() -> ProgramPath:
            return ProgramPath{bytes: zeroed, length: 0, valid: false}

        def program_path_append_codepoint(path: mutable ProgramPath&, value: u64) -> bool:
            return false if value == 0 or value <= Unicode::UNICODE_CONTROL_MAX or value == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_DELETE
            return false if value > Unicode::UNICODE_MAX_CODEPOINT
            if value < Utf8::UTF8_CONTINUATION_BASE:
                return program_path_append(path, value.u8())
            if value < Unicode::UNICODE_TWO_BYTE_MAX_EXCLUSIVE:
                first: u8 = (Utf8::UTF8_TWO_BYTE_BASE | (value >> Utf8::UTF8_SHIFT)).u8()
                second: u8 = (Utf8::UTF8_CONTINUATION_BASE | (value & Utf8::UTF8_CONTINUATION_MASK)).u8()
                return false if not program_path_append(path, first)
                return program_path_append(path, second)
            if value < Unicode::UNICODE_THREE_BYTE_MAX_EXCLUSIVE:
                first: u8 = (Utf8::UTF8_THREE_BYTE_BASE | (value >> (Utf8::UTF8_SHIFT * 2))).u8()
                second: u8 = (Utf8::UTF8_CONTINUATION_BASE | ((value >> Utf8::UTF8_SHIFT) & Utf8::UTF8_CONTINUATION_MASK)).u8()
                third: u8 = (Utf8::UTF8_CONTINUATION_BASE | (value & Utf8::UTF8_CONTINUATION_MASK)).u8()
                return false if not program_path_append(path, first)
                return false if not program_path_append(path, second)
                return program_path_append(path, third)
            first: u8 = (Utf8::UTF8_FOUR_BYTE_BASE | (value >> (Utf8::UTF8_SHIFT * 3))).u8()
            second: u8 = (Utf8::UTF8_CONTINUATION_BASE | ((value >> (Utf8::UTF8_SHIFT * 2)) & Utf8::UTF8_CONTINUATION_MASK)).u8()
            third: u8 = (Utf8::UTF8_CONTINUATION_BASE | ((value >> Utf8::UTF8_SHIFT) & Utf8::UTF8_CONTINUATION_MASK)).u8()
            fourth: u8 = (Utf8::UTF8_CONTINUATION_BASE | (value & Utf8::UTF8_CONTINUATION_MASK)).u8()
            return false if not program_path_append(path, first)
            return false if not program_path_append(path, second)
            return false if not program_path_append(path, third)
            return program_path_append(path, fourth)

        def program_path_utf8_is_valid(path: ProgramPath) -> bool:
            index: mutable usize = 0
            while index < path.length:
                first: u64 = path.bytes[index].u64()
                sequence_length: mutable usize = 1
                minimum_codepoint: mutable u64 = 0
                codepoint: mutable u64 = first
                if first >= Utf8::UTF8_TWO_BYTE_START and first <= Utf8::UTF8_TWO_BYTE_END:
                    sequence_length <- Utf8::UTF8_TWO_BYTE_LENGTH
                    minimum_codepoint <- Utf8::UTF8_TWO_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::UTF8_FIRST_TWO_MASK
                if first >= Utf8::UTF8_THREE_BYTE_START and first <= Utf8::UTF8_THREE_BYTE_END:
                    sequence_length <- Utf8::UTF8_THREE_BYTE_LENGTH
                    minimum_codepoint <- Utf8::UTF8_THREE_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::UTF8_FIRST_THREE_MASK
                if first >= Utf8::UTF8_FOUR_BYTE_START and first <= Utf8::UTF8_FOUR_BYTE_END:
                    sequence_length <- Utf8::UTF8_FOUR_BYTE_LENGTH
                    minimum_codepoint <- Utf8::UTF8_FOUR_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::UTF8_FIRST_FOUR_MASK
                if first >= Utf8::UTF8_CONTINUATION_MIN and sequence_length == 1:
                    return false
                return false if sequence_length > path.length - index
                for offset in 1..<sequence_length:
                    continuation: u64 = path.bytes[index + offset].u64()
                    return false if continuation < Utf8::UTF8_CONTINUATION_MIN or continuation > Utf8::UTF8_CONTINUATION_MAX
                    codepoint <- (codepoint << Utf8::UTF8_SHIFT) | (continuation & Utf8::UTF8_CONTINUATION_MASK)
                return false if codepoint < minimum_codepoint or codepoint > Unicode::UNICODE_MAX_CODEPOINT
                return false if codepoint >= Unicode::UNICODE_SURROGATE_RANGE_START and codepoint <= Unicode::UNICODE_SURROGATE_RANGE_END
                index <- index + sequence_length
            return true

        def parse_program_path_string(payload: u8&, length: usize, start: usize) -> ProgramPath:
            path: mutable ProgramPath = zeroed
            path.valid <- true
            return invalid_program_path() if start >= length or payload[start] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = payload[index]
                if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                    return invalid_program_path() if path.length == 0 or not program_path_utf8_is_valid(path)
                    return path
                if byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                    return invalid_program_path() if index + 1 >= length
                    escaped: u8 = payload[index + 1]
                    if escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE or escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH or escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_SLASH:
                        path.valid <- program_path_append(path, escaped)
                        return invalid_program_path() if not path.valid
                        index <- index + 2
                        continue
                    if escaped == Character::ASCII_LOWER_U:
                        high: ParsedValue = parse_unicode_quad(payload, length, index + 2)
                        return invalid_program_path() if not high.valid
                        codepoint: mutable u64 = high.value
                        index <- high.end
                        if high.value >= Unicode::UNICODE_SURROGATE_HIGH_START and high.value <= Unicode::UNICODE_SURROGATE_HIGH_END:
                            return invalid_program_path() if index + 1 >= length or payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH or payload[index + 1] != Character::ASCII_LOWER_U
                            low: ParsedValue = parse_unicode_quad(payload, length, index + 2)
                            return invalid_program_path() if not low.valid or low.value < Unicode::UNICODE_SURROGATE_LOW_START or low.value > Unicode::UNICODE_SURROGATE_LOW_END
                            codepoint <- Unicode::UNICODE_SURROGATE_BASE + ((high.value - Unicode::UNICODE_HIGH_SURROGATE_OFFSET) << Unicode::UNICODE_SURROGATE_SHIFT) + (low.value - Unicode::UNICODE_LOW_SURROGATE_OFFSET)
                            index <- low.end
                        else:
                            return invalid_program_path() if high.value >= Unicode::UNICODE_SURROGATE_LOW_START and high.value <= Unicode::UNICODE_SURROGATE_LOW_END
                        path.valid <- program_path_append_codepoint(path, codepoint)
                        return invalid_program_path() if not path.valid
                        continue
                    # Control escapes cannot name a useful portable filesystem path.
                    return invalid_program_path() if escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSPACE or escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_FORM_FEED or escaped == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_NEWLINE or escaped == Character::ASCII_CARRIAGE_RETURN_ESCAPE or escaped == Character::ASCII_ESCAPE_TAB
                    return invalid_program_path()
                return invalid_program_path() if byte < Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_SPACE or byte.u64() == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_DELETE
                path.valid <- program_path_append(path, byte)
                return invalid_program_path() if not path.valid
                index <- index + 1
            return invalid_program_path()

        def parse_memory_reference(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length or payload[start] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            index: mutable usize = start + 1
            return invalid_value() if index >= length
            if index + NumberFormat::HEX_PREFIX_LENGTH - 1 < length and payload[index] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO and (payload[index + 1] == Character::ASCII_LOWER_X or payload[index + 1] == Character::ASCII_UPPER_X):
                index <- index + NumberFormat::HEX_PREFIX_LENGTH
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                return invalid_value() if payload[index] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH
                digit: ParsedValue = hex_digit(payload[index])
                return invalid_value() if not digit.valid or digits >= MemoryPayload::MEMORY_REFERENCE_MAX_DIGITS or value > (NumberFormat::MAX_INTEGER - digit.value) / NumberFormat::HEX_BASE
                value <- value * NumberFormat::HEX_BASE + digit.value
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if index >= length or digits == 0
            if index + 1 < length:
                delimiter: u8 = payload[index + 1]
                return invalid_value() if not is_whitespace(delimiter) and delimiter != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA and delimiter != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and delimiter != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index + 1}

        def parse_unsigned_bounded(payload: u8&, length: usize, start: usize, maximum: u64) -> ParsedValue:
            return invalid_value() if start >= length or payload[start] < Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO or payload[start] > Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_NINE
            index: mutable usize = start
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] >= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO and payload[index] <= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_NINE:
                return invalid_value() if digits == NumberFormat::FIRST_DIGIT_COUNT and value == 0
                digit: u64 = (payload[index] - Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO).u64()
                return invalid_value() if value > (maximum - digit) / NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_DECIMAL_BASE
                value <- value * NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_DECIMAL_BASE + digit
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if digits == 0
            if index < length:
                return invalid_value() if not is_whitespace(payload[index]) and payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index}

        def parse_count(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return parse_unsigned_bounded(payload, length, start, MemoryPayload::MEMORY_COUNT_MAX)

        def parse_signed_offset(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length
            negative: bool = payload[start] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_MINUS
            index: mutable usize = start + 1 if negative else start
            return invalid_value() if index >= length or payload[index] < Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO or payload[index] > Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_NINE
            maximum: u64 = NumberFormat::MIN_SIGNED_INTEGER_MAGNITUDE if negative else NumberFormat::MAX_SIGNED_INTEGER
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] >= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO and payload[index] <= Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_NINE:
                return invalid_value() if digits == NumberFormat::FIRST_DIGIT_COUNT and value == 0
                digit: u64 = (payload[index] - Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO).u64()
                return invalid_value() if value > (maximum - digit) / NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_DECIMAL_BASE
                value <- value * NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_DECIMAL_BASE + digit
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if digits == 0
            if index < length:
                return invalid_value() if not is_whitespace(payload[index]) and payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[index] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index}

        def request_handle_value_parse(payload: u8&, length: usize, field: u8) -> ParsedValue:
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 0)
            return invalid_value() if arguments == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return invalid_value() if arguments >= length or payload[arguments] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            reference_start: usize = object_field_value_start(payload, length, arguments, field, 0)
            return invalid_value() if reference_start == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, field, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return parse_unsigned_bounded(payload, length, reference_start, NumberFormat::MAX_INTEGER)

    public:
        struct ProgramPath:
            bytes: mutable u8[SourcePaths::PROGRAM_PATH_CAPACITY]
            length: mutable usize
            valid: mutable bool

        struct ClientCoordinates:
            valid: mutable bool
            lines_start_at_one: mutable bool
            columns_start_at_one: mutable bool

        struct MemoryRequest:
            valid: mutable bool
            address: mutable u64
            count: mutable usize

        struct VariablesRequest:
            valid: mutable bool
            reference: mutable u64
            start: mutable usize
            count: mutable usize
            has_count: mutable bool

        struct ReferenceRequest:
            valid: mutable bool
            reference: mutable u64

        struct SourceBreakpointsRequest:
            valid: mutable bool
            source_reference: mutable u64
            has_source_reference: mutable bool
            source_path: mutable ProgramPath
            has_source_path: mutable bool
            lines: mutable u32[SourcePaths::DAP_SOURCE_BREAKPOINT_LIMIT]
            count: mutable usize

        struct SourcePathRootRequest:
            valid: mutable bool
            root: mutable ProgramPath
            has_root: mutable bool

        def thread_id_request_parse(payload: u8&, length: usize) -> ReferenceRequest:
            parsed: ParsedValue = request_handle_value_parse(payload, length, DapFields::THREAD_ID_FIELD)
            return ReferenceRequest{valid: parsed.valid, reference: parsed.value}

        def frame_id_request_parse(payload: u8&, length: usize) -> ReferenceRequest:
            parsed: ParsedValue = request_handle_value_parse(payload, length, DapFields::FRAME_ID_FIELD)
            return ReferenceRequest{valid: parsed.valid, reference: parsed.value}

        def source_breakpoints_append(request: mutable SourceBreakpointsRequest&, line: u64) -> bool:
            return false if request.count >= SourcePaths::DAP_SOURCE_BREAKPOINT_LIMIT or line > NumberFormat::MAX_U32_INTEGER
            request.lines[request.count] <- line.u32()
            request.count <- request.count + 1
            return true

        def source_breakpoints_parse_array(payload: u8&, length: usize, array_start: usize, request: mutable SourceBreakpointsRequest&, object_items: bool) -> bool:
            return false if array_start >= length or payload[array_start] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN
            cursor: mutable usize = array_start + 1
            while cursor < length:
                while cursor < length and is_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                return false if cursor >= length
                if payload[cursor] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE:
                    return true
                line: mutable ParsedValue = invalid_value()
                if object_items:
                    return false if payload[cursor] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
                    # Reject semantics the engine cannot honor instead of
                    # silently turning conditional or log breakpoints into
                    # ordinary line breakpoints.
                    return false if object_field_value_start(payload, length, cursor, DapFields::COLUMN_FIELD, 0) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, cursor, DapFields::CONDITION_FIELD, 0) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, cursor, DapFields::HIT_CONDITION_FIELD, 0) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, cursor, DapFields::LOG_MESSAGE_FIELD, 0) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
                    line_start: usize = object_field_value_start(payload, length, cursor, DapFields::LINE_FIELD, 0)
                    return false if line_start == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, cursor, DapFields::LINE_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
                    line <- parse_unsigned_bounded(payload, length, line_start, NumberFormat::MAX_U32_INTEGER)
                    return false if not line.valid or not source_breakpoints_append(request, line.value)
                    item_end: usize = json_value_end(payload, length, cursor)
                    return false if item_end == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
                    cursor <- item_end
                else:
                    line <- parse_unsigned_bounded(payload, length, cursor, NumberFormat::MAX_U32_INTEGER)
                    return false if not line.valid or not source_breakpoints_append(request, line.value)
                    cursor <- line.end
                while cursor < length and is_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                return false if cursor >= length
                return true if payload[cursor] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return false if payload[cursor] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA
                cursor <- cursor + 1
                lookahead: mutable usize = cursor
                while lookahead < length and is_whitespace(payload[lookahead]):
                    lookahead <- lookahead + 1
                return false if lookahead >= length or payload[lookahead] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return false

        # A sourceReference is the explicit EDIR source-file DebugId. Paths
        # are resolved only against an artifact's source table; never hash an
        # editor path into a guessed source identity.
        def source_breakpoints_request_parse(payload: u8&, length: usize) -> SourceBreakpointsRequest:
            request: mutable SourceBreakpointsRequest = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 0)
            return request if arguments == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            source: usize = object_field_value_start(payload, length, arguments, DapFields::SOURCE_FIELD, 0)
            breakpoints: usize = object_field_value_start(payload, length, arguments, DapFields::BREAKPOINTS_FIELD, 0)
            lines: usize = object_field_value_start(payload, length, arguments, DapFields::LINES_FIELD, 0)
            return request if source == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or payload[source] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            return request if object_field_value_start(payload, length, arguments, DapFields::SOURCE_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::BREAKPOINTS_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::LINES_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return request if breakpoints != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX and lines != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            source_reference: usize = object_field_value_start(payload, length, source, DapFields::SOURCE_REFERENCE_FIELD, 0)
            source_path_start: usize = object_field_value_start(payload, length, source, DapFields::SOURCE_PATH_FIELD, 0)
            return request if object_field_value_start(payload, length, source, DapFields::SOURCE_REFERENCE_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, source, DapFields::SOURCE_PATH_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            if source_reference != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                parsed_reference: ParsedValue = parse_source_reference(payload, length, source_reference)
                return request if not parsed_reference.valid
                request.source_reference <- parsed_reference.value
                request.has_source_reference <- true
            if source_path_start != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                request.source_path <- parse_program_path_string(payload, length, source_path_start)
                return request if not request.source_path.valid
                request.has_source_path <- true
            return request if not request.has_source_reference and not request.has_source_path
            return request if request.source_reference == SourcePaths::NO_SOURCE_REFERENCE and not request.has_source_path
            if breakpoints != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                return request if not source_breakpoints_parse_array(payload, length, breakpoints, request, true)
            if lines != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                return request if not source_breakpoints_parse_array(payload, length, lines, request, false)
            request.valid <- true
            return request

        def parse_source_reference(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length
            if payload[start] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_ZERO:
                end: usize = start + NumberFormat::FIRST_DIGIT_COUNT
                return invalid_value() if end < length and not is_whitespace(payload[end]) and payload[end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[end] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return ParsedValue{valid: true, value: 0, end: end}
            return parse_unsigned_bounded(payload, length, start, NumberFormat::MAX_INTEGER)

        # Decode only the direct DAP arguments used for paged variable
        # inspection. Nested decoys and duplicate properties are rejected.
        def variables_request_parse(payload: u8&, length: usize) -> VariablesRequest:
            request: mutable VariablesRequest = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 0)
            return request if arguments == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            reference_start: usize = object_field_value_start(payload, length, arguments, DapFields::VARIABLES_REFERENCE_FIELD, 0)
            start_start: usize = object_field_value_start(payload, length, arguments, DapFields::START_FIELD, 0)
            count_start: usize = object_field_value_start(payload, length, arguments, DapFields::COUNT_FIELD, 0)
            return request if reference_start == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return request if object_field_value_start(payload, length, arguments, DapFields::VARIABLES_REFERENCE_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::START_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::COUNT_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            reference: ParsedValue = parse_unsigned_bounded(payload, length, reference_start, NumberFormat::MAX_INTEGER)
            return request if not reference.valid
            request.reference <- reference.value
            if start_start != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                start: ParsedValue = parse_count(payload, length, start_start)
                return request if not start.valid
                request.start <- start.value.usize()
            if count_start != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                count: ParsedValue = parse_count(payload, length, count_start)
                return request if not count.valid
                request.count <- count.value.usize()
                request.has_count <- true
            request.valid <- true
            return request

        def memory_request_parse(payload: u8&, length: usize) -> MemoryRequest:
            request: mutable MemoryRequest = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 0)
            return request if arguments == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            first_reference: usize = object_field_value_start(payload, length, arguments, DapFields::MEMORY_REFERENCE_FIELD, 0)
            first_count: usize = object_field_value_start(payload, length, arguments, DapFields::COUNT_FIELD, 0)
            first_offset: usize = object_field_value_start(payload, length, arguments, DapFields::OFFSET_FIELD, 0)
            return request if first_reference == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or first_count == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return request if object_field_value_start(payload, length, arguments, DapFields::MEMORY_REFERENCE_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::COUNT_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::OFFSET_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            reference: ParsedValue = parse_memory_reference(payload, length, first_reference)
            count: ParsedValue = parse_count(payload, length, first_count)
            return request if not reference.valid or not count.valid
            address: mutable u64 = reference.value
            if first_offset != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                offset: ParsedValue = parse_signed_offset(payload, length, first_offset)
                return request if not offset.valid
                if payload[first_offset] == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_MINUS:
                    return request if offset.value > address
                    address <- address - offset.value
                else:
                    return request if offset.value > NumberFormat::MAX_INTEGER - address
                    address <- address + offset.value
            request.valid <- true
            request.address <- address
            request.count <- count.value.usize()
            return request

        def program_path_parse(payload: u8&, length: usize) -> ProgramPath:
            result: mutable ProgramPath = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 0)
            return result if arguments == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return result if arguments >= length or payload[arguments] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            program: usize = object_field_value_start(payload, length, arguments, DapFields::PROGRAM_FIELD, 0)
            return result if program == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::PROGRAM_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            parsed: ProgramPath = parse_program_path_string(payload, length, program)
            return invalid_program_path() if not parsed.valid or parsed.length > SourcePaths::DAP_PATH_COMPONENT_CAPACITY
            return parsed

        def source_path_root_parse(payload: u8&, length: usize) -> SourcePathRootRequest:
            request: mutable SourcePathRootRequest = zeroed
            request.valid <- true
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 0)
            if object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                request.valid <- false
                return request
            return request if arguments == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            if arguments >= length or payload[arguments] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN:
                request.valid <- false
                return request
            root: usize = object_field_value_start(payload, length, arguments, DapFields::SOURCE_PATH_ROOT_FIELD, 0)
            if object_field_value_start(payload, length, arguments, DapFields::SOURCE_PATH_ROOT_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                request.valid <- false
                return request
            return request if root == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            request.root <- parse_program_path_string(payload, length, root)
            request.valid <- request.root.valid and request.root.length <= SourcePaths::DAP_PATH_COMPONENT_CAPACITY
            request.has_root <- request.root.valid
            return request

        def client_coordinates_default() -> ClientCoordinates:
            return ClientCoordinates{valid: true, lines_start_at_one: true, columns_start_at_one: true}

        def client_coordinates_parse(payload: u8&, length: usize) -> ClientCoordinates:
            coordinates: mutable ClientCoordinates = client_coordinates_default()
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 0)
            return coordinates if arguments == NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if arguments >= length or payload[arguments] != Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            lines: usize = object_field_value_start(payload, length, arguments, DapFields::LINES_START_AT_ONE_FIELD, 0)
            return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if object_field_value_start(payload, length, arguments, DapFields::LINES_START_AT_ONE_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            if lines != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                line_value: ParsedValue = parse_json_boolean(payload, length, lines)
                return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if not line_value.valid
                coordinates.lines_start_at_one <- line_value.value != 0
            columns: usize = object_field_value_start(payload, length, arguments, DapFields::COLUMNS_START_AT_ONE_FIELD, 0)
            return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if object_field_value_start(payload, length, arguments, DapFields::COLUMNS_START_AT_ONE_FIELD, 1) != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX
            if columns != NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX:
                column_value: ParsedValue = parse_json_boolean(payload, length, columns)
                return ClientCoordinates{valid: false, lines_start_at_one: true, columns_start_at_one: true} if not column_value.valid
                coordinates.columns_start_at_one <- column_value.value != 0
            return coordinates
