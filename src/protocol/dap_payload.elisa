                return Character::DAP_PAYLOAD_CHARACTER_ASCII_A if position == FieldBytePosition::POSITION_ONE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_M if position == FieldBytePosition::POSITION_TWO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E
            if field == DapFields::MEMORY_REFERENCE:
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_M if position == FieldBytePosition::POSITION_ZERO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_ONE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_M if position == FieldBytePosition::POSITION_TWO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_O if position == FieldBytePosition::POSITION_THREE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_R if position == FieldBytePosition::POSITION_FOUR
                return Character::ASCII_Y if position == FieldBytePosition::POSITION_FIVE
                return Character::ASCII_UPPER_R if position == FieldBytePosition::POSITION_SIX
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_SEVEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_F if position == FieldBytePosition::POSITION_EIGHT
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_NINE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_R if position == FieldBytePosition::POSITION_TEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_ELEVEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_N if position == FieldBytePosition::POSITION_TWELVE
                return Character::ASCII_C if position == FieldBytePosition::POSITION_THIRTEEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E
            if field == DapFields::DAP_PAYLOAD_DAPFIELDS_OFFSET:
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_O if position == FieldBytePosition::POSITION_ZERO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_F if position == FieldBytePosition::POSITION_ONE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_F if position == FieldBytePosition::POSITION_TWO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_S if position == FieldBytePosition::POSITION_THREE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_FOUR
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_T
            return Character::ASCII_C if position == FieldBytePosition::POSITION_ZERO
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_O if position == FieldBytePosition::POSITION_ONE
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_U if position == FieldBytePosition::POSITION_TWO
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_N if position == FieldBytePosition::POSITION_THREE
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_T

        def field_matches(payload: u8&, index: usize, length: usize, field: u8) -> bool:
            key_length: usize = field_length(field)
            return false if index >= length or payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            decoded_length: mutable usize = 0
            cursor: mutable usize = index + 1
            while cursor < length:
                byte: u8 = payload[cursor]
                return decoded_length == key_length if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
                decoded: mutable u64 = byte.u64()
                if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                    return false if cursor + 1 >= length
                    escaped: u8 = payload[cursor + 1]
                    if escaped == Character::ASCII_LOWER_U:
                        unicode_value: ParsedValue = parse_unicode_quad(payload, length, cursor + 2)
                        return false if not unicode_value.valid or unicode_value.value >= Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_BASE
                        decoded <- unicode_value.value
                        cursor <- unicode_value.end
                    else:
                        # Escaped controls cannot equal any supported field
                        # character. Decode the printable JSON escapes exactly.
                        decoded <- escaped.u64() if escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE or escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH or escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_SLASH
                        decoded <- Character::DAP_PAYLOAD_CHARACTER_ASCII_SPACE.u64() if escaped == Character::ASCII_BACKSPACE or escaped == Character::ASCII_FORM_FEED or escaped == Character::ASCII_NEWLINE or escaped == Character::ESCAPE_CARRIAGE_RETURN or escaped == Character::ESCAPE_TAB
                        return false if escaped != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE and escaped != Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH and escaped != Character::DAP_PAYLOAD_CHARACTER_ASCII_SLASH and escaped != Character::ASCII_BACKSPACE and escaped != Character::ASCII_FORM_FEED and escaped != Character::ASCII_NEWLINE and escaped != Character::ESCAPE_CARRIAGE_RETURN and escaped != Character::ESCAPE_TAB
                        cursor <- cursor + 2
                else:
                    cursor <- cursor + 1
                return false if decoded_length >= key_length or decoded != field_byte(field, decoded_length).u64()
                decoded_length <- decoded_length + 1
            return false

        def field_value_start(payload: u8&, length: usize, field: u8, start: usize) -> usize:
            return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if start >= length
            in_string: mutable bool = false
            escaped: mutable bool = false
            index: mutable usize = 0
            while index < length:
                byte: u8 = payload[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    else:
                        escaped <- true if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH
                        in_string <- false if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE and not escaped
                    index <- index + 1
                else:
                    if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                        key_start: usize = index
                        key_cursor: mutable usize = index + 1
                        key_escaped: mutable bool = false
                        while key_cursor < length:
                            key_byte: u8 = payload[key_cursor]
                            if key_escaped:
                                key_escaped <- false
                            else:
                                if key_byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                                    key_escaped <- true
                                else:
                                    break if key_byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
                            key_cursor <- key_cursor + 1
                        return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if key_cursor >= length or key_escaped
                        lookahead: mutable usize = key_cursor + 1
                        while lookahead < length and is_whitespace(payload[lookahead]):
                            lookahead <- lookahead + 1
                        if key_start >= start and field_matches(payload, key_start, length, field) and lookahead < length and payload[lookahead] == Character::DAP_PAYLOAD_CHARACTER_ASCII_COLON:
                            lookahead <- lookahead + 1
                            while lookahead < length and is_whitespace(payload[lookahead]):
                                lookahead <- lookahead + 1
                            return lookahead
                        index <- key_cursor + 1
                    else:
                        index <- index + 1
            return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX

        def json_string_end(payload: u8&, length: usize, start: usize) -> usize:
            return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if start >= length or payload[start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            escaped: mutable bool = false
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = payload[index]
                if escaped:
                    escaped <- false
                else:
                    if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                        escaped <- true
                    else:
                        return index + 1 if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
                index <- index + 1
            return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX

        def json_value_end(payload: u8&, length: usize, start: usize) -> usize:
            return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if start >= length
            return json_string_end(payload, length, start) if payload[start] == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            if payload[start] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN or payload[start] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN:
                delimiters: mutable u8[JsonStructure::DAP_PAYLOAD_JSONSTRUCTURE_MAX_NESTING] = zeroed
                delimiters[JsonStructure::ROOT_DELIMITER_INDEX] <- payload[start]
                depth: mutable usize = JsonStructure::INITIAL_NESTING_DEPTH
                in_string: mutable bool = false
                escaped: mutable bool = false
                index: mutable usize = start + 1
                while index < length:
                    byte: u8 = payload[index]
                    if in_string:
                        if escaped:
                            escaped <- false
                        else:
                            if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                                escaped <- true
                            else:
                                in_string <- false if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
                    else:
                        if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                            in_string <- true
                        else:
                            if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN or byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN:
                                return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if depth >= JsonStructure::DAP_PAYLOAD_JSONSTRUCTURE_MAX_NESTING
                                delimiters[depth] <- byte
                                depth <- depth + 1
                            else:
                                if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE or byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE:
                                    return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if depth == JsonStructure::EMPTY_NESTING_DEPTH
                                    opener: u8 = delimiters[depth - 1]
                                    return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if (opener == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN and byte != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE) or (opener == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN and byte != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE)
                                    depth <- depth - 1
                                    return index + 1 if depth == JsonStructure::EMPTY_NESTING_DEPTH
                    index <- index + 1
                return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            index: mutable usize = start
            while index < length:
                byte: u8 = payload[index]
                break if is_whitespace(byte) or byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA or byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE or byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                index <- index + 1
            return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if index == start else index

        def parse_json_boolean(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length
            if payload[start] == Character::DAP_PAYLOAD_CHARACTER_ASCII_T:
                return invalid_value() if length - start < JsonStructure::TRUE_LENGTH
                return invalid_value() if payload[start + 1] != Character::DAP_PAYLOAD_CHARACTER_ASCII_R or payload[start + 2] != Character::DAP_PAYLOAD_CHARACTER_ASCII_U or payload[start + 3] != Character::DAP_PAYLOAD_CHARACTER_ASCII_E
                true_literal_end: usize = start + JsonStructure::TRUE_LENGTH
                return invalid_value() if true_literal_end < length and not is_whitespace(payload[true_literal_end]) and payload[true_literal_end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[true_literal_end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[true_literal_end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return ParsedValue{valid: true, value: 1, end: true_literal_end}
            if payload[start] == Character::DAP_PAYLOAD_CHARACTER_ASCII_F:
                return invalid_value() if length - start < JsonStructure::FALSE_LENGTH
                return invalid_value() if payload[start + 1] != Character::DAP_PAYLOAD_CHARACTER_ASCII_A or payload[start + 2] != Character::DAP_PAYLOAD_CHARACTER_ASCII_L or payload[start + 3] != Character::DAP_PAYLOAD_CHARACTER_ASCII_S or payload[start + 4] != Character::DAP_PAYLOAD_CHARACTER_ASCII_E
                false_literal_end: usize = start + JsonStructure::FALSE_LENGTH
                return invalid_value() if false_literal_end < length and not is_whitespace(payload[false_literal_end]) and payload[false_literal_end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[false_literal_end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[false_literal_end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return ParsedValue{valid: true, value: 0, end: false_literal_end}
            return invalid_value()

        # Reads only direct properties from one object and skips complete
        # nested values, so launch path lookup cannot accept nested decoys.
        def object_field_value_start(payload: u8&, length: usize, object_start: usize, field: u8, occurrence: usize) -> usize:
            return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if object_start >= length or payload[object_start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            property_index: mutable usize = object_start + 1
            matched: mutable usize = 0
            while property_index < length:
                while property_index < length and (is_whitespace(payload[property_index]) or payload[property_index] == Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA):
                    property_index <- property_index + 1
                return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if property_index >= length or payload[property_index] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE
                key_start: usize = property_index
                key_end: usize = json_string_end(payload, length, key_start)
                return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if key_end == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                property_index <- key_end
                while property_index < length and is_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if property_index >= length or payload[property_index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COLON
                property_index <- property_index + 1
                while property_index < length and is_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                value_start: usize = property_index
                value_end: usize = json_value_end(payload, length, value_start)
                return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX if value_end == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                if field_matches(payload, key_start, length, field):
                    if matched == occurrence:
                        return value_start
                    matched <- matched + 1
                property_index <- value_end
            return NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX

        def hex_digit(byte: u8) -> ParsedValue:
            return ParsedValue{valid: true, value: (byte - Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO).u64(), end: 0} if byte >= Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO and byte <= Character::DAP_PAYLOAD_CHARACTER_ASCII_NINE
            return ParsedValue{valid: true, value: (byte - Character::DAP_PAYLOAD_CHARACTER_ASCII_A).u64() + NumberFormat::HEX_DIGIT_OFFSET, end: 0} if byte >= Character::DAP_PAYLOAD_CHARACTER_ASCII_A and byte <= Character::DAP_PAYLOAD_CHARACTER_ASCII_F
            return ParsedValue{valid: true, value: (byte - Character::DAP_PAYLOAD_CHARACTER_ASCII_UPPER_A).u64() + NumberFormat::HEX_DIGIT_OFFSET, end: 0} if byte >= Character::DAP_PAYLOAD_CHARACTER_ASCII_UPPER_A and byte <= Character::DAP_PAYLOAD_CHARACTER_ASCII_UPPER_F
            return invalid_value()

        def parse_unicode_quad(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start > length or length - start < Unicode::HEX_DIGITS
            value: mutable u64 = 0
            for offset in 0..<Unicode::HEX_DIGITS:
                digit: ParsedValue = hex_digit(payload[start + offset])
                return invalid_value() if not digit.valid
                value <- value * NumberFormat::DAP_PAYLOAD_HEX_BASE + digit.value
            return ParsedValue{valid: true, value: value, end: start + Unicode::HEX_DIGITS}

        def program_path_append(path: mutable ProgramPath&, value: u8) -> bool:
            return false if path.length >= SourcePaths::PROGRAM_PATH_CAPACITY
            path.bytes[path.length] <- value
            path.length <- path.length + 1
            return true

        def invalid_program_path() -> ProgramPath:
            return ProgramPath{bytes: zeroed, length: 0, valid: false}

        def program_path_append_codepoint(path: mutable ProgramPath&, value: u64) -> bool:
            return false if value == 0 or value <= Unicode::DAP_PAYLOAD_UNICODE_CONTROL_MAX or value == Character::DAP_PAYLOAD_CHARACTER_ASCII_DELETE
            return false if value > Unicode::DAP_PAYLOAD_UNICODE_MAX_CODEPOINT
            if value < Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_BASE:
                return program_path_append(path, value.u8())
            if value < Unicode::DAP_PAYLOAD_UNICODE_TWO_BYTE_MAX_EXCLUSIVE:
                first: u8 = (Utf8::DAP_PAYLOAD_UTF8_TWO_BYTE_BASE | (value >> Utf8::DAP_PAYLOAD_UTF8_SHIFT)).u8()
                second: u8 = (Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_BASE | (value & Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MASK)).u8()
                return false if not program_path_append(path, first)
                return program_path_append(path, second)
            if value < Unicode::DAP_PAYLOAD_UNICODE_THREE_BYTE_MAX_EXCLUSIVE:
                first: u8 = (Utf8::DAP_PAYLOAD_UTF8_THREE_BYTE_BASE | (value >> (Utf8::DAP_PAYLOAD_UTF8_SHIFT * 2))).u8()
                second: u8 = (Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_BASE | ((value >> Utf8::DAP_PAYLOAD_UTF8_SHIFT) & Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MASK)).u8()
                third: u8 = (Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_BASE | (value & Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MASK)).u8()
                return false if not program_path_append(path, first)
                return false if not program_path_append(path, second)
                return program_path_append(path, third)
            first: u8 = (Utf8::DAP_PAYLOAD_UTF8_FOUR_BYTE_BASE | (value >> (Utf8::DAP_PAYLOAD_UTF8_SHIFT * 3))).u8()
            second: u8 = (Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_BASE | ((value >> (Utf8::DAP_PAYLOAD_UTF8_SHIFT * 2)) & Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MASK)).u8()
            third: u8 = (Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_BASE | ((value >> Utf8::DAP_PAYLOAD_UTF8_SHIFT) & Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MASK)).u8()
            fourth: u8 = (Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_BASE | (value & Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MASK)).u8()
            return false if not program_path_append(path, first)
            return false if not program_path_append(path, second)
            return false if not program_path_append(path, third)
            return program_path_append(path, fourth)

        def program_path_utf8_is_valid(path: ProgramPath) -> bool:
            index: mutable usize = 0
            while index < path.length:
                first: u64 = path.bytes[index].u64()
                sequence_length: mutable usize = 1
                minimum_codepoint: mutable u64 = 0
                codepoint: mutable u64 = first
                if first >= Utf8::DAP_PAYLOAD_UTF8_TWO_BYTE_START and first <= Utf8::DAP_PAYLOAD_UTF8_TWO_BYTE_END:
                    sequence_length <- Utf8::DAP_PAYLOAD_UTF8_TWO_BYTE_LENGTH
                    minimum_codepoint <- Utf8::DAP_PAYLOAD_UTF8_TWO_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::DAP_PAYLOAD_UTF8_FIRST_TWO_MASK
                if first >= Utf8::DAP_PAYLOAD_UTF8_THREE_BYTE_START and first <= Utf8::DAP_PAYLOAD_UTF8_THREE_BYTE_END:
                    sequence_length <- Utf8::DAP_PAYLOAD_UTF8_THREE_BYTE_LENGTH
                    minimum_codepoint <- Utf8::DAP_PAYLOAD_UTF8_THREE_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::DAP_PAYLOAD_UTF8_FIRST_THREE_MASK
                if first >= Utf8::DAP_PAYLOAD_UTF8_FOUR_BYTE_START and first <= Utf8::DAP_PAYLOAD_UTF8_FOUR_BYTE_END:
                    sequence_length <- Utf8::DAP_PAYLOAD_UTF8_FOUR_BYTE_LENGTH
                    minimum_codepoint <- Utf8::DAP_PAYLOAD_UTF8_FOUR_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::DAP_PAYLOAD_UTF8_FIRST_FOUR_MASK
                if first >= Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MIN and sequence_length == 1:
                    return false
                return false if sequence_length > path.length - index
                for offset in 1..<sequence_length:
                    continuation: u64 = path.bytes[index + offset].u64()
                    return false if continuation < Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MIN or continuation > Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MAX
                    codepoint <- (codepoint << Utf8::DAP_PAYLOAD_UTF8_SHIFT) | (continuation & Utf8::DAP_PAYLOAD_UTF8_CONTINUATION_MASK)
                return false if codepoint < minimum_codepoint or codepoint > Unicode::DAP_PAYLOAD_UNICODE_MAX_CODEPOINT
                return false if codepoint >= Unicode::SURROGATE_RANGE_START and codepoint <= Unicode::SURROGATE_RANGE_END
                index <- index + sequence_length
            return true

        def parse_program_path_string(payload: u8&, length: usize, start: usize) -> ProgramPath:
            path: mutable ProgramPath = zeroed
            path.valid <- true
            return invalid_program_path() if start >= length or payload[start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = payload[index]
                if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                    return invalid_program_path() if path.length == 0 or not program_path_utf8_is_valid(path)
                    return path
                if byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                    return invalid_program_path() if index + 1 >= length
                    escaped: u8 = payload[index + 1]
                    if escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE or escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH or escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_SLASH:
                        path.valid <- program_path_append(path, escaped)
                        return invalid_program_path() if not path.valid
                        index <- index + 2
                        continue
                    if escaped == Character::ASCII_LOWER_U:
                        high: ParsedValue = parse_unicode_quad(payload, length, index + 2)
                        return invalid_program_path() if not high.valid
                        codepoint: mutable u64 = high.value
                        index <- high.end
                        if high.value >= Unicode::DAP_PAYLOAD_UNICODE_SURROGATE_HIGH_START and high.value <= Unicode::DAP_PAYLOAD_UNICODE_SURROGATE_HIGH_END:
                            return invalid_program_path() if index + 1 >= length or payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH or payload[index + 1] != Character::ASCII_LOWER_U
                            low: ParsedValue = parse_unicode_quad(payload, length, index + 2)
                            return invalid_program_path() if not low.valid or low.value < Unicode::DAP_PAYLOAD_UNICODE_SURROGATE_LOW_START or low.value > Unicode::DAP_PAYLOAD_UNICODE_SURROGATE_LOW_END
                            codepoint <- Unicode::DAP_PAYLOAD_UNICODE_SURROGATE_BASE + ((high.value - Unicode::DAP_PAYLOAD_UNICODE_HIGH_SURROGATE_OFFSET) << Unicode::DAP_PAYLOAD_UNICODE_SURROGATE_SHIFT) + (low.value - Unicode::DAP_PAYLOAD_UNICODE_LOW_SURROGATE_OFFSET)
                            index <- low.end
                        else:
                            return invalid_program_path() if high.value >= Unicode::DAP_PAYLOAD_UNICODE_SURROGATE_LOW_START and high.value <= Unicode::DAP_PAYLOAD_UNICODE_SURROGATE_LOW_END
                        path.valid <- program_path_append_codepoint(path, codepoint)
                        return invalid_program_path() if not path.valid
                        continue
                    # Control escapes cannot name a useful portable filesystem path.
                    return invalid_program_path() if escaped == Character::ASCII_BACKSPACE or escaped == Character::ASCII_FORM_FEED or escaped == Character::ASCII_NEWLINE or escaped == Character::ESCAPE_CARRIAGE_RETURN or escaped == Character::ESCAPE_TAB
                    return invalid_program_path()
                return invalid_program_path() if byte < Character::DAP_PAYLOAD_CHARACTER_ASCII_SPACE or byte.u64() == Character::DAP_PAYLOAD_CHARACTER_ASCII_DELETE
                path.valid <- program_path_append(path, byte)
                return invalid_program_path() if not path.valid
                index <- index + 1
            return invalid_program_path()

        def parse_memory_reference(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length or payload[start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            index: mutable usize = start + 1
            return invalid_value() if index >= length
            if index + NumberFormat::HEX_PREFIX_LENGTH - 1 < length and payload[index] == Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO and (payload[index + 1] == Character::ASCII_LOWER_X or payload[index + 1] == Character::ASCII_UPPER_X):
                index <- index + NumberFormat::HEX_PREFIX_LENGTH
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                return invalid_value() if payload[index] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH
                digit: ParsedValue = hex_digit(payload[index])
                return invalid_value() if not digit.valid or digits >= MemoryPayload::REFERENCE_MAX_DIGITS or value > (NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_MAX_U64 - digit.value) / NumberFormat::DAP_PAYLOAD_HEX_BASE
                value <- value * NumberFormat::DAP_PAYLOAD_HEX_BASE + digit.value
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if index >= length or digits == 0
            if index + 1 < length:
                delimiter: u8 = payload[index + 1]
                return invalid_value() if not is_whitespace(delimiter) and delimiter != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA and delimiter != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and delimiter != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index + 1}

        def parse_unsigned_bounded(payload: u8&, length: usize, start: usize, maximum: u64) -> ParsedValue:
            return invalid_value() if start >= length or payload[start] < Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO or payload[start] > Character::DAP_PAYLOAD_CHARACTER_ASCII_NINE
            index: mutable usize = start
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] >= Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO and payload[index] <= Character::DAP_PAYLOAD_CHARACTER_ASCII_NINE:
                return invalid_value() if digits == NumberFormat::FIRST_DIGIT_COUNT and value == 0
                digit: u64 = (payload[index] - Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO).u64()
                return invalid_value() if value > (maximum - digit) / NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_DECIMAL_BASE
                value <- value * NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_DECIMAL_BASE + digit
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if digits == 0
            if index < length:
                return invalid_value() if not is_whitespace(payload[index]) and payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index}

        def parse_count(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return parse_unsigned_bounded(payload, length, start, MemoryPayload::COUNT_MAX)

        def parse_signed_offset(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length
            negative: bool = payload[start] == Character::DAP_PAYLOAD_CHARACTER_ASCII_MINUS
            index: mutable usize = start + 1 if negative else start
            return invalid_value() if index >= length or payload[index] < Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO or payload[index] > Character::DAP_PAYLOAD_CHARACTER_ASCII_NINE
            maximum: u64 = NumberFormat::MIN_I64_MAGNITUDE if negative else NumberFormat::MAX_I64
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] >= Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO and payload[index] <= Character::DAP_PAYLOAD_CHARACTER_ASCII_NINE:
                return invalid_value() if digits == NumberFormat::FIRST_DIGIT_COUNT and value == 0
                digit: u64 = (payload[index] - Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO).u64()
                return invalid_value() if value > (maximum - digit) / NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_DECIMAL_BASE
                value <- value * NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_DECIMAL_BASE + digit
                digits <- digits + 1
                index <- index + 1
            return invalid_value() if digits == 0
            if index < length:
                return invalid_value() if not is_whitespace(payload[index]) and payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[index] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return ParsedValue{valid: true, value: value, end: index}

        def request_handle_value_parse(payload: u8&, length: usize, field: u8) -> ParsedValue:
            root_start: mutable usize = RequestParsing::FIRST_JSON_BYTE_INDEX
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + RequestParsing::JSON_WHITESPACE_INCREMENT
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 0)
            return invalid_value() if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return invalid_value() if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            reference_start: usize = object_field_value_start(payload, length, arguments, field, 0)
            return invalid_value() if reference_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, field, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return parse_unsigned_bounded(payload, length, reference_start, NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_MAX_U64)

    public:
        struct ProgramPath:
            bytes: mutable u8[SourcePaths::PROGRAM_PATH_CAPACITY]
            length: mutable usize
            valid: mutable bool

        struct ClientOptions:
            valid: mutable bool
            lines_start_at_one: mutable bool
            columns_start_at_one: mutable bool
            supports_variable_type: mutable bool

        struct MemoryRequest:
            valid: mutable bool
            address: mutable u64
            count: mutable usize

        struct VariablesRequest:
            valid: mutable bool
            reference: mutable u64
            start: mutable usize
            count: mutable usize
            has_count: mutable bool

        struct ReferenceRequest:
            valid: mutable bool
            reference: mutable u64

        # DAP's JSON number model cannot exactly carry arbitrary u64 results.
        # The extension response uses exact u32 halves, joined by this parser.
        struct HostEffectResponse:
            valid: mutable bool
            request_id: mutable u64
            has_value: mutable bool
            value: mutable u64

        struct StackTraceRequest:
            valid: mutable bool
            thread_id: mutable u64
            start_frame: mutable usize
            levels: mutable usize
            has_levels: mutable bool

        struct EvaluateRequest:
            valid: mutable bool
            expression: mutable ProgramPath
            frame_id: mutable u64
            has_frame_id: mutable bool

        struct BreakpointConditionExpression:
            bytes: mutable u8[BreakpointCondition::MAX_EXPRESSION_BYTES]
            length: mutable usize
            has_condition: mutable bool
            valid: mutable bool

        struct BreakpointConditionReference:
            offset: mutable usize
            length: mutable usize
            has_condition: mutable bool

        struct BreakpointLogMessage:
            bytes: mutable u8[BreakpointLog::MAX_MESSAGE_BYTES]
            length: mutable usize
            has_message: mutable bool
            valid: mutable bool

        struct BreakpointLogMessageReference:
            offset: mutable usize
            length: mutable usize
            has_message: mutable bool

        struct SourceBreakpointsRequest:
            valid: mutable bool
            source_reference: mutable u64
            has_source_reference: mutable bool
            source_path: mutable ProgramPath
            has_source_path: mutable bool
            lines: mutable u32[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            columns: mutable u32[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            has_columns: mutable bool[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            hit_targets: mutable u64[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            has_hit_targets: mutable bool[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            breakpoint_text_bytes: mutable u8[BreakpointText::MAX_REQUEST_TEXT_BYTES]
            conditions: mutable BreakpointConditionReference[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            log_messages: mutable BreakpointLogMessageReference[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            breakpoint_text_bytes_length: mutable usize
            count: mutable usize

        struct FunctionBreakpointsRequest:
            valid: mutable bool
            breakpoint_text_bytes: mutable u8[BreakpointText::MAX_REQUEST_TEXT_BYTES]
            name_offsets: mutable usize[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            name_lengths: mutable usize[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            condition_offsets: mutable usize[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            condition_lengths: mutable usize[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            has_conditions: mutable bool[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            hit_targets: mutable u64[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            has_hit_targets: mutable bool[SourcePaths::SOURCE_BREAKPOINT_LIMIT]
            breakpoint_text_bytes_length: mutable usize
            count: mutable usize

        struct SourcePathRootRequest:
            valid: mutable bool
            root: mutable ProgramPath
            has_root: mutable bool

        struct VirtualFileSnapshot:
            path_id: mutable u64
            generation: mutable u64
            bytes: mutable u8[VirtualFileSnapshots::MAX_SNAPSHOT_BYTES]
            length: mutable usize
            writable: mutable bool

        struct VirtualFileSnapshotsRequest:
            valid: mutable bool
            snapshots: mutable VirtualFileSnapshot[VirtualFileSnapshots::MAX_SNAPSHOT_COUNT]
            count: mutable usize

    private:
        def virtual_file_path_id(path: ProgramPath) -> u64:
            hash: mutable u64 = VirtualFileSnapshots::HASH_OFFSET_BASIS
            for index in VirtualFileSnapshots::FIRST_PATH_BYTE..<path.length:
                hash <- (hash ^ path.bytes[index].u64()) * VirtualFileSnapshots::HASH_PRIME
            return hash

        def virtual_file_snapshot_parse(payload: u8&, length: usize, object_start: usize) -> VirtualFileSnapshot:
            snapshot: mutable VirtualFileSnapshot = zeroed
            path_start: usize = object_field_value_start(payload, length, object_start, DapFields::VIRTUAL_FILE_PATH, VirtualFileSnapshots::FIRST_PROPERTY)
            return snapshot if path_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, object_start, DapFields::VIRTUAL_FILE_PATH, VirtualFileSnapshots::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            path: ProgramPath = parse_program_path_string(payload, length, path_start)
            return snapshot if not path.valid or path.length > SourcePaths::PATH_COMPONENT_CAPACITY
            snapshot.path_id <- virtual_file_path_id(path)
            return zeroed if snapshot.path_id == VirtualFileSnapshots::NO_PATH_ID
            snapshot.generation <- VirtualFileSnapshots::INITIAL_GENERATION
            contents_start: usize = object_field_value_start(payload, length, object_start, DapFields::VIRTUAL_FILE_CONTENTS_HEX, VirtualFileSnapshots::FIRST_PROPERTY)
            return zeroed if contents_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, object_start, DapFields::VIRTUAL_FILE_CONTENTS_HEX, VirtualFileSnapshots::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return zeroed if contents_start >= length or payload[contents_start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            cursor: mutable usize = contents_start + 1
            while cursor < length and payload[cursor] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                return zeroed if cursor + VirtualFileSnapshots::HEX_DIGIT_PAIR_WIDTH >= length or snapshot.length >= VirtualFileSnapshots::MAX_SNAPSHOT_BYTES
                high_nibble: ParsedValue = hex_digit(payload[cursor])
                low_nibble: ParsedValue = hex_digit(payload[cursor + VirtualFileSnapshots::LOW_NIBBLE_OFFSET])
                return zeroed if not high_nibble.valid or not low_nibble.valid
                snapshot.bytes[snapshot.length] <- ((high_nibble.value << VirtualFileSnapshots::HEX_HIGH_NIBBLE_SHIFT) | low_nibble.value).u8()
                snapshot.length <- snapshot.length + VirtualFileSnapshots::NEXT_RESOURCE
                cursor <- cursor + VirtualFileSnapshots::HEX_DIGIT_PAIR_WIDTH
            return zeroed if cursor >= length
            contents_end: usize = json_string_end(payload, length, contents_start)
            return zeroed if contents_end != cursor + VirtualFileSnapshots::NEXT_RESOURCE
            writable_start: usize = object_field_value_start(payload, length, object_start, DapFields::VIRTUAL_FILE_WRITABLE, VirtualFileSnapshots::FIRST_PROPERTY)
            return zeroed if object_field_value_start(payload, length, object_start, DapFields::VIRTUAL_FILE_WRITABLE, VirtualFileSnapshots::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            if writable_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                writable_value: ParsedValue = parse_json_boolean(payload, length, writable_start)
                return zeroed if not writable_value.valid
                snapshot.writable <- writable_value.value != VirtualFileSnapshots::FALSE_BOOLEAN_VALUE
            return snapshot

        def virtual_file_snapshots_parse_array(payload: u8&, length: usize, array_start: usize, request: mutable VirtualFileSnapshotsRequest&) -> bool:
            return false if array_start >= length or payload[array_start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN
            cursor: mutable usize = array_start + VirtualFileSnapshots::NEXT_RESOURCE
            while cursor < length:
                while cursor < length and is_whitespace(payload[cursor]):
                    cursor <- cursor + VirtualFileSnapshots::NEXT_RESOURCE
                return false if cursor >= length
                return true if payload[cursor] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return false if request.count >= VirtualFileSnapshots::MAX_SNAPSHOT_COUNT or payload[cursor] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
                snapshot: VirtualFileSnapshot = virtual_file_snapshot_parse(payload, length, cursor)
                return false if snapshot.path_id == VirtualFileSnapshots::NO_PATH_ID
                for index in VirtualFileSnapshots::FIRST_RESOURCE..<request.count:
                    return false if request.snapshots[index].path_id == snapshot.path_id
                request.snapshots[request.count] <- snapshot
                request.count <- request.count + VirtualFileSnapshots::NEXT_RESOURCE
                item_end: usize = json_value_end(payload, length, cursor)
                return false if item_end == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                cursor <- item_end
                while cursor < length and is_whitespace(payload[cursor]):
                    cursor <- cursor + VirtualFileSnapshots::NEXT_RESOURCE
                return true if cursor < length and payload[cursor] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return false if cursor >= length or payload[cursor] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA
                cursor <- cursor + VirtualFileSnapshots::NEXT_RESOURCE
                lookahead: mutable usize = cursor
                while lookahead < length and is_whitespace(payload[lookahead]):
                    lookahead <- lookahead + VirtualFileSnapshots::NEXT_RESOURCE
                return false if lookahead >= length or payload[lookahead] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return false

    public:
        def virtual_file_snapshots_request_parse(payload: u8&, length: usize) -> VirtualFileSnapshotsRequest:
            request: mutable VirtualFileSnapshotsRequest = zeroed
            root_start: mutable usize = RequestParsing::FIRST_JSON_BYTE_INDEX
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + RequestParsing::JSON_WHITESPACE_INCREMENT
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, VirtualFileSnapshots::FIRST_PROPERTY)
            if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                request.valid <- object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, VirtualFileSnapshots::DUPLICATE_PROPERTY) == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                return request
            return request if object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, VirtualFileSnapshots::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            files: usize = object_field_value_start(payload, length, arguments, DapFields::ELISA_VIRTUAL_FILES, VirtualFileSnapshots::FIRST_PROPERTY)
            if files == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                request.valid <- object_field_value_start(payload, length, arguments, DapFields::ELISA_VIRTUAL_FILES, VirtualFileSnapshots::DUPLICATE_PROPERTY) == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                return request
            return request if object_field_value_start(payload, length, arguments, DapFields::ELISA_VIRTUAL_FILES, VirtualFileSnapshots::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if not virtual_file_snapshots_parse_array(payload, length, files, request)
            request.valid <- true
            return request

        def thread_id_request_parse(payload: u8&, length: usize) -> ReferenceRequest:
            parsed: ParsedValue = request_handle_value_parse(payload, length, DapFields::THREAD_ID)
            return ReferenceRequest{valid: parsed.valid, reference: parsed.value}

        def host_effect_response_parse(payload: u8&, length: usize) -> HostEffectResponse:
            response: mutable HostEffectResponse = zeroed
            root_start: mutable usize = RequestParsing::FIRST_JSON_BYTE_INDEX
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + RequestParsing::JSON_WHITESPACE_INCREMENT
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, HostEffectResponseParsing::FIRST_PROPERTY)
            return response if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, HostEffectResponseParsing::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return response if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN

            request_id_start: usize = object_field_value_start(payload, length, arguments, DapFields::HOST_EFFECT_REQUEST_ID, HostEffectResponseParsing::FIRST_PROPERTY)
            return response if request_id_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::HOST_EFFECT_REQUEST_ID, HostEffectResponseParsing::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            request_id: ParsedValue = parse_unsigned_bounded(payload, length, request_id_start, NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_MAX_U64)
            return response if not request_id.valid or request_id.value == HostEffectResponseParsing::NO_REQUEST_ID

            high_start: usize = object_field_value_start(payload, length, arguments, DapFields::HOST_EFFECT_VALUE_HIGH, HostEffectResponseParsing::FIRST_PROPERTY)
            low_start: usize = object_field_value_start(payload, length, arguments, DapFields::HOST_EFFECT_VALUE_LOW, HostEffectResponseParsing::FIRST_PROPERTY)
            return response if object_field_value_start(payload, length, arguments, DapFields::HOST_EFFECT_VALUE_HIGH, HostEffectResponseParsing::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::HOST_EFFECT_VALUE_LOW, HostEffectResponseParsing::DUPLICATE_PROPERTY) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return response if (high_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX) != (low_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX)

            response.valid <- true
            response.request_id <- request_id.value
            response.has_value <- high_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            if response.has_value:
                value_high: ParsedValue = parse_unsigned_bounded(payload, length, high_start, NumberFormat::MAX_U32)
                value_low: ParsedValue = parse_unsigned_bounded(payload, length, low_start, NumberFormat::MAX_U32)
                return HostEffectResponse{valid: false, request_id: HostEffectResponseParsing::NO_REQUEST_ID, has_value: false, value: 0} if not value_high.valid or not value_low.valid
                response.value <- (value_high.value << HostEffectResponseParsing::VALUE_HALF_WIDTH) | value_low.value
            return response

        def frame_id_request_parse(payload: u8&, length: usize) -> ReferenceRequest:
            parsed: ParsedValue = request_handle_value_parse(payload, length, DapFields::FRAME_ID)
            return ReferenceRequest{valid: parsed.valid, reference: parsed.value}

        def evaluate_request_parse(payload: u8&, length: usize) -> EvaluateRequest:
            request: mutable EvaluateRequest = zeroed
            root_start: mutable usize = RequestParsing::FIRST_JSON_BYTE_INDEX
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + RequestParsing::JSON_WHITESPACE_INCREMENT
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, StackTraceParsing::FIRST_PROPERTY_OCCURRENCE)
            return request if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, StackTraceParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            expression_start: usize = object_field_value_start(payload, length, arguments, DapFields::EXPRESSION, StackTraceParsing::FIRST_PROPERTY_OCCURRENCE)
            frame_start: usize = object_field_value_start(payload, length, arguments, DapFields::FRAME_ID, StackTraceParsing::FIRST_PROPERTY_OCCURRENCE)
            return request if expression_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::EXPRESSION, StackTraceParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if object_field_value_start(payload, length, arguments, DapFields::FRAME_ID, StackTraceParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            expression: ProgramPath = parse_program_path_string(payload, length, expression_start)
            return request if not expression.valid
            request.expression <- expression
            if frame_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                frame_id: ParsedValue = parse_unsigned_bounded(payload, length, frame_start, NumberFormat::MAX_U32)
                return request if not frame_id.valid
                request.frame_id <- frame_id.value
                request.has_frame_id <- true
            request.valid <- true
            return request

        def stack_trace_request_parse(payload: u8&, length: usize) -> StackTraceRequest:
            request: mutable StackTraceRequest = zeroed
            request.start_frame <- StackTraceParsing::DEFAULT_START_FRAME
            request.levels <- StackTraceParsing::DEFAULT_LEVELS
            root_start: mutable usize = RequestParsing::FIRST_JSON_BYTE_INDEX
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + RequestParsing::JSON_WHITESPACE_INCREMENT
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, StackTraceParsing::FIRST_PROPERTY_OCCURRENCE)
            return request if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, StackTraceParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            thread_start: usize = object_field_value_start(payload, length, arguments, DapFields::THREAD_ID, StackTraceParsing::FIRST_PROPERTY_OCCURRENCE)
            start_frame_start: usize = object_field_value_start(payload, length, arguments, DapFields::START_FRAME, StackTraceParsing::FIRST_PROPERTY_OCCURRENCE)
            levels_start: usize = object_field_value_start(payload, length, arguments, DapFields::LEVELS, StackTraceParsing::FIRST_PROPERTY_OCCURRENCE)
            return request if thread_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if object_field_value_start(payload, length, arguments, DapFields::THREAD_ID, StackTraceParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if object_field_value_start(payload, length, arguments, DapFields::START_FRAME, StackTraceParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if object_field_value_start(payload, length, arguments, DapFields::LEVELS, StackTraceParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            thread_id: ParsedValue = parse_unsigned_bounded(payload, length, thread_start, NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_MAX_U64)
            return request if not thread_id.valid
            request.thread_id <- thread_id.value
            if start_frame_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                start_frame: ParsedValue = parse_unsigned_bounded(payload, length, start_frame_start, NumberFormat::MAX_U32)
                return request if not start_frame.valid
                request.start_frame <- start_frame.value.usize()
            if levels_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                levels: ParsedValue = parse_unsigned_bounded(payload, length, levels_start, NumberFormat::MAX_U32)
                return request if not levels.valid
                request.levels <- levels.value.usize()
                request.has_levels <- true
            request.valid <- true
            return request

        def hit_condition_string_parse(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length or payload[start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE
            cursor: mutable usize = start + HitCondition::QUOTE_WIDTH
            value: mutable u64 = HitCondition::NO_TARGET
            digit_count: mutable usize = 0
            while cursor < length and payload[cursor] != Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE:
                byte: u8 = payload[cursor]
                return invalid_value() if byte < Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO or byte > Character::DAP_PAYLOAD_CHARACTER_ASCII_NINE
                digit: u64 = (byte - Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO).u64()
                return invalid_value() if value > (HitCondition::MAX_TARGET - digit) / NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_DECIMAL_BASE
                value <- value * NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_DECIMAL_BASE + digit
                digit_count <- digit_count + HitCondition::DIGIT_INCREMENT
                cursor <- cursor + HitCondition::DIGIT_INCREMENT
            return invalid_value() if cursor >= length or digit_count == 0 or value == HitCondition::NO_TARGET
            return ParsedValue{valid: true, value: value, end: cursor + HitCondition::QUOTE_WIDTH}

        def breakpoint_condition_string_parse(payload: u8&, length: usize, start: usize) -> BreakpointConditionExpression:
            condition: mutable BreakpointConditionExpression = zeroed
            end: usize = json_string_end(payload, length, start)
            return condition if end == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            condition.valid <- true
            return condition if end == start + BreakpointCondition::TWO_QUOTE_WIDTH
            cursor: mutable usize = start + BreakpointCondition::QUOTE_WIDTH
            content_end: usize = end - BreakpointCondition::QUOTE_WIDTH
            while cursor < content_end:
                decoded: mutable u8 = payload[cursor]
                if payload[cursor] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                    return zeroed if cursor + BreakpointCondition::ESCAPED_BYTE_WIDTH > content_end
                    escaped: u8 = payload[cursor + BreakpointCondition::BYTE_INCREMENT]
                    if escaped == Character::ASCII_LOWER_U:
                        codepoint: ParsedValue = parse_unicode_quad(payload, content_end, cursor + BreakpointCondition::ESCAPED_BYTE_WIDTH)
                        return zeroed if not codepoint.valid or codepoint.value > BreakpointCondition::ASCII_ONLY_MAX
                        decoded <- codepoint.value.u8()
                        cursor <- codepoint.end
                    else:
                        if escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE or escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH or escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_SLASH:
                            decoded <- escaped
                        else:
                            if escaped == Character::ASCII_BACKSPACE:
                                decoded <- BreakpointCondition::ESCAPE_BACKSPACE
                            else:
                                if escaped == Character::ASCII_FORM_FEED:
                                    decoded <- BreakpointCondition::ESCAPE_FORM_FEED
                                else:
                                    if escaped == Character::ASCII_NEWLINE:
                                        decoded <- BreakpointCondition::ESCAPE_LINE_FEED
                                    else:
                                        if escaped == Character::ESCAPE_CARRIAGE_RETURN:
                                            decoded <- BreakpointCondition::ESCAPE_CARRIAGE_RETURN
                                        else:
                                            if escaped == Character::ESCAPE_TAB:
                                                decoded <- BreakpointCondition::ESCAPE_TAB
                                            else:
                                                return zeroed
                        cursor <- cursor + BreakpointCondition::ESCAPED_BYTE_WIDTH
                else:
                    return zeroed if payload[cursor] < BreakpointCondition::ASCII_SPACE or payload[cursor].u64() > BreakpointCondition::ASCII_ONLY_MAX
                    cursor <- cursor + BreakpointCondition::BYTE_INCREMENT
                return zeroed if condition.length >= BreakpointCondition::MAX_EXPRESSION_BYTES
                condition.bytes[condition.length] <- decoded
                condition.length <- condition.length + BreakpointCondition::BYTE_INCREMENT
            condition.has_condition <- true
            return condition

        def breakpoint_log_message_string_parse(payload: u8&, length: usize, start: usize) -> BreakpointLogMessage:
            message: mutable BreakpointLogMessage = zeroed
            end: usize = json_string_end(payload, length, start)
            return message if end == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            message.valid <- true
            message.has_message <- true
            return message if end == start + BreakpointCondition::TWO_QUOTE_WIDTH
            cursor: mutable usize = start + BreakpointCondition::QUOTE_WIDTH
            content_end: usize = end - BreakpointCondition::QUOTE_WIDTH
            while cursor < content_end:
                decoded: mutable u8 = payload[cursor]
                if payload[cursor] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH:
                    return zeroed if cursor + BreakpointCondition::ESCAPED_BYTE_WIDTH > content_end
                    escaped: u8 = payload[cursor + BreakpointCondition::BYTE_INCREMENT]
                    if escaped == Character::ASCII_LOWER_U:
                        codepoint: ParsedValue = parse_unicode_quad(payload, content_end, cursor + BreakpointCondition::ESCAPED_BYTE_WIDTH)
                        return zeroed if not codepoint.valid or codepoint.value > BreakpointCondition::ASCII_ONLY_MAX
                        decoded <- codepoint.value.u8()
                        cursor <- codepoint.end
                    else:
                        if escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_QUOTE or escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_BACKSLASH or escaped == Character::DAP_PAYLOAD_CHARACTER_ASCII_SLASH:
                            decoded <- escaped
                        else:
                            if escaped == Character::ASCII_BACKSPACE:
                                decoded <- BreakpointCondition::ESCAPE_BACKSPACE
                            else:
                                if escaped == Character::ASCII_FORM_FEED:
                                    decoded <- BreakpointCondition::ESCAPE_FORM_FEED
                                else:
                                    if escaped == Character::ASCII_NEWLINE:
                                        decoded <- BreakpointCondition::ESCAPE_LINE_FEED
                                    else:
                                        if escaped == Character::ESCAPE_CARRIAGE_RETURN:
                                            decoded <- BreakpointCondition::ESCAPE_CARRIAGE_RETURN
                                        else:
                                            if escaped == Character::ESCAPE_TAB:
                                                decoded <- BreakpointCondition::ESCAPE_TAB
                                            else:
                                                return zeroed
                        cursor <- cursor + BreakpointCondition::ESCAPED_BYTE_WIDTH
                else:
                    return zeroed if payload[cursor] < BreakpointCondition::ASCII_SPACE
                    cursor <- cursor + BreakpointCondition::BYTE_INCREMENT
                return zeroed if message.length >= BreakpointLog::MAX_MESSAGE_BYTES
                message.bytes[message.length] <- decoded
                message.length <- message.length + BreakpointCondition::BYTE_INCREMENT
            return message

        def source_breakpoints_append(request: mutable SourceBreakpointsRequest&, line: u64, column: u64, has_column: bool, hit_target: u64, has_hit_target: bool, condition: BreakpointConditionExpression, log_message: BreakpointLogMessage) -> bool:
            return false if request.count >= SourcePaths::SOURCE_BREAKPOINT_LIMIT or line > NumberFormat::MAX_U32 or column > NumberFormat::MAX_U32
            return false if request.breakpoint_text_bytes_length > BreakpointText::MAX_REQUEST_TEXT_BYTES
            return false if condition.length > BreakpointText::MAX_REQUEST_TEXT_BYTES - request.breakpoint_text_bytes_length
            return false if log_message.length > BreakpointText::MAX_REQUEST_TEXT_BYTES - request.breakpoint_text_bytes_length - condition.length
            request.lines[request.count] <- line.u32()
            request.columns[request.count] <- column.u32()
            request.has_columns[request.count] <- has_column
            request.hit_targets[request.count] <- hit_target
            request.has_hit_targets[request.count] <- has_hit_target
            condition_offset: usize = request.breakpoint_text_bytes_length if condition.length > BreakpointCondition::EMPTY_EXPRESSION_LENGTH else BreakpointText::FIRST_TEXT_BYTE
            request.conditions[request.count] <- BreakpointConditionReference{offset: condition_offset, length: condition.length, has_condition: condition.has_condition}
            for index in 0..<condition.length:
                request.breakpoint_text_bytes[request.breakpoint_text_bytes_length + index] <- condition.bytes[index]
            message_offset: usize = request.breakpoint_text_bytes_length + condition.length if log_message.length > BreakpointLog::EMPTY_MESSAGE_LENGTH else BreakpointText::FIRST_TEXT_BYTE
            request.log_messages[request.count] <- BreakpointLogMessageReference{offset: message_offset, length: log_message.length, has_message: log_message.has_message}
            for index in 0..<log_message.length:
                request.breakpoint_text_bytes[message_offset + index] <- log_message.bytes[index]
            request.breakpoint_text_bytes_length <- request.breakpoint_text_bytes_length + condition.length + log_message.length
            request.count <- request.count + 1
            return true

        def source_breakpoints_parse_array(payload: u8&, length: usize, array_start: usize, request: mutable SourceBreakpointsRequest&, object_items: bool) -> bool:
            return false if array_start >= length or payload[array_start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN
            cursor: mutable usize = array_start + 1
            while cursor < length:
                while cursor < length and is_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                return false if cursor >= length
                if payload[cursor] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE:
                    return true
                line: mutable ParsedValue = invalid_value()
                column: mutable u64 = SourcePaths::DAP_SOURCE_BREAKPOINT_NO_COLUMN
                has_column: mutable bool = false
                hit_target: mutable u64 = HitCondition::NO_TARGET
                has_hit_target: mutable bool = false
                condition: mutable BreakpointConditionExpression = zeroed
                condition.valid <- true
                log_message: mutable BreakpointLogMessage = zeroed
                log_message.valid <- true
                if object_items:
                    return false if payload[cursor] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
                    log_message_start: usize = object_field_value_start(payload, length, cursor, DapFields::LOG_MESSAGE, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
                    if log_message_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                        return false if object_field_value_start(payload, length, cursor, DapFields::LOG_MESSAGE, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                        log_message <- breakpoint_log_message_string_parse(payload, length, log_message_start)
                        return false if not log_message.valid
                    condition_start: usize = object_field_value_start(payload, length, cursor, DapFields::CONDITION, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
                    if condition_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                        return false if object_field_value_start(payload, length, cursor, DapFields::CONDITION, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                        condition <- breakpoint_condition_string_parse(payload, length, condition_start)
                        return false if not condition.valid
                    hit_condition_start: usize = object_field_value_start(payload, length, cursor, DapFields::HIT_CONDITION, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
                    if hit_condition_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                        return false if object_field_value_start(payload, length, cursor, DapFields::HIT_CONDITION, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                        hit_condition: ParsedValue = hit_condition_string_parse(payload, length, hit_condition_start)
                        return false if not hit_condition.valid
                        hit_target <- hit_condition.value
                        has_hit_target <- true
                    line_start: usize = object_field_value_start(payload, length, cursor, DapFields::LINE, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
                    return false if line_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, cursor, DapFields::LINE, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                    line <- parse_unsigned_bounded(payload, length, line_start, NumberFormat::MAX_U32)
                    column_start: usize = object_field_value_start(payload, length, cursor, DapFields::COLUMN, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
                    if column_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                        return false if object_field_value_start(payload, length, cursor, DapFields::COLUMN, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                        parsed_column: ParsedValue = parse_unsigned_bounded(payload, length, column_start, NumberFormat::MAX_U32)
                        return false if not parsed_column.valid
                        column <- parsed_column.value
                        has_column <- true
                    return false if not line.valid or not source_breakpoints_append(request, line.value, column, has_column, hit_target, has_hit_target, condition, log_message)
                    item_end: usize = json_value_end(payload, length, cursor)
                    return false if item_end == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                    cursor <- item_end
                else:
                    line <- parse_unsigned_bounded(payload, length, cursor, NumberFormat::MAX_U32)
                    return false if not line.valid or not source_breakpoints_append(request, line.value, SourcePaths::DAP_SOURCE_BREAKPOINT_NO_COLUMN, false, HitCondition::NO_TARGET, false, condition, log_message)
                    cursor <- line.end
                while cursor < length and is_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                return false if cursor >= length
                return true if payload[cursor] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return false if payload[cursor] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA
                cursor <- cursor + 1
                lookahead: mutable usize = cursor
                while lookahead < length and is_whitespace(payload[lookahead]):
                    lookahead <- lookahead + 1
                return false if lookahead >= length or payload[lookahead] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return false

        def function_breakpoints_append(request: mutable FunctionBreakpointsRequest&, name: ProgramPath, condition: BreakpointConditionExpression, hit_target: u64, has_hit_target: bool) -> bool:
            return false if request.count >= SourcePaths::SOURCE_BREAKPOINT_LIMIT or not name.valid or name.length == FunctionBreakpointParsing::NO_TEXT_BYTES or name.length > FunctionBreakpointParsing::MAX_NAME_BYTES
            return false if request.breakpoint_text_bytes_length > BreakpointText::MAX_REQUEST_TEXT_BYTES
            return false if name.length > BreakpointText::MAX_REQUEST_TEXT_BYTES - request.breakpoint_text_bytes_length
            return false if condition.length > BreakpointText::MAX_REQUEST_TEXT_BYTES - request.breakpoint_text_bytes_length - name.length
            name_offset: usize = request.breakpoint_text_bytes_length
            condition_offset: usize = request.breakpoint_text_bytes_length + name.length if condition.length > FunctionBreakpointParsing::NO_TEXT_BYTES else BreakpointText::FIRST_TEXT_BYTE
            request.name_offsets[request.count] <- name_offset
            request.name_lengths[request.count] <- name.length
            request.condition_offsets[request.count] <- condition_offset
            request.condition_lengths[request.count] <- condition.length
            request.has_conditions[request.count] <- condition.has_condition
            request.hit_targets[request.count] <- hit_target
            request.has_hit_targets[request.count] <- has_hit_target
            for index in 0..<name.length:
                request.breakpoint_text_bytes[name_offset + index] <- name.bytes[index]
            for index in 0..<condition.length:
                request.breakpoint_text_bytes[condition_offset + index] <- condition.bytes[index]
            request.breakpoint_text_bytes_length <- request.breakpoint_text_bytes_length + name.length + condition.length
            request.count <- request.count + FunctionBreakpointParsing::BYTE_INCREMENT
            return true

        def function_breakpoints_parse_array(payload: u8&, length: usize, array_start: usize, request: mutable FunctionBreakpointsRequest&) -> bool:
            return false if array_start >= length or payload[array_start] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_OPEN
            cursor: mutable usize = array_start + FunctionBreakpointParsing::BYTE_INCREMENT
            while cursor < length:
                while cursor < length and is_whitespace(payload[cursor]):
                    cursor <- cursor + FunctionBreakpointParsing::BYTE_INCREMENT
                return false if cursor >= length
                return true if payload[cursor] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return false if payload[cursor] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
                name_start: usize = object_field_value_start(payload, length, cursor, DapFields::NAME, FunctionBreakpointParsing::FIRST_PROPERTY_OCCURRENCE)
                condition_start: usize = object_field_value_start(payload, length, cursor, DapFields::CONDITION, FunctionBreakpointParsing::FIRST_PROPERTY_OCCURRENCE)
                hit_condition_start: usize = object_field_value_start(payload, length, cursor, DapFields::HIT_CONDITION, FunctionBreakpointParsing::FIRST_PROPERTY_OCCURRENCE)
                return false if name_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                return false if object_field_value_start(payload, length, cursor, DapFields::NAME, FunctionBreakpointParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                return false if object_field_value_start(payload, length, cursor, DapFields::CONDITION, FunctionBreakpointParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                return false if object_field_value_start(payload, length, cursor, DapFields::HIT_CONDITION, FunctionBreakpointParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                name: ProgramPath = parse_program_path_string(payload, length, name_start)
                return false if not name.valid or name.length > FunctionBreakpointParsing::MAX_NAME_BYTES
                condition: mutable BreakpointConditionExpression = zeroed
                condition.valid <- true
                if condition_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                    condition <- breakpoint_condition_string_parse(payload, length, condition_start)
                    return false if not condition.valid
                hit_target: mutable u64 = FunctionBreakpointParsing::NO_HIT_TARGET
                has_hit_target: mutable bool = false
                if hit_condition_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                    parsed_hit_target: ParsedValue = hit_condition_string_parse(payload, length, hit_condition_start)
                    return false if not parsed_hit_target.valid
                    hit_target <- parsed_hit_target.value
                    has_hit_target <- true
                return false if not function_breakpoints_append(request, name, condition, hit_target, has_hit_target)
                item_end: usize = json_value_end(payload, length, cursor)
                return false if item_end == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
                cursor <- item_end
                while cursor < length and is_whitespace(payload[cursor]):
                    cursor <- cursor + FunctionBreakpointParsing::BYTE_INCREMENT
                return false if cursor >= length
                return true if payload[cursor] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return false if payload[cursor] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA
                cursor <- cursor + FunctionBreakpointParsing::BYTE_INCREMENT
                lookahead: mutable usize = cursor
                while lookahead < length and is_whitespace(payload[lookahead]):
                    lookahead <- lookahead + FunctionBreakpointParsing::BYTE_INCREMENT
                return false if lookahead >= length or payload[lookahead] == Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
            return false

        def function_breakpoints_request_parse(payload: u8&, length: usize) -> FunctionBreakpointsRequest:
            request: mutable FunctionBreakpointsRequest = zeroed
            root_start: mutable usize = RequestParsing::FIRST_JSON_BYTE_INDEX
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + RequestParsing::JSON_WHITESPACE_INCREMENT
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, FunctionBreakpointParsing::FIRST_PROPERTY_OCCURRENCE)
            return request if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, FunctionBreakpointParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            breakpoints: usize = object_field_value_start(payload, length, arguments, DapFields::FUNCTION_BREAKPOINTS, FunctionBreakpointParsing::FIRST_PROPERTY_OCCURRENCE)
            return request if breakpoints == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::FUNCTION_BREAKPOINTS, FunctionBreakpointParsing::DUPLICATE_PROPERTY_OCCURRENCE) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if not function_breakpoints_parse_array(payload, length, breakpoints, request)
            request.valid <- true
            return request

        # A sourceReference is the explicit EDIR source-file DebugId. Paths
        # are resolved only against an artifact's source table; never hash an
        # editor path into a guessed source identity.
        def source_breakpoints_request_parse(payload: u8&, length: usize) -> SourceBreakpointsRequest:
            request: mutable SourceBreakpointsRequest = zeroed
            root_start: mutable usize = RequestParsing::FIRST_JSON_BYTE_INDEX
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
            return request if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            source: usize = object_field_value_start(payload, length, arguments, DapFields::SOURCE, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
            breakpoints: usize = object_field_value_start(payload, length, arguments, DapFields::BREAKPOINTS, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
            lines: usize = object_field_value_start(payload, length, arguments, DapFields::LINES, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
            return request if source == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or payload[source] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            return request if object_field_value_start(payload, length, arguments, DapFields::SOURCE, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::BREAKPOINTS, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::LINES, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if breakpoints != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX and lines != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            source_reference: usize = object_field_value_start(payload, length, source, DapFields::SOURCE_REFERENCE, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
            source_path_start: usize = object_field_value_start(payload, length, source, DapFields::DAP_PAYLOAD_DAPFIELDS_SOURCE_PATH, SourcePaths::DAP_SOURCE_BREAKPOINT_FIRST_FIELD_OCCURRENCE_INDEX)
            return request if object_field_value_start(payload, length, source, DapFields::SOURCE_REFERENCE, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, source, DapFields::DAP_PAYLOAD_DAPFIELDS_SOURCE_PATH, SourcePaths::DAP_SOURCE_BREAKPOINT_DUPLICATE_FIELD_OCCURRENCE_INDEX) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            if source_reference != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                parsed_reference: ParsedValue = parse_source_reference(payload, length, source_reference)
                return request if not parsed_reference.valid
                request.source_reference <- parsed_reference.value
                request.has_source_reference <- true
            if source_path_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                request.source_path <- parse_program_path_string(payload, length, source_path_start)
                return request if not request.source_path.valid
                request.has_source_path <- true
            return request if not request.has_source_reference and not request.has_source_path
            return request if request.source_reference == SourcePaths::NO_SOURCE_REFERENCE and not request.has_source_path
            if breakpoints != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                return request if not source_breakpoints_parse_array(payload, length, breakpoints, request, true)
            if lines != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                return request if not source_breakpoints_parse_array(payload, length, lines, request, false)
            request.valid <- true
            return request

        def parse_source_reference(payload: u8&, length: usize, start: usize) -> ParsedValue:
            return invalid_value() if start >= length
            if payload[start] == Character::DAP_PAYLOAD_CHARACTER_ASCII_ZERO:
                end: usize = start + NumberFormat::FIRST_DIGIT_COUNT
                return invalid_value() if end < length and not is_whitespace(payload[end]) and payload[end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_COMMA and payload[end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_CLOSE and payload[end] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACKET_CLOSE
                return ParsedValue{valid: true, value: 0, end: end}
            return parse_unsigned_bounded(payload, length, start, NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_MAX_U64)

        # Decode only the direct DAP arguments used for paged variable
        # inspection. Nested decoys and duplicate properties are rejected.
        def variables_request_parse(payload: u8&, length: usize) -> VariablesRequest:
            request: mutable VariablesRequest = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 0)
            return request if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            reference_start: usize = object_field_value_start(payload, length, arguments, DapFields::VARIABLES_REFERENCE, 0)
            start_start: usize = object_field_value_start(payload, length, arguments, DapFields::START, 0)
            count_start: usize = object_field_value_start(payload, length, arguments, DapFields::COUNT, 0)
            return request if reference_start == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if object_field_value_start(payload, length, arguments, DapFields::VARIABLES_REFERENCE, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::START, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::COUNT, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            reference: ParsedValue = parse_unsigned_bounded(payload, length, reference_start, NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_MAX_U64)
            return request if not reference.valid
            request.reference <- reference.value
            if start_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                start: ParsedValue = parse_count(payload, length, start_start)
                return request if not start.valid
                request.start <- start.value.usize()
            if count_start != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                count: ParsedValue = parse_count(payload, length, count_start)
                return request if not count.valid
                request.count <- count.value.usize()
                request.has_count <- true
            request.valid <- true
            return request

        def memory_request_parse(payload: u8&, length: usize) -> MemoryRequest:
            request: mutable MemoryRequest = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 0)
            return request if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            first_reference: usize = object_field_value_start(payload, length, arguments, DapFields::MEMORY_REFERENCE, 0)
            first_count: usize = object_field_value_start(payload, length, arguments, DapFields::COUNT, 0)
            first_offset: usize = object_field_value_start(payload, length, arguments, DapFields::DAP_PAYLOAD_DAPFIELDS_OFFSET, 0)
            return request if first_reference == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or first_count == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return request if object_field_value_start(payload, length, arguments, DapFields::MEMORY_REFERENCE, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::COUNT, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::DAP_PAYLOAD_DAPFIELDS_OFFSET, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            reference: ParsedValue = parse_memory_reference(payload, length, first_reference)
            count: ParsedValue = parse_count(payload, length, first_count)
            return request if not reference.valid or not count.valid
            address: mutable u64 = reference.value
            if first_offset != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                offset: ParsedValue = parse_signed_offset(payload, length, first_offset)
                return request if not offset.valid
                if payload[first_offset] == Character::DAP_PAYLOAD_CHARACTER_ASCII_MINUS:
                    return request if offset.value > address
                    address <- address - offset.value
                else:
                    return request if offset.value > NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_MAX_U64 - address
                    address <- address + offset.value
            request.valid <- true
            request.address <- address
            request.count <- count.value.usize()
            return request

        def program_path_parse(payload: u8&, length: usize) -> ProgramPath:
            result: mutable ProgramPath = zeroed
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 0)
            return result if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return result if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            program: usize = object_field_value_start(payload, length, arguments, DapFields::PROGRAM, 0)
            return result if program == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX or object_field_value_start(payload, length, arguments, DapFields::PROGRAM, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            parsed: ProgramPath = parse_program_path_string(payload, length, program)
            return invalid_program_path() if not parsed.valid or parsed.length > SourcePaths::PATH_COMPONENT_CAPACITY
            return parsed

        def source_path_root_parse(payload: u8&, length: usize) -> SourcePathRootRequest:
            request: mutable SourcePathRootRequest = zeroed
            request.valid <- true
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 0)
            if object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                request.valid <- false
                return request
            return request if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN:
                request.valid <- false
                return request
            root: usize = object_field_value_start(payload, length, arguments, DapFields::SOURCE_PATH_ROOT, 0)
            if object_field_value_start(payload, length, arguments, DapFields::SOURCE_PATH_ROOT, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                request.valid <- false
                return request
            return request if root == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            request.root <- parse_program_path_string(payload, length, root)
            request.valid <- request.root.valid and request.root.length <= SourcePaths::PATH_COMPONENT_CAPACITY
            request.has_root <- request.root.valid
            return request

        def client_options_default() -> ClientOptions:
            return ClientOptions{valid: true, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false}

        def client_options_parse(payload: u8&, length: usize) -> ClientOptions:
            coordinates: mutable ClientOptions = client_options_default()
            root_start: mutable usize = 0
            while root_start < length and is_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 0)
            return coordinates if arguments == NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return ClientOptions{valid: false, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false} if object_field_value_start(payload, length, root_start, DapFields::ARGUMENTS, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            return ClientOptions{valid: false, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false} if arguments >= length or payload[arguments] != Character::DAP_PAYLOAD_CHARACTER_ASCII_BRACE_OPEN
            lines: usize = object_field_value_start(payload, length, arguments, DapFields::LINES_START_AT_ONE, 0)
            return ClientOptions{valid: false, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false} if object_field_value_start(payload, length, arguments, DapFields::LINES_START_AT_ONE, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            if lines != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                line_value: ParsedValue = parse_json_boolean(payload, length, lines)
                return ClientOptions{valid: false, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false} if not line_value.valid
                coordinates.lines_start_at_one <- line_value.value != 0
            columns: usize = object_field_value_start(payload, length, arguments, DapFields::COLUMNS_START_AT_ONE, 0)
            return ClientOptions{valid: false, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false} if object_field_value_start(payload, length, arguments, DapFields::COLUMNS_START_AT_ONE, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            if columns != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                column_value: ParsedValue = parse_json_boolean(payload, length, columns)
                return ClientOptions{valid: false, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false} if not column_value.valid
                coordinates.columns_start_at_one <- column_value.value != 0
            supports_variable_type: usize = object_field_value_start(payload, length, arguments, DapFields::SUPPORTS_VARIABLE_TYPE, 0)
            return ClientOptions{valid: false, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false} if object_field_value_start(payload, length, arguments, DapFields::SUPPORTS_VARIABLE_TYPE, 1) != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX
            if supports_variable_type != NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX:
                type_value: ParsedValue = parse_json_boolean(payload, length, supports_variable_type)
                return ClientOptions{valid: false, lines_start_at_one: true, columns_start_at_one: true, supports_variable_type: false} if not type_value.valid
                coordinates.supports_variable_type <- type_value.value != 0
            return coordinates
