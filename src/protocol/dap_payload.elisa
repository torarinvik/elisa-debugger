        const module SourcePaths:
            NO_SOURCE_REFERENCE: u64 = 0
            DAP_PATH_COMPONENT_CAPACITY: usize = DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
            PROGRAM_PATH_CAPACITY: usize = DebuggerMetadataSourcePath::MAPPED_SOURCE_PATH_CAPACITY
            DAP_SOURCE_BREAKPOINT_LIMIT: usize = 256

        const module Unicode:
            UNICODE_HEX_DIGITS: usize = 4
            UNICODE_SURROGATE_HIGH_START: u64 = 55296
            UNICODE_SURROGATE_HIGH_END: u64 = 56319
            UNICODE_SURROGATE_LOW_START: u64 = 56320
            UNICODE_SURROGATE_LOW_END: u64 = 57343
