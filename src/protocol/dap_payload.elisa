            DAP_PAYLOAD_UTF8_THREE_BYTE_END: u64 = 239
            DAP_PAYLOAD_UTF8_FOUR_BYTE_START: u64 = 240
            DAP_PAYLOAD_UTF8_FOUR_BYTE_END: u64 = 244
            DAP_PAYLOAD_UTF8_CONTINUATION_MIN: u64 = 128
            DAP_PAYLOAD_UTF8_CONTINUATION_MAX: u64 = 191
            DAP_PAYLOAD_UTF8_TWO_BYTE_MIN_CODEPOINT: u64 = 128
            DAP_PAYLOAD_UTF8_THREE_BYTE_MIN_CODEPOINT: u64 = 2048
            DAP_PAYLOAD_UTF8_FOUR_BYTE_MIN_CODEPOINT: u64 = 65536
            DAP_PAYLOAD_UTF8_TWO_BYTE_LENGTH: usize = 2
            DAP_PAYLOAD_UTF8_THREE_BYTE_LENGTH: usize = 3
            DAP_PAYLOAD_UTF8_FOUR_BYTE_LENGTH: usize = 4

        struct ParsedValue:
            valid: mutable bool
            value: mutable u64
            end: mutable usize

        def invalid_value() -> ParsedValue:
            return ParsedValue{valid: false, value: 0, end: NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_NO_INDEX}

        def is_whitespace(byte: u8) -> bool:
            return byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_SPACE or byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_TAB or byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_LINE_FEED or byte == Character::DAP_PAYLOAD_CHARACTER_ASCII_CARRIAGE_RETURN

        def field_length(field: u8) -> usize:
            return DapFields::SOURCE_REFERENCE_LENGTH if field == DapFields::SOURCE_REFERENCE
            return DapFields::BREAKPOINTS_LENGTH if field == DapFields::BREAKPOINTS
            return DapFields::SOURCE_LENGTH if field == DapFields::SOURCE
            return DapFields::LINE_LENGTH if field == DapFields::LINE
            return DapFields::LINES_LENGTH if field == DapFields::LINES
            return DapFields::COLUMN_LENGTH if field == DapFields::COLUMN
            return DapFields::CONDITION_LENGTH if field == DapFields::CONDITION
            return DapFields::HIT_CONDITION_LENGTH if field == DapFields::HIT_CONDITION
            return DapFields::LOG_MESSAGE_LENGTH if field == DapFields::LOG_MESSAGE
            return DapFields::SOURCE_PATH_LENGTH if field == DapFields::DAP_PAYLOAD_DAPFIELDS_SOURCE_PATH
            return DapFields::SOURCE_PATH_ROOT_LENGTH if field == DapFields::SOURCE_PATH_ROOT
            return DapFields::LINES_START_AT_ONE_LENGTH if field == DapFields::LINES_START_AT_ONE
            return DapFields::COLUMNS_START_AT_ONE_LENGTH if field == DapFields::COLUMNS_START_AT_ONE
            return DapFields::SUPPORTS_VARIABLE_TYPE_LENGTH if field == DapFields::SUPPORTS_VARIABLE_TYPE
            return DapFields::THREAD_ID_LENGTH if field == DapFields::THREAD_ID
            return DapFields::FRAME_ID_LENGTH if field == DapFields::FRAME_ID
            return DapFields::START_FRAME_LENGTH if field == DapFields::START_FRAME
            return DapFields::LEVELS_LENGTH if field == DapFields::LEVELS
            return DapFields::EXPRESSION_LENGTH if field == DapFields::EXPRESSION
            return DapFields::FUNCTION_BREAKPOINTS_LENGTH if field == DapFields::FUNCTION_BREAKPOINTS
            return DapFields::NAME_LENGTH if field == DapFields::NAME
            return DapFields::VARIABLES_REFERENCE_LENGTH if field == DapFields::VARIABLES_REFERENCE
            return DapFields::HOST_EFFECT_REQUEST_ID_LENGTH if field == DapFields::HOST_EFFECT_REQUEST_ID
            return DapFields::HOST_EFFECT_VALUE_HIGH_LENGTH if field == DapFields::HOST_EFFECT_VALUE_HIGH
            return DapFields::HOST_EFFECT_VALUE_LOW_LENGTH if field == DapFields::HOST_EFFECT_VALUE_LOW
            return DapFields::ELISA_VIRTUAL_FILES_LENGTH if field == DapFields::ELISA_VIRTUAL_FILES
            return DapFields::VIRTUAL_FILE_PATH_LENGTH if field == DapFields::VIRTUAL_FILE_PATH
            return DapFields::VIRTUAL_FILE_CONTENTS_HEX_LENGTH if field == DapFields::VIRTUAL_FILE_CONTENTS_HEX
            return DapFields::VIRTUAL_FILE_WRITABLE_LENGTH if field == DapFields::VIRTUAL_FILE_WRITABLE
            return DapFields::START_LENGTH if field == DapFields::START
            return DapFields::ARGUMENTS_LENGTH if field == DapFields::ARGUMENTS
            return DapFields::PROGRAM_LENGTH if field == DapFields::PROGRAM
            return MemoryPayload::REFERENCE_LENGTH if field == DapFields::MEMORY_REFERENCE
            return DapFields::OFFSET_LENGTH if field == DapFields::DAP_PAYLOAD_DAPFIELDS_OFFSET else DapFields::COUNT_LENGTH

        def virtual_file_field_byte(field: u8, position: usize) -> u8:
            if field == DapFields::ELISA_VIRTUAL_FILES:
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_ZERO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_L if position == FieldBytePosition::POSITION_ONE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_I if position == FieldBytePosition::POSITION_TWO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_S if position == FieldBytePosition::POSITION_THREE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_A if position == FieldBytePosition::POSITION_FOUR
                return Character::ASCII_UPPER_V if position == FieldBytePosition::POSITION_FIVE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_I if position == FieldBytePosition::POSITION_SIX
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_R if position == FieldBytePosition::POSITION_SEVEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_T if position == FieldBytePosition::POSITION_EIGHT
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_U if position == FieldBytePosition::POSITION_NINE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_A if position == FieldBytePosition::POSITION_TEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_L if position == FieldBytePosition::POSITION_ELEVEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_UPPER_F if position == FieldBytePosition::POSITION_TWELVE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_I if position == FieldBytePosition::POSITION_THIRTEEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_L if position == FieldBytePosition::POSITION_FOURTEEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_FIFTEEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_S
            if field == DapFields::VIRTUAL_FILE_PATH:
                return Character::ASCII_P if position == FieldBytePosition::POSITION_ZERO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_A if position == FieldBytePosition::POSITION_ONE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_T if position == FieldBytePosition::POSITION_TWO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_H
            if field == DapFields::VIRTUAL_FILE_CONTENTS_HEX:
                return Character::ASCII_C if position == FieldBytePosition::POSITION_ZERO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_O if position == FieldBytePosition::POSITION_ONE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_N if position == FieldBytePosition::POSITION_TWO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_T if position == FieldBytePosition::POSITION_THREE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_FOUR
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_N if position == FieldBytePosition::POSITION_FIVE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_T if position == FieldBytePosition::POSITION_SIX
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_S if position == FieldBytePosition::POSITION_SEVEN
                return Character::ASCII_UPPER_H if position == FieldBytePosition::POSITION_EIGHT
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_NINE
                return Character::ASCII_LOWER_X
            return Character::ASCII_W if position == FieldBytePosition::POSITION_ZERO
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_R if position == FieldBytePosition::POSITION_ONE
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_I if position == FieldBytePosition::POSITION_TWO
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_T if position == FieldBytePosition::POSITION_THREE
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_A if position == FieldBytePosition::POSITION_FOUR
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_B if position == FieldBytePosition::POSITION_FIVE
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_L if position == FieldBytePosition::POSITION_SIX
            return Character::DAP_PAYLOAD_CHARACTER_ASCII_E

        def field_byte(field: u8, position: usize) -> u8:
            return virtual_file_field_byte(field, position) if field == DapFields::ELISA_VIRTUAL_FILES or field == DapFields::VIRTUAL_FILE_PATH or field == DapFields::VIRTUAL_FILE_CONTENTS_HEX or field == DapFields::VIRTUAL_FILE_WRITABLE
            if field == DapFields::HOST_EFFECT_REQUEST_ID:
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_R if position == FieldBytePosition::POSITION_ZERO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_ONE
                return Character::ASCII_Q if position == FieldBytePosition::POSITION_TWO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_U if position == FieldBytePosition::POSITION_THREE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_FOUR
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_S if position == FieldBytePosition::POSITION_FIVE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_T if position == FieldBytePosition::POSITION_SIX
                return Character::ASCII_UPPER_I if position == FieldBytePosition::POSITION_SEVEN
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_D
            if field == DapFields::HOST_EFFECT_VALUE_HIGH:
                return Character::ASCII_LOWER_V if position == FieldBytePosition::POSITION_ZERO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_A if position == FieldBytePosition::POSITION_ONE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_L if position == FieldBytePosition::POSITION_TWO
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_U if position == FieldBytePosition::POSITION_THREE
                return Character::DAP_PAYLOAD_CHARACTER_ASCII_E if position == FieldBytePosition::POSITION_FOUR
                return Character::ASCII_UPPER_H if position == FieldBytePosition::POSITION_FIVE
