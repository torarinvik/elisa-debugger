            UNICODE_LOW_SURROGATE_OFFSET: u64 = 56320
            UNICODE_MAX_CODEPOINT: u64 = 1114111
            UNICODE_CONTROL_MAX: u64 = 31
            UNICODE_TWO_BYTE_MAX_EXCLUSIVE: u64 = 2048
            UNICODE_THREE_BYTE_MAX_EXCLUSIVE: u64 = 65536
            UNICODE_SURROGATE_RANGE_START: u64 = 55296
            UNICODE_SURROGATE_RANGE_END: u64 = 57343

        const module Utf8:
            UTF8_CONTINUATION_BASE: u64 = 128
            UTF8_TWO_BYTE_BASE: u64 = 192
            UTF8_THREE_BYTE_BASE: u64 = 224
            UTF8_FOUR_BYTE_BASE: u64 = 240
            UTF8_CONTINUATION_MASK: u64 = 63
            UTF8_FIRST_TWO_MASK: u64 = 31
            UTF8_FIRST_THREE_MASK: u64 = 15
            UTF8_FIRST_FOUR_MASK: u64 = 7
            UTF8_SHIFT: u64 = 6
