            NO_TARGET: u64 = 0
            MAX_TARGET: u64 = NumberFormat::DAP_PAYLOAD_NUMBERFORMAT_MAX_U64
            QUOTE_WIDTH: usize = 1
            DIGIT_INCREMENT: usize = 1

        const module BreakpointCondition:
            MAX_EXPRESSION_BYTES: usize = DebuggerExpressionLimits::Source::MAX_EXPRESSION_BYTES
            EMPTY_EXPRESSION_LENGTH: usize = 0
            BYTE_INCREMENT: usize = 1
            QUOTE_WIDTH: usize = 1
            TWO_QUOTE_WIDTH: usize = QUOTE_WIDTH + QUOTE_WIDTH
            ESCAPED_BYTE_WIDTH: usize = 2
            ESCAPE_BACKSPACE: u8 = 8
            ESCAPE_FORM_FEED: u8 = 12
            ESCAPE_LINE_FEED: u8 = 10
            ESCAPE_CARRIAGE_RETURN: u8 = 13
            ESCAPE_TAB: u8 = 9
            ASCII_SPACE: u8 = 32
            ASCII_ONLY_MAX: u64 = 127

        const module BreakpointLog:
            MAX_MESSAGE_BYTES: usize = DebuggerExpressionLimits::Source::MAX_LOG_MESSAGE_BYTES
            EMPTY_MESSAGE_LENGTH: usize = 0

        const module BreakpointText:
            MAX_REQUEST_TEXT_BYTES: usize = 8192
            FIRST_TEXT_BYTE: usize = 0

        const module FunctionBreakpointParsing:
            FIRST_REQUEST_INDEX: usize = 0
            FIRST_PROPERTY_OCCURRENCE: usize = 0
            DUPLICATE_PROPERTY_OCCURRENCE: usize = 1
            NO_TEXT_BYTES: usize = 0
            NO_HIT_TARGET: u64 = 0
            BYTE_INCREMENT: usize = 1
            MAX_NAME_BYTES: usize = DebuggerEDIRCapacity::EDIR_FUNCTION_NAME_CAPACITY

        const module Unicode:
            HEX_DIGITS: usize = 4
            DAP_PAYLOAD_UNICODE_SURROGATE_HIGH_START: u64 = 55296
            DAP_PAYLOAD_UNICODE_SURROGATE_HIGH_END: u64 = 56319
            DAP_PAYLOAD_UNICODE_SURROGATE_LOW_START: u64 = 56320
            DAP_PAYLOAD_UNICODE_SURROGATE_LOW_END: u64 = 57343
            DAP_PAYLOAD_UNICODE_SURROGATE_BASE: u64 = 65536
            DAP_PAYLOAD_UNICODE_SURROGATE_SHIFT: u64 = 10
            DAP_PAYLOAD_UNICODE_HIGH_SURROGATE_OFFSET: u64 = 55296
            DAP_PAYLOAD_UNICODE_LOW_SURROGATE_OFFSET: u64 = 56320
            DAP_PAYLOAD_UNICODE_MAX_CODEPOINT: u64 = 1114111
            DAP_PAYLOAD_UNICODE_CONTROL_MAX: u64 = 31
            DAP_PAYLOAD_UNICODE_TWO_BYTE_MAX_EXCLUSIVE: u64 = 2048
            DAP_PAYLOAD_UNICODE_THREE_BYTE_MAX_EXCLUSIVE: u64 = 65536
            SURROGATE_RANGE_START: u64 = 55296
            SURROGATE_RANGE_END: u64 = 57343

        const module Utf8:
            DAP_PAYLOAD_UTF8_CONTINUATION_BASE: u64 = 128
            DAP_PAYLOAD_UTF8_TWO_BYTE_BASE: u64 = 192
            DAP_PAYLOAD_UTF8_THREE_BYTE_BASE: u64 = 224
