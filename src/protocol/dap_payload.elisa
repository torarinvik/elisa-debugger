            UTF8_TWO_BYTE_END: u64 = 223
            UTF8_THREE_BYTE_START: u64 = 224
            UTF8_THREE_BYTE_END: u64 = 239
            UTF8_FOUR_BYTE_START: u64 = 240
            UTF8_FOUR_BYTE_END: u64 = 244
            UTF8_CONTINUATION_MIN: u64 = 128
            UTF8_CONTINUATION_MAX: u64 = 191
            UTF8_TWO_BYTE_MIN_CODEPOINT: u64 = 128
            UTF8_THREE_BYTE_MIN_CODEPOINT: u64 = 2048
            UTF8_FOUR_BYTE_MIN_CODEPOINT: u64 = 65536
            UTF8_TWO_BYTE_LENGTH: usize = 2
            UTF8_THREE_BYTE_LENGTH: usize = 3
            UTF8_FOUR_BYTE_LENGTH: usize = 4

        struct ParsedValue:
            valid: mutable bool
            value: mutable u64
            end: mutable usize

        def invalid_value() -> ParsedValue:
            return ParsedValue{valid: false, value: 0, end: NumberFormat::PROTOCOL_DAP_PAYLOAD_NUMBER_FORMAT_NO_INDEX}

        def is_whitespace(byte: u8) -> bool:
            return byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_SPACE or byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_TAB or byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_LINE_FEED or byte == Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_CARRIAGE_RETURN

        def field_length(field: u8) -> usize:
            return DapFields::SOURCE_REFERENCE_FIELD_LENGTH if field == DapFields::SOURCE_REFERENCE_FIELD
            return DapFields::BREAKPOINTS_FIELD_LENGTH if field == DapFields::BREAKPOINTS_FIELD
            return DapFields::SOURCE_FIELD_LENGTH if field == DapFields::SOURCE_FIELD
            return DapFields::LINE_FIELD_LENGTH if field == DapFields::LINE_FIELD
            return DapFields::LINES_FIELD_LENGTH if field == DapFields::LINES_FIELD
            return DapFields::COLUMN_FIELD_LENGTH if field == DapFields::COLUMN_FIELD
            return DapFields::CONDITION_FIELD_LENGTH if field == DapFields::CONDITION_FIELD
            return DapFields::HIT_CONDITION_FIELD_LENGTH if field == DapFields::HIT_CONDITION_FIELD
            return DapFields::LOG_MESSAGE_FIELD_LENGTH if field == DapFields::LOG_MESSAGE_FIELD
            return DapFields::SOURCE_PATH_FIELD_LENGTH if field == DapFields::SOURCE_PATH_FIELD
            return DapFields::SOURCE_PATH_ROOT_FIELD_LENGTH if field == DapFields::SOURCE_PATH_ROOT_FIELD
            return DapFields::LINES_START_AT_ONE_FIELD_LENGTH if field == DapFields::LINES_START_AT_ONE_FIELD
            return DapFields::COLUMNS_START_AT_ONE_FIELD_LENGTH if field == DapFields::COLUMNS_START_AT_ONE_FIELD
            return DapFields::THREAD_ID_FIELD_LENGTH if field == DapFields::THREAD_ID_FIELD
            return DapFields::FRAME_ID_FIELD_LENGTH if field == DapFields::FRAME_ID_FIELD
            return DapFields::VARIABLES_REFERENCE_FIELD_LENGTH if field == DapFields::VARIABLES_REFERENCE_FIELD
            return DapFields::START_FIELD_LENGTH if field == DapFields::START_FIELD
            return DapFields::ARGUMENTS_FIELD_LENGTH if field == DapFields::ARGUMENTS_FIELD
            return DapFields::PROGRAM_FIELD_LENGTH if field == DapFields::PROGRAM_FIELD
            return MemoryPayload::MEMORY_REFERENCE_LENGTH if field == DapFields::MEMORY_REFERENCE_FIELD
            return DapFields::OFFSET_LENGTH if field == DapFields::OFFSET_FIELD else DapFields::COUNT_LENGTH

        def field_byte(field: u8, position: usize) -> u8:
            if field == DapFields::SOURCE_FIELD:
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_S if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_O if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_U if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_R if position == 3
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_C if position == 4
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_E
            if field == DapFields::SOURCE_PATH_FIELD:
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_P if position == 0
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_A if position == 1
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_T if position == 2
                return Character::PROTOCOL_DAP_PAYLOAD_CHARACTER_ASCII_H
