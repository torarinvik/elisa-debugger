            JSON_FALSE_LENGTH: usize = 5
            MAX_JSON_NESTING: usize = 64
            JSON_ROOT_DELIMITER_INDEX: usize = 0
            JSON_INITIAL_NESTING_DEPTH: usize = 1
            JSON_EMPTY_NESTING_DEPTH: usize = 0

