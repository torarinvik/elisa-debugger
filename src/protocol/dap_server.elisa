                if (container == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_OPEN and byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_CLOSE) or (container == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACKET_OPEN and byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACKET_CLOSE):
                    decoder_json_close_container(decoder, container)
