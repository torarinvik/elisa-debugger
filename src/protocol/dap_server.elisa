                if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_DOT:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_DOT
                    return true
                if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_E or byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_UPPER_E:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_EXPONENT
                    return true
                return false
            if decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_INTEGER:
                if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE:
                    return true
                if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_DOT:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_DOT
                    return true
                if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_E or byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_UPPER_E:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_EXPONENT
                    return true
                return false
            if decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_DOT:
                return false if byte < Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO or byte > Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE
                decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_FRACTION
                return true
            if decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_FRACTION:
                if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE:
                    return true
                if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_E or byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_UPPER_E:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_EXPONENT
                    return true
                return false
            if decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_EXPONENT:
                if byte == Character::ASCII_HYPHEN or byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_PLUS:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_EXPONENT_SIGN
                    return true
                if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_EXPONENT_DIGITS
                    return true
                return false
            if decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_EXPONENT_SIGN:
                return false if byte < Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO or byte > Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE
                decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_EXPONENT_DIGITS
                return true
            if decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_EXPONENT_DIGITS:
                return byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE
            return false

        def decoder_json_primitive_is_complete(decoder: Decoder) -> bool:
            return false if not decoder.json_primitive_valid
            if decoder.json_primitive_kind != JsonWire::JSON_PRIMITIVE_NUMBER:
                return decoder.json_primitive_literal_position == json_primitive_literal_length(decoder.json_primitive_kind)
            return decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_ZERO or decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_INTEGER or decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_FRACTION or decoder.json_primitive_number_state == JsonWire::JSON_NUMBER_EXPONENT_DIGITS

        def decoder_json_top_level_field_context(decoder: mutable Decoder&, prefix_position: u8, final_position: u8, byte: u8) -> bool:
            return false if decoder.json_nesting_count != 1
            return true if decoder.json_string_is_key
            return prefix_position == final_position and byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE

        def header_prefix_matches(position: u8, byte: u8) -> bool:
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_UPPER_C if position == 0
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_O if position == 1
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_N if position == 2
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_T if position == 3
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_E if position == 4
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_N if position == 5
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_T if position == 6
            return byte == Character::ASCII_HYPHEN if position == 7
            return byte == Character::ASCII_UPPER_L if position == 8
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_E if position == 9
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_N if position == 10
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_G if position == 11
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_T if position == 12
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_H if position == 13
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_COLON if position == 14
            return false

        def decoder_json_fail(decoder: mutable Decoder&) -> void:
            decoder.json_structural_invalid <- true
            decoder_fail(decoder)

        def decoder_json_close_container(decoder: mutable Decoder&, expected: u8) -> void:
            if decoder.json_nesting_count == 0 or decoder.json_nesting[decoder.json_nesting_count - 1] != expected:
                decoder_json_fail(decoder)
                return
            decoder.json_object_depth <- decoder.json_object_depth - 1 if expected == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_OPEN
            decoder.json_array_depth <- decoder.json_array_depth - 1 if expected == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACKET_OPEN
            decoder.json_nesting_count <- decoder.json_nesting_count - 1
            if decoder.json_nesting_count == 0:
                decoder.json_root_state <- JsonWire::PROTOCOL_DAP_SERVER_JSON_WIRE_JSON_STATE_ROOT_DONE
                decoder.json_closed <- true
            else:
                decoder.json_states[decoder.json_nesting_count - 1] <- JsonWire::PROTOCOL_DAP_SERVER_JSON_WIRE_JSON_STATE_COMMA_OR_END

        def decoder_json_accept_payload_byte(decoder: mutable Decoder&, byte: u8) -> void:
            return if decoder.json_structural_invalid
            if decoder.json_in_string:
                if decoder.json_unicode_digits > 0:
