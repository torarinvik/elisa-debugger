                if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_COMMA:
                    decoder.json_states[decoder.json_nesting_count - 1] <- JsonWire::JSON_STATE_OBJECT_KEY_REQUIRED if container == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_OPEN else JsonWire::PROTOCOL_DAP_SERVER_JSON_WIRE_JSON_STATE_VALUE
                    return
                decoder_json_fail(decoder)
