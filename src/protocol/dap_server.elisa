                if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_ZERO
                    return true
                if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ONE and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE:
                    decoder.json_primitive_number_state <- JsonWire::JSON_NUMBER_INTEGER
                    return true
                return false
