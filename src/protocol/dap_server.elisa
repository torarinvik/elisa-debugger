                decoder.json_string_is_key <- false if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE
                decoder.json_utf8_continuations_remaining <- 0 if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE
