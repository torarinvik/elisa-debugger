            DAP_SOURCE_BREAKPOINT_LINE_PREFIX: cstr = ",\"line\":"
            DAP_SOURCE_BREAKPOINT_LINE_PREFIX_LENGTH: usize = 8
            DAP_SOURCE_BREAKPOINT_COLUMN_PREFIX: cstr = ",\"column\":"
            DAP_SOURCE_BREAKPOINT_COLUMN_PREFIX_LENGTH: usize = 10
            DAP_SOURCE_BREAKPOINT_ITEM_SUFFIX: cstr = "}"
            DAP_SOURCE_BREAKPOINT_ITEM_SUFFIX_LENGTH: usize = 1
            DAP_SOURCE_BREAKPOINT_SEPARATOR_LENGTH: usize = 1
            DAP_SOURCE_BREAKPOINT_INVALID_SUFFIX: cstr = "\",\"success\":false,\"message\":\"source path/reference or breakpoint lines are invalid\"}"
            DAP_SOURCE_BREAKPOINT_INVALID_SUFFIX_LENGTH: usize = 84
            DAP_SOURCE_BREAKPOINT_RESOURCE_SUFFIX: cstr = "\",\"success\":false,\"message\":\"source breakpoint capacity is exhausted\"}"
            DAP_SOURCE_BREAKPOINT_RESOURCE_SUFFIX_LENGTH: usize = 70

