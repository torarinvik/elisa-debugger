                        else:
                            if byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_SLASH and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_B and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_F and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_N and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_R and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_T:
