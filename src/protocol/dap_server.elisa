            length: mutable usize

        struct Decoder:
            state: mutable u8
            header_tail: mutable u8
            content_length: mutable usize
            header_digits: mutable usize
            payload_received: mutable usize
            command_prefix_position: mutable u8
            in_command: mutable bool
            command_escaped: mutable bool
            command_seen: mutable bool
            command_hash: mutable u64
            command_value_start: mutable usize
            command_value_end: mutable usize
            type_prefix_position: mutable u8
            in_type: mutable bool
            type_escaped: mutable bool
            type_seen: mutable bool
            type_value_start: mutable usize
            type_value_end: mutable usize
            sequence_prefix_position: mutable u8
            in_sequence: mutable bool
            sequence_seen: mutable bool
            request_sequence: mutable u64
            sequence_digits: mutable usize
            header_prefix_position: mutable u8
            json_has_content: mutable bool
            json_first: mutable u8
            json_last: mutable u8
            json_object_depth: mutable usize
            json_array_depth: mutable usize
            json_nesting: mutable u8[JSON_NESTING_CAPACITY]
            json_states: mutable u8[JSON_NESTING_CAPACITY]
            json_nesting_count: mutable usize
            json_in_string: mutable bool
            json_string_is_key: mutable bool
            json_escaped: mutable bool
            json_unicode_digits: mutable u8
            json_in_primitive: mutable bool
            json_primitive_kind: mutable u8
            json_primitive_number_state: mutable u8
            json_primitive_literal_position: mutable u8
            json_primitive_valid: mutable bool
            json_root_state: mutable u8
            json_closed: mutable bool
            json_structural_invalid: mutable bool
            payload: mutable u8[MAX_DAP_PAYLOAD]
            last_payload_length: mutable usize

        def decoder_new() -> Decoder:
            decoder: Decoder = zeroed
            return decoder

        def command_prefix_matches(position: u8, byte: u8) -> bool:
            return byte == ASCII_QUOTE if position == 0
            return byte == ASCII_C if position == 1
            return byte == ASCII_O if position == 2
            return byte == ASCII_M if position == 3
            return byte == ASCII_M if position == 4
            return byte == ASCII_A if position == 5
            return byte == ASCII_N if position == 6
            return byte == ASCII_D if position == 7
            return byte == ASCII_QUOTE if position == 8
            return byte == ASCII_COLON if position == 9
            return byte == ASCII_QUOTE if position == COMMAND_PREFIX_FINAL_POSITION
            return false

        def sequence_prefix_matches(position: u8, byte: u8) -> bool:
            return byte == ASCII_QUOTE if position == 0
            return byte == ASCII_S if position == 1
            return byte == ASCII_E if position == 2
            return byte == ASCII_Q if position == 3
            return byte == ASCII_QUOTE if position == 4
            return byte == ASCII_COLON if position == SEQUENCE_PREFIX_FINAL_POSITION
            return false

        def type_prefix_matches(position: u8, byte: u8) -> bool:
            return byte == ASCII_QUOTE if position == 0
            return byte == ASCII_T if position == 1
            return byte == ASCII_Y if position == 2
            return byte == ASCII_P if position == 3
            return byte == ASCII_E if position == 4
            return byte == ASCII_QUOTE if position == 5
            return byte == ASCII_COLON if position == 6
            return byte == ASCII_QUOTE if position == TYPE_PREFIX_FINAL_POSITION
            return false

        def is_json_whitespace(byte: u8) -> bool:
            return byte == ASCII_SPACE or byte == ASCII_TAB or byte == ASCII_LF or byte == ASCII_CR

        def is_json_hex_digit(byte: u8) -> bool:
            return true if byte >= ASCII_ZERO and byte <= ASCII_NINE
            return true if byte >= ASCII_A and byte <= ASCII_F
            return byte >= ASCII_UPPER_A and byte <= ASCII_UPPER_F

        def json_hex_digit_value(byte: u8) -> u64:
            if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                return (byte - ASCII_ZERO).u64()
            if byte >= ASCII_A and byte <= ASCII_F:
                return (byte - ASCII_A).u64() + JSON_HEX_ALPHA_BASE
            return (byte - ASCII_UPPER_A).u64() + JSON_HEX_ALPHA_BASE

        def decode_json_string(payload: u8&, start: usize, end: usize) -> DecodedJSONString:
            decoded: mutable DecodedJSONString = zeroed
            decoded.valid <- true
            decoded.ascii_only <- true
            index: mutable usize = start
            while index < end:
                character: mutable u8 = payload[index]
                if character == ASCII_BACKSLASH:
                    index <- index + 1
                    return DecodedJSONString{valid: false, ascii_only: false, hash: 0, length: 0} if index >= end
                    escape: u8 = payload[index]
                    if escape == ASCII_U:
                        return DecodedJSONString{valid: false, ascii_only: false, hash: 0, length: 0} if end - index <= JSON_UNICODE_ESCAPE_DIGITS
                        codepoint: mutable u64 = 0
                        hex_index: mutable usize = 0
                        while hex_index < JSON_UNICODE_ESCAPE_DIGITS:
                            digit_byte: u8 = payload[index + 1 + hex_index]
                            return DecodedJSONString{valid: false, ascii_only: false, hash: 0, length: 0} if not is_json_hex_digit(digit_byte)
                            codepoint <- codepoint * JSON_HEX_BASE + json_hex_digit_value(digit_byte)
                            hex_index <- hex_index + 1
                        if codepoint <= JSON_ASCII_MAX.u64():
                            character <- codepoint.u8()
                        else:
                            decoded.ascii_only <- false
                        index <- index + JSON_UNICODE_ESCAPE_DIGITS + 1
                    else:
                        if escape == ASCII_QUOTE:
                            character <- ASCII_QUOTE
                        else:
                            if escape == ASCII_BACKSLASH:
                                character <- ASCII_BACKSLASH
                            else:
                                if escape == ASCII_SLASH:
                                    character <- ASCII_SLASH
                                else:
                                    if escape == ASCII_B:
                                        character <- ASCII_BACKSPACE
                                    else:
                                        if escape == ASCII_F:
                                            character <- ASCII_FORM_FEED
                                        else:
                                            if escape == ASCII_N:
                                                character <- ASCII_LF
                                            else:
                                                if escape == ASCII_R:
                                                    character <- ASCII_CR
                                                else:
                                                    if escape == ASCII_T:
                                                        character <- ASCII_TAB
                                                    else:
                                                        return DecodedJSONString{valid: false, ascii_only: false, hash: 0, length: 0}
                        index <- index + 1
                else:
                    decoded.ascii_only <- false if character > JSON_ASCII_MAX
                    index <- index + 1
                if decoded.ascii_only and decoded.length < MAX_KNOWN_DAP_COMMAND_LENGTH:
                    decoded.hash <- decoded.hash * DAP_HASH_MULTIPLIER + character.u64()
                decoded.length <- decoded.length + 1
            decoded.hash <- 0 if not decoded.ascii_only or decoded.length > MAX_KNOWN_DAP_COMMAND_LENGTH
            return decoded

        # Hashes accelerate dispatch, but exact decoded spelling decides the
        # command. This also recognizes valid JSON Unicode escapes for ASCII
        # command characters while preventing rolling-hash collisions.
        def dap_json_string_matches_ascii(payload: u8&, start: usize, end: usize, expected: cstr, expected_length: usize) -> bool:
            cursor: mutable usize = start
            expected_index: mutable usize = 0
            while cursor < end:
                character: mutable u64 = 0
                if payload[cursor] == ASCII_BACKSLASH:
                    cursor <- cursor + 1
                    return false if cursor >= end or payload[cursor] != ASCII_U
                    return false if end - cursor < JSON_UNICODE_ESCAPE_DIGITS + JSON_UNICODE_ESCAPE_MARKER_BYTES
                    for offset in JSON_UNICODE_ESCAPE_MARKER_BYTES..<(JSON_UNICODE_ESCAPE_DIGITS + JSON_UNICODE_ESCAPE_MARKER_BYTES):
                        digit: u8 = payload[cursor + offset]
                        return false if not is_json_hex_digit(digit)
                        character <- character * JSON_HEX_BASE + json_hex_digit_value(digit)
                    cursor <- cursor + JSON_UNICODE_ESCAPE_DIGITS + JSON_UNICODE_ESCAPE_MARKER_BYTES
                else:
                    character <- payload[cursor].u64()
                    cursor <- cursor + 1
                return false if expected_index >= expected_length
                return false if character > JSON_ASCII_MAX.u64()
                return false if character != expected[expected_index].u64()
                expected_index <- expected_index + 1
            return expected_index == expected_length

        def exact_dap_command_hash(payload: u8&, start: usize, end: usize, candidate_hash: u64) -> u64:
            return COMMAND_HASH_INITIALIZE if candidate_hash == COMMAND_HASH_INITIALIZE and dap_json_string_matches_ascii(payload, start, end, DAP_INIT_COMMAND, DAP_INIT_COMMAND_LENGTH)
            return COMMAND_HASH_LAUNCH if candidate_hash == COMMAND_HASH_LAUNCH and dap_json_string_matches_ascii(payload, start, end, DAP_LAUNCH_COMMAND, DAP_LAUNCH_COMMAND_LENGTH)
            return COMMAND_HASH_CONFIGURATION_DONE if candidate_hash == COMMAND_HASH_CONFIGURATION_DONE and dap_json_string_matches_ascii(payload, start, end, DAP_CONFIGURATION_DONE_COMMAND, DAP_CONFIGURATION_DONE_COMMAND_LENGTH)
            return COMMAND_HASH_CONTINUE if candidate_hash == COMMAND_HASH_CONTINUE and dap_json_string_matches_ascii(payload, start, end, DAP_CONTINUE_COMMAND, DAP_CONTINUE_COMMAND_LENGTH)
            return COMMAND_HASH_NEXT if candidate_hash == COMMAND_HASH_NEXT and dap_json_string_matches_ascii(payload, start, end, DAP_NEXT_COMMAND, DAP_NEXT_COMMAND_LENGTH)
            return COMMAND_HASH_STEP_BACK if candidate_hash == COMMAND_HASH_STEP_BACK and dap_json_string_matches_ascii(payload, start, end, DAP_STEP_BACK_COMMAND, DAP_STEP_BACK_COMMAND_LENGTH)
            return COMMAND_HASH_PAUSE if candidate_hash == COMMAND_HASH_PAUSE and dap_json_string_matches_ascii(payload, start, end, DAP_PAUSE_COMMAND, DAP_PAUSE_COMMAND_LENGTH)
            return COMMAND_HASH_THREADS if candidate_hash == COMMAND_HASH_THREADS and dap_json_string_matches_ascii(payload, start, end, DAP_THREADS_COMMAND, DAP_THREADS_COMMAND_LENGTH)
            return COMMAND_HASH_STACK_TRACE if candidate_hash == COMMAND_HASH_STACK_TRACE and dap_json_string_matches_ascii(payload, start, end, DAP_STACK_TRACE_COMMAND, DAP_STACK_TRACE_COMMAND_LENGTH)
            return COMMAND_HASH_SCOPES if candidate_hash == COMMAND_HASH_SCOPES and dap_json_string_matches_ascii(payload, start, end, DAP_SCOPES_COMMAND, DAP_SCOPES_COMMAND_LENGTH)
            return COMMAND_HASH_VARIABLES if candidate_hash == COMMAND_HASH_VARIABLES and dap_json_string_matches_ascii(payload, start, end, DAP_VARIABLES_COMMAND, DAP_VARIABLES_COMMAND_LENGTH)
            return COMMAND_HASH_EVALUATE if candidate_hash == COMMAND_HASH_EVALUATE and dap_json_string_matches_ascii(payload, start, end, DAP_EVALUATE_COMMAND, DAP_EVALUATE_COMMAND_LENGTH)
            return COMMAND_HASH_SET_BREAKPOINTS if candidate_hash == COMMAND_HASH_SET_BREAKPOINTS and dap_json_string_matches_ascii(payload, start, end, DAP_SET_BREAKPOINTS_COMMAND, DAP_SET_BREAKPOINTS_COMMAND_LENGTH)
            return COMMAND_HASH_SET_FUNCTION_BREAKPOINTS if candidate_hash == COMMAND_HASH_SET_FUNCTION_BREAKPOINTS and dap_json_string_matches_ascii(payload, start, end, DAP_SET_FUNCTION_BREAKPOINTS_COMMAND, DAP_SET_FUNCTION_BREAKPOINTS_COMMAND_LENGTH)
            return COMMAND_HASH_SET_DATA_BREAKPOINTS if candidate_hash == COMMAND_HASH_SET_DATA_BREAKPOINTS and dap_json_string_matches_ascii(payload, start, end, DAP_SET_DATA_BREAKPOINTS_COMMAND, DAP_SET_DATA_BREAKPOINTS_COMMAND_LENGTH)
            return COMMAND_HASH_READ_MEMORY if candidate_hash == COMMAND_HASH_READ_MEMORY and dap_json_string_matches_ascii(payload, start, end, DAP_READ_MEMORY_COMMAND, DAP_READ_MEMORY_COMMAND_LENGTH)
            return COMMAND_HASH_STEP_IN if candidate_hash == COMMAND_HASH_STEP_IN and dap_json_string_matches_ascii(payload, start, end, DAP_STEP_IN_COMMAND, DAP_STEP_IN_COMMAND_LENGTH)
            return COMMAND_HASH_STEP_OUT if candidate_hash == COMMAND_HASH_STEP_OUT and dap_json_string_matches_ascii(payload, start, end, DAP_STEP_OUT_COMMAND, DAP_STEP_OUT_COMMAND_LENGTH)
            return COMMAND_HASH_REVERSE_CONTINUE if candidate_hash == COMMAND_HASH_REVERSE_CONTINUE and dap_json_string_matches_ascii(payload, start, end, DAP_REVERSE_CONTINUE_COMMAND, DAP_REVERSE_CONTINUE_COMMAND_LENGTH)
            return COMMAND_HASH_DISCONNECT if candidate_hash == COMMAND_HASH_DISCONNECT and dap_json_string_matches_ascii(payload, start, end, DAP_DISCONNECT_COMMAND, DAP_DISCONNECT_COMMAND_LENGTH)
            return COMMAND_HASH_TERMINATE if candidate_hash == COMMAND_HASH_TERMINATE and dap_json_string_matches_ascii(payload, start, end, DAP_TERMINATE_COMMAND, DAP_TERMINATE_COMMAND_LENGTH)
            return DAP_UNKNOWN_COMMAND_HASH

        def json_primitive_literal_length(kind: u8) -> u8:
            return 4 if kind == JSON_PRIMITIVE_TRUE or kind == JSON_PRIMITIVE_NULL
            return 5 if kind == JSON_PRIMITIVE_FALSE
            return 0

        def json_primitive_literal_byte(kind: u8, position: u8) -> u8:
            if kind == JSON_PRIMITIVE_TRUE:
                return ASCII_T if position == 0
                return ASCII_R if position == 1
                return ASCII_U if position == 2
                return ASCII_E if position == 3
            if kind == JSON_PRIMITIVE_FALSE:
                return ASCII_F if position == 0
                return ASCII_A if position == 1
                return ASCII_L if position == 2
                return ASCII_S if position == 3
                return ASCII_E if position == 4
            if kind == JSON_PRIMITIVE_NULL:
                return ASCII_N if position == 0
                return ASCII_U if position == 1
                return ASCII_L
            return 0

        def decoder_json_primitive_start(decoder: mutable Decoder&, byte: u8) -> bool:
            decoder.json_primitive_valid <- true
            decoder.json_primitive_literal_position <- 0
            if byte == ASCII_T:
                decoder.json_primitive_kind <- JSON_PRIMITIVE_TRUE
                decoder.json_primitive_literal_position <- 1
                return true
            if byte == ASCII_F:
                decoder.json_primitive_kind <- JSON_PRIMITIVE_FALSE
                decoder.json_primitive_literal_position <- 1
                return true
            if byte == ASCII_N:
                decoder.json_primitive_kind <- JSON_PRIMITIVE_NULL
                decoder.json_primitive_literal_position <- 1
                return true
            if byte == ASCII_HYPHEN:
                decoder.json_primitive_kind <- JSON_PRIMITIVE_NUMBER
                decoder.json_primitive_number_state <- JSON_NUMBER_SIGN
                return true
            if byte == ASCII_ZERO:
                decoder.json_primitive_kind <- JSON_PRIMITIVE_NUMBER
                decoder.json_primitive_number_state <- JSON_NUMBER_ZERO
                return true
            if byte >= ASCII_ONE and byte <= ASCII_NINE:
                decoder.json_primitive_kind <- JSON_PRIMITIVE_NUMBER
                decoder.json_primitive_number_state <- JSON_NUMBER_INTEGER
                return true
            decoder.json_primitive_valid <- false
            return false

        def decoder_json_primitive_continue(decoder: mutable Decoder&, byte: u8) -> bool:
            if decoder.json_primitive_kind != JSON_PRIMITIVE_NUMBER:
                expected_length: u8 = json_primitive_literal_length(decoder.json_primitive_kind)
                return false if decoder.json_primitive_literal_position >= expected_length or byte != json_primitive_literal_byte(decoder.json_primitive_kind, decoder.json_primitive_literal_position)
                decoder.json_primitive_literal_position <- decoder.json_primitive_literal_position + 1
                return true
            if decoder.json_primitive_number_state == JSON_NUMBER_SIGN:
                if byte == ASCII_ZERO:
                    decoder.json_primitive_number_state <- JSON_NUMBER_ZERO
                    return true
                if byte >= ASCII_ONE and byte <= ASCII_NINE:
                    decoder.json_primitive_number_state <- JSON_NUMBER_INTEGER
                    return true
                return false
            if decoder.json_primitive_number_state == JSON_NUMBER_ZERO:
                if byte == ASCII_DOT:
                    decoder.json_primitive_number_state <- JSON_NUMBER_DOT
                    return true
                if byte == ASCII_E or byte == ASCII_UPPER_E:
                    decoder.json_primitive_number_state <- JSON_NUMBER_EXPONENT
                    return true
                return false
            if decoder.json_primitive_number_state == JSON_NUMBER_INTEGER:
                if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                    return true
                if byte == ASCII_DOT:
                    decoder.json_primitive_number_state <- JSON_NUMBER_DOT
                    return true
                if byte == ASCII_E or byte == ASCII_UPPER_E:
                    decoder.json_primitive_number_state <- JSON_NUMBER_EXPONENT
                    return true
                return false
            if decoder.json_primitive_number_state == JSON_NUMBER_DOT:
                return false if byte < ASCII_ZERO or byte > ASCII_NINE
                decoder.json_primitive_number_state <- JSON_NUMBER_FRACTION
                return true
            if decoder.json_primitive_number_state == JSON_NUMBER_FRACTION:
                if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                    return true
                if byte == ASCII_E or byte == ASCII_UPPER_E:
                    decoder.json_primitive_number_state <- JSON_NUMBER_EXPONENT
                    return true
                return false
            if decoder.json_primitive_number_state == JSON_NUMBER_EXPONENT:
                if byte == ASCII_HYPHEN or byte == ASCII_PLUS:
                    decoder.json_primitive_number_state <- JSON_NUMBER_EXPONENT_SIGN
                    return true
                if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                    decoder.json_primitive_number_state <- JSON_NUMBER_EXPONENT_DIGITS
                    return true
                return false
            if decoder.json_primitive_number_state == JSON_NUMBER_EXPONENT_SIGN:
                return false if byte < ASCII_ZERO or byte > ASCII_NINE
                decoder.json_primitive_number_state <- JSON_NUMBER_EXPONENT_DIGITS
                return true
            if decoder.json_primitive_number_state == JSON_NUMBER_EXPONENT_DIGITS:
                return byte >= ASCII_ZERO and byte <= ASCII_NINE
            return false

        def decoder_json_primitive_is_complete(decoder: Decoder) -> bool:
            return false if not decoder.json_primitive_valid
            if decoder.json_primitive_kind != JSON_PRIMITIVE_NUMBER:
                return decoder.json_primitive_literal_position == json_primitive_literal_length(decoder.json_primitive_kind)
            return decoder.json_primitive_number_state == JSON_NUMBER_ZERO or decoder.json_primitive_number_state == JSON_NUMBER_INTEGER or decoder.json_primitive_number_state == JSON_NUMBER_FRACTION or decoder.json_primitive_number_state == JSON_NUMBER_EXPONENT_DIGITS

        def decoder_json_top_level_field_context(decoder: mutable Decoder&, prefix_position: u8, final_position: u8, byte: u8) -> bool:
            return false if decoder.json_nesting_count != 1
            return true if decoder.json_string_is_key
            return prefix_position == final_position and byte == ASCII_QUOTE

        def header_prefix_matches(position: u8, byte: u8) -> bool:
            return byte == ASCII_UPPER_C if position == 0
            return byte == ASCII_O if position == 1
            return byte == ASCII_N if position == 2
            return byte == ASCII_T if position == 3
            return byte == ASCII_E if position == 4
            return byte == ASCII_N if position == 5
            return byte == ASCII_T if position == 6
            return byte == ASCII_HYPHEN if position == 7
            return byte == ASCII_UPPER_L if position == 8
            return byte == ASCII_E if position == 9
            return byte == ASCII_N if position == 10
            return byte == ASCII_G if position == 11
            return byte == ASCII_T if position == 12
            return byte == ASCII_H if position == 13
            return byte == ASCII_COLON if position == 14
            return false

        def decoder_json_fail(decoder: mutable Decoder&) -> void:
            decoder.json_structural_invalid <- true
            decoder_fail(decoder)

        def decoder_json_close_container(decoder: mutable Decoder&, expected: u8) -> void:
            if decoder.json_nesting_count == 0 or decoder.json_nesting[decoder.json_nesting_count - 1] != expected:
                decoder_json_fail(decoder)
                return
            decoder.json_object_depth <- decoder.json_object_depth - 1 if expected == ASCII_BRACE_OPEN
            decoder.json_array_depth <- decoder.json_array_depth - 1 if expected == ASCII_BRACKET_OPEN
            decoder.json_nesting_count <- decoder.json_nesting_count - 1
            if decoder.json_nesting_count == 0:
                decoder.json_root_state <- JSON_STATE_ROOT_DONE
                decoder.json_closed <- true
            else:
                decoder.json_states[decoder.json_nesting_count - 1] <- JSON_STATE_COMMA_OR_END

        def decoder_json_accept_payload_byte(decoder: mutable Decoder&, byte: u8) -> void:
            return if decoder.json_structural_invalid
            if decoder.json_in_string:
                if decoder.json_unicode_digits > 0:
                    if not is_json_hex_digit(byte):
                        decoder_json_fail(decoder)
                        return
                    decoder.json_unicode_digits <- decoder.json_unicode_digits - 1
                else:
                    if decoder.json_escaped:
                        if byte == ASCII_U:
                            decoder.json_unicode_digits <- 4
                        else:
                            if byte != ASCII_QUOTE and byte != ASCII_BACKSLASH and byte != ASCII_SLASH and byte != ASCII_B and byte != ASCII_F and byte != ASCII_N and byte != ASCII_R and byte != ASCII_T:
                                decoder_json_fail(decoder)
                                return
                        decoder.json_escaped <- false
                    else:
                        if byte == ASCII_BACKSLASH:
                            decoder.json_escaped <- true
                        else:
                            if byte == ASCII_QUOTE:
                                decoder.json_in_string <- false
                                if decoder.json_string_is_key:
                                    if decoder.json_nesting_count == 0 or decoder.json_nesting[decoder.json_nesting_count - 1] != ASCII_BRACE_OPEN or decoder.json_states[decoder.json_nesting_count - 1] != JSON_STATE_OBJECT_KEY_OR_END and decoder.json_states[decoder.json_nesting_count - 1] != JSON_STATE_OBJECT_KEY_REQUIRED:
                                        decoder_json_fail(decoder)
                                        return
                                    decoder.json_states[decoder.json_nesting_count - 1] <- JSON_STATE_OBJECT_COLON
                                else:
                                    if decoder.json_nesting_count == 0:
                                        decoder.json_root_state <- JSON_STATE_ROOT_DONE
                                        decoder.json_closed <- true
                                    else:
                                        decoder.json_states[decoder.json_nesting_count - 1] <- JSON_STATE_COMMA_OR_END
                            else:
                                decoder_json_fail(decoder) if byte < ASCII_SPACE
                return
            if decoder.json_in_primitive:
                if is_json_whitespace(byte):
                    if not decoder_json_primitive_is_complete(decoder):
                        decoder_json_fail(decoder)
                        return
                    decoder.json_in_primitive <- false
                    return
                if byte != ASCII_COMMA and byte != ASCII_BRACE_CLOSE and byte != ASCII_BRACKET_CLOSE:
                    if not decoder_json_primitive_continue(decoder, byte):
                        decoder_json_fail(decoder)
                        return
                    return
                if not decoder_json_primitive_is_complete(decoder):
                    decoder_json_fail(decoder)
                    return
                decoder.json_in_primitive <- false
            return if is_json_whitespace(byte)
            if decoder.json_nesting_count == 0:
                if decoder.json_root_state == JSON_STATE_ROOT_DONE:
                    decoder_json_fail(decoder)
                    return
                if byte == ASCII_BRACE_OPEN:
                    if decoder.json_nesting_count >= JSON_NESTING_CAPACITY:
                        decoder_json_fail(decoder)
                        return
                    decoder.json_nesting[decoder.json_nesting_count] <- ASCII_BRACE_OPEN
                    decoder.json_states[decoder.json_nesting_count] <- JSON_STATE_OBJECT_KEY_OR_END
                    decoder.json_nesting_count <- decoder.json_nesting_count + 1
                    decoder.json_object_depth <- decoder.json_object_depth + 1
                    return
                if byte == ASCII_BRACKET_OPEN:
                    if decoder.json_nesting_count >= JSON_NESTING_CAPACITY:
                        decoder_json_fail(decoder)
                        return
                    decoder.json_nesting[decoder.json_nesting_count] <- ASCII_BRACKET_OPEN
                    decoder.json_states[decoder.json_nesting_count] <- JSON_STATE_ARRAY_VALUE_OR_END
                    decoder.json_nesting_count <- decoder.json_nesting_count + 1
                    decoder.json_array_depth <- decoder.json_array_depth + 1
                    return
                if byte == ASCII_COMMA or byte == ASCII_BRACE_CLOSE or byte == ASCII_BRACKET_CLOSE or byte == ASCII_COLON:
                    decoder_json_fail(decoder)
                    return
                decoder.json_in_string <- true if byte == ASCII_QUOTE
                decoder.json_string_is_key <- false if byte == ASCII_QUOTE
                if byte != ASCII_QUOTE:
                    if not decoder_json_primitive_start(decoder, byte):
                        decoder_json_fail(decoder)
                        return
                    decoder.json_in_primitive <- true
                decoder.json_root_state <- JSON_STATE_ROOT_DONE
                decoder.json_closed <- true if byte != ASCII_QUOTE
                return
            state: u8 = decoder.json_states[decoder.json_nesting_count - 1]
            container: u8 = decoder.json_nesting[decoder.json_nesting_count - 1]
            if state == JSON_STATE_OBJECT_KEY_OR_END or state == JSON_STATE_OBJECT_KEY_REQUIRED:
                if container != ASCII_BRACE_OPEN:
                    decoder_json_fail(decoder)
                    return
                if byte == ASCII_BRACE_CLOSE:
                    if state == JSON_STATE_OBJECT_KEY_REQUIRED:
                        decoder_json_fail(decoder)
                        return
                    decoder_json_close_container(decoder, ASCII_BRACE_OPEN)
                    return
                if byte == ASCII_QUOTE:
                    decoder.json_in_string <- true
                    decoder.json_string_is_key <- true
                    return
                decoder_json_fail(decoder)
                return
            if state == JSON_STATE_OBJECT_COLON:
                decoder.json_states[decoder.json_nesting_count - 1] <- JSON_STATE_VALUE if byte == ASCII_COLON
                if byte != ASCII_COLON:
                    decoder_json_fail(decoder)
                    return
                return
            if state == JSON_STATE_COMMA_OR_END:
                if (container == ASCII_BRACE_OPEN and byte == ASCII_BRACE_CLOSE) or (container == ASCII_BRACKET_OPEN and byte == ASCII_BRACKET_CLOSE):
                    decoder_json_close_container(decoder, container)
                    return
                if byte == ASCII_COMMA:
                    decoder.json_states[decoder.json_nesting_count - 1] <- JSON_STATE_OBJECT_KEY_REQUIRED if container == ASCII_BRACE_OPEN else JSON_STATE_VALUE
                    return
                decoder_json_fail(decoder)
                return
            if state == JSON_STATE_ARRAY_VALUE_OR_END and byte == ASCII_BRACKET_CLOSE:
                decoder_json_close_container(decoder, ASCII_BRACKET_OPEN)
                return
            if state != JSON_STATE_VALUE and state != JSON_STATE_ARRAY_VALUE_OR_END:
                decoder_json_fail(decoder)
                return
            if byte == ASCII_BRACE_OPEN:
                if decoder.json_nesting_count >= JSON_NESTING_CAPACITY:
                    decoder_json_fail(decoder)
                    return
                decoder.json_nesting[decoder.json_nesting_count] <- ASCII_BRACE_OPEN
                decoder.json_states[decoder.json_nesting_count] <- JSON_STATE_OBJECT_KEY_OR_END
                decoder.json_nesting_count <- decoder.json_nesting_count + 1
                decoder.json_object_depth <- decoder.json_object_depth + 1
                return
            if byte == ASCII_BRACKET_OPEN:
                if decoder.json_nesting_count >= JSON_NESTING_CAPACITY:
                    decoder_json_fail(decoder)
                    return
                decoder.json_nesting[decoder.json_nesting_count] <- ASCII_BRACKET_OPEN
                decoder.json_states[decoder.json_nesting_count] <- JSON_STATE_ARRAY_VALUE_OR_END
                decoder.json_nesting_count <- decoder.json_nesting_count + 1
                decoder.json_array_depth <- decoder.json_array_depth + 1
                return
            if byte == ASCII_QUOTE:
                decoder.json_in_string <- true
                decoder.json_string_is_key <- false
                return
            if byte == ASCII_COMMA or byte == ASCII_BRACE_CLOSE or byte == ASCII_BRACKET_CLOSE or byte == ASCII_COLON:
                decoder_json_fail(decoder)
                return
            if not decoder_json_primitive_start(decoder, byte):
                decoder_json_fail(decoder)
                return
            decoder.json_in_primitive <- true
            decoder.json_states[decoder.json_nesting_count - 1] <- JSON_STATE_COMMA_OR_END

        def decoder_accept_payload_byte(decoder: mutable Decoder&, byte: u8) -> void:
            decoder_json_accept_payload_byte(decoder, byte)
            return if decoder.state == DECODER_FAILED_STATE
            if byte != ASCII_SPACE and byte != ASCII_TAB and byte != ASCII_LF and byte != ASCII_CR:
                if not decoder.json_has_content:
                    decoder.json_first <- byte
                    decoder.json_has_content <- true
                decoder.json_last <- byte
            command_context: bool = decoder.in_command or decoder_json_top_level_field_context(decoder, decoder.command_prefix_position, COMMAND_PREFIX_FINAL_POSITION, byte)
            if command_context:
                if not decoder.in_command:
                    if command_prefix_matches(decoder.command_prefix_position, byte):
                        decoder.command_prefix_position <- decoder.command_prefix_position + 1
                        if decoder.command_prefix_position == COMMAND_PREFIX_LENGTH:
                            if decoder.command_seen:
                                decoder_fail(decoder)
                                return
                            decoder.in_command <- true
                            decoder.command_escaped <- false
                            decoder.command_hash <- 0
                            decoder.command_value_start <- decoder.payload_received + 1
                    else:
                        if is_json_whitespace(byte) and (decoder.command_prefix_position == COMMAND_PREFIX_LENGTH - 2 or decoder.command_prefix_position == COMMAND_PREFIX_LENGTH - 1):
                            decoder.command_prefix_position <- decoder.command_prefix_position
                        else:
                            decoder.command_prefix_position <- 1 if byte == ASCII_QUOTE else 0
                else:
                    if decoder.command_escaped:
                        decoder.command_escaped <- false
                    else:
                        if byte == ASCII_BACKSLASH:
                            decoder.command_escaped <- true
                        else:
                            if byte == ASCII_QUOTE:
                                decoder.in_command <- false
                                decoder.command_seen <- true
                                decoder.command_value_end <- decoder.payload_received
                                decoded_command: DecodedJSONString = decode_json_string(decoder.payload[0], decoder.command_value_start, decoder.command_value_end)
                                if not decoded_command.valid:
                                    decoder_fail(decoder)
                                    return
                                decoder.command_hash <- exact_dap_command_hash(decoder.payload[0], decoder.command_value_start, decoder.command_value_end, decoded_command.hash)
            else:
                decoder.command_prefix_position <- 0 if not decoder.in_command
            type_context: bool = decoder.in_type or decoder_json_top_level_field_context(decoder, decoder.type_prefix_position, TYPE_PREFIX_FINAL_POSITION, byte)
            if type_context:
                if not decoder.in_type:
                    if type_prefix_matches(decoder.type_prefix_position, byte):
                        decoder.type_prefix_position <- decoder.type_prefix_position + 1
                        if decoder.type_prefix_position == TYPE_PREFIX_LENGTH:
                            if decoder.type_seen:
                                decoder_fail(decoder)
                                return
                            decoder.in_type <- true
                            decoder.type_escaped <- false
                            decoder.type_value_start <- decoder.payload_received + 1
                    else:
                        if is_json_whitespace(byte) and (decoder.type_prefix_position == TYPE_PREFIX_LENGTH - 2 or decoder.type_prefix_position == TYPE_PREFIX_LENGTH - 1):
                            decoder.type_prefix_position <- decoder.type_prefix_position
                        else:
                            decoder.type_prefix_position <- 1 if byte == ASCII_QUOTE else 0
                else:
                    if decoder.type_escaped:
                        decoder.type_escaped <- false
                    else:
                        if byte == ASCII_BACKSLASH:
                            decoder.type_escaped <- true
                        else:
                            if byte == ASCII_QUOTE:
                                decoder.type_value_end <- decoder.payload_received
                                decoded_type: DecodedJSONString = decode_json_string(decoder.payload[0], decoder.type_value_start, decoder.type_value_end)
                                if not decoded_type.valid or not decoded_type.ascii_only or decoded_type.length != TYPE_REQUEST_LENGTH or decoded_type.hash != TYPE_REQUEST_HASH:
                                    decoder_fail(decoder)
                                    return
                                decoder.in_type <- false
                                decoder.type_seen <- true
            else:
                decoder.type_prefix_position <- 0 if not decoder.in_type
            sequence_context: bool = decoder.in_sequence or decoder_json_top_level_field_context(decoder, decoder.sequence_prefix_position, SEQUENCE_PREFIX_FINAL_POSITION, byte)
            if sequence_context:
                if not decoder.in_sequence:
                    if sequence_prefix_matches(decoder.sequence_prefix_position, byte):
                        decoder.sequence_prefix_position <- decoder.sequence_prefix_position + 1
                        if decoder.sequence_prefix_position == SEQUENCE_PREFIX_LENGTH:
                            if decoder.sequence_seen:
                                decoder_fail(decoder)
                                return
                            decoder.in_sequence <- true
                            decoder.request_sequence <- 0
                            decoder.sequence_digits <- 0
                    else:
                        if is_json_whitespace(byte) and decoder.sequence_prefix_position == SEQUENCE_PREFIX_FINAL_POSITION:
                            decoder.sequence_prefix_position <- decoder.sequence_prefix_position
                        else:
                            decoder.sequence_prefix_position <- 1 if byte == ASCII_QUOTE else 0
                else:
                    if is_json_whitespace(byte) and decoder.sequence_digits == 0:
                        decoder.sequence_digits <- 0
                    else:
                        if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                            if decoder.sequence_digits == FIRST_DAP_SEQUENCE_DIGIT_COUNT and decoder.request_sequence == 0:
                                decoder_fail(decoder)
                                return
                            if decoder.sequence_digits >= MAX_DAP_SEQUENCE_DIGITS or decoder.request_sequence > (MAX_DAP_SEQUENCE_VALUE - (byte - ASCII_ZERO).u64()) / DAP_DECIMAL_BASE:
                                decoder_fail(decoder)
                                return
                            decoder.request_sequence <- decoder.request_sequence * DAP_DECIMAL_BASE + (byte - ASCII_ZERO).u64()
                            decoder.sequence_digits <- decoder.sequence_digits + 1
                            decoder.sequence_seen <- true
                        else:
                            if byte != ASCII_COMMA and byte != ASCII_BRACE_CLOSE and byte != ASCII_SPACE and byte != ASCII_TAB and byte != ASCII_LF and byte != ASCII_CR:
                                decoder_fail(decoder)
                                return
                            decoder.in_sequence <- false
            else:
                decoder.sequence_prefix_position <- 0 if not decoder.in_sequence

        def decoder_fail(decoder: mutable Decoder&) -> void:
            decoder.state <- DECODER_FAILED_STATE

        def decoder_accept(decoder: mutable Decoder&, byte: u8) -> bool:
            return false if decoder.state == DECODER_FAILED_STATE
            if decoder.state == DECODER_HEADER_STATE:
                if decoder.header_prefix_position < HEADER_PREFIX_LENGTH:
                    if not header_prefix_matches(decoder.header_prefix_position, byte):
                        decoder_fail(decoder)
                        return false
                    decoder.header_prefix_position <- decoder.header_prefix_position + 1
                    return false
                if decoder.header_tail == HEADER_TAIL_NONE:
                    if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                        if decoder.header_digits >= MAX_DAP_HEADER_DIGITS:
                            decoder_fail(decoder)
                            return false
                        digit: usize = (byte - ASCII_ZERO).usize()
                        if decoder.content_length > (MAX_DAP_PAYLOAD - digit) / DAP_DECIMAL_BASE.usize():
                            decoder_fail(decoder)
                            return false
                        decoder.content_length <- decoder.content_length * DAP_DECIMAL_BASE.usize() + digit
                        decoder.header_digits <- decoder.header_digits + 1
                        return false
                    if byte == ASCII_SPACE:
                        return false
                    if byte == ASCII_CR:
                        return false if decoder.header_digits == 0
                        decoder.header_tail <- HEADER_TAIL_CR
                        return false
                    decoder_fail(decoder)
                    return false
                if decoder.header_tail == HEADER_TAIL_CR:
                    if byte == ASCII_LF:
                        decoder.header_tail <- HEADER_TAIL_CRLF
                        return false
                    decoder_fail(decoder)
                    return false
                if decoder.header_tail == HEADER_TAIL_CRLF:
                    if byte == ASCII_CR:
                        decoder.header_tail <- HEADER_TAIL_CRLFCR
                        return false
                    decoder_fail(decoder)
                    return false
                if byte == ASCII_LF and decoder.header_digits > 0 and decoder.content_length > 0:
                    decoder.state <- DECODER_PAYLOAD_STATE
                    decoder.payload_received <- 0
                    decoder.header_tail <- HEADER_TAIL_NONE
                    return false
                decoder_fail(decoder)
                return false
            if decoder.state == DECODER_PAYLOAD_STATE:
                if decoder.payload_received >= MAX_DAP_PAYLOAD:
                    decoder_fail(decoder)
                    return false
                decoder.payload[decoder.payload_received] <- byte
                decoder_accept_payload_byte(decoder, byte)
                return false if decoder.state == DECODER_FAILED_STATE
                decoder.payload_received <- decoder.payload_received + 1
                if decoder.payload_received == decoder.content_length:
                    if not decoder.command_seen or not decoder.type_seen or not decoder.sequence_seen or decoder.request_sequence < DAP_MIN_REQUEST_SEQUENCE or decoder.in_command or decoder.in_type or decoder.in_sequence or not decoder.json_has_content or decoder.json_first != ASCII_BRACE_OPEN or decoder.json_last != ASCII_BRACE_CLOSE or decoder.json_object_depth != 0 or decoder.json_array_depth != 0 or decoder.json_nesting_count != 0 or decoder.json_in_string or decoder.json_escaped or decoder.json_unicode_digits != 0 or decoder.json_in_primitive or not decoder.json_closed or decoder.json_structural_invalid:
                        decoder_fail(decoder)
                        return false
                    decoder.last_payload_length <- decoder.content_length
                    decoder.state <- DECODER_HEADER_STATE
                    decoder.header_tail <- HEADER_TAIL_NONE
                    decoder.content_length <- 0
                    decoder.header_digits <- 0
                    decoder.header_prefix_position <- 0
                    decoder.payload_received <- 0
                    decoder.command_prefix_position <- 0
                    decoder.in_command <- false
                    decoder.command_escaped <- false
                    decoder.command_seen <- false
                    decoder.type_prefix_position <- 0
                    decoder.in_type <- false
                    decoder.type_escaped <- false
                    decoder.type_seen <- false
                    decoder.sequence_prefix_position <- 0
                    decoder.in_sequence <- false
                    decoder.sequence_seen <- false
                    decoder.json_has_content <- false
                    decoder.json_first <- 0
                    decoder.json_last <- 0
                    decoder.json_object_depth <- 0
                    decoder.json_array_depth <- 0
                    decoder.json_nesting_count <- 0
                    decoder.json_in_string <- false
                    decoder.json_string_is_key <- false
                    decoder.json_escaped <- false
                    decoder.json_unicode_digits <- 0
                    decoder.json_in_primitive <- false
                    decoder.json_primitive_kind <- 0
                    decoder.json_primitive_number_state <- 0
                    decoder.json_primitive_literal_position <- 0
                    decoder.json_primitive_valid <- false
                    decoder.json_root_state <- JSON_STATE_ROOT_VALUE
                    decoder.json_closed <- false
                    decoder.json_structural_invalid <- false
                    return true
                return false
            decoder_fail(decoder)
            return false

        def decimal_digits(value: u64) -> usize:
            count: mutable usize = 1
            remaining: mutable u64 = value
            while remaining >= DAP_DECIMAL_BASE:
                remaining <- remaining / DAP_DECIMAL_BASE
                count <- count + 1
            return count

        def adapter_event_name(kind: DebuggerDAP::EventKind) -> cstr:
            return DAP_EVENT_INITIALIZED_NAME if kind == DebuggerDAP::EventKind.Initialized
            return DAP_EVENT_CONTINUED_NAME if kind == DebuggerDAP::EventKind.Continued
            return DAP_EVENT_STOPPED_NAME if kind == DebuggerDAP::EventKind.Stopped
            return DAP_EVENT_TERMINATED_NAME if kind == DebuggerDAP::EventKind.Terminated
            return DAP_EVENT_EXITED_NAME

        def adapter_event_name_length(kind: DebuggerDAP::EventKind) -> usize:
            return DAP_EVENT_INITIALIZED_NAME_LENGTH if kind == DebuggerDAP::EventKind.Initialized
            return DAP_EVENT_CONTINUED_NAME_LENGTH if kind == DebuggerDAP::EventKind.Continued
            return DAP_EVENT_STOPPED_NAME_LENGTH if kind == DebuggerDAP::EventKind.Stopped
            return DAP_EVENT_TERMINATED_NAME_LENGTH if kind == DebuggerDAP::EventKind.Terminated
            return DAP_EVENT_EXITED_NAME_LENGTH

        def adapter_event_reason_name(reason: DebuggerDAP::StopReason) -> cstr:
            return DAP_EVENT_REASON_STEP if reason == DebuggerDAP::StopReason.Step
            return DAP_EVENT_REASON_PAUSE if reason == DebuggerDAP::StopReason.Pause
            return DAP_EVENT_REASON_BREAKPOINT

        def adapter_event_reason_name_length(reason: DebuggerDAP::StopReason) -> usize:
            return DAP_EVENT_REASON_STEP_LENGTH if reason == DebuggerDAP::StopReason.Step
            return DAP_EVENT_REASON_PAUSE_LENGTH if reason == DebuggerDAP::StopReason.Pause
            return DAP_EVENT_REASON_BREAKPOINT_LENGTH

        def adapter_event_has_body(event: DebuggerDAP::AdapterEvent) -> bool:
            return event.kind == DebuggerDAP::EventKind.Continued or event.kind == DebuggerDAP::EventKind.Stopped or event.kind == DebuggerDAP::EventKind.Exited

        def adapter_event_body_length(event: DebuggerDAP::AdapterEvent) -> usize:
            if event.kind == DebuggerDAP::EventKind.Continued:
                return DAP_EVENT_CONTINUED_BODY_PREFIX_LENGTH + decimal_digits(DAP_MAIN_THREAD_ID) + DAP_EVENT_CONTINUED_BODY_SUFFIX_LENGTH
            if event.kind == DebuggerDAP::EventKind.Stopped:
                return DAP_EVENT_STOPPED_BODY_PREFIX_LENGTH + adapter_event_reason_name_length(event.reason) + DAP_EVENT_STOPPED_THREAD_FIELD_LENGTH + decimal_digits(DAP_MAIN_THREAD_ID) + DAP_EVENT_STOPPED_BODY_SUFFIX_LENGTH
            if event.kind == DebuggerDAP::EventKind.Exited:
                return DAP_EVENT_EXIT_BODY_PREFIX_LENGTH + signed_decimal_digits(event.exit_code) + DAP_EVENT_EXIT_BODY_SUFFIX_LENGTH
            return 0

        def write_adapter_event(event: DebuggerDAP::AdapterEvent, outbound_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            has_body: bool = adapter_event_has_body(event)
            suffix_length: usize = DAP_EVENT_NO_BODY_SUFFIX_LENGTH if not has_body else DAP_EVENT_NAME_END_LENGTH + DAP_EVENT_BODY_FIELD_LENGTH + adapter_event_body_length(event) + DAP_EVENT_OBJECT_END_LENGTH
            frame_length: u64 = (DAP_EVENT_PREFIX_LENGTH + decimal_digits(outbound_sequence) + DAP_EVENT_MIDDLE_LENGTH + adapter_event_name_length(event.kind) + suffix_length).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", frame_length) can Console
            _ = printf("%s", DAP_EVENT_PREFIX) can Console
            _ = printf("%llu", outbound_sequence) can Console
            _ = printf("%s", DAP_EVENT_MIDDLE) can Console
            _ = printf("%s", adapter_event_name(event.kind)) can Console
            if not has_body:
                _ = printf("%s", DAP_EVENT_NO_BODY_SUFFIX) can Console
                return
            _ = printf("%s", DAP_EVENT_NAME_END) can Console
            _ = printf("%s", DAP_EVENT_BODY_FIELD) can Console
            if event.kind == DebuggerDAP::EventKind.Continued:
                _ = printf("%s", DAP_EVENT_CONTINUED_BODY_PREFIX) can Console
                _ = printf("%llu", DAP_MAIN_THREAD_ID) can Console
                _ = printf("%s", DAP_EVENT_CONTINUED_BODY_SUFFIX) can Console
            if event.kind == DebuggerDAP::EventKind.Stopped:
                _ = printf("%s", DAP_EVENT_STOPPED_BODY_PREFIX) can Console
                _ = printf("%s", adapter_event_reason_name(event.reason)) can Console
                _ = printf("%s", DAP_EVENT_STOPPED_THREAD_FIELD) can Console
                _ = printf("%llu", DAP_MAIN_THREAD_ID) can Console
                _ = printf("%s", DAP_EVENT_STOPPED_BODY_SUFFIX) can Console
            if event.kind == DebuggerDAP::EventKind.Exited:
                _ = printf("%s", DAP_EVENT_EXIT_BODY_PREFIX) can Console
                _ = printf("%lld", event.exit_code) can Console
                _ = printf("%s", DAP_EVENT_EXIT_BODY_SUFFIX) can Console
            _ = printf("%s", DAP_EVENT_OBJECT_END) can Console

        def write_dynamic_response(response_sequence: u64, request_sequence: u64, command: cstr, command_length: usize, suffix: cstr, suffix_length: usize) -> void can[Console, Unsafe.PointerCast]:
            body_length: u64 = (DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + DAP_COMMAND_PREFIX_LENGTH + command_length + suffix_length + DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(DAP_COMMAND_PREFIX) can Console
            _ = printf(command) can Console
            _ = printf(suffix) can Console

        # Echo the validated command token for unknown DAP requests. Keeping
        # its original JSON escapes preserves the request's exact string value.
        def write_unknown_command_response(response_sequence: u64, request_sequence: u64, payload: u8&, command_start: usize, command_end: usize) -> void can[Console, Unsafe.PointerCast]:
            command_length: usize = command_end - command_start
            body_length: u64 = (DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + DAP_COMMAND_PREFIX_LENGTH + command_length + DAP_UNSUPPORTED_SUFFIX_LENGTH + DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(DAP_COMMAND_PREFIX) can Console
            for index in command_start..<command_end:
                _ = printf("%c", payload[index].i32()) can Console
            _ = printf(DAP_UNSUPPORTED_SUFFIX) can Console, Unsafe.PointerCast

        struct DAPSourceLocation:
            line: mutable u64
            column: mutable u64
            source_path_bytes: mutable u8[DAP_STACK_SOURCE_PATH_CAPACITY]
            source_path_length: mutable usize
            source_name_start: mutable usize
            source_name_length: mutable usize
            has_source: mutable bool

        def stack_source_location(service: DebuggerManagedService::Service, result: DebuggerProtocolDispatcher::DispatchResult, coordinates: DebuggerDAPPayload::ClientCoordinates) -> DAPSourceLocation:
            location: mutable DAPSourceLocation = zeroed
            location.line <- DAP_UNKNOWN_SOURCE_LINE
            location.column <- DAP_UNKNOWN_SOURCE_LINE
            instruction_index: u64 = result.session.position.statement.value
            if instruction_index < service.controller.engine.image.program.instruction_count:
                source: DebuggerIdentity::SourceSpan = service.controller.engine.image.instructions[instruction_index.usize()].source
                if source.file.value != DAP_NO_SOURCE_FILE_ID and source.start_line != DAP_UNKNOWN_SOURCE_LINE:
                    line: mutable u64 = source.start_line.u64()
                    column: mutable u64 = source.start_column.u64()
                    line <- line - 1 if not coordinates.lines_start_at_one
                    column <- column + 1 if coordinates.columns_start_at_one
                    location.line <- line
                    location.column <- column
                    if service.controller.engine.image.source_file_count <= DebuggerEDIR::source_file_capacity():
                        for file_index in 0..<service.controller.engine.image.source_file_count:
                            file: DebuggerMetadata::SourceFile = service.controller.engine.image.source_files[file_index]
                            continue if file.id.value != source.file.value or file.path_length == DAP_STACK_SOURCE_NO_NAME_LENGTH or file.path_length > DebuggerMetadata::source_path_capacity()
                            root_length: usize = service.controller.source_path_root_length
                            if root_length > DAP_STACK_SOURCE_ROOT_DISABLED_LENGTH and root_length <= DebuggerMetadata::source_path_capacity():
                                for path_index in 0..<root_length:
                                    location.source_path_bytes[path_index] <- service.controller.source_path_root[path_index]
                                location.source_path_length <- root_length
                                if service.controller.source_path_root[root_length - 1] != DAP_STACK_SOURCE_PATH_SEPARATOR:
                                    location.source_path_bytes[location.source_path_length] <- DAP_STACK_SOURCE_PATH_SEPARATOR
                                    location.source_path_length <- location.source_path_length + 1
                            for path_index in 0..<file.path_length:
                                location.source_path_bytes[location.source_path_length + path_index] <- file.path_bytes[path_index]
                            location.source_path_length <- location.source_path_length + file.path_length
                            location.source_name_start <- DAP_STACK_SOURCE_NO_NAME_START
                            for path_index in 0..<location.source_path_length:
                                location.source_name_start <- path_index + 1 if location.source_path_bytes[path_index] == DAP_STACK_SOURCE_PATH_SEPARATOR
                            location.source_name_length <- location.source_path_length - location.source_name_start
                            location.has_source <- true
                            return location
            return location

        def json_string_encoded_length(bytes: u8&, start: usize, length: usize) -> usize:
            encoded_length: mutable usize = length + DAP_JSON_STRING_QUOTE_BYTES
            for index in start..<(start + length):
                encoded_length <- encoded_length + 1 if bytes[index] == ASCII_QUOTE or bytes[index] == ASCII_BACKSLASH
            return encoded_length

        def write_json_string(bytes: u8&, start: usize, length: usize) -> void can[Console, Unsafe.PointerCast]:
            _ = printf("%c", ASCII_QUOTE.i32()) can Console
            for index in start..<(start + length):
                if bytes[index] == ASCII_QUOTE or bytes[index] == ASCII_BACKSLASH:
                    _ = printf("%c", ASCII_BACKSLASH.i32()) can Console
                _ = printf("%c", bytes[index].i32()) can Console
            _ = printf("%c", ASCII_QUOTE.i32()) can Console

        def write_stack_response(service: DebuggerManagedService::Service, result: DebuggerProtocolDispatcher::DispatchResult, request_sequence: u64, response_sequence: u64, coordinates: DebuggerDAPPayload::ClientCoordinates) -> void can[Console, Unsafe.PointerCast]:
            location: DAPSourceLocation = stack_source_location(service, result, coordinates)
            frame_prefix: mutable cstr = DAP_STACK_DYNAMIC_BEFORE_LINE
            frame_prefix_length: mutable usize = DAP_STACK_DYNAMIC_BEFORE_LINE_LENGTH
            if service.controller.engine.machine.return_stack_pointer > DAP_MAIN_CALL_DEPTH:
                frame_prefix <- DAP_STACK_DYNAMIC_NESTED_BEFORE_LINE
                frame_prefix_length <- DAP_STACK_DYNAMIC_NESTED_BEFORE_LINE_LENGTH
            body_length: mutable u64 = (DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + DAP_COMMAND_PREFIX_LENGTH + DAP_STACK_TRACE_COMMAND_LENGTH + frame_prefix_length + decimal_digits(location.line) + DAP_STACK_DYNAMIC_BEFORE_COLUMN_LENGTH + decimal_digits(location.column) + DAP_STACK_DYNAMIC_AFTER_COLUMN_LENGTH + DAP_JSON_TERMINATOR_LENGTH).u64()
            if location.has_source:
                source_name_length: usize = json_string_encoded_length(location.source_path_bytes[0], location.source_name_start, location.source_name_length)
                source_path_length: usize = json_string_encoded_length(location.source_path_bytes[0], 0, location.source_path_length)
                body_length <- body_length + (DAP_STACK_SOURCE_BEFORE_NAME_LENGTH + source_name_length + DAP_STACK_SOURCE_BETWEEN_NAME_AND_PATH_LENGTH + source_path_length + DAP_STACK_SOURCE_AFTER_PATH_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(DAP_COMMAND_PREFIX) can Console
            _ = printf(DAP_STACK_TRACE_COMMAND) can Console
            _ = printf(frame_prefix) can Console
            _ = printf("%llu", location.line) can Console
            _ = printf(DAP_STACK_DYNAMIC_BEFORE_COLUMN) can Console
            _ = printf("%llu", location.column) can Console
            if location.has_source:
                _ = printf(DAP_STACK_SOURCE_BEFORE_NAME) can Console, Unsafe.PointerCast
                write_json_string(location.source_path_bytes[0], location.source_name_start, location.source_name_length) can Console, Unsafe.PointerCast
                _ = printf(DAP_STACK_SOURCE_BETWEEN_NAME_AND_PATH) can Console, Unsafe.PointerCast
                write_json_string(location.source_path_bytes[0], 0, location.source_path_length) can Console, Unsafe.PointerCast
                _ = printf(DAP_STACK_SOURCE_AFTER_PATH) can Console, Unsafe.PointerCast
            _ = printf(DAP_STACK_DYNAMIC_AFTER_COLUMN) can Console

        def locals_reference_for_generation(generation: u64) -> u64:
            return DAP_LOCALS_REFERENCE_FALLBACK if generation == DAP_NO_EXPECTED_GENERATION
            return generation

        def write_scopes_response(service: DebuggerManagedService::Service, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            generation: u64 = locals_reference_for_generation(service.controller.session.stop_generation)
            body_length: u64 = (DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + DAP_COMMAND_PREFIX_LENGTH + DAP_SCOPES_COMMAND_LENGTH + DAP_SCOPES_BEFORE_REFERENCE_LENGTH + decimal_digits(generation) + DAP_SCOPES_AFTER_REFERENCE_LENGTH + DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(DAP_COMMAND_PREFIX) can Console
            _ = printf(DAP_SCOPES_COMMAND) can Console
            _ = printf(DAP_SCOPES_BEFORE_REFERENCE) can Console
            _ = printf("%llu", generation) can Console
            _ = printf(DAP_SCOPES_AFTER_REFERENCE) can Console

        def signed_decimal_digits(value: i64) -> usize:
            magnitude: mutable u64 = value.u64()
            if value < 0:
                magnitude <- (-(value + 1)).u64() + DAP_DECIMAL_INCREMENT
            count: mutable usize = DAP_DIGIT_COUNT_INCREMENT
            while magnitude >= DAP_DECIMAL_BASE:
                magnitude <- magnitude / DAP_DECIMAL_BASE
                count <- count + DAP_DIGIT_COUNT_INCREMENT
            return count + DAP_DIGIT_COUNT_INCREMENT if value < 0
            return count

        def write_variables_response(page: DebuggerManagedInspection::LocalPage, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            entries_length: mutable usize = 0
            for index in 0..<page.count:
                entry: DebuggerManagedInspection::LocalSnapshot = page.entries[index]
                value_length: usize = signed_decimal_digits(entry.value) if entry.available else DAP_VARIABLE_UNAVAILABLE_VALUE_LENGTH
                entry_length: usize = DAP_VARIABLE_NAME_PREFIX_LENGTH + decimal_digits(entry.index.u64()) + DAP_VARIABLE_VALUE_PREFIX_LENGTH + value_length + DAP_VARIABLE_SUFFIX_LENGTH
                entries_length <- entries_length + entry_length
                entries_length <- entries_length + DAP_DIGIT_COUNT_INCREMENT if index > 0
            body_length: u64 = (DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + DAP_COMMAND_PREFIX_LENGTH + DAP_VARIABLES_COMMAND_LENGTH + DAP_VARIABLES_BEFORE_ITEMS_LENGTH + entries_length + DAP_VARIABLES_AFTER_ITEMS_LENGTH + DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(DAP_COMMAND_PREFIX) can Console
            _ = printf(DAP_VARIABLES_COMMAND) can Console
            _ = printf(DAP_VARIABLES_BEFORE_ITEMS) can Console
            for index in 0..<page.count:
                entry: DebuggerManagedInspection::LocalSnapshot = page.entries[index]
                if index > 0:
                    _ = printf(",") can Console
                _ = printf(DAP_VARIABLE_NAME_PREFIX) can Console
                _ = printf("%llu", entry.index.u64()) can Console
                _ = printf(DAP_VARIABLE_VALUE_PREFIX) can Console
                if entry.available:
                    _ = printf("%lld", entry.value) can Console
                else:
                    _ = printf(DAP_VARIABLE_UNAVAILABLE_VALUE) can Console
                _ = printf(DAP_VARIABLE_SUFFIX) can Console
            _ = printf(DAP_VARIABLES_AFTER_ITEMS) can Console

        def write_source_breakpoints_response(page: DebuggerManagedService::SourceBreakpointResult, coordinates: DebuggerDAPPayload::ClientCoordinates, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            body_length: mutable u64 = (DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + DAP_COMMAND_PREFIX_LENGTH + DAP_SET_BREAKPOINTS_COMMAND_LENGTH + DAP_SOURCE_BREAKPOINT_RESPONSE_PREFIX_LENGTH + DAP_SOURCE_BREAKPOINT_RESPONSE_SUFFIX_LENGTH).u64()
            for index in 0..<page.count:
                entry: DebuggerManagedService::SourceBreakpointEntry = page.points[index]
                verified_length: usize = DAP_JSON_TRUE_LENGTH if entry.verified else DAP_JSON_FALSE_LENGTH
                body_length <- body_length + (DAP_SOURCE_BREAKPOINT_ITEM_PREFIX_LENGTH + decimal_digits(entry.id.value) + DAP_SOURCE_BREAKPOINT_VERIFIED_PREFIX_LENGTH + verified_length + DAP_SOURCE_BREAKPOINT_LINE_PREFIX_LENGTH + decimal_digits(entry.line.u64()) + DAP_SOURCE_BREAKPOINT_ITEM_SUFFIX_LENGTH).u64()
                body_length <- body_length + DAP_SOURCE_BREAKPOINT_SEPARATOR_LENGTH.u64() if index > 0
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(DAP_COMMAND_PREFIX) can Console
            _ = printf(DAP_SET_BREAKPOINTS_COMMAND) can Console
            _ = printf(DAP_SOURCE_BREAKPOINT_RESPONSE_PREFIX) can Console
            for index in 0..<page.count:
                entry: DebuggerManagedService::SourceBreakpointEntry = page.points[index]
                if index > 0:
                    _ = printf(",") can Console
                _ = printf(DAP_SOURCE_BREAKPOINT_ITEM_PREFIX) can Console
                _ = printf("%llu", entry.id.value) can Console
                _ = printf(DAP_SOURCE_BREAKPOINT_VERIFIED_PREFIX) can Console
                if entry.verified:
                    _ = printf("true") can Console
                else:
                    _ = printf("false") can Console
                _ = printf(DAP_SOURCE_BREAKPOINT_LINE_PREFIX) can Console
                response_line: mutable u64 = entry.line.u64()
                response_line <- response_line - DAP_SOURCE_BREAKPOINT_LINE_INCREMENT if not coordinates.lines_start_at_one
                _ = printf("%llu", response_line) can Console
                _ = printf(DAP_SOURCE_BREAKPOINT_ITEM_SUFFIX) can Console
            _ = printf(DAP_SOURCE_BREAKPOINT_RESPONSE_SUFFIX) can Console

        def request_for(method: DebuggerProtocolRequest::RequestMethod, request_id: u64) -> DebuggerProtocolRequest::Request:
            request: mutable DebuggerProtocolRequest::Request = zeroed
            request.method <- method
            request.id <- DAP_FALLBACK_REQUEST_ID if request_id == DAP_NO_EXPECTED_GENERATION else request_id
            request.has_id <- true
            request.target_event <- 0
            request.valid <- true
            return request

        def dispatch_managed(service: mutable DebuggerManagedService::Service&, method: DebuggerProtocolRequest::RequestMethod, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            request: DebuggerProtocolRequest::Request = request_for(method, request_id)
            result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: method, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_step_out(service: mutable DebuggerManagedService::Service&, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            result: DebuggerManagedService::Result = DebuggerManagedService::service_step_out(service)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Step, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_step_over(service: mutable DebuggerManagedService::Service&, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            result: DebuggerManagedService::Result = DebuggerManagedService::service_step_over(service)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Step, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_reverse_continue(service: mutable DebuggerManagedService::Service&, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            result: DebuggerManagedService::Result = DebuggerManagedService::service_reverse_continue(service)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.ReverseStep, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_memory(service: mutable DebuggerManagedService::Service&, request_id: u64, payload: u8&, payload_length: usize, memory: mutable DebuggerMemory::MemoryRead&) -> DebuggerProtocolDispatcher::DispatchResult:
            request: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(payload, payload_length)
            if not request.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_MEMORY_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Memory, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            dispatch_request_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request_for(DebuggerProtocolRequest::RequestMethod.Memory, request_id))
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Memory, accepted: false, stop_generation: service.controller.session.stop_generation, failure: dispatch_request_result.failure} if not dispatch_request_result.accepted
            memory <- DebuggerManagedService::service_memory(service, request.address, request.count)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Memory, accepted: DebuggerMemory::memory_read_is_available(memory), stop_generation: service.controller.session.stop_generation, failure: memory.failure}

        def dispatch_variables(service: mutable DebuggerManagedService::Service&, request_id: u64, payload: u8&, payload_length: usize, page: mutable DebuggerManagedInspection::LocalPage&) -> DebuggerProtocolDispatcher::DispatchResult:
            request: DebuggerDAPPayload::VariablesRequest = DebuggerDAPPayload::variables_request_parse(payload, payload_length)
            if not request.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_VARIABLES_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Variables, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            if request.reference == DAP_NO_VARIABLE_REFERENCE:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_VARIABLES_DETAIL_ZERO_REFERENCE)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Variables, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            current_reference: u64 = locals_reference_for_generation(service.controller.session.stop_generation)
            if request.reference != current_reference:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DAP_VARIABLES_DETAIL_STALE_REFERENCE)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Variables, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            result: DebuggerProtocolDispatcher::DispatchResult = dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Variables, request_id)
            return result if not result.accepted
            page <- DebuggerManagedService::service_locals(service, request.start, request.count if request.has_count else DAP_NO_VARIABLES_REQUESTED)
            page.count <- DAP_NO_VARIABLES_REQUESTED if request.has_count and request.count == DAP_NO_VARIABLES_REQUESTED
            return result

        def dispatch_source_breakpoints(service: mutable DebuggerManagedService::Service&, request_id: u64, payload: u8&, payload_length: usize, coordinates: DebuggerDAPPayload::ClientCoordinates, response: mutable DebuggerManagedService::SourceBreakpointResult&) -> DebuggerProtocolDispatcher::DispatchResult:
            request: mutable DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(payload, payload_length)
            if not request.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            source_id: mutable DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DAP_NO_SOURCE_FILE_ID)
            if request.has_source_reference and request.source_reference != DAP_NO_SOURCE_REFERENCE:
                source_id <- DebuggerIdentity::debug_id(request.source_reference)
                if not DebuggerManagedEngine::managed_source_file_id_is_known(service.controller, source_id):
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            if request.has_source_path:
                path_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, request.source_path.bytes[0], request.source_path.length)
                if path_id.value == DAP_NO_SOURCE_FILE_ID or (source_id.value != DAP_NO_SOURCE_FILE_ID and source_id.value != path_id.value):
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                source_id <- path_id
            if source_id.value == DAP_NO_SOURCE_FILE_ID:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            for index in 0..<request.count:
                if coordinates.lines_start_at_one:
                    if request.lines[index] == 0:
                        failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                        return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                else:
                    if request.lines[index].u64() >= DAP_MAX_SOURCE_BREAKPOINT_LINE:
                        failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                        return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                    request.lines[index] <- (request.lines[index].u64() + DAP_SOURCE_BREAKPOINT_LINE_INCREMENT).u32()
            response <- DebuggerManagedService::service_replace_source_breakpoints(service, source_id, request.lines[0], request.count)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: response.accepted, stop_generation: service.controller.session.stop_generation, failure: response.failure}

        def dispatch_launch(service: mutable DebuggerManagedService::Service&, request_id: u64, payload: u8&, payload_length: usize) -> DebuggerProtocolDispatcher::DispatchResult can[Blocking.IO, Unsafe.PointerCast]:
            return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Launch, request_id) if service.controller.session.state != DebuggerSession::SessionState.Created
            path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(payload, payload_length)
            if not path.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_MEMORY_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            source_root: DebuggerDAPPayload::SourcePathRootRequest = DebuggerDAPPayload::source_path_root_parse(payload, payload_length)
            if not source_root.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_MEMORY_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(path.bytes[0], path.length) can Blocking.IO, Unsafe.PointerCast
            if not loaded.valid:
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: loaded.failure}
            recording: DebuggerIdentity::DebugId = service.controller.engine.recording
            session: DebuggerSession::Session = service.controller.session
            service <- DebuggerManagedService::service_new(session, loaded.image, recording)
            if source_root.has_root and not DebuggerManagedEngine::managed_set_source_path_root(service.controller, source_root.root.bytes[0], source_root.root.length):
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_MEMORY_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Launch, request_id)

        def dispatch_command(service: mutable DebuggerManagedService::Service&, command_hash: u64, request_id: u64, payload: u8&, payload_length: usize, memory: mutable DebuggerMemory::MemoryRead&, variables: mutable DebuggerManagedInspection::LocalPage&, source_breakpoints: mutable DebuggerManagedService::SourceBreakpointResult&, client_coordinates: mutable DebuggerDAPPayload::ClientCoordinates&) -> DebuggerProtocolDispatcher::DispatchResult can[Blocking.IO, Unsafe.PointerCast]:
            if command_hash == COMMAND_HASH_INITIALIZE:
                coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(payload, payload_length)
                if not coordinates.valid:
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DAP_MEMORY_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Initialize, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                client_coordinates <- coordinates
                return DebuggerProtocolDispatcher::dispatch_request(service.controller.session, request_for(DebuggerProtocolRequest::RequestMethod.Initialize, request_id), DAP_NO_EXPECTED_GENERATION)
            if command_hash == COMMAND_HASH_LAUNCH:
                return dispatch_launch(service, request_id, payload, payload_length) can Blocking.IO, Unsafe.PointerCast
            if command_hash == COMMAND_HASH_CONTINUE:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Continue, request_id)
            if command_hash == COMMAND_HASH_PAUSE:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Pause, request_id)
            if command_hash == COMMAND_HASH_NEXT:
                return dispatch_step_over(service, request_id)
            if command_hash == COMMAND_HASH_STEP_BACK:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.ReverseStep, request_id)
            if command_hash == COMMAND_HASH_DISCONNECT:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Detach, request_id)
            if command_hash == COMMAND_HASH_TERMINATE:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Terminate, request_id)
            if command_hash == COMMAND_HASH_STACK_TRACE:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Stack, request_id)
            if command_hash == COMMAND_HASH_SCOPES:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Scopes, request_id)
            if command_hash == COMMAND_HASH_VARIABLES:
                return dispatch_variables(service, request_id, payload, payload_length, variables)
            if command_hash == COMMAND_HASH_EVALUATE:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Evaluate, request_id)
            if command_hash == COMMAND_HASH_SET_BREAKPOINTS:
                return dispatch_source_breakpoints(service, request_id, payload, payload_length, client_coordinates, source_breakpoints)
            if command_hash == COMMAND_HASH_SET_FUNCTION_BREAKPOINTS:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.SetBreakpoints, request_id)
            if command_hash == COMMAND_HASH_SET_DATA_BREAKPOINTS:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints, request_id)
            if command_hash == COMMAND_HASH_READ_MEMORY:
                return dispatch_memory(service, request_id, payload, payload_length, memory)
            if command_hash == COMMAND_HASH_STEP_IN:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Step, request_id)
            if command_hash == COMMAND_HASH_STEP_OUT:
                return dispatch_step_out(service, request_id)
            if command_hash == COMMAND_HASH_REVERSE_CONTINUE:
                return dispatch_reverse_continue(service, request_id)
            if command_hash == COMMAND_HASH_CONFIGURATION_DONE:
                if service.controller.session.state != DebuggerSession::SessionState.Running and service.controller.session.state != DebuggerSession::SessionState.Stopped:
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DAP_CONFIGURATION_DONE_DETAIL_INVALID_STATE)
                    return DebuggerProtocolDispatcher::dispatch_error(service.controller.session, DebuggerProtocolRequest::RequestMethod.Initialize, failure)
                return DebuggerProtocolDispatcher::dispatch_ok(service.controller.session, DebuggerProtocolRequest::RequestMethod.Initialize)
            if command_hash == COMMAND_HASH_THREADS:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Threads, request_id)
            invalid: mutable DebuggerProtocolRequest::Request = zeroed
            invalid.valid <- false
            return DebuggerProtocolDispatcher::dispatch_request(service.controller.session, invalid, DAP_NO_EXPECTED_GENERATION)

        def write_failure_response(command_hash: u64, request_sequence: u64, response_sequence: u64, payload: u8&, command_start: usize, command_end: usize) -> void can[Console, Unsafe.PointerCast]:
            if command_hash == COMMAND_HASH_INITIALIZE:
                write_dynamic_response(response_sequence, request_sequence, DAP_INIT_COMMAND, DAP_INIT_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_LAUNCH:
                write_dynamic_response(response_sequence, request_sequence, DAP_LAUNCH_COMMAND, DAP_LAUNCH_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_CONFIGURATION_DONE:
                write_dynamic_response(response_sequence, request_sequence, DAP_CONFIGURATION_DONE_COMMAND, DAP_CONFIGURATION_DONE_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_CONTINUE:
                write_dynamic_response(response_sequence, request_sequence, DAP_CONTINUE_COMMAND, DAP_CONTINUE_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_NEXT:
                write_dynamic_response(response_sequence, request_sequence, DAP_NEXT_COMMAND, DAP_NEXT_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_STEP_BACK:
                write_dynamic_response(response_sequence, request_sequence, DAP_STEP_BACK_COMMAND, DAP_STEP_BACK_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_PAUSE:
                write_dynamic_response(response_sequence, request_sequence, DAP_PAUSE_COMMAND, DAP_PAUSE_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_THREADS:
                write_dynamic_response(response_sequence, request_sequence, DAP_THREADS_COMMAND, DAP_THREADS_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_STACK_TRACE:
                write_dynamic_response(response_sequence, request_sequence, DAP_STACK_TRACE_COMMAND, DAP_STACK_TRACE_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_SCOPES:
                write_dynamic_response(response_sequence, request_sequence, DAP_SCOPES_COMMAND, DAP_SCOPES_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_VARIABLES:
                write_dynamic_response(response_sequence, request_sequence, DAP_VARIABLES_COMMAND, DAP_VARIABLES_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_EVALUATE:
                write_dynamic_response(response_sequence, request_sequence, DAP_EVALUATE_COMMAND, DAP_EVALUATE_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_SET_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, DAP_SET_BREAKPOINTS_COMMAND, DAP_SET_BREAKPOINTS_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_SET_FUNCTION_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, DAP_SET_FUNCTION_BREAKPOINTS_COMMAND, DAP_SET_FUNCTION_BREAKPOINTS_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_SET_DATA_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, DAP_SET_DATA_BREAKPOINTS_COMMAND, DAP_SET_DATA_BREAKPOINTS_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_READ_MEMORY:
                write_dynamic_response(response_sequence, request_sequence, DAP_READ_MEMORY_COMMAND, DAP_READ_MEMORY_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_STEP_IN:
                write_dynamic_response(response_sequence, request_sequence, DAP_STEP_IN_COMMAND, DAP_STEP_IN_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_STEP_OUT:
                write_dynamic_response(response_sequence, request_sequence, DAP_STEP_OUT_COMMAND, DAP_STEP_OUT_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_REVERSE_CONTINUE:
                write_dynamic_response(response_sequence, request_sequence, DAP_REVERSE_CONTINUE_COMMAND, DAP_REVERSE_CONTINUE_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_DISCONNECT:
                write_dynamic_response(response_sequence, request_sequence, DAP_DISCONNECT_COMMAND, DAP_DISCONNECT_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_TERMINATE:
                write_dynamic_response(response_sequence, request_sequence, DAP_TERMINATE_COMMAND, DAP_TERMINATE_COMMAND_LENGTH, DAP_UNAVAILABLE_SUFFIX, DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            write_unknown_command_response(response_sequence, request_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast

        def write_launch_failure_response(result: DebuggerProtocolDispatcher::DispatchResult, request_sequence: u64, response_sequence: u64, payload: u8&, command_start: usize, command_end: usize) -> void can[Console, Unsafe.PointerCast]:
            if result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                write_dynamic_response(response_sequence, request_sequence, DAP_LAUNCH_COMMAND, DAP_LAUNCH_COMMAND_LENGTH, DAP_LAUNCH_INVALID_SUFFIX, DAP_LAUNCH_INVALID_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Corrupt:
                write_dynamic_response(response_sequence, request_sequence, DAP_LAUNCH_COMMAND, DAP_LAUNCH_COMMAND_LENGTH, DAP_LAUNCH_CORRUPT_SUFFIX, DAP_LAUNCH_CORRUPT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.ResourceLimit:
                write_dynamic_response(response_sequence, request_sequence, DAP_LAUNCH_COMMAND, DAP_LAUNCH_COMMAND_LENGTH, DAP_LAUNCH_RESOURCE_SUFFIX, DAP_LAUNCH_RESOURCE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            write_failure_response(COMMAND_HASH_LAUNCH, request_sequence, response_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast

        def write_memory_response(memory: DebuggerMemory::MemoryRead, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            address_digits: mutable usize = DAP_FIRST_HEX_DIGIT_COUNT
            address_remaining: mutable u64 = memory.address
            while address_remaining >= DAP_MEMORY_HEX_BASE:
                address_remaining <- address_remaining / DAP_MEMORY_HEX_BASE
                address_digits <- address_digits + 1
            body_length: u64 = (DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + DAP_COMMAND_PREFIX_LENGTH + DAP_READ_MEMORY_COMMAND_LENGTH + DAP_MEMORY_SUCCESS_BEFORE_ADDRESS_LENGTH + address_digits + DAP_MEMORY_SUCCESS_BEFORE_DATA_LENGTH + memory.length * DAP_MEMORY_HEX_BYTES + DAP_MEMORY_SUCCESS_AFTER_DATA_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(DAP_COMMAND_PREFIX) can Console
            _ = printf(DAP_READ_MEMORY_COMMAND) can Console
            _ = printf(DAP_MEMORY_SUCCESS_BEFORE_ADDRESS) can Console
            _ = printf("%llx", memory.address) can Console
            _ = printf(DAP_MEMORY_SUCCESS_BEFORE_DATA) can Console
            for index in 0..<memory.length:
                _ = printf("%02llx", memory.bytes[index].u64()) can Console
            _ = printf(DAP_MEMORY_SUCCESS_AFTER_DATA) can Console

        def write_response(service: DebuggerManagedService::Service, result: DebuggerProtocolDispatcher::DispatchResult, command_hash: u64, request_sequence: u64, response_sequence: u64, memory: DebuggerMemory::MemoryRead, variables: DebuggerManagedInspection::LocalPage, source_breakpoints: DebuggerManagedService::SourceBreakpointResult, client_coordinates: DebuggerDAPPayload::ClientCoordinates, payload: u8&, command_start: usize, command_end: usize) -> void can[Console, Unsafe.PointerCast]:
            if not result.accepted:
                if command_hash == COMMAND_HASH_VARIABLES:
                    suffix: mutable cstr = DAP_UNAVAILABLE_SUFFIX
                    suffix_length: mutable usize = DAP_UNAVAILABLE_SUFFIX_LENGTH
                    if result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                        suffix <- DAP_VARIABLES_INVALID_SUFFIX
                        suffix_length <- DAP_VARIABLES_INVALID_SUFFIX_LENGTH
                        suffix <- DAP_VARIABLES_ARGUMENT_SUFFIX if result.failure.detail == DAP_VARIABLES_DETAIL_ARGUMENT
                        suffix_length <- DAP_VARIABLES_ARGUMENT_SUFFIX_LENGTH if result.failure.detail == DAP_VARIABLES_DETAIL_ARGUMENT
                        suffix <- DAP_VARIABLES_ZERO_REFERENCE_SUFFIX if result.failure.detail == DAP_VARIABLES_DETAIL_ZERO_REFERENCE
                        suffix_length <- DAP_VARIABLES_ZERO_REFERENCE_SUFFIX_LENGTH if result.failure.detail == DAP_VARIABLES_DETAIL_ZERO_REFERENCE
                        suffix <- DAP_VARIABLES_INVALID_ID_SUFFIX if result.failure.detail == DAP_VARIABLES_DETAIL_REQUEST_ID
                        suffix_length <- DAP_VARIABLES_INVALID_ID_SUFFIX_LENGTH if result.failure.detail == DAP_VARIABLES_DETAIL_REQUEST_ID
                        suffix <- DAP_VARIABLES_INVALID_METHOD_SUFFIX if result.failure.detail == DAP_VARIABLES_DETAIL_METHOD
                        suffix_length <- DAP_VARIABLES_INVALID_METHOD_SUFFIX_LENGTH if result.failure.detail == DAP_VARIABLES_DETAIL_METHOD
                    if result.failure.code == DebuggerErrors::ErrorCode.Unavailable and result.failure.detail == DAP_VARIABLES_DETAIL_STALE_REFERENCE:
                        suffix <- DAP_VARIABLES_STALE_SUFFIX
                        suffix_length <- DAP_VARIABLES_STALE_SUFFIX_LENGTH
                    write_dynamic_response(response_sequence, request_sequence, DAP_VARIABLES_COMMAND, DAP_VARIABLES_COMMAND_LENGTH, suffix, suffix_length) can Console, Unsafe.PointerCast
                    return
                if command_hash == COMMAND_HASH_READ_MEMORY and result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                    write_dynamic_response(response_sequence, request_sequence, DAP_READ_MEMORY_COMMAND, DAP_READ_MEMORY_COMMAND_LENGTH, DAP_MEMORY_INVALID_SUFFIX, DAP_MEMORY_INVALID_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == COMMAND_HASH_SET_BREAKPOINTS and result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                    write_dynamic_response(response_sequence, request_sequence, DAP_SET_BREAKPOINTS_COMMAND, DAP_SET_BREAKPOINTS_COMMAND_LENGTH, DAP_SOURCE_BREAKPOINT_INVALID_SUFFIX, DAP_SOURCE_BREAKPOINT_INVALID_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == COMMAND_HASH_SET_BREAKPOINTS and result.failure.code == DebuggerErrors::ErrorCode.ResourceLimit:
                    write_dynamic_response(response_sequence, request_sequence, DAP_SET_BREAKPOINTS_COMMAND, DAP_SET_BREAKPOINTS_COMMAND_LENGTH, DAP_SOURCE_BREAKPOINT_RESOURCE_SUFFIX, DAP_SOURCE_BREAKPOINT_RESOURCE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == COMMAND_HASH_CONFIGURATION_DONE and result.failure.code == DebuggerErrors::ErrorCode.InvalidState:
                    write_dynamic_response(response_sequence, request_sequence, DAP_CONFIGURATION_DONE_COMMAND, DAP_CONFIGURATION_DONE_COMMAND_LENGTH, DAP_CONFIGURATION_DONE_INVALID_STATE_SUFFIX, DAP_CONFIGURATION_DONE_INVALID_STATE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == COMMAND_HASH_LAUNCH:
                    write_launch_failure_response(result, request_sequence, response_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast
                    return
                write_failure_response(command_hash, request_sequence, response_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_READ_MEMORY:
                write_memory_response(memory, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_INITIALIZE:
                write_dynamic_response(response_sequence, request_sequence, DAP_INIT_COMMAND, DAP_INIT_COMMAND_LENGTH, DAP_INIT_SUFFIX, DAP_INIT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_LAUNCH:
                write_dynamic_response(response_sequence, request_sequence, DAP_LAUNCH_COMMAND, DAP_LAUNCH_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_CONFIGURATION_DONE:
                write_dynamic_response(response_sequence, request_sequence, DAP_CONFIGURATION_DONE_COMMAND, DAP_CONFIGURATION_DONE_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_CONTINUE:
                write_dynamic_response(response_sequence, request_sequence, DAP_CONTINUE_COMMAND, DAP_CONTINUE_COMMAND_LENGTH, DAP_CONTINUE_SUFFIX, DAP_CONTINUE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_NEXT:
                write_dynamic_response(response_sequence, request_sequence, DAP_NEXT_COMMAND, DAP_NEXT_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_STEP_BACK:
                write_dynamic_response(response_sequence, request_sequence, DAP_STEP_BACK_COMMAND, DAP_STEP_BACK_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_PAUSE:
                write_dynamic_response(response_sequence, request_sequence, DAP_PAUSE_COMMAND, DAP_PAUSE_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_THREADS:
                write_dynamic_response(response_sequence, request_sequence, DAP_THREADS_COMMAND, DAP_THREADS_COMMAND_LENGTH, DAP_THREADS_SUFFIX, DAP_THREADS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_STACK_TRACE:
                write_stack_response(service, result, request_sequence, response_sequence, client_coordinates) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_SCOPES:
                write_scopes_response(service, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_VARIABLES:
                write_variables_response(variables, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_EVALUATE:
                write_dynamic_response(response_sequence, request_sequence, DAP_EVALUATE_COMMAND, DAP_EVALUATE_COMMAND_LENGTH, DAP_EVALUATE_SUFFIX, DAP_EVALUATE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_SET_BREAKPOINTS:
                write_source_breakpoints_response(source_breakpoints, client_coordinates, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_SET_FUNCTION_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, DAP_SET_FUNCTION_BREAKPOINTS_COMMAND, DAP_SET_FUNCTION_BREAKPOINTS_COMMAND_LENGTH, DAP_SET_BREAKPOINTS_SUFFIX, DAP_SET_BREAKPOINTS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_SET_DATA_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, DAP_SET_DATA_BREAKPOINTS_COMMAND, DAP_SET_DATA_BREAKPOINTS_COMMAND_LENGTH, DAP_SET_DATA_BREAKPOINTS_SUFFIX, DAP_SET_DATA_BREAKPOINTS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_STEP_IN:
                write_dynamic_response(response_sequence, request_sequence, DAP_STEP_IN_COMMAND, DAP_STEP_IN_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_STEP_OUT:
                write_dynamic_response(response_sequence, request_sequence, DAP_STEP_OUT_COMMAND, DAP_STEP_OUT_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_REVERSE_CONTINUE:
                write_dynamic_response(response_sequence, request_sequence, DAP_REVERSE_CONTINUE_COMMAND, DAP_REVERSE_CONTINUE_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_DISCONNECT:
                write_dynamic_response(response_sequence, request_sequence, DAP_DISCONNECT_COMMAND, DAP_DISCONNECT_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == COMMAND_HASH_TERMINATE:
                write_dynamic_response(response_sequence, request_sequence, DAP_TERMINATE_COMMAND, DAP_TERMINATE_COMMAND_LENGTH, DAP_SIMPLE_SUCCESS_SUFFIX, DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            write_unknown_command_response(response_sequence, request_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast

        def event_request_kind(command_hash: u64) -> DebuggerDAP::RequestKind:
            return DebuggerDAP::RequestKind.Launch if command_hash == COMMAND_HASH_LAUNCH
            return DebuggerDAP::RequestKind.Continue if command_hash == COMMAND_HASH_CONTINUE
            return DebuggerDAP::RequestKind.Pause if command_hash == COMMAND_HASH_PAUSE
            return DebuggerDAP::RequestKind.Step if command_hash == COMMAND_HASH_NEXT or command_hash == COMMAND_HASH_STEP_IN or command_hash == COMMAND_HASH_STEP_OUT or command_hash == COMMAND_HASH_STEP_BACK
            return DebuggerDAP::RequestKind.ReverseContinue if command_hash == COMMAND_HASH_REVERSE_CONTINUE
            return DebuggerDAP::RequestKind.Terminate if command_hash == COMMAND_HASH_TERMINATE
            return DebuggerDAP::RequestKind.Other

    public:
        def initial_session() -> DebuggerSession::Session:
            build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
            return DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())

        def run() -> i64 can[Console, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            decoder: mutable Decoder = decoder_new()
            chunk: mutable u8[DAP_READ_CHUNK_SIZE] = zeroed
            outbound_sequence: mutable u64 = 1
            client_coordinates: mutable DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_default()
            session: DebuggerSession::Session = initial_session()
            service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, DebuggerDefaultImage::image_new(), DebuggerIdentity::debug_id(1))
            memory: mutable DebuggerMemory::MemoryRead = zeroed
            variables: mutable DebuggerManagedInspection::LocalPage = zeroed
            source_breakpoints: mutable DebuggerManagedService::SourceBreakpointResult = zeroed
            while true:
                count: isize = read(STDIN_FD, (&chunk[0]).cast[void&], DAP_READ_CHUNK_SIZE) can Console
                break if count <= 0
                for index in 0..<count.usize():
                    completed: bool = decoder_accept(decoder, chunk[index])
                    if completed:
                        memory <- zeroed
                        source_breakpoints <- zeroed
                        result: DebuggerProtocolDispatcher::DispatchResult = dispatch_command(service, decoder.command_hash, decoder.request_sequence, decoder.payload[0], decoder.last_payload_length, memory, variables, source_breakpoints, client_coordinates)
                        service.controller.session <- result.session
                        write_response(service, result, decoder.command_hash, decoder.request_sequence, outbound_sequence, memory, variables, source_breakpoints, client_coordinates, decoder.payload[0], decoder.command_value_start, decoder.command_value_end) can Console, Unsafe.PointerCast
                        return DAP_SERVER_INVALID_FRAME_EXIT_CODE if outbound_sequence == MAX_DAP_OUTBOUND_SEQUENCE
                        outbound_sequence <- outbound_sequence + DAP_DECIMAL_INCREMENT
                        event_batch: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(event_request_kind(decoder.command_hash), result.accepted, service.controller.session.state, service.controller.engine.machine.halted, service.controller.engine.machine.faulted, service.controller.engine.machine.result)
                        for event_index in 0..<event_batch.count:
                            write_adapter_event(event_batch.events[event_index], outbound_sequence) can Console, Unsafe.PointerCast
                            return DAP_SERVER_INVALID_FRAME_EXIT_CODE if outbound_sequence == MAX_DAP_OUTBOUND_SEQUENCE
                            outbound_sequence <- outbound_sequence + DAP_DECIMAL_INCREMENT
                        _ = fflush(null) can Console
                        decoder.command_hash <- 0
                        decoder.request_sequence <- 0
                        decoder.sequence_digits <- 0
                        decoder.sequence_prefix_position <- 0
                        decoder.in_sequence <- false
                    return DAP_SERVER_INVALID_FRAME_EXIT_CODE if decoder.state == DECODER_FAILED_STATE
            return DAP_SERVER_INVALID_FRAME_EXIT_CODE if decoder.state != DECODER_HEADER_STATE or decoder.header_prefix_position != 0
            return DAP_SERVER_SUCCESS_EXIT_CODE

def main() -> i64 can[Console, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return DebuggerDAPServer::run()
