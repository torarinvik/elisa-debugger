                decoder.json_primitive_literal_position <- 1
                return true
            if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_F:
                decoder.json_primitive_kind <- JsonWire::JSON_PRIMITIVE_FALSE
                decoder.json_primitive_literal_position <- 1
                return true
            if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_N:
                decoder.json_primitive_kind <- JsonWire::JSON_PRIMITIVE_NULL
                decoder.json_primitive_literal_position <- 1
                return true
