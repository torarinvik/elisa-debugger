        const DAP_LAUNCH_COMMAND_LENGTH: usize = 6
        const DAP_SIMPLE_SUCCESS_SUFFIX: cstr = "\",\"success\":true}"
        const DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH: usize = 17
