            RESPONSE_PREFIX: cstr = "\",\"success\":true,\"body\":{\"stackFrames\":["
            RESPONSE_PREFIX_LENGTH: usize = 40
            RESPONSE_MIDDLE: cstr = "],\"totalFrames\":"
            RESPONSE_MIDDLE_LENGTH: usize = 16
            RESPONSE_SUFFIX: cstr = "}}"
            RESPONSE_SUFFIX_LENGTH: usize = 2
            FRAME_ID_PREFIX: cstr = "{\"id\":"
            FRAME_ID_PREFIX_LENGTH: usize = 6
            FIRST_NAME_BYTE_INDEX: usize = 0
            FRAME_NAME_PREFIX: cstr = ",\"name\":"
            FRAME_NAME_PREFIX_LENGTH: usize = 8
            FRAME_LINE_PREFIX: cstr = ",\"line\":"
            FRAME_LINE_PREFIX_LENGTH: usize = 8
            FRAME_COLUMN_PREFIX: cstr = ",\"column\":"
            FRAME_COLUMN_PREFIX_LENGTH: usize = 10
            FRAME_SOURCE_BEFORE_NAME: cstr = ",\"source\":{\"name\":"
            FRAME_SOURCE_BEFORE_NAME_LENGTH: usize = 18
            FRAME_SOURCE_BETWEEN_NAME_AND_PATH: cstr = ",\"path\":"
            FRAME_SOURCE_BETWEEN_NAME_AND_PATH_LENGTH: usize = 8
            FRAME_SOURCE_AFTER_PATH: cstr = "}"
            FRAME_SOURCE_AFTER_PATH_LENGTH: usize = 1
            FRAME_SUFFIX: cstr = "}"
            FRAME_SUFFIX_LENGTH: usize = 1
            FRAME_SEPARATOR: cstr = ","
            FRAME_SEPARATOR_LENGTH: usize = 1

        const module StackTraceSourcePath:
            DAP_STACK_SOURCE_PATH_CAPACITY: usize = DebuggerMetadataSourcePath::MAPPED_SOURCE_PATH_CAPACITY
            EMPTY_PATH_LENGTH: usize = 0
            EMPTY_NAME_START: usize = 0
            DISABLED_ROOT_LENGTH: usize = 0
            PATH_SEPARATOR: u8 = 47
            PATH_SEPARATOR_COUNT: usize = 1
            FIRST_SOURCE_FILE_INDEX: usize = 0
            FIRST_PATH_BYTE_INDEX: usize = 0
            PATH_INDEX_INCREMENT: usize = 1
            FIRST_FRAME_PAGE_INDEX: usize = 0

        const module StackTraceFrameHandle:
            INVALID_FRAME_ID: u64 = 0
            FRAME_ID_RESERVED_SLOT_COUNT: usize = 1
            MAX_FRAME_ID_REFERENCE: u64 = 18446744073709551615
            FRAME_ID_REFERENCE_STRIDE: usize = DebuggerEDIRCapacity::EDIR_CALL_FRAME_CAPACITY + StackTraceFrameHandle::FRAME_ID_RESERVED_SLOT_COUNT

        const module StackTraceLocalsReference:
            MAX_LOCALS_REFERENCE: u64 = 18446744073709551615
            LOCALS_REFERENCE_STRIDE: usize = DebuggerEDIRCapacity::EDIR_CALL_FRAME_CAPACITY

        const module Threads:
            DAP_THREADS_COMMAND: cstr = "threads"
            DAP_THREADS_COMMAND_LENGTH: usize = 7
            DAP_THREADS_SUFFIX: cstr = "\",\"success\":true,\"body\":{\"threads\":[{\"id\":1,\"name\":\"main\"}]}}"
            DAP_THREADS_SUFFIX_LENGTH: usize = 61

        const module TransportLimits:
            PROTOCOL_DAP_SERVER_TRANSPORT_LIMITS_STDIN_FD: int = 0
            MAX_DAP_PAYLOAD: usize = 65536
            MAX_DAP_HEADER_BYTES: usize = 64
            MAX_DAP_HEADER_DIGITS: usize = 10
            MAX_DAP_SEQUENCE_DIGITS: usize = 20
            FIRST_DAP_SEQUENCE_DIGIT_COUNT: usize = 1
            MAX_DAP_SEQUENCE_VALUE: u64 = 18446744073709551615
            DAP_MIN_REQUEST_SEQUENCE: u64 = 1
            MAX_DAP_OUTBOUND_SEQUENCE: u64 = 18446744073709551615
            DAP_READ_CHUNK_SIZE: usize = 4096
            DAP_SERVER_SUCCESS_EXIT_CODE: i64 = 0
            DAP_SERVER_INVALID_FRAME_EXIT_CODE: i64 = 2

        const module Variables:
            DAP_VARIABLES_COMMAND: cstr = "variables"
            DAP_VARIABLES_COMMAND_LENGTH: usize = 9
            DAP_VARIABLES_BEFORE_ITEMS: cstr = "\",\"success\":true,\"body\":{\"variables\":["
            DAP_VARIABLES_BEFORE_ITEMS_LENGTH: usize = 38
            DAP_VARIABLES_AFTER_ITEMS: cstr = "]}}"
            DAP_VARIABLES_AFTER_ITEMS_LENGTH: usize = 3
            DAP_VARIABLE_NAME_PREFIX: cstr = "{\"name\":\"local"
            DAP_VARIABLE_NAME_PREFIX_LENGTH: usize = 14
            DAP_VARIABLE_VALUE_PREFIX: cstr = "\",\"value\":\""
            DAP_VARIABLE_VALUE_PREFIX_LENGTH: usize = 11
            DAP_VARIABLE_SUFFIX: cstr = "\",\"type\":\"i64\",\"variablesReference\":0}"
            DAP_VARIABLE_SUFFIX_LENGTH: usize = 38
            DAP_VARIABLE_UNAVAILABLE_VALUE: cstr = "<unavailable>"
            DAP_VARIABLE_UNAVAILABLE_VALUE_LENGTH: usize = 13
            DAP_VARIABLES_ARGUMENT_SUFFIX: cstr = "\",\"success\":false,\"message\":\"variables arguments are invalid\"}"
            DAP_VARIABLES_ARGUMENT_SUFFIX_LENGTH: usize = 62
            DAP_VARIABLES_INVALID_SUFFIX: cstr = "\",\"success\":false,\"message\":\"variables request is invalid\"}"
            DAP_VARIABLES_INVALID_SUFFIX_LENGTH: usize = 59
            DAP_VARIABLES_ZERO_REFERENCE_SUFFIX: cstr = "\",\"success\":false,\"message\":\"variables reference is invalid\"}"
            DAP_VARIABLES_ZERO_REFERENCE_SUFFIX_LENGTH: usize = 61
            DAP_VARIABLES_STALE_SUFFIX: cstr = "\",\"success\":false,\"message\":\"variables reference is stale\"}"
            DAP_VARIABLES_STALE_SUFFIX_LENGTH: usize = 59
            DAP_VARIABLES_INVALID_ID_SUFFIX: cstr = "\",\"success\":false,\"message\":\"variables request id is invalid\"}"
            DAP_VARIABLES_INVALID_ID_SUFFIX_LENGTH: usize = 62
            DAP_VARIABLES_INVALID_METHOD_SUFFIX: cstr = "\",\"success\":false,\"message\":\"variables method is invalid\"}"
            DAP_VARIABLES_INVALID_METHOD_SUFFIX_LENGTH: usize = 58

        struct DecodedJSONString:
            valid: mutable bool
            ascii_only: mutable bool
            hash: mutable u64
            length: mutable usize

        struct Decoder:
            state: mutable u8
            header_tail: mutable u8
            content_length: mutable usize
            header_bytes: mutable usize
            header_digits: mutable usize
            payload_received: mutable usize
            command_prefix_position: mutable u8
            in_command: mutable bool
            command_escaped: mutable bool
            command_seen: mutable bool
            command_hash: mutable u64
            command_value_start: mutable usize
            command_value_end: mutable usize
            type_prefix_position: mutable u8
            in_type: mutable bool
            type_escaped: mutable bool
            type_seen: mutable bool
            type_value_start: mutable usize
            type_value_end: mutable usize
            sequence_prefix_position: mutable u8
            in_sequence: mutable bool
            sequence_seen: mutable bool
            request_sequence: mutable u64
            sequence_digits: mutable usize
            header_prefix_position: mutable u8
            json_has_content: mutable bool
            json_first: mutable u8
            json_last: mutable u8
            json_object_depth: mutable usize
            json_array_depth: mutable usize
            json_nesting: mutable u8[JsonWire::PROTOCOL_DAP_SERVER_JSON_WIRE_JSON_NESTING_CAPACITY]
            json_states: mutable u8[JsonWire::PROTOCOL_DAP_SERVER_JSON_WIRE_JSON_NESTING_CAPACITY]
            json_nesting_count: mutable usize
            json_in_string: mutable bool
            json_string_is_key: mutable bool
            json_escaped: mutable bool
            json_unicode_digits: mutable u8
            json_utf8_continuations_remaining: mutable u8
            json_utf8_next_byte_min: mutable u8
            json_utf8_next_byte_max: mutable u8
            json_key_value_start: mutable usize
            json_in_primitive: mutable bool
            json_primitive_kind: mutable u8
            json_primitive_number_state: mutable u8
            json_primitive_literal_position: mutable u8
            json_primitive_valid: mutable bool
            json_root_state: mutable u8
            json_closed: mutable bool
            json_structural_invalid: mutable bool
            payload: mutable u8[TransportLimits::MAX_DAP_PAYLOAD]
            last_payload_length: mutable usize

        def decoder_new() -> Decoder:
            decoder: Decoder = zeroed
            return decoder

        def json_prefix_matches(position: u8, byte: u8, prefix: cstr, prefix_length: u8) -> bool:
            return false if position >= prefix_length
            return byte == prefix[position.usize()].u8()

        def command_prefix_matches(position: u8, byte: u8) -> bool:
            return json_prefix_matches(position, byte, RequestFields::COMMAND_PREFIX, RequestFields::COMMAND_PREFIX_LENGTH)

        def sequence_prefix_matches(position: u8, byte: u8) -> bool:
            return json_prefix_matches(position, byte, FrameParsing::SEQUENCE_PREFIX, FrameParsing::SEQUENCE_PREFIX_LENGTH)

        def type_prefix_matches(position: u8, byte: u8) -> bool:
            return json_prefix_matches(position, byte, FrameParsing::TYPE_PREFIX, FrameParsing::TYPE_PREFIX_LENGTH)

        def is_json_whitespace(byte: u8) -> bool:
            return byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_SPACE or byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_TAB or byte == Character::ASCII_LF or byte == Character::ASCII_CR

        def is_json_hex_digit(byte: u8) -> bool:
            return true if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE
            return true if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_A and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_F
            return byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_UPPER_A and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_UPPER_F

        def json_hex_digit_value(byte: u8) -> u64:
            if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE:
                return (byte - Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO).u64()
            if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_A and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_F:
                return (byte - Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_A).u64() + JsonWire::JSON_HEX_ALPHA_BASE
            return (byte - Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_UPPER_A).u64() + JsonWire::JSON_HEX_ALPHA_BASE

        def decode_json_string(payload: u8&, start: usize, end: usize) -> DecodedJSONString:
            decoded: mutable DecodedJSONString = zeroed
            decoded.valid <- true
            decoded.ascii_only <- true
            index: mutable usize = start
            while index < end:
                character: mutable u8 = payload[index]
                if character == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH:
                    index <- index + 1
                    return DecodedJSONString{valid: false, ascii_only: false, hash: 0, length: 0} if index >= end
                    escape: u8 = payload[index]
                    if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_U:
                        return DecodedJSONString{valid: false, ascii_only: false, hash: 0, length: 0} if end - index <= JsonWire::JSON_UNICODE_ESCAPE_DIGITS
                        codepoint: mutable u64 = 0
                        hex_index: mutable usize = 0
                        while hex_index < JsonWire::JSON_UNICODE_ESCAPE_DIGITS:
                            digit_byte: u8 = payload[index + 1 + hex_index]
                            return DecodedJSONString{valid: false, ascii_only: false, hash: 0, length: 0} if not is_json_hex_digit(digit_byte)
                            codepoint <- codepoint * JsonWire::JSON_HEX_BASE + json_hex_digit_value(digit_byte)
                            hex_index <- hex_index + 1
                        if codepoint <= JsonWire::JSON_ASCII_MAX.u64():
                            character <- codepoint.u8()
                        else:
                            decoded.ascii_only <- false
                        index <- index + JsonWire::JSON_UNICODE_ESCAPE_DIGITS + 1
                    else:
                        if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE:
                            character <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE
                        else:
                            if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH:
                                character <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH
                            else:
                                if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_SLASH:
                                    character <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_SLASH
                                else:
                                    if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_B:
                                        character <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSPACE
                                    else:
                                        if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_F:
                                            character <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_FORM_FEED
                                        else:
                                            if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_N:
                                                character <- Character::ASCII_LF
                                            else:
                                                if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_R:
                                                    character <- Character::ASCII_CR
                                                else:
                                                    if escape == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_T:
                                                        character <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_TAB
                                                    else:
                                                        return DecodedJSONString{valid: false, ascii_only: false, hash: 0, length: 0}
                        index <- index + 1
                else:
                    decoded.ascii_only <- false if character > JsonWire::JSON_ASCII_MAX
                    index <- index + 1
                if decoded.ascii_only and decoded.length < CommandDispatch::MAX_KNOWN_DAP_COMMAND_LENGTH:
                    decoded.hash <- decoded.hash * CommandDispatch::DAP_HASH_MULTIPLIER + character.u64()
                decoded.length <- decoded.length + 1
            decoded.hash <- 0 if not decoded.ascii_only or decoded.length > CommandDispatch::MAX_KNOWN_DAP_COMMAND_LENGTH
            return decoded

        # Hashes accelerate dispatch, but exact decoded spelling decides the
        # command. This also recognizes valid JSON Unicode escapes for ASCII
        # command characters while preventing rolling-hash collisions.
        def dap_json_string_matches_ascii(payload: u8&, start: usize, end: usize, expected: cstr, expected_length: usize) -> bool:
            cursor: mutable usize = start
            expected_index: mutable usize = 0
            while cursor < end:
                character: mutable u64 = 0
                if payload[cursor] == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH:
                    cursor <- cursor + 1
                    return false if cursor >= end or payload[cursor] != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_U
                    return false if end - cursor < JsonWire::JSON_UNICODE_ESCAPE_DIGITS + JsonWire::JSON_UNICODE_ESCAPE_MARKER_BYTES
                    for offset in JsonWire::JSON_UNICODE_ESCAPE_MARKER_BYTES..<(JsonWire::JSON_UNICODE_ESCAPE_DIGITS + JsonWire::JSON_UNICODE_ESCAPE_MARKER_BYTES):
                        digit: u8 = payload[cursor + offset]
                        return false if not is_json_hex_digit(digit)
                        character <- character * JsonWire::JSON_HEX_BASE + json_hex_digit_value(digit)
                    cursor <- cursor + JsonWire::JSON_UNICODE_ESCAPE_DIGITS + JsonWire::JSON_UNICODE_ESCAPE_MARKER_BYTES
                else:
                    character <- payload[cursor].u64()
                    cursor <- cursor + 1
                return false if expected_index >= expected_length
                return false if character > JsonWire::JSON_ASCII_MAX.u64()
                return false if character != expected[expected_index].u64()
                expected_index <- expected_index + 1
            return expected_index == expected_length

        def decoder_json_prepare_top_level_key(decoder: mutable Decoder&, start: usize, end: usize) -> void:
            decoder.command_prefix_position <- 0
            decoder.type_prefix_position <- 0
            decoder.sequence_prefix_position <- 0
            if dap_json_string_matches_ascii(decoder.payload[0], start, end, RequestFields::ROOT_SEQ_KEY, RequestFields::ROOT_SEQ_KEY_LENGTH):
                decoder.sequence_prefix_position <- FrameParsing::SEQUENCE_PREFIX_FINAL_POSITION - 1
            else:
                if dap_json_string_matches_ascii(decoder.payload[0], start, end, RequestFields::ROOT_TYPE_KEY, RequestFields::ROOT_TYPE_KEY_LENGTH):
                    decoder.type_prefix_position <- FrameParsing::TYPE_PREFIX_FINAL_POSITION - 2
                else:
                    if dap_json_string_matches_ascii(decoder.payload[0], start, end, RequestFields::ROOT_COMMAND_KEY, RequestFields::ROOT_COMMAND_KEY_LENGTH):
                        decoder.command_prefix_position <- RequestFields::COMMAND_PREFIX_FINAL_POSITION - 2

        def decoder_json_accept_raw_utf8_byte(decoder: mutable Decoder&, byte: u8) -> bool:
            if decoder.json_utf8_continuations_remaining > 0:
                return false if byte < decoder.json_utf8_next_byte_min or byte > decoder.json_utf8_next_byte_max
                decoder.json_utf8_continuations_remaining <- decoder.json_utf8_continuations_remaining - 1
                decoder.json_utf8_next_byte_min <- JsonWire::JSON_UTF8_CONTINUATION_MIN
                decoder.json_utf8_next_byte_max <- JsonWire::JSON_UTF8_CONTINUATION_MAX
                return true
            if byte >= JsonWire::JSON_UTF8_TWO_BYTE_LEAD_MIN and byte <= JsonWire::JSON_UTF8_TWO_BYTE_LEAD_MAX:
                decoder.json_utf8_continuations_remaining <- JsonWire::JSON_UTF8_CONTINUATIONS_TWO_BYTE
                decoder.json_utf8_next_byte_min <- JsonWire::JSON_UTF8_CONTINUATION_MIN
                decoder.json_utf8_next_byte_max <- JsonWire::JSON_UTF8_CONTINUATION_MAX
                return true
            if byte >= JsonWire::JSON_UTF8_THREE_BYTE_LEAD_MIN and byte <= JsonWire::JSON_UTF8_THREE_BYTE_LEAD_MAX:
                decoder.json_utf8_continuations_remaining <- JsonWire::JSON_UTF8_CONTINUATIONS_THREE_BYTE
                decoder.json_utf8_next_byte_min <- JsonWire::JSON_UTF8_CONTINUATION_MIN
                decoder.json_utf8_next_byte_max <- JsonWire::JSON_UTF8_CONTINUATION_MAX
                decoder.json_utf8_next_byte_min <- JsonWire::JSON_UTF8_E0_CONTINUATION_MIN if byte == JsonWire::JSON_UTF8_E0_LEAD
                decoder.json_utf8_next_byte_max <- JsonWire::JSON_UTF8_ED_CONTINUATION_MAX if byte == JsonWire::JSON_UTF8_ED_LEAD
                return true
            if byte >= JsonWire::JSON_UTF8_FOUR_BYTE_LEAD_MIN and byte <= JsonWire::JSON_UTF8_FOUR_BYTE_LEAD_MAX:
                decoder.json_utf8_continuations_remaining <- JsonWire::JSON_UTF8_CONTINUATIONS_FOUR_BYTE
                decoder.json_utf8_next_byte_min <- JsonWire::JSON_UTF8_CONTINUATION_MIN
                decoder.json_utf8_next_byte_max <- JsonWire::JSON_UTF8_CONTINUATION_MAX
                decoder.json_utf8_next_byte_min <- JsonWire::JSON_UTF8_F0_CONTINUATION_MIN if byte == JsonWire::JSON_UTF8_F0_LEAD
                decoder.json_utf8_next_byte_max <- JsonWire::JSON_UTF8_F4_CONTINUATION_MAX if byte == JsonWire::JSON_UTF8_F4_LEAD
                return true
            return false

        def exact_dap_command_hash(payload: u8&, start: usize, end: usize, candidate_hash: u64) -> u64:
            return CommandDispatch::COMMAND_HASH_INITIALIZE if candidate_hash == CommandDispatch::COMMAND_HASH_INITIALIZE and dap_json_string_matches_ascii(payload, start, end, Initialize::DAP_INIT_COMMAND, Initialize::DAP_INIT_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_LAUNCH if candidate_hash == CommandDispatch::COMMAND_HASH_LAUNCH and dap_json_string_matches_ascii(payload, start, end, Launch::DAP_LAUNCH_COMMAND, Launch::DAP_LAUNCH_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_CONFIGURATION_DONE if candidate_hash == CommandDispatch::COMMAND_HASH_CONFIGURATION_DONE and dap_json_string_matches_ascii(payload, start, end, Configuration::DAP_CONFIGURATION_DONE_COMMAND, Configuration::DAP_CONFIGURATION_DONE_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_CONTINUE if candidate_hash == CommandDispatch::COMMAND_HASH_CONTINUE and dap_json_string_matches_ascii(payload, start, end, ExecutionControl::DAP_CONTINUE_COMMAND, ExecutionControl::DAP_CONTINUE_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_NEXT if candidate_hash == CommandDispatch::COMMAND_HASH_NEXT and dap_json_string_matches_ascii(payload, start, end, ExecutionControl::DAP_NEXT_COMMAND, ExecutionControl::DAP_NEXT_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_STEP_BACK if candidate_hash == CommandDispatch::COMMAND_HASH_STEP_BACK and dap_json_string_matches_ascii(payload, start, end, ExecutionControl::DAP_STEP_BACK_COMMAND, ExecutionControl::DAP_STEP_BACK_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_PAUSE if candidate_hash == CommandDispatch::COMMAND_HASH_PAUSE and dap_json_string_matches_ascii(payload, start, end, ExecutionControl::DAP_PAUSE_COMMAND, ExecutionControl::DAP_PAUSE_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_THREADS if candidate_hash == CommandDispatch::COMMAND_HASH_THREADS and dap_json_string_matches_ascii(payload, start, end, Threads::DAP_THREADS_COMMAND, Threads::DAP_THREADS_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_STACK_TRACE if candidate_hash == CommandDispatch::COMMAND_HASH_STACK_TRACE and dap_json_string_matches_ascii(payload, start, end, StackTraceCommand::DAP_STACK_TRACE_COMMAND, StackTraceCommand::DAP_STACK_TRACE_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_SCOPES if candidate_hash == CommandDispatch::COMMAND_HASH_SCOPES and dap_json_string_matches_ascii(payload, start, end, Scopes::DAP_SCOPES_COMMAND, Scopes::DAP_SCOPES_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_VARIABLES if candidate_hash == CommandDispatch::COMMAND_HASH_VARIABLES and dap_json_string_matches_ascii(payload, start, end, Variables::DAP_VARIABLES_COMMAND, Variables::DAP_VARIABLES_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_EVALUATE if candidate_hash == CommandDispatch::COMMAND_HASH_EVALUATE and dap_json_string_matches_ascii(payload, start, end, Evaluate::DAP_EVALUATE_COMMAND, Evaluate::DAP_EVALUATE_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_SET_BREAKPOINTS if candidate_hash == CommandDispatch::COMMAND_HASH_SET_BREAKPOINTS and dap_json_string_matches_ascii(payload, start, end, SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND, SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_SET_FUNCTION_BREAKPOINTS if candidate_hash == CommandDispatch::COMMAND_HASH_SET_FUNCTION_BREAKPOINTS and dap_json_string_matches_ascii(payload, start, end, BreakpointCommands::DAP_SET_FUNCTION_BREAKPOINTS_COMMAND, BreakpointCommands::DAP_SET_FUNCTION_BREAKPOINTS_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_SET_DATA_BREAKPOINTS if candidate_hash == CommandDispatch::COMMAND_HASH_SET_DATA_BREAKPOINTS and dap_json_string_matches_ascii(payload, start, end, BreakpointCommands::DAP_SET_DATA_BREAKPOINTS_COMMAND, BreakpointCommands::DAP_SET_DATA_BREAKPOINTS_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_READ_MEMORY if candidate_hash == CommandDispatch::COMMAND_HASH_READ_MEMORY and dap_json_string_matches_ascii(payload, start, end, Memory::DAP_READ_MEMORY_COMMAND, Memory::DAP_READ_MEMORY_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_STEP_IN if candidate_hash == CommandDispatch::COMMAND_HASH_STEP_IN and dap_json_string_matches_ascii(payload, start, end, ExecutionControl::DAP_STEP_IN_COMMAND, ExecutionControl::DAP_STEP_IN_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_STEP_OUT if candidate_hash == CommandDispatch::COMMAND_HASH_STEP_OUT and dap_json_string_matches_ascii(payload, start, end, ExecutionControl::DAP_STEP_OUT_COMMAND, ExecutionControl::DAP_STEP_OUT_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_REVERSE_CONTINUE if candidate_hash == CommandDispatch::COMMAND_HASH_REVERSE_CONTINUE and dap_json_string_matches_ascii(payload, start, end, ExecutionControl::DAP_REVERSE_CONTINUE_COMMAND, ExecutionControl::DAP_REVERSE_CONTINUE_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_DISCONNECT if candidate_hash == CommandDispatch::COMMAND_HASH_DISCONNECT and dap_json_string_matches_ascii(payload, start, end, Lifecycle::DAP_DISCONNECT_COMMAND, Lifecycle::DAP_DISCONNECT_COMMAND_LENGTH)
            return CommandDispatch::COMMAND_HASH_TERMINATE if candidate_hash == CommandDispatch::COMMAND_HASH_TERMINATE and dap_json_string_matches_ascii(payload, start, end, Lifecycle::DAP_TERMINATE_COMMAND, Lifecycle::DAP_TERMINATE_COMMAND_LENGTH)
