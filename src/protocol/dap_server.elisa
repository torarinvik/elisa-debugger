                        decoder_json_fail(decoder)
                        return
                    decoder.json_nesting[decoder.json_nesting_count] <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACKET_OPEN
                    decoder.json_states[decoder.json_nesting_count] <- JsonWire::JSON_STATE_ARRAY_VALUE_OR_END
                    decoder.json_nesting_count <- decoder.json_nesting_count + 1
                    decoder.json_array_depth <- decoder.json_array_depth + 1
