            if byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_SPACE and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_TAB and byte != Character::ASCII_LF and byte != Character::ASCII_CR:
                if not decoder.json_has_content:
                    decoder.json_first <- byte
                    decoder.json_has_content <- true
                decoder.json_last <- byte
            command_context: bool = decoder.in_command or decoder_json_top_level_field_context(decoder, decoder.command_prefix_position, RequestFields::COMMAND_PREFIX_FINAL_POSITION, byte)
            if command_context:
                if not decoder.in_command:
                    if command_prefix_matches(decoder.command_prefix_position, byte):
                        decoder.command_prefix_position <- decoder.command_prefix_position + 1
                        if decoder.command_prefix_position == RequestFields::COMMAND_PREFIX_LENGTH:
                            if decoder.command_seen:
                                decoder_fail(decoder)
