                decoder_json_fail(decoder)
                return
            if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_OPEN:
                if decoder.json_nesting_count >= JsonWire::PROTOCOL_DAP_SERVER_JSON_WIRE_JSON_NESTING_CAPACITY:
                    decoder_json_fail(decoder)
