        const COMMAND_HASH_SET_BREAKPOINTS: u64 = 12884271682976838880
        const COMMAND_HASH_SET_DATA_BREAKPOINTS: u64 = 11437948931016314838
        const COMMAND_HASH_STEP_IN: u64 = 3402599697
        const COMMAND_HASH_STEP_OUT: u64 = 105480596706
