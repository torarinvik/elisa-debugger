                        decoder.command_escaped <- false
                    else:
                        if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH:
                            decoder.command_escaped <- true
                        else:
                            if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE:
                                decoder.in_command <- false
                                decoder.command_seen <- true
                                decoder.command_value_end <- decoder.payload_received
                                decoded_command: DecodedJSONString = decode_json_string(decoder.payload[0], decoder.command_value_start, decoder.command_value_end)
                                if not decoded_command.valid:
                                    decoder_fail(decoder)
                                    return
                                decoder.command_hash <- exact_dap_command_hash(decoder.payload[0], decoder.command_value_start, decoder.command_value_end, decoded_command.hash)
            else:
                decoder.command_prefix_position <- 0 if not decoder.in_command
            type_context: bool = decoder.in_type or decoder_json_top_level_field_context(decoder, decoder.type_prefix_position, FrameParsing::TYPE_PREFIX_FINAL_POSITION, byte)
            if type_context:
                if not decoder.in_type:
                    if type_prefix_matches(decoder.type_prefix_position, byte):
                        decoder.type_prefix_position <- decoder.type_prefix_position + 1
                        if decoder.type_prefix_position == FrameParsing::TYPE_PREFIX_LENGTH:
                            if decoder.type_seen:
                                decoder_fail(decoder)
                                return
                            decoder.in_type <- true
                            decoder.type_escaped <- false
                            decoder.type_value_start <- decoder.payload_received + 1
                    else:
                        if is_json_whitespace(byte) and (decoder.type_prefix_position == FrameParsing::TYPE_PREFIX_LENGTH - 2 or decoder.type_prefix_position == FrameParsing::TYPE_PREFIX_LENGTH - 1):
                            decoder.type_prefix_position <- decoder.type_prefix_position
                        else:
                            decoder.type_prefix_position <- 1 if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE else 0
                else:
                    if decoder.type_escaped:
                        decoder.type_escaped <- false
                    else:
                        if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH:
                            decoder.type_escaped <- true
                        else:
                            if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE:
                                decoder.type_value_end <- decoder.payload_received
                                decoded_type: DecodedJSONString = decode_json_string(decoder.payload[0], decoder.type_value_start, decoder.type_value_end)
                                if not decoded_type.valid or not decoded_type.ascii_only or decoded_type.length != FrameParsing::TYPE_REQUEST_LENGTH or decoded_type.hash != FrameParsing::TYPE_REQUEST_HASH:
                                    decoder_fail(decoder)
                                    return
                                decoder.in_type <- false
                                decoder.type_seen <- true
            else:
                decoder.type_prefix_position <- 0 if not decoder.in_type
            sequence_context: bool = decoder.in_sequence or decoder_json_top_level_field_context(decoder, decoder.sequence_prefix_position, FrameParsing::SEQUENCE_PREFIX_FINAL_POSITION, byte)
            if sequence_context:
                if not decoder.in_sequence:
                    if sequence_prefix_matches(decoder.sequence_prefix_position, byte):
                        decoder.sequence_prefix_position <- decoder.sequence_prefix_position + 1
                        if decoder.sequence_prefix_position == FrameParsing::SEQUENCE_PREFIX_LENGTH:
                            if decoder.sequence_seen:
                                decoder_fail(decoder)
                                return
                            decoder.in_sequence <- true
                            decoder.request_sequence <- 0
                            decoder.sequence_digits <- 0
                    else:
                        if is_json_whitespace(byte) and decoder.sequence_prefix_position == FrameParsing::SEQUENCE_PREFIX_FINAL_POSITION:
                            decoder.sequence_prefix_position <- decoder.sequence_prefix_position
                        else:
                            decoder.sequence_prefix_position <- 1 if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE else 0
                else:
                    if is_json_whitespace(byte) and decoder.sequence_digits == 0:
                        decoder.sequence_digits <- 0
                    else:
                        if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE:
                            if decoder.sequence_digits == TransportLimits::FIRST_DAP_SEQUENCE_DIGIT_COUNT and decoder.request_sequence == 0:
                                decoder_fail(decoder)
                                return
                            if decoder.sequence_digits >= TransportLimits::MAX_DAP_SEQUENCE_DIGITS or decoder.request_sequence > (TransportLimits::MAX_DAP_SEQUENCE_VALUE - (byte - Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO).u64()) / NumberFormat::DAP_DECIMAL_BASE:
                                decoder_fail(decoder)
                                return
                            decoder.request_sequence <- decoder.request_sequence * NumberFormat::DAP_DECIMAL_BASE + (byte - Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO).u64()
                            decoder.sequence_digits <- decoder.sequence_digits + 1
                            decoder.sequence_seen <- true
                        else:
                            if byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_COMMA and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_CLOSE and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_SPACE and byte != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_TAB and byte != Character::ASCII_LF and byte != Character::ASCII_CR:
                                decoder_fail(decoder)
                                return
                            decoder.in_sequence <- false
            else:
                decoder.sequence_prefix_position <- 0 if not decoder.in_sequence

        def decoder_fail(decoder: mutable Decoder&) -> void:
            decoder.state <- FrameParsing::DECODER_FAILED_STATE

        def decoder_accept(decoder: mutable Decoder&, byte: u8) -> bool:
            return false if decoder.state == FrameParsing::DECODER_FAILED_STATE
            if decoder.state == FrameParsing::DECODER_HEADER_STATE:
                if decoder.header_bytes >= TransportLimits::MAX_DAP_HEADER_BYTES:
                    decoder_fail(decoder)
                    return false
                decoder.header_bytes <- decoder.header_bytes + NumberFormat::DAP_HEADER_BYTE_INCREMENT
                if decoder.header_prefix_position < FrameParsing::HEADER_PREFIX_LENGTH:
                    if not header_prefix_matches(decoder.header_prefix_position, byte):
                        decoder_fail(decoder)
                        return false
                    decoder.header_prefix_position <- decoder.header_prefix_position + 1
                    return false
                if decoder.header_tail == FrameParsing::HEADER_TAIL_NONE:
                    if byte >= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO and byte <= Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_NINE:
                        if decoder.header_digits >= TransportLimits::MAX_DAP_HEADER_DIGITS:
                            decoder_fail(decoder)
                            return false
                        digit: usize = (byte - Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_ZERO).usize()
                        if decoder.content_length > (TransportLimits::MAX_DAP_PAYLOAD - digit) / NumberFormat::DAP_DECIMAL_BASE.usize():
                            decoder_fail(decoder)
                            return false
                        decoder.content_length <- decoder.content_length * NumberFormat::DAP_DECIMAL_BASE.usize() + digit
                        decoder.header_digits <- decoder.header_digits + 1
                        return false
                    if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_SPACE:
                        return false
                    if byte == Character::ASCII_CR:
                        return false if decoder.header_digits == 0
                        decoder.header_tail <- FrameParsing::HEADER_TAIL_CR
                        return false
                    decoder_fail(decoder)
                    return false
                if decoder.header_tail == FrameParsing::HEADER_TAIL_CR:
                    if byte == Character::ASCII_LF:
                        decoder.header_tail <- FrameParsing::HEADER_TAIL_CRLF
                        return false
                    decoder_fail(decoder)
                    return false
                if decoder.header_tail == FrameParsing::HEADER_TAIL_CRLF:
                    if byte == Character::ASCII_CR:
                        decoder.header_tail <- FrameParsing::HEADER_TAIL_CRLFCR
                        return false
                    decoder_fail(decoder)
                    return false
                if byte == Character::ASCII_LF and decoder.header_digits > 0 and decoder.content_length > 0:
                    decoder.state <- FrameParsing::DECODER_PAYLOAD_STATE
                    decoder.payload_received <- 0
                    decoder.header_tail <- FrameParsing::HEADER_TAIL_NONE
                    decoder.header_bytes <- 0
                    return false
                decoder_fail(decoder)
                return false
            if decoder.state == FrameParsing::DECODER_PAYLOAD_STATE:
                if decoder.payload_received >= TransportLimits::MAX_DAP_PAYLOAD:
                    decoder_fail(decoder)
                    return false
                decoder.payload[decoder.payload_received] <- byte
                decoder_accept_payload_byte(decoder, byte)
                return false if decoder.state == FrameParsing::DECODER_FAILED_STATE
                decoder.payload_received <- decoder.payload_received + 1
                if decoder.payload_received == decoder.content_length:
                    if not decoder.command_seen or not decoder.type_seen or not decoder.sequence_seen or decoder.request_sequence < TransportLimits::DAP_MIN_REQUEST_SEQUENCE or decoder.in_command or decoder.in_type or decoder.in_sequence or not decoder.json_has_content or decoder.json_first != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_OPEN or decoder.json_last != Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_CLOSE or decoder.json_object_depth != 0 or decoder.json_array_depth != 0 or decoder.json_nesting_count != 0 or decoder.json_in_string or decoder.json_escaped or decoder.json_unicode_digits != 0 or decoder.json_utf8_continuations_remaining != 0 or decoder.json_in_primitive or not decoder.json_closed or decoder.json_structural_invalid:
                        decoder_fail(decoder)
                        return false
                    decoder.last_payload_length <- decoder.content_length
                    decoder.state <- FrameParsing::DECODER_HEADER_STATE
                    decoder.header_tail <- FrameParsing::HEADER_TAIL_NONE
                    decoder.content_length <- 0
                    decoder.header_bytes <- 0
                    decoder.header_digits <- 0
                    decoder.header_prefix_position <- 0
                    decoder.payload_received <- 0
                    decoder.command_prefix_position <- 0
                    decoder.in_command <- false
                    decoder.command_escaped <- false
                    decoder.command_seen <- false
                    decoder.type_prefix_position <- 0
                    decoder.in_type <- false
                    decoder.type_escaped <- false
                    decoder.type_seen <- false
                    decoder.sequence_prefix_position <- 0
                    decoder.in_sequence <- false
                    decoder.sequence_seen <- false
                    decoder.json_has_content <- false
                    decoder.json_first <- 0
                    decoder.json_last <- 0
                    decoder.json_object_depth <- 0
                    decoder.json_array_depth <- 0
                    decoder.json_nesting_count <- 0
                    decoder.json_in_string <- false
                    decoder.json_string_is_key <- false
                    decoder.json_escaped <- false
                    decoder.json_unicode_digits <- 0
                    decoder.json_utf8_continuations_remaining <- 0
                    decoder.json_utf8_next_byte_min <- 0
                    decoder.json_utf8_next_byte_max <- 0
                    decoder.json_key_value_start <- 0
                    decoder.json_in_primitive <- false
                    decoder.json_primitive_kind <- 0
                    decoder.json_primitive_number_state <- 0
                    decoder.json_primitive_literal_position <- 0
                    decoder.json_primitive_valid <- false
                    decoder.json_root_state <- JsonWire::JSON_STATE_ROOT_VALUE
                    decoder.json_closed <- false
                    decoder.json_structural_invalid <- false
                    return true
                return false
            decoder_fail(decoder)
            return false

        def decimal_digits(value: u64) -> usize:
            count: mutable usize = 1
            remaining: mutable u64 = value
            while remaining >= NumberFormat::DAP_DECIMAL_BASE:
                remaining <- remaining / NumberFormat::DAP_DECIMAL_BASE
                count <- count + 1
            return count

        def json_hex_digit(value: u8) -> u8:
            return LogpointOutput::ASCII_ZERO + value if value < LogpointOutput::HEX_ALPHA_BASE
            return LogpointOutput::HEX_ALPHA_OFFSET + value

        def log_output_escaped_length(bytes: u8&, length: usize) -> usize:
            escaped_length: mutable usize = 0
            for index in 0..<length:
                byte: u8 = bytes[index]
                if byte == LogpointOutput::ASCII_BACKSLASH or byte == LogpointOutput::ASCII_QUOTE or byte == LogpointOutput::ASCII_BACKSPACE or byte == LogpointOutput::ASCII_TAB or byte == LogpointOutput::ASCII_LINE_FEED or byte == LogpointOutput::ASCII_FORM_FEED or byte == LogpointOutput::ASCII_CARRIAGE_RETURN:
                    escaped_length <- escaped_length + LogpointOutput::JSON_PAIR_LENGTH
                else:
                    escaped_length <- escaped_length + LogpointOutput::HEX_ESCAPE_LENGTH if byte < LogpointOutput::ASCII_SPACE
                    escaped_length <- escaped_length + 1 if byte >= LogpointOutput::ASCII_SPACE
            return escaped_length

        def write_log_output_json_string(bytes: u8&, length: usize) -> void can[Console, Unsafe.PointerCast]:
            for index in 0..<length:
                byte: u8 = bytes[index]
                if byte == LogpointOutput::ASCII_BACKSLASH or byte == LogpointOutput::ASCII_QUOTE:
                    _ = printf("%c%c", LogpointOutput::ASCII_BACKSLASH, byte) can Console
                else:
                    if byte == LogpointOutput::ASCII_BACKSPACE:
                        _ = printf("%c%c", LogpointOutput::ASCII_BACKSLASH, LogpointOutput::ASCII_LOWER_B) can Console
                    else:
                        if byte == LogpointOutput::ASCII_FORM_FEED:
                            _ = printf("%c%c", LogpointOutput::ASCII_BACKSLASH, LogpointOutput::ASCII_LOWER_F) can Console
                        else:
                            if byte == LogpointOutput::ASCII_LINE_FEED:
                                _ = printf("%c%c", LogpointOutput::ASCII_BACKSLASH, LogpointOutput::ASCII_LOWER_N) can Console
                            else:
                                if byte == LogpointOutput::ASCII_CARRIAGE_RETURN:
                                    _ = printf("%c%c", LogpointOutput::ASCII_BACKSLASH, LogpointOutput::ASCII_LOWER_R) can Console
                                else:
                                    if byte == LogpointOutput::ASCII_TAB:
                                        _ = printf("%c%c", LogpointOutput::ASCII_BACKSLASH, LogpointOutput::ASCII_LOWER_T) can Console
                                    else:
                                        if byte < LogpointOutput::ASCII_SPACE:
                                            _ = printf("%c%c%c%c%c%c", LogpointOutput::ASCII_BACKSLASH, LogpointOutput::ASCII_LOWER_U, LogpointOutput::ASCII_ZERO, LogpointOutput::ASCII_ZERO, json_hex_digit(byte / LogpointOutput::HEX_BASE), json_hex_digit(byte % LogpointOutput::HEX_BASE)) can Console
                                        else:
                                            _ = printf("%c", byte) can Console

        def write_log_output_event(bytes: u8&, length: usize, outbound_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            body_length: usize = LogpointOutput::MINIMAL_FRAME_LENGTH + decimal_digits(outbound_sequence) + log_output_escaped_length(bytes, length)
            _ = printf("Content-Length: %llu\r\n\r\n", body_length.u64()) can Console
            _ = printf("%s", Events::DAP_EVENT_PREFIX) can Console
            _ = printf("%llu", outbound_sequence) can Console
            _ = printf("%s", Events::DAP_EVENT_MIDDLE) can Console
            _ = printf("%s", LogpointOutput::EVENT_NAME) can Console
            _ = printf("%s", Events::DAP_EVENT_NAME_END) can Console
            _ = printf("%s", Events::DAP_EVENT_BODY_FIELD) can Console
            _ = printf("%s", LogpointOutput::BODY_PREFIX) can Console
            write_log_output_json_string(bytes, length) can Console, Unsafe.PointerCast
            _ = printf("%s", LogpointOutput::BODY_SUFFIX) can Console

        def command_can_emit_log_output(command_hash: u64) -> bool:
            return true if command_hash == CommandDispatch::COMMAND_HASH_CONTINUE or command_hash == CommandDispatch::COMMAND_HASH_NEXT or command_hash == CommandDispatch::COMMAND_HASH_STEP_IN or command_hash == CommandDispatch::COMMAND_HASH_STEP_OUT
            return false

        def adapter_event_name(kind: DebuggerDAP::EventKind) -> cstr:
            return Events::DAP_EVENT_INITIALIZED_NAME if kind == DebuggerDAP::EventKind.Initialized
            return Events::DAP_EVENT_CONTINUED_NAME if kind == DebuggerDAP::EventKind.Continued
            return Events::DAP_EVENT_STOPPED_NAME if kind == DebuggerDAP::EventKind.Stopped
            return Events::DAP_EVENT_TERMINATED_NAME if kind == DebuggerDAP::EventKind.Terminated
            return Events::DAP_EVENT_EXITED_NAME

        def adapter_event_name_length(kind: DebuggerDAP::EventKind) -> usize:
            return Events::DAP_EVENT_INITIALIZED_NAME_LENGTH if kind == DebuggerDAP::EventKind.Initialized
            return Events::DAP_EVENT_CONTINUED_NAME_LENGTH if kind == DebuggerDAP::EventKind.Continued
            return Events::DAP_EVENT_STOPPED_NAME_LENGTH if kind == DebuggerDAP::EventKind.Stopped
            return Events::DAP_EVENT_TERMINATED_NAME_LENGTH if kind == DebuggerDAP::EventKind.Terminated
            return Events::DAP_EVENT_EXITED_NAME_LENGTH

        def adapter_event_reason_name(reason: DebuggerDAP::StopReason) -> cstr:
            return Events::DAP_EVENT_REASON_STEP if reason == DebuggerDAP::StopReason.Step
            return Events::DAP_EVENT_REASON_PAUSE if reason == DebuggerDAP::StopReason.Pause
            return Events::DAP_EVENT_REASON_BREAKPOINT

        def adapter_event_reason_name_length(reason: DebuggerDAP::StopReason) -> usize:
            return Events::DAP_EVENT_REASON_STEP_LENGTH if reason == DebuggerDAP::StopReason.Step
            return Events::DAP_EVENT_REASON_PAUSE_LENGTH if reason == DebuggerDAP::StopReason.Pause
            return Events::DAP_EVENT_REASON_BREAKPOINT_LENGTH

        def adapter_event_has_body(event: DebuggerDAP::AdapterEvent) -> bool:
            return event.kind == DebuggerDAP::EventKind.Continued or event.kind == DebuggerDAP::EventKind.Stopped or event.kind == DebuggerDAP::EventKind.Exited

        def adapter_event_body_length(event: DebuggerDAP::AdapterEvent) -> usize:
            if event.kind == DebuggerDAP::EventKind.Continued:
                return Events::DAP_EVENT_CONTINUED_BODY_PREFIX_LENGTH + decimal_digits(RuntimeIdentifiers::DAP_MAIN_THREAD_ID) + Events::DAP_EVENT_CONTINUED_BODY_SUFFIX_LENGTH
            if event.kind == DebuggerDAP::EventKind.Stopped:
                return Events::DAP_EVENT_STOPPED_BODY_PREFIX_LENGTH + adapter_event_reason_name_length(event.reason) + Events::DAP_EVENT_STOPPED_THREAD_FIELD_LENGTH + decimal_digits(RuntimeIdentifiers::DAP_MAIN_THREAD_ID) + Events::DAP_EVENT_STOPPED_BODY_SUFFIX_LENGTH
            if event.kind == DebuggerDAP::EventKind.Exited:
                return Events::DAP_EVENT_EXIT_BODY_PREFIX_LENGTH + signed_decimal_digits(event.exit_code) + Events::DAP_EVENT_EXIT_BODY_SUFFIX_LENGTH
            return 0

        def write_adapter_event(event: DebuggerDAP::AdapterEvent, outbound_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            has_body: bool = adapter_event_has_body(event)
            suffix_length: usize = Events::DAP_EVENT_NO_BODY_SUFFIX_LENGTH if not has_body else Events::DAP_EVENT_NAME_END_LENGTH + Events::DAP_EVENT_BODY_FIELD_LENGTH + adapter_event_body_length(event) + Events::DAP_EVENT_OBJECT_END_LENGTH
            frame_length: u64 = (Events::DAP_EVENT_PREFIX_LENGTH + decimal_digits(outbound_sequence) + Events::DAP_EVENT_MIDDLE_LENGTH + adapter_event_name_length(event.kind) + suffix_length).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", frame_length) can Console
            _ = printf("%s", Events::DAP_EVENT_PREFIX) can Console
            _ = printf("%llu", outbound_sequence) can Console
            _ = printf("%s", Events::DAP_EVENT_MIDDLE) can Console
            _ = printf("%s", adapter_event_name(event.kind)) can Console
            if not has_body:
                _ = printf("%s", Events::DAP_EVENT_NO_BODY_SUFFIX) can Console
                return
            _ = printf("%s", Events::DAP_EVENT_NAME_END) can Console
            _ = printf("%s", Events::DAP_EVENT_BODY_FIELD) can Console
            if event.kind == DebuggerDAP::EventKind.Continued:
                _ = printf("%s", Events::DAP_EVENT_CONTINUED_BODY_PREFIX) can Console
                _ = printf("%llu", RuntimeIdentifiers::DAP_MAIN_THREAD_ID) can Console
                _ = printf("%s", Events::DAP_EVENT_CONTINUED_BODY_SUFFIX) can Console
            if event.kind == DebuggerDAP::EventKind.Stopped:
                _ = printf("%s", Events::DAP_EVENT_STOPPED_BODY_PREFIX) can Console
                _ = printf("%s", adapter_event_reason_name(event.reason)) can Console
                _ = printf("%s", Events::DAP_EVENT_STOPPED_THREAD_FIELD) can Console
                _ = printf("%llu", RuntimeIdentifiers::DAP_MAIN_THREAD_ID) can Console
                _ = printf("%s", Events::DAP_EVENT_STOPPED_BODY_SUFFIX) can Console
            if event.kind == DebuggerDAP::EventKind.Exited:
                _ = printf("%s", Events::DAP_EVENT_EXIT_BODY_PREFIX) can Console
                _ = printf("%lld", event.exit_code) can Console
                _ = printf("%s", Events::DAP_EVENT_EXIT_BODY_SUFFIX) can Console
            _ = printf("%s", Events::DAP_EVENT_OBJECT_END) can Console

        def write_dynamic_response(response_sequence: u64, request_sequence: u64, command: cstr, command_length: usize, suffix: cstr, suffix_length: usize) -> void can[Console, Unsafe.PointerCast]:
            body_length: u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + command_length + suffix_length + JsonWire::DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            _ = printf(command) can Console
            _ = printf(suffix) can Console

        # Echo the validated command token for unknown DAP requests. Keeping
        # its original JSON escapes preserves the request's exact string value.
        def write_unknown_command_response(response_sequence: u64, request_sequence: u64, payload: u8&, command_start: usize, command_end: usize) -> void can[Console, Unsafe.PointerCast]:
            command_length: usize = command_end - command_start
            body_length: u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + command_length + ResponseStatus::DAP_UNSUPPORTED_SUFFIX_LENGTH + JsonWire::DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            for index in command_start..<command_end:
                _ = printf("%c", payload[index].i32()) can Console
            _ = printf(ResponseStatus::DAP_UNSUPPORTED_SUFFIX) can Console, Unsafe.PointerCast

        struct DAPSourceLocation:
            line: mutable u64
            column: mutable u64
            source_path_bytes: mutable u8[StackTraceSourcePath::DAP_STACK_SOURCE_PATH_CAPACITY]
            source_path_length: mutable usize
            source_name_start: mutable usize
            source_name_length: mutable usize
            has_source: mutable bool

        struct DAPRequestContext:
            stack_start_frame: mutable usize
            stack_levels: mutable usize
            stack_has_levels: mutable bool
            scope_frame_index: mutable usize
            evaluate_value: mutable i64
            function_breakpoints: mutable DebuggerManagedService::FunctionBreakpointResult

        def stack_source_location(service: DebuggerManagedService::Service, source: DebuggerIdentity::SourceSpan, has_source: bool, coordinates: DebuggerDAPPayload::ClientCoordinates) -> DAPSourceLocation:
            location: mutable DAPSourceLocation = zeroed
            location.line <- ResponseMetadata::DAP_UNKNOWN_SOURCE_LINE
            location.column <- ResponseMetadata::DAP_UNKNOWN_SOURCE_LINE
            return location if not has_source or DebuggerIdentity::debug_id_is_zero(source.file) or source.start_line == ResponseMetadata::DAP_UNKNOWN_SOURCE_LINE
            line: mutable u64 = source.start_line.u64()
            column: mutable u64 = source.start_column.u64()
            line <- line - SourceBreakpoints::DAP_SOURCE_BREAKPOINT_LINE_INCREMENT if not coordinates.lines_start_at_one
            column <- column + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_COLUMN_INCREMENT if coordinates.columns_start_at_one
            location.line <- line
            location.column <- column
            if service.controller.engine.image.source_file_count <= DebuggerEDIR::source_file_capacity():
                for file_index in StackTraceSourcePath::FIRST_SOURCE_FILE_INDEX..<service.controller.engine.image.source_file_count:
                    file: DebuggerMetadata::SourceFile = service.controller.engine.image.source_files[file_index]
                    continue if file.id.value != source.file.value or file.path_length == StackTraceSourcePath::EMPTY_PATH_LENGTH or file.path_length > DebuggerMetadata::source_path_capacity()
                    root_length: usize = service.controller.source_path_root_length
                    return location if root_length > StackTraceSourcePath::DAP_STACK_SOURCE_PATH_CAPACITY
                    separator_count: usize = StackTraceSourcePath::PATH_SEPARATOR_COUNT if root_length > StackTraceSourcePath::DISABLED_ROOT_LENGTH and service.controller.source_path_root[root_length - StackTraceSourcePath::PATH_INDEX_INCREMENT] != StackTraceSourcePath::PATH_SEPARATOR else StackTraceSourcePath::EMPTY_PATH_LENGTH
                    prefix_length: usize = root_length + separator_count
                    return location if prefix_length > StackTraceSourcePath::DAP_STACK_SOURCE_PATH_CAPACITY or file.path_length > StackTraceSourcePath::DAP_STACK_SOURCE_PATH_CAPACITY - prefix_length
                    if root_length > StackTraceSourcePath::DISABLED_ROOT_LENGTH:
                        for path_index in StackTraceSourcePath::FIRST_PATH_BYTE_INDEX..<root_length:
                            location.source_path_bytes[path_index] <- service.controller.source_path_root[path_index]
                        location.source_path_length <- root_length
                        if separator_count > StackTraceSourcePath::EMPTY_PATH_LENGTH:
                            location.source_path_bytes[location.source_path_length] <- StackTraceSourcePath::PATH_SEPARATOR
                            location.source_path_length <- location.source_path_length + separator_count
                    for path_index in StackTraceSourcePath::FIRST_PATH_BYTE_INDEX..<file.path_length:
                        location.source_path_bytes[location.source_path_length + path_index] <- file.path_bytes[path_index]
                    location.source_path_length <- location.source_path_length + file.path_length
                    location.source_name_start <- StackTraceSourcePath::EMPTY_NAME_START
                    for path_index in StackTraceSourcePath::FIRST_PATH_BYTE_INDEX..<location.source_path_length:
                        location.source_name_start <- path_index + StackTraceSourcePath::PATH_INDEX_INCREMENT if location.source_path_bytes[path_index] == StackTraceSourcePath::PATH_SEPARATOR
                    location.source_name_length <- location.source_path_length - location.source_name_start
                    location.has_source <- true
                    return location
            return location

        def json_string_encoded_length(bytes: u8&, start: usize, length: usize) -> usize:
            encoded_length: mutable usize = length + JsonWire::DAP_JSON_STRING_QUOTE_BYTES
            for index in start..<(start + length):
                encoded_length <- encoded_length + 1 if bytes[index] == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE or bytes[index] == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH
            return encoded_length

        def write_json_string(bytes: u8&, start: usize, length: usize) -> void can[Console, Unsafe.PointerCast]:
            _ = printf("%c", Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE.i32()) can Console
            for index in start..<(start + length):
                if bytes[index] == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE or bytes[index] == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH:
                    _ = printf("%c", Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BACKSLASH.i32()) can Console
                _ = printf("%c", bytes[index].i32()) can Console
            _ = printf("%c", Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_QUOTE.i32()) can Console

        def write_stack_response(service: DebuggerManagedService::Service, request_sequence: u64, response_sequence: u64, coordinates: DebuggerDAPPayload::ClientCoordinates, start_frame: usize, levels: usize, has_levels: bool) -> void can[Console, Unsafe.PointerCast]:
            page: DebuggerDAPFrames::StackPage = DebuggerDAPFrames::stack_trace_page(service.controller.engine.image, service.controller.engine.machine, start_frame, levels, has_levels)
            body_length: mutable u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + StackTraceCommand::DAP_STACK_TRACE_COMMAND_LENGTH + StackTraceFrameWire::RESPONSE_PREFIX_LENGTH + StackTraceFrameWire::RESPONSE_MIDDLE_LENGTH + decimal_digits(page.total_frames.u64()) + StackTraceFrameWire::RESPONSE_SUFFIX_LENGTH + JsonWire::DAP_JSON_TERMINATOR_LENGTH).u64()
            for frame_index in StackTraceSourcePath::FIRST_FRAME_PAGE_INDEX..<page.count:
                frame: DebuggerDAPFrames::FrameView = page.frames[frame_index]
                location: DAPSourceLocation = stack_source_location(service, frame.source, frame.has_source, coordinates)
                frame_id: u64 = dap_frame_id_for_generation(service.controller.session.stop_generation, frame.stack_index)
                name_length: usize = json_string_encoded_length(frame.name_bytes[StackTraceFrameWire::FIRST_NAME_BYTE_INDEX], StackTraceFrameWire::FIRST_NAME_BYTE_INDEX, frame.name_length)
                body_length <- body_length + (StackTraceFrameWire::FRAME_ID_PREFIX_LENGTH + decimal_digits(frame_id) + StackTraceFrameWire::FRAME_NAME_PREFIX_LENGTH + name_length + StackTraceFrameWire::FRAME_LINE_PREFIX_LENGTH + decimal_digits(location.line) + StackTraceFrameWire::FRAME_COLUMN_PREFIX_LENGTH + decimal_digits(location.column) + StackTraceFrameWire::FRAME_SUFFIX_LENGTH).u64()
                body_length <- body_length + StackTraceFrameWire::FRAME_SEPARATOR_LENGTH.u64() if frame_index > StackTraceSourcePath::FIRST_FRAME_PAGE_INDEX
                if location.has_source:
                    source_name_length: usize = json_string_encoded_length(location.source_path_bytes[StackTraceSourcePath::FIRST_PATH_BYTE_INDEX], location.source_name_start, location.source_name_length)
                    source_path_length: usize = json_string_encoded_length(location.source_path_bytes[StackTraceSourcePath::FIRST_PATH_BYTE_INDEX], StackTraceSourcePath::FIRST_PATH_BYTE_INDEX, location.source_path_length)
                    body_length <- body_length + (StackTraceFrameWire::FRAME_SOURCE_BEFORE_NAME_LENGTH + source_name_length + StackTraceFrameWire::FRAME_SOURCE_BETWEEN_NAME_AND_PATH_LENGTH + source_path_length + StackTraceFrameWire::FRAME_SOURCE_AFTER_PATH_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            _ = printf(StackTraceCommand::DAP_STACK_TRACE_COMMAND) can Console
            _ = printf(StackTraceFrameWire::RESPONSE_PREFIX) can Console
            for frame_index in StackTraceSourcePath::FIRST_FRAME_PAGE_INDEX..<page.count:
                frame: DebuggerDAPFrames::FrameView = page.frames[frame_index]
                location: DAPSourceLocation = stack_source_location(service, frame.source, frame.has_source, coordinates)
                frame_id: u64 = dap_frame_id_for_generation(service.controller.session.stop_generation, frame.stack_index)
                if frame_index > StackTraceSourcePath::FIRST_FRAME_PAGE_INDEX:
                    _ = printf(StackTraceFrameWire::FRAME_SEPARATOR) can Console
                _ = printf(StackTraceFrameWire::FRAME_ID_PREFIX) can Console
                _ = printf("%llu", frame_id) can Console
                _ = printf(StackTraceFrameWire::FRAME_NAME_PREFIX) can Console
                write_json_string(frame.name_bytes[StackTraceFrameWire::FIRST_NAME_BYTE_INDEX], StackTraceFrameWire::FIRST_NAME_BYTE_INDEX, frame.name_length) can Console, Unsafe.PointerCast
                _ = printf(StackTraceFrameWire::FRAME_LINE_PREFIX) can Console
                _ = printf("%llu", location.line) can Console
                _ = printf(StackTraceFrameWire::FRAME_COLUMN_PREFIX) can Console
                _ = printf("%llu", location.column) can Console
                if location.has_source:
                    _ = printf(StackTraceFrameWire::FRAME_SOURCE_BEFORE_NAME) can Console, Unsafe.PointerCast
                    write_json_string(location.source_path_bytes[StackTraceSourcePath::FIRST_PATH_BYTE_INDEX], location.source_name_start, location.source_name_length) can Console, Unsafe.PointerCast
                    _ = printf(StackTraceFrameWire::FRAME_SOURCE_BETWEEN_NAME_AND_PATH) can Console, Unsafe.PointerCast
                    write_json_string(location.source_path_bytes[StackTraceSourcePath::FIRST_PATH_BYTE_INDEX], StackTraceSourcePath::FIRST_PATH_BYTE_INDEX, location.source_path_length) can Console, Unsafe.PointerCast
                    _ = printf(StackTraceFrameWire::FRAME_SOURCE_AFTER_PATH) can Console, Unsafe.PointerCast
                _ = printf(StackTraceFrameWire::FRAME_SUFFIX) can Console
            _ = printf(StackTraceFrameWire::RESPONSE_MIDDLE) can Console
            _ = printf("%llu", page.total_frames.u64()) can Console
            _ = printf(StackTraceFrameWire::RESPONSE_SUFFIX) can Console

        def locals_reference_for_generation(generation: u64) -> u64:
            return ResponseMetadata::DAP_LOCALS_REFERENCE_FALLBACK if generation == RuntimeIdentifiers::DAP_NO_EXPECTED_GENERATION
            return generation

        def locals_reference_for_frame(generation: u64, frame_index: usize) -> u64:
            normalized_generation: u64 = locals_reference_for_generation(generation)
            frame_offset: u64 = frame_index.u64()
            stride: u64 = StackTraceLocalsReference::LOCALS_REFERENCE_STRIDE.u64()
            return RuntimeIdentifiers::DAP_NO_VARIABLE_REFERENCE if normalized_generation > (StackTraceLocalsReference::MAX_LOCALS_REFERENCE - frame_offset) / stride
            return normalized_generation * stride + frame_offset

        def locals_frame_index_for_reference(generation: u64, return_stack_depth: usize, reference: u64) -> usize:
            frame_capacity: usize = DebuggerDAPFrames::frame_capacity()
            normalized_generation: u64 = locals_reference_for_generation(generation)
            stride: u64 = StackTraceLocalsReference::LOCALS_REFERENCE_STRIDE.u64()
            return frame_capacity if return_stack_depth > DebuggerEDIR::call_depth_capacity()
            return frame_capacity if normalized_generation > StackTraceLocalsReference::MAX_LOCALS_REFERENCE / stride
            generation_base: u64 = normalized_generation * stride
            return frame_capacity if reference < generation_base
            frame_offset: u64 = reference - generation_base
            return frame_capacity if frame_offset >= frame_capacity.u64()
            frame_index: usize = frame_offset.usize()
            return frame_capacity if frame_index > return_stack_depth
            return frame_index

        def dap_frame_id_for_generation(generation: u64, frame_index: usize) -> u64:
            frame_capacity: usize = DebuggerDAPFrames::frame_capacity()
            return StackTraceFrameHandle::INVALID_FRAME_ID if frame_index >= frame_capacity
            frame_offset: u64 = frame_index.u64() + StackTraceFrameHandle::FRAME_ID_RESERVED_SLOT_COUNT.u64()
            stride: u64 = StackTraceFrameHandle::FRAME_ID_REFERENCE_STRIDE.u64()
            return StackTraceFrameHandle::INVALID_FRAME_ID if generation > (StackTraceFrameHandle::MAX_FRAME_ID_REFERENCE - frame_offset) / stride
            return generation * stride + frame_offset

        def dap_frame_index_for_id(generation: u64, return_stack_depth: usize, reference: u64) -> usize:
            frame_capacity: usize = DebuggerDAPFrames::frame_capacity()
            stride: u64 = StackTraceFrameHandle::FRAME_ID_REFERENCE_STRIDE.u64()
            return frame_capacity if return_stack_depth > DebuggerEDIR::call_depth_capacity()
            return frame_capacity if generation > StackTraceFrameHandle::MAX_FRAME_ID_REFERENCE / stride
            generation_base: u64 = generation * stride
            return frame_capacity if reference <= generation_base
            frame_offset: u64 = reference - generation_base
            return frame_capacity if frame_offset < StackTraceFrameHandle::FRAME_ID_RESERVED_SLOT_COUNT.u64() or frame_offset > frame_capacity.u64()
            frame_index: usize = (frame_offset - StackTraceFrameHandle::FRAME_ID_RESERVED_SLOT_COUNT.u64()).usize()
            return frame_capacity if frame_index > return_stack_depth
            return frame_index

        def write_scopes_response(service: DebuggerManagedService::Service, frame_index: usize, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            reference: u64 = locals_reference_for_frame(service.controller.session.stop_generation, frame_index)
            body_length: u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + Scopes::DAP_SCOPES_COMMAND_LENGTH + Scopes::DAP_SCOPES_BEFORE_REFERENCE_LENGTH + decimal_digits(reference) + Scopes::DAP_SCOPES_AFTER_REFERENCE_LENGTH + JsonWire::DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            _ = printf(Scopes::DAP_SCOPES_COMMAND) can Console
            _ = printf(Scopes::DAP_SCOPES_BEFORE_REFERENCE) can Console
            _ = printf("%llu", reference) can Console
            _ = printf(Scopes::DAP_SCOPES_AFTER_REFERENCE) can Console

        def signed_decimal_digits(value: i64) -> usize:
            magnitude: mutable u64 = value.u64()
            if value < 0:
                magnitude <- (-(value + 1)).u64() + NumberFormat::DAP_DECIMAL_INCREMENT
            count: mutable usize = NumberFormat::DAP_DIGIT_COUNT_INCREMENT
            while magnitude >= NumberFormat::DAP_DECIMAL_BASE:
                magnitude <- magnitude / NumberFormat::DAP_DECIMAL_BASE
                count <- count + NumberFormat::DAP_DIGIT_COUNT_INCREMENT
            return count + NumberFormat::DAP_DIGIT_COUNT_INCREMENT if value < 0
            return count

        def source_breakpoint_response_line(line: u32, coordinates: DebuggerDAPPayload::ClientCoordinates) -> u64:
            response_line: u64 = line.u64()
            return 0 if not coordinates.lines_start_at_one and response_line == 0
            return response_line - SourceBreakpoints::DAP_SOURCE_BREAKPOINT_LINE_INCREMENT if not coordinates.lines_start_at_one
            return response_line

        def source_breakpoint_response_column(column: u32, coordinates: DebuggerDAPPayload::ClientCoordinates) -> u64:
            response_column: mutable u64 = column.u64()
            response_column <- response_column + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_COLUMN_INCREMENT if coordinates.columns_start_at_one
            return response_column

        def write_variables_response(page: DebuggerManagedInspection::LocalPage, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            entries_length: mutable usize = 0
            for index in 0..<page.count:
                entry: DebuggerManagedInspection::LocalSnapshot = page.entries[index]
                value_length: usize = signed_decimal_digits(entry.value) if entry.available else Variables::DAP_VARIABLE_UNAVAILABLE_VALUE_LENGTH
                entry_length: usize = Variables::DAP_VARIABLE_NAME_PREFIX_LENGTH + decimal_digits(entry.index.u64()) + Variables::DAP_VARIABLE_VALUE_PREFIX_LENGTH + value_length + Variables::DAP_VARIABLE_SUFFIX_LENGTH
                entries_length <- entries_length + entry_length
                entries_length <- entries_length + NumberFormat::DAP_DIGIT_COUNT_INCREMENT if index > 0
            body_length: u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + Variables::DAP_VARIABLES_COMMAND_LENGTH + Variables::DAP_VARIABLES_BEFORE_ITEMS_LENGTH + entries_length + Variables::DAP_VARIABLES_AFTER_ITEMS_LENGTH + JsonWire::DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            _ = printf(Variables::DAP_VARIABLES_COMMAND) can Console
            _ = printf(Variables::DAP_VARIABLES_BEFORE_ITEMS) can Console
            for index in 0..<page.count:
                entry: DebuggerManagedInspection::LocalSnapshot = page.entries[index]
                if index > 0:
                    _ = printf(",") can Console
                _ = printf(Variables::DAP_VARIABLE_NAME_PREFIX) can Console
                _ = printf("%llu", entry.index.u64()) can Console
                _ = printf(Variables::DAP_VARIABLE_VALUE_PREFIX) can Console
                if entry.available:
                    _ = printf("%lld", entry.value) can Console
                else:
                    _ = printf(Variables::DAP_VARIABLE_UNAVAILABLE_VALUE) can Console
                _ = printf(Variables::DAP_VARIABLE_SUFFIX) can Console
            _ = printf(Variables::DAP_VARIABLES_AFTER_ITEMS) can Console

        def write_source_breakpoints_response(page: DebuggerManagedService::SourceBreakpointResult, coordinates: DebuggerDAPPayload::ClientCoordinates, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            body_length: mutable u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND_LENGTH + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESPONSE_PREFIX_LENGTH + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESPONSE_SUFFIX_LENGTH).u64()
            for index in 0..<page.count:
                entry: DebuggerManagedService::SourceBreakpointEntry = page.points[index]
                response_line: u64 = source_breakpoint_response_line(entry.line, coordinates)
                verified_length: usize = JsonWire::DAP_JSON_TRUE_LENGTH if entry.verified else JsonWire::DAP_JSON_FALSE_LENGTH
                body_length <- body_length + (SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ITEM_PREFIX_LENGTH + decimal_digits(entry.id.value) + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_VERIFIED_PREFIX_LENGTH + verified_length + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_LINE_PREFIX_LENGTH + decimal_digits(response_line) + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ITEM_SUFFIX_LENGTH).u64()
                if entry.has_column:
                    response_column: u64 = source_breakpoint_response_column(entry.column, coordinates)
                    body_length <- body_length + (SourceBreakpoints::DAP_SOURCE_BREAKPOINT_COLUMN_PREFIX_LENGTH + decimal_digits(response_column)).u64()
                body_length <- body_length + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_SEPARATOR_LENGTH.u64() if index > 0
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            _ = printf(SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND) can Console
            _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESPONSE_PREFIX) can Console
            for index in 0..<page.count:
                entry: DebuggerManagedService::SourceBreakpointEntry = page.points[index]
                if index > 0:
                    _ = printf(",") can Console
                _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ITEM_PREFIX) can Console
                _ = printf("%llu", entry.id.value) can Console
                _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_VERIFIED_PREFIX) can Console
                if entry.verified:
                    _ = printf("true") can Console
                else:
                    _ = printf("false") can Console
                _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_LINE_PREFIX) can Console
                response_line: u64 = source_breakpoint_response_line(entry.line, coordinates)
                _ = printf("%llu", response_line) can Console
                if entry.has_column:
                    response_column: u64 = source_breakpoint_response_column(entry.column, coordinates)
                    _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_COLUMN_PREFIX) can Console
                    _ = printf("%llu", response_column) can Console
                _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ITEM_SUFFIX) can Console
            _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESPONSE_SUFFIX) can Console

        def write_function_breakpoints_response(page: DebuggerManagedService::FunctionBreakpointResult, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            body_length: mutable u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + BreakpointCommands::DAP_SET_FUNCTION_BREAKPOINTS_COMMAND_LENGTH + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESPONSE_PREFIX_LENGTH + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESPONSE_SUFFIX_LENGTH).u64()
            for index in 0..<page.count:
                entry: DebuggerManagedService::FunctionBreakpointEntry = page.points[index]
                verified_length: usize = JsonWire::DAP_JSON_TRUE_LENGTH if entry.verified else JsonWire::DAP_JSON_FALSE_LENGTH
                body_length <- body_length + (SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ITEM_PREFIX_LENGTH + decimal_digits(entry.id.value) + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_VERIFIED_PREFIX_LENGTH + verified_length + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ITEM_SUFFIX_LENGTH).u64()
                body_length <- body_length + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_SEPARATOR_LENGTH.u64() if index > SourceBreakpoints::DAP_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            _ = printf(BreakpointCommands::DAP_SET_FUNCTION_BREAKPOINTS_COMMAND) can Console
            _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESPONSE_PREFIX) can Console
            for index in 0..<page.count:
                entry: DebuggerManagedService::FunctionBreakpointEntry = page.points[index]
                if index > SourceBreakpoints::DAP_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX:
                    _ = printf(",") can Console
                _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ITEM_PREFIX) can Console
                _ = printf("%llu", entry.id.value) can Console
                _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_VERIFIED_PREFIX) can Console
                if entry.verified:
                    _ = printf("true") can Console
                else:
                    _ = printf("false") can Console
                _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ITEM_SUFFIX) can Console
            _ = printf(SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESPONSE_SUFFIX) can Console

        def request_for(method: DebuggerProtocolRequest::RequestMethod, request_id: u64) -> DebuggerProtocolRequest::Request:
            request: mutable DebuggerProtocolRequest::Request = zeroed
            request.method <- method
            request.id <- RuntimeIdentifiers::DAP_FALLBACK_REQUEST_ID if request_id == RuntimeIdentifiers::DAP_NO_EXPECTED_GENERATION else request_id
            request.has_id <- true
            request.target_event <- 0
            request.valid <- true
            return request

        def dispatch_managed(service: mutable DebuggerManagedService::Service&, method: DebuggerProtocolRequest::RequestMethod, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            request: DebuggerProtocolRequest::Request = request_for(method, request_id)
            result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: method, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_step_out(service: mutable DebuggerManagedService::Service&, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            result: DebuggerManagedService::Result = DebuggerManagedService::service_step_out(service)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Step, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_step_in(service: mutable DebuggerManagedService::Service&, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            result: DebuggerManagedService::Result = DebuggerManagedService::service_step_into(service)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Step, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_step_over(service: mutable DebuggerManagedService::Service&, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            result: DebuggerManagedService::Result = DebuggerManagedService::service_step_over(service)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Step, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_reverse_continue(service: mutable DebuggerManagedService::Service&, request_id: u64) -> DebuggerProtocolDispatcher::DispatchResult:
            result: DebuggerManagedService::Result = DebuggerManagedService::service_reverse_continue(service)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.ReverseStep, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}

        def dispatch_memory(service: mutable DebuggerManagedService::Service&, request_id: u64, payload: u8&, payload_length: usize, memory: mutable DebuggerMemory::MemoryRead&) -> DebuggerProtocolDispatcher::DispatchResult:
            request: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(payload, payload_length)
            if not request.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_MEMORY_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Memory, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            dispatch_request_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request_for(DebuggerProtocolRequest::RequestMethod.Memory, request_id))
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Memory, accepted: false, stop_generation: service.controller.session.stop_generation, failure: dispatch_request_result.failure} if not dispatch_request_result.accepted
            memory <- DebuggerManagedService::service_memory(service, request.address, request.count)
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Memory, accepted: DebuggerMemory::memory_read_is_available(memory), stop_generation: service.controller.session.stop_generation, failure: memory.failure}

        def dispatch_variables(service: mutable DebuggerManagedService::Service&, request_id: u64, payload: u8&, payload_length: usize, page: mutable DebuggerManagedInspection::LocalPage&) -> DebuggerProtocolDispatcher::DispatchResult:
            request: DebuggerDAPPayload::VariablesRequest = DebuggerDAPPayload::variables_request_parse(payload, payload_length)
            if not request.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_VARIABLES_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Variables, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            if request.reference == RuntimeIdentifiers::DAP_NO_VARIABLE_REFERENCE:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_VARIABLES_DETAIL_ZERO_REFERENCE)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Variables, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            generation: u64 = service.controller.session.stop_generation
            return_stack_depth: usize = service.controller.engine.machine.return_stack_pointer
            frame_index: usize = locals_frame_index_for_reference(generation, return_stack_depth, request.reference)
            if frame_index >= DebuggerDAPFrames::frame_capacity():
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DAP_VARIABLES_DETAIL_STALE_REFERENCE)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Variables, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            result: DebuggerProtocolDispatcher::DispatchResult = dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Variables, request_id)
            return result if not result.accepted
            page <- DebuggerManagedService::service_frame_locals(service, frame_index, request.start, request.count if request.has_count else RuntimeIdentifiers::DAP_NO_VARIABLES_REQUESTED)
            page.count <- RuntimeIdentifiers::DAP_NO_VARIABLES_REQUESTED if request.has_count and request.count == RuntimeIdentifiers::DAP_NO_VARIABLES_REQUESTED
            return result

        def dispatch_evaluate(service: mutable DebuggerManagedService::Service&, payload: u8&, payload_length: usize, context: mutable DAPRequestContext&) -> DebuggerProtocolDispatcher::DispatchResult:
            request: DebuggerDAPPayload::EvaluateRequest = DebuggerDAPPayload::evaluate_request_parse(payload, payload_length)
            if not request.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_EVALUATE_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Evaluate, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            generation: u64 = service.controller.session.stop_generation
            depth: usize = service.controller.engine.machine.return_stack_pointer
            frame_index: usize = dap_frame_index_for_id(generation, depth, request.frame_id) if request.has_frame_id else RuntimeIdentifiers::DAP_CURRENT_FRAME_INDEX
            if frame_index >= DebuggerDAPFrames::frame_capacity():
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_EVALUATE_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Evaluate, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            evaluated: DebuggerManagedService::EvaluateResult = DebuggerManagedService::service_evaluate_expression(service, request.expression.bytes[0], request.expression.length, frame_index)
            if not evaluated.accepted:
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Evaluate, accepted: false, stop_generation: service.controller.session.stop_generation, failure: evaluated.failure}
            context.evaluate_value <- evaluated.value
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Evaluate, accepted: true, stop_generation: service.controller.session.stop_generation, failure: DebuggerErrors::no_error()}

        def dispatch_source_breakpoints(service: mutable DebuggerManagedService::Service&, request_id: u64, payload: u8&, payload_length: usize, coordinates: DebuggerDAPPayload::ClientCoordinates, response: mutable DebuggerManagedService::SourceBreakpointResult&) -> DebuggerProtocolDispatcher::DispatchResult:
            request: mutable DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(payload, payload_length)
            if not request.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            source_id: mutable DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(RuntimeIdentifiers::DAP_NO_SOURCE_FILE_ID)
            if request.has_source_reference and request.source_reference != RuntimeIdentifiers::DAP_NO_SOURCE_REFERENCE:
                source_id <- DebuggerIdentity::debug_id(request.source_reference)
                if not DebuggerManagedEngine::managed_source_file_id_is_known(service.controller, source_id):
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            if request.has_source_path:
                path_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, request.source_path.bytes[0], request.source_path.length)
                if path_id.value == RuntimeIdentifiers::DAP_NO_SOURCE_FILE_ID or (source_id.value != RuntimeIdentifiers::DAP_NO_SOURCE_FILE_ID and source_id.value != path_id.value):
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                source_id <- path_id
            if source_id.value == RuntimeIdentifiers::DAP_NO_SOURCE_FILE_ID:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            for index in 0..<request.count:
                if coordinates.lines_start_at_one:
                    if request.lines[index] == 0:
                        failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                        return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                else:
                    if request.lines[index].u64() >= ResponseMetadata::DAP_MAX_SOURCE_BREAKPOINT_LINE:
                        failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                        return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                    request.lines[index] <- (request.lines[index].u64() + SourceBreakpoints::DAP_SOURCE_BREAKPOINT_LINE_INCREMENT).u32()
                if request.has_columns[index] and coordinates.columns_start_at_one:
                    if request.columns[index] == SourceBreakpoints::DAP_SOURCE_BREAKPOINT_ONE_BASED_COLUMN_INVALID_ZERO:
                        failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                        return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                    request.columns[index] <- (request.columns[index].u64() - SourceBreakpoints::DAP_SOURCE_BREAKPOINT_COLUMN_INCREMENT).u32()
            response <- DebuggerManagedService::service_replace_source_breakpoints_with_columns(service, source_id, request.lines[SourceBreakpoints::DAP_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], request.columns[SourceBreakpoints::DAP_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], request.has_columns[SourceBreakpoints::DAP_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], request.count)
            if response.accepted:
                for index in SourceBreakpoints::DAP_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX..<request.count:
                    if request.has_hit_targets[index]:
                        applied: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_hit_target(service, response.points[index].id, request.hit_targets[index])
                        if not applied.accepted:
                            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: applied.failure}
                    if request.conditions[index].has_condition:
                        condition_applied: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_condition(service, response.points[index].id, request.breakpoint_text_bytes[request.conditions[index].offset], request.conditions[index].length)
                        if not condition_applied.accepted:
                            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: condition_applied.failure}
                    if request.log_messages[index].has_message:
                        log_message_applied: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_log_message(service, response.points[index].id, request.breakpoint_text_bytes[request.log_messages[index].offset], request.log_messages[index].length)
                        if not log_message_applied.accepted:
                            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: log_message_applied.failure}
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: response.accepted, stop_generation: service.controller.session.stop_generation, failure: response.failure}

        def dispatch_function_breakpoints(service: mutable DebuggerManagedService::Service&, payload: u8&, payload_length: usize, context: mutable DAPRequestContext&) -> DebuggerProtocolDispatcher::DispatchResult:
            request: DebuggerDAPPayload::FunctionBreakpointsRequest = DebuggerDAPPayload::function_breakpoints_request_parse(payload, payload_length)
            if not request.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SOURCE_BREAKPOINT_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            response: mutable DebuggerManagedService::FunctionBreakpointResult = DebuggerManagedService::service_replace_function_breakpoints(service, request.breakpoint_text_bytes[FunctionBreakpointRequest::FIRST_TEXT_BYTE_INDEX], request.breakpoint_text_bytes_length, request.name_offsets[FunctionBreakpointRequest::FIRST_REQUEST_INDEX], request.name_lengths[FunctionBreakpointRequest::FIRST_REQUEST_INDEX], request.count)
            if response.accepted:
                for index in FunctionBreakpointRequest::FIRST_REQUEST_INDEX..<request.count:
                    if request.has_hit_targets[index]:
                        applied: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_hit_target(service, response.points[index].id, request.hit_targets[index])
                        if not applied.accepted:
                            context.function_breakpoints <- response
                            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: applied.failure}
                    if request.has_conditions[index]:
                        condition_applied: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_condition(service, response.points[index].id, request.breakpoint_text_bytes[request.condition_offsets[index]], request.condition_lengths[index])
                        if not condition_applied.accepted:
                            context.function_breakpoints <- response
                            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: false, stop_generation: service.controller.session.stop_generation, failure: condition_applied.failure}
            context.function_breakpoints <- response
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, accepted: response.accepted, stop_generation: service.controller.session.stop_generation, failure: response.failure}

        def dispatch_launch(service: mutable DebuggerManagedService::Service&, request_id: u64, payload: u8&, payload_length: usize) -> DebuggerProtocolDispatcher::DispatchResult can[Blocking.IO, Unsafe.PointerCast]:
            return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Launch, request_id) if service.controller.session.state != DebuggerSession::SessionState.Created
            path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(payload, payload_length)
            if not path.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_MEMORY_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            source_root: DebuggerDAPPayload::SourcePathRootRequest = DebuggerDAPPayload::source_path_root_parse(payload, payload_length)
            if not source_root.valid:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_MEMORY_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(path.bytes[0], path.length) can Blocking.IO, Unsafe.PointerCast
            if not loaded.valid:
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: loaded.failure}
            recording: DebuggerIdentity::DebugId = service.controller.engine.recording
            session: DebuggerSession::Session = service.controller.session
            candidate: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, loaded.image, recording)
            if source_root.has_root and not DebuggerManagedEngine::managed_set_source_path_root(candidate.controller, source_root.root.bytes[0], source_root.root.length):
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_MEMORY_DETAIL_ARGUMENT)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            result: DebuggerProtocolDispatcher::DispatchResult = dispatch_managed(candidate, DebuggerProtocolRequest::RequestMethod.Launch, request_id)
            if not result.accepted:
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Launch, accepted: false, stop_generation: service.controller.session.stop_generation, failure: result.failure}
            service <- candidate
            return result

        def dispatch_command(service: mutable DebuggerManagedService::Service&, command_hash: u64, request_id: u64, payload: u8&, payload_length: usize, memory: mutable DebuggerMemory::MemoryRead&, variables: mutable DebuggerManagedInspection::LocalPage&, source_breakpoints: mutable DebuggerManagedService::SourceBreakpointResult&, client_coordinates: mutable DebuggerDAPPayload::ClientCoordinates&, context: mutable DAPRequestContext&) -> DebuggerProtocolDispatcher::DispatchResult can[Blocking.IO, Unsafe.PointerCast]:
            if command_hash == CommandDispatch::COMMAND_HASH_INITIALIZE:
                coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(payload, payload_length)
                if not coordinates.valid:
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_MEMORY_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Initialize, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                client_coordinates <- coordinates
                return DebuggerProtocolDispatcher::dispatch_request(service.controller.session, request_for(DebuggerProtocolRequest::RequestMethod.Initialize, request_id), RuntimeIdentifiers::DAP_NO_EXPECTED_GENERATION)
            if command_hash == CommandDispatch::COMMAND_HASH_LAUNCH:
                return dispatch_launch(service, request_id, payload, payload_length) can Blocking.IO, Unsafe.PointerCast
            if command_hash == CommandDispatch::COMMAND_HASH_CONTINUE:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Continue, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_PAUSE:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Pause, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_NEXT:
                return dispatch_step_over(service, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_BACK:
                # DAP defaults stepBack to statement granularity. The managed
                # reverse-step-over operation stops at the preceding source
                # boundary while preserving call-frame semantics.
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.ReverseStepOver, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_DISCONNECT:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Detach, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_TERMINATE:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Terminate, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_STACK_TRACE:
                stack_request: DebuggerDAPPayload::StackTraceRequest = DebuggerDAPPayload::stack_trace_request_parse(payload, payload_length)
                if not stack_request.valid or stack_request.thread_id != RuntimeIdentifiers::DAP_SUPPORTED_THREAD_ID:
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_STACK_TRACE_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Stack, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                page: DebuggerDAPFrames::StackPage = DebuggerDAPFrames::stack_trace_page(service.controller.engine.image, service.controller.engine.machine, stack_request.start_frame, stack_request.levels, stack_request.has_levels)
                if not page.valid:
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DAP_STACK_TRACE_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Stack, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                context.stack_start_frame <- stack_request.start_frame
                context.stack_levels <- stack_request.levels
                context.stack_has_levels <- stack_request.has_levels
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Stack, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_SCOPES:
                frame_request: DebuggerDAPPayload::ReferenceRequest = DebuggerDAPPayload::frame_id_request_parse(payload, payload_length)
                generation: u64 = service.controller.session.stop_generation
                return_stack_depth: usize = service.controller.engine.machine.return_stack_pointer
                frame_index: usize = dap_frame_index_for_id(generation, return_stack_depth, frame_request.reference) if frame_request.valid else DebuggerDAPFrames::frame_capacity()
                if not frame_request.valid or frame_index >= DebuggerDAPFrames::frame_capacity():
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DAP_SCOPES_DETAIL_ARGUMENT)
                    return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: DebuggerProtocolRequest::RequestMethod.Scopes, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
                context.scope_frame_index <- frame_index
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Scopes, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_VARIABLES:
                return dispatch_variables(service, request_id, payload, payload_length, variables)
            if command_hash == CommandDispatch::COMMAND_HASH_EVALUATE:
                return dispatch_evaluate(service, payload, payload_length, context)
            if command_hash == CommandDispatch::COMMAND_HASH_SET_BREAKPOINTS:
                return dispatch_source_breakpoints(service, request_id, payload, payload_length, client_coordinates, source_breakpoints)
            if command_hash == CommandDispatch::COMMAND_HASH_SET_FUNCTION_BREAKPOINTS:
                return dispatch_function_breakpoints(service, payload, payload_length, context)
            if command_hash == CommandDispatch::COMMAND_HASH_SET_DATA_BREAKPOINTS:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_READ_MEMORY:
                return dispatch_memory(service, request_id, payload, payload_length, memory)
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_IN:
                return dispatch_step_in(service, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_OUT:
                return dispatch_step_out(service, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_REVERSE_CONTINUE:
                return dispatch_reverse_continue(service, request_id)
            if command_hash == CommandDispatch::COMMAND_HASH_CONFIGURATION_DONE:
                if service.controller.session.state != DebuggerSession::SessionState.Running and service.controller.session.state != DebuggerSession::SessionState.Stopped:
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DAP_CONFIGURATION_DONE_DETAIL_INVALID_STATE)
                    return DebuggerProtocolDispatcher::dispatch_error(service.controller.session, DebuggerProtocolRequest::RequestMethod.Initialize, failure)
                return DebuggerProtocolDispatcher::dispatch_ok(service.controller.session, DebuggerProtocolRequest::RequestMethod.Initialize)
            if command_hash == CommandDispatch::COMMAND_HASH_THREADS:
                return dispatch_managed(service, DebuggerProtocolRequest::RequestMethod.Threads, request_id)
            invalid: mutable DebuggerProtocolRequest::Request = zeroed
            invalid.valid <- false
            return DebuggerProtocolDispatcher::dispatch_request(service.controller.session, invalid, RuntimeIdentifiers::DAP_NO_EXPECTED_GENERATION)

        def write_failure_response(command_hash: u64, request_sequence: u64, response_sequence: u64, payload: u8&, command_start: usize, command_end: usize) -> void can[Console, Unsafe.PointerCast]:
            if command_hash == CommandDispatch::COMMAND_HASH_INITIALIZE:
                write_dynamic_response(response_sequence, request_sequence, Initialize::DAP_INIT_COMMAND, Initialize::DAP_INIT_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_LAUNCH:
                write_dynamic_response(response_sequence, request_sequence, Launch::DAP_LAUNCH_COMMAND, Launch::DAP_LAUNCH_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_CONFIGURATION_DONE:
                write_dynamic_response(response_sequence, request_sequence, Configuration::DAP_CONFIGURATION_DONE_COMMAND, Configuration::DAP_CONFIGURATION_DONE_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_CONTINUE:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_CONTINUE_COMMAND, ExecutionControl::DAP_CONTINUE_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_NEXT:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_NEXT_COMMAND, ExecutionControl::DAP_NEXT_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_BACK:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_STEP_BACK_COMMAND, ExecutionControl::DAP_STEP_BACK_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_PAUSE:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_PAUSE_COMMAND, ExecutionControl::DAP_PAUSE_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_THREADS:
                write_dynamic_response(response_sequence, request_sequence, Threads::DAP_THREADS_COMMAND, Threads::DAP_THREADS_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_STACK_TRACE:
                write_dynamic_response(response_sequence, request_sequence, StackTraceCommand::DAP_STACK_TRACE_COMMAND, StackTraceCommand::DAP_STACK_TRACE_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_SCOPES:
                write_dynamic_response(response_sequence, request_sequence, Scopes::DAP_SCOPES_COMMAND, Scopes::DAP_SCOPES_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_VARIABLES:
                write_dynamic_response(response_sequence, request_sequence, Variables::DAP_VARIABLES_COMMAND, Variables::DAP_VARIABLES_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_EVALUATE:
                write_dynamic_response(response_sequence, request_sequence, Evaluate::DAP_EVALUATE_COMMAND, Evaluate::DAP_EVALUATE_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_SET_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND, SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_SET_FUNCTION_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, BreakpointCommands::DAP_SET_FUNCTION_BREAKPOINTS_COMMAND, BreakpointCommands::DAP_SET_FUNCTION_BREAKPOINTS_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_SET_DATA_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, BreakpointCommands::DAP_SET_DATA_BREAKPOINTS_COMMAND, BreakpointCommands::DAP_SET_DATA_BREAKPOINTS_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_READ_MEMORY:
                write_dynamic_response(response_sequence, request_sequence, Memory::DAP_READ_MEMORY_COMMAND, Memory::DAP_READ_MEMORY_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_IN:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_STEP_IN_COMMAND, ExecutionControl::DAP_STEP_IN_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_OUT:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_STEP_OUT_COMMAND, ExecutionControl::DAP_STEP_OUT_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_REVERSE_CONTINUE:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_REVERSE_CONTINUE_COMMAND, ExecutionControl::DAP_REVERSE_CONTINUE_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_DISCONNECT:
                write_dynamic_response(response_sequence, request_sequence, Lifecycle::DAP_DISCONNECT_COMMAND, Lifecycle::DAP_DISCONNECT_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_TERMINATE:
                write_dynamic_response(response_sequence, request_sequence, Lifecycle::DAP_TERMINATE_COMMAND, Lifecycle::DAP_TERMINATE_COMMAND_LENGTH, ResponseStatus::DAP_UNAVAILABLE_SUFFIX, ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            write_unknown_command_response(response_sequence, request_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast

        def write_launch_failure_response(result: DebuggerProtocolDispatcher::DispatchResult, request_sequence: u64, response_sequence: u64, payload: u8&, command_start: usize, command_end: usize) -> void can[Console, Unsafe.PointerCast]:
            if result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                write_dynamic_response(response_sequence, request_sequence, Launch::DAP_LAUNCH_COMMAND, Launch::DAP_LAUNCH_COMMAND_LENGTH, Launch::DAP_LAUNCH_INVALID_SUFFIX, Launch::DAP_LAUNCH_INVALID_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Corrupt:
                write_dynamic_response(response_sequence, request_sequence, Launch::DAP_LAUNCH_COMMAND, Launch::DAP_LAUNCH_COMMAND_LENGTH, Launch::DAP_LAUNCH_CORRUPT_SUFFIX, Launch::DAP_LAUNCH_CORRUPT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.ResourceLimit:
                write_dynamic_response(response_sequence, request_sequence, Launch::DAP_LAUNCH_COMMAND, Launch::DAP_LAUNCH_COMMAND_LENGTH, Launch::DAP_LAUNCH_RESOURCE_SUFFIX, Launch::DAP_LAUNCH_RESOURCE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            write_failure_response(CommandDispatch::COMMAND_HASH_LAUNCH, request_sequence, response_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast

        def write_launch_success_response(request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            write_dynamic_response(response_sequence, request_sequence, Launch::DAP_LAUNCH_COMMAND, Launch::DAP_LAUNCH_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast

        def write_memory_response(memory: DebuggerMemory::MemoryRead, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            address_digits: mutable usize = Memory::DAP_FIRST_HEX_DIGIT_COUNT
            address_remaining: mutable u64 = memory.address
            while address_remaining >= Memory::DAP_MEMORY_HEX_BASE:
                address_remaining <- address_remaining / Memory::DAP_MEMORY_HEX_BASE
                address_digits <- address_digits + 1
            body_length: u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + Memory::DAP_READ_MEMORY_COMMAND_LENGTH + Memory::DAP_MEMORY_SUCCESS_BEFORE_ADDRESS_LENGTH + address_digits + Memory::DAP_MEMORY_SUCCESS_BEFORE_DATA_LENGTH + memory.length * Memory::DAP_MEMORY_HEX_BYTES + Memory::DAP_MEMORY_SUCCESS_AFTER_DATA_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            _ = printf(Memory::DAP_READ_MEMORY_COMMAND) can Console
            _ = printf(Memory::DAP_MEMORY_SUCCESS_BEFORE_ADDRESS) can Console
            _ = printf("%llx", memory.address) can Console
            _ = printf(Memory::DAP_MEMORY_SUCCESS_BEFORE_DATA) can Console
            for index in 0..<memory.length:
                _ = printf("%02llx", memory.bytes[index].u64()) can Console
            _ = printf(Memory::DAP_MEMORY_SUCCESS_AFTER_DATA) can Console

        def write_evaluate_response(value: i64, request_sequence: u64, response_sequence: u64) -> void can[Console, Unsafe.PointerCast]:
            body_length: u64 = (ResponseEnvelope::DAP_BODY_PREFIX_LENGTH + decimal_digits(response_sequence) + ResponseEnvelope::DAP_BODY_MIDDLE_LENGTH + decimal_digits(request_sequence) + ResponseEnvelope::DAP_COMMAND_PREFIX_LENGTH + Evaluate::DAP_EVALUATE_COMMAND_LENGTH + Evaluate::DAP_EVALUATE_SUCCESS_BEFORE_VALUE_LENGTH + signed_decimal_digits(value) + Evaluate::DAP_EVALUATE_SUCCESS_AFTER_VALUE_LENGTH + JsonWire::DAP_JSON_TERMINATOR_LENGTH).u64()
            _ = printf("Content-Length: %llu\r\n\r\n", body_length) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_PREFIX) can Console
            _ = printf("%llu", response_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_BODY_MIDDLE) can Console
            _ = printf("%llu", request_sequence) can Console
            _ = printf(ResponseEnvelope::DAP_COMMAND_PREFIX) can Console
            _ = printf(Evaluate::DAP_EVALUATE_COMMAND) can Console
            _ = printf(Evaluate::DAP_EVALUATE_SUCCESS_BEFORE_VALUE) can Console
            _ = printf("%lld", value) can Console
            _ = printf(Evaluate::DAP_EVALUATE_SUCCESS_AFTER_VALUE) can Console

        def write_response(service: DebuggerManagedService::Service, result: DebuggerProtocolDispatcher::DispatchResult, command_hash: u64, request_sequence: u64, response_sequence: u64, state_committed: bool, memory: DebuggerMemory::MemoryRead, variables: DebuggerManagedInspection::LocalPage, source_breakpoints: DebuggerManagedService::SourceBreakpointResult, client_coordinates: DebuggerDAPPayload::ClientCoordinates, context: DAPRequestContext, payload: u8&, command_start: usize, command_end: usize) -> void can[Console, Unsafe.PointerCast]:
            if not result.accepted:
                if command_hash == CommandDispatch::COMMAND_HASH_EVALUATE:
                    write_dynamic_response(response_sequence, request_sequence, Evaluate::DAP_EVALUATE_COMMAND, Evaluate::DAP_EVALUATE_COMMAND_LENGTH, Evaluate::DAP_EVALUATE_FAILURE_SUFFIX, Evaluate::DAP_EVALUATE_FAILURE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == CommandDispatch::COMMAND_HASH_CONTINUE and state_committed:
                    # Continue may report a bounded-work failure after the VM
                    # has already advanced and committed a stopped position.
                    # Keep the request failure explicit while telling the host
                    # to refresh inspection from the stop event that follows.
                    write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_CONTINUE_COMMAND, ExecutionControl::DAP_CONTINUE_COMMAND_LENGTH, ExecutionControl::DAP_CONTINUE_PARTIAL_FAILURE_SUFFIX, ExecutionControl::DAP_CONTINUE_PARTIAL_FAILURE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == CommandDispatch::COMMAND_HASH_VARIABLES:
                    suffix: mutable cstr = ResponseStatus::DAP_UNAVAILABLE_SUFFIX
                    suffix_length: mutable usize = ResponseStatus::DAP_UNAVAILABLE_SUFFIX_LENGTH
                    if result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                        suffix <- Variables::DAP_VARIABLES_INVALID_SUFFIX
                        suffix_length <- Variables::DAP_VARIABLES_INVALID_SUFFIX_LENGTH
                        suffix <- Variables::DAP_VARIABLES_ARGUMENT_SUFFIX if result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_ARGUMENT
                        suffix_length <- Variables::DAP_VARIABLES_ARGUMENT_SUFFIX_LENGTH if result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_ARGUMENT
                        suffix <- Variables::DAP_VARIABLES_ZERO_REFERENCE_SUFFIX if result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_ZERO_REFERENCE
                        suffix_length <- Variables::DAP_VARIABLES_ZERO_REFERENCE_SUFFIX_LENGTH if result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_ZERO_REFERENCE
                        suffix <- Variables::DAP_VARIABLES_INVALID_ID_SUFFIX if result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_REQUEST_ID
                        suffix_length <- Variables::DAP_VARIABLES_INVALID_ID_SUFFIX_LENGTH if result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_REQUEST_ID
                        suffix <- Variables::DAP_VARIABLES_INVALID_METHOD_SUFFIX if result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_METHOD
                        suffix_length <- Variables::DAP_VARIABLES_INVALID_METHOD_SUFFIX_LENGTH if result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_METHOD
                    if result.failure.code == DebuggerErrors::ErrorCode.Unavailable and result.failure.detail == ErrorDetail::DAP_VARIABLES_DETAIL_STALE_REFERENCE:
                        suffix <- Variables::DAP_VARIABLES_STALE_SUFFIX
                        suffix_length <- Variables::DAP_VARIABLES_STALE_SUFFIX_LENGTH
                    write_dynamic_response(response_sequence, request_sequence, Variables::DAP_VARIABLES_COMMAND, Variables::DAP_VARIABLES_COMMAND_LENGTH, suffix, suffix_length) can Console, Unsafe.PointerCast
                    return
                if command_hash == CommandDispatch::COMMAND_HASH_READ_MEMORY and result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                    write_dynamic_response(response_sequence, request_sequence, Memory::DAP_READ_MEMORY_COMMAND, Memory::DAP_READ_MEMORY_COMMAND_LENGTH, Memory::DAP_MEMORY_INVALID_SUFFIX, Memory::DAP_MEMORY_INVALID_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == CommandDispatch::COMMAND_HASH_SET_BREAKPOINTS and result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                    write_dynamic_response(response_sequence, request_sequence, SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND, SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND_LENGTH, SourceBreakpoints::DAP_SOURCE_BREAKPOINT_INVALID_SUFFIX, SourceBreakpoints::DAP_SOURCE_BREAKPOINT_INVALID_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == CommandDispatch::COMMAND_HASH_SET_BREAKPOINTS and result.failure.code == DebuggerErrors::ErrorCode.ResourceLimit:
                    write_dynamic_response(response_sequence, request_sequence, SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND, SourceBreakpoints::DAP_SET_BREAKPOINTS_COMMAND_LENGTH, SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESOURCE_SUFFIX, SourceBreakpoints::DAP_SOURCE_BREAKPOINT_RESOURCE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == CommandDispatch::COMMAND_HASH_CONFIGURATION_DONE and result.failure.code == DebuggerErrors::ErrorCode.InvalidState:
                    write_dynamic_response(response_sequence, request_sequence, Configuration::DAP_CONFIGURATION_DONE_COMMAND, Configuration::DAP_CONFIGURATION_DONE_COMMAND_LENGTH, Configuration::DAP_CONFIGURATION_DONE_INVALID_STATE_SUFFIX, Configuration::DAP_CONFIGURATION_DONE_INVALID_STATE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                    return
                if command_hash == CommandDispatch::COMMAND_HASH_LAUNCH:
                    write_launch_failure_response(result, request_sequence, response_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast
                    return
                write_failure_response(command_hash, request_sequence, response_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_READ_MEMORY:
                write_memory_response(memory, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_INITIALIZE:
                write_dynamic_response(response_sequence, request_sequence, Initialize::DAP_INIT_COMMAND, Initialize::DAP_INIT_COMMAND_LENGTH, Initialize::DAP_INIT_SUFFIX, Initialize::DAP_INIT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_LAUNCH:
                write_launch_success_response(request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_CONFIGURATION_DONE:
                write_dynamic_response(response_sequence, request_sequence, Configuration::DAP_CONFIGURATION_DONE_COMMAND, Configuration::DAP_CONFIGURATION_DONE_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_CONTINUE:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_CONTINUE_COMMAND, ExecutionControl::DAP_CONTINUE_COMMAND_LENGTH, ExecutionControl::DAP_CONTINUE_SUFFIX, ExecutionControl::DAP_CONTINUE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_NEXT:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_NEXT_COMMAND, ExecutionControl::DAP_NEXT_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_BACK:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_STEP_BACK_COMMAND, ExecutionControl::DAP_STEP_BACK_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_PAUSE:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_PAUSE_COMMAND, ExecutionControl::DAP_PAUSE_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_THREADS:
                write_dynamic_response(response_sequence, request_sequence, Threads::DAP_THREADS_COMMAND, Threads::DAP_THREADS_COMMAND_LENGTH, Threads::DAP_THREADS_SUFFIX, Threads::DAP_THREADS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_STACK_TRACE:
                write_stack_response(service, request_sequence, response_sequence, client_coordinates, context.stack_start_frame, context.stack_levels, context.stack_has_levels) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_SCOPES:
                write_scopes_response(service, context.scope_frame_index, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_VARIABLES:
                write_variables_response(variables, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_EVALUATE:
                write_evaluate_response(context.evaluate_value, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_SET_BREAKPOINTS:
                write_source_breakpoints_response(source_breakpoints, client_coordinates, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_SET_FUNCTION_BREAKPOINTS:
                write_function_breakpoints_response(context.function_breakpoints, request_sequence, response_sequence) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_SET_DATA_BREAKPOINTS:
                write_dynamic_response(response_sequence, request_sequence, BreakpointCommands::DAP_SET_DATA_BREAKPOINTS_COMMAND, BreakpointCommands::DAP_SET_DATA_BREAKPOINTS_COMMAND_LENGTH, BreakpointCommands::DAP_SET_DATA_BREAKPOINTS_SUFFIX, BreakpointCommands::DAP_SET_DATA_BREAKPOINTS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_IN:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_STEP_IN_COMMAND, ExecutionControl::DAP_STEP_IN_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_STEP_OUT:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_STEP_OUT_COMMAND, ExecutionControl::DAP_STEP_OUT_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_REVERSE_CONTINUE:
                write_dynamic_response(response_sequence, request_sequence, ExecutionControl::DAP_REVERSE_CONTINUE_COMMAND, ExecutionControl::DAP_REVERSE_CONTINUE_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_DISCONNECT:
                write_dynamic_response(response_sequence, request_sequence, Lifecycle::DAP_DISCONNECT_COMMAND, Lifecycle::DAP_DISCONNECT_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if command_hash == CommandDispatch::COMMAND_HASH_TERMINATE:
                write_dynamic_response(response_sequence, request_sequence, Lifecycle::DAP_TERMINATE_COMMAND, Lifecycle::DAP_TERMINATE_COMMAND_LENGTH, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX, ResponseStatus::DAP_SIMPLE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            write_unknown_command_response(response_sequence, request_sequence, payload, command_start, command_end) can Console, Unsafe.PointerCast

        def event_request_kind(command_hash: u64) -> DebuggerDAP::RequestKind:
            return DebuggerDAP::RequestKind.Initialize if command_hash == CommandDispatch::COMMAND_HASH_INITIALIZE
            return DebuggerDAP::RequestKind.Launch if command_hash == CommandDispatch::COMMAND_HASH_LAUNCH
            return DebuggerDAP::RequestKind.Continue if command_hash == CommandDispatch::COMMAND_HASH_CONTINUE
            return DebuggerDAP::RequestKind.Pause if command_hash == CommandDispatch::COMMAND_HASH_PAUSE
            return DebuggerDAP::RequestKind.Step if command_hash == CommandDispatch::COMMAND_HASH_NEXT or command_hash == CommandDispatch::COMMAND_HASH_STEP_IN or command_hash == CommandDispatch::COMMAND_HASH_STEP_OUT or command_hash == CommandDispatch::COMMAND_HASH_STEP_BACK
            return DebuggerDAP::RequestKind.ReverseContinue if command_hash == CommandDispatch::COMMAND_HASH_REVERSE_CONTINUE
            return DebuggerDAP::RequestKind.Terminate if command_hash == CommandDispatch::COMMAND_HASH_TERMINATE
            return DebuggerDAP::RequestKind.Other

    public:
        def initial_session() -> DebuggerSession::Session:
            build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
            return DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())

        def run() -> i64 can[Console, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            decoder: mutable Decoder = decoder_new()
            chunk: mutable u8[TransportLimits::DAP_READ_CHUNK_SIZE] = zeroed
            outbound_sequence: mutable u64 = 1
            client_coordinates: mutable DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_default()
            session: DebuggerSession::Session = initial_session()
            service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, DebuggerDefaultImage::image_new(), DebuggerIdentity::debug_id(1))
            memory: mutable DebuggerMemory::MemoryRead = zeroed
            variables: mutable DebuggerManagedInspection::LocalPage = zeroed
            source_breakpoints: mutable DebuggerManagedService::SourceBreakpointResult = zeroed
            context: mutable DAPRequestContext = zeroed
            pending_launch_request_sequence: mutable u64 = PendingLaunch::NO_REQUEST_SEQUENCE
            has_pending_launch_response: mutable bool = false
            while true:
                count: isize = read(TransportLimits::PROTOCOL_DAP_SERVER_TRANSPORT_LIMITS_STDIN_FD, (&chunk[0]).cast[void&], TransportLimits::DAP_READ_CHUNK_SIZE) can Console
                break if count <= 0
                for index in 0..<count.usize():
                    completed: bool = decoder_accept(decoder, chunk[index])
                    if completed:
                        memory <- zeroed
                        source_breakpoints <- zeroed
                        context <- zeroed
                        generation_before_request: u64 = service.controller.session.stop_generation
                        result: DebuggerProtocolDispatcher::DispatchResult = dispatch_command(service, decoder.command_hash, decoder.request_sequence, decoder.payload[0], decoder.last_payload_length, memory, variables, source_breakpoints, client_coordinates, context)
                        service.controller.session <- result.session
                        state_committed: bool = service.controller.session.stop_generation != generation_before_request
                        launch_response_deferred: bool = decoder.command_hash == CommandDispatch::COMMAND_HASH_LAUNCH and result.accepted
                        if launch_response_deferred:
                            pending_launch_request_sequence <- decoder.request_sequence
                            has_pending_launch_response <- true
                        else:
                            write_response(service, result, decoder.command_hash, decoder.request_sequence, outbound_sequence, state_committed, memory, variables, source_breakpoints, client_coordinates, context, decoder.payload[0], decoder.command_value_start, decoder.command_value_end) can Console, Unsafe.PointerCast
                        return TransportLimits::DAP_SERVER_INVALID_FRAME_EXIT_CODE if outbound_sequence == TransportLimits::MAX_DAP_OUTBOUND_SEQUENCE
                        outbound_sequence <- outbound_sequence + NumberFormat::DAP_DECIMAL_INCREMENT
                        if command_can_emit_log_output(decoder.command_hash) and service.controller.log_output_length > LogpointOutput::NO_OUTPUT_BYTES:
                            write_log_output_event(service.controller.log_output[LogpointOutput::FIRST_BYTE_INDEX], service.controller.log_output_length, outbound_sequence) can Console, Unsafe.PointerCast
                            return TransportLimits::DAP_SERVER_INVALID_FRAME_EXIT_CODE if outbound_sequence == TransportLimits::MAX_DAP_OUTBOUND_SEQUENCE
                            outbound_sequence <- outbound_sequence + NumberFormat::DAP_DECIMAL_INCREMENT
                            service.controller.log_output_length <- 0
                        event_batch: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(event_request_kind(decoder.command_hash), result.accepted, state_committed, service.controller.session.state, service.controller.engine.machine.halted, service.controller.engine.machine.faulted, service.controller.engine.machine.result)
                        for event_index in 0..<event_batch.count:
                            write_adapter_event(event_batch.events[event_index], outbound_sequence) can Console, Unsafe.PointerCast
                            return TransportLimits::DAP_SERVER_INVALID_FRAME_EXIT_CODE if outbound_sequence == TransportLimits::MAX_DAP_OUTBOUND_SEQUENCE
                            outbound_sequence <- outbound_sequence + NumberFormat::DAP_DECIMAL_INCREMENT
                        if decoder.command_hash == CommandDispatch::COMMAND_HASH_CONFIGURATION_DONE and result.accepted and has_pending_launch_response:
                            write_launch_success_response(pending_launch_request_sequence, outbound_sequence) can Console, Unsafe.PointerCast
                            has_pending_launch_response <- false
                            pending_launch_request_sequence <- PendingLaunch::NO_REQUEST_SEQUENCE
                            return TransportLimits::DAP_SERVER_INVALID_FRAME_EXIT_CODE if outbound_sequence == TransportLimits::MAX_DAP_OUTBOUND_SEQUENCE
                            outbound_sequence <- outbound_sequence + NumberFormat::DAP_DECIMAL_INCREMENT
                        _ = fflush(null) can Console
                        decoder.command_hash <- 0
                        decoder.request_sequence <- 0
                        decoder.sequence_digits <- 0
                        decoder.sequence_prefix_position <- 0
                        decoder.in_sequence <- false
                    return TransportLimits::DAP_SERVER_INVALID_FRAME_EXIT_CODE if decoder.state == FrameParsing::DECODER_FAILED_STATE
            return TransportLimits::DAP_SERVER_INVALID_FRAME_EXIT_CODE if decoder.state != FrameParsing::DECODER_HEADER_STATE or decoder.header_prefix_position != 0
            return TransportLimits::DAP_SERVER_SUCCESS_EXIT_CODE

def main() -> i64 can[Console, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return DebuggerDAPServer::run()
