                decoder.json_nesting[decoder.json_nesting_count] <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACE_OPEN
                decoder.json_states[decoder.json_nesting_count] <- JsonWire::JSON_STATE_OBJECT_KEY_OR_END
                decoder.json_nesting_count <- decoder.json_nesting_count + 1
                decoder.json_object_depth <- decoder.json_object_depth + 1
                return
            if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACKET_OPEN:
                if decoder.json_nesting_count >= JsonWire::PROTOCOL_DAP_SERVER_JSON_WIRE_JSON_NESTING_CAPACITY:
                    decoder_json_fail(decoder)
                    return
                decoder.json_nesting[decoder.json_nesting_count] <- Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_BRACKET_OPEN
                decoder.json_states[decoder.json_nesting_count] <- JsonWire::JSON_STATE_ARRAY_VALUE_OR_END
