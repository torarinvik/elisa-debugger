        def json_primitive_literal_length(kind: u8) -> u8:
            return 4 if kind == JsonWire::JSON_PRIMITIVE_TRUE or kind == JsonWire::JSON_PRIMITIVE_NULL
            return 5 if kind == JsonWire::JSON_PRIMITIVE_FALSE
            return 0

        def json_primitive_literal_byte(kind: u8, position: u8) -> u8:
            if kind == JsonWire::JSON_PRIMITIVE_TRUE:
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_T if position == 0
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_R if position == 1
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_U if position == 2
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_E if position == 3
            if kind == JsonWire::JSON_PRIMITIVE_FALSE:
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_F if position == 0
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_A if position == 1
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_L if position == 2
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_S if position == 3
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_E if position == 4
            if kind == JsonWire::JSON_PRIMITIVE_NULL:
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_N if position == 0
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_U if position == 1
                return Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_L
            return 0

        def decoder_json_primitive_start(decoder: mutable Decoder&, byte: u8) -> bool:
            decoder.json_primitive_valid <- true
            decoder.json_primitive_literal_position <- 0
            if byte == Character::PROTOCOL_DAP_SERVER_CHARACTER_ASCII_T:
