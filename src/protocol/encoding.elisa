            EVALUATION_CONSUMED_PREFIX: cstr = ",\"consumed\":"

        const module Sentinels:
            NO_PAGE: u64 = 0
            PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID: u64 = 0

        const module SessionEncoding:
            SESSION_REQUEST_KIND_PREFIX: cstr = "{\"kind\":\"request\",\"method\":"
            SESSION_CLIENT_PREFIX: cstr = ",\"client\":{\"name\":"
            SESSION_CLIENT_VERSION_PREFIX: cstr = ",\"version\":"
            SESSION_CLIENT_INSTANCE_PREFIX: cstr = ",\"instance\":"
            SESSION_OWNER_PREFIX: cstr = "},\"ownerToken\":"
            SESSION_RESPONSE_PREFIX: cstr = "{\"kind\":\"response\",\"id\":"
            SESSION_RESPONSE_SESSION_PREFIX: cstr = ",\"sessionId\":"

        const module TimelineEncoding:
            TIMELINE_DISCOVERY_FEATURE_PREFIX: cstr = ",\"timeline\":"
            TIMELINE_FIELD_PREFIX: cstr = ",\"timeline\":{\"position\":{\"event\":"
            TIMELINE_BRANCH_PREFIX: cstr = ",\"branch\":"
            TIMELINE_HISTORY_PREFIX: cstr = "},\"history\":{\"retained\":{\"available\":"
            TIMELINE_HISTORY_EXACT_PREFIX: cstr = "},\"exact\":{\"available\":"
            TIMELINE_NAVIGATION_PREFIX: cstr = "},\"navigation\":{\"canReverse\":"
            TIMELINE_NAVIGATION_SEEK_PREFIX: cstr = ",\"canSeek\":"
            TIMELINE_NAVIGATION_REASON_PREFIX: cstr = ",\"reason\":\""
            TIMELINE_NAVIGATION_SUFFIX: cstr = "\"}"
            TIMELINE_REASON_READY: cstr = "ready"
            TIMELINE_REASON_UNSUPPORTED_HISTORY: cstr = "unsupportedHistory"
            TIMELINE_REASON_SESSION_NOT_STOPPED: cstr = "sessionNotStopped"
            TIMELINE_REASON_STATE_NOT_EXACT: cstr = "stateNotExact"
            TIMELINE_REASON_SIDE_STATE_UNALIGNED: cstr = "sideStateUnaligned"
            TIMELINE_REASON_AT_BOUNDARY: cstr = "atBoundary"
            TIMELINE_BOOKMARKS_PREFIX: cstr = "}},\"bookmarks\":["
            TIMELINE_BOOKMARK_PREFIX: cstr = "{\"id\":"
            TIMELINE_BOOKMARK_EVENT_PREFIX: cstr = ",\"event\":"
            TIMELINE_BOOKMARK_LABEL_PREFIX: cstr = ",\"labelId\":"
            TIMELINE_BOOKMARK_NOTE_PREFIX: cstr = ",\"noteId\":"
            TIMELINE_BOOKMARK_PINNED_PREFIX: cstr = ",\"pinned\":"
            TIMELINE_CHECKPOINT_PREFIX: cstr = "],\"checkpoint\":{\"available\":"
            TIMELINE_CHECKPOINT_EVENT_PREFIX: cstr = ",\"event\":"
            TIMELINE_CHECKPOINT_HASH_PREFIX: cstr = ",\"stateHash\":"
            TIMELINE_AVAILABLE_EVENT_PREFIX: cstr = ",\"firstEvent\":"
            TIMELINE_AVAILABLE_LAST_EVENT_PREFIX: cstr = ",\"lastEvent\":"
            TIMELINE_OBJECT_SUFFIX: cstr = "}}}}"

        const module MemoryEncoding:
            MEMORY_FIELD_PREFIX: cstr = ",\"memory\":{\"address\":"
            MEMORY_LENGTH_PREFIX: cstr = ",\"length\":"
            MEMORY_STATE_PREFIX: cstr = ",\"state\":\""
            MEMORY_BYTES_PREFIX: cstr = "\",\"bytes\":\""
            MEMORY_OBJECT_SUFFIX: cstr = "\"}}}"
            MEMORY_STATE_AVAILABLE: cstr = "available"
            HEX_DIGITS: cstr = "0123456789abcdef"
            HEX_SHIFT: u64 = 4
            HEX_MASK: u8 = 15

        const module HistoryEncoding:
            CHECKPOINT_FIELD_PREFIX: cstr = ",\"checkpoint\":{\"available\":true,\"event\":"
            CHECKPOINT_HASH_PREFIX: cstr = ",\"stateHash\":"
            BRANCH_FIELD_PREFIX: cstr = ",\"branch\":{\"id\":"
            HISTORY_OBJECT_SUFFIX: cstr = "}}}"

        const module TraceVerificationEncoding:
            FIELD_PREFIX: cstr = ",\"verification\":{\"state\":\""
            VERIFIED_CHUNKS_PREFIX: cstr = "\",\"verifiedChunks\":"
            VERIFIED_EVENT_PREFIX: cstr = ",\"verifiedEvent\":"
            REPLAYABLE_PREFIX: cstr = ",\"replayable\":"
            OBJECT_SUFFIX: cstr = "}}}"
            STATE_EXACT: cstr = "exact"
            STATE_PARTIAL: cstr = "partial"
            STATE_UNAVAILABLE: cstr = "unavailable"
            STATE_CORRUPT: cstr = "corrupt"
            STATE_EMPTY: cstr = "empty"

        const module OwnershipEncoding:
            CREATE_SESSION_RESULT_PREFIX: cstr = ",\"ok\":true,\"result\":{\"accepted\":true,\"sessionId\":"
            CREATE_SESSION_OWNER_PREFIX: cstr = ",\"ownerToken\":"
            CREATE_SESSION_GENERATION_PREFIX: cstr = ",\"stopGeneration\":"

        def buffer_put_byte(buffer: mutable JsonBuffer&, byte: u8) -> void:
            if buffer.failed or buffer.length >= JsonValues::JSON_BUFFER_CAPACITY:
                buffer.failed <- true
                return
            buffer.bytes[buffer.length] <- byte
            buffer.length <- buffer.length + Index::STEP

        def buffer_put_cstr(buffer: mutable JsonBuffer&, text: cstr) -> void:
            index: mutable usize = Index::FIRST
            while text[index] != Character::C_STRING_TERMINATOR:
                buffer_put_byte(buffer, text[index].u8())
                return if buffer.failed
                index <- index + Index::STEP

        def buffer_put_u64(buffer: mutable JsonBuffer&, value: u64) -> void:
            digits: mutable u8[NumberFormat::DECIMAL_DIGIT_CAPACITY] = zeroed
            count: mutable usize = Index::FIRST
            remaining: mutable u64 = value
            if remaining == NumberFormat::ZERO_UNSIGNED_VALUE:
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_ZERO)
                return
            while remaining > NumberFormat::ZERO_UNSIGNED_VALUE:
                return if count >= NumberFormat::DECIMAL_DIGIT_CAPACITY
                digits[count] <- (remaining % NumberFormat::PROTOCOL_ENCODING_NUMBER_FORMAT_DECIMAL_BASE).u8() + Character::PROTOCOL_ENCODING_CHARACTER_ASCII_ZERO
                count <- count + Index::STEP
                remaining <- remaining / NumberFormat::PROTOCOL_ENCODING_NUMBER_FORMAT_DECIMAL_BASE
            for index in Index::FIRST..<count:
                buffer_put_byte(buffer, digits[count - index - Index::PREVIOUS])

        def buffer_put_i64_string(buffer: mutable JsonBuffer&, value: i64) -> void:
            magnitude: mutable u64 = value.u64()
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
            if value < NumberFormat::ZERO_SIGNED_VALUE:
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_MINUS)
                magnitude <- (-(value + NumberFormat::SIGNED_MAGNITUDE_ADJUSTMENT)).u64() + NumberFormat::UNSIGNED_MAGNITUDE_ADJUSTMENT
            buffer_put_u64(buffer, magnitude)
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)

        def buffer_put_bool(buffer: mutable JsonBuffer&, value: bool) -> void:
            buffer_put_cstr(buffer, JsonValues::JSON_TRUE if value else JsonValues::JSON_FALSE)

        def buffer_put_json_string(buffer: mutable JsonBuffer&, text: cstr) -> void:
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
            index: mutable usize = Index::FIRST
            while text[index] != Character::C_STRING_TERMINATOR:
                byte: u8 = text[index].u8()
                if byte == Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE or byte == Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BACKSLASH:
                    buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BACKSLASH)
                    buffer_put_byte(buffer, byte)
                else:
                    if byte == Character::PROTOCOL_ENCODING_CHARACTER_ASCII_LINE_FEED:
                        buffer_put_cstr(buffer, "\\n")
                    else:
                        if byte == Character::PROTOCOL_ENCODING_CHARACTER_ASCII_CARRIAGE_RETURN:
                            buffer_put_cstr(buffer, "\\r")
                        else:
                            if byte == Character::PROTOCOL_ENCODING_CHARACTER_ASCII_TAB:
                                buffer_put_cstr(buffer, "\\t")
                            else:
                                if byte < Character::PROTOCOL_ENCODING_CHARACTER_ASCII_SPACE:
                                    buffer.failed <- true
                                    return
                                buffer_put_byte(buffer, byte)
                return if buffer.failed
                index <- index + Index::STEP
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)

        def buffer_put_id_string(buffer: mutable JsonBuffer&, value: u64) -> void:
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
            buffer_put_u64(buffer, value)
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)

        def buffer_put_named_id_string(buffer: mutable JsonBuffer&, name: cstr, value: u64) -> void:
            buffer_put_cstr(buffer, name)
            buffer_put_id_string(buffer, value)

        def buffer_put_hex_byte(buffer: mutable JsonBuffer&, value: u8) -> void:
            buffer_put_byte(buffer, MemoryEncoding::HEX_DIGITS[(value >> MemoryEncoding::HEX_SHIFT).usize()].u8())
            buffer_put_byte(buffer, MemoryEncoding::HEX_DIGITS[(value & MemoryEncoding::HEX_MASK).usize()].u8())

        def request_id_is_valid(request: DebuggerProtocol::RequestEnvelope) -> bool:
            return request.request_id > Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID if request.method != DebuggerProtocol::Method.Discover
            return true

        def buffer_put_request_fields(buffer: mutable JsonBuffer&, request: DebuggerProtocol::RequestEnvelope&) -> void:
            buffer_put_cstr(buffer, RequestEncoding::REQUEST_KIND_PREFIX)
            buffer_put_json_string(buffer, DebuggerProtocolVocabulary::method_name(request.method))
            if request.request_id > Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer_put_named_id_string(buffer, RequestEncoding::REQUEST_ID_PREFIX, request.request_id)
            buffer_put_named_id_string(buffer, RequestEncoding::REQUEST_SESSION_PREFIX, request.session_id)
            buffer_put_named_id_string(buffer, RequestEncoding::REQUEST_EXPECTED_PREFIX, request.expected_stop_generation)
            buffer_put_cstr(buffer, RequestEncoding::REQUEST_PAGE_PREFIX)
            buffer_put_u64(buffer, request.page_size)
            buffer_put_named_id_string(buffer, RequestEncoding::REQUEST_TARGET_PREFIX, request.target_event)
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)

        def session_request_is_encodable(request: DebuggerProtocolIntegration::SessionRequest) -> bool:
            limits: DebuggerProtocolIntegration::IntegrationLimits = DebuggerProtocolIntegration::integration_limits_default()
            return false if request.request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or not DebuggerProtocol::method_is_valid(request.method) or not DebuggerProtocolIntegration::client_identity_is_valid(request.client)
            return false if DebuggerProtocolIntegration::integration_method_is_mutating(request.method) and request.owner_token == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID
            return false if request.page_size > limits.max_page_size or request.target_event > limits.max_trace_events
            return true

        def buffer_put_session_request_fields(buffer: mutable JsonBuffer&, request: DebuggerProtocolIntegration::SessionRequest&) -> void:
            buffer_put_cstr(buffer, SessionEncoding::SESSION_REQUEST_KIND_PREFIX)
            buffer_put_json_string(buffer, DebuggerProtocolVocabulary::method_name(request.method))
            buffer_put_named_id_string(buffer, RequestEncoding::REQUEST_ID_PREFIX, request.request_id)
            buffer_put_named_id_string(buffer, RequestEncoding::REQUEST_SESSION_PREFIX, request.session_id)
            buffer_put_cstr(buffer, SessionEncoding::SESSION_CLIENT_PREFIX)
            buffer_put_id_string(buffer, request.client.name.value)
            buffer_put_cstr(buffer, SessionEncoding::SESSION_CLIENT_VERSION_PREFIX)
            buffer_put_id_string(buffer, request.client.version.value)
            buffer_put_cstr(buffer, SessionEncoding::SESSION_CLIENT_INSTANCE_PREFIX)
            buffer_put_id_string(buffer, request.client.instance.value)
            buffer_put_cstr(buffer, SessionEncoding::SESSION_OWNER_PREFIX)
            buffer_put_id_string(buffer, request.owner_token)
            buffer_put_named_id_string(buffer, RequestEncoding::REQUEST_EXPECTED_PREFIX, request.expected_generation)
            buffer_put_cstr(buffer, RequestEncoding::REQUEST_PAGE_PREFIX)
            buffer_put_u64(buffer, request.page_size)
            buffer_put_named_id_string(buffer, RequestEncoding::REQUEST_TARGET_PREFIX, request.target_event)
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)

        def session_response_is_encodable(response: DebuggerProtocolIntegration::SessionResponse) -> bool:
            return false if response.request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or not DebuggerErrors::error_is_well_formed(response.failure)
            return false if response.next_page > ProductMetadata::PROTOCOL_ENCODING_PRODUCT_METADATA_MAX_TRACE_EVENTS
            return response.accepted and DebuggerErrors::error_is_ok(response.failure) or not response.accepted and not DebuggerErrors::error_is_ok(response.failure)

        def buffer_put_next_page(buffer: mutable JsonBuffer&, next_page: u64) -> void:
            return if next_page == Sentinels::NO_PAGE
            buffer_put_cstr(buffer, ",\"next\":")
            buffer_put_id_string(buffer, next_page)

        def buffer_put_discovery_result(buffer: mutable JsonBuffer&, capabilities: DebuggerCapabilities::CapabilitySet) -> void:
            protocol: DebuggerProtocol::ProtocolVersion = DebuggerProtocol::protocol_version()
            buffer_put_cstr(buffer, ",\"ok\":true,\"result\":{\"protocolMajor\":")
            buffer_put_u64(buffer, protocol.major.u64())
            buffer_put_cstr(buffer, ",\"protocolMinor\":")
            buffer_put_u64(buffer, protocol.minor.u64())
            buffer_put_cstr(buffer, ",\"server\":")
            buffer_put_json_string(buffer, ProductMetadata::SERVER_NAME)
            buffer_put_cstr(buffer, ",\"productVersion\":")
            buffer_put_json_string(buffer, ProductMetadata::PRODUCT_VERSION)
            buffer_put_cstr(buffer, ",\"engines\":[")
            buffer_put_json_string(buffer, ProductMetadata::MANAGED_ENGINE_NAME)
            buffer_put_cstr(buffer, "],\"traceSchema\":")
            buffer_put_u64(buffer, ProductMetadata::PROTOCOL_ENCODING_PRODUCT_METADATA_TRACE_SCHEMA)
            buffer_put_cstr(buffer, ",\"features\":{\"sourceBreakpoints\":")
            buffer_put_bool(buffer, capabilities.source_breakpoints)
            buffer_put_cstr(buffer, ",\"functionBreakpoints\":")
            buffer_put_bool(buffer, capabilities.function_breakpoints)
            buffer_put_cstr(buffer, ",\"dataBreakpoints\":")
            buffer_put_bool(buffer, capabilities.data_breakpoints)
            buffer_put_cstr(buffer, ",\"typedValues\":")
            buffer_put_bool(buffer, capabilities.typed_values)
            buffer_put_cstr(buffer, ",\"expressionEvaluation\":")
            buffer_put_bool(buffer, capabilities.expression_evaluation)
            buffer_put_cstr(buffer, ",\"reverseExecution\":")
            buffer_put_bool(buffer, capabilities.reverse_execution)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_DISCOVERY_FEATURE_PREFIX)
            buffer_put_bool(buffer, capabilities.history != DebuggerCapabilities::HistoryKind.None)
            buffer_put_cstr(buffer, ",\"checkpoints\":")
            buffer_put_bool(buffer, capabilities.checkpoints)
            buffer_put_cstr(buffer, ",\"branches\":")
            buffer_put_bool(buffer, capabilities.branches)
            buffer_put_cstr(buffer, ",\"concurrencyGraph\":")
            buffer_put_bool(buffer, capabilities.concurrency_graph)
            buffer_put_cstr(buffer, ",\"provenance\":")
            buffer_put_bool(buffer, capabilities.provenance)
            buffer_put_cstr(buffer, ",\"remoteTransport\":")
            buffer_put_bool(buffer, capabilities.remote_transport)
            buffer_put_cstr(buffer, ",\"traceVerification\":")
            buffer_put_bool(buffer, capabilities.trace_verification)
            buffer_put_cstr(buffer, ",\"memoryRead\":")
            buffer_put_bool(buffer, capabilities.memory_read)
            buffer_put_cstr(buffer, ",\"historicalQueries\":")
            buffer_put_bool(buffer, capabilities.historical_queries)
            buffer_put_cstr(buffer, ",\"traceExport\":")
            buffer_put_bool(buffer, capabilities.trace_export)
            buffer_put_cstr(buffer, ",\"scheduleExploration\":")
            buffer_put_bool(buffer, capabilities.schedule_exploration)
            buffer_put_cstr(buffer, ",\"nativeAttach\":")
            buffer_put_bool(buffer, capabilities.native_attach)
            buffer_put_cstr(buffer, ",\"postmortemInspection\":")
            buffer_put_bool(buffer, capabilities.postmortem_inspection)
            buffer_put_cstr(buffer, "},\"installationHealthy\":true}")

        def response_is_encodable(response: DebuggerProtocol::ResponseEnvelope) -> bool:
            return false if response.request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or not DebuggerErrors::error_is_well_formed(response.failure)
            return false if response.next_page > ProductMetadata::PROTOCOL_ENCODING_PRODUCT_METADATA_MAX_TRACE_EVENTS
            return response.ok and DebuggerErrors::error_is_ok(response.failure) or not response.ok and not DebuggerErrors::error_is_ok(response.failure)

        def native_stack_page_is_encodable(page: DebuggerAgentSnapshotWire::DecodedSnapshotStackPage, generation: u64) -> bool:
            return false if page.status != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready or generation == AgentResponse::ZERO_ID or page.generation != generation or page.thread_id == AgentResponse::ZERO_ID
            return false if page.total_frame_count > DebuggerAgentFrames::agent_shadow_frame_capacity() or page.frame_start > page.total_frame_count
            return false if page.frame_count > DebuggerAgentSnapshotWire::SnapshotBuffer::MAX_FRAMES_PER_PAGE or page.frame_count > page.total_frame_count - page.frame_start
            return false if page.frame_count == AgentResponse::EMPTY_COUNT and page.frame_start < page.total_frame_count
            for index in AgentResponse::FIRST_ENTRY..<page.frame_count:
                frame: DebuggerAgentFrames::AgentShadowFrameInfo = page.frames[index]
                ordinal: usize = page.frame_start + index
                return false if frame.invocation.value == AgentResponse::ZERO_ID or frame.function.value == AgentResponse::ZERO_ID or frame.task.value == AgentResponse::ZERO_ID
                return false if frame.binding_count > DebuggerAgentFrames::agent_shadow_binding_capacity()
                return false if ordinal == AgentResponse::EMPTY_COUNT and frame.parent_invocation.value != AgentResponse::ZERO_ID
                return false if ordinal > AgentResponse::EMPTY_COUNT and frame.parent_invocation.value == AgentResponse::ZERO_ID
                if index > AgentResponse::FIRST_ENTRY:
                    return false if frame.parent_invocation.value != page.frames[index - AgentResponse::ONE_ENTRY].invocation.value
                for previous in AgentResponse::FIRST_ENTRY..<index:
                    return false if frame.invocation.value == page.frames[previous].invocation.value
            return true

        def native_local_page_is_encodable(page: DebuggerAgentSnapshotWire::DecodedSnapshotPage, generation: u64) -> bool:
            return false if page.status != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready or generation == AgentResponse::ZERO_ID or page.generation != generation or page.thread_id == AgentResponse::ZERO_ID
            return false if page.frame_index >= DebuggerAgentFrames::agent_shadow_frame_capacity() or page.frame.invocation.value == AgentResponse::ZERO_ID or page.frame.function.value == AgentResponse::ZERO_ID or page.frame.task.value == AgentResponse::ZERO_ID
            return false if page.frame.binding_count > DebuggerAgentFrames::agent_shadow_binding_capacity() or page.binding_start > page.frame.binding_count
            return false if page.binding_count > DebuggerAgentSnapshotWire::SnapshotBuffer::MAX_BINDINGS_PER_PAGE or page.binding_count > page.frame.binding_count - page.binding_start
            return false if page.binding_count == AgentResponse::EMPTY_COUNT and page.binding_start < page.frame.binding_count
            for index in AgentResponse::FIRST_ENTRY..<page.binding_count:
                descriptor: DebuggerAgentFrames::AgentStorageDescriptor = page.bindings[index]
                return false if not DebuggerAgentFrames::agent_storage_descriptor_is_exact(descriptor)
                for previous in AgentResponse::FIRST_ENTRY..<index:
                    return false if descriptor.binding.value == page.bindings[previous].binding.value
            return true

        def agent_value_kind_name(kind: DebuggerAgentFrames::AgentValueKind) -> cstr:
            return AgentResponse::JSON_VOID if kind == DebuggerAgentFrames::AgentValueKind.Void
            return AgentResponse::JSON_SIGNED if kind == DebuggerAgentFrames::AgentValueKind.Signed
            return AgentResponse::JSON_UNSIGNED if kind == DebuggerAgentFrames::AgentValueKind.Unsigned
            return AgentResponse::JSON_FLOATING if kind == DebuggerAgentFrames::AgentValueKind.Floating
            return AgentResponse::JSON_BOOLEAN if kind == DebuggerAgentFrames::AgentValueKind.Boolean
            return AgentResponse::JSON_TEXT if kind == DebuggerAgentFrames::AgentValueKind.Text
            return AgentResponse::JSON_AGGREGATE if kind == DebuggerAgentFrames::AgentValueKind.Aggregate
            return AgentResponse::JSON_REFERENCE if kind == DebuggerAgentFrames::AgentValueKind.Reference
            return AgentResponse::JSON_OPAQUE

        def agent_value_state_name(state: DebuggerAgentFrames::AgentValueState) -> cstr:
            return AgentResponse::JSON_AVAILABLE if state == DebuggerAgentFrames::AgentValueState.Available
            return AgentResponse::JSON_UNAVAILABLE if state == DebuggerAgentFrames::AgentValueState.Unavailable
            return AgentResponse::JSON_OPTIMIZED_AWAY if state == DebuggerAgentFrames::AgentValueState.OptimizedAway
            return AgentResponse::JSON_UNINITIALIZED if state == DebuggerAgentFrames::AgentValueState.Uninitialized
            return AgentResponse::JSON_REDACTED if state == DebuggerAgentFrames::AgentValueState.Redacted
            return AgentResponse::JSON_INVALID

        def agent_storage_kind_name(kind: DebuggerAgentFrames::AgentStorageKind) -> cstr:
            return AgentResponse::JSON_REGISTER if kind == DebuggerAgentFrames::AgentStorageKind.Register
            return AgentResponse::JSON_STACK_SLOT if kind == DebuggerAgentFrames::AgentStorageKind.StackSlot
            return AgentResponse::JSON_CONSTANT if kind == DebuggerAgentFrames::AgentStorageKind.Constant
            return AgentResponse::JSON_RUNTIME_SLOT if kind == DebuggerAgentFrames::AgentStorageKind.RuntimeSlot
            return AgentResponse::JSON_UNKNOWN

        def agent_scalar_status_name(status: DebuggerAgentValueCodec::ValueCodecStatus) -> cstr:
            return AgentResponse::JSON_AVAILABLE if status == DebuggerAgentValueCodec::ValueCodecStatus.Ready
            return AgentResponse::JSON_DISPLAY_UNAVAILABLE if status == DebuggerAgentValueCodec::ValueCodecStatus.Unavailable
            return AgentResponse::JSON_DISPLAY_INVALID if status == DebuggerAgentValueCodec::ValueCodecStatus.InvalidWidth or status == DebuggerAgentValueCodec::ValueCodecStatus.ValueOutOfRange or status == DebuggerAgentValueCodec::ValueCodecStatus.InvalidDescriptor or status == DebuggerAgentValueCodec::ValueCodecStatus.InvalidBoolean
            return AgentResponse::JSON_DISPLAY_UNSUPPORTED

        def buffer_put_scalar_display(buffer: mutable JsonBuffer&, descriptor: DebuggerAgentFrames::AgentStorageDescriptor&) -> DebuggerAgentValueCodec::ValueCodecStatus:
            decoded: DebuggerAgentValueCodec::DecodedScalar = DebuggerAgentValueCodec::agent_scalar_decode(descriptor)
            formatted: DebuggerAgentValueCodec::FormattedScalar = DebuggerAgentValueCodec::agent_scalar_format(decoded)
            if formatted.status == DebuggerAgentValueCodec::ValueCodecStatus.Ready:
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
                for index in AgentResponse::FIRST_ENTRY..<formatted.length:
                    buffer_put_byte(buffer, formatted.bytes[index])
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
            else:
                buffer_put_cstr(buffer, AgentResponse::JSON_NULL)
            return formatted.status

    public:
        struct JsonBuffer:
            bytes: mutable u8[JsonValues::JSON_BUFFER_CAPACITY]
            length: mutable usize
            failed: mutable bool

        def json_buffer_new() -> JsonBuffer:
            return JsonBuffer{bytes: zeroed, length: Index::FIRST, failed: false}

        def json_buffer_is_valid(buffer: JsonBuffer&) -> bool:
            return not buffer.failed and buffer.length <= JsonValues::JSON_BUFFER_CAPACITY

        def response_encode(response: DebuggerProtocol::ResponseEnvelope) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if not response_is_encodable(response):
                buffer.failed <- true
                return buffer
            buffer_put_cstr(buffer, "{\"kind\":\"response\",\"id\":")
            buffer_put_id_string(buffer, response.request_id)
            if response.ok:
                buffer_put_cstr(buffer, ",\"ok\":true,\"result\":{\"accepted\":true,\"stopGeneration\":")
                buffer_put_id_string(buffer, response.stop_generation)
                buffer_put_next_page(buffer, response.next_page)
                buffer_put_cstr(buffer, "}}")
            else:
                buffer_put_cstr(buffer, ",\"ok\":false,\"error\":{\"code\":")
                buffer_put_json_string(buffer, DebuggerProtocolVocabulary::error_code_name(response.failure.code))
                buffer_put_cstr(buffer, ",\"message\":\"debugger request failed\",\"detail\":")
                buffer_put_u64(buffer, response.failure.detail.u64())
                buffer_put_cstr(buffer, "}}")
            return buffer

        # Encode the stable editor-neutral request envelope.  Numeric identity
        # fields are strings so JavaScript clients cannot lose precision;
        # pageSize remains a bounded JSON number because it is a count.
        # Discovery may omit its id by passing zero.  Every other method needs
        # a non-zero request id so responses can be correlated safely.
        def request_encode(request: DebuggerProtocol::RequestEnvelope) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request.kind != DebuggerProtocol::MessageKind.Request or not DebuggerProtocol::method_is_valid(request.method) or not request_id_is_valid(request) or request.page_size > ProductMetadata::PROTOCOL_ENCODING_PRODUCT_METADATA_MAX_PAGE_SIZE:
                buffer.failed <- true
                return buffer
            buffer_put_request_fields(buffer, request)
            return buffer

        def session_request_encode(request: DebuggerProtocolIntegration::SessionRequest) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if not session_request_is_encodable(request):
                buffer.failed <- true
                return buffer
            buffer_put_session_request_fields(buffer, request)
            return buffer

        def session_response_encode(response: DebuggerProtocolIntegration::SessionResponse) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if not session_response_is_encodable(response):
                buffer.failed <- true
                return buffer
            buffer_put_cstr(buffer, SessionEncoding::SESSION_RESPONSE_PREFIX)
            buffer_put_id_string(buffer, response.request_id)
            buffer_put_named_id_string(buffer, SessionEncoding::SESSION_RESPONSE_SESSION_PREFIX, response.session_id)
            if response.accepted:
                buffer_put_cstr(buffer, ",\"ok\":true,\"stopGeneration\":")
                buffer_put_id_string(buffer, response.stop_generation)
                buffer_put_cstr(buffer, ",\"next\":")
                buffer_put_id_string(buffer, response.next_page)
            else:
                buffer_put_cstr(buffer, ",\"ok\":false,\"error\":{\"code\":")
                buffer_put_json_string(buffer, DebuggerProtocolVocabulary::error_code_name(response.failure.code))
                buffer_put_cstr(buffer, ",\"retryable\":")
                buffer_put_cstr(buffer, "true" if response.failure.retryable else "false")
                buffer_put_cstr(buffer, ",\"detail\":")
                buffer_put_u64(buffer, response.failure.detail.u64())
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)
            return buffer

        def discovery_response_encode(request_id: u64, capabilities: DebuggerCapabilities::CapabilitySet) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            buffer_put_cstr(buffer, "{\"kind\":\"response\",\"id\":")
            buffer_put_id_string(buffer, request_id)
            buffer_put_discovery_result(buffer, capabilities)
            buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)
            return buffer

        # createSession is the compact process transport's ownership
        # handshake.  IDs remain decimal JSON strings so clients in runtimes
        # with lossy numbers can round-trip them without conversion.
        def create_session_response_encode(request_id: u64, session_id: u64, owner_token: u64, generation: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or session_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or owner_token == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            buffer_put_cstr(buffer, ManagedResponse::MANAGED_RESPONSE_PREFIX)
            buffer_put_id_string(buffer, request_id)
            buffer_put_cstr(buffer, OwnershipEncoding::CREATE_SESSION_RESULT_PREFIX)
            buffer_put_id_string(buffer, session_id)
            buffer_put_cstr(buffer, OwnershipEncoding::CREATE_SESSION_OWNER_PREFIX)
            buffer_put_id_string(buffer, owner_token)
            buffer_put_cstr(buffer, OwnershipEncoding::CREATE_SESSION_GENERATION_PREFIX)
            buffer_put_id_string(buffer, generation)
            buffer_put_cstr(buffer, "}}")
            return buffer

        # Initialize pins the client's wire contract before session requests.
        # A newer minor is safe because minor additions are backward
        # compatible; the server selects the highest minor it implements.
        def initialize_response_encode(request_id: u64, requested_minor: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            protocol: DebuggerProtocol::ProtocolVersion = DebuggerProtocol::protocol_version()
            server_minor: u64 = protocol.minor.u64()
            negotiated_minor: u64 = server_minor if requested_minor > server_minor else requested_minor
            buffer_put_cstr(buffer, "{\"kind\":\"response\",\"id\":")
            buffer_put_id_string(buffer, request_id)
            buffer_put_cstr(buffer, ",\"ok\":true,\"result\":{\"protocolMajor\":")
            buffer_put_u64(buffer, protocol.major.u64())
            buffer_put_cstr(buffer, ",\"protocolMinor\":")
            buffer_put_u64(buffer, negotiated_minor)
            buffer_put_cstr(buffer, ",\"server\":")
            buffer_put_json_string(buffer, ProductMetadata::SERVER_NAME)
            buffer_put_cstr(buffer, ",\"productVersion\":")
            buffer_put_json_string(buffer, ProductMetadata::PRODUCT_VERSION)
            buffer_put_cstr(buffer, ",\"installationHealthy\":true}}")
            return buffer

        def initialize_version_error_encode(request_id: u64, requested_major: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            protocol: DebuggerProtocol::ProtocolVersion = DebuggerProtocol::protocol_version()
            buffer_put_cstr(buffer, "{\"kind\":\"response\",\"id\":")
            buffer_put_id_string(buffer, request_id)
            buffer_put_cstr(buffer, ",\"ok\":false,\"error\":{\"code\":")
            buffer_put_json_string(buffer, InitializationMessages::PROTOCOL_ENCODING_INITIALIZATION_MESSAGES_INCOMPATIBLE_VERSION_CODE)
            buffer_put_cstr(buffer, ",\"message\":")
            buffer_put_json_string(buffer, InitializationMessages::INCOMPATIBLE_VERSION_MESSAGE)
            buffer_put_cstr(buffer, ",\"requestedProtocolMajor\":")
            buffer_put_u64(buffer, requested_major)
            buffer_put_cstr(buffer, ",\"serverProtocolMajor\":")
            buffer_put_u64(buffer, protocol.major.u64())
            buffer_put_cstr(buffer, ",\"serverProtocolMinor\":")
            buffer_put_u64(buffer, protocol.minor.u64())
            buffer_put_cstr(buffer, "}}")
            return buffer

        def initialize_arguments_error_encode(request_id: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            buffer_put_cstr(buffer, "{\"kind\":\"response\",\"id\":")
            buffer_put_id_string(buffer, request_id)
            buffer_put_cstr(buffer, ",\"ok\":false,\"error\":{\"code\":\"INVALID_ARGUMENT\",\"message\":")
            buffer_put_json_string(buffer, JsonValues::INVALID_INITIALIZE_MESSAGE)
            buffer_put_cstr(buffer, "}}")
            return buffer

        def initialize_required_error_encode(request_id: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            buffer_put_cstr(buffer, "{\"kind\":\"response\",\"id\":")
            buffer_put_id_string(buffer, request_id)
            buffer_put_cstr(buffer, ",\"ok\":false,\"error\":{\"code\":")
            buffer_put_json_string(buffer, InitializationMessages::INITIALIZE_REQUIRED_CODE)
            buffer_put_cstr(buffer, ",\"message\":")
            buffer_put_json_string(buffer, InitializationMessages::INITIALIZE_REQUIRED_MESSAGE)
            buffer_put_cstr(buffer, "}}")
            return buffer

        def managed_result_prefix(buffer: mutable JsonBuffer&, request_id: u64, generation: u64) -> void:
            buffer_put_cstr(buffer, ManagedResponse::MANAGED_RESPONSE_PREFIX)
            buffer_put_id_string(buffer, request_id)
            buffer_put_cstr(buffer, ManagedResponse::MANAGED_RESPONSE_SUCCESS)
            buffer_put_id_string(buffer, generation)

        def managed_frame_response_encode(request_id: u64, generation: u64, frame: DebuggerManagedInspection::FrameSnapshot) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, ",\"position\":{\"event\":")
            buffer_put_id_string(buffer, frame.event)
            buffer_put_cstr(buffer, "},\"frame\":{\"name\":")
            buffer_put_json_string(buffer, RuntimeJsonValues::JSON_FRAME_NAME)
            buffer_put_cstr(buffer, ",\"id\":")
            buffer_put_id_string(buffer, frame.id.value)
            buffer_put_cstr(buffer, ",\"instruction\":")
            buffer_put_id_string(buffer, frame.instruction.value)
            buffer_put_cstr(buffer, ",\"event\":")
            buffer_put_id_string(buffer, frame.event)
            buffer_put_cstr(buffer, ",\"accumulator\":")
            buffer_put_i64_string(buffer, frame.accumulator)
            buffer_put_cstr(buffer, ",\"result\":")
            buffer_put_i64_string(buffer, frame.result)
            buffer_put_cstr(buffer, ",\"returnDepth\":")
            buffer_put_u64(buffer, frame.return_depth.u64())
            buffer_put_cstr(buffer, "}}}")
            return buffer

        def managed_source_breakpoints_response_encode(request_id: u64, generation: u64, result: DebuggerManagedService::SourceBreakpointResult&) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or not result.accepted or result.count > DebuggerProtocolRequest::source_breakpoint_request_capacity():
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, SourceBreakpointResponse::SOURCE_BREAKPOINT_RESPONSE_ITEMS_PREFIX)
            for index in Index::FIRST..<result.count:
                point: DebuggerManagedService::SourceBreakpointEntry = result.points[index]
                if index > Index::FIRST:
                    buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_COMMA)
                buffer_put_cstr(buffer, SourceBreakpointResponse::SOURCE_BREAKPOINT_RESPONSE_ITEM_PREFIX)
                buffer_put_id_string(buffer, point.id.value)
                buffer_put_cstr(buffer, SourceBreakpointResponse::SOURCE_BREAKPOINT_RESPONSE_LINE_PREFIX)
                buffer_put_u64(buffer, point.line.u64())
                buffer_put_cstr(buffer, SourceBreakpointResponse::SOURCE_BREAKPOINT_RESPONSE_VERIFIED_PREFIX)
                buffer_put_bool(buffer, point.verified)
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)
            buffer_put_cstr(buffer, "]}}")
            return buffer

        # The current EDIR executor has one logical execution thread. Keep its
        # stable identity in the wire response so generic editor clients can
        # use the same thread-oriented inspection flow as DAP clients.
        def managed_threads_response_encode(request_id: u64, generation: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, ",\"threads\":[{\"id\":")
            buffer_put_id_string(buffer, RuntimeJsonValues::JSON_MAIN_THREAD_ID)
            buffer_put_cstr(buffer, ",\"name\":")
            buffer_put_json_string(buffer, RuntimeJsonValues::JSON_MAIN_THREAD_NAME)
            buffer_put_cstr(buffer, "}]}}")
            return buffer

        def managed_scopes_response_encode(request_id: u64, generation: u64, local_count: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, ",\"scopes\":[{\"name\":")
            buffer_put_json_string(buffer, RuntimeJsonValues::JSON_SCOPE_LOCALS)
            buffer_put_cstr(buffer, ",\"variablesReference\":")
            buffer_put_id_string(buffer, generation)
            buffer_put_cstr(buffer, ",\"namedVariables\":")
            buffer_put_u64(buffer, local_count)
            buffer_put_cstr(buffer, ",\"expensive\":false}]}}")
            return buffer

        def managed_locals_response_encode(request_id: u64, generation: u64, event: u64, page: DebuggerManagedInspection::LocalPage) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or page.count > DebuggerManagedInspection::local_page_capacity():
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, ",\"position\":{\"event\":")
            buffer_put_id_string(buffer, event)
            buffer_put_cstr(buffer, "},\"values\":[")
            for index in Index::FIRST..<page.count:
                entry: DebuggerManagedInspection::LocalSnapshot = page.entries[index]
                if index > Index::FIRST:
                    buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_COMMA)
                buffer_put_cstr(buffer, "{\"index\":")
                buffer_put_u64(buffer, entry.index.u64())
                buffer_put_cstr(buffer, ",\"name\":\"")
                buffer_put_cstr(buffer, RuntimeJsonValues::JSON_LOCAL_PREFIX)
                buffer_put_u64(buffer, entry.index.u64())
                buffer_put_cstr(buffer, "\",\"type\":\"")
                buffer_put_cstr(buffer, JsonValues::JSON_TYPE_I64)
                buffer_put_cstr(buffer, "\",\"availability\":\"")
                buffer_put_cstr(buffer, RuntimeJsonValues::JSON_AVAILABILITY_AVAILABLE if entry.available else RuntimeJsonValues::JSON_AVAILABILITY_UNINITIALIZED)
                buffer_put_cstr(buffer, "\",\"value\":")
                buffer_put_i64_string(buffer, entry.value) if entry.available
                buffer_put_cstr(buffer, JsonValues::JSON_NULL) if not entry.available
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)
            buffer_put_cstr(buffer, "],\"complete\":")
            buffer_put_bool(buffer, page.complete)
            buffer_put_cstr(buffer, ",\"next\":")
            buffer_put_id_string(buffer, page.next.u64()) if page.next > Sentinels::NO_PAGE
            buffer_put_cstr(buffer, JsonValues::JSON_NULL) if page.next == Sentinels::NO_PAGE
            buffer_put_cstr(buffer, "}}")
            return buffer

        # Serialize native stack metadata as the same bounded JSON contract
        # used by editor-neutral clients. Opaque identities remain strings so
        # JavaScript hosts preserve the full 64-bit value.
        def agent_stack_response_encode(request_id: u64, generation: u64, page: DebuggerAgentSnapshotWire::DecodedSnapshotStackPage) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or not native_stack_page_is_encodable(page, generation):
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, AgentResponse::STACK_FIELD)
            buffer_put_id_string(buffer, page.thread_id)
            buffer_put_cstr(buffer, AgentResponse::STACK_TOTAL_PREFIX)
            buffer_put_u64(buffer, page.total_frame_count.u64())
            buffer_put_cstr(buffer, AgentResponse::STACK_START_PREFIX)
            buffer_put_u64(buffer, page.frame_start.u64())
            buffer_put_cstr(buffer, AgentResponse::STACK_FRAMES_PREFIX)
            for index in AgentResponse::FIRST_ENTRY..<page.frame_count:
                frame: DebuggerAgentFrames::AgentShadowFrameInfo = page.frames[index]
                frame_index: usize = page.frame_start + index
                if index > AgentResponse::FIRST_ENTRY:
                    buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_COMMA)
                buffer_put_cstr(buffer, AgentResponse::STACK_FRAME_INDEX_PREFIX)
                buffer_put_u64(buffer, frame_index.u64())
                buffer_put_cstr(buffer, AgentResponse::STACK_INVOCATION_PREFIX)
                buffer_put_id_string(buffer, frame.invocation.value)
                buffer_put_cstr(buffer, AgentResponse::STACK_PARENT_PREFIX)
                if frame.parent_invocation.value == AgentResponse::ZERO_ID:
                    buffer_put_cstr(buffer, AgentResponse::JSON_NULL)
                else:
                    buffer_put_id_string(buffer, frame.parent_invocation.value)
                buffer_put_cstr(buffer, AgentResponse::STACK_FUNCTION_PREFIX)
                buffer_put_id_string(buffer, frame.function.value)
                buffer_put_cstr(buffer, AgentResponse::STACK_TASK_PREFIX)
                buffer_put_id_string(buffer, frame.task.value)
                buffer_put_cstr(buffer, AgentResponse::STACK_SOURCE_PREFIX)
                buffer_put_id_string(buffer, frame.source_file.value)
                buffer_put_cstr(buffer, AgentResponse::STACK_LINE_PREFIX)
                buffer_put_u64(buffer, frame.source_line.u64())
                buffer_put_cstr(buffer, AgentResponse::STACK_COLUMN_PREFIX)
                buffer_put_u64(buffer, frame.source_column.u64())
                buffer_put_cstr(buffer, AgentResponse::STACK_LOCAL_COUNT_PREFIX)
                buffer_put_u64(buffer, frame.binding_count.u64())
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)
            next_frame: usize = page.frame_start + page.frame_count
            buffer_put_cstr(buffer, AgentResponse::STACK_NEXT_PREFIX)
            if next_frame < page.total_frame_count:
                buffer_put_u64(buffer, next_frame.u64())
            else:
                buffer_put_cstr(buffer, AgentResponse::JSON_NULL)
            buffer_put_cstr(buffer, AgentResponse::PAGE_COMPLETE_PREFIX)
            buffer_put_bool(buffer, next_frame >= page.total_frame_count)
            buffer_put_cstr(buffer, "}}}")
            return buffer

        # Native local pages preserve raw canonical bytes and storage metadata.
        # Primitive display values use the scalar codec; unsupported composite
        # representations are explicitly marked instead of guessed.
        def agent_values_response_encode(request_id: u64, generation: u64, page: DebuggerAgentSnapshotWire::DecodedSnapshotPage) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or not native_local_page_is_encodable(page, generation):
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, AgentResponse::VALUES_FRAME_PREFIX)
            buffer_put_u64(buffer, page.frame_index.u64())
            buffer_put_cstr(buffer, AgentResponse::VALUES_INVOCATION_PREFIX)
            buffer_put_id_string(buffer, page.frame.invocation.value)
            buffer_put_cstr(buffer, "},\"totalBindings\":")
            buffer_put_u64(buffer, page.frame.binding_count.u64())
            buffer_put_cstr(buffer, AgentResponse::VALUES_START_PREFIX)
            buffer_put_u64(buffer, page.binding_start.u64())
            buffer_put_cstr(buffer, AgentResponse::VALUES_FIELD)
            for index in AgentResponse::FIRST_ENTRY..<page.binding_count:
                descriptor: DebuggerAgentFrames::AgentStorageDescriptor = page.bindings[index]
                if index > AgentResponse::FIRST_ENTRY:
                    buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_COMMA)
                buffer_put_cstr(buffer, AgentResponse::VALUES_ENTRY_PREFIX)
                buffer_put_id_string(buffer, descriptor.binding.value)
                buffer_put_cstr(buffer, AgentResponse::VALUES_SCOPE_PREFIX)
                buffer_put_id_string(buffer, descriptor.scope.value)
                buffer_put_cstr(buffer, AgentResponse::VALUES_TYPE_PREFIX)
                buffer_put_id_string(buffer, descriptor.type_id.value)
                buffer_put_cstr(buffer, AgentResponse::VALUES_NAME_PREFIX)
                buffer_put_u64(buffer, descriptor.binding.value)
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
                buffer_put_cstr(buffer, AgentResponse::VALUES_KIND_PREFIX)
                buffer_put_cstr(buffer, agent_value_kind_name(descriptor.value_kind))
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
                buffer_put_cstr(buffer, AgentResponse::VALUES_STATE_PREFIX)
                buffer_put_cstr(buffer, agent_value_state_name(descriptor.state))
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
                buffer_put_cstr(buffer, AgentResponse::VALUES_STORAGE_KIND_PREFIX)
                buffer_put_cstr(buffer, agent_storage_kind_name(descriptor.storage_kind))
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
                buffer_put_cstr(buffer, AgentResponse::VALUES_STORAGE_LOCATION_PREFIX)
                buffer_put_i64_string(buffer, descriptor.storage_location)
                buffer_put_cstr(buffer, AgentResponse::VALUES_BYTE_SIZE_PREFIX)
                buffer_put_id_string(buffer, descriptor.byte_size)
                buffer_put_cstr(buffer, AgentResponse::VALUES_BYTES_PREFIX)
                if descriptor.state == DebuggerAgentFrames::AgentValueState.Available:
                    buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
                    for byte_index in AgentResponse::FIRST_ENTRY..<descriptor.byte_size.usize():
                        buffer_put_hex_byte(buffer, descriptor.bytes[byte_index])
                    buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_QUOTE)
                else:
                    buffer_put_cstr(buffer, AgentResponse::JSON_NULL)
                buffer_put_cstr(buffer, AgentResponse::VALUES_DISPLAY_PREFIX)
                display_status: DebuggerAgentValueCodec::ValueCodecStatus = buffer_put_scalar_display(buffer, descriptor)
                buffer_put_cstr(buffer, AgentResponse::VALUES_DISPLAY_STATUS_PREFIX)
                buffer_put_cstr(buffer, agent_scalar_status_name(display_status))
                buffer_put_cstr(buffer, "\"}")
            next_binding: usize = page.binding_start + page.binding_count
            buffer_put_cstr(buffer, AgentResponse::PAGE_COMPLETE_PREFIX)
            buffer_put_bool(buffer, next_binding >= page.frame.binding_count)
            buffer_put_cstr(buffer, AgentResponse::VALUES_NEXT_PREFIX)
            if next_binding < page.frame.binding_count:
                buffer_put_u64(buffer, next_binding.u64())
            else:
                buffer_put_cstr(buffer, AgentResponse::JSON_NULL)
            buffer_put_cstr(buffer, "}}")
            return buffer

        # Expression values are returned as decimal strings so clients with
        # IEEE-754 number semantics retain every signed 64-bit result.
        def managed_evaluate_response_encode(request_id: u64, generation: u64, result: DebuggerManagedService::EvaluateResult&) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or not result.accepted or not DebuggerErrors::error_is_ok(result.failure):
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, EvaluationEncoding::EVALUATION_FIELD_PREFIX)
            buffer_put_i64_string(buffer, result.value)
            buffer_put_cstr(buffer, EvaluationEncoding::EVALUATION_CONSUMED_PREFIX)
            buffer_put_u64(buffer, result.consumed.u64())
            buffer_put_cstr(buffer, "}}}")
            return buffer

        def managed_memory_response_encode(request_id: u64, generation: u64, read: DebuggerMemory::MemoryRead&) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or not DebuggerMemory::memory_read_is_available(read):
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, MemoryEncoding::MEMORY_FIELD_PREFIX)
            buffer_put_id_string(buffer, read.address)
            buffer_put_cstr(buffer, MemoryEncoding::MEMORY_LENGTH_PREFIX)
            buffer_put_u64(buffer, read.length.u64())
            buffer_put_cstr(buffer, MemoryEncoding::MEMORY_STATE_PREFIX)
            buffer_put_cstr(buffer, MemoryEncoding::MEMORY_STATE_AVAILABLE)
            buffer_put_cstr(buffer, MemoryEncoding::MEMORY_BYTES_PREFIX)
            for index in Index::FIRST..<read.length:
                buffer_put_hex_byte(buffer, read.bytes[index])
            buffer_put_cstr(buffer, MemoryEncoding::MEMORY_OBJECT_SUFFIX)
            return buffer

        def managed_checkpoint_response_encode(request_id: u64, generation: u64, event: u64, state_hash: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, HistoryEncoding::CHECKPOINT_FIELD_PREFIX)
            buffer_put_id_string(buffer, event)
            buffer_put_cstr(buffer, HistoryEncoding::CHECKPOINT_HASH_PREFIX)
            buffer_put_id_string(buffer, state_hash)
            buffer_put_cstr(buffer, HistoryEncoding::HISTORY_OBJECT_SUFFIX)
            return buffer

        def managed_branch_response_encode(request_id: u64, generation: u64, branch: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or branch == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, HistoryEncoding::BRANCH_FIELD_PREFIX)
            buffer_put_id_string(buffer, branch)
            buffer_put_cstr(buffer, HistoryEncoding::HISTORY_OBJECT_SUFFIX)
            return buffer

        def managed_trace_verification_response_encode(request_id: u64, generation: u64, report: DebuggerTraceVerify::VerificationReport&) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID:
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, TraceVerificationEncoding::FIELD_PREFIX)
            if report.state == DebuggerTraceVerify::VerificationState.Exact:
                buffer_put_cstr(buffer, TraceVerificationEncoding::STATE_EXACT)
            if report.state == DebuggerTraceVerify::VerificationState.Partial:
                buffer_put_cstr(buffer, TraceVerificationEncoding::STATE_PARTIAL)
            if report.state == DebuggerTraceVerify::VerificationState.Unavailable:
                buffer_put_cstr(buffer, TraceVerificationEncoding::STATE_UNAVAILABLE)
            if report.state == DebuggerTraceVerify::VerificationState.Corrupt:
                buffer_put_cstr(buffer, TraceVerificationEncoding::STATE_CORRUPT)
            if report.state == DebuggerTraceVerify::VerificationState.Empty:
                buffer_put_cstr(buffer, TraceVerificationEncoding::STATE_EMPTY)
            buffer_put_cstr(buffer, TraceVerificationEncoding::VERIFIED_CHUNKS_PREFIX)
            buffer_put_id_string(buffer, report.verified_chunks)
            buffer_put_cstr(buffer, TraceVerificationEncoding::VERIFIED_EVENT_PREFIX)
            buffer_put_id_string(buffer, report.verified_event)
            buffer_put_cstr(buffer, TraceVerificationEncoding::REPLAYABLE_PREFIX)
            buffer_put_bool(buffer, report.replayable)
            buffer_put_cstr(buffer, TraceVerificationEncoding::OBJECT_SUFFIX)
            return buffer

        # Encode the bounded, editor-neutral timeline extension. Event and
        # identity values remain JSON strings so clients in JavaScript and
        # other number-limited runtimes can round-trip them without loss.
        # This response is deliberately a snapshot: clients must use the
        # returned stop generation when issuing a subsequent seek or reverse
        # request.
        def managed_timeline_response_encode(request_id: u64, generation: u64, timeline: DebuggerTimeline::Timeline&, has_checkpoint: bool, checkpoint_event: u64, checkpoint_hash: u64) -> JsonBuffer:
            buffer: mutable JsonBuffer = json_buffer_new()
            if request_id == Sentinels::PROTOCOL_ENCODING_SENTINELS_NO_REQUEST_ID or timeline.bookmark_count > DebuggerTimeline::timeline_bookmark_capacity() or not DebuggerTimeline::history_bounds_is_valid(timeline.bounds) or not DebuggerTimeline::history_eligibility_is_valid(timeline.eligibility):
                buffer.failed <- true
                return buffer
            managed_result_prefix(buffer, request_id, generation)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_FIELD_PREFIX)
            buffer_put_id_string(buffer, timeline.position.event)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_BRANCH_PREFIX)
            buffer_put_id_string(buffer, timeline.position.branch.value)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_HISTORY_PREFIX)
            buffer_put_bool(buffer, timeline.bounds.has_retained)
            if timeline.bounds.has_retained:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_AVAILABLE_EVENT_PREFIX)
                buffer_put_id_string(buffer, timeline.bounds.retained_first)
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_AVAILABLE_LAST_EVENT_PREFIX)
                buffer_put_id_string(buffer, timeline.bounds.retained_last)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_HISTORY_EXACT_PREFIX)
            buffer_put_bool(buffer, timeline.bounds.has_exact)
            if timeline.bounds.has_exact:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_AVAILABLE_EVENT_PREFIX)
                buffer_put_id_string(buffer, timeline.bounds.exact_first)
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_AVAILABLE_LAST_EVENT_PREFIX)
                buffer_put_id_string(buffer, timeline.bounds.exact_last)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_NAVIGATION_PREFIX)
            buffer_put_bool(buffer, timeline.eligibility.can_reverse)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_NAVIGATION_SEEK_PREFIX)
            buffer_put_bool(buffer, timeline.eligibility.can_seek)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_NAVIGATION_REASON_PREFIX)
            if timeline.eligibility.reason == DebuggerTimeline::HistoryEligibilityReason.Ready:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_REASON_READY)
            elif timeline.eligibility.reason == DebuggerTimeline::HistoryEligibilityReason.UnsupportedHistory:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_REASON_UNSUPPORTED_HISTORY)
            elif timeline.eligibility.reason == DebuggerTimeline::HistoryEligibilityReason.SessionNotStopped:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_REASON_SESSION_NOT_STOPPED)
            elif timeline.eligibility.reason == DebuggerTimeline::HistoryEligibilityReason.StateNotExact:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_REASON_STATE_NOT_EXACT)
            elif timeline.eligibility.reason == DebuggerTimeline::HistoryEligibilityReason.SideStateUnaligned:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_REASON_SIDE_STATE_UNALIGNED)
            else:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_REASON_AT_BOUNDARY)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_NAVIGATION_SUFFIX)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_BOOKMARKS_PREFIX)
            for index in Index::FIRST..<timeline.bookmark_count:
                bookmark: DebuggerTimeline::Bookmark = timeline.bookmarks[index]
                if index > Index::FIRST:
                    buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_COMMA)
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_BOOKMARK_PREFIX)
                buffer_put_id_string(buffer, bookmark.id.value)
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_BOOKMARK_EVENT_PREFIX)
                buffer_put_id_string(buffer, bookmark.position.event)
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_BOOKMARK_LABEL_PREFIX)
                buffer_put_id_string(buffer, bookmark.label.value)
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_BOOKMARK_NOTE_PREFIX)
                buffer_put_id_string(buffer, bookmark.note.value)
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_BOOKMARK_PINNED_PREFIX)
                buffer_put_bool(buffer, bookmark.pinned)
                buffer_put_byte(buffer, Character::PROTOCOL_ENCODING_CHARACTER_ASCII_BRACE_CLOSE)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_CHECKPOINT_PREFIX)
            buffer_put_bool(buffer, has_checkpoint)
            if has_checkpoint:
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_CHECKPOINT_EVENT_PREFIX)
                buffer_put_id_string(buffer, checkpoint_event)
                buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_CHECKPOINT_HASH_PREFIX)
                buffer_put_id_string(buffer, checkpoint_hash)
            buffer_put_cstr(buffer, TimelineEncoding::TIMELINE_OBJECT_SUFFIX)
            return buffer
