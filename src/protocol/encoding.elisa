            JSON_VOID: cstr = "void"
            JSON_SIGNED: cstr = "signed"
            JSON_UNSIGNED: cstr = "unsigned"
            JSON_FLOATING: cstr = "floating"
            JSON_BOOLEAN: cstr = "boolean"
            JSON_TEXT: cstr = "text"
