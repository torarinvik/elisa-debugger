        const module SourceBreakpointResponse:
            SOURCE_BREAKPOINT_RESPONSE_ITEMS_PREFIX: cstr = ",\"breakpoints\":["
            SOURCE_BREAKPOINT_RESPONSE_ITEM_PREFIX: cstr = "{\"id\":"
            SOURCE_BREAKPOINT_RESPONSE_LINE_PREFIX: cstr = ",\"line\":"
            SOURCE_BREAKPOINT_RESPONSE_VERIFIED_PREFIX: cstr = ",\"verified\":"

        const module EvaluationEncoding:
