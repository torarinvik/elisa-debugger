            VALUES_BYTES_PREFIX: cstr = ",\"bytes\":"
            VALUES_DISPLAY_PREFIX: cstr = ",\"display\":"
            VALUES_DISPLAY_STATUS_PREFIX: cstr = ",\"displayStatus\":\""
            VALUES_NEXT_PREFIX: cstr = "],\"nextBinding\":"
            PAGE_COMPLETE_PREFIX: cstr = ",\"complete\":"
            JSON_NULL: cstr = "null"
            JSON_AVAILABLE: cstr = "available"
            JSON_UNAVAILABLE: cstr = "unavailable"
            JSON_OPTIMIZED_AWAY: cstr = "optimizedAway"
            JSON_UNINITIALIZED: cstr = "uninitialized"
            JSON_REDACTED: cstr = "redacted"
