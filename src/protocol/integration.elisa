# Stable typed integration contract for editor plugins and headless clients.
# Transports serialize these values; no client needs private engine structures.

include "./messages.elisa"
include "../core/session.elisa"
include "../core/capabilities.elisa"
include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerProtocolIntegration:
    private:

        const module ErrorDetail:
            DETAIL_PRODUCT: u32 = 1
            DETAIL_SESSION: u32 = 2
            PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_GENERATION: u32 = 3
            PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_METHOD: u32 = 4
            DETAIL_OWNER: u32 = 5
            DETAIL_TARGET: u32 = 6
            PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_CAPABILITY: u32 = 7
            DETAIL_LIMIT: u32 = 8
            DETAIL_CLIENT: u32 = 9

        const module Identity:
            PROTOCOL_INTEGRATION_IDENTITY_NO_ID: u64 = 0

        const module NegotiatedLimits:
            DEFAULT_MAX_PAGE_SIZE: u64 = 256
            DEFAULT_MAX_TRACE_EVENTS: u64 = 1024
            DEFAULT_MAX_QUERY_STEPS: u64 = 1000000
            DEFAULT_MAX_PAYLOAD_BYTES: u64 = 65536

        const module ProductMetadata:
            TRACE_SCHEMA_VERSION: u32 = 1

    public:
        enum OutputChannel:
            Debugger
            TargetStdout
            TargetStderr
            Historical
            Branch

        enum DisconnectPolicy:
            Detach
            Pause
            Continue

        enum RetrySafety:
            Safe
            SameRequestOnly
            Forbidden

        struct ClientIdentity:
            name: mutable DebuggerIdentity::DebugId
            version: mutable DebuggerIdentity::DebugId
            instance: mutable DebuggerIdentity::DebugId

        struct InstallationStatus:
            healthy: mutable bool
            compiler_compatible: mutable bool
            runtime_compatible: mutable bool
            diagnostic: mutable DebuggerIdentity::DebugId

        struct IntegrationLimits:
            max_page_size: mutable u64
            max_trace_events: mutable u64
            max_query_steps: mutable u64
            max_payload_bytes: mutable u64

        struct DiscoveryDocument:
            product: mutable DebuggerIdentity::DebugId
            product_major: mutable u32
            product_minor: mutable u32
            product_patch: mutable u32
            protocol: mutable DebuggerProtocol::ProtocolVersion
            trace_schema: mutable u32
            session: mutable DebuggerIdentity::DebugId
            capabilities: mutable DebuggerCapabilities::CapabilitySet
            limits: mutable IntegrationLimits
            installation: mutable InstallationStatus

        struct SessionRequest:
            client: mutable ClientIdentity
            request_id: mutable u64
            session_id: mutable u64
            owner_token: mutable u64
            expected_generation: mutable u64
            method: mutable DebuggerProtocol::Method
            page_size: mutable u64
            target_event: mutable u64

        struct SessionResponse:
            request_id: mutable u64
            session_id: mutable u64
            stop_generation: mutable u64
            accepted: mutable bool
            next_page: mutable u64
            failure: mutable DebuggerErrors::DebuggerError

        struct CancelRequest:
            client: mutable ClientIdentity
            request_id: mutable u64
            target_request_id: mutable u64
            session_id: mutable u64
            owner_token: mutable u64
            expected_generation: mutable u64

        def integration_limits_default() -> IntegrationLimits:
            return IntegrationLimits{max_page_size: NegotiatedLimits::DEFAULT_MAX_PAGE_SIZE, max_trace_events: NegotiatedLimits::DEFAULT_MAX_TRACE_EVENTS, max_query_steps: NegotiatedLimits::DEFAULT_MAX_QUERY_STEPS, max_payload_bytes: NegotiatedLimits::DEFAULT_MAX_PAYLOAD_BYTES}

        def discovery_new(session: DebuggerSession::Session, product: DebuggerIdentity::DebugId, installation: InstallationStatus) -> DiscoveryDocument:
            return DiscoveryDocument{product: product, product_major: 0, product_minor: 1, product_patch: 0, protocol: DebuggerProtocol::protocol_version(), trace_schema: ProductMetadata::TRACE_SCHEMA_VERSION, session: session.id, capabilities: session.capabilities, limits: integration_limits_default(), installation: installation}

        def discovery_document_is_valid(document: DiscoveryDocument) -> bool:
            return false if document.product.value == Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID or document.session.value == Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID
            return false if not DebuggerProtocol::protocol_compatible(document.protocol) or document.trace_schema != ProductMetadata::TRACE_SCHEMA_VERSION
            return false if not DebuggerCapabilities::capabilities_is_valid(document.capabilities)
            return false if document.limits.max_page_size == 0 or document.limits.max_trace_events == 0 or document.limits.max_query_steps == 0 or document.limits.max_payload_bytes == 0
            return true

        def integration_method_is_mutating(method: DebuggerProtocol::Method) -> bool:
            return true if method == DebuggerProtocol::Method.CreateSession or method == DebuggerProtocol::Method.Launch or method == DebuggerProtocol::Method.Attach or method == DebuggerProtocol::Method.OpenTrace or method == DebuggerProtocol::Method.Replay or method == DebuggerProtocol::Method.Pause or method == DebuggerProtocol::Method.Continue or method == DebuggerProtocol::Method.Step or method == DebuggerProtocol::Method.ReverseStep or method == DebuggerProtocol::Method.Seek or method == DebuggerProtocol::Method.SetBreakpoints or method == DebuggerProtocol::Method.SetDataBreakpoints or method == DebuggerProtocol::Method.Checkpoint or method == DebuggerProtocol::Method.Branch or method == DebuggerProtocol::Method.Detach or method == DebuggerProtocol::Method.Terminate or method == DebuggerProtocol::Method.Close or method == DebuggerProtocol::Method.Cancel
            return false

        def client_identity_is_valid(client: ClientIdentity) -> bool:
            return client.name.value != Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID and client.version.value != Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID and client.instance.value != Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID

        def retry_is_safe(method: DebuggerProtocol::Method) -> bool:
            return method == DebuggerProtocol::Method.Discover or method == DebuggerProtocol::Method.Initialize or method == DebuggerProtocol::Method.Threads or method == DebuggerProtocol::Method.Stack or method == DebuggerProtocol::Method.Scopes or method == DebuggerProtocol::Method.Variables or method == DebuggerProtocol::Method.Evaluate or method == DebuggerProtocol::Method.Memory or method == DebuggerProtocol::Method.Compare or method == DebuggerProtocol::Method.TraceVerify or method == DebuggerProtocol::Method.TraceExport

        def retry_is_forbidden(method: DebuggerProtocol::Method) -> bool:
            return method == DebuggerProtocol::Method.CreateSession or method == DebuggerProtocol::Method.Launch or method == DebuggerProtocol::Method.Attach or method == DebuggerProtocol::Method.Branch or method == DebuggerProtocol::Method.Terminate

        def retry_is_same_request_only(method: DebuggerProtocol::Method) -> bool:
            return integration_method_is_mutating(method) and not retry_is_forbidden(method)

        def integration_method_supported(method: DebuggerProtocol::Method, capabilities: DebuggerCapabilities::CapabilitySet) -> bool:
            return capabilities.engine == DebuggerCapabilities::EngineKind.Managed or capabilities.engine == DebuggerCapabilities::EngineKind.InstrumentedNative if method == DebuggerProtocol::Method.Launch
            return capabilities.engine != DebuggerCapabilities::EngineKind.Postmortem if method == DebuggerProtocol::Method.Pause or method == DebuggerProtocol::Method.Continue or method == DebuggerProtocol::Method.Step
            return capabilities.native_attach if method == DebuggerProtocol::Method.Attach
            return capabilities.history != DebuggerCapabilities::HistoryKind.None if method == DebuggerProtocol::Method.OpenTrace
            return capabilities.history == DebuggerCapabilities::HistoryKind.Exact if method == DebuggerProtocol::Method.Replay or method == DebuggerProtocol::Method.Seek
            return capabilities.reverse_execution if method == DebuggerProtocol::Method.ReverseStep
            return capabilities.engine != DebuggerCapabilities::EngineKind.Postmortem if method == DebuggerProtocol::Method.Detach
            return capabilities.engine == DebuggerCapabilities::EngineKind.Managed or capabilities.engine == DebuggerCapabilities::EngineKind.InstrumentedNative if method == DebuggerProtocol::Method.Terminate
            return capabilities.source_breakpoints if method == DebuggerProtocol::Method.SetBreakpoints
            return capabilities.data_breakpoints if method == DebuggerProtocol::Method.SetDataBreakpoints
            return capabilities.checkpoints if method == DebuggerProtocol::Method.Checkpoint
            return capabilities.branches if method == DebuggerProtocol::Method.Branch
            return capabilities.provenance if method == DebuggerProtocol::Method.Compare
            return capabilities.trace_verification if method == DebuggerProtocol::Method.TraceVerify
            return capabilities.trace_export if method == DebuggerProtocol::Method.TraceExport
            return capabilities.typed_values if method == DebuggerProtocol::Method.Threads or method == DebuggerProtocol::Method.Stack or method == DebuggerProtocol::Method.Scopes or method == DebuggerProtocol::Method.Variables
            return capabilities.expression_evaluation if method == DebuggerProtocol::Method.Evaluate
            return capabilities.memory_read if method == DebuggerProtocol::Method.Memory
            # Every known capability-gated method has already returned above
            # when supported.  Keep only lifecycle/discovery methods in the
            # unconditional allowlist; an unsupported predicate must not fall
            # through to success.
            return true if method == DebuggerProtocol::Method.Discover or method == DebuggerProtocol::Method.Initialize or method == DebuggerProtocol::Method.CreateSession or method == DebuggerProtocol::Method.Close or method == DebuggerProtocol::Method.Cancel
            return false

        def integration_capabilities_match(left: DebuggerCapabilities::CapabilitySet, right: DebuggerCapabilities::CapabilitySet) -> bool:
            return left.engine == right.engine and left.history == right.history and left.source_breakpoints == right.source_breakpoints and left.function_breakpoints == right.function_breakpoints and left.data_breakpoints == right.data_breakpoints and left.typed_values == right.typed_values and left.expression_evaluation == right.expression_evaluation and left.reverse_execution == right.reverse_execution and left.checkpoints == right.checkpoints and left.branches == right.branches and left.concurrency_graph == right.concurrency_graph and left.provenance == right.provenance and left.remote_transport == right.remote_transport and left.trace_verification == right.trace_verification and left.trace_export == right.trace_export and left.historical_queries == right.historical_queries and left.schedule_exploration == right.schedule_exploration and left.memory_read == right.memory_read and left.native_attach == right.native_attach and left.postmortem_inspection == right.postmortem_inspection

        # The transport supplies the token it issued to the current session
        # owner. A non-zero token in the request alone is not authorization.
        def session_request_validate(request: SessionRequest, session: DebuggerSession::Session, document: DiscoveryDocument, expected_owner_token: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_PRODUCT) if not discovery_document_is_valid(document)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_CLIENT) if not client_identity_is_valid(request.client)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_SESSION) if document.session.value != session.id.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_CAPABILITY) if not integration_capabilities_match(document.capabilities, session.capabilities)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_SESSION) if request.request_id == Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID or request.session_id != Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID and request.session_id != session.id.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_OWNER) if integration_method_is_mutating(request.method) and (expected_owner_token == Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID or request.owner_token != expected_owner_token)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_METHOD) if not DebuggerProtocol::method_is_valid(request.method)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_CAPABILITY) if not integration_method_supported(request.method, session.capabilities)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, ErrorDetail::PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_GENERATION) if request.expected_generation != Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID and request.expected_generation != session.stop_generation
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_LIMIT) if request.page_size > document.limits.max_page_size
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_TARGET) if request.target_event > document.limits.max_trace_events
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_CAPABILITY) if request.method == DebuggerProtocol::Method.TraceExport and not session.capabilities.trace_export
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_CAPABILITY) if request.method == DebuggerProtocol::Method.TraceVerify and not session.capabilities.trace_verification
            return DebuggerErrors::no_error()

        def cancel_request_validate(request: CancelRequest, session: DebuggerSession::Session, document: DiscoveryDocument, expected_owner_token: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_PRODUCT) if not discovery_document_is_valid(document)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_CLIENT) if not client_identity_is_valid(request.client)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_SESSION) if document.session.value != session.id.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_SESSION) if request.request_id == Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID or request.target_request_id == Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID or request.target_request_id == request.request_id or request.session_id != Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID and request.session_id != session.id.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_OWNER) if expected_owner_token == Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID or request.owner_token != expected_owner_token
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, ErrorDetail::PROTOCOL_INTEGRATION_ERROR_DETAIL_DETAIL_GENERATION) if request.expected_generation != Identity::PROTOCOL_INTEGRATION_IDENTITY_NO_ID and request.expected_generation != session.stop_generation
            return DebuggerErrors::no_error()

        def response_ok(request: SessionRequest, session: DebuggerSession::Session, next_page: u64) -> SessionResponse:
            return SessionResponse{request_id: request.request_id, session_id: session.id.value, stop_generation: session.stop_generation, accepted: true, next_page: next_page, failure: DebuggerErrors::no_error()}

        def response_error(request: SessionRequest, session: DebuggerSession::Session, failure: DebuggerErrors::DebuggerError) -> SessionResponse:
            return SessionResponse{request_id: request.request_id, session_id: session.id.value, stop_generation: session.stop_generation, accepted: false, next_page: 0, failure: failure}
