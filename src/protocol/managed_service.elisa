# Managed session facade.  It is the executable bridge between the public
# request model and the deterministic replay engine; editor transports can
# delegate here without duplicating lifecycle or replay policy.

include "../engine/managed.elisa"
include "../inspect/managed.elisa"
include "../inspect/memory.elisa"
include "../inspect/allocations.elisa"
include "../protocol/request.elisa"
include "../core/errors.elisa"
include "../replay/compare.elisa"
include "../replay/full_checkpoint.elisa"
include "../replay/branches.elisa"
include "../metadata/source.elisa"
include "../inspect/store.elisa"
include "../inspect/expression_parser.elisa"
include "../query/timeline.elisa"
include "../query/edir_provenance.elisa"
include "../query/engine.elisa"
include "../query/history.elisa"
include "../core/cancellation.elisa"

module DebuggerManagedService:
    private:

        const module ErrorDetail:
            DETAIL_UNSUPPORTED: u32 = 1
            PROTOCOL_MANAGED_SERVICE_ERROR_DETAIL_DETAIL_STALE_GENERATION: u32 = 2
            PROTOCOL_MANAGED_SERVICE_ERROR_DETAIL_DETAIL_REQUEST_ID: u32 = 4
            PROTOCOL_MANAGED_SERVICE_ERROR_DETAIL_DETAIL_METHOD: u32 = 5
            DETAIL_MEMORY_HISTORY_UNAVAILABLE: u32 = 6
            DETAIL_MEMORY_HISTORY_RANGE: u32 = 7
            DETAIL_MEMORY_HISTORY_SLOT: u32 = 8
            DETAIL_MEMORY_HISTORY_CORRUPT: u32 = 9
            DETAIL_RECORDING_DIVERGED: u32 = 10
            DETAIL_ALLOCATION_UNAVAILABLE: u32 = 11
            DETAIL_EVALUATION_FRAME: u32 = 12
            DETAIL_EVALUATION_ENVIRONMENT: u32 = 13
            DETAIL_BREAKPOINT_POLICY: u32 = 14
            DETAIL_BREAKPOINT_CONDITION: u32 = 15
            DETAIL_BREAKPOINT_LOG_MESSAGE: u32 = 16

        const module EventCapture:
            SERVICE_EVENT_CAPTURE_CAPACITY: usize = 64

        const module ExecutionDefaults:
            DEFAULT_CONTINUE_STEPS: u64 = 64

        const module HistoryLimits:
            MAX_SEEK_EVENT: u64 = 64
            MAX_SOURCE_BREAKPOINTS: usize = 256

        const module SourceBreakpoints:
            PROTOCOL_MANAGED_SERVICE_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX: usize = 0

        const module FunctionBreakpoints:
            NO_BREAKPOINT_COUNT: usize = 0

        const module BreakpointPolicy:
            NO_BREAKPOINT_ID: u64 = 0
            FIRST_BREAKPOINT_INDEX: usize = 0

        const module RecordingState:
            ROOT_RECORDING_BRANCH: u64 = 0

        const module Initialization:
            NO_RECORDED_EVENTS: usize = 0
            NO_CHECKPOINT_EVENT: u64 = 0
            NO_CHECKPOINT_HASH: u64 = 0

        const module RequestState:
            PROTOCOL_MANAGED_SERVICE_REQUEST_STATE_NO_EXPECTED_GENERATION: u64 = 0
            PROTOCOL_MANAGED_SERVICE_REQUEST_STATE_NO_REQUEST_ID: u64 = 0
            PROTOCOL_MANAGED_SERVICE_REQUEST_STATE_REQUEST_METHOD_MAX: u16 = 32

        const module EvaluationNames:
            LOCAL_PREFIX: cstr = "local"
            GLOBAL_PREFIX: cstr = "global"
            LOCAL_PREFIX_LENGTH: usize = 5
            GLOBAL_PREFIX_LENGTH: usize = 6
            NAME_BUFFER_CAPACITY: usize = 32
            MAX_INDEX_DIGITS: usize = 2
            SINGLE_INDEX_DIGIT_COUNT: usize = 1
            ASCII_ZERO: u8 = 48
            DECIMAL_BASE: usize = 10
            FIRST_DIGIT_INDEX: usize = 0
            SECOND_DIGIT_INDEX: usize = 1

        const module EvaluationBounds:
            FIRST_PAGE_OFFSET: usize = 0
            UNBOUNDED_PAGE_REQUEST: usize = 0
            FIRST_ENTRY_INDEX: usize = 0
            FIRST_PREFIX_BYTE_INDEX: usize = 0
            NO_CONSUMED_BYTES: usize = 0

        def service_add_indexed_bindings(environment: mutable DebuggerExpressionParser::ExpressionEnvironment&, page: DebuggerManagedInspection::LocalPage, prefix: cstr, prefix_length: usize) -> bool:
            for entry_index in EvaluationBounds::FIRST_ENTRY_INDEX..<page.count:
                entry: DebuggerManagedInspection::LocalSnapshot = page.entries[entry_index]
                name: mutable u8[EvaluationNames::NAME_BUFFER_CAPACITY] = zeroed
                for prefix_index in EvaluationBounds::FIRST_PREFIX_BYTE_INDEX..<prefix_length:
                    name[prefix_index] <- prefix[prefix_index]
                digit_count: usize = EvaluationNames::MAX_INDEX_DIGITS if entry.index >= EvaluationNames::DECIMAL_BASE else EvaluationNames::SINGLE_INDEX_DIGIT_COUNT
                if digit_count == EvaluationNames::MAX_INDEX_DIGITS:
                    name[prefix_length + EvaluationNames::FIRST_DIGIT_INDEX] <- EvaluationNames::ASCII_ZERO + (entry.index / EvaluationNames::DECIMAL_BASE).u8()
                    name[prefix_length + EvaluationNames::SECOND_DIGIT_INDEX] <- EvaluationNames::ASCII_ZERO + (entry.index % EvaluationNames::DECIMAL_BASE).u8()
                else:
                    name[prefix_length] <- EvaluationNames::ASCII_ZERO + entry.index.u8()
                return false if not DebuggerExpressionParser::expression_environment_add(environment, name[0], prefix_length + digit_count, entry.value, entry.available)
            return true

        def memory_history_error(window: DebuggerHistory::QueryWindow, failure: DebuggerErrors::DebuggerError) -> DebuggerQueryEngine::QueryExecution:
            result: mutable DebuggerQueryEngine::QueryExecution = zeroed
            DebuggerQueryEngine::query_execution_initialize(result, window)
            result.failure <- failure
            return result

    public:
        struct Service:
            controller: mutable DebuggerManagedEngine::ManagedController
            recorded_events: mutable DebuggerEvents::EventEnvelope[EventCapture::SERVICE_EVENT_CAPTURE_CAPACITY]
            recorded_event_count: mutable usize
            trace_partial: mutable bool
            trace_failure: mutable DebuggerErrors::DebuggerError
            last_error: mutable DebuggerErrors::DebuggerError
            last_checkpoint_event: mutable u64
            last_checkpoint_hash: mutable u64
            has_checkpoint: mutable bool
            last_branch: mutable DebuggerIdentity::DebugId
            timeline: mutable DebuggerTimeline::Timeline

    private:
        def service_recording_mark_partial(service: mutable Service&, failure: DebuggerErrors::DebuggerError) -> void:
            service.trace_partial <- true
            service.trace_failure <- failure

        def service_recorded_event_matches(left: DebuggerEvents::EventEnvelope, right: DebuggerEvents::EventEnvelope) -> bool:
            return false if left.schema != right.schema or left.ordinal != right.ordinal or left.task.value != right.task.value or left.kind != right.kind or left.quality != right.quality or left.payload_hash != right.payload_hash
            return false if left.position.recording.value != right.position.recording.value or left.position.branch.value != right.position.branch.value or left.position.event != right.position.event
            return false if left.position.task.value != right.position.task.value or left.position.invocation.value != right.position.invocation.value or left.position.statement.value != right.position.statement.value or left.position.microstep != right.position.microstep
            return true

        def service_capture_recording(service: mutable Service&) -> void:
            return if service.trace_partial
            current_event_count: usize = service.controller.engine.event_count
            # Moving the inspection cursor backward does not change the
            # immutable events already captured for the root execution. If
            # execution resumes through that prefix, compare it with the
            # capture and downgrade only when the new execution differs.
            return if current_event_count < service.recorded_event_count
            if current_event_count > EventCapture::SERVICE_EVENT_CAPTURE_CAPACITY:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ErrorDetail::DETAIL_RECORDING_DIVERGED)
                service_recording_mark_partial(service, failure)
                return
            index: mutable usize = 0
            while index < current_event_count:
                event: DebuggerEvents::EventEnvelope = service.controller.engine.events[index]
                if event.position.branch.value != RecordingState::ROOT_RECORDING_BRANCH or event.ordinal != index.u64():
                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_RECORDING_DIVERGED)
                    service_recording_mark_partial(service, failure)
                    return
                if index < service.recorded_event_count:
                    if not service_recorded_event_matches(service.recorded_events[index], event):
                        failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_RECORDING_DIVERGED)
                        service_recording_mark_partial(service, failure)
                        return
                else:
                    service.recorded_events[index] <- event
                    service.recorded_event_count <- service.recorded_event_count + 1
                index <- index + 1

        def service_main_thread_is_available(session: DebuggerSession::Session) -> bool:
            return true if session.state == DebuggerSession::SessionState.Running or session.state == DebuggerSession::SessionState.Pausing or session.state == DebuggerSession::SessionState.Stopped or session.state == DebuggerSession::SessionState.Recording or session.state == DebuggerSession::SessionState.Replaying
            return false

    public:

        struct Result:
            accepted: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        struct EvaluateResult:
            accepted: mutable bool
            value: mutable i64
            consumed: mutable usize
            failure: mutable DebuggerErrors::DebuggerError

        struct SourceBreakpointEntry:
            id: mutable DebuggerIdentity::DebugId
            line: mutable u32
            column: mutable u32
            has_column: mutable bool
            verified: mutable bool

        struct SourceBreakpointResult:
            accepted: mutable bool
            points: mutable SourceBreakpointEntry[HistoryLimits::MAX_SOURCE_BREAKPOINTS]
            count: mutable usize
            failure: mutable DebuggerErrors::DebuggerError

        struct FunctionBreakpointEntry:
            id: mutable DebuggerIdentity::DebugId
            verified: mutable bool

        struct FunctionBreakpointResult:
            accepted: mutable bool
            points: mutable FunctionBreakpointEntry[HistoryLimits::MAX_SOURCE_BREAKPOINTS]
            count: mutable usize
            failure: mutable DebuggerErrors::DebuggerError

        struct CheckpointResult:
            accepted: mutable bool
            checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint
            failure: mutable DebuggerErrors::DebuggerError

        def service_initialize(service: mutable Service&, session: DebuggerSession::Session&, image: DebuggerEDIR::ProgramImage&, recording: DebuggerIdentity::DebugId) -> void:
            DebuggerManagedEngine::managed_initialize(service.controller, session, image, recording)
            # `recorded_event_count` gates every read of this fixed history
            # buffer, so stale entries are unreachable after the reset.
            service.recorded_event_count <- Initialization::NO_RECORDED_EVENTS
            service.trace_partial <- false
            service.trace_failure <- DebuggerErrors::no_error()
            service.last_error <- DebuggerErrors::no_error()
            service.last_checkpoint_event <- Initialization::NO_CHECKPOINT_EVENT
            service.last_checkpoint_hash <- Initialization::NO_CHECKPOINT_HASH
            service.has_checkpoint <- false
            service.last_branch <- DebuggerIdentity::debug_id(RecordingState::ROOT_RECORDING_BRANCH)
            service.timeline <- DebuggerTimeline::timeline_new(session.position, session.capabilities)

        def service_recording_capacity() -> usize:
            return EventCapture::SERVICE_EVENT_CAPTURE_CAPACITY

        def result_error(failure: DebuggerErrors::DebuggerError) -> Result:
            return Result{accepted: false, failure: failure}

        def result_ok() -> Result:
            return Result{accepted: true, failure: DebuggerErrors::no_error()}

        def evaluate_result_error(failure: DebuggerErrors::DebuggerError, consumed: usize) -> EvaluateResult:
            return EvaluateResult{accepted: false, value: 0, consumed: consumed, failure: failure}

        def source_breakpoint_result_error(failure: DebuggerErrors::DebuggerError) -> SourceBreakpointResult:
            return SourceBreakpointResult{accepted: false, points: zeroed, count: 0, failure: failure}

        def function_breakpoint_result_error(failure: DebuggerErrors::DebuggerError) -> FunctionBreakpointResult:
            return FunctionBreakpointResult{accepted: false, points: zeroed, count: FunctionBreakpoints::NO_BREAKPOINT_COUNT, failure: failure}

        def checkpoint_error(failure: DebuggerErrors::DebuggerError) -> CheckpointResult:
            return CheckpointResult{accepted: false, checkpoint: zeroed, failure: failure}

        def checkpoint_ok(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&) -> CheckpointResult:
            return CheckpointResult{accepted: true, checkpoint: checkpoint, failure: DebuggerErrors::no_error()}

        # Keep the public history view aligned with the provider after every
        # operation that can move the stop position.  Bounds are monotonic for
        # a service lifetime: moving backward changes the current position but
        # never erases retained history.
        def service_sync_timeline(service: mutable Service&) -> void:
            service_capture_recording(service)
            position: DebuggerIdentity::Position = service.controller.session.position
            bounds: mutable DebuggerTimeline::HistoryBounds = service.timeline.bounds
            if not bounds.has_retained:
                bounds <- DebuggerTimeline::history_bounds_new(position.event)
            bounds.retained_first <- position.event if position.event < bounds.retained_first
            bounds.retained_last <- position.event if position.event > bounds.retained_last
            if service.controller.session.capabilities.history == DebuggerCapabilities::HistoryKind.Exact:
                had_exact: mutable bool = bounds.has_exact
                bounds.has_exact <- true
                bounds.exact_first <- position.event if not had_exact or position.event < bounds.exact_first
                bounds.exact_last <- position.event if not had_exact or position.event > bounds.exact_last
                bounds.exact_first <- bounds.retained_first if bounds.exact_first < bounds.retained_first
                bounds.exact_last <- bounds.retained_last if bounds.exact_last > bounds.retained_last
            else:
                bounds.has_exact <- false
                bounds.exact_first <- position.event
                bounds.exact_last <- position.event
            service.timeline.bounds <- bounds
            service.timeline.position <- position
            service.timeline.bounds.current <- position.event

        def service_dispatch(service: mutable Service&, request: DebuggerProtocolRequest::Request) -> Result:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if not request.valid:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_UNSUPPORTED)
                service.last_error <- failure
                return result_error(failure)
            if not request.has_id or request.id == RequestState::PROTOCOL_MANAGED_SERVICE_REQUEST_STATE_NO_REQUEST_ID:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::PROTOCOL_MANAGED_SERVICE_ERROR_DETAIL_DETAIL_REQUEST_ID)
                service.last_error <- failure
                return result_error(failure)
            if request.method == DebuggerProtocolRequest::RequestMethod.Unknown or request.method.u16() > RequestState::PROTOCOL_MANAGED_SERVICE_REQUEST_STATE_REQUEST_METHOD_MAX:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::PROTOCOL_MANAGED_SERVICE_ERROR_DETAIL_DETAIL_METHOD)
                service.last_error <- failure
                return result_error(failure)
            if request.expected_generation != RequestState::PROTOCOL_MANAGED_SERVICE_REQUEST_STATE_NO_EXPECTED_GENERATION and request.expected_generation != service.controller.session.stop_generation:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, ErrorDetail::PROTOCOL_MANAGED_SERVICE_ERROR_DETAIL_DETAIL_STALE_GENERATION)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return service_reverse_step_over(service) if request.method == DebuggerProtocolRequest::RequestMethod.ReverseStepOver
            return service_reverse_step_out(service) if request.method == DebuggerProtocolRequest::RequestMethod.ReverseStepOut
            if request.method == DebuggerProtocolRequest::RequestMethod.Launch:
                failure <- DebuggerManagedEngine::managed_launch(service.controller)
            if request.method == DebuggerProtocolRequest::RequestMethod.Initialize:
                failure <- DebuggerErrors::no_error()
            if request.method == DebuggerProtocolRequest::RequestMethod.Discover:
                failure <- DebuggerErrors::no_error()
            if request.method == DebuggerProtocolRequest::RequestMethod.CreateSession:
                service.controller.session <- DebuggerSession::session_configure(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_UNSUPPORTED) if service.controller.session.last_error != DebuggerSession::SessionError.None
            # These lifecycle methods require a trace operand that the compact
            # request envelope does not carry. Do not report that trace I/O or
            # replay started after changing only the session state.
            if request.method == DebuggerProtocolRequest::RequestMethod.OpenTrace or request.method == DebuggerProtocolRequest::RequestMethod.Replay:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED)
            if request.method == DebuggerProtocolRequest::RequestMethod.Pause:
                failure <- DebuggerManagedEngine::managed_pause(service.controller)
            if request.method == DebuggerProtocolRequest::RequestMethod.Continue:
                failure <- DebuggerManagedEngine::managed_continue(service.controller, ExecutionDefaults::DEFAULT_CONTINUE_STEPS)
            if request.method == DebuggerProtocolRequest::RequestMethod.Step:
                failure <- DebuggerManagedEngine::managed_step(service.controller)
            if request.method == DebuggerProtocolRequest::RequestMethod.ReverseStep:
                failure <- DebuggerManagedEngine::managed_reverse_step(service.controller)
            if request.method == DebuggerProtocolRequest::RequestMethod.Seek:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if request.target_event > HistoryLimits::MAX_SEEK_EVENT
                failure <- DebuggerManagedEngine::managed_seek(service.controller, request.target_event.usize()) if DebuggerErrors::error_is_ok(failure)
            if request.method == DebuggerProtocolRequest::RequestMethod.Timeline:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if service.controller.session.capabilities.history == DebuggerCapabilities::HistoryKind.None
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.Memory:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.memory_read
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.Threads:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if not service_main_thread_is_available(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.Stack or request.method == DebuggerProtocolRequest::RequestMethod.Scopes or request.method == DebuggerProtocolRequest::RequestMethod.Variables or request.method == DebuggerProtocolRequest::RequestMethod.Evaluate:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if (request.method == DebuggerProtocolRequest::RequestMethod.Stack or request.method == DebuggerProtocolRequest::RequestMethod.Scopes or request.method == DebuggerProtocolRequest::RequestMethod.Variables) and not service.controller.session.capabilities.typed_values
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if request.method == DebuggerProtocolRequest::RequestMethod.Evaluate and not service.controller.session.capabilities.expression_evaluation
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.source_breakpoints
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.data_breakpoints
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            # The generic request envelope has no expression or breakpoint
            # operands. Do not report success for operations it cannot apply;
            # typed callers use the dedicated evaluation and breakpoint APIs.
            if (request.method == DebuggerProtocolRequest::RequestMethod.Evaluate or request.method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints or request.method == DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints) and DebuggerErrors::error_is_ok(failure):
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED)
            if request.method == DebuggerProtocolRequest::RequestMethod.Checkpoint:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.checkpoints
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
                if DebuggerErrors::error_is_ok(failure):
                    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerManagedEngine::managed_full_checkpoint(service.controller)
                    failure <- DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
                    if DebuggerErrors::error_is_ok(failure):
                        service.last_checkpoint_event <- checkpoint.event
                        service.last_checkpoint_hash <- checkpoint.state_hash
                        service.has_checkpoint <- true
            if request.method == DebuggerProtocolRequest::RequestMethod.Branch:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.branches
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
                if DebuggerErrors::error_is_ok(failure):
                    branch: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_create_branch(service.controller)
                    failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ErrorDetail::DETAIL_UNSUPPORTED) if branch.value == 0
                    service.last_branch <- branch if DebuggerErrors::error_is_ok(failure)
            if request.method == DebuggerProtocolRequest::RequestMethod.Compare or request.method == DebuggerProtocolRequest::RequestMethod.TraceVerify or request.method == DebuggerProtocolRequest::RequestMethod.TraceExport:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if request.method == DebuggerProtocolRequest::RequestMethod.Compare and not service.controller.session.capabilities.provenance
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if request.method == DebuggerProtocolRequest::RequestMethod.TraceVerify and not service.controller.session.capabilities.trace_verification
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if request.method == DebuggerProtocolRequest::RequestMethod.TraceExport and not service.controller.session.capabilities.trace_export
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
                # These operations require typed bundle/engine operands that
                # the compact lifecycle request does not carry. Prevent a
                # false success; callers use service_compare/trace APIs with
                # their validated operands.
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::PROTOCOL_MANAGED_SERVICE_ERROR_DETAIL_DETAIL_METHOD) if DebuggerErrors::error_is_ok(failure)
            # Cancellation requires a token owned by the transport layer. This
            # facade does not carry one, so never report a false success.
            if request.method == DebuggerProtocolRequest::RequestMethod.Cancel:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED)
            if request.method == DebuggerProtocolRequest::RequestMethod.Detach:
                service.controller.session <- DebuggerSession::session_detach(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_UNSUPPORTED) if service.controller.session.last_error != DebuggerSession::SessionError.None
            if request.method == DebuggerProtocolRequest::RequestMethod.Terminate:
                service.controller.session <- DebuggerSession::session_terminate(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_UNSUPPORTED) if service.controller.session.last_error != DebuggerSession::SessionError.None
            if request.method == DebuggerProtocolRequest::RequestMethod.Close:
                service.controller.session <- DebuggerSession::session_close(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_UNSUPPORTED) if service.controller.session.last_error != DebuggerSession::SessionError.None
            if request.method != DebuggerProtocolRequest::RequestMethod.Launch and request.method != DebuggerProtocolRequest::RequestMethod.Pause and request.method != DebuggerProtocolRequest::RequestMethod.Continue and request.method != DebuggerProtocolRequest::RequestMethod.Step and request.method != DebuggerProtocolRequest::RequestMethod.ReverseStep and request.method != DebuggerProtocolRequest::RequestMethod.ReverseStepOver and request.method != DebuggerProtocolRequest::RequestMethod.ReverseStepOut and request.method != DebuggerProtocolRequest::RequestMethod.Seek and request.method != DebuggerProtocolRequest::RequestMethod.Timeline and request.method != DebuggerProtocolRequest::RequestMethod.Memory and request.method != DebuggerProtocolRequest::RequestMethod.Threads and request.method != DebuggerProtocolRequest::RequestMethod.Stack and request.method != DebuggerProtocolRequest::RequestMethod.Scopes and request.method != DebuggerProtocolRequest::RequestMethod.Variables and request.method != DebuggerProtocolRequest::RequestMethod.Evaluate and request.method != DebuggerProtocolRequest::RequestMethod.SetBreakpoints and request.method != DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints and request.method != DebuggerProtocolRequest::RequestMethod.Checkpoint and request.method != DebuggerProtocolRequest::RequestMethod.Branch and request.method != DebuggerProtocolRequest::RequestMethod.Compare and request.method != DebuggerProtocolRequest::RequestMethod.TraceVerify and request.method != DebuggerProtocolRequest::RequestMethod.TraceExport:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED) if request.method != DebuggerProtocolRequest::RequestMethod.Discover and request.method != DebuggerProtocolRequest::RequestMethod.Initialize and request.method != DebuggerProtocolRequest::RequestMethod.CreateSession and request.method != DebuggerProtocolRequest::RequestMethod.OpenTrace and request.method != DebuggerProtocolRequest::RequestMethod.Replay and request.method != DebuggerProtocolRequest::RequestMethod.Detach and request.method != DebuggerProtocolRequest::RequestMethod.Terminate and request.method != DebuggerProtocolRequest::RequestMethod.Close
            service.last_error <- failure
            service_sync_timeline(service)
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            service_sync_timeline(service)
            return result_ok()

        def service_frame(service: mutable Service&) -> DebuggerManagedInspection::FrameSnapshot:
            return DebuggerManagedInspection::current_frame(service.controller.engine)

        def service_locals(service: mutable Service&, offset: usize, requested: usize) -> DebuggerManagedInspection::LocalPage:
            return DebuggerManagedInspection::locals_page(service.controller.engine, offset, requested)

        def service_frame_locals(service: mutable Service&, frame_index: usize, offset: usize, requested: usize) -> DebuggerManagedInspection::LocalPage:
            return DebuggerManagedInspection::locals_page_for_frame(service.controller.engine, frame_index, offset, requested)

        def service_globals(service: mutable Service&, offset: usize, requested: usize) -> DebuggerManagedInspection::LocalPage:
            return DebuggerManagedInspection::globals_page(service.controller.engine, offset, requested)

        # Resolve only the selected stopped frame's scalar locals and the
        # current scalar globals. The evaluator receives a copied bounded
        # environment and cannot read or mutate engine state itself.
        def service_evaluate_expression(service: mutable Service&, expression: u8&, expression_length: usize, frame_index: usize) -> EvaluateResult:
            return evaluate_result_error(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED), EvaluationBounds::NO_CONSUMED_BYTES) if not service.controller.session.capabilities.expression_evaluation
            return evaluate_result_error(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED), EvaluationBounds::NO_CONSUMED_BYTES) if not DebuggerSession::session_can_inspect(service.controller.session)
            return evaluate_result_error(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_EVALUATION_FRAME), EvaluationBounds::NO_CONSUMED_BYTES) if service.controller.engine.machine.return_stack_pointer > DebuggerEDIR::call_depth_capacity() or frame_index > service.controller.engine.machine.return_stack_pointer
            locals: DebuggerManagedInspection::LocalPage = service_frame_locals(service, frame_index, EvaluationBounds::FIRST_PAGE_OFFSET, EvaluationBounds::UNBOUNDED_PAGE_REQUEST)
            globals: DebuggerManagedInspection::LocalPage = service_globals(service, EvaluationBounds::FIRST_PAGE_OFFSET, EvaluationBounds::UNBOUNDED_PAGE_REQUEST)
            environment: mutable DebuggerExpressionParser::ExpressionEnvironment = DebuggerExpressionParser::expression_environment_new()
            return evaluate_result_error(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ErrorDetail::DETAIL_EVALUATION_ENVIRONMENT), EvaluationBounds::NO_CONSUMED_BYTES) if not service_add_indexed_bindings(environment, locals, EvaluationNames::LOCAL_PREFIX, EvaluationNames::LOCAL_PREFIX_LENGTH)
            return evaluate_result_error(DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ErrorDetail::DETAIL_EVALUATION_ENVIRONMENT), EvaluationBounds::NO_CONSUMED_BYTES) if not service_add_indexed_bindings(environment, globals, EvaluationNames::GLOBAL_PREFIX, EvaluationNames::GLOBAL_PREFIX_LENGTH)
            parsed: DebuggerExpressionParser::ExpressionParseResult = DebuggerExpressionParser::expression_parse_with_environment(expression, expression_length, environment)
            return evaluate_result_error(parsed.failure, parsed.consumed) if not parsed.valid
            return EvaluateResult{accepted: true, value: parsed.value, consumed: parsed.consumed, failure: DebuggerErrors::no_error()}

        def service_allocations(service: mutable Service&, offset: usize, requested: usize) -> DebuggerManagedAllocations::AllocationPage:
            unavailable: mutable DebuggerManagedAllocations::AllocationPage = zeroed
            unavailable.complete <- true
            unavailable.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_ALLOCATION_UNAVAILABLE)
            return unavailable if not DebuggerSession::session_can_inspect(service.controller.session)
            return unavailable if service.controller.session.capabilities.engine != DebuggerCapabilities::EngineKind.Managed or service.controller.session.capabilities.history != DebuggerCapabilities::HistoryKind.Exact
            return DebuggerManagedAllocations::allocation_page(service.controller.engine, offset, requested)


        def service_is_exact(service: mutable Service&) -> bool:
            return DebuggerManagedEngine::managed_is_exact(service.controller)

        def service_capture_trace_events(service: mutable Service&) -> void:
            service_capture_recording(service)

        def service_checkpoint(service: mutable Service&) -> DebuggerTraceBinary::ByteWriter:
            return DebuggerManagedEngine::managed_checkpoint(service.controller)

        def service_full_checkpoint(service: mutable Service&) -> CheckpointResult:
            checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerManagedEngine::managed_full_checkpoint(service.controller)
            failure: DebuggerErrors::DebuggerError = DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
            return checkpoint_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return checkpoint_ok(checkpoint)

        def service_restore_full_checkpoint(service: mutable Service&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_restore_full_checkpoint(service.controller, checkpoint)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            service_sync_timeline(service)
            return result_ok()

        def service_create_branch(service: mutable Service&) -> DebuggerIdentity::DebugId:
            branch: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_create_branch(service.controller)
            service.last_branch <- branch if branch.value != 0
            service_sync_timeline(service) if branch.value != 0
            return branch

        def service_add_intervention(service: mutable Service&, branch: DebuggerIdentity::DebugId, intervention: DebuggerBranches::Intervention) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_add_intervention(service.controller, branch, intervention)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return result_ok()

        def service_set_source_breakpoint(service: mutable Service&, location: DebuggerMetadata::SourceLocation) -> DebuggerIdentity::DebugId:
            return DebuggerManagedEngine::managed_set_source_breakpoint(service.controller, location)

        def service_replace_source_breakpoints(service: mutable Service&, source: DebuggerIdentity::DebugId, lines: u32&, requested_count: usize) -> SourceBreakpointResult:
            columns: mutable u32[HistoryLimits::MAX_SOURCE_BREAKPOINTS] = zeroed
            has_columns: mutable bool[HistoryLimits::MAX_SOURCE_BREAKPOINTS] = zeroed
            return service_replace_source_breakpoints_with_columns(service, source, lines, columns[SourceBreakpoints::PROTOCOL_MANAGED_SERVICE_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], has_columns[SourceBreakpoints::PROTOCOL_MANAGED_SERVICE_SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX], requested_count)

        def service_replace_source_breakpoints_with_columns(service: mutable Service&, source: DebuggerIdentity::DebugId, lines: u32&, columns: u32&, has_columns: bool&, requested_count: usize) -> SourceBreakpointResult:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if source.value == 0 or requested_count > HistoryLimits::MAX_SOURCE_BREAKPOINTS:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_UNSUPPORTED)
                service.last_error <- failure
                return source_breakpoint_result_error(failure)
            for index in 0..<requested_count:
                if lines[index] == 0:
                    failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_UNSUPPORTED)
                    service.last_error <- failure
                    return source_breakpoint_result_error(failure)
            if not service.controller.session.capabilities.source_breakpoints:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_UNSUPPORTED)
            if service.controller.session.state == DebuggerSession::SessionState.Created or service.controller.session.state == DebuggerSession::SessionState.Configuring or service.controller.session.state == DebuggerSession::SessionState.Launching:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Exited or service.controller.session.state == DebuggerSession::SessionState.Detached or service.controller.session.state == DebuggerSession::SessionState.Failed or service.controller.session.state == DebuggerSession::SessionState.Closed:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure)
            if service.controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or service.controller.engine.machine.faulted:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure)
            service.last_error <- failure
            return source_breakpoint_result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            replacement: DebuggerBreakpointManager::BreakpointReplacement = DebuggerManagedEngine::managed_replace_source_breakpoints_with_columns(service.controller, source, lines, columns, has_columns, requested_count)
            if not replacement.accepted:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, ErrorDetail::DETAIL_UNSUPPORTED) if not DebuggerBreakpointManager::breakpoint_table_is_valid(service.controller.state.breakpoints)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ErrorDetail::DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure)
                service.last_error <- failure
                return source_breakpoint_result_error(failure)
            service.last_error <- DebuggerErrors::no_error()
            result: mutable SourceBreakpointResult = zeroed
            result.accepted <- true
            result.count <- replacement.count
            for index in 0..<replacement.count:
                result.points[index] <- SourceBreakpointEntry{id: replacement.results[index].id, line: replacement.results[index].line, column: replacement.results[index].column, has_column: replacement.results[index].has_column, verified: replacement.results[index].verified}
            result.failure <- DebuggerErrors::no_error()
            return result

        def service_replace_function_breakpoints(service: mutable Service&, names: u8&, text_length: usize, name_offsets: usize&, name_lengths: usize&, requested_count: usize) -> FunctionBreakpointResult:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if requested_count > HistoryLimits::MAX_SOURCE_BREAKPOINTS:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY)
            if not service.controller.session.capabilities.function_breakpoints:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Created or service.controller.session.state == DebuggerSession::SessionState.Configuring or service.controller.session.state == DebuggerSession::SessionState.Launching:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Exited or service.controller.session.state == DebuggerSession::SessionState.Detached or service.controller.session.state == DebuggerSession::SessionState.Failed or service.controller.session.state == DebuggerSession::SessionState.Closed:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            if service.controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or service.controller.engine.machine.faulted:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            service.last_error <- failure
            return function_breakpoint_result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            replacement: DebuggerBreakpointManager::BreakpointReplacement = DebuggerManagedEngine::managed_replace_function_breakpoints(service.controller, names, text_length, name_offsets, name_lengths, requested_count)
            if not replacement.accepted:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if not DebuggerBreakpointManager::breakpoint_table_is_valid(service.controller.state.breakpoints)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
                service.last_error <- failure
                return function_breakpoint_result_error(failure)
            service.last_error <- DebuggerErrors::no_error()
            result: mutable FunctionBreakpointResult = zeroed
            result.accepted <- true
            result.count <- replacement.count
            for index in 0..<replacement.count:
                result.points[index] <- FunctionBreakpointEntry{id: replacement.results[index].id, verified: replacement.results[index].verified}
            result.failure <- DebuggerErrors::no_error()
            return result

        def service_set_breakpoint_hit_target(service: mutable Service&, breakpoint_id: DebuggerIdentity::DebugId, hit_target: u64) -> Result:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if breakpoint_id.value == BreakpointPolicy::NO_BREAKPOINT_ID:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY)
            if not service.controller.session.capabilities.source_breakpoints and not service.controller.session.capabilities.function_breakpoints:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Created or service.controller.session.state == DebuggerSession::SessionState.Configuring or service.controller.session.state == DebuggerSession::SessionState.Launching:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Exited or service.controller.session.state == DebuggerSession::SessionState.Detached or service.controller.session.state == DebuggerSession::SessionState.Failed or service.controller.session.state == DebuggerSession::SessionState.Closed:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            if service.controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or service.controller.engine.machine.faulted:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            if not DebuggerBreakpointManager::breakpoint_table_is_valid(service.controller.state.breakpoints):
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY) if DebuggerErrors::error_is_ok(failure)
            if not DebuggerErrors::error_is_ok(failure):
                service.last_error <- failure
                return result_error(failure)
            found: mutable bool = false
            for index in BreakpointPolicy::FIRST_BREAKPOINT_INDEX..<service.controller.state.breakpoints.count:
                if service.controller.state.breakpoints.points[index].id.value == breakpoint_id.value and (service.controller.state.breakpoints.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source or service.controller.state.breakpoints.points[index].kind == DebuggerBreakpoints::BreakpointKind.Function):
                    service.controller.state.breakpoints.points[index].hit_target <- hit_target
                    service.controller.state.breakpoints.points[index].hit_count <- 0
                    found <- true
                    break
            if not found:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_BREAKPOINT_POLICY)
                service.last_error <- failure
                return result_error(failure)
            service.last_error <- DebuggerErrors::no_error()
            return result_ok()

        def service_set_breakpoint_condition(service: mutable Service&, breakpoint_id: DebuggerIdentity::DebugId, expression: u8&, expression_length: usize) -> Result:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if breakpoint_id.value == BreakpointPolicy::NO_BREAKPOINT_ID or expression_length > DebuggerBreakpoints::breakpoint_condition_capacity():
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_BREAKPOINT_CONDITION)
            if (not service.controller.session.capabilities.source_breakpoints and not service.controller.session.capabilities.function_breakpoints) or not service.controller.session.capabilities.expression_evaluation:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_BREAKPOINT_CONDITION) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Created or service.controller.session.state == DebuggerSession::SessionState.Configuring or service.controller.session.state == DebuggerSession::SessionState.Launching:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_BREAKPOINT_CONDITION) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Exited or service.controller.session.state == DebuggerSession::SessionState.Detached or service.controller.session.state == DebuggerSession::SessionState.Failed or service.controller.session.state == DebuggerSession::SessionState.Closed:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_BREAKPOINT_CONDITION) if DebuggerErrors::error_is_ok(failure)
            if service.controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or service.controller.engine.machine.faulted:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_BREAKPOINT_CONDITION) if DebuggerErrors::error_is_ok(failure)
            if not DebuggerBreakpointManager::breakpoint_table_is_valid(service.controller.state.breakpoints):
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, ErrorDetail::DETAIL_BREAKPOINT_CONDITION) if DebuggerErrors::error_is_ok(failure)
            if not DebuggerErrors::error_is_ok(failure):
                service.last_error <- failure
                return result_error(failure)
            found: mutable bool = false
            for index in BreakpointPolicy::FIRST_BREAKPOINT_INDEX..<service.controller.state.breakpoints.count:
                if service.controller.state.breakpoints.points[index].id.value == breakpoint_id.value and (service.controller.state.breakpoints.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source or service.controller.state.breakpoints.points[index].kind == DebuggerBreakpoints::BreakpointKind.Function):
                    for byte_index in 0..<DebuggerBreakpoints::breakpoint_condition_capacity():
                        service.controller.state.breakpoints.points[index].condition_expression[byte_index] <- DebuggerBreakpoints::breakpoint_empty_expression_byte()
                    for byte_index in 0..<expression_length:
                        service.controller.state.breakpoints.points[index].condition_expression[byte_index] <- expression[byte_index]
                    service.controller.state.breakpoints.points[index].condition_length <- expression_length
                    service.controller.state.breakpoints.points[index].hit_count <- 0
                    found <- true
                    break
            if not found:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_BREAKPOINT_CONDITION)
                service.last_error <- failure
                return result_error(failure)
            service.last_error <- DebuggerErrors::no_error()
            return result_ok()

        def service_set_breakpoint_log_message(service: mutable Service&, breakpoint_id: DebuggerIdentity::DebugId, message: u8&, message_length: usize) -> Result:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if breakpoint_id.value == BreakpointPolicy::NO_BREAKPOINT_ID or message_length > DebuggerBreakpoints::breakpoint_log_message_capacity():
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_BREAKPOINT_LOG_MESSAGE)
            if not service.controller.session.capabilities.source_breakpoints:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_BREAKPOINT_LOG_MESSAGE) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Created or service.controller.session.state == DebuggerSession::SessionState.Configuring or service.controller.session.state == DebuggerSession::SessionState.Launching:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_BREAKPOINT_LOG_MESSAGE) if DebuggerErrors::error_is_ok(failure)
            if service.controller.session.state == DebuggerSession::SessionState.Exited or service.controller.session.state == DebuggerSession::SessionState.Detached or service.controller.session.state == DebuggerSession::SessionState.Failed or service.controller.session.state == DebuggerSession::SessionState.Closed:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_BREAKPOINT_LOG_MESSAGE) if DebuggerErrors::error_is_ok(failure)
            if service.controller.engine.engine_error == DebuggerReplayEngine::EngineError.ExecutionFault or service.controller.engine.machine.faulted:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_BREAKPOINT_LOG_MESSAGE) if DebuggerErrors::error_is_ok(failure)
            if not DebuggerBreakpointManager::breakpoint_table_is_valid(service.controller.state.breakpoints):
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, ErrorDetail::DETAIL_BREAKPOINT_LOG_MESSAGE) if DebuggerErrors::error_is_ok(failure)
            if not DebuggerErrors::error_is_ok(failure):
                service.last_error <- failure
                return result_error(failure)
            found: mutable bool = false
            for index in BreakpointPolicy::FIRST_BREAKPOINT_INDEX..<service.controller.state.breakpoints.count:
                if service.controller.state.breakpoints.points[index].id.value == breakpoint_id.value and service.controller.state.breakpoints.points[index].kind == DebuggerBreakpoints::BreakpointKind.Source:
                    for byte_index in 0..<DebuggerBreakpoints::breakpoint_log_message_capacity():
                        service.controller.state.breakpoints.points[index].log_message[byte_index] <- DebuggerBreakpoints::breakpoint_empty_expression_byte()
                    for byte_index in 0..<message_length:
                        service.controller.state.breakpoints.points[index].log_message[byte_index] <- message[byte_index]
                    service.controller.state.breakpoints.points[index].log_message_length <- message_length
                    service.controller.state.breakpoints.points[index].logpoint <- true
                    service.controller.state.breakpoints.points[index].hit_count <- 0
                    found <- true
                    break
            if not found:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_BREAKPOINT_LOG_MESSAGE)
                service.last_error <- failure
                return result_error(failure)
            service.last_error <- DebuggerErrors::no_error()
            return result_ok()

        def service_values(service: mutable Service&) -> DebuggerValueStore::ValueStore:
            return DebuggerManagedEngine::managed_values(service.controller)

        def service_has_checkpoint(service: Service&) -> bool:
            return service.has_checkpoint

        def service_last_checkpoint_event(service: Service&) -> u64:
            return service.last_checkpoint_event

        def service_last_checkpoint_hash(service: Service&) -> u64:
            return service.last_checkpoint_hash

        def service_last_branch(service: Service&) -> DebuggerIdentity::DebugId:
            return service.last_branch

        def service_timeline(service: Service&) -> DebuggerTimeline::Timeline:
            return service.timeline

        def service_set_timeline_capabilities(service: mutable Service&, capabilities: DebuggerCapabilities::CapabilitySet) -> DebuggerTimeline::TimelineResult:
            result: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_set_capabilities(service.timeline, capabilities)
            service.timeline <- result.timeline
            service.controller.session.capabilities <- capabilities if result.accepted
            service_sync_timeline(service) if result.accepted
            return result

        def service_add_bookmark(service: mutable Service&, label: DebuggerIdentity::DebugId, note: DebuggerIdentity::DebugId, pinned: bool) -> DebuggerTimeline::TimelineResult:
            service_sync_timeline(service)
            result: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_add_bookmark(service.timeline, label, note, pinned)
            service.timeline <- result.timeline
            return result

        def service_remove_bookmark(service: mutable Service&, bookmark: DebuggerIdentity::DebugId) -> DebuggerTimeline::TimelineResult:
            result: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_remove_bookmark(service.timeline, bookmark)
            service.timeline <- result.timeline
            return result

        def service_seek_bookmark(service: mutable Service&, bookmark: DebuggerIdentity::DebugId) -> DebuggerTimeline::TimelineResult:
            target: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_seek_bookmark(service.timeline, bookmark)
            return target if not target.accepted
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(service.controller, target.timeline.bounds.current.usize())
            return DebuggerTimeline::TimelineResult{timeline: service.timeline, accepted: false, failure: failure} if not DebuggerErrors::error_is_ok(failure)
            service.controller.session.position <- DebuggerReplayEngine::replay_engine_position(service.controller.engine)
            service.timeline <- target.timeline
            service_sync_timeline(service)
            return DebuggerTimeline::TimelineResult{timeline: service.timeline, accepted: true, failure: DebuggerErrors::no_error()}

        def service_step_over(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_over(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            service_sync_timeline(service)
            return result_ok()

        def service_step_into(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_into(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            service_sync_timeline(service)
            return result_ok()

        def service_step_out(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_out(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            service_sync_timeline(service)
            return result_ok()

        def service_reverse_step_over(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_over(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            service_sync_timeline(service)
            return result_ok()

        def service_reverse_step_out(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_out(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            service_sync_timeline(service)
            return result_ok()

        def service_reverse_continue(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_continue(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            service_sync_timeline(service)
            return result_ok()

        def service_fork(service: mutable Service&, branch: DebuggerIdentity::DebugId) -> DebuggerReplayEngine::ReplayEngine:
            return DebuggerManagedEngine::managed_fork(service.controller, branch)

        def service_intervene_accumulator(service: mutable Service&, value: i64) -> DebuggerErrors::DebuggerError:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_intervene_accumulator(service.controller.engine, value)
            service.last_error <- failure
            service_sync_timeline(service) if DebuggerErrors::error_is_ok(failure)
            return failure

        def service_compare(service: mutable Service&, other: mutable DebuggerReplayEngine::ReplayEngine&) -> DebuggerReplayCompare::BranchComparison:
            return DebuggerReplayCompare::compare_engines(service.controller.engine, other)

        def service_memory(service: mutable Service&, address: u64, length: usize) -> DebuggerMemory::MemoryRead:
            return DebuggerMemory::memory_read_managed(service.controller.engine.machine, address, length) if DebuggerSession::session_can_inspect(service.controller.session)
            return DebuggerMemory::memory_read_invalid(address, DebuggerMemory::MemoryState.Unavailable, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_UNSUPPORTED))

        # Typed local-service API. The compact JSON request and editor discovery
        # surfaces do not carry query operands, so their provenance and
        # historical-query capability flags remain false until a transport
        # exposes this complete typed contract.
        def service_memory_write_history(service: mutable Service&, slot: u64, window: DebuggerHistory::QueryWindow, token: DebuggerCancellation::CancellationToken) -> DebuggerQueryEngine::QueryExecution:
            empty_index: mutable DebuggerProvenance::ProvenanceIndex = zeroed
            DebuggerProvenance::provenance_initialize(empty_index)
            empty_binding: DebuggerIdentity::BindingIdentity = zeroed
            if not DebuggerHistory::query_window_is_valid(window):
                return DebuggerQueryEngine::query_find_writes(empty_index, empty_binding, window, token)
            if not DebuggerSession::session_can_inspect(service.controller.session):
                return memory_history_error(window, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, ErrorDetail::DETAIL_MEMORY_HISTORY_UNAVAILABLE))
            if service.controller.session.capabilities.engine != DebuggerCapabilities::EngineKind.Managed or service.controller.session.capabilities.history != DebuggerCapabilities::HistoryKind.Exact:
                return memory_history_error(window, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_MEMORY_HISTORY_UNAVAILABLE))
            if not DebuggerEDIRProvenance::edir_provenance_memory_slot_is_valid(slot):
                return memory_history_error(window, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_MEMORY_HISTORY_SLOT))
            if window.last_event >= service.controller.engine.event_count.u64():
                return memory_history_error(window, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_MEMORY_HISTORY_RANGE))
            index: mutable DebuggerProvenance::ProvenanceIndex = zeroed
            DebuggerEDIRProvenance::edir_provenance_from_engine(service.controller.engine, index)
            if not DebuggerProvenance::provenance_is_complete(index):
                return memory_history_error(window, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, ErrorDetail::DETAIL_MEMORY_HISTORY_CORRUPT))
            binding: DebuggerIdentity::BindingIdentity = DebuggerEDIRProvenance::edir_provenance_memory_binding(service.controller.engine, slot)
            return DebuggerQueryEngine::query_find_writes(index, binding, window, token)
