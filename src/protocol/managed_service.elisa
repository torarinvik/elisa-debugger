# Managed session facade.  It is the executable bridge between the public
# request model and the deterministic replay engine; editor transports can
# delegate here without duplicating lifecycle or replay policy.

include "../engine/managed.elisa"
include "../inspect/managed.elisa"
include "../inspect/memory.elisa"
include "../protocol/request.elisa"
include "../core/errors.elisa"
include "../replay/compare.elisa"
include "../replay/full_checkpoint.elisa"
include "../replay/branches.elisa"
include "../metadata/source.elisa"
include "../inspect/store.elisa"

module DebuggerManagedService:
    private:
        const DEFAULT_CONTINUE_STEPS: u64 = 64
        const DETAIL_UNSUPPORTED: u32 = 1
        const DETAIL_STALE_GENERATION: u32 = 2
        const NO_EXPECTED_GENERATION: u64 = 0
        const NO_REQUEST_ID: u64 = 0
        const DETAIL_REQUEST_ID: u32 = 4
        const DETAIL_METHOD: u32 = 5
        const REQUEST_METHOD_MAX: u16 = 29
        const MAX_SEEK_EVENT: u64 = 64

    public:
        struct Service:
            controller: mutable DebuggerManagedEngine::ManagedController
            last_error: mutable DebuggerErrors::DebuggerError

        struct Result:
            accepted: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        struct CheckpointResult:
            accepted: mutable bool
            checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint
            failure: mutable DebuggerErrors::DebuggerError

        def service_new(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage, recording: DebuggerIdentity::DebugId) -> Service:
            return Service{controller: DebuggerManagedEngine::managed_new(session, image, recording), last_error: DebuggerErrors::no_error()}

        def result_error(failure: DebuggerErrors::DebuggerError) -> Result:
            return Result{accepted: false, failure: failure}

        def result_ok() -> Result:
            return Result{accepted: true, failure: DebuggerErrors::no_error()}

        def checkpoint_error(failure: DebuggerErrors::DebuggerError) -> CheckpointResult:
            return CheckpointResult{accepted: false, checkpoint: zeroed, failure: failure}

        def checkpoint_ok(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> CheckpointResult:
            return CheckpointResult{accepted: true, checkpoint: checkpoint, failure: DebuggerErrors::no_error()}

        def service_dispatch(service: mutable Service&, request: DebuggerProtocolRequest::Request) -> Result:
            failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if not request.valid:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_UNSUPPORTED)
                service.last_error <- failure
                return result_error(failure)
            if not request.has_id or request.id == NO_REQUEST_ID:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_REQUEST_ID)
                service.last_error <- failure
                return result_error(failure)
            if request.method == DebuggerProtocolRequest::RequestMethod.Unknown or request.method.u16() > REQUEST_METHOD_MAX:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_METHOD)
                service.last_error <- failure
                return result_error(failure)
            if request.expected_generation != NO_EXPECTED_GENERATION and request.expected_generation != service.controller.session.stop_generation:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, DETAIL_STALE_GENERATION)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            if request.method == DebuggerProtocolRequest::RequestMethod.Launch:
                failure <- DebuggerManagedEngine::managed_launch(service.controller)
            if request.method == DebuggerProtocolRequest::RequestMethod.Initialize:
                failure <- DebuggerErrors::no_error()
            if request.method == DebuggerProtocolRequest::RequestMethod.Discover:
                failure <- DebuggerErrors::no_error()
            if request.method == DebuggerProtocolRequest::RequestMethod.CreateSession:
                service.controller.session <- DebuggerSession::session_configure(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_UNSUPPORTED) if service.controller.session.last_error != DebuggerSession::SessionError.None
            if request.method == DebuggerProtocolRequest::RequestMethod.OpenTrace:
                service.controller.session <- DebuggerSession::session_open_trace(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_UNSUPPORTED) if service.controller.session.last_error == DebuggerSession::SessionError.InvalidTransition
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if service.controller.session.last_error == DebuggerSession::SessionError.Unsupported
            if request.method == DebuggerProtocolRequest::RequestMethod.Replay:
                service.controller.session <- DebuggerSession::session_begin_replay(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_UNSUPPORTED) if service.controller.session.last_error == DebuggerSession::SessionError.InvalidTransition
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if service.controller.session.last_error == DebuggerSession::SessionError.Unsupported
            if request.method == DebuggerProtocolRequest::RequestMethod.Pause:
                failure <- DebuggerManagedEngine::managed_pause(service.controller)
            if request.method == DebuggerProtocolRequest::RequestMethod.Continue:
                failure <- DebuggerManagedEngine::managed_continue(service.controller, DEFAULT_CONTINUE_STEPS)
            if request.method == DebuggerProtocolRequest::RequestMethod.Step:
                failure <- DebuggerManagedEngine::managed_step(service.controller)
            if request.method == DebuggerProtocolRequest::RequestMethod.ReverseStep:
                failure <- DebuggerManagedEngine::managed_reverse_step(service.controller)
            if request.method == DebuggerProtocolRequest::RequestMethod.Seek:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED) if request.target_event > MAX_SEEK_EVENT
                failure <- DebuggerManagedEngine::managed_seek(service.controller, request.target_event.usize()) if DebuggerErrors::error_is_ok(failure)
            if request.method == DebuggerProtocolRequest::RequestMethod.Memory:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.memory_read
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.Threads or request.method == DebuggerProtocolRequest::RequestMethod.Stack or request.method == DebuggerProtocolRequest::RequestMethod.Scopes or request.method == DebuggerProtocolRequest::RequestMethod.Variables or request.method == DebuggerProtocolRequest::RequestMethod.Evaluate:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if (request.method == DebuggerProtocolRequest::RequestMethod.Threads or request.method == DebuggerProtocolRequest::RequestMethod.Stack or request.method == DebuggerProtocolRequest::RequestMethod.Scopes or request.method == DebuggerProtocolRequest::RequestMethod.Variables) and not service.controller.session.capabilities.typed_values
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if request.method == DebuggerProtocolRequest::RequestMethod.Evaluate and not service.controller.session.capabilities.expression_evaluation
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.source_breakpoints
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.data_breakpoints
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.Checkpoint:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.checkpoints
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.Branch:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if not service.controller.session.capabilities.branches
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.Compare or request.method == DebuggerProtocolRequest::RequestMethod.TraceVerify or request.method == DebuggerProtocolRequest::RequestMethod.TraceExport:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if request.method == DebuggerProtocolRequest::RequestMethod.Compare and not service.controller.session.capabilities.provenance
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if request.method == DebuggerProtocolRequest::RequestMethod.TraceVerify and not service.controller.session.capabilities.trace_verification
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if request.method == DebuggerProtocolRequest::RequestMethod.TraceExport and not service.controller.session.capabilities.trace_export
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED) if DebuggerErrors::error_is_ok(failure) and not DebuggerSession::session_can_inspect(service.controller.session)
            if request.method == DebuggerProtocolRequest::RequestMethod.Detach:
                service.controller.session <- DebuggerSession::session_detach(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_UNSUPPORTED) if service.controller.session.last_error != DebuggerSession::SessionError.None
            if request.method == DebuggerProtocolRequest::RequestMethod.Terminate:
                service.controller.session <- DebuggerSession::session_terminate(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_UNSUPPORTED) if service.controller.session.last_error != DebuggerSession::SessionError.None
            if request.method == DebuggerProtocolRequest::RequestMethod.Close:
                service.controller.session <- DebuggerSession::session_close(service.controller.session)
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_UNSUPPORTED) if service.controller.session.last_error != DebuggerSession::SessionError.None
            if request.method != DebuggerProtocolRequest::RequestMethod.Launch and request.method != DebuggerProtocolRequest::RequestMethod.Pause and request.method != DebuggerProtocolRequest::RequestMethod.Continue and request.method != DebuggerProtocolRequest::RequestMethod.Step and request.method != DebuggerProtocolRequest::RequestMethod.ReverseStep and request.method != DebuggerProtocolRequest::RequestMethod.Seek and request.method != DebuggerProtocolRequest::RequestMethod.Memory and request.method != DebuggerProtocolRequest::RequestMethod.Threads and request.method != DebuggerProtocolRequest::RequestMethod.Stack and request.method != DebuggerProtocolRequest::RequestMethod.Scopes and request.method != DebuggerProtocolRequest::RequestMethod.Variables and request.method != DebuggerProtocolRequest::RequestMethod.Evaluate and request.method != DebuggerProtocolRequest::RequestMethod.SetBreakpoints and request.method != DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints and request.method != DebuggerProtocolRequest::RequestMethod.Checkpoint and request.method != DebuggerProtocolRequest::RequestMethod.Branch and request.method != DebuggerProtocolRequest::RequestMethod.Compare and request.method != DebuggerProtocolRequest::RequestMethod.TraceVerify and request.method != DebuggerProtocolRequest::RequestMethod.TraceExport:
                failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_UNSUPPORTED) if request.method != DebuggerProtocolRequest::RequestMethod.Discover and request.method != DebuggerProtocolRequest::RequestMethod.Initialize and request.method != DebuggerProtocolRequest::RequestMethod.CreateSession and request.method != DebuggerProtocolRequest::RequestMethod.OpenTrace and request.method != DebuggerProtocolRequest::RequestMethod.Replay and request.method != DebuggerProtocolRequest::RequestMethod.Detach and request.method != DebuggerProtocolRequest::RequestMethod.Terminate and request.method != DebuggerProtocolRequest::RequestMethod.Close
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return result_ok()

        def service_frame(service: mutable Service&) -> DebuggerManagedInspection::FrameSnapshot:
            return DebuggerManagedInspection::current_frame(service.controller.engine)

        def service_locals(service: mutable Service&, offset: usize, requested: usize) -> DebuggerManagedInspection::LocalPage:
            return DebuggerManagedInspection::locals_page(service.controller.engine, offset, requested)

        def service_is_exact(service: mutable Service&) -> bool:
            return DebuggerManagedEngine::managed_is_exact(service.controller)

        def service_checkpoint(service: mutable Service&) -> DebuggerTraceBinary::ByteWriter:
            return DebuggerManagedEngine::managed_checkpoint(service.controller)

        def service_full_checkpoint(service: mutable Service&) -> CheckpointResult:
            checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerManagedEngine::managed_full_checkpoint(service.controller)
            failure: DebuggerErrors::DebuggerError = DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
            return checkpoint_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return checkpoint_ok(checkpoint)

        def service_restore_full_checkpoint(service: mutable Service&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_restore_full_checkpoint(service.controller, checkpoint)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return result_ok()

        def service_create_branch(service: mutable Service&) -> DebuggerIdentity::DebugId:
            return DebuggerManagedEngine::managed_create_branch(service.controller)

        def service_add_intervention(service: mutable Service&, branch: DebuggerIdentity::DebugId, intervention: DebuggerBranches::Intervention) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_add_intervention(service.controller, branch, intervention)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return result_ok()

        def service_set_source_breakpoint(service: mutable Service&, location: DebuggerMetadata::SourceLocation) -> DebuggerIdentity::DebugId:
            return DebuggerManagedEngine::managed_set_source_breakpoint(service.controller, location)

        def service_values(service: mutable Service&) -> DebuggerValueStore::ValueStore:
            return DebuggerManagedEngine::managed_values(service.controller)

        def service_step_over(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_over(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return result_ok()

        def service_step_out(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_out(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return result_ok()

        def service_reverse_continue(service: mutable Service&) -> Result:
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_continue(service.controller)
            service.last_error <- failure
            return result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            return result_ok()

        def service_fork(service: mutable Service&, branch: DebuggerIdentity::DebugId) -> DebuggerReplayEngine::ReplayEngine:
            return DebuggerManagedEngine::managed_fork(service.controller, branch)

        def service_intervene_accumulator(service: mutable Service&, value: i64) -> DebuggerErrors::DebuggerError:
            return DebuggerManagedEngine::managed_intervene_accumulator(service.controller.engine, value)

        def service_compare(service: mutable Service&, other: DebuggerReplayEngine::ReplayEngine) -> DebuggerReplayCompare::BranchComparison:
            return DebuggerReplayCompare::compare_engines(service.controller.engine, other)

        def service_memory(service: mutable Service&, address: u64, length: usize) -> DebuggerMemory::MemoryRead:
            return DebuggerMemory::memory_read_managed(service.controller.engine.machine, address, length) if DebuggerSession::session_can_inspect(service.controller.session)
            return DebuggerMemory::memory_read_invalid(address, DebuggerMemory::MemoryState.Unavailable, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_UNSUPPORTED))
