# Optional typed trace API for editor adapters. Keeping artifact codecs out of
# the core managed-service module keeps ordinary DAP sessions lightweight.

include "./managed_trace_export.elisa"
include "../trace/verify.elisa"
include "../trace/reader.elisa"
include "../trace/file_reader.elisa"
include "../vm/edir_codec.elisa"
include "../core/events.elisa"

module DebuggerManagedTraceService:
    private:

        const module Boundary:
            FIRST_INDEX: usize = 0
            COUNT_INCREMENT: usize = 1

        const module EmptyVerification:
            NO_VERIFIED_CHUNKS: usize = 0
            NO_VERIFIED_EVENT: u64 = 0

        const module RestoreIdentity:
            ROOT_BRANCH: u64 = 0

        const module RestoreRequest:
            REQUEST_ID: u64 = 1
            NO_EXPECTED_GENERATION: u64 = 0
            INITIAL_EVENT: u64 = 0

        const module RestoreBookmark:
            NO_ID: u64 = 0

        const module RestoreDetail:
            INVALID_READER: u32 = 3
            BUILD_MISMATCH: u32 = 4
            RECORDING_MISMATCH: u32 = 5
            CHECKPOINT_MISMATCH: u32 = 6
            EVENT_MISMATCH: u32 = 7
            CHECKPOINT_CAPACITY: u32 = 8
            CHECKPOINT_RESTORE_CAPABILITY: u32 = 9
            IMAGE_MISMATCH: u32 = 10

        const module FreshRestoreDetail:
            FRESH_CHECKPOINT_RESTORE_CAPABILITY: u32 = 11
            RECORDING: u32 = 12
            BRANCH: u32 = 13
            CAPACITY: u32 = 14
            REPLAY: u32 = 15
            DESTINATION: u32 = 16
            BUILD: u32 = 17
            IMAGE: u32 = 18

        const module FileRestoreDetail:
            DESTINATION: u32 = 19
            EVENT: u32 = 20
            REPLACE_DESTINATION: u32 = 21

        const module FileRestoreDestination:
            NO_SIDE_EVENTS: usize = 0
            NO_SCHEDULER_CURSOR: usize = 0
            NO_SCHEDULER_RECORDS: usize = 0
            SCHEDULER_NOT_ACTIVE: bool = false

        def trace_restore_error(code: DebuggerErrors::ErrorCode, retryable: bool, detail: u32) -> DebuggerManagedService::Result:
            failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(code, retryable, detail)
            return DebuggerManagedService::Result{accepted: false, failure: failure}

        def trace_restore_file_destination_is_fresh(service: DebuggerManagedService::Service&) -> bool:
            return false if service.controller.session.state != DebuggerSession::SessionState.Created or service.controller.engine.event_count != RestoreRequest::INITIAL_EVENT.usize() or service.recorded_event_count != Boundary::NO_RECORDED_EVENTS or service.trace_partial
            return false if service.controller.state.branches.count != FileRestoreDestination::NO_SIDE_EVENTS
            return false if service.controller.state.tasks.task_count != FileRestoreDestination::NO_SIDE_EVENTS or service.controller.state.tasks.wait_count != FileRestoreDestination::NO_SIDE_EVENTS
            return false if service.controller.state.tasks.scheduler.count != FileRestoreDestination::NO_SCHEDULER_RECORDS or service.controller.state.tasks.scheduler.cursor != FileRestoreDestination::NO_SCHEDULER_CURSOR
            return false if service.controller.state.tasks.scheduler.replaying != FileRestoreDestination::SCHEDULER_NOT_ACTIVE or service.controller.state.tasks.scheduler.diverged or service.controller.state.tasks.scheduler.overflowed
            return false if service.controller.state.effects.count != FileRestoreDestination::NO_SIDE_EVENTS or service.controller.state.resources.count != FileRestoreDestination::NO_SIDE_EVENTS
            return false if service.controller.state.adapters.clock.count != FileRestoreDestination::NO_SIDE_EVENTS or service.controller.state.adapters.random.count != FileRestoreDestination::NO_SIDE_EVENTS
            return service.controller.state.adapters.console.count == FileRestoreDestination::NO_SIDE_EVENTS

        def trace_restore_file(service: mutable DebuggerManagedService::Service&, path: u8&, path_length: usize, target_event: u64) -> DebuggerManagedService::Result can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            service.replay_diagnostic <- zeroed
            loaded: mutable DebuggerTraceFileReader::LoadResult = DebuggerTraceFileReader::trace_file_reader_load(path, path_length) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
            return DebuggerManagedService::result_error(loaded.failure) if not loaded.accepted
            reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceFileReader::trace_file_reader_result_reader(loaded) can Abort.Panic
            if target_event > reader.event_count.u64():
                DebuggerTraceFileReader::trace_file_reader_result_destroy(loaded) can Memory.Release, Unsafe.PointerCast
                return trace_restore_error(DebuggerErrors::ErrorCode.Unavailable, true, FileRestoreDetail::EVENT)
            original_recording: DebuggerIdentity::DebugId = service.controller.engine.recording
            service.controller.engine.recording <- reader.recording
            restored: DebuggerManagedService::Result = trace_restore_checkpoint(service, reader, reader.event_count.u64(), target_event)
            DebuggerTraceFileReader::trace_file_reader_result_destroy(loaded) can Memory.Release, Unsafe.PointerCast
            if not restored.accepted:
                service.controller.engine.recording <- original_recording
                return restored
            return restored

        def trace_restore_build_matches(build: DebuggerIdentity::BuildIdentity, manifest: DebuggerTraceManifest::BundleManifest) -> bool:
            return build.compiler.value == manifest.compiler.value and build.runtime.value == manifest.runtime.value and build.source.value == manifest.source.value and build.target.value == manifest.target.value and build.metadata_version == manifest.metadata_version

        def trace_restore_builds_equal(left: DebuggerIdentity::BuildIdentity, right: DebuggerIdentity::BuildIdentity) -> bool:
            return left.compiler.value == right.compiler.value and left.runtime.value == right.runtime.value and left.source.value == right.source.value and left.target.value == right.target.value and left.metadata_version == right.metadata_version

        def trace_restore_image_matches(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&, image: mutable DebuggerEDIR::ProgramImage&) -> bool:
            fingerprint: DebuggerEDIRCodec::ArtifactFingerprint = DebuggerEDIRCodec::artifact_fingerprint(image)
            return fingerprint.valid and checkpoint.image_fingerprint_valid and checkpoint.image_fingerprint == fingerprint.value

        def trace_restore_events_match(expected: DebuggerEvents::EventEnvelope, actual: DebuggerEvents::EventEnvelope) -> bool:
            return DebuggerEvents::event_envelopes_equal(expected, actual)

        def trace_restore_verified_position(service: DebuggerManagedService::Service&, count: usize) -> DebuggerIdentity::Position:
            position: mutable DebuggerIdentity::Position = DebuggerIdentity::initial_position(service.controller.engine.recording)
            if count > Boundary::FIRST_INDEX:
                position <- service.controller.engine.events[count - Boundary::COUNT_INCREMENT].position
                position.event <- count.u64()
            return position

        def trace_restore_dispatch(service: mutable DebuggerManagedService::Service&, method: DebuggerProtocolRequest::RequestMethod) -> DebuggerManagedService::Result:
            request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: method, id: RestoreRequest::REQUEST_ID, has_id: true, expected_generation: RestoreRequest::NO_EXPECTED_GENERATION, target_event: RestoreRequest::INITIAL_EVENT, valid: true}
            return DebuggerManagedService::service_dispatch(service, request)

        def trace_restore_dispatch_seek(service: mutable DebuggerManagedService::Service&, target_event: u64) -> DebuggerManagedService::Result:
            request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Seek, id: RestoreRequest::REQUEST_ID, has_id: true, expected_generation: RestoreRequest::NO_EXPECTED_GENERATION, target_event: target_event, valid: true}
            return DebuggerManagedService::service_dispatch(service, request)

        def trace_restore_preserve_bookmarks(restored: mutable DebuggerManagedService::Service&, previous: DebuggerManagedService::Service&, target_event: u64) -> void:
            capacity: usize = DebuggerTimeline::timeline_bookmark_capacity()
            return if previous.timeline.bookmark_count > capacity or previous.timeline.next_bookmark_id == RestoreBookmark::NO_ID or not DebuggerTimeline::history_bounds_is_valid(previous.timeline.bounds)
            restored.timeline.next_bookmark_id <- previous.timeline.next_bookmark_id
            for index in Boundary::FIRST_INDEX..<previous.timeline.bookmark_count:
                bookmark: DebuggerTimeline::Bookmark = previous.timeline.bookmarks[index]
                continue if bookmark.id.value == RestoreBookmark::NO_ID or bookmark.id.value >= previous.timeline.next_bookmark_id
                continue if bookmark.position.recording.value != restored.controller.engine.recording.value or bookmark.position.branch.value != RestoreIdentity::ROOT_BRANCH or bookmark.position.event > target_event
                continue if restored.timeline.bookmark_count >= capacity
                duplicate: mutable bool = false
                for existing in Boundary::FIRST_INDEX..<restored.timeline.bookmark_count:
                    duplicate <- true if restored.timeline.bookmarks[existing].id.value == bookmark.id.value
                continue if duplicate
                restored.timeline.bookmarks[restored.timeline.bookmark_count] <- bookmark
                restored.timeline.bookmark_count <- restored.timeline.bookmark_count + Boundary::COUNT_INCREMENT

        def trace_restore_preserve_configuration(restored: mutable DebuggerManagedService::Service&, previous: DebuggerManagedService::Service&, target_event: u64) -> void:
            restored.controller.state.breakpoints <- previous.controller.state.breakpoints
            restored.controller.state.watchpoints <- previous.controller.state.watchpoints
            restored.controller.source_path_root <- previous.controller.source_path_root
            restored.controller.source_path_root_length <- previous.controller.source_path_root_length
            restored.controller.engine.next_branch_id <- previous.controller.engine.next_branch_id
            trace_restore_preserve_bookmarks(restored, previous, target_event)

        def trace_restore_temporary_error(service: mutable DebuggerManagedService::Service&, temporary: mutable DebuggerManagedService::Service&, failure: DebuggerManagedService::Result) -> DebuggerManagedService::Result can[Memory.Release, Unsafe.PointerCast]:
            service.replay_diagnostic <- temporary.replay_diagnostic
            DebuggerManagedEngine::managed_controller_release_owned_history(temporary.controller) can Memory.Release, Unsafe.PointerCast
            return failure

        # Replay stops are private work. Replacing the live stop publishes one
        # generation change and rebuilds value references at that generation.
        def trace_restore_publish_generation(restored: mutable DebuggerManagedService::Service&, previous: DebuggerManagedService::Service&) -> void:
            restored.controller.session.stop_generation <- previous.controller.session.stop_generation
            restoring: DebuggerSession::Session = DebuggerSession::session_begin_restore(restored.controller.session, RestoreRequest::NO_EXPECTED_GENERATION)
            restored.controller.session <- DebuggerSession::session_finish_restore(restoring)
            DebuggerManagedEngine::managed_refresh_values(restored.controller)

        def trace_restore_checkpoint(service: mutable DebuggerManagedService::Service&, reader: DebuggerTraceReader::TraceReader&, replay_event: u64, restore_position_event: u64) -> DebuggerManagedService::Result can[Memory.Release, Unsafe.PointerCast]:
            service.replay_diagnostic <- zeroed
            return trace_restore_error(DebuggerErrors::ErrorCode.Corrupt, false, RestoreDetail::INVALID_READER) if not DebuggerTraceReader::reader_is_exact(reader) or reader.manifest.first_event != RestoreRequest::INITIAL_EVENT
            return trace_restore_error(DebuggerErrors::ErrorCode.Unavailable, true, RestoreDetail::INVALID_READER) if replay_event > reader.event_count.u64() or restore_position_event > replay_event
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, RestoreDetail::BUILD_MISMATCH) if not trace_restore_build_matches(service.controller.session.build, reader.manifest)
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, RestoreDetail::RECORDING_MISMATCH) if reader.recording.value != service.controller.engine.recording.value
            checkpoint_lookup: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(reader, replay_event)
            return trace_restore_error(DebuggerErrors::ErrorCode.Unavailable, true, RestoreDetail::CHECKPOINT_MISMATCH) if not checkpoint_lookup.found
            checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint_lookup.checkpoint
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, RestoreDetail::BUILD_MISMATCH) if not trace_restore_builds_equal(checkpoint.build, service.controller.session.build)
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, RestoreDetail::IMAGE_MISMATCH) if not trace_restore_image_matches(checkpoint, service.controller.engine.image)
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, RestoreDetail::RECORDING_MISMATCH) if checkpoint.recording.value != service.controller.engine.recording.value or checkpoint.branch.value != RestoreIdentity::ROOT_BRANCH
            return trace_restore_error(DebuggerErrors::ErrorCode.ResourceLimit, false, RestoreDetail::CHECKPOINT_CAPACITY) if replay_event > DebuggerManagedService::service_recording_capacity().u64()
            return trace_restore_error(DebuggerErrors::ErrorCode.Corrupt, false, RestoreDetail::INVALID_READER) if checkpoint.event > reader.event_count.u64()
            return trace_restore_error(DebuggerErrors::ErrorCode.Unsupported, false, RestoreDetail::CHECKPOINT_RESTORE_CAPABILITY) if service.controller.session.capabilities.engine != DebuggerCapabilities::EngineKind.Managed or service.controller.session.capabilities.history != DebuggerCapabilities::HistoryKind.Exact or not service.controller.session.capabilities.checkpoints

            fresh_session: DebuggerSession::Session = DebuggerSession::new_session(service.controller.session.id, service.controller.session.build, service.controller.session.capabilities)
            fresh_session.stop_generation <- service.controller.session.stop_generation
            temporary: mutable DebuggerManagedService::Service = zeroed
            DebuggerManagedService::service_initialize(temporary, fresh_session, service.controller.engine.image, service.controller.engine.recording)
            if checkpoint.effects.count > Boundary::FIRST_INDEX or checkpoint.resources.count > Boundary::FIRST_INDEX:
                replay_failure: DebuggerErrors::DebuggerError = DebuggerManagedTraceReplay::replay_recorded_prefix(temporary, checkpoint, reader.events[Boundary::FIRST_INDEX], checkpoint.event.usize())
                if not DebuggerErrors::error_is_ok(replay_failure):
                    return trace_restore_temporary_error(service, temporary, DebuggerManagedService::result_error(replay_failure))
            else:
                # Legacy typed checkpoints may retain observational adapter
                # state. Preserve their machine-prefix validation and history
                # barrier; capture still refuses an exact export of that state.
                launched: DebuggerManagedService::Result = trace_restore_dispatch(temporary, DebuggerProtocolRequest::RequestMethod.Launch)
                return trace_restore_temporary_error(service, temporary, launched) if not launched.accepted
                paused: DebuggerManagedService::Result = trace_restore_dispatch(temporary, DebuggerProtocolRequest::RequestMethod.Pause)
                return trace_restore_temporary_error(service, temporary, paused) if not paused.accepted
                while temporary.controller.engine.event_count.u64() < checkpoint.event:
                    stepped: DebuggerManagedService::Result = trace_restore_dispatch(temporary, DebuggerProtocolRequest::RequestMethod.Step)
                    return trace_restore_temporary_error(service, temporary, stepped) if not stepped.accepted

            for index in Boundary::FIRST_INDEX..<checkpoint.event.usize():
                if not trace_restore_events_match(reader.events[index], temporary.controller.engine.events[index]):
                    temporary.replay_diagnostic <- DebuggerReplayDiagnostic::event_mismatch(reader.events[index], temporary.controller.engine.events[index], trace_restore_verified_position(temporary, index))
                    failure: DebuggerManagedService::Result = trace_restore_error(DebuggerErrors::ErrorCode.Diverged, false, RestoreDetail::EVENT_MISMATCH)
                    return trace_restore_temporary_error(service, temporary, failure)
            if checkpoint.event != temporary.controller.engine.event_count.u64() or checkpoint.state_hash != DebuggerReplayEngine::replay_engine_state_hash(temporary.controller.engine) or not DebuggerCheckpoint::snapshot_matches_machine(checkpoint.machine, temporary.controller.engine.machine):
                temporary.replay_diagnostic <- DebuggerReplayDiagnostic::values(DebuggerReplayDiagnostic::Component.MachineState, trace_restore_verified_position(temporary, checkpoint.event.usize()), checkpoint.event, checkpoint.state_hash, DebuggerReplayEngine::replay_engine_state_hash(temporary.controller.engine))
                failure: DebuggerManagedService::Result = trace_restore_error(DebuggerErrors::ErrorCode.Diverged, false, RestoreDetail::CHECKPOINT_MISMATCH)
                return trace_restore_temporary_error(service, temporary, failure)
            failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_restore_full_checkpoint(temporary.controller, checkpoint)
            if not DebuggerErrors::error_is_ok(failure):
                failed: DebuggerManagedService::Result = DebuggerManagedService::Result{accepted: false, failure: failure}
                return trace_restore_temporary_error(service, temporary, failed)
            while temporary.controller.engine.event_count.u64() < replay_event:
                stepped: DebuggerManagedService::Result = trace_restore_dispatch(temporary, DebuggerProtocolRequest::RequestMethod.Step)
                if not stepped.accepted:
                    return trace_restore_temporary_error(service, temporary, stepped)
            if temporary.controller.engine.event_count.u64() != replay_event:
                failure: DebuggerManagedService::Result = trace_restore_error(DebuggerErrors::ErrorCode.Diverged, false, RestoreDetail::CHECKPOINT_MISMATCH)
                return trace_restore_temporary_error(service, temporary, failure)
            for index in Boundary::FIRST_INDEX..<replay_event.usize():
                if not trace_restore_events_match(reader.events[index], temporary.controller.engine.events[index]):
                    temporary.replay_diagnostic <- DebuggerReplayDiagnostic::event_mismatch(reader.events[index], temporary.controller.engine.events[index], trace_restore_verified_position(temporary, index))
                    temporary.replay_diagnostic.has_verified_checkpoint <- index.u64() >= checkpoint.event
                    temporary.replay_diagnostic.verified_checkpoint_event <- checkpoint.event
                    failure: DebuggerManagedService::Result = trace_restore_error(DebuggerErrors::ErrorCode.Diverged, false, RestoreDetail::EVENT_MISMATCH)
                    return trace_restore_temporary_error(service, temporary, failure)
            trace_restore_preserve_configuration(temporary, service, replay_event)
            if restore_position_event < replay_event:
                sought: DebuggerManagedService::Result = trace_restore_dispatch_seek(temporary, restore_position_event)
                if not sought.accepted:
                    return trace_restore_temporary_error(service, temporary, sought)
            if temporary.controller.engine.event_count.u64() != restore_position_event:
                failure: DebuggerManagedService::Result = trace_restore_error(DebuggerErrors::ErrorCode.Diverged, false, RestoreDetail::CHECKPOINT_MISMATCH)
                return trace_restore_temporary_error(service, temporary, failure)
            trace_restore_publish_generation(temporary, service)
            DebuggerManagedService::service_sync_timeline(temporary)
            DebuggerManagedEngine::managed_controller_release_owned_history(service.controller) can Memory.Release, Unsafe.PointerCast
            service <- temporary
            return DebuggerManagedService::Result{accepted: true, failure: DebuggerErrors::no_error()}

        def trace_restore_fresh_checkpoint(service: mutable DebuggerManagedService::Service&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&) -> DebuggerManagedService::Result can[Memory.Release, Unsafe.PointerCast]:
            service.replay_diagnostic <- zeroed
            failure: mutable DebuggerErrors::DebuggerError = DebuggerFullCheckpoint::full_checkpoint_validate(checkpoint)
            return DebuggerManagedService::result_error(failure) if not DebuggerErrors::error_is_ok(failure)
            capabilities: DebuggerCapabilities::CapabilitySet = service.controller.session.capabilities
            return trace_restore_error(DebuggerErrors::ErrorCode.Unsupported, false, FreshRestoreDetail::FRESH_CHECKPOINT_RESTORE_CAPABILITY) if capabilities.engine != DebuggerCapabilities::EngineKind.Managed or capabilities.history != DebuggerCapabilities::HistoryKind.Exact or not capabilities.checkpoints
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FreshRestoreDetail::BUILD) if not trace_restore_builds_equal(checkpoint.build, service.controller.session.build)
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FreshRestoreDetail::IMAGE) if not trace_restore_image_matches(checkpoint, service.controller.engine.image)
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FreshRestoreDetail::DESTINATION) if service.controller.session.state != DebuggerSession::SessionState.Created or service.controller.engine.event_count != RestoreRequest::INITIAL_EVENT.usize() or service.recorded_event_count != Boundary::NO_RECORDED_EVENTS or service.trace_partial or service.controller.state.branches.count != Boundary::NO_RECORDED_EVENTS
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FreshRestoreDetail::RECORDING) if checkpoint.recording.value != service.controller.engine.recording.value
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FreshRestoreDetail::BRANCH) if checkpoint.branch.value != RestoreIdentity::ROOT_BRANCH
            return trace_restore_error(DebuggerErrors::ErrorCode.ResourceLimit, false, FreshRestoreDetail::CAPACITY) if checkpoint.event > DebuggerManagedService::service_recording_capacity().u64()

            fresh_session: DebuggerSession::Session = DebuggerSession::new_session(service.controller.session.id, service.controller.session.build, capabilities)
            fresh_session.stop_generation <- service.controller.session.stop_generation
            temporary: mutable DebuggerManagedService::Service = zeroed
            DebuggerManagedService::service_initialize(temporary, fresh_session, service.controller.engine.image, service.controller.engine.recording)
            launched: DebuggerManagedService::Result = trace_restore_dispatch(temporary, DebuggerProtocolRequest::RequestMethod.Launch)
            return trace_restore_temporary_error(service, temporary, launched) if not launched.accepted
            paused: DebuggerManagedService::Result = trace_restore_dispatch(temporary, DebuggerProtocolRequest::RequestMethod.Pause)
            return trace_restore_temporary_error(service, temporary, paused) if not paused.accepted
            while temporary.controller.engine.event_count.u64() < checkpoint.event:
                stepped: DebuggerManagedService::Result = trace_restore_dispatch(temporary, DebuggerProtocolRequest::RequestMethod.Step)
                if not stepped.accepted:
                    return trace_restore_temporary_error(service, temporary, stepped)

            if temporary.controller.engine.event_count.u64() != checkpoint.event or DebuggerReplayEngine::replay_engine_state_hash(temporary.controller.engine) != checkpoint.state_hash or not DebuggerCheckpoint::snapshot_matches_machine(checkpoint.machine, temporary.controller.engine.machine):
                temporary.replay_diagnostic <- DebuggerReplayDiagnostic::values(DebuggerReplayDiagnostic::Component.MachineState, DebuggerIdentity::initial_position(temporary.controller.engine.recording), checkpoint.event, checkpoint.state_hash, DebuggerReplayEngine::replay_engine_state_hash(temporary.controller.engine))
                failed: DebuggerManagedService::Result = trace_restore_error(DebuggerErrors::ErrorCode.Diverged, false, FreshRestoreDetail::REPLAY)
                return trace_restore_temporary_error(service, temporary, failed)
            failure <- DebuggerManagedEngine::managed_restore_full_checkpoint(temporary.controller, checkpoint)
            if not DebuggerErrors::error_is_ok(failure):
                failed: DebuggerManagedService::Result = DebuggerManagedService::result_error(failure)
                return trace_restore_temporary_error(service, temporary, failed)
            trace_restore_preserve_configuration(temporary, service, checkpoint.event)
            trace_restore_publish_generation(temporary, service)
            DebuggerManagedService::service_sync_timeline(temporary)
            DebuggerManagedEngine::managed_controller_release_owned_history(service.controller) can Memory.Release, Unsafe.PointerCast
            service <- temporary
            return DebuggerManagedService::result_ok()

        def trace_report_for_failure(service: DebuggerManagedService::Service&, failure: DebuggerErrors::DebuggerError) -> DebuggerTraceVerify::VerificationReport:
            state: mutable DebuggerTraceVerify::VerificationState = DebuggerTraceVerify::VerificationState.Corrupt
            state <- DebuggerTraceVerify::VerificationState.Unavailable if failure.code == DebuggerErrors::ErrorCode.Unsupported
            state <- DebuggerTraceVerify::VerificationState.Partial if service.trace_partial and failure.code != DebuggerErrors::ErrorCode.Unsupported
            state <- DebuggerTraceVerify::VerificationState.Unavailable if failure.code == DebuggerErrors::ErrorCode.Unavailable and not service.trace_partial
            return DebuggerTraceVerify::VerificationReport{state: state, verified_chunks: EmptyVerification::NO_VERIFIED_CHUNKS, verified_event: EmptyVerification::NO_VERIFIED_EVENT, replayable: false, failure: failure}

    public:
        # Build a stable snapshot; later service operations do not mutate it.
        # Rewinds preserve the recorded high-water checkpoint. Child-branch
        # execution remains a partial capture until lineage is serialized.
        def service_trace_bundle(service: mutable DebuggerManagedService::Service&) -> DebuggerTracePipeline::BundleBuildResult can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            return DebuggerManagedTraceCapture::capture_export_bundle(service) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast

        def service_trace_export(service: mutable DebuggerManagedService::Service&) -> DebuggerTraceExport::ExportResult can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            return DebuggerManagedTraceExportService::service_trace_export(service) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast

        def service_trace_verify(service: mutable DebuggerManagedService::Service&) -> DebuggerTraceVerify::VerificationReport can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            built: DebuggerTracePipeline::BundleBuildResult = DebuggerManagedTraceCapture::capture_verification_bundle(service) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
            return trace_report_for_failure(service, built.failure) if not built.accepted
            bundle: mutable heap DebuggerTraceBundle::TraceBundle& = DebuggerTracePipeline::bundle_build_result_bundle(built) can Abort.Panic
            report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_bundle(bundle) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
            DebuggerTraceBundle::bundle_destroy(bundle) can Memory.Release, Unsafe.PointerCast
            return report

        # Restore from a reader-owned checkpoint only after replaying and
        # matching the complete prefix in a temporary service.
        def service_trace_restore_checkpoint(service: mutable DebuggerManagedService::Service&, reader: DebuggerTraceReader::TraceReader&, target_event: u64) -> DebuggerManagedService::Result can[Memory.Release, Unsafe.PointerCast]:
            return trace_restore_checkpoint(service, reader, target_event, target_event) can Memory.Release, Unsafe.PointerCast

        # Restore a decoded checkpoint into a fresh service after verifying its
        # build and complete canonical EDIR image fingerprint, then replaying
        # its machine prefix. The identity fields and hashes detect accidental
        # mismatches but do not authenticate checkpoints from untrusted
        # sources. The destination must be Created, have no recorded events or
        # branch records, and negotiate checkpoint support; debug configuration
        # may be seeded beforehand and is preserved.
        def service_restore_fresh_checkpoint(service: mutable DebuggerManagedService::Service&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&) -> DebuggerManagedService::Result can[Memory.Release, Unsafe.PointerCast]:
            return trace_restore_fresh_checkpoint(service, checkpoint) can Memory.Release, Unsafe.PointerCast

        # Restore an exact committed artifact into a new service state. File
        # decoding and replay happen against temporary owned state; the caller's
        # service is replaced only after compatibility, checkpoint, and prefix
        # verification all succeed.
        def service_trace_restore_file(service: mutable DebuggerManagedService::Service&, path: u8&, path_length: usize, target_event: u64) -> DebuggerManagedService::Result can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidState, false, FileRestoreDetail::DESTINATION) if not trace_restore_file_destination_is_fresh(service)
            return trace_restore_file(service, path, path_length, target_event) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast

        # Replace a stopped managed session only after a complete trace decode,
        # compatibility check, and replay has succeeded. Adapters must reject
        # stale stop generations and active external-effect requests first.
        def service_trace_replace_from_file(service: mutable DebuggerManagedService::Service&, path: u8&, path_length: usize, target_event: u64) -> DebuggerManagedService::Result can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            return trace_restore_error(DebuggerErrors::ErrorCode.InvalidState, false, FileRestoreDetail::REPLACE_DESTINATION) if service.controller.session.state != DebuggerSession::SessionState.Stopped
            return trace_restore_file(service, path, path_length, target_event) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
