# Stable protocol model shared by the session service and editor adapters.

include "../core/errors.elisa"

module DebuggerProtocol:
    private:

        const module EnvelopeLimits:
            PROTOCOL_MESSAGES_ENVELOPE_LIMITS_MAX_PAGE_SIZE: u64 = 256
            MESSAGE_KIND_MAX: u16 = 2
            METHOD_MAX: u16 = 28

        const module ProtocolVersionBounds:
            PROTOCOL_MESSAGES_VERSION_BOUNDS_PROTOCOL_MAJOR: u32 = 1
            PROTOCOL_MESSAGES_VERSION_BOUNDS_PROTOCOL_MINOR: u32 = 0

    public:
        enum MessageKind:
            Request
            Response
            Event

        enum Method:
            Discover
            Initialize
            CreateSession
            OpenTrace
            Launch
            Attach
            Replay
            Pause
            Continue
            Step
            ReverseStep
            Seek
            Threads
            Stack
            Scopes
            Variables
            Evaluate
            SetBreakpoints
            SetDataBreakpoints
            Checkpoint
            Branch
            Compare
            TraceVerify
            TraceExport
            Detach
            Terminate
            Close
            Cancel
            Memory

        struct ProtocolVersion:
            major: mutable u32
            minor: mutable u32

        struct RequestEnvelope:
            kind: mutable MessageKind
            method: mutable Method
            request_id: mutable u64
            session_id: mutable u64
            expected_stop_generation: mutable u64
            page_size: mutable u64
            target_event: mutable u64

        struct ResponseEnvelope:
            request_id: mutable u64
            ok: mutable bool
            failure: mutable DebuggerErrors::DebuggerError
            stop_generation: mutable u64
            next_page: mutable u64

        def protocol_version() -> ProtocolVersion:
            return ProtocolVersion{major: ProtocolVersionBounds::PROTOCOL_MESSAGES_VERSION_BOUNDS_PROTOCOL_MAJOR, minor: ProtocolVersionBounds::PROTOCOL_MESSAGES_VERSION_BOUNDS_PROTOCOL_MINOR}

        def protocol_compatible(client: ProtocolVersion) -> bool:
            return client.major == ProtocolVersionBounds::PROTOCOL_MESSAGES_VERSION_BOUNDS_PROTOCOL_MAJOR and client.minor <= ProtocolVersionBounds::PROTOCOL_MESSAGES_VERSION_BOUNDS_PROTOCOL_MINOR

        def message_kind_is_valid(kind: MessageKind) -> bool:
            return kind.u16() <= EnvelopeLimits::MESSAGE_KIND_MAX

        def method_is_valid(method: Method) -> bool:
            return method.u16() <= EnvelopeLimits::METHOD_MAX

        def protocol_bound_page_size(requested: u64) -> u64:
            return EnvelopeLimits::PROTOCOL_MESSAGES_ENVELOPE_LIMITS_MAX_PAGE_SIZE if requested == 0 or requested > EnvelopeLimits::PROTOCOL_MESSAGES_ENVELOPE_LIMITS_MAX_PAGE_SIZE else requested

        def response_ok(request_id: u64, generation: u64) -> ResponseEnvelope:
            return ResponseEnvelope{request_id: request_id, ok: true, failure: DebuggerErrors::no_error(), stop_generation: generation, next_page: 0}

        def response_error(request_id: u64, failure: DebuggerErrors::DebuggerError, generation: u64) -> ResponseEnvelope:
            return ResponseEnvelope{request_id: request_id, ok: false, failure: failure, stop_generation: generation, next_page: 0}

        def response_is_valid(response: ResponseEnvelope) -> bool:
            return false if response.request_id == 0 or not DebuggerErrors::error_is_well_formed(response.failure)
            return DebuggerErrors::error_is_ok(response.failure) if response.ok
            return not DebuggerErrors::error_is_ok(response.failure)
