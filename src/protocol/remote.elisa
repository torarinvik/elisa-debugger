# Remote session transport state.  Authentication is deliberately delegated to
# an externally provisioned tunnel or platform security binding; this module
# never invents cryptography or accepts unauthenticated process control.

include "../core/errors.elisa"
include "../security/policy.elisa"
include "./artifacts.elisa"

module DebuggerRemote:
    private:
        const REMOTE_PROTOCOL_MAJOR: u32 = 1
        const REMOTE_PROTOCOL_MINOR: u32 = 0
        const REMOTE_ENGINE_MANAGED: u32 = 1
        const REMOTE_TRACE_SCHEMA: u32 = 1
        const REMOTE_HEARTBEAT_LIMIT: u64 = 3
        const REMOTE_MAX_AUTH_ATTEMPTS: u32 = 3
        const REMOTE_OPERATION_MAX: u16 = 4
        const REMOTE_NO_CREDENTIAL: u64 = 0
        const DETAIL_PROTOCOL: u32 = 1
        const DETAIL_AUTHENTICATION: u32 = 2
        const DETAIL_QUOTA: u32 = 3
        const DETAIL_STATE: u32 = 4
        const DETAIL_AUTH_ATTEMPTS: u32 = 5
        const DETAIL_INSPECT_PERMISSION: u32 = 6
        const DETAIL_CONTROL_PERMISSION: u32 = 7
        const DETAIL_MUTATION_PERMISSION: u32 = 8
        const DETAIL_EXTERNAL_EXECUTION_PERMISSION: u32 = 9
        const DETAIL_ARTIFACT_PERMISSION: u32 = 10
        const DETAIL_REMOTE_TRANSPORT: u32 = 11
        const DETAIL_INVALID_OPERATION: u32 = 12

    public:
        enum RemoteState:
            Disconnected
            Authenticating
            Connected
            Draining
            Failed

        enum RemoteDisconnectPolicy:
            Detach
            Pause
            Continue

        # Keep remote authorization decisions distinct even when the host
        # policy currently maps them onto its shared permission vocabulary.
        enum RemoteOperation:
            Inspect
            Control
            Mutate
            ExternalExecution
            ArtifactTransfer

        struct RemoteHandshake:
            protocol_major: mutable u32
            protocol_minor: mutable u32
            engine: mutable u32
            trace_schema: mutable u32
            authenticated: mutable bool

        struct RemoteChannel:
            state: mutable RemoteState
            handshake: mutable RemoteHandshake
            disconnect_policy: mutable RemoteDisconnectPolicy
            missed_heartbeats: mutable u64
            auth_attempts: mutable u32
            policy: mutable DebuggerSecurity::Policy
            bytes_received: mutable u64
            quota_exceeded: mutable bool
            artifact: mutable DebuggerRemoteArtifacts::ArtifactTransfer
            last_error: mutable DebuggerErrors::DebuggerError

        def remote_new(policy: DebuggerSecurity::Policy) -> RemoteChannel:
            return RemoteChannel{state: RemoteState.Disconnected, handshake: RemoteHandshake{protocol_major: 0, protocol_minor: 0, engine: 0, trace_schema: 0, authenticated: false}, disconnect_policy: RemoteDisconnectPolicy.Detach, missed_heartbeats: 0, auth_attempts: 0, policy: policy, bytes_received: 0, quota_exceeded: false, artifact: DebuggerRemoteArtifacts::transfer_new(), last_error: DebuggerErrors::no_error()}

        def remote_new_with_policy(policy: DebuggerSecurity::Policy, disconnect_policy: RemoteDisconnectPolicy) -> RemoteChannel:
            updated: mutable RemoteChannel = remote_new(policy)
            updated.disconnect_policy <- disconnect_policy
            return updated

        def remote_begin(channel: RemoteChannel) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            return updated if channel.state != RemoteState.Disconnected
            return updated if channel.auth_attempts >= REMOTE_MAX_AUTH_ATTEMPTS
            updated.state <- RemoteState.Authenticating
            updated.handshake.protocol_major <- 0
            updated.handshake.protocol_minor <- 0
            updated.handshake.engine <- 0
            updated.handshake.trace_schema <- 0
            updated.handshake.authenticated <- false
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        # Authentication is intentionally delegated to a host provisioned
        # credential or secure tunnel. Equality is the only policy this module
        # owns; no key material or cryptographic primitive is invented here.
        def remote_authenticate(channel: RemoteChannel, presented: u64, expected: u64) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            if channel.state != RemoteState.Authenticating:
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_STATE)
                return updated
            if expected != REMOTE_NO_CREDENTIAL and presented == expected:
                updated.handshake.authenticated <- true
                updated.auth_attempts <- 0
                updated.last_error <- DebuggerErrors::no_error()
                return updated
            updated.handshake.authenticated <- false
            updated.auth_attempts <- channel.auth_attempts + 1 if channel.auth_attempts < REMOTE_MAX_AUTH_ATTEMPTS
            updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.PermissionDenied, true, DETAIL_AUTH_ATTEMPTS)
            if updated.auth_attempts >= REMOTE_MAX_AUTH_ATTEMPTS:
                updated.state <- RemoteState.Failed
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.PermissionDenied, false, DETAIL_AUTH_ATTEMPTS)
            return updated

        def remote_accept_handshake(channel: RemoteChannel, handshake: RemoteHandshake) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            if channel.state != RemoteState.Authenticating:
                updated.state <- RemoteState.Failed
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_STATE)
                return updated
            if handshake.protocol_major != REMOTE_PROTOCOL_MAJOR or handshake.protocol_minor > REMOTE_PROTOCOL_MINOR or handshake.engine != REMOTE_ENGINE_MANAGED or handshake.trace_schema != REMOTE_TRACE_SCHEMA:
                updated.state <- RemoteState.Failed
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, DETAIL_PROTOCOL)
                return updated
            if not handshake.authenticated or not channel.handshake.authenticated:
                updated.state <- RemoteState.Failed
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.PermissionDenied, false, DETAIL_AUTHENTICATION)
                return updated
            updated.handshake <- handshake
            updated.state <- RemoteState.Connected
            updated.missed_heartbeats <- 0
            updated.bytes_received <- 0
            updated.quota_exceeded <- false
            updated.auth_attempts <- 0
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        def remote_receive(channel: RemoteChannel, bytes: u64) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            return updated if channel.state != RemoteState.Connected
            if bytes > channel.policy.quotas.remote_payload_bytes:
                updated.quota_exceeded <- true
                updated.state <- RemoteState.Draining
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, DETAIL_QUOTA)
                return updated
            if channel.bytes_received > channel.policy.quotas.remote_payload_bytes - bytes:
                updated.quota_exceeded <- true
                updated.state <- RemoteState.Draining
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, DETAIL_QUOTA)
                return updated
            updated.bytes_received <- channel.bytes_received + bytes
            updated.missed_heartbeats <- 0
            return updated

        def remote_begin_artifact(channel: RemoteChannel, size: usize, checksum: u64) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            authorization: DebuggerErrors::DebuggerError = remote_authorize(channel, RemoteOperation.ArtifactTransfer)
            if not DebuggerErrors::error_is_ok(authorization):
                updated.last_error <- authorization
                return updated
            if DebuggerRemoteArtifacts::transfer_is_receiving(channel.artifact):
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_STATE)
                return updated
            if size.u64() > channel.policy.quotas.remote_payload_bytes or channel.bytes_received > channel.policy.quotas.remote_payload_bytes - size.u64():
                updated.quota_exceeded <- true
                updated.state <- RemoteState.Draining
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, DETAIL_QUOTA)
                return updated
            updated.artifact <- DebuggerRemoteArtifacts::transfer_begin(channel.artifact, size, checksum)
            updated.last_error <- updated.artifact.last_error
            return updated

        def remote_push_artifact(channel: RemoteChannel, sequence: u64, bytes: u8&, length: usize) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            authorization: DebuggerErrors::DebuggerError = remote_authorize(channel, RemoteOperation.ArtifactTransfer)
            if not DebuggerErrors::error_is_ok(authorization):
                updated.last_error <- authorization
                return updated
            accounted: RemoteChannel = remote_receive(channel, length.u64())
            return accounted if accounted.state != RemoteState.Connected
            accounted.artifact <- DebuggerRemoteArtifacts::transfer_push(channel.artifact, sequence, bytes, length)
            accounted.last_error <- accounted.artifact.last_error
            return accounted

        def remote_finish_artifact(channel: RemoteChannel) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            authorization: DebuggerErrors::DebuggerError = remote_authorize(channel, RemoteOperation.ArtifactTransfer)
            if not DebuggerErrors::error_is_ok(authorization):
                updated.last_error <- authorization
                return updated
            updated.artifact <- DebuggerRemoteArtifacts::transfer_finish(channel.artifact)
            updated.last_error <- updated.artifact.last_error
            return updated

        def remote_heartbeat_missed(channel: RemoteChannel) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            return updated if channel.state != RemoteState.Connected
            if channel.missed_heartbeats >= REMOTE_HEARTBEAT_LIMIT:
                updated.state <- RemoteState.Draining
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, true, DETAIL_STATE)
                return updated
            updated.missed_heartbeats <- channel.missed_heartbeats + 1
            if updated.missed_heartbeats >= REMOTE_HEARTBEAT_LIMIT:
                updated.state <- RemoteState.Draining
                updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, true, DETAIL_STATE)
            return updated

        def remote_disconnect(channel: RemoteChannel) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            updated.state <- RemoteState.Disconnected
            updated.handshake.protocol_major <- 0
            updated.handshake.protocol_minor <- 0
            updated.handshake.engine <- 0
            updated.handshake.trace_schema <- 0
            updated.handshake.authenticated <- false
            updated.missed_heartbeats <- 0
            updated.bytes_received <- 0
            # A quota violation permanently taints this channel.  Clearing the
            # flag here would let a client bypass the reconnect gate by
            # disconnecting first; create a fresh channel to obtain a new
            # quota budget.
            updated.quota_exceeded <- channel.quota_exceeded
            updated.artifact <- DebuggerRemoteArtifacts::transfer_new()
            # Failed attempts remain charged to this channel across every
            # disconnect. A successful authentication clears the counter;
            # creating a new channel starts a fresh attempt budget.
            updated.auth_attempts <- channel.auth_attempts
            updated.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, DETAIL_QUOTA) if channel.quota_exceeded
            updated.last_error <- DebuggerErrors::no_error() if not channel.quota_exceeded
            return updated

        def remote_reconnect(channel: RemoteChannel) -> RemoteChannel:
            updated: mutable RemoteChannel = channel
            return updated if channel.quota_exceeded
            return updated if channel.auth_attempts >= REMOTE_MAX_AUTH_ATTEMPTS
            return updated if channel.state != RemoteState.Disconnected and channel.state != RemoteState.Draining and channel.state != RemoteState.Failed
            updated.state <- RemoteState.Authenticating
            updated.handshake.protocol_major <- 0
            updated.handshake.protocol_minor <- 0
            updated.handshake.engine <- 0
            updated.handshake.trace_schema <- 0
            updated.handshake.authenticated <- false
            updated.missed_heartbeats <- 0
            updated.bytes_received <- 0
            updated.quota_exceeded <- false
            updated.artifact <- DebuggerRemoteArtifacts::transfer_new()
            updated.last_error <- DebuggerErrors::no_error()
            return updated

        def remote_can_control(channel: RemoteChannel) -> bool:
            return DebuggerErrors::error_is_ok(remote_authorize(channel, RemoteOperation.Control))

    private:
        def remote_operation_permission(operation: RemoteOperation) -> DebuggerSecurity::Permission:
            return DebuggerSecurity::Permission.Inspect if operation == RemoteOperation.Inspect
            return DebuggerSecurity::Permission.Execute if operation == RemoteOperation.Control
            return DebuggerSecurity::Permission.Mutate if operation == RemoteOperation.Mutate
            return DebuggerSecurity::Permission.SpawnProcess if operation == RemoteOperation.ExternalExecution
            return DebuggerSecurity::Permission.ExportTrace

        def remote_operation_detail(operation: RemoteOperation) -> u32:
            return DETAIL_INSPECT_PERMISSION if operation == RemoteOperation.Inspect
            return DETAIL_CONTROL_PERMISSION if operation == RemoteOperation.Control
            return DETAIL_MUTATION_PERMISSION if operation == RemoteOperation.Mutate
            return DETAIL_EXTERNAL_EXECUTION_PERMISSION if operation == RemoteOperation.ExternalExecution
            return DETAIL_ARTIFACT_PERMISSION

    public:
        # This gate is the single point remote adapters should call before
        # exposing an operation. A verified tunnel alone is not permission to
        # inspect, control, mutate, spawn a process, or export an artifact.
        def remote_authorize(channel: RemoteChannel, operation: RemoteOperation) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_INVALID_OPERATION) if operation.u16() > REMOTE_OPERATION_MAX
            if channel.quota_exceeded:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, DETAIL_QUOTA)
            if channel.state != RemoteState.Connected or not channel.handshake.authenticated or channel.missed_heartbeats >= REMOTE_HEARTBEAT_LIMIT:
                return channel.last_error if not DebuggerErrors::error_is_ok(channel.last_error)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, true, DETAIL_REMOTE_TRANSPORT)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.PermissionDenied, false, remote_operation_detail(operation)) if not DebuggerSecurity::policy_allows(channel.policy, remote_operation_permission(operation))
            return DebuggerErrors::no_error()

        def remote_can_inspect(channel: RemoteChannel) -> bool:
            return DebuggerErrors::error_is_ok(remote_authorize(channel, RemoteOperation.Inspect))

        def remote_can_mutate(channel: RemoteChannel) -> bool:
            return DebuggerErrors::error_is_ok(remote_authorize(channel, RemoteOperation.Mutate))

        def remote_can_execute_external(channel: RemoteChannel) -> bool:
            return DebuggerErrors::error_is_ok(remote_authorize(channel, RemoteOperation.ExternalExecution))

        def remote_quota_remaining(channel: RemoteChannel) -> u64:
            return channel.policy.quotas.remote_payload_bytes - channel.bytes_received if channel.bytes_received < channel.policy.quotas.remote_payload_bytes
            return 0

        def remote_is_connected(channel: RemoteChannel) -> bool:
            return channel.state == RemoteState.Connected and channel.handshake.authenticated and not channel.quota_exceeded and channel.missed_heartbeats < REMOTE_HEARTBEAT_LIMIT

        def remote_authentication_attempts(channel: RemoteChannel) -> u32:
            return channel.auth_attempts

        def remote_should_detach(channel: RemoteChannel) -> bool:
            return channel.disconnect_policy == RemoteDisconnectPolicy.Detach

        def remote_should_pause(channel: RemoteChannel) -> bool:
            return channel.disconnect_policy == RemoteDisconnectPolicy.Pause

        def remote_should_continue(channel: RemoteChannel) -> bool:
            return channel.disconnect_policy == RemoteDisconnectPolicy.Continue
