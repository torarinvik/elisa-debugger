# Bounded JSON request classifier.  It intentionally recognizes the stable
# `method` member without treating untrusted input as executable code.  Full
# value decoding is layered behind the same request type.

include "./vocabulary.elisa"

module DebuggerProtocolRequest:
    private:

        const module Character:
            REQUEST_CHARACTER_ASCII_QUOTE: u8 = 34
            REQUEST_CHARACTER_ASCII_COLON: u8 = 58
            REQUEST_CHARACTER_ASCII_BRACE_OPEN: u8 = 123
            REQUEST_CHARACTER_ASCII_BRACE_CLOSE: u8 = 125
            REQUEST_CHARACTER_ASCII_BRACKET_OPEN: u8 = 91
            REQUEST_CHARACTER_ASCII_BRACKET_CLOSE: u8 = 93
            REQUEST_CHARACTER_ASCII_BACKSLASH: u8 = 92
            REQUEST_CHARACTER_ASCII_ZERO: u8 = 48
            REQUEST_CHARACTER_ASCII_ONE: u8 = 49
            REQUEST_CHARACTER_ASCII_NINE: u8 = 57
            REQUEST_CHARACTER_ASCII_COMMA: u8 = 44
            REQUEST_CHARACTER_ASCII_SPACE: u8 = 32
            REQUEST_CHARACTER_ASCII_TAB: u8 = 9
            REQUEST_CHARACTER_ASCII_LINE_FEED: u8 = 10
            REQUEST_CHARACTER_ASCII_CARRIAGE_RETURN: u8 = 13
            REQUEST_CHARACTER_ASCII_M: u8 = 109
            REQUEST_CHARACTER_ASCII_E: u8 = 101
            REQUEST_CHARACTER_ASCII_T: u8 = 116
            REQUEST_CHARACTER_ASCII_H: u8 = 104
            REQUEST_CHARACTER_ASCII_O: u8 = 111
            REQUEST_CHARACTER_ASCII_D: u8 = 100
            REQUEST_CHARACTER_ASCII_I: u8 = 105
            REQUEST_CHARACTER_ASCII_A: u8 = 97
            REQUEST_CHARACTER_ASCII_L: u8 = 108
            REQUEST_CHARACTER_ASCII_S: u8 = 115
            REQUEST_CHARACTER_ASCII_MINUS: u8 = 45
            ASCII_PLUS: u8 = 43
            ASCII_DOT: u8 = 46
            ASCII_UPPER_E: u8 = 69
            REQUEST_CHARACTER_ASCII_SLASH: u8 = 47
            REQUEST_CHARACTER_ASCII_B: u8 = 98
            REQUEST_CHARACTER_ASCII_F: u8 = 102
            REQUEST_CHARACTER_ASCII_N: u8 = 110
            REQUEST_CHARACTER_ASCII_R: u8 = 114
            REQUEST_CHARACTER_ASCII_U: u8 = 117
            REQUEST_CHARACTER_ASCII_UPPER_A: u8 = 65
            REQUEST_CHARACTER_ASCII_UPPER_F: u8 = 70
            REQUEST_CHARACTER_ASCII_DELETE: u64 = 127

        const module JsonParser:
            NESTING_CAPACITY: usize = 64
            STATE_VALUE: u8 = 0
            STATE_KEY_OR_END: u8 = 1
            STATE_COLON: u8 = 2
            STATE_COMMA_OR_END: u8 = 3
            STATE_ROOT_DONE: u8 = 4
            STATE_VALUE_OR_END: u8 = 5
            STATE_KEY_REQUIRED: u8 = 6
            REQUEST_JSONPARSER_NO_INDEX: usize = 18446744073709551615

        const module JsonLiteral:
            TRUE_BYTES: cstr = "true"
            TRUE_LENGTH: usize = 4
            FALSE_BYTES: cstr = "false"
            FALSE_LENGTH: usize = 5
            NULL_BYTES: cstr = "null"
            NULL_LENGTH: usize = 4

        const module MethodHash:
            REQUEST_METHODHASH_MULTIPLIER: u64 = 31
            DISCOVER: u64 = 2847836501993
            INITIALIZE: u64 = 2872973214862224
            CREATE_SESSION: u64 = 7173654557551470074
            REQUEST_METHODHASH_LAUNCH: u64 = 3185124275
            REQUEST_METHODHASH_ATTACH: u64 = 2887708229
            OPEN_TRACE: u64 = 97845186083099
            REQUEST_METHODHASH_PAUSE: u64 = 106440182
            REQUEST_METHODHASH_CONTINUE: u64 = 2825521278119
            REQUEST_METHODHASH_STEP: u64 = 3540684
            REQUEST_METHODHASH_REVERSE_STEP: u64 = 96211551034117326
            REQUEST_METHODHASH_SEEK: u64 = 3526264
            THREADS: u64 = 106036245417
            REQUEST_METHODHASH_STACK: u64 = 109757064
            SCOPES: u64 = 3387198623
            VARIABLES: u64 = 103414140075383
            REQUEST_METHODHASH_EVALUATE: u64 = 2886379809945
            SET_BREAKPOINTS: u64 = 12884271682976838880
            REQUEST_METHODHASH_CHECKPOINT: u64 = 2709093068854664
            REQUEST_METHODHASH_BRANCH: u64 = 2913936802
            REQUEST_METHODHASH_COMPARE: u64 = 91144797413
            DETACH: u64 = 2959742867
            TERMINATE: u64 = 101818530709089
            REQUEST_METHODHASH_CLOSE: u64 = 94756344
            REQUEST_METHODHASH_REPLAY: u64 = 3360442343
            SET_DATA_BREAKPOINTS: u64 = 11437948931016314838
            REQUEST_METHODHASH_TRACE_VERIFY: u64 = 3043472847335273794
            TRACE_EXPORT: u64 = 3043472846866071677
            CANCEL: u64 = 2927242874
            MEMORY: u64 = 3217210625
            REQUEST_METHODHASH_REVERSE_STEP_OVER: u64 = 13868363593868912322
            REQUEST_METHODHASH_REVERSE_STEP_OUT: u64 = 6992985432408838048
            REQUEST_METHODHASH_TIMELINE: u64 = 3287868298305

        const module Sentinel:
            REQUEST_SENTINEL_NO_ID: u64 = 0

        const module NumberFormat:
            FIRST_NUMBER_DIGIT_COUNT: usize = 1
            REQUEST_NUMBERFORMAT_DECIMAL_BASE: u64 = 10
            REQUEST_NUMBERFORMAT_HEX_BASE: u64 = 16
            HEX_LETTER_OFFSET: u64 = 10
            REQUEST_NUMBERFORMAT_ASCII_MAX: u64 = 127
            FIRST_HEX_DIGIT_OFFSET: usize = 1
            REQUEST_NUMBERFORMAT_MAX_U64: u64 = 18446744073709551615

        const module RequestKeys:
            NONE: u8 = 0
            METHOD: u8 = 1
            ID: u8 = 2
            EXPECTED: u8 = 3
            TARGET: u8 = 4
            METHOD_LENGTH: usize = 6
            ID_LENGTH: usize = 2
            EXPECTED_LENGTH: usize = 22
            TARGET_LENGTH: usize = 11
            METHOD_HASH: u64 = 3217412321
            ID_HASH: u64 = 3355
            EXPECTED_HASH: u64 = 6143712305181352850
            TARGET_HASH: u64 = 97741681043071881

        const module RequestLimits:
            METHOD_PREFIX_LENGTH: usize = 10
            ID_PREFIX_LENGTH: usize = 5
            EXPECTED_PREFIX_LENGTH: usize = 25
            TARGET_PREFIX_LENGTH: usize = 14
            MAX_METHOD_LENGTH: usize = 64
            MAX_ID_DIGITS: usize = 20
            MAX_GENERATION_DIGITS: usize = 20
            REQUEST_REQUESTLIMITS_PROGRAM_PATH_CAPACITY: usize = 1024
            PAGE_SIZE_MAX: u64 = 256
            PAGE_START_MAX: u64 = NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64
            VERSION_MAX: u64 = 4294967295
            REQUEST_LIMITS_SOURCE_BREAKPOINT_COUNT_MAX: usize = 32
            REQUEST_LIMITS_SOURCE_BREAKPOINT_LINE_MAX: u64 = 4294967295
            REQUEST_LIMITS_NO_SOURCE_LINE: u64 = 0
            REQUEST_LIMITS_SINGLE_SOURCE_BREAKPOINT_MEMBER_COUNT: usize = 1

        const module Unicode:
            ESCAPE_DIGITS: usize = 4
            ESCAPE_MARKER_BYTES: usize = 1
            REQUEST_UNICODE_MAX_CODEPOINT: u64 = 1114111
            REQUEST_UNICODE_CONTROL_MAX: u64 = 31
            REQUEST_UNICODE_TWO_BYTE_MAX_EXCLUSIVE: u64 = 2048
            REQUEST_UNICODE_THREE_BYTE_MAX_EXCLUSIVE: u64 = 65536
            REQUEST_UNICODE_SURROGATE_HIGH_START: u64 = 55296
            REQUEST_UNICODE_SURROGATE_HIGH_END: u64 = 56319
            REQUEST_UNICODE_SURROGATE_LOW_START: u64 = 56320
            REQUEST_UNICODE_SURROGATE_LOW_END: u64 = 57343
            REQUEST_UNICODE_SURROGATE_BASE: u64 = 65536
            REQUEST_UNICODE_HIGH_SURROGATE_OFFSET: u64 = 55296
            REQUEST_UNICODE_LOW_SURROGATE_OFFSET: u64 = 56320
            REQUEST_UNICODE_SURROGATE_SHIFT: u64 = 10

        const module Utf8:
            REQUEST_UTF8_CONTINUATION_BASE: u64 = 128
            REQUEST_UTF8_CONTINUATION_MASK: u64 = 63
            REQUEST_UTF8_SHIFT: u64 = 6
            REQUEST_UTF8_TWO_BYTE_BASE: u64 = 192
            REQUEST_UTF8_THREE_BYTE_BASE: u64 = 224
            REQUEST_UTF8_FOUR_BYTE_BASE: u64 = 240
            REQUEST_UTF8_TWO_BYTE_START: u64 = 194
            REQUEST_UTF8_TWO_BYTE_END: u64 = 223
            REQUEST_UTF8_THREE_BYTE_START: u64 = 224
            REQUEST_UTF8_THREE_BYTE_END: u64 = 239
            REQUEST_UTF8_FOUR_BYTE_START: u64 = 240
            REQUEST_UTF8_FOUR_BYTE_END: u64 = 244
            REQUEST_UTF8_CONTINUATION_MIN: u64 = 128
            REQUEST_UTF8_CONTINUATION_MAX: u64 = 191
            REQUEST_UTF8_TWO_BYTE_MIN_CODEPOINT: u64 = 128
            REQUEST_UTF8_THREE_BYTE_MIN_CODEPOINT: u64 = 2048
            REQUEST_UTF8_FOUR_BYTE_MIN_CODEPOINT: u64 = 65536
            REQUEST_UTF8_FIRST_TWO_MASK: u64 = 31
            REQUEST_UTF8_FIRST_THREE_MASK: u64 = 15
            REQUEST_UTF8_FIRST_FOUR_MASK: u64 = 7
            REQUEST_UTF8_TWO_BYTE_LENGTH: usize = 2
            REQUEST_UTF8_THREE_BYTE_LENGTH: usize = 3
            REQUEST_UTF8_FOUR_BYTE_LENGTH: usize = 4

        struct ParsedOperandNumber:
            valid: mutable bool
            value: mutable u64
            end: mutable usize



    public:
        enum RequestMethod:
            Unknown
            Discover
            Initialize
            CreateSession
            Launch
            Attach
            OpenTrace
            Replay
            Pause
            Continue
            Step
            ReverseStep
            Seek
            Threads
            Stack
            Scopes
            Variables
            Evaluate
            SetBreakpoints
            SetDataBreakpoints
            Checkpoint
            Branch
            Compare
            TraceVerify
            TraceExport
            Detach
            Terminate
            Close
            Cancel
            Memory
            ReverseStepOver
            ReverseStepOut
            Timeline

        struct Request:
            method: mutable RequestMethod
            id: mutable u64
            has_id: mutable bool
            expected_generation: mutable u64
            target_event: mutable u64
            valid: mutable bool

        struct ProgramPath:
            bytes: mutable u8[RequestLimits::REQUEST_REQUESTLIMITS_PROGRAM_PATH_CAPACITY]
            length: mutable usize
            valid: mutable bool

        struct SourceBreakpointRequest:
            source_path: mutable ProgramPath
            has_source_path: mutable bool
            lines: mutable u32[RequestLimits::REQUEST_LIMITS_SOURCE_BREAKPOINT_COUNT_MAX]
            count: mutable usize
            has_breakpoints: mutable bool
            valid: mutable bool

        struct RequestOperands:
            valid: mutable bool
            has_expected_generation: mutable bool
            session_id: mutable u64
            has_session_id: mutable bool
            owner_token: mutable u64
            has_owner_token: mutable bool
            program: mutable ProgramPath
            has_program: mutable bool
            protocol_major: mutable u64
            has_protocol_major: mutable bool
            protocol_minor: mutable u64
            has_protocol_minor: mutable bool
            variables_reference: mutable u64
            has_variables_reference: mutable bool
            page_size: mutable u64
            has_page_size: mutable bool
            page_start: mutable u64
            has_page_start: mutable bool
            source_breakpoints: mutable SourceBreakpointRequest

        def invalid_request() -> Request:
            return zeroed

        def request_hash_byte(hash: u64, byte: u8) -> u64:
            return hash * MethodHash::REQUEST_METHODHASH_MULTIPLIER + byte.u64()

        def request_method_from_hash(hash: u64) -> RequestMethod:
            return RequestMethod.Discover if hash == MethodHash::DISCOVER
            return RequestMethod.Initialize if hash == MethodHash::INITIALIZE
            return RequestMethod.CreateSession if hash == MethodHash::CREATE_SESSION
            return RequestMethod.Launch if hash == MethodHash::REQUEST_METHODHASH_LAUNCH
            return RequestMethod.Attach if hash == MethodHash::REQUEST_METHODHASH_ATTACH
            return RequestMethod.OpenTrace if hash == MethodHash::OPEN_TRACE
            return RequestMethod.Replay if hash == MethodHash::REQUEST_METHODHASH_REPLAY
            return RequestMethod.Pause if hash == MethodHash::REQUEST_METHODHASH_PAUSE
            return RequestMethod.Continue if hash == MethodHash::REQUEST_METHODHASH_CONTINUE
            return RequestMethod.Step if hash == MethodHash::REQUEST_METHODHASH_STEP
            return RequestMethod.ReverseStep if hash == MethodHash::REQUEST_METHODHASH_REVERSE_STEP
            return RequestMethod.Seek if hash == MethodHash::REQUEST_METHODHASH_SEEK
            return RequestMethod.Threads if hash == MethodHash::THREADS
            return RequestMethod.Stack if hash == MethodHash::REQUEST_METHODHASH_STACK
            return RequestMethod.Scopes if hash == MethodHash::SCOPES
            return RequestMethod.Variables if hash == MethodHash::VARIABLES
            return RequestMethod.Evaluate if hash == MethodHash::REQUEST_METHODHASH_EVALUATE
            return RequestMethod.SetBreakpoints if hash == MethodHash::SET_BREAKPOINTS
            return RequestMethod.SetDataBreakpoints if hash == MethodHash::SET_DATA_BREAKPOINTS
            return RequestMethod.Checkpoint if hash == MethodHash::REQUEST_METHODHASH_CHECKPOINT
            return RequestMethod.Branch if hash == MethodHash::REQUEST_METHODHASH_BRANCH
            return RequestMethod.Compare if hash == MethodHash::REQUEST_METHODHASH_COMPARE
            return RequestMethod.TraceVerify if hash == MethodHash::REQUEST_METHODHASH_TRACE_VERIFY
            return RequestMethod.TraceExport if hash == MethodHash::TRACE_EXPORT
            return RequestMethod.Detach if hash == MethodHash::DETACH
            return RequestMethod.Terminate if hash == MethodHash::TERMINATE
            return RequestMethod.Close if hash == MethodHash::REQUEST_METHODHASH_CLOSE
            return RequestMethod.Cancel if hash == MethodHash::CANCEL
            return RequestMethod.Memory if hash == MethodHash::MEMORY
            return RequestMethod.ReverseStepOver if hash == MethodHash::REQUEST_METHODHASH_REVERSE_STEP_OVER
            return RequestMethod.ReverseStepOut if hash == MethodHash::REQUEST_METHODHASH_REVERSE_STEP_OUT
            return RequestMethod.Timeline if hash == MethodHash::REQUEST_METHODHASH_TIMELINE
            return RequestMethod.Unknown

        def reverse_request_method_name(method: RequestMethod) -> cstr:
            return DebuggerProtocolVocabulary::method_name(DebuggerProtocol::Method.ReverseStepOver) if method == RequestMethod.ReverseStepOver
            return DebuggerProtocolVocabulary::method_name(DebuggerProtocol::Method.ReverseStepOut) if method == RequestMethod.ReverseStepOut
            return ""

        def request_method_name(method: RequestMethod) -> cstr:
            return "discover" if method == RequestMethod.Discover
            return "initialize" if method == RequestMethod.Initialize
            return "createSession" if method == RequestMethod.CreateSession
            return "launch" if method == RequestMethod.Launch
            return "attach" if method == RequestMethod.Attach
            return "openTrace" if method == RequestMethod.OpenTrace
            return "replay" if method == RequestMethod.Replay
            return "pause" if method == RequestMethod.Pause
            return "continue" if method == RequestMethod.Continue
            return "step" if method == RequestMethod.Step
            return "reverseStep" if method == RequestMethod.ReverseStep
            return "seek" if method == RequestMethod.Seek
            return "threads" if method == RequestMethod.Threads
            return "stack" if method == RequestMethod.Stack
            return "scopes" if method == RequestMethod.Scopes
            return "variables" if method == RequestMethod.Variables
            return "evaluate" if method == RequestMethod.Evaluate
            return "setBreakpoints" if method == RequestMethod.SetBreakpoints
            return "setDataBreakpoints" if method == RequestMethod.SetDataBreakpoints
            return "checkpoint" if method == RequestMethod.Checkpoint
            return "branch" if method == RequestMethod.Branch
            return "compare" if method == RequestMethod.Compare
            return "trace.verify" if method == RequestMethod.TraceVerify
            return "trace.export" if method == RequestMethod.TraceExport
            return "detach" if method == RequestMethod.Detach
            return "terminate" if method == RequestMethod.Terminate
            return "close" if method == RequestMethod.Close
            return "cancel" if method == RequestMethod.Cancel
            return "memory" if method == RequestMethod.Memory
            return reverse_request_method_name(method) if method == RequestMethod.ReverseStepOver or method == RequestMethod.ReverseStepOut
            return DebuggerProtocolVocabulary::method_name(DebuggerProtocol::Method.Timeline) if method == RequestMethod.Timeline
            return ""

        def request_cstr_length(value: cstr) -> usize:
            length: mutable usize = 0
            while value[length] != 0:
                length <- length + 1
            return length

        # Hashes are only a quick candidate lookup.  Compare the decoded JSON
        # string with the canonical token before trusting the enum so a rolling
        # hash collision cannot turn an unknown method into a real operation.
        def request_method_json_string_matches(payload: u8&, start: usize, end: usize, expected: cstr) -> bool:
            cursor: mutable usize = start
            expected_index: mutable usize = 0
            expected_length: usize = request_cstr_length(expected)
            while cursor < end:
                character: mutable u64 = 0
                if payload[cursor] == Character::REQUEST_CHARACTER_ASCII_BACKSLASH:
                    cursor <- cursor + 1
                    return false if cursor >= end
                    escape: u8 = payload[cursor]
                    if escape == Character::REQUEST_CHARACTER_ASCII_U:
                        return false if end - cursor <= Unicode::ESCAPE_DIGITS
                        for offset in NumberFormat::FIRST_HEX_DIGIT_OFFSET..<(Unicode::ESCAPE_DIGITS + Unicode::ESCAPE_MARKER_BYTES):
                            digit: u8 = payload[cursor + offset]
                            hex_value: mutable u64 = 0
                            if digit >= Character::REQUEST_CHARACTER_ASCII_ZERO and digit <= Character::REQUEST_CHARACTER_ASCII_NINE:
                                hex_value <- (digit - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                            else:
                                if digit >= Character::REQUEST_CHARACTER_ASCII_A and digit <= Character::REQUEST_CHARACTER_ASCII_F:
                                    hex_value <- (digit - Character::REQUEST_CHARACTER_ASCII_A).u64() + NumberFormat::HEX_LETTER_OFFSET
                                else:
                                    if digit >= Character::REQUEST_CHARACTER_ASCII_UPPER_A and digit <= Character::REQUEST_CHARACTER_ASCII_UPPER_F:
                                        hex_value <- (digit - Character::REQUEST_CHARACTER_ASCII_UPPER_A).u64() + NumberFormat::HEX_LETTER_OFFSET
                                    else:
                                        return false
                            character <- character * NumberFormat::REQUEST_NUMBERFORMAT_HEX_BASE + hex_value
                        cursor <- cursor + Unicode::ESCAPE_DIGITS + Unicode::ESCAPE_MARKER_BYTES
                    else:
                        # None of the canonical method names contains a JSON
                        # escapable punctuation or control character.
                        return false
                else:
                    character <- payload[cursor].u64()
                    cursor <- cursor + 1
                return false if character > NumberFormat::REQUEST_NUMBERFORMAT_ASCII_MAX
                return false if expected_index >= expected_length
                return false if expected[expected_index].u8().u64() != character
                expected_index <- expected_index + 1
            return expected_index == expected_length

        def request_method_from_json_value(payload: u8&, start: usize, end: usize, hash_candidate: RequestMethod) -> RequestMethod:
            return hash_candidate if hash_candidate != RequestMethod.Unknown and request_method_json_string_matches(payload, start, end, request_method_name(hash_candidate))
            return RequestMethod.Discover if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Discover))
            return RequestMethod.Initialize if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Initialize))
            return RequestMethod.CreateSession if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.CreateSession))
            return RequestMethod.Launch if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Launch))
            return RequestMethod.Attach if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Attach))
            return RequestMethod.OpenTrace if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.OpenTrace))
            return RequestMethod.Replay if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Replay))
            return RequestMethod.Pause if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Pause))
            return RequestMethod.Continue if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Continue))
            return RequestMethod.Step if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Step))
            return RequestMethod.ReverseStep if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.ReverseStep))
            return RequestMethod.Seek if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Seek))
            return RequestMethod.Threads if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Threads))
            return RequestMethod.Stack if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Stack))
            return RequestMethod.Scopes if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Scopes))
            return RequestMethod.Variables if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Variables))
            return RequestMethod.Evaluate if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Evaluate))
            return RequestMethod.SetBreakpoints if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.SetBreakpoints))
            return RequestMethod.SetDataBreakpoints if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.SetDataBreakpoints))
            return RequestMethod.Checkpoint if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Checkpoint))
            return RequestMethod.Branch if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Branch))
            return RequestMethod.Compare if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Compare))
            return RequestMethod.TraceVerify if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.TraceVerify))
            return RequestMethod.TraceExport if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.TraceExport))
            return RequestMethod.Detach if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Detach))
            return RequestMethod.Terminate if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Terminate))
            return RequestMethod.Close if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Close))
            return RequestMethod.Cancel if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Cancel))
            return RequestMethod.Memory if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Memory))
            return RequestMethod.ReverseStepOver if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.ReverseStepOver))
            return RequestMethod.ReverseStepOut if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.ReverseStepOut))
            return RequestMethod.Timeline if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Timeline))
            return RequestMethod.Unknown

        def is_numeric_terminator(byte: u8) -> bool:
            return true if byte == Character::REQUEST_CHARACTER_ASCII_COMMA or byte == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE
            return true if byte == Character::REQUEST_CHARACTER_ASCII_SPACE or byte == Character::REQUEST_CHARACTER_ASCII_TAB
            return true if byte == Character::REQUEST_CHARACTER_ASCII_LINE_FEED or byte == Character::REQUEST_CHARACTER_ASCII_CARRIAGE_RETURN
            return false

        def is_json_whitespace(byte: u8) -> bool:
            return byte == Character::REQUEST_CHARACTER_ASCII_SPACE or byte == Character::REQUEST_CHARACTER_ASCII_TAB or byte == Character::REQUEST_CHARACTER_ASCII_LINE_FEED or byte == Character::REQUEST_CHARACTER_ASCII_CARRIAGE_RETURN

        def is_json_hex_digit(byte: u8) -> bool:
            return true if byte >= Character::REQUEST_CHARACTER_ASCII_ZERO and byte <= Character::REQUEST_CHARACTER_ASCII_NINE
            return true if byte >= Character::REQUEST_CHARACTER_ASCII_A and byte <= Character::REQUEST_CHARACTER_ASCII_F
            return byte >= Character::REQUEST_CHARACTER_ASCII_UPPER_A and byte <= Character::REQUEST_CHARACTER_ASCII_UPPER_F

        # The lightweight field scanner runs alongside the structural parser.
        # A quoted field name embedded in a string value must not be mistaken
        # for another top-level member (for example, an escaped `"method":`).
        # Count the immediately preceding backslashes so escaped quotes are
        # ignored while a quote preceded by an even number remains structural.
        def json_byte_is_escaped(payload: u8&, index: usize) -> bool:
            return false if payload[index] != Character::REQUEST_CHARACTER_ASCII_QUOTE
            slash_count: mutable usize = 0
            cursor: mutable usize = index
            while cursor > 0:
                cursor <- cursor - 1
                return false if payload[cursor] != Character::REQUEST_CHARACTER_ASCII_BACKSLASH and slash_count % 2 == 0
                return true if payload[cursor] != Character::REQUEST_CHARACTER_ASCII_BACKSLASH and slash_count % 2 == 1
                slash_count <- slash_count + 1
            return slash_count % 2 == 1

        def request_raw_json_key_matches(payload: u8&, start: usize, end: usize, expected: cstr) -> bool:
            expected_length: usize = request_cstr_length(expected)
            return false if end - start != expected_length
            for offset in 0..<expected_length:
                return false if payload[start + offset] != expected[offset].u8()
            return true

        def request_key_kind(payload: u8&, start: usize, end: usize, hash: u64, length: usize) -> u8:
            return RequestKeys::METHOD if length == RequestKeys::METHOD_LENGTH and hash == RequestKeys::METHOD_HASH and request_raw_json_key_matches(payload, start, end, "method")
            return RequestKeys::ID if length == RequestKeys::ID_LENGTH and hash == RequestKeys::ID_HASH and request_raw_json_key_matches(payload, start, end, "id")
            return RequestKeys::EXPECTED if length == RequestKeys::EXPECTED_LENGTH and hash == RequestKeys::EXPECTED_HASH and request_raw_json_key_matches(payload, start, end, "expectedStopGeneration")
            return RequestKeys::TARGET if length == RequestKeys::TARGET_LENGTH and hash == RequestKeys::TARGET_HASH and request_raw_json_key_matches(payload, start, end, "targetEvent")
            return RequestKeys::NONE

        def request_top_level_fields_are_valid(payload: u8&, length: usize) -> bool:
            object_depth: mutable usize = 0
            array_depth: mutable usize = 0
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_hash: mutable u64 = 0
            string_length: mutable usize = 0
            string_start: mutable usize = 0
            top_level_method_seen: mutable bool = false
            index: mutable usize = 0
            while index < length:
                byte: u8 = payload[index]
                if in_string:
                    if escaped:
                        escaped <- false
                        string_hash <- request_hash_byte(string_hash, byte)
                        string_length <- string_length + 1
                    else:
                        if byte == Character::REQUEST_CHARACTER_ASCII_BACKSLASH:
                            escaped <- true
                            string_hash <- request_hash_byte(string_hash, byte)
                            string_length <- string_length + 1
                        else:
                            if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE:
                                in_string <- false
                                lookahead: mutable usize = index + 1
                                while lookahead < length and is_json_whitespace(payload[lookahead]):
                                    lookahead <- lookahead + 1
                                if lookahead < length and payload[lookahead] == Character::REQUEST_CHARACTER_ASCII_COLON:
                                    key_kind: u8 = request_key_kind(payload, string_start, index, string_hash, string_length)
                                    if key_kind != RequestKeys::NONE:
                                        return false if object_depth != 1 or array_depth != 0
                                        top_level_method_seen <- true if key_kind == RequestKeys::METHOD
                            else:
                                string_hash <- request_hash_byte(string_hash, byte)
                                string_length <- string_length + 1
                else:
                    if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE:
                        in_string <- true
                        escaped <- false
                        string_hash <- 0
                        string_length <- 0
                        string_start <- index + 1
                    else:
                        if byte == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN:
                            object_depth <- object_depth + 1
                        else:
                            if byte == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE:
                                return false if object_depth == 0
                                object_depth <- object_depth - 1
                            else:
                                if byte == Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN:
                                    array_depth <- array_depth + 1
                                else:
                                    if byte == Character::REQUEST_CHARACTER_ASCII_BRACKET_CLOSE:
                                        return false if array_depth == 0
                                        array_depth <- array_depth - 1
                index <- index + 1
            return not in_string and not escaped and object_depth == 0 and array_depth == 0 and top_level_method_seen

        def json_string_end(payload: u8&, length: usize, start: usize) -> usize:
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if start >= length or payload[start] != Character::REQUEST_CHARACTER_ASCII_QUOTE
            index: mutable usize = start + 1
            escaped: mutable bool = false
            unicode_digits: mutable usize = 0
            while index < length:
                byte: u8 = payload[index]
                if unicode_digits > 0:
                    return JsonParser::REQUEST_JSONPARSER_NO_INDEX if not is_json_hex_digit(byte)
                    unicode_digits <- unicode_digits - 1
                else:
                    if escaped:
                        return JsonParser::REQUEST_JSONPARSER_NO_INDEX if byte != Character::REQUEST_CHARACTER_ASCII_QUOTE and byte != Character::REQUEST_CHARACTER_ASCII_BACKSLASH and byte != Character::REQUEST_CHARACTER_ASCII_SLASH and byte != Character::REQUEST_CHARACTER_ASCII_B and byte != Character::REQUEST_CHARACTER_ASCII_F and byte != Character::REQUEST_CHARACTER_ASCII_N and byte != Character::REQUEST_CHARACTER_ASCII_R and byte != Character::REQUEST_CHARACTER_ASCII_T and byte != Character::REQUEST_CHARACTER_ASCII_U
                        escaped <- false
                        unicode_digits <- 4 if byte == Character::REQUEST_CHARACTER_ASCII_U
                    else:
                        if byte == Character::REQUEST_CHARACTER_ASCII_BACKSLASH:
                            escaped <- true
                        else:
                            return index + 1 if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE
                            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if byte < Character::REQUEST_CHARACTER_ASCII_SPACE
                index <- index + 1
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if escaped or unicode_digits > 0
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX

        def json_literal_matches(payload: u8&, start: usize, end: usize, expected: cstr, expected_length: usize) -> bool:
            return false if start > end or end - start != expected_length
            for offset in 0..<expected_length |payload, expected|:
                return false if payload[start + offset] != expected[offset].u8()
            return true

        def json_primitive_is_valid(payload: u8&, start: usize, end: usize) -> bool:
            return false if start >= end
            length: usize = end - start
            return true if length == JsonLiteral::TRUE_LENGTH and json_literal_matches(payload, start, end, JsonLiteral::TRUE_BYTES, JsonLiteral::TRUE_LENGTH)
            return true if length == JsonLiteral::FALSE_LENGTH and json_literal_matches(payload, start, end, JsonLiteral::FALSE_BYTES, JsonLiteral::FALSE_LENGTH)
            return true if length == JsonLiteral::NULL_LENGTH and json_literal_matches(payload, start, end, JsonLiteral::NULL_BYTES, JsonLiteral::NULL_LENGTH)
            index: mutable usize = start
            if payload[index] == Character::REQUEST_CHARACTER_ASCII_MINUS:
                index <- index + 1
            return false if index >= end
            if payload[index] == Character::REQUEST_CHARACTER_ASCII_ZERO:
                index <- index + 1
                return false if index < end and payload[index] >= Character::REQUEST_CHARACTER_ASCII_ZERO and payload[index] <= Character::REQUEST_CHARACTER_ASCII_NINE
            else:
                return false if payload[index] < Character::REQUEST_CHARACTER_ASCII_ONE or payload[index] > Character::REQUEST_CHARACTER_ASCII_NINE
                while index < end and payload[index] >= Character::REQUEST_CHARACTER_ASCII_ZERO and payload[index] <= Character::REQUEST_CHARACTER_ASCII_NINE:
                    index <- index + 1
            if index < end and payload[index] == Character::ASCII_DOT:
                index <- index + 1
                return false if index >= end or payload[index] < Character::REQUEST_CHARACTER_ASCII_ZERO or payload[index] > Character::REQUEST_CHARACTER_ASCII_NINE
                while index < end and payload[index] >= Character::REQUEST_CHARACTER_ASCII_ZERO and payload[index] <= Character::REQUEST_CHARACTER_ASCII_NINE:
                    index <- index + 1
            if index < end and (payload[index] == Character::REQUEST_CHARACTER_ASCII_E or payload[index] == Character::ASCII_UPPER_E):
                index <- index + 1
                if index < end and (payload[index] == Character::REQUEST_CHARACTER_ASCII_MINUS or payload[index] == Character::ASCII_PLUS):
                    index <- index + 1
                return false if index >= end or payload[index] < Character::REQUEST_CHARACTER_ASCII_ZERO or payload[index] > Character::REQUEST_CHARACTER_ASCII_NINE
                while index < end and payload[index] >= Character::REQUEST_CHARACTER_ASCII_ZERO and payload[index] <= Character::REQUEST_CHARACTER_ASCII_NINE:
                    index <- index + 1
            return index == end

        def json_primitive_end(payload: u8&, length: usize, start: usize) -> usize:
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if start >= length
            index: mutable usize = start
            while index < length:
                byte: u8 = payload[index]
                return index if is_json_whitespace(byte) or byte == Character::REQUEST_CHARACTER_ASCII_COMMA or byte == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE or byte == Character::REQUEST_CHARACTER_ASCII_BRACKET_CLOSE
                return JsonParser::REQUEST_JSONPARSER_NO_INDEX if byte == Character::REQUEST_CHARACTER_ASCII_COLON or byte == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN or byte == Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN or byte == Character::REQUEST_CHARACTER_ASCII_QUOTE
                index <- index + 1
            return index

        def json_value_end(payload: u8&, length: usize, start: usize) -> usize:
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if start >= length
            return json_string_end(payload, length, start) if payload[start] == Character::REQUEST_CHARACTER_ASCII_QUOTE
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if payload[start] == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN or payload[start] == Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN or payload[start] == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE or payload[start] == Character::REQUEST_CHARACTER_ASCII_BRACKET_CLOSE or payload[start] == Character::REQUEST_CHARACTER_ASCII_COMMA or payload[start] == Character::REQUEST_CHARACTER_ASCII_COLON
            end: usize = json_primitive_end(payload, length, start)
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if end == JsonParser::REQUEST_JSONPARSER_NO_INDEX or not json_primitive_is_valid(payload, start, end)
            return end

    private:
        # Decode only printable ASCII JSON key escapes. All supported request
        # operand names are ASCII; non-ASCII keys cannot match them.
        def request_json_key_matches(payload: u8&, start: usize, end: usize, expected: cstr) -> bool:
            cursor: mutable usize = start
            expected_index: mutable usize = 0
            expected_length: usize = request_cstr_length(expected)
            while cursor < end:
                character: mutable u64 = payload[cursor].u64()
                if payload[cursor] == Character::REQUEST_CHARACTER_ASCII_BACKSLASH:
                    cursor <- cursor + 1
                    return false if cursor >= end
                    escaped: u8 = payload[cursor]
                    if escaped == Character::REQUEST_CHARACTER_ASCII_U:
                        return false if end - cursor <= Unicode::ESCAPE_DIGITS
                        character <- 0
                        for offset in NumberFormat::FIRST_HEX_DIGIT_OFFSET..<(Unicode::ESCAPE_DIGITS + Unicode::ESCAPE_MARKER_BYTES):
                            digit: u8 = payload[cursor + offset]
                            hex_value: mutable u64 = 0
                            if digit >= Character::REQUEST_CHARACTER_ASCII_ZERO and digit <= Character::REQUEST_CHARACTER_ASCII_NINE:
                                hex_value <- (digit - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                            else:
                                if digit >= Character::REQUEST_CHARACTER_ASCII_A and digit <= Character::REQUEST_CHARACTER_ASCII_F:
                                    hex_value <- (digit - Character::REQUEST_CHARACTER_ASCII_A).u64() + NumberFormat::HEX_LETTER_OFFSET
                                else:
                                    if digit >= Character::REQUEST_CHARACTER_ASCII_UPPER_A and digit <= Character::REQUEST_CHARACTER_ASCII_UPPER_F:
                                        hex_value <- (digit - Character::REQUEST_CHARACTER_ASCII_UPPER_A).u64() + NumberFormat::HEX_LETTER_OFFSET
                                    else:
                                        return false
                            character <- character * NumberFormat::REQUEST_NUMBERFORMAT_HEX_BASE + hex_value
                        cursor <- cursor + Unicode::ESCAPE_DIGITS + Unicode::ESCAPE_MARKER_BYTES
                    else:
                        return false if escaped != Character::REQUEST_CHARACTER_ASCII_QUOTE and escaped != Character::REQUEST_CHARACTER_ASCII_BACKSLASH and escaped != Character::REQUEST_CHARACTER_ASCII_SLASH
                        character <- escaped.u64()
                        cursor <- cursor + 1
                else:
                    cursor <- cursor + 1
                return false if character > NumberFormat::REQUEST_NUMBERFORMAT_ASCII_MAX or expected_index >= expected_length
                return false if expected[expected_index].u8().u64() != character
                expected_index <- expected_index + 1
            return expected_index == expected_length

        def request_operand_json_value_end(payload: u8&, length: usize, start: usize) -> usize:
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if start >= length
            return json_string_end(payload, length, start) if payload[start] == Character::REQUEST_CHARACTER_ASCII_QUOTE
            if payload[start] == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN or payload[start] == Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN:
                depth: mutable usize = 0
                in_string: mutable bool = false
                escaped: mutable bool = false
                index: mutable usize = start
                while index < length:
                    byte: u8 = payload[index]
                    if in_string:
                        if escaped:
                            escaped <- false
                        else:
                            if byte == Character::REQUEST_CHARACTER_ASCII_BACKSLASH:
                                escaped <- true
                            else:
                                in_string <- false if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE
                    else:
                        if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE:
                            in_string <- true
                        else:
                            if byte == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN or byte == Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN:
                                depth <- depth + 1
                            else:
                                if byte == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE or byte == Character::REQUEST_CHARACTER_ASCII_BRACKET_CLOSE:
                                    return index + 1 if depth == 1
                                    depth <- depth - 1
                    index <- index + 1
                return JsonParser::REQUEST_JSONPARSER_NO_INDEX
            end: usize = json_primitive_end(payload, length, start)
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if end == JsonParser::REQUEST_JSONPARSER_NO_INDEX or not json_primitive_is_valid(payload, start, end)
            return end

        # Scan direct members of one object, skipping complete values so a
        # nested arguments/program decoy cannot satisfy a launch request.
        def request_object_field_value_start(payload: u8&, length: usize, object_start: usize, expected: cstr, occurrence: usize) -> usize:
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX if object_start >= length or payload[object_start] != Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN
            property_index: mutable usize = object_start + 1
            matched: mutable usize = 0
            while property_index < length:
                while property_index < length and (is_json_whitespace(payload[property_index]) or payload[property_index] == Character::REQUEST_CHARACTER_ASCII_COMMA):
                    property_index <- property_index + 1
                return JsonParser::REQUEST_JSONPARSER_NO_INDEX if property_index >= length or payload[property_index] == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE
                key_start: usize = property_index
                key_end: usize = json_string_end(payload, length, key_start)
                return JsonParser::REQUEST_JSONPARSER_NO_INDEX if key_end == JsonParser::REQUEST_JSONPARSER_NO_INDEX
                property_index <- key_end
                while property_index < length and is_json_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                return JsonParser::REQUEST_JSONPARSER_NO_INDEX if property_index >= length or payload[property_index] != Character::REQUEST_CHARACTER_ASCII_COLON
                property_index <- property_index + 1
                while property_index < length and is_json_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                value_start: usize = property_index
                value_end: usize = request_operand_json_value_end(payload, length, value_start)
                return JsonParser::REQUEST_JSONPARSER_NO_INDEX if value_end == JsonParser::REQUEST_JSONPARSER_NO_INDEX
                if request_json_key_matches(payload, key_start + 1, key_end - 1, expected):
                    if matched == occurrence:
                        return value_start
                    matched <- matched + 1
                property_index <- value_end
            return JsonParser::REQUEST_JSONPARSER_NO_INDEX

        def invalid_operand_number() -> ParsedOperandNumber:
            return ParsedOperandNumber{valid: false, value: 0, end: JsonParser::REQUEST_JSONPARSER_NO_INDEX}

        def request_parse_bounded_unsigned(payload: u8&, length: usize, start: usize, maximum: u64, allow_decimal_string: bool) -> ParsedOperandNumber:
            return invalid_operand_number() if start >= length
            quoted: bool = payload[start] == Character::REQUEST_CHARACTER_ASCII_QUOTE
            return invalid_operand_number() if quoted and not allow_decimal_string
            return invalid_operand_number() if not quoted and (payload[start] < Character::REQUEST_CHARACTER_ASCII_ZERO or payload[start] > Character::REQUEST_CHARACTER_ASCII_NINE)
            index: mutable usize = start + 1 if quoted else start
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] >= Character::REQUEST_CHARACTER_ASCII_ZERO and payload[index] <= Character::REQUEST_CHARACTER_ASCII_NINE:
                digit: u64 = (payload[index] - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                return invalid_operand_number() if digits > 0 and value == 0
                return invalid_operand_number() if value > (maximum - digit) / NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE
                value <- value * NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE + digit
                digits <- digits + 1
                index <- index + 1
            return invalid_operand_number() if digits == 0
            if quoted:
                return invalid_operand_number() if index >= length or payload[index] != Character::REQUEST_CHARACTER_ASCII_QUOTE
                index <- index + 1
            if index < length:
                byte: u8 = payload[index]
                return invalid_operand_number() if not is_json_whitespace(byte) and byte != Character::REQUEST_CHARACTER_ASCII_COMMA and byte != Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE
            return ParsedOperandNumber{valid: true, value: value, end: index}

        def invalid_program_path() -> ProgramPath:
            return ProgramPath{bytes: zeroed, length: 0, valid: false}

        def request_program_path_append(path: mutable ProgramPath&, byte: u8) -> bool:
            return false if path.length >= RequestLimits::REQUEST_REQUESTLIMITS_PROGRAM_PATH_CAPACITY
            path.bytes[path.length] <- byte
            path.length <- path.length + 1
            return true

        def request_program_path_append_codepoint(path: mutable ProgramPath&, value: u64) -> bool:
            return false if value == 0 or value <= Unicode::REQUEST_UNICODE_CONTROL_MAX or value == Character::REQUEST_CHARACTER_ASCII_DELETE
            return false if value > Unicode::REQUEST_UNICODE_MAX_CODEPOINT
            if value < Utf8::REQUEST_UTF8_CONTINUATION_BASE:
                return request_program_path_append(path, value.u8())
            if value < Unicode::REQUEST_UNICODE_TWO_BYTE_MAX_EXCLUSIVE:
                first: u8 = (Utf8::REQUEST_UTF8_TWO_BYTE_BASE | (value >> Utf8::REQUEST_UTF8_SHIFT)).u8()
                second: u8 = (Utf8::REQUEST_UTF8_CONTINUATION_BASE | (value & Utf8::REQUEST_UTF8_CONTINUATION_MASK)).u8()
                return false if not request_program_path_append(path, first)
                return request_program_path_append(path, second)
            if value < Unicode::REQUEST_UNICODE_THREE_BYTE_MAX_EXCLUSIVE:
                first: u8 = (Utf8::REQUEST_UTF8_THREE_BYTE_BASE | (value >> (Utf8::REQUEST_UTF8_SHIFT * 2))).u8()
                second: u8 = (Utf8::REQUEST_UTF8_CONTINUATION_BASE | ((value >> Utf8::REQUEST_UTF8_SHIFT) & Utf8::REQUEST_UTF8_CONTINUATION_MASK)).u8()
                third: u8 = (Utf8::REQUEST_UTF8_CONTINUATION_BASE | (value & Utf8::REQUEST_UTF8_CONTINUATION_MASK)).u8()
                return false if not request_program_path_append(path, first)
                return false if not request_program_path_append(path, second)
                return request_program_path_append(path, third)
            first: u8 = (Utf8::REQUEST_UTF8_FOUR_BYTE_BASE | (value >> (Utf8::REQUEST_UTF8_SHIFT * 3))).u8()
            second: u8 = (Utf8::REQUEST_UTF8_CONTINUATION_BASE | ((value >> (Utf8::REQUEST_UTF8_SHIFT * 2)) & Utf8::REQUEST_UTF8_CONTINUATION_MASK)).u8()
            third: u8 = (Utf8::REQUEST_UTF8_CONTINUATION_BASE | ((value >> Utf8::REQUEST_UTF8_SHIFT) & Utf8::REQUEST_UTF8_CONTINUATION_MASK)).u8()
            fourth: u8 = (Utf8::REQUEST_UTF8_CONTINUATION_BASE | (value & Utf8::REQUEST_UTF8_CONTINUATION_MASK)).u8()
            return false if not request_program_path_append(path, first)
            return false if not request_program_path_append(path, second)
            return false if not request_program_path_append(path, third)
            return request_program_path_append(path, fourth)

        def request_program_path_utf8_is_valid(path: ProgramPath) -> bool:
            index: mutable usize = 0
            while index < path.length:
                first: u64 = path.bytes[index].u64()
                sequence_length: mutable usize = 1
                minimum_codepoint: mutable u64 = 0
                codepoint: mutable u64 = first
                if first >= Utf8::REQUEST_UTF8_TWO_BYTE_START and first <= Utf8::REQUEST_UTF8_TWO_BYTE_END:
                    sequence_length <- Utf8::REQUEST_UTF8_TWO_BYTE_LENGTH
                    minimum_codepoint <- Utf8::REQUEST_UTF8_TWO_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::REQUEST_UTF8_FIRST_TWO_MASK
                if first >= Utf8::REQUEST_UTF8_THREE_BYTE_START and first <= Utf8::REQUEST_UTF8_THREE_BYTE_END:
                    sequence_length <- Utf8::REQUEST_UTF8_THREE_BYTE_LENGTH
                    minimum_codepoint <- Utf8::REQUEST_UTF8_THREE_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::REQUEST_UTF8_FIRST_THREE_MASK
                if first >= Utf8::REQUEST_UTF8_FOUR_BYTE_START and first <= Utf8::REQUEST_UTF8_FOUR_BYTE_END:
                    sequence_length <- Utf8::REQUEST_UTF8_FOUR_BYTE_LENGTH
                    minimum_codepoint <- Utf8::REQUEST_UTF8_FOUR_BYTE_MIN_CODEPOINT
                    codepoint <- first & Utf8::REQUEST_UTF8_FIRST_FOUR_MASK
                if first >= Utf8::REQUEST_UTF8_CONTINUATION_MIN and sequence_length == 1:
                    return false
                return false if sequence_length > path.length - index
                for offset in 1..<sequence_length:
                    continuation: u64 = path.bytes[index + offset].u64()
                    return false if continuation < Utf8::REQUEST_UTF8_CONTINUATION_MIN or continuation > Utf8::REQUEST_UTF8_CONTINUATION_MAX
                    codepoint <- (codepoint << Utf8::REQUEST_UTF8_SHIFT) | (continuation & Utf8::REQUEST_UTF8_CONTINUATION_MASK)
                return false if codepoint < minimum_codepoint or codepoint > Unicode::REQUEST_UNICODE_MAX_CODEPOINT
                return false if codepoint >= Unicode::REQUEST_UNICODE_SURROGATE_LOW_START and codepoint <= Unicode::REQUEST_UNICODE_SURROGATE_LOW_END
                index <- index + sequence_length
            return true

        def request_hex_digit(byte: u8) -> ParsedOperandNumber:
            return ParsedOperandNumber{valid: true, value: (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64(), end: 0} if byte >= Character::REQUEST_CHARACTER_ASCII_ZERO and byte <= Character::REQUEST_CHARACTER_ASCII_NINE
            return ParsedOperandNumber{valid: true, value: (byte - Character::REQUEST_CHARACTER_ASCII_A).u64() + NumberFormat::HEX_LETTER_OFFSET, end: 0} if byte >= Character::REQUEST_CHARACTER_ASCII_A and byte <= Character::REQUEST_CHARACTER_ASCII_F
            return ParsedOperandNumber{valid: true, value: (byte - Character::REQUEST_CHARACTER_ASCII_UPPER_A).u64() + NumberFormat::HEX_LETTER_OFFSET, end: 0} if byte >= Character::REQUEST_CHARACTER_ASCII_UPPER_A and byte <= Character::REQUEST_CHARACTER_ASCII_UPPER_F
            return invalid_operand_number()

        def request_parse_unicode_quad(payload: u8&, length: usize, start: usize) -> ParsedOperandNumber:
            return invalid_operand_number() if start > length or length - start < Unicode::ESCAPE_DIGITS
            value: mutable u64 = 0
            for offset in 0..<Unicode::ESCAPE_DIGITS:
                digit: ParsedOperandNumber = request_hex_digit(payload[start + offset])
                return invalid_operand_number() if not digit.valid
                value <- value * NumberFormat::REQUEST_NUMBERFORMAT_HEX_BASE + digit.value
            return ParsedOperandNumber{valid: true, value: value, end: start + Unicode::ESCAPE_DIGITS}

        def request_program_path_string_parse(payload: u8&, length: usize, start: usize) -> ProgramPath:
            path: mutable ProgramPath = zeroed
            path.valid <- true
            return invalid_program_path() if start >= length or payload[start] != Character::REQUEST_CHARACTER_ASCII_QUOTE
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = payload[index]
                if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE:
                    return invalid_program_path() if path.length == 0 or not request_program_path_utf8_is_valid(path)
                    return path
                if byte == Character::REQUEST_CHARACTER_ASCII_BACKSLASH:
                    return invalid_program_path() if index + 1 >= length
                    escaped: u8 = payload[index + 1]
                    if escaped == Character::REQUEST_CHARACTER_ASCII_QUOTE or escaped == Character::REQUEST_CHARACTER_ASCII_BACKSLASH or escaped == Character::REQUEST_CHARACTER_ASCII_SLASH:
                        path.valid <- request_program_path_append(path, escaped)
                        return invalid_program_path() if not path.valid
                        index <- index + 2
                        continue
                    if escaped == Character::REQUEST_CHARACTER_ASCII_U:
                        high: ParsedOperandNumber = request_parse_unicode_quad(payload, length, index + 2)
                        return invalid_program_path() if not high.valid
                        codepoint: mutable u64 = high.value
                        index <- high.end
                        if high.value >= Unicode::REQUEST_UNICODE_SURROGATE_HIGH_START and high.value <= Unicode::REQUEST_UNICODE_SURROGATE_HIGH_END:
                            return invalid_program_path() if index + 1 >= length or payload[index] != Character::REQUEST_CHARACTER_ASCII_BACKSLASH or payload[index + 1] != Character::REQUEST_CHARACTER_ASCII_U
                            low: ParsedOperandNumber = request_parse_unicode_quad(payload, length, index + 2)
                            return invalid_program_path() if not low.valid or low.value < Unicode::REQUEST_UNICODE_SURROGATE_LOW_START or low.value > Unicode::REQUEST_UNICODE_SURROGATE_LOW_END
                            codepoint <- Unicode::REQUEST_UNICODE_SURROGATE_BASE + ((high.value - Unicode::REQUEST_UNICODE_HIGH_SURROGATE_OFFSET) << Unicode::REQUEST_UNICODE_SURROGATE_SHIFT) + (low.value - Unicode::REQUEST_UNICODE_LOW_SURROGATE_OFFSET)
                            index <- low.end
                        else:
                            return invalid_program_path() if high.value >= Unicode::REQUEST_UNICODE_SURROGATE_LOW_START and high.value <= Unicode::REQUEST_UNICODE_SURROGATE_LOW_END
                        path.valid <- request_program_path_append_codepoint(path, codepoint)
                        return invalid_program_path() if not path.valid
                        continue
                    return invalid_program_path() if escaped == Character::REQUEST_CHARACTER_ASCII_B or escaped == Character::REQUEST_CHARACTER_ASCII_F or escaped == Character::REQUEST_CHARACTER_ASCII_N or escaped == Character::REQUEST_CHARACTER_ASCII_R or escaped == Character::REQUEST_CHARACTER_ASCII_T
                    return invalid_program_path()
                return invalid_program_path() if byte < Character::REQUEST_CHARACTER_ASCII_SPACE or byte.u64() == Character::REQUEST_CHARACTER_ASCII_DELETE
                path.valid <- request_program_path_append(path, byte)
                return invalid_program_path() if not path.valid
                index <- index + 1
            return invalid_program_path()

        def request_source_breakpoint_object_has_only_field(payload: u8&, length: usize, object_start: usize, expected: cstr) -> bool:
            return false if object_start >= length or payload[object_start] != Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN
            cursor: mutable usize = object_start + 1
            field_count: mutable usize = 0
            while cursor < length:
                while cursor < length and is_json_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                return field_count == RequestLimits::REQUEST_LIMITS_SINGLE_SOURCE_BREAKPOINT_MEMBER_COUNT if cursor < length and payload[cursor] == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE
                key_start: usize = cursor
                key_end: usize = json_string_end(payload, length, key_start)
                return false if key_end == JsonParser::REQUEST_JSONPARSER_NO_INDEX
                return false if not request_json_key_matches(payload, key_start + 1, key_end - 1, expected)
                cursor <- key_end
                while cursor < length and is_json_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                return false if cursor >= length or payload[cursor] != Character::REQUEST_CHARACTER_ASCII_COLON
                cursor <- cursor + 1
                while cursor < length and is_json_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                value_end: usize = request_operand_json_value_end(payload, length, cursor)
                return false if value_end == JsonParser::REQUEST_JSONPARSER_NO_INDEX
                cursor <- value_end
                field_count <- field_count + 1
                while cursor < length and is_json_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                return field_count == RequestLimits::REQUEST_LIMITS_SINGLE_SOURCE_BREAKPOINT_MEMBER_COUNT if cursor < length and payload[cursor] == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE
                return false if cursor >= length or payload[cursor] != Character::REQUEST_CHARACTER_ASCII_COMMA
                cursor <- cursor + 1
            return false

        def request_source_breakpoint_line_parse(payload: u8&, length: usize, object_start: usize) -> ParsedOperandNumber:
            return invalid_operand_number() if not request_source_breakpoint_object_has_only_field(payload, length, object_start, "line")
            line_start: usize = request_object_field_value_start(payload, length, object_start, "line", 0)
            return invalid_operand_number() if line_start == JsonParser::REQUEST_JSONPARSER_NO_INDEX
            return invalid_operand_number() if request_object_field_value_start(payload, length, object_start, "line", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            return request_parse_bounded_unsigned(payload, length, line_start, RequestLimits::REQUEST_LIMITS_SOURCE_BREAKPOINT_LINE_MAX, false)

        def request_source_breakpoint_array_parse(payload: u8&, length: usize, array_start: usize, request: mutable SourceBreakpointRequest&) -> bool:
            return false if array_start >= length or payload[array_start] != Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN
            request.has_breakpoints <- true
            cursor: mutable usize = array_start + 1
            while cursor < length and is_json_whitespace(payload[cursor]):
                cursor <- cursor + 1
            return true if cursor < length and payload[cursor] == Character::REQUEST_CHARACTER_ASCII_BRACKET_CLOSE
            while cursor < length:
                return false if request.count >= RequestLimits::REQUEST_LIMITS_SOURCE_BREAKPOINT_COUNT_MAX
                return false if payload[cursor] != Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN
                line: ParsedOperandNumber = request_source_breakpoint_line_parse(payload, length, cursor)
                return false if not line.valid or line.value == RequestLimits::REQUEST_LIMITS_NO_SOURCE_LINE
                request.lines[request.count] <- line.value.u32()
                request.count <- request.count + 1
                value_end: usize = request_operand_json_value_end(payload, length, cursor)
                return false if value_end == JsonParser::REQUEST_JSONPARSER_NO_INDEX
                cursor <- value_end
                while cursor < length and is_json_whitespace(payload[cursor]):
                    cursor <- cursor + 1
                if cursor < length and payload[cursor] == Character::REQUEST_CHARACTER_ASCII_COMMA:
                    cursor <- cursor + 1
                    while cursor < length and is_json_whitespace(payload[cursor]):
                        cursor <- cursor + 1
                    continue
                if cursor < length and payload[cursor] == Character::REQUEST_CHARACTER_ASCII_BRACKET_CLOSE:
                    return true
                return false
            return false

        def request_source_breakpoints_parse(payload: u8&, length: usize, arguments: usize) -> SourceBreakpointRequest:
            request: mutable SourceBreakpointRequest = zeroed
            request.source_path <- invalid_program_path()
            source: usize = request_object_field_value_start(payload, length, arguments, "source", 0)
            return request if source == JsonParser::REQUEST_JSONPARSER_NO_INDEX or request_object_field_value_start(payload, length, arguments, "source", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            return request if source >= length or payload[source] != Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN
            return request if not request_source_breakpoint_object_has_only_field(payload, length, source, "path")
            path_start: usize = request_object_field_value_start(payload, length, source, "path", 0)
            return request if path_start == JsonParser::REQUEST_JSONPARSER_NO_INDEX or request_object_field_value_start(payload, length, source, "path", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            source_path: ProgramPath = request_program_path_string_parse(payload, length, path_start)
            return request if not source_path.valid
            request.source_path <- source_path
            request.has_source_path <- true
            breakpoints_start: usize = request_object_field_value_start(payload, length, arguments, "breakpoints", 0)
            return request if breakpoints_start == JsonParser::REQUEST_JSONPARSER_NO_INDEX or request_object_field_value_start(payload, length, arguments, "breakpoints", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            return request if not request_source_breakpoint_array_parse(payload, length, breakpoints_start, request)
            request.valid <- true
            return request

        def request_arguments_operands_parse(payload: u8&, length: usize, arguments: usize, method: RequestMethod, operands: mutable RequestOperands&) -> bool:
            return false if arguments >= length or payload[arguments] != Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN
            program: usize = request_object_field_value_start(payload, length, arguments, "program", 0)
            return false if request_object_field_value_start(payload, length, arguments, "program", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            if program != JsonParser::REQUEST_JSONPARSER_NO_INDEX:
                parsed: ProgramPath = request_program_path_string_parse(payload, length, program)
                return false if not parsed.valid
                operands.program <- parsed
                operands.has_program <- true
            variables_reference_start: usize = request_object_field_value_start(payload, length, arguments, "variablesReference", 0)
            return false if request_object_field_value_start(payload, length, arguments, "variablesReference", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            if variables_reference_start != JsonParser::REQUEST_JSONPARSER_NO_INDEX:
                variables_reference: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, variables_reference_start, NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64, true)
                return false if not variables_reference.valid
                operands.variables_reference <- variables_reference.value
                operands.has_variables_reference <- true
            if method == RequestMethod.SetBreakpoints:
                source_breakpoints: SourceBreakpointRequest = request_source_breakpoints_parse(payload, length, arguments)
                return false if not source_breakpoints.valid
                operands.source_breakpoints <- source_breakpoints
            return false if method == RequestMethod.Variables and not operands.has_variables_reference
            return true

        def request_pagination_operands_parse(payload: u8&, length: usize, root_start: usize, operands: mutable RequestOperands&) -> bool:
            page_size_start: usize = request_object_field_value_start(payload, length, root_start, "pageSize", 0)
            return false if request_object_field_value_start(payload, length, root_start, "pageSize", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            if page_size_start != JsonParser::REQUEST_JSONPARSER_NO_INDEX:
                page_size: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, page_size_start, RequestLimits::PAGE_SIZE_MAX, false)
                return false if not page_size.valid
                operands.page_size <- page_size.value
                operands.has_page_size <- true
            page_start_start: usize = request_object_field_value_start(payload, length, root_start, "pageStart", 0)
            return false if request_object_field_value_start(payload, length, root_start, "pageStart", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            if page_start_start != JsonParser::REQUEST_JSONPARSER_NO_INDEX:
                page_start: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, page_start_start, RequestLimits::PAGE_START_MAX, true)
                return false if not page_start.valid
                operands.page_start <- page_start.value
                operands.has_page_start <- true
            return true

        # Session ownership fields live on the root request object.  They are
        # optional for the legacy compact flow, but once a client opts into
        # createSession the server can require both fields on every state
        # changing request.  Parse them here rather than treating them as
        # untyped extension data so duplicate, malformed, and overflowing
        # values fail before dispatch.
        def request_session_operands_parse(payload: u8&, length: usize, root_start: usize, operands: mutable RequestOperands&) -> bool:
            session_start: usize = request_object_field_value_start(payload, length, root_start, "sessionId", 0)
            return false if request_object_field_value_start(payload, length, root_start, "sessionId", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            if session_start != JsonParser::REQUEST_JSONPARSER_NO_INDEX:
                session: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, session_start, NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64, true)
                return false if not session.valid
                operands.session_id <- session.value
                operands.has_session_id <- true
            owner_start: usize = request_object_field_value_start(payload, length, root_start, "ownerToken", 0)
            return false if request_object_field_value_start(payload, length, root_start, "ownerToken", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            if owner_start != JsonParser::REQUEST_JSONPARSER_NO_INDEX:
                owner: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, owner_start, NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64, true)
                return false if not owner.valid
                operands.owner_token <- owner.value
                operands.has_owner_token <- true
            return true

        # The headless initialize request must negotiate the wire version
        # before clients issue session operations. Versions are JSON integers
        # bounded to the protocol's u32 representation.
        def request_initialization_version_parse(payload: u8&, length: usize, root_start: usize, method: RequestMethod, operands: mutable RequestOperands&) -> bool:
            return true if method != RequestMethod.Initialize
            major_start: usize = request_object_field_value_start(payload, length, root_start, "protocolMajor", 0)
            minor_start: usize = request_object_field_value_start(payload, length, root_start, "protocolMinor", 0)
            return false if major_start == JsonParser::REQUEST_JSONPARSER_NO_INDEX or minor_start == JsonParser::REQUEST_JSONPARSER_NO_INDEX
            return false if request_object_field_value_start(payload, length, root_start, "protocolMajor", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX or request_object_field_value_start(payload, length, root_start, "protocolMinor", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            major: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, major_start, RequestLimits::VERSION_MAX, false)
            minor: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, minor_start, RequestLimits::VERSION_MAX, false)
            return false if not major.valid or not minor.valid
            operands.protocol_major <- major.value
            operands.has_protocol_major <- true
            operands.protocol_minor <- minor.value
            operands.has_protocol_minor <- true
            return true

    public:
        def request_has_object_shape(payload: u8&, length: usize) -> bool:
            return false if length < 2
            first: mutable usize = 0
            while first < length and (payload[first] == Character::REQUEST_CHARACTER_ASCII_SPACE or payload[first] == Character::REQUEST_CHARACTER_ASCII_TAB or payload[first] == Character::REQUEST_CHARACTER_ASCII_LINE_FEED or payload[first] == Character::REQUEST_CHARACTER_ASCII_CARRIAGE_RETURN):
                first <- first + 1
            return false if first >= length or payload[first] != Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN
            last: mutable usize = length
            while last > first + 1 and (payload[last - 1] == Character::REQUEST_CHARACTER_ASCII_SPACE or payload[last - 1] == Character::REQUEST_CHARACTER_ASCII_TAB or payload[last - 1] == Character::REQUEST_CHARACTER_ASCII_LINE_FEED or payload[last - 1] == Character::REQUEST_CHARACTER_ASCII_CARRIAGE_RETURN):
                last <- last - 1
            return false if last <= first + 1 or payload[last - 1] != Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE
            nesting: mutable u8[JsonParser::NESTING_CAPACITY] = zeroed
            states: mutable u8[JsonParser::NESTING_CAPACITY] = zeroed
            nesting_count: mutable usize = 0
            root_state: mutable u8 = JsonParser::STATE_VALUE
            index: mutable usize = first
            while index < last:
                while index < last and is_json_whitespace(payload[index]):
                    index <- index + 1
                continue if index >= last
                if nesting_count == 0:
                    return false if root_state == JsonParser::STATE_ROOT_DONE
                    if payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN or payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN:
                        return false if nesting_count >= JsonParser::NESTING_CAPACITY
                        nesting[nesting_count] <- payload[index]
                        states[nesting_count] <- JsonParser::STATE_KEY_OR_END if payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN else JsonParser::STATE_VALUE_OR_END
                        nesting_count <- nesting_count + 1
                        index <- index + 1
                    else:
                        value_end: usize = json_value_end(payload, last, index)
                        return false if value_end == JsonParser::REQUEST_JSONPARSER_NO_INDEX
                        root_state <- JsonParser::STATE_ROOT_DONE
                        index <- value_end
                else:
                    state: u8 = states[nesting_count - 1]
                    container: u8 = nesting[nesting_count - 1]
                    if state == JsonParser::STATE_KEY_OR_END or state == JsonParser::STATE_KEY_REQUIRED:
                        return false if container != Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN
                        if payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE:
                            return false if state == JsonParser::STATE_KEY_REQUIRED
                            nesting_count <- nesting_count - 1
                            root_state <- JsonParser::STATE_ROOT_DONE if nesting_count == 0
                            states[nesting_count - 1] <- JsonParser::STATE_COMMA_OR_END if nesting_count > 0
                            index <- index + 1
                        else:
                            return false if payload[index] != Character::REQUEST_CHARACTER_ASCII_QUOTE
                            key_end: usize = json_string_end(payload, last, index)
                            return false if key_end == JsonParser::REQUEST_JSONPARSER_NO_INDEX
                            states[nesting_count - 1] <- JsonParser::STATE_COLON
                            index <- key_end
                    else:
                        if state == JsonParser::STATE_COLON:
                            return false if payload[index] != Character::REQUEST_CHARACTER_ASCII_COLON
                            states[nesting_count - 1] <- JsonParser::STATE_VALUE
                            index <- index + 1
                        else:
                            if state == JsonParser::STATE_VALUE_OR_END and payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACKET_CLOSE:
                                nesting_count <- nesting_count - 1
                                root_state <- JsonParser::STATE_ROOT_DONE if nesting_count == 0
                                states[nesting_count - 1] <- JsonParser::STATE_COMMA_OR_END if nesting_count > 0
                                index <- index + 1
                            else:
                                if state == JsonParser::STATE_COMMA_OR_END:
                                    if (container == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN and payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACE_CLOSE) or (container == Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN and payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACKET_CLOSE):
                                        nesting_count <- nesting_count - 1
                                        root_state <- JsonParser::STATE_ROOT_DONE if nesting_count == 0
                                        states[nesting_count - 1] <- JsonParser::STATE_COMMA_OR_END if nesting_count > 0
                                        index <- index + 1
                                    else:
                                        return false if payload[index] != Character::REQUEST_CHARACTER_ASCII_COMMA
                                        states[nesting_count - 1] <- JsonParser::STATE_KEY_REQUIRED if container == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN else JsonParser::STATE_VALUE
                                        index <- index + 1
                                else:
                                    if payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN or payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACKET_OPEN:
                                        return false if nesting_count >= JsonParser::NESTING_CAPACITY
                                        nesting[nesting_count] <- payload[index]
                                        states[nesting_count] <- JsonParser::STATE_KEY_OR_END if payload[index] == Character::REQUEST_CHARACTER_ASCII_BRACE_OPEN else JsonParser::STATE_VALUE_OR_END
                                        nesting_count <- nesting_count + 1
                                        index <- index + 1
                                    else:
                                        value_end: usize = json_value_end(payload, last, index)
                                        return false if value_end == JsonParser::REQUEST_JSONPARSER_NO_INDEX
                                        states[nesting_count - 1] <- JsonParser::STATE_COMMA_OR_END
                                        index <- value_end
            return root_state == JsonParser::STATE_ROOT_DONE and nesting_count == 0

        def request_parse(payload: u8&, length: usize) -> Request:
            request: mutable Request = zeroed
            request.method <- RequestMethod.Unknown
            request.valid <- false
            return invalid_request() if not request_has_object_shape(payload, length)
            return invalid_request() if not request_top_level_fields_are_valid(payload, length)
            prefix: mutable u8[RequestLimits::METHOD_PREFIX_LENGTH] = [Character::REQUEST_CHARACTER_ASCII_QUOTE, Character::REQUEST_CHARACTER_ASCII_M, Character::REQUEST_CHARACTER_ASCII_E, Character::REQUEST_CHARACTER_ASCII_T, Character::REQUEST_CHARACTER_ASCII_H, Character::REQUEST_CHARACTER_ASCII_O, Character::REQUEST_CHARACTER_ASCII_D, Character::REQUEST_CHARACTER_ASCII_QUOTE, Character::REQUEST_CHARACTER_ASCII_COLON, Character::REQUEST_CHARACTER_ASCII_QUOTE]
            prefix_position: mutable usize = 0
            in_method: mutable bool = false
            method_field_seen: mutable bool = false
            method_hash: mutable u64 = 0
            method_length: mutable usize = 0
            method_value_start: mutable usize = 0
            method_value_escaped: mutable bool = false
            id_prefix: mutable u8[RequestLimits::ID_PREFIX_LENGTH] = [Character::REQUEST_CHARACTER_ASCII_QUOTE, Character::REQUEST_CHARACTER_ASCII_I, Character::REQUEST_CHARACTER_ASCII_D, Character::REQUEST_CHARACTER_ASCII_QUOTE, Character::REQUEST_CHARACTER_ASCII_COLON]
            id_position: mutable usize = 0
            in_id: mutable bool = false
            id_field_seen: mutable bool = false
            id_digits: mutable usize = 0
            id_quoted: mutable bool = false
            expected_prefix: mutable u8[RequestLimits::EXPECTED_PREFIX_LENGTH] = [34, 101, 120, 112, 101, 99, 116, 101, 100, 83, 116, 111, 112, 71, 101, 110, 101, 114, 97, 116, 105, 111, 110, 34, 58]
            expected_position: mutable usize = 0
            in_expected: mutable bool = false
            expected_field_seen: mutable bool = false
            expected_has_digits: mutable bool = false
            expected_digits: mutable usize = 0
            expected_quoted: mutable bool = false
            target_prefix: mutable u8[RequestLimits::TARGET_PREFIX_LENGTH] = [34, 116, 97, 114, 103, 101, 116, 69, 118, 101, 110, 116, 34, 58]
            target_position: mutable usize = 0
            in_target: mutable bool = false
            target_field_seen: mutable bool = false
            target_has_digits: mutable bool = false
            target_digits: mutable usize = 0
            target_quoted: mutable bool = false
            for index in 0..<length:
                byte: u8 = payload[index]
                if not in_method:
                    if byte == prefix[prefix_position] and (prefix_position != 0 or not json_byte_is_escaped(payload, index)):
                        prefix_position <- prefix_position + 1
                        if prefix_position == RequestLimits::METHOD_PREFIX_LENGTH:
                            return invalid_request() if method_field_seen
                            in_method <- true
                            method_field_seen <- true
                            prefix_position <- 0
                            method_value_start <- index + 1
                            method_value_escaped <- false
                    else:
                        if not (is_json_whitespace(byte) and (prefix_position == RequestLimits::METHOD_PREFIX_LENGTH - 2 or prefix_position == RequestLimits::METHOD_PREFIX_LENGTH - 1)):
                            if byte == prefix[0] and not json_byte_is_escaped(payload, index):
                                prefix_position <- 1
                            else:
                                prefix_position <- 0
                else:
                    if method_value_escaped:
                        method_value_escaped <- false
                    else:
                        if byte == Character::REQUEST_CHARACTER_ASCII_BACKSLASH:
                            method_value_escaped <- true
                        else:
                            if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE:
                                candidate: RequestMethod = request_method_from_hash(method_hash)
                                request.method <- request_method_from_json_value(payload, method_value_start, index, candidate)
                                request.valid <- request.method != RequestMethod.Unknown
                                in_method <- false
                    if in_method:
                        method_hash <- request_hash_byte(method_hash, byte)
                        method_length <- method_length + 1
                        return invalid_request() if method_length > RequestLimits::MAX_METHOD_LENGTH
                if not in_id:
                    if byte == id_prefix[id_position] and (id_position != 0 or not json_byte_is_escaped(payload, index)):
                        id_position <- id_position + 1
                        if id_position == RequestLimits::ID_PREFIX_LENGTH:
                            return invalid_request() if id_field_seen
                            in_id <- true
                            id_field_seen <- true
                            id_position <- 0
                            id_digits <- 0
                            id_quoted <- false
                            request.id <- 0
                    else:
                        if not (is_json_whitespace(byte) and id_position == RequestLimits::ID_PREFIX_LENGTH - 1):
                            if byte == id_prefix[0] and not json_byte_is_escaped(payload, index):
                                id_position <- 1
                            else:
                                id_position <- 0
                else:
                    if id_quoted:
                        if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE:
                            return invalid_request() if id_digits == 0
                            id_quoted <- false
                            in_id <- false
                        else:
                            return invalid_request() if byte < Character::REQUEST_CHARACTER_ASCII_ZERO or byte > Character::REQUEST_CHARACTER_ASCII_NINE
                            return invalid_request() if id_digits == NumberFormat::FIRST_NUMBER_DIGIT_COUNT and request.id == 0
                            return invalid_request() if id_digits >= RequestLimits::MAX_ID_DIGITS or request.id > (NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64 - (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()) / NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE
                            if id_digits < RequestLimits::MAX_ID_DIGITS:
                                request.id <- request.id * NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE + (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                                id_digits <- id_digits + 1
                                request.has_id <- true
                    else:
                        if is_json_whitespace(byte) and id_digits == 0:
                            id_digits <- 0
                        else:
                            if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE and id_digits == 0:
                                id_quoted <- true
                            else:
                                if byte >= Character::REQUEST_CHARACTER_ASCII_ZERO and byte <= Character::REQUEST_CHARACTER_ASCII_NINE:
                                    return invalid_request() if id_digits == NumberFormat::FIRST_NUMBER_DIGIT_COUNT and request.id == 0
                                    return invalid_request() if id_digits >= RequestLimits::MAX_ID_DIGITS or request.id > (NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64 - (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()) / NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE
                                    if id_digits < RequestLimits::MAX_ID_DIGITS:
                                        request.id <- request.id * NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE + (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                                        id_digits <- id_digits + 1
                                        request.has_id <- true
                                else:
                                    return invalid_request() if not is_numeric_terminator(byte)
                                    in_id <- false
                if not in_expected:
                    if byte == expected_prefix[expected_position] and (expected_position != 0 or not json_byte_is_escaped(payload, index)):
                        expected_position <- expected_position + 1
                        if expected_position == RequestLimits::EXPECTED_PREFIX_LENGTH:
                            return invalid_request() if expected_field_seen
                            in_expected <- true
                            expected_field_seen <- true
                            expected_position <- 0
                            expected_digits <- 0
                            expected_quoted <- false
                    else:
                        if not (is_json_whitespace(byte) and (expected_position == RequestLimits::EXPECTED_PREFIX_LENGTH - 1 or expected_position == RequestLimits::EXPECTED_PREFIX_LENGTH - 2)):
                            if byte == expected_prefix[0] and not json_byte_is_escaped(payload, index):
                                expected_position <- 1
                            else:
                                expected_position <- 0
                else:
                    if expected_quoted:
                        if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE:
                            return invalid_request() if not expected_has_digits
                            expected_quoted <- false
                            in_expected <- false
                        else:
                            return invalid_request() if byte < Character::REQUEST_CHARACTER_ASCII_ZERO or byte > Character::REQUEST_CHARACTER_ASCII_NINE
                            return invalid_request() if expected_digits >= NumberFormat::FIRST_NUMBER_DIGIT_COUNT and request.expected_generation == 0
                            return invalid_request() if expected_digits >= RequestLimits::MAX_GENERATION_DIGITS or request.expected_generation > (NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64 - (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()) / NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE
                            if expected_digits < RequestLimits::MAX_GENERATION_DIGITS:
                                request.expected_generation <- request.expected_generation * NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE + (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                                expected_digits <- expected_digits + 1
                                expected_has_digits <- true
                    else:
                        if is_json_whitespace(byte) and not expected_has_digits:
                            expected_has_digits <- false
                        else:
                            if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE and not expected_has_digits:
                                expected_quoted <- true
                            else:
                                if byte >= Character::REQUEST_CHARACTER_ASCII_ZERO and byte <= Character::REQUEST_CHARACTER_ASCII_NINE:
                                    return invalid_request() if expected_digits >= NumberFormat::FIRST_NUMBER_DIGIT_COUNT and request.expected_generation == 0
                                    return invalid_request() if expected_digits >= RequestLimits::MAX_GENERATION_DIGITS or request.expected_generation > (NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64 - (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()) / NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE
                                    if expected_digits < RequestLimits::MAX_GENERATION_DIGITS:
                                        request.expected_generation <- request.expected_generation * NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE + (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                                        expected_digits <- expected_digits + 1
                                        expected_has_digits <- true
                                else:
                                    return invalid_request() if not is_numeric_terminator(byte)
                                    in_expected <- false
                if not in_target:
                    if byte == target_prefix[target_position] and (target_position != 0 or not json_byte_is_escaped(payload, index)):
                        target_position <- target_position + 1
                        if target_position == RequestLimits::TARGET_PREFIX_LENGTH:
                            return invalid_request() if target_field_seen
                            in_target <- true
                            target_field_seen <- true
                            target_position <- 0
                            target_digits <- 0
                            target_quoted <- false
                    else:
                        if not (is_json_whitespace(byte) and (target_position == RequestLimits::TARGET_PREFIX_LENGTH - 1 or target_position == RequestLimits::TARGET_PREFIX_LENGTH - 2)):
                            if byte == target_prefix[0] and not json_byte_is_escaped(payload, index):
                                target_position <- 1
                            else:
                                target_position <- 0
                else:
                    if target_quoted:
                        if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE:
                            return invalid_request() if not target_has_digits
                            target_quoted <- false
                            in_target <- false
                        else:
                            return invalid_request() if byte < Character::REQUEST_CHARACTER_ASCII_ZERO or byte > Character::REQUEST_CHARACTER_ASCII_NINE
                            return invalid_request() if target_digits >= NumberFormat::FIRST_NUMBER_DIGIT_COUNT and request.target_event == 0
                            return invalid_request() if target_digits >= RequestLimits::MAX_GENERATION_DIGITS or request.target_event > (NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64 - (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()) / NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE
                            if target_digits < RequestLimits::MAX_GENERATION_DIGITS:
                                request.target_event <- request.target_event * NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE + (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                                target_digits <- target_digits + 1
                                target_has_digits <- true
                    else:
                        if is_json_whitespace(byte) and not target_has_digits:
                            target_has_digits <- false
                        else:
                            if byte == Character::REQUEST_CHARACTER_ASCII_QUOTE and not target_has_digits:
                                target_quoted <- true
                            else:
                                if byte >= Character::REQUEST_CHARACTER_ASCII_ZERO and byte <= Character::REQUEST_CHARACTER_ASCII_NINE:
                                    return invalid_request() if target_digits >= NumberFormat::FIRST_NUMBER_DIGIT_COUNT and request.target_event == 0
                                    return invalid_request() if target_digits >= RequestLimits::MAX_GENERATION_DIGITS or request.target_event > (NumberFormat::REQUEST_NUMBERFORMAT_MAX_U64 - (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()) / NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE
                                    if target_digits < RequestLimits::MAX_GENERATION_DIGITS:
                                        request.target_event <- request.target_event * NumberFormat::REQUEST_NUMBERFORMAT_DECIMAL_BASE + (byte - Character::REQUEST_CHARACTER_ASCII_ZERO).u64()
                                        target_digits <- target_digits + 1
                                        target_has_digits <- true
                                else:
                                    return invalid_request() if not is_numeric_terminator(byte)
                                    in_target <- false
            return invalid_request() if in_method or in_id or in_expected or in_target
            return invalid_request() if id_field_seen and (not request.has_id or request.id == Sentinel::REQUEST_SENTINEL_NO_ID)
            return invalid_request() if request.method != RequestMethod.Discover and not request.has_id
            return invalid_request() if expected_field_seen and not expected_has_digits
            return invalid_request() if target_field_seen and not target_has_digits
            return request

        # Parse the ordinary protocol envelope's launch and pagination
        # operands. Launch requires one arguments.program path; other methods
        # may omit it. Paths are decoded as bounded UTF-8 filesystem paths.
        def request_operands_parse(payload: u8&, length: usize) -> RequestOperands:
            operands: mutable RequestOperands = zeroed
            operands.program <- invalid_program_path()
            request: Request = request_parse(payload, length)
            return operands if not request.valid
            root_start: mutable usize = 0
            while root_start < length and is_json_whitespace(payload[root_start]):
                root_start <- root_start + 1
            expected_generation: usize = request_object_field_value_start(payload, length, root_start, "expectedStopGeneration", 0)
            operands.has_expected_generation <- expected_generation != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            arguments: usize = request_object_field_value_start(payload, length, root_start, "arguments", 0)
            return operands if request_object_field_value_start(payload, length, root_start, "arguments", 1) != JsonParser::REQUEST_JSONPARSER_NO_INDEX
            if arguments != JsonParser::REQUEST_JSONPARSER_NO_INDEX:
                return operands if not request_arguments_operands_parse(payload, length, arguments, request.method, operands)
            return operands if request.method == RequestMethod.Launch and not operands.has_program
            return operands if request.method == RequestMethod.Variables and not operands.has_variables_reference
            return operands if not request_session_operands_parse(payload, length, root_start, operands)
            return operands if not request_initialization_version_parse(payload, length, root_start, request.method, operands)
            return operands if not request_pagination_operands_parse(payload, length, root_start, operands)
            operands.valid <- true
            return operands

        def source_breakpoint_request_capacity() -> usize:
            return RequestLimits::REQUEST_LIMITS_SOURCE_BREAKPOINT_COUNT_MAX
