# Bounded JSON request classifier.  It intentionally recognizes the stable
# `method` member without treating untrusted input as executable code.  Full
# value decoding is layered behind the same request type.

module DebuggerProtocolRequest:
    private:
        const REQUEST_METHOD_PREFIX_LENGTH: usize = 10
        const REQUEST_ID_PREFIX_LENGTH: usize = 5
        const REQUEST_EXPECTED_PREFIX_LENGTH: usize = 25
        const REQUEST_TARGET_PREFIX_LENGTH: usize = 14
        const REQUEST_MAX_METHOD_LENGTH: usize = 64
        const REQUEST_MAX_ID_DIGITS: usize = 20
        const REQUEST_NO_ID: u64 = 0
        const REQUEST_MAX_GENERATION_DIGITS: usize = 20
        const FIRST_NUMBER_DIGIT_COUNT: usize = 1
        const ASCII_QUOTE: u8 = 34
        const ASCII_COLON: u8 = 58
        const ASCII_BRACE_OPEN: u8 = 123
        const ASCII_BRACE_CLOSE: u8 = 125
        const ASCII_BRACKET_OPEN: u8 = 91
        const ASCII_BRACKET_CLOSE: u8 = 93
        const ASCII_BACKSLASH: u8 = 92
        const ASCII_ZERO: u8 = 48
        const ASCII_ONE: u8 = 49
        const ASCII_NINE: u8 = 57
        const ASCII_COMMA: u8 = 44
        const ASCII_SPACE: u8 = 32
        const ASCII_TAB: u8 = 9
        const ASCII_LINE_FEED: u8 = 10
        const ASCII_CARRIAGE_RETURN: u8 = 13
        const ASCII_M: u8 = 109
        const ASCII_E: u8 = 101
        const ASCII_T: u8 = 116
        const ASCII_H: u8 = 104
        const ASCII_O: u8 = 111
        const ASCII_D: u8 = 100
        const ASCII_I: u8 = 105
        const ASCII_A: u8 = 97
        const ASCII_L: u8 = 108
        const ASCII_S: u8 = 115
        const REQUEST_HASH_MULTIPLIER: u64 = 31
        const DECIMAL_BASE: u64 = 10
        const REQUEST_HEX_BASE: u64 = 16
        const REQUEST_ASCII_MAX: u64 = 127
        const REQUEST_UNICODE_ESCAPE_DIGITS: usize = 4
        const REQUEST_UNICODE_ESCAPE_MARKER_BYTES: usize = 1
        const REQUEST_FIRST_UNICODE_HEX_DIGIT_OFFSET: usize = 1
        const REQUEST_HEX_LETTER_OFFSET: u64 = 10
        const MAX_REQUEST_INTEGER: u64 = 18446744073709551615
        const JSON_NESTING_CAPACITY: usize = 64
        const REQUEST_KEY_NONE: u8 = 0
        const REQUEST_KEY_METHOD: u8 = 1
        const REQUEST_KEY_ID: u8 = 2
        const REQUEST_KEY_EXPECTED: u8 = 3
        const REQUEST_KEY_TARGET: u8 = 4
        const REQUEST_KEY_METHOD_LENGTH: usize = 6
        const REQUEST_KEY_ID_LENGTH: usize = 2
        const REQUEST_KEY_EXPECTED_LENGTH: usize = 22
        const REQUEST_KEY_TARGET_LENGTH: usize = 11
        const REQUEST_KEY_METHOD_HASH: u64 = 3217412321
        const REQUEST_KEY_ID_HASH: u64 = 3355
        const REQUEST_KEY_EXPECTED_HASH: u64 = 6143712305181352850
        const REQUEST_KEY_TARGET_HASH: u64 = 97741681043071881
        const REQUEST_PROGRAM_PATH_CAPACITY: usize = 1024
        const REQUEST_PAGE_SIZE_MAX: u64 = 256
        const REQUEST_PAGE_START_MAX: u64 = MAX_REQUEST_INTEGER
        const REQUEST_PROTOCOL_VERSION_MAX: u64 = 4294967295
        const REQUEST_JSON_HEX_BASE: u64 = 16
        const REQUEST_JSON_HEX_LETTER_OFFSET: u64 = 10
        const REQUEST_UNICODE_MAX_CODEPOINT: u64 = 1114111
        const REQUEST_UNICODE_CONTROL_MAX: u64 = 31
        const REQUEST_UNICODE_TWO_BYTE_MAX_EXCLUSIVE: u64 = 2048
        const REQUEST_UNICODE_THREE_BYTE_MAX_EXCLUSIVE: u64 = 65536
        const REQUEST_UNICODE_SURROGATE_HIGH_START: u64 = 55296
        const REQUEST_UNICODE_SURROGATE_HIGH_END: u64 = 56319
        const REQUEST_UNICODE_SURROGATE_LOW_START: u64 = 56320
        const REQUEST_UNICODE_SURROGATE_LOW_END: u64 = 57343
        const REQUEST_UNICODE_SURROGATE_BASE: u64 = 65536
        const REQUEST_UNICODE_HIGH_SURROGATE_OFFSET: u64 = 55296
        const REQUEST_UNICODE_LOW_SURROGATE_OFFSET: u64 = 56320
        const REQUEST_UNICODE_SURROGATE_SHIFT: u64 = 10
        const REQUEST_UTF8_CONTINUATION_BASE: u64 = 128
        const REQUEST_UTF8_CONTINUATION_MASK: u64 = 63
        const REQUEST_UTF8_SHIFT: u64 = 6
        const REQUEST_UTF8_TWO_BYTE_BASE: u64 = 192
        const REQUEST_UTF8_THREE_BYTE_BASE: u64 = 224
        const REQUEST_UTF8_FOUR_BYTE_BASE: u64 = 240
        const REQUEST_UTF8_TWO_BYTE_START: u64 = 194
        const REQUEST_UTF8_TWO_BYTE_END: u64 = 223
        const REQUEST_UTF8_THREE_BYTE_START: u64 = 224
        const REQUEST_UTF8_THREE_BYTE_END: u64 = 239
        const REQUEST_UTF8_FOUR_BYTE_START: u64 = 240
        const REQUEST_UTF8_FOUR_BYTE_END: u64 = 244
        const REQUEST_UTF8_CONTINUATION_MIN: u64 = 128
        const REQUEST_UTF8_CONTINUATION_MAX: u64 = 191
        const REQUEST_UTF8_TWO_BYTE_MIN_CODEPOINT: u64 = 128
        const REQUEST_UTF8_THREE_BYTE_MIN_CODEPOINT: u64 = 2048
        const REQUEST_UTF8_FOUR_BYTE_MIN_CODEPOINT: u64 = 65536
        const REQUEST_UTF8_FIRST_TWO_MASK: u64 = 31
        const REQUEST_UTF8_FIRST_THREE_MASK: u64 = 15
        const REQUEST_UTF8_FIRST_FOUR_MASK: u64 = 7
        const REQUEST_UTF8_TWO_BYTE_LENGTH: usize = 2
        const REQUEST_UTF8_THREE_BYTE_LENGTH: usize = 3
        const REQUEST_UTF8_FOUR_BYTE_LENGTH: usize = 4
        const REQUEST_ASCII_DELETE: u64 = 127

        struct ParsedOperandNumber:
            valid: mutable bool
            value: mutable u64
            end: mutable usize

        const JSON_STATE_VALUE: u8 = 0
        const JSON_STATE_KEY_OR_END: u8 = 1
        const JSON_STATE_COLON: u8 = 2
        const JSON_STATE_COMMA_OR_END: u8 = 3
        const JSON_STATE_ROOT_DONE: u8 = 4
        const JSON_STATE_VALUE_OR_END: u8 = 5
        const JSON_STATE_KEY_REQUIRED: u8 = 6
        const JSON_NO_INDEX: usize = 18446744073709551615
        const ASCII_MINUS: u8 = 45
        const ASCII_PLUS: u8 = 43
        const ASCII_DOT: u8 = 46
        const ASCII_LOWER_E: u8 = 101
        const ASCII_UPPER_E: u8 = 69
        const ASCII_SLASH: u8 = 47
        const ASCII_B: u8 = 98
        const ASCII_F: u8 = 102
        const ASCII_N: u8 = 110
        const ASCII_R: u8 = 114
        const ASCII_U: u8 = 117
        const ASCII_UPPER_A: u8 = 65
        const ASCII_UPPER_F: u8 = 70
        const JSON_LITERAL_SENTINEL: u8 = 0

        const HASH_DISCOVER: u64 = 2847836501993
        const HASH_INITIALIZE: u64 = 2872973214862224
        const HASH_CREATE_SESSION: u64 = 7173654557551470074
        const HASH_LAUNCH: u64 = 3185124275
        const HASH_ATTACH: u64 = 2887708229
        const HASH_OPEN_TRACE: u64 = 97845186083099
        const HASH_PAUSE: u64 = 106440182
        const HASH_CONTINUE: u64 = 2825521278119
        const HASH_STEP: u64 = 3540684
        const HASH_REVERSE_STEP: u64 = 96211551034117326
        const HASH_SEEK: u64 = 3526264
        const HASH_THREADS: u64 = 106036245417
        const HASH_STACK: u64 = 109757064
        const HASH_SCOPES: u64 = 3387198623
        const HASH_VARIABLES: u64 = 103414140075383
        const HASH_EVALUATE: u64 = 2886379809945
        const HASH_SET_BREAKPOINTS: u64 = 12884271682976838880
        const HASH_CHECKPOINT: u64 = 2709093068854664
        const HASH_BRANCH: u64 = 2913936802
        const HASH_COMPARE: u64 = 91144797413
        const HASH_DETACH: u64 = 2959742867
        const HASH_TERMINATE: u64 = 101818530709089
        const HASH_CLOSE: u64 = 94756344
        const HASH_REPLAY: u64 = 3360442343
        const HASH_SET_DATA_BREAKPOINTS: u64 = 11437948931016314838
        const HASH_TRACE_VERIFY: u64 = 3043472847335273794
        const HASH_TRACE_EXPORT: u64 = 3043472846866071677
        const HASH_CANCEL: u64 = 2927242874
        const HASH_MEMORY: u64 = 3217210625

    public:
        enum RequestMethod:
            Unknown
            Discover
            Initialize
            CreateSession
            Launch
            Attach
            OpenTrace
            Replay
            Pause
            Continue
            Step
            ReverseStep
            Seek
            Threads
            Stack
            Scopes
            Variables
            Evaluate
            SetBreakpoints
            SetDataBreakpoints
            Checkpoint
            Branch
            Compare
            TraceVerify
            TraceExport
            Detach
            Terminate
            Close
            Cancel
            Memory

        struct Request:
            method: mutable RequestMethod
            id: mutable u64
            has_id: mutable bool
            expected_generation: mutable u64
            target_event: mutable u64
            valid: mutable bool

        struct ProgramPath:
            bytes: mutable u8[REQUEST_PROGRAM_PATH_CAPACITY]
            length: mutable usize
            valid: mutable bool

        struct RequestOperands:
            valid: mutable bool
            program: mutable ProgramPath
            has_program: mutable bool
            protocol_major: mutable u64
            has_protocol_major: mutable bool
            protocol_minor: mutable u64
            has_protocol_minor: mutable bool
            variables_reference: mutable u64
            has_variables_reference: mutable bool
            page_size: mutable u64
            has_page_size: mutable bool
            page_start: mutable u64
            has_page_start: mutable bool

        def invalid_request() -> Request:
            return zeroed

        def request_hash_byte(hash: u64, byte: u8) -> u64:
            return hash * REQUEST_HASH_MULTIPLIER + byte.u64()

        def request_method_from_hash(hash: u64) -> RequestMethod:
            return RequestMethod.Discover if hash == HASH_DISCOVER
            return RequestMethod.Initialize if hash == HASH_INITIALIZE
            return RequestMethod.CreateSession if hash == HASH_CREATE_SESSION
            return RequestMethod.Launch if hash == HASH_LAUNCH
            return RequestMethod.Attach if hash == HASH_ATTACH
            return RequestMethod.OpenTrace if hash == HASH_OPEN_TRACE
            return RequestMethod.Replay if hash == HASH_REPLAY
            return RequestMethod.Pause if hash == HASH_PAUSE
            return RequestMethod.Continue if hash == HASH_CONTINUE
            return RequestMethod.Step if hash == HASH_STEP
            return RequestMethod.ReverseStep if hash == HASH_REVERSE_STEP
            return RequestMethod.Seek if hash == HASH_SEEK
            return RequestMethod.Threads if hash == HASH_THREADS
            return RequestMethod.Stack if hash == HASH_STACK
            return RequestMethod.Scopes if hash == HASH_SCOPES
            return RequestMethod.Variables if hash == HASH_VARIABLES
            return RequestMethod.Evaluate if hash == HASH_EVALUATE
            return RequestMethod.SetBreakpoints if hash == HASH_SET_BREAKPOINTS
            return RequestMethod.SetDataBreakpoints if hash == HASH_SET_DATA_BREAKPOINTS
            return RequestMethod.Checkpoint if hash == HASH_CHECKPOINT
            return RequestMethod.Branch if hash == HASH_BRANCH
            return RequestMethod.Compare if hash == HASH_COMPARE
            return RequestMethod.TraceVerify if hash == HASH_TRACE_VERIFY
            return RequestMethod.TraceExport if hash == HASH_TRACE_EXPORT
            return RequestMethod.Detach if hash == HASH_DETACH
            return RequestMethod.Terminate if hash == HASH_TERMINATE
            return RequestMethod.Close if hash == HASH_CLOSE
            return RequestMethod.Cancel if hash == HASH_CANCEL
            return RequestMethod.Memory if hash == HASH_MEMORY
            return RequestMethod.Unknown

        def request_method_name(method: RequestMethod) -> cstr:
            return "discover" if method == RequestMethod.Discover
            return "initialize" if method == RequestMethod.Initialize
            return "createSession" if method == RequestMethod.CreateSession
            return "launch" if method == RequestMethod.Launch
            return "attach" if method == RequestMethod.Attach
            return "openTrace" if method == RequestMethod.OpenTrace
            return "replay" if method == RequestMethod.Replay
            return "pause" if method == RequestMethod.Pause
            return "continue" if method == RequestMethod.Continue
            return "step" if method == RequestMethod.Step
            return "reverseStep" if method == RequestMethod.ReverseStep
            return "seek" if method == RequestMethod.Seek
            return "threads" if method == RequestMethod.Threads
            return "stack" if method == RequestMethod.Stack
            return "scopes" if method == RequestMethod.Scopes
            return "variables" if method == RequestMethod.Variables
            return "evaluate" if method == RequestMethod.Evaluate
            return "setBreakpoints" if method == RequestMethod.SetBreakpoints
            return "setDataBreakpoints" if method == RequestMethod.SetDataBreakpoints
            return "checkpoint" if method == RequestMethod.Checkpoint
            return "branch" if method == RequestMethod.Branch
            return "compare" if method == RequestMethod.Compare
            return "trace.verify" if method == RequestMethod.TraceVerify
            return "trace.export" if method == RequestMethod.TraceExport
            return "detach" if method == RequestMethod.Detach
            return "terminate" if method == RequestMethod.Terminate
            return "close" if method == RequestMethod.Close
            return "cancel" if method == RequestMethod.Cancel
            return "memory" if method == RequestMethod.Memory
            return ""

        def request_cstr_length(value: cstr) -> usize:
            length: mutable usize = 0
            while value[length] != 0:
                length <- length + 1
            return length

        # Hashes are only a quick candidate lookup.  Compare the decoded JSON
        # string with the canonical token before trusting the enum so a rolling
        # hash collision cannot turn an unknown method into a real operation.
        def request_method_json_string_matches(payload: u8&, start: usize, end: usize, expected: cstr) -> bool:
            cursor: mutable usize = start
            expected_index: mutable usize = 0
            expected_length: usize = request_cstr_length(expected)
            while cursor < end:
                character: mutable u64 = 0
                if payload[cursor] == ASCII_BACKSLASH:
                    cursor <- cursor + 1
                    return false if cursor >= end
                    escape: u8 = payload[cursor]
                    if escape == ASCII_U:
                        return false if end - cursor <= REQUEST_UNICODE_ESCAPE_DIGITS
                        for offset in REQUEST_FIRST_UNICODE_HEX_DIGIT_OFFSET..<(REQUEST_UNICODE_ESCAPE_DIGITS + REQUEST_UNICODE_ESCAPE_MARKER_BYTES):
                            digit: u8 = payload[cursor + offset]
                            hex_value: mutable u64 = 0
                            if digit >= ASCII_ZERO and digit <= ASCII_NINE:
                                hex_value <- (digit - ASCII_ZERO).u64()
                            else:
                                if digit >= ASCII_A and digit <= ASCII_F:
                                    hex_value <- (digit - ASCII_A).u64() + REQUEST_HEX_LETTER_OFFSET
                                else:
                                    if digit >= ASCII_UPPER_A and digit <= ASCII_UPPER_F:
                                        hex_value <- (digit - ASCII_UPPER_A).u64() + REQUEST_HEX_LETTER_OFFSET
                                    else:
                                        return false
                            character <- character * REQUEST_HEX_BASE + hex_value
                        cursor <- cursor + REQUEST_UNICODE_ESCAPE_DIGITS + REQUEST_UNICODE_ESCAPE_MARKER_BYTES
                    else:
                        # None of the canonical method names contains a JSON
                        # escapable punctuation or control character.
                        return false
                else:
                    character <- payload[cursor].u64()
                    cursor <- cursor + 1
                return false if character > REQUEST_ASCII_MAX
                return false if expected_index >= expected_length
                return false if expected[expected_index].u8().u64() != character
                expected_index <- expected_index + 1
            return expected_index == expected_length

        def request_method_from_json_value(payload: u8&, start: usize, end: usize, hash_candidate: RequestMethod) -> RequestMethod:
            return hash_candidate if hash_candidate != RequestMethod.Unknown and request_method_json_string_matches(payload, start, end, request_method_name(hash_candidate))
            return RequestMethod.Discover if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Discover))
            return RequestMethod.Initialize if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Initialize))
            return RequestMethod.CreateSession if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.CreateSession))
            return RequestMethod.Launch if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Launch))
            return RequestMethod.Attach if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Attach))
            return RequestMethod.OpenTrace if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.OpenTrace))
            return RequestMethod.Replay if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Replay))
            return RequestMethod.Pause if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Pause))
            return RequestMethod.Continue if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Continue))
            return RequestMethod.Step if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Step))
            return RequestMethod.ReverseStep if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.ReverseStep))
            return RequestMethod.Seek if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Seek))
            return RequestMethod.Threads if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Threads))
            return RequestMethod.Stack if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Stack))
            return RequestMethod.Scopes if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Scopes))
            return RequestMethod.Variables if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Variables))
            return RequestMethod.Evaluate if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Evaluate))
            return RequestMethod.SetBreakpoints if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.SetBreakpoints))
            return RequestMethod.SetDataBreakpoints if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.SetDataBreakpoints))
            return RequestMethod.Checkpoint if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Checkpoint))
            return RequestMethod.Branch if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Branch))
            return RequestMethod.Compare if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Compare))
            return RequestMethod.TraceVerify if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.TraceVerify))
            return RequestMethod.TraceExport if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.TraceExport))
            return RequestMethod.Detach if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Detach))
            return RequestMethod.Terminate if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Terminate))
            return RequestMethod.Close if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Close))
            return RequestMethod.Cancel if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Cancel))
            return RequestMethod.Memory if request_method_json_string_matches(payload, start, end, request_method_name(RequestMethod.Memory))
            return RequestMethod.Unknown

        def is_numeric_terminator(byte: u8) -> bool:
            return true if byte == ASCII_COMMA or byte == ASCII_BRACE_CLOSE
            return true if byte == ASCII_SPACE or byte == ASCII_TAB
            return true if byte == ASCII_LINE_FEED or byte == ASCII_CARRIAGE_RETURN
            return false

        def is_json_whitespace(byte: u8) -> bool:
            return byte == ASCII_SPACE or byte == ASCII_TAB or byte == ASCII_LINE_FEED or byte == ASCII_CARRIAGE_RETURN

        def is_json_hex_digit(byte: u8) -> bool:
            return true if byte >= ASCII_ZERO and byte <= ASCII_NINE
            return true if byte >= ASCII_A and byte <= ASCII_F
            return byte >= ASCII_UPPER_A and byte <= ASCII_UPPER_F

        # The lightweight field scanner runs alongside the structural parser.
        # A quoted field name embedded in a string value must not be mistaken
        # for another top-level member (for example, an escaped `"method":`).
        # Count the immediately preceding backslashes so escaped quotes are
        # ignored while a quote preceded by an even number remains structural.
        def json_byte_is_escaped(payload: u8&, index: usize) -> bool:
            return false if payload[index] != ASCII_QUOTE
            slash_count: mutable usize = 0
            cursor: mutable usize = index
            while cursor > 0:
                cursor <- cursor - 1
                return false if payload[cursor] != ASCII_BACKSLASH and slash_count % 2 == 0
                return true if payload[cursor] != ASCII_BACKSLASH and slash_count % 2 == 1
                slash_count <- slash_count + 1
            return slash_count % 2 == 1

        def request_raw_json_key_matches(payload: u8&, start: usize, end: usize, expected: cstr) -> bool:
            expected_length: usize = request_cstr_length(expected)
            return false if end - start != expected_length
            for offset in 0..<expected_length:
                return false if payload[start + offset] != expected[offset].u8()
            return true

        def request_key_kind(payload: u8&, start: usize, end: usize, hash: u64, length: usize) -> u8:
            return REQUEST_KEY_METHOD if length == REQUEST_KEY_METHOD_LENGTH and hash == REQUEST_KEY_METHOD_HASH and request_raw_json_key_matches(payload, start, end, "method")
            return REQUEST_KEY_ID if length == REQUEST_KEY_ID_LENGTH and hash == REQUEST_KEY_ID_HASH and request_raw_json_key_matches(payload, start, end, "id")
            return REQUEST_KEY_EXPECTED if length == REQUEST_KEY_EXPECTED_LENGTH and hash == REQUEST_KEY_EXPECTED_HASH and request_raw_json_key_matches(payload, start, end, "expectedStopGeneration")
            return REQUEST_KEY_TARGET if length == REQUEST_KEY_TARGET_LENGTH and hash == REQUEST_KEY_TARGET_HASH and request_raw_json_key_matches(payload, start, end, "targetEvent")
            return REQUEST_KEY_NONE

        def request_top_level_fields_are_valid(payload: u8&, length: usize) -> bool:
            object_depth: mutable usize = 0
            array_depth: mutable usize = 0
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_hash: mutable u64 = 0
            string_length: mutable usize = 0
            string_start: mutable usize = 0
            top_level_method_seen: mutable bool = false
            index: mutable usize = 0
            while index < length:
                byte: u8 = payload[index]
                if in_string:
                    if escaped:
                        escaped <- false
                        string_hash <- request_hash_byte(string_hash, byte)
                        string_length <- string_length + 1
                    else:
                        if byte == ASCII_BACKSLASH:
                            escaped <- true
                            string_hash <- request_hash_byte(string_hash, byte)
                            string_length <- string_length + 1
                        else:
                            if byte == ASCII_QUOTE:
                                in_string <- false
                                lookahead: mutable usize = index + 1
                                while lookahead < length and is_json_whitespace(payload[lookahead]):
                                    lookahead <- lookahead + 1
                                if lookahead < length and payload[lookahead] == ASCII_COLON:
                                    key_kind: u8 = request_key_kind(payload, string_start, index, string_hash, string_length)
                                    if key_kind != REQUEST_KEY_NONE:
                                        return false if object_depth != 1 or array_depth != 0
                                        top_level_method_seen <- true if key_kind == REQUEST_KEY_METHOD
                            else:
                                string_hash <- request_hash_byte(string_hash, byte)
                                string_length <- string_length + 1
                else:
                    if byte == ASCII_QUOTE:
                        in_string <- true
                        escaped <- false
                        string_hash <- 0
                        string_length <- 0
                        string_start <- index + 1
                    else:
                        if byte == ASCII_BRACE_OPEN:
                            object_depth <- object_depth + 1
                        else:
                            if byte == ASCII_BRACE_CLOSE:
                                return false if object_depth == 0
                                object_depth <- object_depth - 1
                            else:
                                if byte == ASCII_BRACKET_OPEN:
                                    array_depth <- array_depth + 1
                                else:
                                    if byte == ASCII_BRACKET_CLOSE:
                                        return false if array_depth == 0
                                        array_depth <- array_depth - 1
                index <- index + 1
            return not in_string and not escaped and object_depth == 0 and array_depth == 0 and top_level_method_seen

        def json_string_end(payload: u8&, length: usize, start: usize) -> usize:
            return JSON_NO_INDEX if start >= length or payload[start] != ASCII_QUOTE
            index: mutable usize = start + 1
            escaped: mutable bool = false
            unicode_digits: mutable usize = 0
            while index < length:
                byte: u8 = payload[index]
                if unicode_digits > 0:
                    return JSON_NO_INDEX if not is_json_hex_digit(byte)
                    unicode_digits <- unicode_digits - 1
                else:
                    if escaped:
                        return JSON_NO_INDEX if byte != ASCII_QUOTE and byte != ASCII_BACKSLASH and byte != ASCII_SLASH and byte != ASCII_B and byte != ASCII_F and byte != ASCII_N and byte != ASCII_R and byte != ASCII_T and byte != ASCII_U
                        escaped <- false
                        unicode_digits <- 4 if byte == ASCII_U
                    else:
                        if byte == ASCII_BACKSLASH:
                            escaped <- true
                        else:
                            return index + 1 if byte == ASCII_QUOTE
                            return JSON_NO_INDEX if byte < ASCII_SPACE
                index <- index + 1
            return JSON_NO_INDEX if escaped or unicode_digits > 0
            return JSON_NO_INDEX

        def json_literal_matches(payload: u8&, start: usize, end: usize, first: u8, second: u8, third: u8, fourth: u8, fifth: u8) -> bool:
            length: usize = end - start
            return payload[start] == first and payload[start + 1] == second and payload[start + 2] == third and payload[start + 3] == fourth and (length == 4 or payload[start + 4] == fifth)

        def json_primitive_is_valid(payload: u8&, start: usize, end: usize) -> bool:
            return false if start >= end
            length: usize = end - start
            return true if length == 4 and json_literal_matches(payload, start, end, ASCII_T, ASCII_R, ASCII_U, ASCII_E, JSON_LITERAL_SENTINEL)
            return true if length == 5 and json_literal_matches(payload, start, end, ASCII_F, ASCII_A, ASCII_L, ASCII_S, ASCII_E)
            return true if length == 4 and json_literal_matches(payload, start, end, ASCII_N, ASCII_U, ASCII_L, ASCII_L, JSON_LITERAL_SENTINEL)
            index: mutable usize = start
            if payload[index] == ASCII_MINUS:
                index <- index + 1
            return false if index >= end
            if payload[index] == ASCII_ZERO:
                index <- index + 1
                return false if index < end and payload[index] >= ASCII_ZERO and payload[index] <= ASCII_NINE
            else:
                return false if payload[index] < ASCII_ONE or payload[index] > ASCII_NINE
                while index < end and payload[index] >= ASCII_ZERO and payload[index] <= ASCII_NINE:
                    index <- index + 1
            if index < end and payload[index] == ASCII_DOT:
                index <- index + 1
                return false if index >= end or payload[index] < ASCII_ZERO or payload[index] > ASCII_NINE
                while index < end and payload[index] >= ASCII_ZERO and payload[index] <= ASCII_NINE:
                    index <- index + 1
            if index < end and (payload[index] == ASCII_LOWER_E or payload[index] == ASCII_UPPER_E):
                index <- index + 1
                if index < end and (payload[index] == ASCII_MINUS or payload[index] == ASCII_PLUS):
                    index <- index + 1
                return false if index >= end or payload[index] < ASCII_ZERO or payload[index] > ASCII_NINE
                while index < end and payload[index] >= ASCII_ZERO and payload[index] <= ASCII_NINE:
                    index <- index + 1
            return index == end

        def json_primitive_end(payload: u8&, length: usize, start: usize) -> usize:
            return JSON_NO_INDEX if start >= length
            index: mutable usize = start
            while index < length:
                byte: u8 = payload[index]
                return index if is_json_whitespace(byte) or byte == ASCII_COMMA or byte == ASCII_BRACE_CLOSE or byte == ASCII_BRACKET_CLOSE
                return JSON_NO_INDEX if byte == ASCII_COLON or byte == ASCII_BRACE_OPEN or byte == ASCII_BRACKET_OPEN or byte == ASCII_QUOTE
                index <- index + 1
            return index

        def json_value_end(payload: u8&, length: usize, start: usize) -> usize:
            return JSON_NO_INDEX if start >= length
            return json_string_end(payload, length, start) if payload[start] == ASCII_QUOTE
            return JSON_NO_INDEX if payload[start] == ASCII_BRACE_OPEN or payload[start] == ASCII_BRACKET_OPEN or payload[start] == ASCII_BRACE_CLOSE or payload[start] == ASCII_BRACKET_CLOSE or payload[start] == ASCII_COMMA or payload[start] == ASCII_COLON
            end: usize = json_primitive_end(payload, length, start)
            return JSON_NO_INDEX if end == JSON_NO_INDEX or not json_primitive_is_valid(payload, start, end)
            return end

    private:
        # Decode only printable ASCII JSON key escapes. All supported request
        # operand names are ASCII; non-ASCII keys cannot match them.
        def request_json_key_matches(payload: u8&, start: usize, end: usize, expected: cstr) -> bool:
            cursor: mutable usize = start
            expected_index: mutable usize = 0
            expected_length: usize = request_cstr_length(expected)
            while cursor < end:
                character: mutable u64 = payload[cursor].u64()
                if payload[cursor] == ASCII_BACKSLASH:
                    cursor <- cursor + 1
                    return false if cursor >= end
                    escaped: u8 = payload[cursor]
                    if escaped == ASCII_U:
                        return false if end - cursor <= REQUEST_UNICODE_ESCAPE_DIGITS
                        character <- 0
                        for offset in REQUEST_FIRST_UNICODE_HEX_DIGIT_OFFSET..<(REQUEST_UNICODE_ESCAPE_DIGITS + REQUEST_UNICODE_ESCAPE_MARKER_BYTES):
                            digit: u8 = payload[cursor + offset]
                            hex_value: mutable u64 = 0
                            if digit >= ASCII_ZERO and digit <= ASCII_NINE:
                                hex_value <- (digit - ASCII_ZERO).u64()
                            else:
                                if digit >= ASCII_A and digit <= ASCII_F:
                                    hex_value <- (digit - ASCII_A).u64() + REQUEST_HEX_LETTER_OFFSET
                                else:
                                    if digit >= ASCII_UPPER_A and digit <= ASCII_UPPER_F:
                                        hex_value <- (digit - ASCII_UPPER_A).u64() + REQUEST_HEX_LETTER_OFFSET
                                    else:
                                        return false
                            character <- character * REQUEST_HEX_BASE + hex_value
                        cursor <- cursor + REQUEST_UNICODE_ESCAPE_DIGITS + REQUEST_UNICODE_ESCAPE_MARKER_BYTES
                    else:
                        return false if escaped != ASCII_QUOTE and escaped != ASCII_BACKSLASH and escaped != ASCII_SLASH
                        character <- escaped.u64()
                        cursor <- cursor + 1
                else:
                    cursor <- cursor + 1
                return false if character > REQUEST_ASCII_MAX or expected_index >= expected_length
                return false if expected[expected_index].u8().u64() != character
                expected_index <- expected_index + 1
            return expected_index == expected_length

        def request_operand_json_value_end(payload: u8&, length: usize, start: usize) -> usize:
            return JSON_NO_INDEX if start >= length
            return json_string_end(payload, length, start) if payload[start] == ASCII_QUOTE
            if payload[start] == ASCII_BRACE_OPEN or payload[start] == ASCII_BRACKET_OPEN:
                depth: mutable usize = 0
                in_string: mutable bool = false
                escaped: mutable bool = false
                index: mutable usize = start
                while index < length:
                    byte: u8 = payload[index]
                    if in_string:
                        if escaped:
                            escaped <- false
                        else:
                            if byte == ASCII_BACKSLASH:
                                escaped <- true
                            else:
                                in_string <- false if byte == ASCII_QUOTE
                    else:
                        if byte == ASCII_QUOTE:
                            in_string <- true
                        else:
                            if byte == ASCII_BRACE_OPEN or byte == ASCII_BRACKET_OPEN:
                                depth <- depth + 1
                            else:
                                if byte == ASCII_BRACE_CLOSE or byte == ASCII_BRACKET_CLOSE:
                                    return index + 1 if depth == 1
                                    depth <- depth - 1
                    index <- index + 1
                return JSON_NO_INDEX
            end: usize = json_primitive_end(payload, length, start)
            return JSON_NO_INDEX if end == JSON_NO_INDEX or not json_primitive_is_valid(payload, start, end)
            return end

        # Scan direct members of one object, skipping complete values so a
        # nested arguments/program decoy cannot satisfy a launch request.
        def request_object_field_value_start(payload: u8&, length: usize, object_start: usize, expected: cstr, occurrence: usize) -> usize:
            return JSON_NO_INDEX if object_start >= length or payload[object_start] != ASCII_BRACE_OPEN
            property_index: mutable usize = object_start + 1
            matched: mutable usize = 0
            while property_index < length:
                while property_index < length and (is_json_whitespace(payload[property_index]) or payload[property_index] == ASCII_COMMA):
                    property_index <- property_index + 1
                return JSON_NO_INDEX if property_index >= length or payload[property_index] == ASCII_BRACE_CLOSE
                key_start: usize = property_index
                key_end: usize = json_string_end(payload, length, key_start)
                return JSON_NO_INDEX if key_end == JSON_NO_INDEX
                property_index <- key_end
                while property_index < length and is_json_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                return JSON_NO_INDEX if property_index >= length or payload[property_index] != ASCII_COLON
                property_index <- property_index + 1
                while property_index < length and is_json_whitespace(payload[property_index]):
                    property_index <- property_index + 1
                value_start: usize = property_index
                value_end: usize = request_operand_json_value_end(payload, length, value_start)
                return JSON_NO_INDEX if value_end == JSON_NO_INDEX
                if request_json_key_matches(payload, key_start + 1, key_end - 1, expected):
                    if matched == occurrence:
                        return value_start
                    matched <- matched + 1
                property_index <- value_end
            return JSON_NO_INDEX

        def invalid_operand_number() -> ParsedOperandNumber:
            return ParsedOperandNumber{valid: false, value: 0, end: JSON_NO_INDEX}

        def request_parse_bounded_unsigned(payload: u8&, length: usize, start: usize, maximum: u64, allow_decimal_string: bool) -> ParsedOperandNumber:
            return invalid_operand_number() if start >= length
            quoted: bool = payload[start] == ASCII_QUOTE
            return invalid_operand_number() if quoted and not allow_decimal_string
            return invalid_operand_number() if not quoted and (payload[start] < ASCII_ZERO or payload[start] > ASCII_NINE)
            index: mutable usize = start + 1 if quoted else start
            value: mutable u64 = 0
            digits: mutable usize = 0
            while index < length and payload[index] >= ASCII_ZERO and payload[index] <= ASCII_NINE:
                digit: u64 = (payload[index] - ASCII_ZERO).u64()
                return invalid_operand_number() if digits > 0 and value == 0
                return invalid_operand_number() if value > (maximum - digit) / DECIMAL_BASE
                value <- value * DECIMAL_BASE + digit
                digits <- digits + 1
                index <- index + 1
            return invalid_operand_number() if digits == 0
            if quoted:
                return invalid_operand_number() if index >= length or payload[index] != ASCII_QUOTE
                index <- index + 1
            if index < length:
                byte: u8 = payload[index]
                return invalid_operand_number() if not is_json_whitespace(byte) and byte != ASCII_COMMA and byte != ASCII_BRACE_CLOSE
            return ParsedOperandNumber{valid: true, value: value, end: index}

        def invalid_program_path() -> ProgramPath:
            return ProgramPath{bytes: zeroed, length: 0, valid: false}

        def request_program_path_append(path: mutable ProgramPath&, byte: u8) -> bool:
            return false if path.length >= REQUEST_PROGRAM_PATH_CAPACITY
            path.bytes[path.length] <- byte
            path.length <- path.length + 1
            return true

        def request_program_path_append_codepoint(path: mutable ProgramPath&, value: u64) -> bool:
            return false if value == 0 or value <= REQUEST_UNICODE_CONTROL_MAX or value == REQUEST_ASCII_DELETE
            return false if value > REQUEST_UNICODE_MAX_CODEPOINT
            if value < REQUEST_UTF8_CONTINUATION_BASE:
                return request_program_path_append(path, value.u8())
            if value < REQUEST_UNICODE_TWO_BYTE_MAX_EXCLUSIVE:
                first: u8 = (REQUEST_UTF8_TWO_BYTE_BASE | (value >> REQUEST_UTF8_SHIFT)).u8()
                second: u8 = (REQUEST_UTF8_CONTINUATION_BASE | (value & REQUEST_UTF8_CONTINUATION_MASK)).u8()
                return false if not request_program_path_append(path, first)
                return request_program_path_append(path, second)
            if value < REQUEST_UNICODE_THREE_BYTE_MAX_EXCLUSIVE:
                first: u8 = (REQUEST_UTF8_THREE_BYTE_BASE | (value >> (REQUEST_UTF8_SHIFT * 2))).u8()
                second: u8 = (REQUEST_UTF8_CONTINUATION_BASE | ((value >> REQUEST_UTF8_SHIFT) & REQUEST_UTF8_CONTINUATION_MASK)).u8()
                third: u8 = (REQUEST_UTF8_CONTINUATION_BASE | (value & REQUEST_UTF8_CONTINUATION_MASK)).u8()
                return false if not request_program_path_append(path, first)
                return false if not request_program_path_append(path, second)
                return request_program_path_append(path, third)
            first: u8 = (REQUEST_UTF8_FOUR_BYTE_BASE | (value >> (REQUEST_UTF8_SHIFT * 3))).u8()
            second: u8 = (REQUEST_UTF8_CONTINUATION_BASE | ((value >> (REQUEST_UTF8_SHIFT * 2)) & REQUEST_UTF8_CONTINUATION_MASK)).u8()
            third: u8 = (REQUEST_UTF8_CONTINUATION_BASE | ((value >> REQUEST_UTF8_SHIFT) & REQUEST_UTF8_CONTINUATION_MASK)).u8()
            fourth: u8 = (REQUEST_UTF8_CONTINUATION_BASE | (value & REQUEST_UTF8_CONTINUATION_MASK)).u8()
            return false if not request_program_path_append(path, first)
            return false if not request_program_path_append(path, second)
            return false if not request_program_path_append(path, third)
            return request_program_path_append(path, fourth)

        def request_program_path_utf8_is_valid(path: ProgramPath) -> bool:
            index: mutable usize = 0
            while index < path.length:
                first: u64 = path.bytes[index].u64()
                sequence_length: mutable usize = 1
                minimum_codepoint: mutable u64 = 0
                codepoint: mutable u64 = first
                if first >= REQUEST_UTF8_TWO_BYTE_START and first <= REQUEST_UTF8_TWO_BYTE_END:
                    sequence_length <- REQUEST_UTF8_TWO_BYTE_LENGTH
                    minimum_codepoint <- REQUEST_UTF8_TWO_BYTE_MIN_CODEPOINT
                    codepoint <- first & REQUEST_UTF8_FIRST_TWO_MASK
                if first >= REQUEST_UTF8_THREE_BYTE_START and first <= REQUEST_UTF8_THREE_BYTE_END:
                    sequence_length <- REQUEST_UTF8_THREE_BYTE_LENGTH
                    minimum_codepoint <- REQUEST_UTF8_THREE_BYTE_MIN_CODEPOINT
                    codepoint <- first & REQUEST_UTF8_FIRST_THREE_MASK
                if first >= REQUEST_UTF8_FOUR_BYTE_START and first <= REQUEST_UTF8_FOUR_BYTE_END:
                    sequence_length <- REQUEST_UTF8_FOUR_BYTE_LENGTH
                    minimum_codepoint <- REQUEST_UTF8_FOUR_BYTE_MIN_CODEPOINT
                    codepoint <- first & REQUEST_UTF8_FIRST_FOUR_MASK
                if first >= REQUEST_UTF8_CONTINUATION_MIN and sequence_length == 1:
                    return false
                return false if sequence_length > path.length - index
                for offset in 1..<sequence_length:
                    continuation: u64 = path.bytes[index + offset].u64()
                    return false if continuation < REQUEST_UTF8_CONTINUATION_MIN or continuation > REQUEST_UTF8_CONTINUATION_MAX
                    codepoint <- (codepoint << REQUEST_UTF8_SHIFT) | (continuation & REQUEST_UTF8_CONTINUATION_MASK)
                return false if codepoint < minimum_codepoint or codepoint > REQUEST_UNICODE_MAX_CODEPOINT
                return false if codepoint >= REQUEST_UNICODE_SURROGATE_LOW_START and codepoint <= REQUEST_UNICODE_SURROGATE_LOW_END
                index <- index + sequence_length
            return true

        def request_hex_digit(byte: u8) -> ParsedOperandNumber:
            return ParsedOperandNumber{valid: true, value: (byte - ASCII_ZERO).u64(), end: 0} if byte >= ASCII_ZERO and byte <= ASCII_NINE
            return ParsedOperandNumber{valid: true, value: (byte - ASCII_A).u64() + REQUEST_JSON_HEX_LETTER_OFFSET, end: 0} if byte >= ASCII_A and byte <= ASCII_F
            return ParsedOperandNumber{valid: true, value: (byte - ASCII_UPPER_A).u64() + REQUEST_JSON_HEX_LETTER_OFFSET, end: 0} if byte >= ASCII_UPPER_A and byte <= ASCII_UPPER_F
            return invalid_operand_number()

        def request_parse_unicode_quad(payload: u8&, length: usize, start: usize) -> ParsedOperandNumber:
            return invalid_operand_number() if start > length or length - start < REQUEST_UNICODE_ESCAPE_DIGITS
            value: mutable u64 = 0
            for offset in 0..<REQUEST_UNICODE_ESCAPE_DIGITS:
                digit: ParsedOperandNumber = request_hex_digit(payload[start + offset])
                return invalid_operand_number() if not digit.valid
                value <- value * REQUEST_JSON_HEX_BASE + digit.value
            return ParsedOperandNumber{valid: true, value: value, end: start + REQUEST_UNICODE_ESCAPE_DIGITS}

        def request_program_path_string_parse(payload: u8&, length: usize, start: usize) -> ProgramPath:
            path: mutable ProgramPath = zeroed
            path.valid <- true
            return invalid_program_path() if start >= length or payload[start] != ASCII_QUOTE
            index: mutable usize = start + 1
            while index < length:
                byte: u8 = payload[index]
                if byte == ASCII_QUOTE:
                    return invalid_program_path() if path.length == 0 or not request_program_path_utf8_is_valid(path)
                    return path
                if byte == ASCII_BACKSLASH:
                    return invalid_program_path() if index + 1 >= length
                    escaped: u8 = payload[index + 1]
                    if escaped == ASCII_QUOTE or escaped == ASCII_BACKSLASH or escaped == ASCII_SLASH:
                        path.valid <- request_program_path_append(path, escaped)
                        return invalid_program_path() if not path.valid
                        index <- index + 2
                        continue
                    if escaped == ASCII_U:
                        high: ParsedOperandNumber = request_parse_unicode_quad(payload, length, index + 2)
                        return invalid_program_path() if not high.valid
                        codepoint: mutable u64 = high.value
                        index <- high.end
                        if high.value >= REQUEST_UNICODE_SURROGATE_HIGH_START and high.value <= REQUEST_UNICODE_SURROGATE_HIGH_END:
                            return invalid_program_path() if index + 1 >= length or payload[index] != ASCII_BACKSLASH or payload[index + 1] != ASCII_U
                            low: ParsedOperandNumber = request_parse_unicode_quad(payload, length, index + 2)
                            return invalid_program_path() if not low.valid or low.value < REQUEST_UNICODE_SURROGATE_LOW_START or low.value > REQUEST_UNICODE_SURROGATE_LOW_END
                            codepoint <- REQUEST_UNICODE_SURROGATE_BASE + ((high.value - REQUEST_UNICODE_HIGH_SURROGATE_OFFSET) << REQUEST_UNICODE_SURROGATE_SHIFT) + (low.value - REQUEST_UNICODE_LOW_SURROGATE_OFFSET)
                            index <- low.end
                        else:
                            return invalid_program_path() if high.value >= REQUEST_UNICODE_SURROGATE_LOW_START and high.value <= REQUEST_UNICODE_SURROGATE_LOW_END
                        path.valid <- request_program_path_append_codepoint(path, codepoint)
                        return invalid_program_path() if not path.valid
                        continue
                    return invalid_program_path() if escaped == ASCII_B or escaped == ASCII_F or escaped == ASCII_N or escaped == ASCII_R or escaped == ASCII_T
                    return invalid_program_path()
                return invalid_program_path() if byte < ASCII_SPACE or byte.u64() == REQUEST_ASCII_DELETE
                path.valid <- request_program_path_append(path, byte)
                return invalid_program_path() if not path.valid
                index <- index + 1
            return invalid_program_path()

        def request_arguments_operands_parse(payload: u8&, length: usize, arguments: usize, method: RequestMethod, operands: mutable RequestOperands&) -> bool:
            return false if arguments >= length or payload[arguments] != ASCII_BRACE_OPEN
            program: usize = request_object_field_value_start(payload, length, arguments, "program", 0)
            return false if request_object_field_value_start(payload, length, arguments, "program", 1) != JSON_NO_INDEX
            if program != JSON_NO_INDEX:
                parsed: ProgramPath = request_program_path_string_parse(payload, length, program)
                return false if not parsed.valid
                operands.program <- parsed
                operands.has_program <- true
            variables_reference_start: usize = request_object_field_value_start(payload, length, arguments, "variablesReference", 0)
            return false if request_object_field_value_start(payload, length, arguments, "variablesReference", 1) != JSON_NO_INDEX
            if variables_reference_start != JSON_NO_INDEX:
                variables_reference: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, variables_reference_start, MAX_REQUEST_INTEGER, true)
                return false if not variables_reference.valid
                operands.variables_reference <- variables_reference.value
                operands.has_variables_reference <- true
            return false if method == RequestMethod.Variables and not operands.has_variables_reference
            return true

        def request_pagination_operands_parse(payload: u8&, length: usize, root_start: usize, operands: mutable RequestOperands&) -> bool:
            page_size_start: usize = request_object_field_value_start(payload, length, root_start, "pageSize", 0)
            return false if request_object_field_value_start(payload, length, root_start, "pageSize", 1) != JSON_NO_INDEX
            if page_size_start != JSON_NO_INDEX:
                page_size: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, page_size_start, REQUEST_PAGE_SIZE_MAX, false)
                return false if not page_size.valid
                operands.page_size <- page_size.value
                operands.has_page_size <- true
            page_start_start: usize = request_object_field_value_start(payload, length, root_start, "pageStart", 0)
            return false if request_object_field_value_start(payload, length, root_start, "pageStart", 1) != JSON_NO_INDEX
            if page_start_start != JSON_NO_INDEX:
                page_start: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, page_start_start, REQUEST_PAGE_START_MAX, true)
                return false if not page_start.valid
                operands.page_start <- page_start.value
                operands.has_page_start <- true
            return true

        # The headless initialize request must negotiate the wire version
        # before clients issue session operations. Versions are JSON integers
        # bounded to the protocol's u32 representation.
        def request_initialization_version_parse(payload: u8&, length: usize, root_start: usize, method: RequestMethod, operands: mutable RequestOperands&) -> bool:
            return true if method != RequestMethod.Initialize
            major_start: usize = request_object_field_value_start(payload, length, root_start, "protocolMajor", 0)
            minor_start: usize = request_object_field_value_start(payload, length, root_start, "protocolMinor", 0)
            return false if major_start == JSON_NO_INDEX or minor_start == JSON_NO_INDEX
            return false if request_object_field_value_start(payload, length, root_start, "protocolMajor", 1) != JSON_NO_INDEX or request_object_field_value_start(payload, length, root_start, "protocolMinor", 1) != JSON_NO_INDEX
            major: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, major_start, REQUEST_PROTOCOL_VERSION_MAX, false)
            minor: ParsedOperandNumber = request_parse_bounded_unsigned(payload, length, minor_start, REQUEST_PROTOCOL_VERSION_MAX, false)
            return false if not major.valid or not minor.valid
            operands.protocol_major <- major.value
            operands.has_protocol_major <- true
            operands.protocol_minor <- minor.value
            operands.has_protocol_minor <- true
            return true

    public:
        def request_has_object_shape(payload: u8&, length: usize) -> bool:
            return false if length < 2
            first: mutable usize = 0
            while first < length and (payload[first] == ASCII_SPACE or payload[first] == ASCII_TAB or payload[first] == ASCII_LINE_FEED or payload[first] == ASCII_CARRIAGE_RETURN):
                first <- first + 1
            return false if first >= length or payload[first] != ASCII_BRACE_OPEN
            last: mutable usize = length
            while last > first + 1 and (payload[last - 1] == ASCII_SPACE or payload[last - 1] == ASCII_TAB or payload[last - 1] == ASCII_LINE_FEED or payload[last - 1] == ASCII_CARRIAGE_RETURN):
                last <- last - 1
            return false if last <= first + 1 or payload[last - 1] != ASCII_BRACE_CLOSE
            nesting: mutable u8[JSON_NESTING_CAPACITY] = zeroed
            states: mutable u8[JSON_NESTING_CAPACITY] = zeroed
            nesting_count: mutable usize = 0
            root_state: mutable u8 = JSON_STATE_VALUE
            index: mutable usize = first
            while index < last:
                while index < last and is_json_whitespace(payload[index]):
                    index <- index + 1
                continue if index >= last
                if nesting_count == 0:
                    return false if root_state == JSON_STATE_ROOT_DONE
                    if payload[index] == ASCII_BRACE_OPEN or payload[index] == ASCII_BRACKET_OPEN:
                        return false if nesting_count >= JSON_NESTING_CAPACITY
                        nesting[nesting_count] <- payload[index]
                        states[nesting_count] <- JSON_STATE_KEY_OR_END if payload[index] == ASCII_BRACE_OPEN else JSON_STATE_VALUE_OR_END
                        nesting_count <- nesting_count + 1
                        index <- index + 1
                    else:
                        value_end: usize = json_value_end(payload, last, index)
                        return false if value_end == JSON_NO_INDEX
                        root_state <- JSON_STATE_ROOT_DONE
                        index <- value_end
                else:
                    state: u8 = states[nesting_count - 1]
                    container: u8 = nesting[nesting_count - 1]
                    if state == JSON_STATE_KEY_OR_END or state == JSON_STATE_KEY_REQUIRED:
                        return false if container != ASCII_BRACE_OPEN
                        if payload[index] == ASCII_BRACE_CLOSE:
                            return false if state == JSON_STATE_KEY_REQUIRED
                            nesting_count <- nesting_count - 1
                            root_state <- JSON_STATE_ROOT_DONE if nesting_count == 0
                            states[nesting_count - 1] <- JSON_STATE_COMMA_OR_END if nesting_count > 0
                            index <- index + 1
                        else:
                            return false if payload[index] != ASCII_QUOTE
                            key_end: usize = json_string_end(payload, last, index)
                            return false if key_end == JSON_NO_INDEX
                            states[nesting_count - 1] <- JSON_STATE_COLON
                            index <- key_end
                    else:
                        if state == JSON_STATE_COLON:
                            return false if payload[index] != ASCII_COLON
                            states[nesting_count - 1] <- JSON_STATE_VALUE
                            index <- index + 1
                        else:
                            if state == JSON_STATE_VALUE_OR_END and payload[index] == ASCII_BRACKET_CLOSE:
                                nesting_count <- nesting_count - 1
                                root_state <- JSON_STATE_ROOT_DONE if nesting_count == 0
                                states[nesting_count - 1] <- JSON_STATE_COMMA_OR_END if nesting_count > 0
                                index <- index + 1
                            else:
                                if state == JSON_STATE_COMMA_OR_END:
                                    if (container == ASCII_BRACE_OPEN and payload[index] == ASCII_BRACE_CLOSE) or (container == ASCII_BRACKET_OPEN and payload[index] == ASCII_BRACKET_CLOSE):
                                        nesting_count <- nesting_count - 1
                                        root_state <- JSON_STATE_ROOT_DONE if nesting_count == 0
                                        states[nesting_count - 1] <- JSON_STATE_COMMA_OR_END if nesting_count > 0
                                        index <- index + 1
                                    else:
                                        return false if payload[index] != ASCII_COMMA
                                        states[nesting_count - 1] <- JSON_STATE_KEY_REQUIRED if container == ASCII_BRACE_OPEN else JSON_STATE_VALUE
                                        index <- index + 1
                                else:
                                    if payload[index] == ASCII_BRACE_OPEN or payload[index] == ASCII_BRACKET_OPEN:
                                        return false if nesting_count >= JSON_NESTING_CAPACITY
                                        nesting[nesting_count] <- payload[index]
                                        states[nesting_count] <- JSON_STATE_KEY_OR_END if payload[index] == ASCII_BRACE_OPEN else JSON_STATE_VALUE_OR_END
                                        nesting_count <- nesting_count + 1
                                        index <- index + 1
                                    else:
                                        value_end: usize = json_value_end(payload, last, index)
                                        return false if value_end == JSON_NO_INDEX
                                        states[nesting_count - 1] <- JSON_STATE_COMMA_OR_END
                                        index <- value_end
            return root_state == JSON_STATE_ROOT_DONE and nesting_count == 0

        def request_parse(payload: u8&, length: usize) -> Request:
            request: mutable Request = zeroed
            request.method <- RequestMethod.Unknown
            request.valid <- false
            return invalid_request() if not request_has_object_shape(payload, length)
            return invalid_request() if not request_top_level_fields_are_valid(payload, length)
            prefix: mutable u8[REQUEST_METHOD_PREFIX_LENGTH] = [ASCII_QUOTE, ASCII_M, ASCII_E, ASCII_T, ASCII_H, ASCII_O, ASCII_D, ASCII_QUOTE, ASCII_COLON, ASCII_QUOTE]
            prefix_position: mutable usize = 0
            in_method: mutable bool = false
            method_field_seen: mutable bool = false
            method_hash: mutable u64 = 0
            method_length: mutable usize = 0
            method_value_start: mutable usize = 0
            method_value_escaped: mutable bool = false
            id_prefix: mutable u8[REQUEST_ID_PREFIX_LENGTH] = [ASCII_QUOTE, ASCII_I, ASCII_D, ASCII_QUOTE, ASCII_COLON]
            id_position: mutable usize = 0
            in_id: mutable bool = false
            id_field_seen: mutable bool = false
            id_digits: mutable usize = 0
            id_quoted: mutable bool = false
            expected_prefix: mutable u8[REQUEST_EXPECTED_PREFIX_LENGTH] = [34, 101, 120, 112, 101, 99, 116, 101, 100, 83, 116, 111, 112, 71, 101, 110, 101, 114, 97, 116, 105, 111, 110, 34, 58]
            expected_position: mutable usize = 0
            in_expected: mutable bool = false
            expected_field_seen: mutable bool = false
            expected_has_digits: mutable bool = false
            expected_digits: mutable usize = 0
            expected_quoted: mutable bool = false
            target_prefix: mutable u8[REQUEST_TARGET_PREFIX_LENGTH] = [34, 116, 97, 114, 103, 101, 116, 69, 118, 101, 110, 116, 34, 58]
            target_position: mutable usize = 0
            in_target: mutable bool = false
            target_field_seen: mutable bool = false
            target_has_digits: mutable bool = false
            target_digits: mutable usize = 0
            target_quoted: mutable bool = false
            for index in 0..<length:
                byte: u8 = payload[index]
                if not in_method:
                    if byte == prefix[prefix_position] and (prefix_position != 0 or not json_byte_is_escaped(payload, index)):
                        prefix_position <- prefix_position + 1
                        if prefix_position == REQUEST_METHOD_PREFIX_LENGTH:
                            return invalid_request() if method_field_seen
                            in_method <- true
                            method_field_seen <- true
                            prefix_position <- 0
                            method_value_start <- index + 1
                            method_value_escaped <- false
                    else:
                        if not (is_json_whitespace(byte) and (prefix_position == REQUEST_METHOD_PREFIX_LENGTH - 2 or prefix_position == REQUEST_METHOD_PREFIX_LENGTH - 1)):
                            if byte == prefix[0] and not json_byte_is_escaped(payload, index):
                                prefix_position <- 1
                            else:
                                prefix_position <- 0
                else:
                    if method_value_escaped:
                        method_value_escaped <- false
                    else:
                        if byte == ASCII_BACKSLASH:
                            method_value_escaped <- true
                        else:
                            if byte == ASCII_QUOTE:
                                candidate: RequestMethod = request_method_from_hash(method_hash)
                                request.method <- request_method_from_json_value(payload, method_value_start, index, candidate)
                                request.valid <- request.method != RequestMethod.Unknown
                                in_method <- false
                    if in_method:
                        method_hash <- request_hash_byte(method_hash, byte)
                        method_length <- method_length + 1
                        return invalid_request() if method_length > REQUEST_MAX_METHOD_LENGTH
                if not in_id:
                    if byte == id_prefix[id_position] and (id_position != 0 or not json_byte_is_escaped(payload, index)):
                        id_position <- id_position + 1
                        if id_position == REQUEST_ID_PREFIX_LENGTH:
                            return invalid_request() if id_field_seen
                            in_id <- true
                            id_field_seen <- true
                            id_position <- 0
                            id_digits <- 0
                            id_quoted <- false
                            request.id <- 0
                    else:
                        if not (is_json_whitespace(byte) and id_position == REQUEST_ID_PREFIX_LENGTH - 1):
                            if byte == id_prefix[0] and not json_byte_is_escaped(payload, index):
                                id_position <- 1
                            else:
                                id_position <- 0
                else:
                    if id_quoted:
                        if byte == ASCII_QUOTE:
                            return invalid_request() if id_digits == 0
                            id_quoted <- false
                            in_id <- false
                        else:
                            return invalid_request() if byte < ASCII_ZERO or byte > ASCII_NINE
                            return invalid_request() if id_digits == FIRST_NUMBER_DIGIT_COUNT and request.id == 0
                            return invalid_request() if id_digits >= REQUEST_MAX_ID_DIGITS or request.id > (MAX_REQUEST_INTEGER - (byte - ASCII_ZERO).u64()) / DECIMAL_BASE
                            if id_digits < REQUEST_MAX_ID_DIGITS:
                                request.id <- request.id * DECIMAL_BASE + (byte - ASCII_ZERO).u64()
                                id_digits <- id_digits + 1
                                request.has_id <- true
                    else:
                        if is_json_whitespace(byte) and id_digits == 0:
                            id_digits <- 0
                        else:
                            if byte == ASCII_QUOTE and id_digits == 0:
                                id_quoted <- true
                            else:
                                if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                                    return invalid_request() if id_digits == FIRST_NUMBER_DIGIT_COUNT and request.id == 0
                                    return invalid_request() if id_digits >= REQUEST_MAX_ID_DIGITS or request.id > (MAX_REQUEST_INTEGER - (byte - ASCII_ZERO).u64()) / DECIMAL_BASE
                                    if id_digits < REQUEST_MAX_ID_DIGITS:
                                        request.id <- request.id * DECIMAL_BASE + (byte - ASCII_ZERO).u64()
                                        id_digits <- id_digits + 1
                                        request.has_id <- true
                                else:
                                    return invalid_request() if not is_numeric_terminator(byte)
                                    in_id <- false
                if not in_expected:
                    if byte == expected_prefix[expected_position] and (expected_position != 0 or not json_byte_is_escaped(payload, index)):
                        expected_position <- expected_position + 1
                        if expected_position == REQUEST_EXPECTED_PREFIX_LENGTH:
                            return invalid_request() if expected_field_seen
                            in_expected <- true
                            expected_field_seen <- true
                            expected_position <- 0
                            expected_digits <- 0
                            expected_quoted <- false
                    else:
                        if not (is_json_whitespace(byte) and (expected_position == REQUEST_EXPECTED_PREFIX_LENGTH - 1 or expected_position == REQUEST_EXPECTED_PREFIX_LENGTH - 2)):
                            if byte == expected_prefix[0] and not json_byte_is_escaped(payload, index):
                                expected_position <- 1
                            else:
                                expected_position <- 0
                else:
                    if expected_quoted:
                        if byte == ASCII_QUOTE:
                            return invalid_request() if not expected_has_digits
                            expected_quoted <- false
                            in_expected <- false
                        else:
                            return invalid_request() if byte < ASCII_ZERO or byte > ASCII_NINE
                            return invalid_request() if expected_digits >= FIRST_NUMBER_DIGIT_COUNT and request.expected_generation == 0
                            return invalid_request() if expected_digits >= REQUEST_MAX_GENERATION_DIGITS or request.expected_generation > (MAX_REQUEST_INTEGER - (byte - ASCII_ZERO).u64()) / DECIMAL_BASE
                            if expected_digits < REQUEST_MAX_GENERATION_DIGITS:
                                request.expected_generation <- request.expected_generation * DECIMAL_BASE + (byte - ASCII_ZERO).u64()
                                expected_digits <- expected_digits + 1
                                expected_has_digits <- true
                    else:
                        if is_json_whitespace(byte) and not expected_has_digits:
                            expected_has_digits <- false
                        else:
                            if byte == ASCII_QUOTE and not expected_has_digits:
                                expected_quoted <- true
                            else:
                                if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                                    return invalid_request() if expected_digits >= FIRST_NUMBER_DIGIT_COUNT and request.expected_generation == 0
                                    return invalid_request() if expected_digits >= REQUEST_MAX_GENERATION_DIGITS or request.expected_generation > (MAX_REQUEST_INTEGER - (byte - ASCII_ZERO).u64()) / DECIMAL_BASE
                                    if expected_digits < REQUEST_MAX_GENERATION_DIGITS:
                                        request.expected_generation <- request.expected_generation * DECIMAL_BASE + (byte - ASCII_ZERO).u64()
                                        expected_digits <- expected_digits + 1
                                        expected_has_digits <- true
                                else:
                                    return invalid_request() if not is_numeric_terminator(byte)
                                    in_expected <- false
                if not in_target:
                    if byte == target_prefix[target_position] and (target_position != 0 or not json_byte_is_escaped(payload, index)):
                        target_position <- target_position + 1
                        if target_position == REQUEST_TARGET_PREFIX_LENGTH:
                            return invalid_request() if target_field_seen
                            in_target <- true
                            target_field_seen <- true
                            target_position <- 0
                            target_digits <- 0
                            target_quoted <- false
                    else:
                        if not (is_json_whitespace(byte) and (target_position == REQUEST_TARGET_PREFIX_LENGTH - 1 or target_position == REQUEST_TARGET_PREFIX_LENGTH - 2)):
                            if byte == target_prefix[0] and not json_byte_is_escaped(payload, index):
                                target_position <- 1
                            else:
                                target_position <- 0
                else:
                    if target_quoted:
                        if byte == ASCII_QUOTE:
                            return invalid_request() if not target_has_digits
                            target_quoted <- false
                            in_target <- false
                        else:
                            return invalid_request() if byte < ASCII_ZERO or byte > ASCII_NINE
                            return invalid_request() if target_digits >= FIRST_NUMBER_DIGIT_COUNT and request.target_event == 0
                            return invalid_request() if target_digits >= REQUEST_MAX_GENERATION_DIGITS or request.target_event > (MAX_REQUEST_INTEGER - (byte - ASCII_ZERO).u64()) / DECIMAL_BASE
                            if target_digits < REQUEST_MAX_GENERATION_DIGITS:
                                request.target_event <- request.target_event * DECIMAL_BASE + (byte - ASCII_ZERO).u64()
                                target_digits <- target_digits + 1
                                target_has_digits <- true
                    else:
                        if is_json_whitespace(byte) and not target_has_digits:
                            target_has_digits <- false
                        else:
                            if byte == ASCII_QUOTE and not target_has_digits:
                                target_quoted <- true
                            else:
                                if byte >= ASCII_ZERO and byte <= ASCII_NINE:
                                    return invalid_request() if target_digits >= FIRST_NUMBER_DIGIT_COUNT and request.target_event == 0
                                    return invalid_request() if target_digits >= REQUEST_MAX_GENERATION_DIGITS or request.target_event > (MAX_REQUEST_INTEGER - (byte - ASCII_ZERO).u64()) / DECIMAL_BASE
                                    if target_digits < REQUEST_MAX_GENERATION_DIGITS:
                                        request.target_event <- request.target_event * DECIMAL_BASE + (byte - ASCII_ZERO).u64()
                                        target_digits <- target_digits + 1
                                        target_has_digits <- true
                                else:
                                    return invalid_request() if not is_numeric_terminator(byte)
                                    in_target <- false
            return invalid_request() if in_method or in_id or in_expected or in_target
            return invalid_request() if id_field_seen and (not request.has_id or request.id == REQUEST_NO_ID)
            return invalid_request() if request.method != RequestMethod.Discover and not request.has_id
            return invalid_request() if expected_field_seen and not expected_has_digits
            return invalid_request() if target_field_seen and not target_has_digits
            return request

        # Parse the ordinary protocol envelope's launch and pagination
        # operands. Launch requires one arguments.program path; other methods
        # may omit it. Paths are decoded as bounded UTF-8 filesystem paths.
        def request_operands_parse(payload: u8&, length: usize) -> RequestOperands:
            operands: mutable RequestOperands = zeroed
            operands.program <- invalid_program_path()
            request: Request = request_parse(payload, length)
            return operands if not request.valid
            root_start: mutable usize = 0
            while root_start < length and is_json_whitespace(payload[root_start]):
                root_start <- root_start + 1
            arguments: usize = request_object_field_value_start(payload, length, root_start, "arguments", 0)
            return operands if request_object_field_value_start(payload, length, root_start, "arguments", 1) != JSON_NO_INDEX
            if arguments != JSON_NO_INDEX:
                return operands if not request_arguments_operands_parse(payload, length, arguments, request.method, operands)
            return operands if request.method == RequestMethod.Launch and not operands.has_program
            return operands if request.method == RequestMethod.Variables and not operands.has_variables_reference
            return operands if not request_initialization_version_parse(payload, length, root_start, request.method, operands)
            return operands if not request_pagination_operands_parse(payload, length, root_start, operands)
            operands.valid <- true
            return operands
