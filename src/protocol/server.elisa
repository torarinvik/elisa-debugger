include "./framing.elisa"
include "./request.elisa"
include "../core/session.elisa"
include "../core/capabilities.elisa"
include "../core/identity.elisa"
include "./dispatcher.elisa"
include "./encoding.elisa"
include "../engine/default_image.elisa"
include "./managed_service.elisa"

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern printf(format: cstr, ...) -> int can[Console]
extern puts(text: cstr) -> int can[Console]

module DebuggerProtocolServer:
    private:
        const STDIN_FD: int = 0
        const READ_CHUNK_SIZE: usize = 4096
        const FALLBACK_RESPONSE_ID: u64 = 1
        const SERVER_SUCCESS_EXIT_CODE: i64 = 0
        const SERVER_INVALID_FRAME_EXIT_CODE: i64 = 2
        const DECIMAL_BASE: u64 = 10
        const RESPONSE_BODY_PREFIX_LENGTH: usize = 25
        const RESPONSE_ID_PREFIX: cstr = "{\"kind\":\"response\",\"id\":\""
        const RESPONSE_UNSUPPORTED_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"UNSUPPORTED\",\"message\":\"method is not implemented\"}}"
        const RESPONSE_UNSUPPORTED_SUFFIX_LENGTH: usize = 82
        const RESPONSE_SUCCESS_SUFFIX: cstr = "\",\"ok\":true,\"result\":{\"accepted\":true}}"
        const RESPONSE_SUCCESS_SUFFIX_LENGTH: usize = 39
        const RESPONSE_INVALID_STATE_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"INVALID_STATE\",\"message\":\"session state does not allow this operation\"}}"
        const RESPONSE_INVALID_STATE_SUFFIX_LENGTH: usize = 102
        const RESPONSE_INVALID_ARGUMENT_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"INVALID_ARGUMENT\",\"message\":\"request is invalid\"}}"
        const RESPONSE_INVALID_ARGUMENT_SUFFIX_LENGTH: usize = 80
        const RESPONSE_STALE_GENERATION_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"STALE_GENERATION\",\"message\":\"request stop generation is stale\"}}"
        const RESPONSE_STALE_GENERATION_SUFFIX_LENGTH: usize = 94
        const RESPONSE_UNAVAILABLE_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"UNAVAILABLE\",\"message\":\"operation is unavailable for this session\"}}"
        const RESPONSE_UNAVAILABLE_SUFFIX_LENGTH: usize = 98
        const RESPONSE_RESULT_UNAVAILABLE_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"UNAVAILABLE\",\"message\":\"method result is not available on this endpoint\"}}"
        const RESPONSE_RESULT_UNAVAILABLE_SUFFIX_LENGTH: usize = 104
        const RESPONSE_CANCELLED_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"CANCELLED\",\"message\":\"operation was cancelled\"}}"
        const RESPONSE_CANCELLED_SUFFIX_LENGTH: usize = 78
        const RESPONSE_DIVERGED_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"DIVERGED\",\"message\":\"replay diverged from the recorded trace\"}}"
        const RESPONSE_DIVERGED_SUFFIX_LENGTH: usize = 93
        const RESPONSE_CORRUPT_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"CORRUPT\",\"message\":\"trace data is corrupt\"}}"
        const RESPONSE_CORRUPT_SUFFIX_LENGTH: usize = 74
        const RESPONSE_RESOURCE_LIMIT_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"RESOURCE_LIMIT\",\"message\":\"resource limit exceeded\"}}"
        const RESPONSE_RESOURCE_LIMIT_SUFFIX_LENGTH: usize = 83
        const RESPONSE_PERMISSION_DENIED_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"PERMISSION_DENIED\",\"message\":\"permission denied\"}}"
        const RESPONSE_PERMISSION_DENIED_SUFFIX_LENGTH: usize = 80
        const RESPONSE_TRANSPORT_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"TRANSPORT\",\"message\":\"transport failure\"}}"
        const RESPONSE_TRANSPORT_SUFFIX_LENGTH: usize = 72
        const RESPONSE_INTERNAL_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"INTERNAL\",\"message\":\"internal debugger failure\"}}"
        const RESPONSE_INTERNAL_SUFFIX_LENGTH: usize = 79

        def decimal_digits(value: u64) -> usize:
            count: mutable usize = 1
            remaining: mutable u64 = value
            while remaining >= DECIMAL_BASE:
                remaining <- remaining / DECIMAL_BASE
                count <- count + 1
            return count

        def write_dynamic_response(id: u64, suffix: cstr, suffix_length: usize) -> void can[Console, Unsafe.PointerCast]:
            body_length: u64 = (RESPONSE_BODY_PREFIX_LENGTH + decimal_digits(id) + suffix_length).u64()
            _ = printf("%llu ", body_length) can Console
            _ = printf(RESPONSE_ID_PREFIX) can Console
            _ = printf("%llu", id) can Console
            _ = printf(suffix) can Console
            _ = printf("\n") can Console

        def write_json_buffer_response(buffer: DebuggerProtocolEncoding::JsonBuffer) -> void can[Console]:
            return if not DebuggerProtocolEncoding::json_buffer_is_valid(buffer)
            _ = printf("%llu", buffer.length.u64()) can Console
            _ = printf(" ") can Console
            for index in 0..<buffer.length:
                _ = printf("%c", buffer.bytes[index].i32()) can Console
            _ = printf("\n") can Console

        def server_capabilities(engine_capabilities: DebuggerCapabilities::CapabilitySet) -> DebuggerCapabilities::CapabilitySet:
            wire: mutable DebuggerCapabilities::CapabilitySet = engine_capabilities
            # This compact endpoint does not carry source breakpoint operands
            # or inspection/trace result payloads, so do not expose those
            # engine-level features as usable over this wire surface.
            wire.source_breakpoints <- false
            wire.typed_values <- false
            wire.historical_queries <- false
            wire.trace_export <- false
            return wire

        def write_discovery_response(id: u64, capabilities: DebuggerCapabilities::CapabilitySet) -> void can[Console]:
            encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::discovery_response_encode(id, capabilities)
            write_json_buffer_response(encoded) can Console

        def write_unsupported_response(id: u64) -> void can[Console, Unsafe.PointerCast]:
            write_dynamic_response(id, RESPONSE_UNSUPPORTED_SUFFIX, RESPONSE_UNSUPPORTED_SUFFIX_LENGTH) can Console, Unsafe.PointerCast

        def write_success_response(id: u64) -> void can[Console, Unsafe.PointerCast]:
            write_dynamic_response(id, RESPONSE_SUCCESS_SUFFIX, RESPONSE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast

        def write_invalid_state_response(id: u64) -> void can[Console, Unsafe.PointerCast]:
            write_dynamic_response(id, RESPONSE_INVALID_STATE_SUFFIX, RESPONSE_INVALID_STATE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast

        def response_requires_missing_payload(method: DebuggerProtocolRequest::RequestMethod) -> bool:
            return true if method == DebuggerProtocolRequest::RequestMethod.Threads or method == DebuggerProtocolRequest::RequestMethod.Stack or method == DebuggerProtocolRequest::RequestMethod.Scopes or method == DebuggerProtocolRequest::RequestMethod.Variables or method == DebuggerProtocolRequest::RequestMethod.Evaluate or method == DebuggerProtocolRequest::RequestMethod.Memory
            return false

        def write_response(result: DebuggerProtocolDispatcher::DispatchResult, id: u64, capabilities: DebuggerCapabilities::CapabilitySet) -> void can[Console, Unsafe.PointerCast]:
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.Discover:
                write_discovery_response(id, capabilities) can Console
                return
            if result.accepted and response_requires_missing_payload(result.method):
                write_dynamic_response(id, RESPONSE_RESULT_UNAVAILABLE_SUFFIX, RESPONSE_RESULT_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.accepted:
                write_success_response(id) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Unsupported:
                write_unsupported_response(id) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                write_dynamic_response(id, RESPONSE_INVALID_ARGUMENT_SUFFIX, RESPONSE_INVALID_ARGUMENT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.StaleGeneration:
                write_dynamic_response(id, RESPONSE_STALE_GENERATION_SUFFIX, RESPONSE_STALE_GENERATION_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Unavailable:
                write_dynamic_response(id, RESPONSE_UNAVAILABLE_SUFFIX, RESPONSE_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Cancelled:
                write_dynamic_response(id, RESPONSE_CANCELLED_SUFFIX, RESPONSE_CANCELLED_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Diverged:
                write_dynamic_response(id, RESPONSE_DIVERGED_SUFFIX, RESPONSE_DIVERGED_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Corrupt:
                write_dynamic_response(id, RESPONSE_CORRUPT_SUFFIX, RESPONSE_CORRUPT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.ResourceLimit:
                write_dynamic_response(id, RESPONSE_RESOURCE_LIMIT_SUFFIX, RESPONSE_RESOURCE_LIMIT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.PermissionDenied:
                write_dynamic_response(id, RESPONSE_PERMISSION_DENIED_SUFFIX, RESPONSE_PERMISSION_DENIED_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Transport:
                write_dynamic_response(id, RESPONSE_TRANSPORT_SUFFIX, RESPONSE_TRANSPORT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Internal:
                write_dynamic_response(id, RESPONSE_INTERNAL_SUFFIX, RESPONSE_INTERNAL_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            write_invalid_state_response(id) can Console, Unsafe.PointerCast
            return

        def dispatch_request(service: mutable DebuggerManagedService::Service&, request: DebuggerProtocolRequest::Request) -> DebuggerProtocolDispatcher::DispatchResult:
            if request.method == DebuggerProtocolRequest::RequestMethod.Initialize or request.method == DebuggerProtocolRequest::RequestMethod.CreateSession or request.method == DebuggerProtocolRequest::RequestMethod.OpenTrace or request.method == DebuggerProtocolRequest::RequestMethod.Launch or request.method == DebuggerProtocolRequest::RequestMethod.Replay or request.method == DebuggerProtocolRequest::RequestMethod.Pause or request.method == DebuggerProtocolRequest::RequestMethod.Continue or request.method == DebuggerProtocolRequest::RequestMethod.Step or request.method == DebuggerProtocolRequest::RequestMethod.ReverseStep or request.method == DebuggerProtocolRequest::RequestMethod.Seek or request.method == DebuggerProtocolRequest::RequestMethod.Threads or request.method == DebuggerProtocolRequest::RequestMethod.Stack or request.method == DebuggerProtocolRequest::RequestMethod.Scopes or request.method == DebuggerProtocolRequest::RequestMethod.Variables or request.method == DebuggerProtocolRequest::RequestMethod.Evaluate or request.method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints or request.method == DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints or request.method == DebuggerProtocolRequest::RequestMethod.Checkpoint or request.method == DebuggerProtocolRequest::RequestMethod.Branch or request.method == DebuggerProtocolRequest::RequestMethod.Compare or request.method == DebuggerProtocolRequest::RequestMethod.TraceVerify or request.method == DebuggerProtocolRequest::RequestMethod.TraceExport or request.method == DebuggerProtocolRequest::RequestMethod.Detach or request.method == DebuggerProtocolRequest::RequestMethod.Terminate or request.method == DebuggerProtocolRequest::RequestMethod.Close or request.method == DebuggerProtocolRequest::RequestMethod.Memory:
                result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}
            result: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(service.controller.session, request, 0)
            service.controller.session <- result.session
            return result

    public:
        def run_protocol_server() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            decoder: mutable DebuggerProtocolFraming::FrameDecoder = DebuggerProtocolFraming::frame_decoder_new()
            chunk: mutable u8[READ_CHUNK_SIZE] = zeroed
            build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
                compiler: DebuggerIdentity::debug_id(1),
                runtime: DebuggerIdentity::debug_id(2),
                source: DebuggerIdentity::debug_id(3),
                target: DebuggerIdentity::debug_id(4),
                metadata_version: 1
            }
            session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
            service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, DebuggerDefaultImage::image_new(), DebuggerIdentity::debug_id(1))
            while true:
                count: isize = read(STDIN_FD, (&chunk[0]).cast[void&], READ_CHUNK_SIZE) can Console
                break if count <= 0
                for index in 0..<count.usize():
                    completed: bool = DebuggerProtocolFraming::frame_decoder_accept(decoder, chunk[index])
                    if completed:
                        request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(decoder.payload[0], DebuggerProtocolFraming::frame_decoder_length(decoder))
                        return SERVER_INVALID_FRAME_EXIT_CODE if not request.valid and not request.has_id
                        result: mutable DebuggerProtocolDispatcher::DispatchResult = dispatch_request(service, request)
                        session <- result.session
                        response_id: u64 = request.id if request.has_id else FALLBACK_RESPONSE_ID
                        write_response(result, response_id, server_capabilities(service.controller.session.capabilities)) can Console, Unsafe.PointerCast
                        DebuggerProtocolFraming::frame_decoder_reset(decoder)
                    return SERVER_INVALID_FRAME_EXIT_CODE if DebuggerProtocolFraming::frame_decoder_is_failed(decoder)
            return SERVER_INVALID_FRAME_EXIT_CODE if decoder.state != DebuggerProtocolFraming::FrameDecoderState.Header or decoder.header_digits != 0
            return SERVER_SUCCESS_EXIT_CODE

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return DebuggerProtocolServer::run_protocol_server()
