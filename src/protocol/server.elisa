include "./framing.elisa"
include "./request.elisa"
include "../core/session.elisa"
include "../core/capabilities.elisa"
include "../core/identity.elisa"
include "./dispatcher.elisa"
include "./encoding.elisa"
include "../engine/default_image.elisa"
include "./managed_service.elisa"
include "../vm/edir_file.elisa"
include "../inspect/managed.elisa"

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern printf(format: cstr, ...) -> int can[Console]
extern puts(text: cstr) -> int can[Console]
extern fflush(stream: mutable void&?) -> int can[Console]

module DebuggerProtocolServer:
    private:

        const module ErrorDetail:
            DETAIL_INVALID_LAUNCH_CONFIGURATION: u32 = 4
            DETAIL_STALE_VARIABLE_REFERENCE: u32 = 5
            DETAIL_INVALID_LAUNCH_STATE: u32 = 6
            DETAIL_STALE_LAUNCH_GENERATION: u32 = 7
            PROTOCOL_SERVER_ERROR_DETAIL_INVALID_SOURCE_BREAKPOINTS: u32 = 8
            PROTOCOL_SERVER_ERROR_DETAIL_STALE_SOURCE_BREAKPOINT_GENERATION: u32 = 9
            PROTOCOL_SERVER_ERROR_DETAIL_UNKNOWN_SOURCE_PATH: u32 = 10
            PROTOCOL_SERVER_ERROR_DETAIL_CORRUPT_SOURCE_TABLE: u32 = 11
            PROTOCOL_SERVER_ERROR_DETAIL_OWNER_TOKEN: u32 = 12

        const module InitializationState:
            INITIALIZE_NOT_REQUESTED: u8 = 0
            INITIALIZE_COMPATIBLE: u8 = 1
            INITIALIZE_INVALID_REQUEST: u8 = 2
            INITIALIZE_INCOMPATIBLE_MAJOR: u8 = 3
            INITIALIZE_REQUIRED_FOR_SESSION: u8 = 4

        const module NumberFormat:
            PROTOCOL_SERVER_NUMBER_FORMAT_DECIMAL_BASE: u64 = 10

        const module RequestDefaults:
            FALLBACK_RESPONSE_ID: u64 = 1
            PROTOCOL_SERVER_REQUEST_DEFAULTS_NO_EXPECTED_GENERATION: u64 = 0
            PROTOCOL_SERVER_REQUEST_DEFAULTS_DEFAULT_PAGE_SIZE: u64 = 0
            DEFAULT_PAGE_START: u64 = 0
            PROTOCOL_SERVER_NO_SOURCE_FILE_ID: u64 = 0

        const module ResponseEncoding:
            RESPONSE_BODY_PREFIX_LENGTH: usize = 25
            RESPONSE_ID_PREFIX: cstr = "{\"kind\":\"response\",\"id\":\""
            RESPONSE_UNSUPPORTED_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"UNSUPPORTED\",\"message\":\"method is not implemented\"}}"
            RESPONSE_UNSUPPORTED_SUFFIX_LENGTH: usize = 82
            RESPONSE_SUCCESS_SUFFIX: cstr = "\",\"ok\":true,\"result\":{\"accepted\":true}}"
            RESPONSE_SUCCESS_SUFFIX_LENGTH: usize = 39
            RESPONSE_INVALID_STATE_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"INVALID_STATE\",\"message\":\"session state does not allow this operation\"}}"
            RESPONSE_INVALID_STATE_SUFFIX_LENGTH: usize = 102
            RESPONSE_INVALID_ARGUMENT_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"INVALID_ARGUMENT\",\"message\":\"request is invalid\"}}"
            RESPONSE_INVALID_ARGUMENT_SUFFIX_LENGTH: usize = 80
            RESPONSE_STALE_GENERATION_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"STALE_GENERATION\",\"message\":\"request stop generation is stale\"}}"
            RESPONSE_STALE_GENERATION_SUFFIX_LENGTH: usize = 94
            RESPONSE_UNAVAILABLE_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"UNAVAILABLE\",\"message\":\"operation is unavailable for this session\"}}"
            RESPONSE_UNAVAILABLE_SUFFIX_LENGTH: usize = 98
            RESPONSE_RESULT_UNAVAILABLE_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"UNAVAILABLE\",\"message\":\"method result is not available on this endpoint\"}}"
            RESPONSE_RESULT_UNAVAILABLE_SUFFIX_LENGTH: usize = 104
            RESPONSE_CANCELLED_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"CANCELLED\",\"message\":\"operation was cancelled\"}}"
            RESPONSE_CANCELLED_SUFFIX_LENGTH: usize = 78
            RESPONSE_DIVERGED_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"DIVERGED\",\"message\":\"replay diverged from the recorded trace\"}}"
            RESPONSE_DIVERGED_SUFFIX_LENGTH: usize = 93
            RESPONSE_CORRUPT_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"CORRUPT\",\"message\":\"trace data is corrupt\"}}"
            RESPONSE_CORRUPT_SUFFIX_LENGTH: usize = 74
            RESPONSE_RESOURCE_LIMIT_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"RESOURCE_LIMIT\",\"message\":\"resource limit exceeded\"}}"
            RESPONSE_RESOURCE_LIMIT_SUFFIX_LENGTH: usize = 83
            RESPONSE_PERMISSION_DENIED_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"PERMISSION_DENIED\",\"message\":\"permission denied\"}}"
            RESPONSE_PERMISSION_DENIED_SUFFIX_LENGTH: usize = 80
            RESPONSE_TRANSPORT_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"TRANSPORT\",\"message\":\"transport failure\"}}"
            RESPONSE_TRANSPORT_SUFFIX_LENGTH: usize = 72
            RESPONSE_INTERNAL_SUFFIX: cstr = "\",\"ok\":false,\"error\":{\"code\":\"INTERNAL\",\"message\":\"internal debugger failure\"}}"
            RESPONSE_INTERNAL_SUFFIX_LENGTH: usize = 79

        const module ServerProcess:
            PROTOCOL_SERVER_PROCESS_STDIN_FD: int = 0
            READ_CHUNK_SIZE: usize = 4096
            SERVER_SUCCESS_EXIT_CODE: i64 = 0
            SERVER_INVALID_FRAME_EXIT_CODE: i64 = 2

        const module Ownership:
            SESSION_ID: u64 = 1
            OWNER_TOKEN: u64 = 1

        struct InitializationResponse:
            status: mutable u8
            requested_major: mutable u64
            requested_minor: mutable u64

        struct SourceBreakpointDispatch:
            dispatch: mutable DebuggerProtocolDispatcher::DispatchResult
            payload: mutable DebuggerManagedService::SourceBreakpointResult

        def decimal_digits(value: u64) -> usize:
            count: mutable usize = 1
            remaining: mutable u64 = value
            while remaining >= NumberFormat::PROTOCOL_SERVER_NUMBER_FORMAT_DECIMAL_BASE:
                remaining <- remaining / NumberFormat::PROTOCOL_SERVER_NUMBER_FORMAT_DECIMAL_BASE
                count <- count + 1
            return count

        def write_dynamic_response(id: u64, suffix: cstr, suffix_length: usize) -> void can[Console, Unsafe.PointerCast]:
            body_length: u64 = (ResponseEncoding::RESPONSE_BODY_PREFIX_LENGTH + decimal_digits(id) + suffix_length).u64()
            _ = printf("%llu ", body_length) can Console
            _ = printf(ResponseEncoding::RESPONSE_ID_PREFIX) can Console
            _ = printf("%llu", id) can Console
            _ = printf(suffix) can Console
            _ = printf("\n") can Console

        def write_json_buffer_response(buffer: DebuggerProtocolEncoding::JsonBuffer) -> void can[Console]:
            return if not DebuggerProtocolEncoding::json_buffer_is_valid(buffer)
            _ = printf("%llu", buffer.length.u64()) can Console
            _ = printf(" ") can Console
            for index in 0..<buffer.length:
                _ = printf("%c", buffer.bytes[index].i32()) can Console
            _ = printf("\n") can Console

        def server_capabilities(engine_capabilities: DebuggerCapabilities::CapabilitySet) -> DebuggerCapabilities::CapabilitySet:
            wire: mutable DebuggerCapabilities::CapabilitySet = engine_capabilities
            # Source breakpoints now have a bounded path/line request and
            # structured result on this wire. Keep other capabilities hidden
            # when their operands or result payloads are not transported.
            wire.checkpoints <- false
            wire.branches <- false
            wire.trace_verification <- false
            wire.historical_queries <- false
            wire.memory_read <- false
            wire.trace_export <- false
            return wire

        def write_discovery_response(id: u64, capabilities: DebuggerCapabilities::CapabilitySet) -> void can[Console]:
            encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::discovery_response_encode(id, capabilities)
            write_json_buffer_response(encoded) can Console

        def write_unsupported_response(id: u64) -> void can[Console, Unsafe.PointerCast]:
            write_dynamic_response(id, ResponseEncoding::RESPONSE_UNSUPPORTED_SUFFIX, ResponseEncoding::RESPONSE_UNSUPPORTED_SUFFIX_LENGTH) can Console, Unsafe.PointerCast

        def write_success_response(id: u64) -> void can[Console, Unsafe.PointerCast]:
            write_dynamic_response(id, ResponseEncoding::RESPONSE_SUCCESS_SUFFIX, ResponseEncoding::RESPONSE_SUCCESS_SUFFIX_LENGTH) can Console, Unsafe.PointerCast

        def write_invalid_state_response(id: u64) -> void can[Console, Unsafe.PointerCast]:
            write_dynamic_response(id, ResponseEncoding::RESPONSE_INVALID_STATE_SUFFIX, ResponseEncoding::RESPONSE_INVALID_STATE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast

        def response_requires_missing_payload(method: DebuggerProtocolRequest::RequestMethod) -> bool:
            return true if method == DebuggerProtocolRequest::RequestMethod.Evaluate or method == DebuggerProtocolRequest::RequestMethod.Memory
            return false

        def request_requires_session(method: DebuggerProtocolRequest::RequestMethod) -> bool:
            return false if method == DebuggerProtocolRequest::RequestMethod.Discover or method == DebuggerProtocolRequest::RequestMethod.Initialize or method == DebuggerProtocolRequest::RequestMethod.CreateSession
            return true

        def request_requires_owner(method: DebuggerProtocolRequest::RequestMethod) -> bool:
            return true if method == DebuggerProtocolRequest::RequestMethod.Launch or method == DebuggerProtocolRequest::RequestMethod.OpenTrace or method == DebuggerProtocolRequest::RequestMethod.Replay or method == DebuggerProtocolRequest::RequestMethod.Attach or method == DebuggerProtocolRequest::RequestMethod.Pause or method == DebuggerProtocolRequest::RequestMethod.Continue or method == DebuggerProtocolRequest::RequestMethod.Step or method == DebuggerProtocolRequest::RequestMethod.ReverseStep or method == DebuggerProtocolRequest::RequestMethod.ReverseStepOver or method == DebuggerProtocolRequest::RequestMethod.ReverseStepOut or method == DebuggerProtocolRequest::RequestMethod.Seek or method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints or method == DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints or method == DebuggerProtocolRequest::RequestMethod.Checkpoint or method == DebuggerProtocolRequest::RequestMethod.Branch or method == DebuggerProtocolRequest::RequestMethod.Detach or method == DebuggerProtocolRequest::RequestMethod.Terminate or method == DebuggerProtocolRequest::RequestMethod.Close or method == DebuggerProtocolRequest::RequestMethod.Cancel
            return false

        def ownership_validation(request: DebuggerProtocolRequest::Request, operands: DebuggerProtocolRequest::RequestOperands, session: DebuggerSession::Session, owner_active: bool, owner_token: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::no_error() if not owner_active or not request_requires_session(request.method)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.PermissionDenied, false, ErrorDetail::PROTOCOL_SERVER_ERROR_DETAIL_OWNER_TOKEN) if not operands.has_session_id or operands.session_id != session.id.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.PermissionDenied, false, ErrorDetail::PROTOCOL_SERVER_ERROR_DETAIL_OWNER_TOKEN) if request_requires_owner(request.method) and (not operands.has_owner_token or operands.owner_token != owner_token)
            return DebuggerErrors::no_error()

        def write_response(service: DebuggerManagedService::Service, result: DebuggerProtocolDispatcher::DispatchResult, id: u64, capabilities: DebuggerCapabilities::CapabilitySet, page_size: u64, page_start: u64, initialization: InitializationResponse, source_breakpoints: DebuggerManagedService::SourceBreakpointResult, owner_token: u64) -> void can[Console, Unsafe.PointerCast]:
            if initialization.status == InitializationState::INITIALIZE_COMPATIBLE:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::initialize_response_encode(id, initialization.requested_minor)
                write_json_buffer_response(encoded) can Console
                return
            if initialization.status == InitializationState::INITIALIZE_INVALID_REQUEST:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::initialize_arguments_error_encode(id)
                write_json_buffer_response(encoded) can Console
                return
            if initialization.status == InitializationState::INITIALIZE_INCOMPATIBLE_MAJOR:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::initialize_version_error_encode(id, initialization.requested_major)
                write_json_buffer_response(encoded) can Console
                return
            if initialization.status == InitializationState::INITIALIZE_REQUIRED_FOR_SESSION:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::initialize_required_error_encode(id)
                write_json_buffer_response(encoded) can Console
                return
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.Discover:
                write_discovery_response(id, capabilities) can Console
                return
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.CreateSession:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::create_session_response_encode(id, service.controller.session.id.value, owner_token, result.stop_generation)
                write_json_buffer_response(encoded) can Console
                return
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.Threads:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_threads_response_encode(id, result.stop_generation)
                write_json_buffer_response(encoded) can Console
                return
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.Stack:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_frame_response_encode(id, result.stop_generation, DebuggerManagedService::service_frame(service))
                write_json_buffer_response(encoded) can Console
                return
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.Scopes:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_scopes_response_encode(id, result.stop_generation, service.controller.engine.image.program.local_count)
                write_json_buffer_response(encoded) can Console
                return
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.Variables:
                local_count: u64 = service.controller.engine.image.program.local_count
                safe_page_start: usize = local_count.usize() if page_start > local_count else page_start.usize()
                locals: DebuggerManagedInspection::LocalPage = DebuggerManagedService::service_locals(service, safe_page_start, page_size.usize())
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_locals_response_encode(id, result.stop_generation, result.session.position.event, locals)
                write_json_buffer_response(encoded) can Console
                return
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_source_breakpoints_response_encode(id, result.stop_generation, source_breakpoints)
                write_json_buffer_response(encoded) can Console
                return
            if result.accepted and result.method == DebuggerProtocolRequest::RequestMethod.Timeline:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_timeline_response_encode(id, result.stop_generation, DebuggerManagedService::service_timeline(service), DebuggerManagedService::service_has_checkpoint(service), DebuggerManagedService::service_last_checkpoint_event(service), DebuggerManagedService::service_last_checkpoint_hash(service))
                write_json_buffer_response(encoded) can Console
                return
            if result.accepted and response_requires_missing_payload(result.method):
                write_dynamic_response(id, ResponseEncoding::RESPONSE_RESULT_UNAVAILABLE_SUFFIX, ResponseEncoding::RESPONSE_RESULT_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.accepted:
                encoded: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::response_encode(DebuggerProtocol::response_ok(id, result.stop_generation))
                write_json_buffer_response(encoded) can Console
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Unsupported:
                write_unsupported_response(id) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.InvalidArgument:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_INVALID_ARGUMENT_SUFFIX, ResponseEncoding::RESPONSE_INVALID_ARGUMENT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.StaleGeneration:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_STALE_GENERATION_SUFFIX, ResponseEncoding::RESPONSE_STALE_GENERATION_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Unavailable:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_UNAVAILABLE_SUFFIX, ResponseEncoding::RESPONSE_UNAVAILABLE_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Cancelled:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_CANCELLED_SUFFIX, ResponseEncoding::RESPONSE_CANCELLED_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Diverged:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_DIVERGED_SUFFIX, ResponseEncoding::RESPONSE_DIVERGED_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Corrupt:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_CORRUPT_SUFFIX, ResponseEncoding::RESPONSE_CORRUPT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.ResourceLimit:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_RESOURCE_LIMIT_SUFFIX, ResponseEncoding::RESPONSE_RESOURCE_LIMIT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.PermissionDenied:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_PERMISSION_DENIED_SUFFIX, ResponseEncoding::RESPONSE_PERMISSION_DENIED_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Transport:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_TRANSPORT_SUFFIX, ResponseEncoding::RESPONSE_TRANSPORT_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            if result.failure.code == DebuggerErrors::ErrorCode.Internal:
                write_dynamic_response(id, ResponseEncoding::RESPONSE_INTERNAL_SUFFIX, ResponseEncoding::RESPONSE_INTERNAL_SUFFIX_LENGTH) can Console, Unsafe.PointerCast
                return
            write_invalid_state_response(id) can Console, Unsafe.PointerCast
            return

        def dispatch_request(service: mutable DebuggerManagedService::Service&, request: DebuggerProtocolRequest::Request) -> DebuggerProtocolDispatcher::DispatchResult:
            if request.method == DebuggerProtocolRequest::RequestMethod.ReverseStepOver or request.method == DebuggerProtocolRequest::RequestMethod.ReverseStepOut:
                result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}
            if request.method == DebuggerProtocolRequest::RequestMethod.Initialize or request.method == DebuggerProtocolRequest::RequestMethod.CreateSession or request.method == DebuggerProtocolRequest::RequestMethod.OpenTrace or request.method == DebuggerProtocolRequest::RequestMethod.Launch or request.method == DebuggerProtocolRequest::RequestMethod.Replay or request.method == DebuggerProtocolRequest::RequestMethod.Pause or request.method == DebuggerProtocolRequest::RequestMethod.Continue or request.method == DebuggerProtocolRequest::RequestMethod.Step or request.method == DebuggerProtocolRequest::RequestMethod.ReverseStep or request.method == DebuggerProtocolRequest::RequestMethod.Seek or request.method == DebuggerProtocolRequest::RequestMethod.Timeline or request.method == DebuggerProtocolRequest::RequestMethod.Threads or request.method == DebuggerProtocolRequest::RequestMethod.Stack or request.method == DebuggerProtocolRequest::RequestMethod.Scopes or request.method == DebuggerProtocolRequest::RequestMethod.Variables or request.method == DebuggerProtocolRequest::RequestMethod.Evaluate or request.method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints or request.method == DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints or request.method == DebuggerProtocolRequest::RequestMethod.Checkpoint or request.method == DebuggerProtocolRequest::RequestMethod.Branch or request.method == DebuggerProtocolRequest::RequestMethod.Compare or request.method == DebuggerProtocolRequest::RequestMethod.TraceVerify or request.method == DebuggerProtocolRequest::RequestMethod.TraceExport or request.method == DebuggerProtocolRequest::RequestMethod.Detach or request.method == DebuggerProtocolRequest::RequestMethod.Terminate or request.method == DebuggerProtocolRequest::RequestMethod.Close or request.method == DebuggerProtocolRequest::RequestMethod.Memory:
                result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: result.accepted, stop_generation: service.controller.session.stop_generation, failure: result.failure}
            result: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(service.controller.session, request, 0)
            service.controller.session <- result.session
            return result

        def dispatch_launch(service: mutable DebuggerManagedService::Service&, request: DebuggerProtocolRequest::Request, operands: DebuggerProtocolRequest::RequestOperands) -> DebuggerProtocolDispatcher::DispatchResult can[Blocking.IO, Unsafe.PointerCast]:
            if not operands.valid or not operands.has_program:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_INVALID_LAUNCH_CONFIGURATION)
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: false, stop_generation: service.controller.session.stop_generation, failure: failure}
            session: DebuggerSession::Session = service.controller.session
            if request.expected_generation != RequestDefaults::PROTOCOL_SERVER_REQUEST_DEFAULTS_NO_EXPECTED_GENERATION and request.expected_generation != session.stop_generation:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, ErrorDetail::DETAIL_STALE_LAUNCH_GENERATION)
                return DebuggerProtocolDispatcher::dispatch_error(session, request.method, failure)
            launchable: bool = session.state == DebuggerSession::SessionState.Created or session.state == DebuggerSession::SessionState.Configuring or session.state == DebuggerSession::SessionState.Launching
            if not launchable:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_INVALID_LAUNCH_STATE)
                return DebuggerProtocolDispatcher::dispatch_error(session, request.method, failure)
            loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(operands.program.bytes[0], operands.program.length) can Blocking.IO, Unsafe.PointerCast
            if not loaded.valid:
                return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: false, stop_generation: service.controller.session.stop_generation, failure: loaded.failure}
            recording: DebuggerIdentity::DebugId = service.controller.engine.recording
            candidate: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, loaded.image, recording)
            result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(candidate, request)
            if not result.accepted:
                return DebuggerProtocolDispatcher::dispatch_error(session, request.method, result.failure)
            service <- candidate
            return DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: true, stop_generation: service.controller.session.stop_generation, failure: DebuggerErrors::no_error()}

        def source_breakpoint_dispatch_error(service: DebuggerManagedService::Service, request: DebuggerProtocolRequest::Request, code: DebuggerErrors::ErrorCode, detail: u32) -> SourceBreakpointDispatch:
            failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(code, code == DebuggerErrors::ErrorCode.Unavailable, detail)
            dispatch: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, failure)
            return SourceBreakpointDispatch{dispatch: dispatch, payload: zeroed}

        def dispatch_source_breakpoints(service: mutable DebuggerManagedService::Service&, request: DebuggerProtocolRequest::Request, operands: DebuggerProtocolRequest::RequestOperands) -> SourceBreakpointDispatch:
            return source_breakpoint_dispatch_error(service, request, DebuggerErrors::ErrorCode.InvalidArgument, ErrorDetail::PROTOCOL_SERVER_ERROR_DETAIL_INVALID_SOURCE_BREAKPOINTS) if not operands.source_breakpoints.valid or not operands.source_breakpoints.has_source_path or not operands.source_breakpoints.has_breakpoints
            if operands.has_expected_generation and request.expected_generation != service.controller.session.stop_generation:
                return source_breakpoint_dispatch_error(service, request, DebuggerErrors::ErrorCode.StaleGeneration, ErrorDetail::PROTOCOL_SERVER_ERROR_DETAIL_STALE_SOURCE_BREAKPOINT_GENERATION)
            image: DebuggerEDIR::ProgramImage = service.controller.engine.image
            return source_breakpoint_dispatch_error(service, request, DebuggerErrors::ErrorCode.Corrupt, ErrorDetail::PROTOCOL_SERVER_ERROR_DETAIL_CORRUPT_SOURCE_TABLE) if image.source_file_count > DebuggerEDIR::source_file_capacity()
            source: mutable DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(RequestDefaults::PROTOCOL_SERVER_NO_SOURCE_FILE_ID)
            for file_index in 0..<image.source_file_count:
                file: DebuggerMetadata::SourceFile = image.source_files[file_index]
                continue if file.path_length != operands.source_breakpoints.source_path.length
                path_matches: mutable bool = true
                for path_index in 0..<file.path_length:
                    path_matches <- false if file.path_bytes[path_index] != operands.source_breakpoints.source_path.bytes[path_index]
                if path_matches:
                    source <- file.id
                    break
            return source_breakpoint_dispatch_error(service, request, DebuggerErrors::ErrorCode.InvalidArgument, ErrorDetail::PROTOCOL_SERVER_ERROR_DETAIL_UNKNOWN_SOURCE_PATH) if source.value == RequestDefaults::PROTOCOL_SERVER_NO_SOURCE_FILE_ID
            replacement: DebuggerManagedService::SourceBreakpointResult = DebuggerManagedService::service_replace_source_breakpoints(service, source, operands.source_breakpoints.lines[0], operands.source_breakpoints.count)
            dispatch: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::DispatchResult{session: service.controller.session, method: request.method, accepted: replacement.accepted, stop_generation: service.controller.session.stop_generation, failure: replacement.failure}
            return SourceBreakpointDispatch{dispatch: dispatch, payload: replacement}

    public:
        def run_protocol_server() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            decoder: mutable DebuggerProtocolFraming::FrameDecoder = DebuggerProtocolFraming::frame_decoder_new()
            chunk: mutable u8[ServerProcess::READ_CHUNK_SIZE] = zeroed
            build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
                compiler: DebuggerIdentity::debug_id(1),
                runtime: DebuggerIdentity::debug_id(2),
                source: DebuggerIdentity::debug_id(3),
                target: DebuggerIdentity::debug_id(4),
                metadata_version: 1
            }
            session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Ownership::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
            session.capabilities <- server_capabilities(session.capabilities)
            service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, DebuggerDefaultImage::image_new(), DebuggerIdentity::debug_id(Ownership::SESSION_ID))
            protocol_initialized: mutable bool = false
            ownership_active: mutable bool = false
            owner_token: mutable u64 = 0
            while true:
                count: isize = read(ServerProcess::PROTOCOL_SERVER_PROCESS_STDIN_FD, (&chunk[0]).cast[void&], ServerProcess::READ_CHUNK_SIZE) can Console
                break if count <= 0
                for index in 0..<count.usize():
                    completed: bool = DebuggerProtocolFraming::frame_decoder_accept(decoder, chunk[index])
                    if completed:
                        request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(decoder.payload[0], DebuggerProtocolFraming::frame_decoder_length(decoder))
                        return ServerProcess::SERVER_INVALID_FRAME_EXIT_CODE if not request.valid and not request.has_id
                        operands: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(decoder.payload[0], DebuggerProtocolFraming::frame_decoder_length(decoder))
                        result: mutable DebuggerProtocolDispatcher::DispatchResult = zeroed
                        initialization: mutable InitializationResponse = zeroed
                        source_breakpoint_payload: mutable DebuggerManagedService::SourceBreakpointResult = zeroed
                        if request.valid and request.method == DebuggerProtocolRequest::RequestMethod.Initialize:
                            if not operands.valid or not operands.has_protocol_major or not operands.has_protocol_minor:
                                initialization.status <- InitializationState::INITIALIZE_INVALID_REQUEST
                                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_INVALID_LAUNCH_CONFIGURATION)
                                result <- DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, failure)
                            else:
                                server_protocol: DebuggerProtocol::ProtocolVersion = DebuggerProtocol::protocol_version()
                                if operands.protocol_major != server_protocol.major.u64():
                                    initialization.status <- InitializationState::INITIALIZE_INCOMPATIBLE_MAJOR
                                    initialization.requested_major <- operands.protocol_major
                                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, ErrorDetail::DETAIL_INVALID_LAUNCH_CONFIGURATION)
                                    result <- DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, failure)
                                else:
                                    initialization.status <- InitializationState::INITIALIZE_COMPATIBLE
                                    initialization.requested_minor <- operands.protocol_minor
                                    result <- dispatch_request(service, request)
                                    protocol_initialized <- true if result.accepted
                        else:
                            if request.valid and request.method != DebuggerProtocolRequest::RequestMethod.Discover and not protocol_initialized:
                                initialization.status <- InitializationState::INITIALIZE_REQUIRED_FOR_SESSION
                                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, ErrorDetail::DETAIL_INVALID_LAUNCH_STATE)
                                result <- DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, failure)
                            else:
                                if not operands.valid:
                                    failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_INVALID_LAUNCH_CONFIGURATION)
                                    result <- DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, failure)
                                else:
                                    ownership_failure: DebuggerErrors::DebuggerError = ownership_validation(request, operands, service.controller.session, ownership_active, owner_token)
                                    if not DebuggerErrors::error_is_ok(ownership_failure):
                                        result <- DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, ownership_failure)
                                    else:
                                        if request.valid and request.method == DebuggerProtocolRequest::RequestMethod.Launch:
                                            result <- dispatch_launch(service, request, operands) can Blocking.IO, Unsafe.PointerCast
                                        else:
                                            if request.valid and request.method == DebuggerProtocolRequest::RequestMethod.SetBreakpoints:
                                                replacement: SourceBreakpointDispatch = dispatch_source_breakpoints(service, request, operands)
                                                result <- replacement.dispatch
                                                source_breakpoint_payload <- replacement.payload
                                            else:
                                                if request.valid and request.method == DebuggerProtocolRequest::RequestMethod.Variables and operands.variables_reference != service.controller.session.stop_generation:
                                                    stale_reference: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, ErrorDetail::DETAIL_STALE_VARIABLE_REFERENCE)
                                                    result <- DebuggerProtocolDispatcher::dispatch_error(service.controller.session, request.method, stale_reference)
                                                else:
                                                    result <- dispatch_request(service, request)
                                    # createSession is intentionally opt-in for
                                    # compatibility with older compact clients.
                                    # Once accepted, subsequent requests carry a
                                    # process-scoped owner token and session ID.
                                    if request.valid and request.method == DebuggerProtocolRequest::RequestMethod.CreateSession and result.accepted:
                                        ownership_active <- true
                                        owner_token <- Ownership::OWNER_TOKEN
                        session <- result.session
                        response_id: u64 = request.id if request.has_id else RequestDefaults::FALLBACK_RESPONSE_ID
                        page_size: u64 = operands.page_size if operands.has_page_size else RequestDefaults::PROTOCOL_SERVER_REQUEST_DEFAULTS_DEFAULT_PAGE_SIZE
                        page_start: u64 = operands.page_start if operands.has_page_start else RequestDefaults::DEFAULT_PAGE_START
                        write_response(service, result, response_id, server_capabilities(service.controller.session.capabilities), page_size, page_start, initialization, source_breakpoint_payload, owner_token) can Console, Unsafe.PointerCast
                        _ = fflush(null) can Console
                        DebuggerProtocolFraming::frame_decoder_reset(decoder)
                    return ServerProcess::SERVER_INVALID_FRAME_EXIT_CODE if DebuggerProtocolFraming::frame_decoder_is_failed(decoder)
            return ServerProcess::SERVER_INVALID_FRAME_EXIT_CODE if decoder.state != DebuggerProtocolFraming::FrameDecoderState.Header or decoder.header_digits != 0
            return ServerProcess::SERVER_SUCCESS_EXIT_CODE

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return DebuggerProtocolServer::run_protocol_server()
