# Editor-neutral service facade.  It is intentionally data-oriented so a DAP
# adapter, JetBrains bridge, CLI, or remote client can use the same semantics.

include "../core/session.elisa"
include "../core/errors.elisa"
include "../core/capabilities.elisa"
include "./messages.elisa"
include "./request.elisa"
include "./dispatcher.elisa"
include "./managed_service.elisa"
include "../engine/default_image.elisa"

module DebuggerSessionService:
    private:
        const NO_EXPECTED_STOP_GENERATION: u64 = 0
        const DETAIL_INVALID_MESSAGE_KIND: u32 = 1
        const DETAIL_SESSION_MISMATCH: u32 = 2
        const DETAIL_REQUEST_ID: u32 = 3
        const NO_SESSION_ID: u64 = 0
        const NO_REQUEST_ID: u64 = 0

    public:
        struct Service:
            session: mutable DebuggerSession::Session
            protocol: mutable DebuggerProtocol::ProtocolVersion

        def service_new(session: DebuggerSession::Session) -> Service:
            return Service{session: session, protocol: DebuggerProtocol::protocol_version()}

        def service_validate(service: Service, request: DebuggerProtocol::RequestEnvelope) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_REQUEST_ID) if request.request_id == NO_REQUEST_ID
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_SESSION_MISMATCH) if request.session_id != NO_SESSION_ID and request.session_id != service.session.id.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_INVALID_MESSAGE_KIND) if not DebuggerProtocol::message_kind_is_valid(request.kind) or request.kind != DebuggerProtocol::MessageKind.Request
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_INVALID_MESSAGE_KIND) if not DebuggerProtocol::method_is_valid(request.method)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, service.session.stop_generation.u32()) if request.expected_stop_generation != NO_EXPECTED_STOP_GENERATION and request.expected_stop_generation != service.session.stop_generation
            return DebuggerErrors::no_error()

        def service_response(service: Service, request: DebuggerProtocol::RequestEnvelope) -> DebuggerProtocol::ResponseEnvelope:
            failure: DebuggerErrors::DebuggerError = service_validate(service, request)
            return DebuggerProtocol::response_error(request.request_id, failure, service.session.stop_generation) if not DebuggerErrors::error_is_ok(failure)
            return DebuggerProtocol::response_ok(request.request_id, service.session.stop_generation)

        def request_method(method: DebuggerProtocol::Method) -> DebuggerProtocolRequest::RequestMethod:
            return DebuggerProtocolRequest::RequestMethod.Discover if method == DebuggerProtocol::Method.Discover
            return DebuggerProtocolRequest::RequestMethod.Initialize if method == DebuggerProtocol::Method.Initialize
            return DebuggerProtocolRequest::RequestMethod.CreateSession if method == DebuggerProtocol::Method.CreateSession
            return DebuggerProtocolRequest::RequestMethod.OpenTrace if method == DebuggerProtocol::Method.OpenTrace
            return DebuggerProtocolRequest::RequestMethod.Launch if method == DebuggerProtocol::Method.Launch
            return DebuggerProtocolRequest::RequestMethod.Attach if method == DebuggerProtocol::Method.Attach
            return DebuggerProtocolRequest::RequestMethod.Replay if method == DebuggerProtocol::Method.Replay
            return DebuggerProtocolRequest::RequestMethod.Pause if method == DebuggerProtocol::Method.Pause
            return DebuggerProtocolRequest::RequestMethod.Continue if method == DebuggerProtocol::Method.Continue
            return DebuggerProtocolRequest::RequestMethod.Step if method == DebuggerProtocol::Method.Step
            return DebuggerProtocolRequest::RequestMethod.ReverseStep if method == DebuggerProtocol::Method.ReverseStep
            return DebuggerProtocolRequest::RequestMethod.Seek if method == DebuggerProtocol::Method.Seek
            return DebuggerProtocolRequest::RequestMethod.Threads if method == DebuggerProtocol::Method.Threads
            return DebuggerProtocolRequest::RequestMethod.Stack if method == DebuggerProtocol::Method.Stack
            return DebuggerProtocolRequest::RequestMethod.Scopes if method == DebuggerProtocol::Method.Scopes
            return DebuggerProtocolRequest::RequestMethod.Variables if method == DebuggerProtocol::Method.Variables
            return DebuggerProtocolRequest::RequestMethod.Evaluate if method == DebuggerProtocol::Method.Evaluate
            return DebuggerProtocolRequest::RequestMethod.SetBreakpoints if method == DebuggerProtocol::Method.SetBreakpoints
            return DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints if method == DebuggerProtocol::Method.SetDataBreakpoints
            return DebuggerProtocolRequest::RequestMethod.Checkpoint if method == DebuggerProtocol::Method.Checkpoint
            return DebuggerProtocolRequest::RequestMethod.Branch if method == DebuggerProtocol::Method.Branch
            return DebuggerProtocolRequest::RequestMethod.Compare if method == DebuggerProtocol::Method.Compare
            return DebuggerProtocolRequest::RequestMethod.TraceVerify if method == DebuggerProtocol::Method.TraceVerify
            return DebuggerProtocolRequest::RequestMethod.TraceExport if method == DebuggerProtocol::Method.TraceExport
            return DebuggerProtocolRequest::RequestMethod.Detach if method == DebuggerProtocol::Method.Detach
            return DebuggerProtocolRequest::RequestMethod.Terminate if method == DebuggerProtocol::Method.Terminate
            return DebuggerProtocolRequest::RequestMethod.Close if method == DebuggerProtocol::Method.Close
            return DebuggerProtocolRequest::RequestMethod.Memory if method == DebuggerProtocol::Method.Memory
            return DebuggerProtocolRequest::RequestMethod.Cancel

        def service_handle(service: mutable Service&, request: DebuggerProtocol::RequestEnvelope) -> DebuggerProtocol::ResponseEnvelope:
            snapshot: Service = service
            validation: DebuggerErrors::DebuggerError = service_validate(snapshot, request)
            return DebuggerProtocol::response_error(request.request_id, validation, service.session.stop_generation) if not DebuggerErrors::error_is_ok(validation)
            typed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: request_method(request.method), id: request.request_id, has_id: true, expected_generation: request.expected_stop_generation, target_event: request.target_event, valid: true}
            result: mutable DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(service.session, typed, request.expected_stop_generation)
            result <- DebuggerProtocolDispatcher::dispatch_seek(service.session, typed, request.expected_stop_generation) if request.method == DebuggerProtocol::Method.Seek
            service.session <- result.session
            return DebuggerProtocol::response_ok(request.request_id, result.stop_generation) if result.accepted
            return DebuggerProtocol::response_error(request.request_id, result.failure, result.stop_generation)

        # Concrete managed-provider entrypoint. The lightweight Service above
        # remains useful for provider state-machine tests; this helper exposes
        # the same envelope contract while executing the EDIR engine.
        def managed_new(session: DebuggerSession::Session, recording: u64) -> DebuggerManagedService::Service:
            return DebuggerManagedService::service_new(session, DebuggerDefaultImage::image_new(), DebuggerIdentity::debug_id(recording))

        def service_handle_managed(service: mutable DebuggerManagedService::Service&, request: DebuggerProtocol::RequestEnvelope) -> DebuggerProtocol::ResponseEnvelope:
            session: DebuggerSession::Session = service.controller.session
            validation: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_REQUEST_ID) if request.request_id == NO_REQUEST_ID
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_SESSION_MISMATCH) if DebuggerErrors::error_is_ok(validation) and request.session_id != NO_SESSION_ID and request.session_id != session.id.value
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_INVALID_MESSAGE_KIND) if DebuggerErrors::error_is_ok(validation) and (not DebuggerProtocol::message_kind_is_valid(request.kind) or request.kind != DebuggerProtocol::MessageKind.Request)
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, DETAIL_INVALID_MESSAGE_KIND) if DebuggerErrors::error_is_ok(validation) and not DebuggerProtocol::method_is_valid(request.method)
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, session.stop_generation.u32()) if DebuggerErrors::error_is_ok(validation) and request.expected_stop_generation != NO_EXPECTED_STOP_GENERATION and request.expected_stop_generation != session.stop_generation
            return DebuggerProtocol::response_error(request.request_id, validation, session.stop_generation) if not DebuggerErrors::error_is_ok(validation)
            typed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: request_method(request.method), id: request.request_id, has_id: true, expected_generation: request.expected_stop_generation, target_event: request.target_event, valid: true}
            result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, typed)
            return DebuggerProtocol::response_ok(request.request_id, service.controller.session.stop_generation) if result.accepted
            return DebuggerProtocol::response_error(request.request_id, result.failure, service.controller.session.stop_generation)
