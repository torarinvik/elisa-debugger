# Editor-neutral service facade.  It is intentionally data-oriented so a DAP
# adapter, JetBrains bridge, CLI, or remote client can use the same semantics.

include "../core/session.elisa"
include "../core/errors.elisa"
include "../core/capabilities.elisa"
include "./messages.elisa"
include "./request.elisa"
include "./dispatcher.elisa"
include "./managed_service.elisa"
include "../engine/default_image.elisa"

module DebuggerSessionService:
    private:

        const module ErrorDetail:
            DETAIL_INVALID_MESSAGE_KIND: u32 = 1
            DETAIL_SESSION_MISMATCH: u32 = 2
            PROTOCOL_SESSION_SERVICE_ERROR_DETAIL_DETAIL_REQUEST_ID: u32 = 3
            PROTOCOL_SESSION_SERVICE_ERROR_DETAIL_DETAIL_STALE_GENERATION: u32 = 4

        const module ResponseIdentifiers:
            DISCOVERY_FALLBACK_RESPONSE_ID: u64 = 1

        const module SessionState:
            NO_EXPECTED_STOP_GENERATION: u64 = 0
            NO_SESSION_ID: u64 = 0
            PROTOCOL_SESSION_SERVICE_STATE_NO_REQUEST_ID: u64 = 0

        def response_id(request: DebuggerProtocol::RequestEnvelope) -> u64:
            return ResponseIdentifiers::DISCOVERY_FALLBACK_RESPONSE_ID if request.request_id == SessionState::PROTOCOL_SESSION_SERVICE_STATE_NO_REQUEST_ID and request.method == DebuggerProtocol::Method.Discover
            return request.request_id

    public:
        struct Service:
            session: mutable DebuggerSession::Session
            protocol: mutable DebuggerProtocol::ProtocolVersion

        def service_new(session: DebuggerSession::Session) -> Service:
            return Service{session: session, protocol: DebuggerProtocol::protocol_version()}

        def service_validate(service: Service, request: DebuggerProtocol::RequestEnvelope) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::PROTOCOL_SESSION_SERVICE_ERROR_DETAIL_DETAIL_REQUEST_ID) if request.request_id == SessionState::PROTOCOL_SESSION_SERVICE_STATE_NO_REQUEST_ID and request.method != DebuggerProtocol::Method.Discover
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_SESSION_MISMATCH) if request.session_id != SessionState::NO_SESSION_ID and request.session_id != service.session.id.value
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_INVALID_MESSAGE_KIND) if not DebuggerProtocol::message_kind_is_valid(request.kind) or request.kind != DebuggerProtocol::MessageKind.Request
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_INVALID_MESSAGE_KIND) if not DebuggerProtocol::method_is_valid(request.method)
            # RequestEnvelope has no target-request field, so cancellation must
            # use CancelRequest and cannot be dispatched through this facade.
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::PROTOCOL_SESSION_SERVICE_ERROR_DETAIL_DETAIL_REQUEST_ID) if request.method == DebuggerProtocol::Method.Cancel
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, ErrorDetail::PROTOCOL_SESSION_SERVICE_ERROR_DETAIL_DETAIL_STALE_GENERATION) if request.expected_stop_generation != SessionState::NO_EXPECTED_STOP_GENERATION and request.expected_stop_generation != service.session.stop_generation
            return DebuggerErrors::no_error()

        def service_response(service: Service, request: DebuggerProtocol::RequestEnvelope) -> DebuggerProtocol::ResponseEnvelope:
            failure: DebuggerErrors::DebuggerError = service_validate(service, request)
            return DebuggerProtocol::response_error(response_id(request), failure, service.session.stop_generation) if not DebuggerErrors::error_is_ok(failure)
            return DebuggerProtocol::response_ok(response_id(request), service.session.stop_generation)

        def request_method(method: DebuggerProtocol::Method) -> DebuggerProtocolRequest::RequestMethod:
            return DebuggerProtocolRequest::RequestMethod.Discover if method == DebuggerProtocol::Method.Discover
            return DebuggerProtocolRequest::RequestMethod.Initialize if method == DebuggerProtocol::Method.Initialize
            return DebuggerProtocolRequest::RequestMethod.CreateSession if method == DebuggerProtocol::Method.CreateSession
            return DebuggerProtocolRequest::RequestMethod.OpenTrace if method == DebuggerProtocol::Method.OpenTrace
            return DebuggerProtocolRequest::RequestMethod.Launch if method == DebuggerProtocol::Method.Launch
            return DebuggerProtocolRequest::RequestMethod.Attach if method == DebuggerProtocol::Method.Attach
            return DebuggerProtocolRequest::RequestMethod.Replay if method == DebuggerProtocol::Method.Replay
            return DebuggerProtocolRequest::RequestMethod.Pause if method == DebuggerProtocol::Method.Pause
            return DebuggerProtocolRequest::RequestMethod.Continue if method == DebuggerProtocol::Method.Continue
            return DebuggerProtocolRequest::RequestMethod.Step if method == DebuggerProtocol::Method.Step
            return DebuggerProtocolRequest::RequestMethod.ReverseStep if method == DebuggerProtocol::Method.ReverseStep
            return DebuggerProtocolRequest::RequestMethod.ReverseStepOver if method == DebuggerProtocol::Method.ReverseStepOver
            return DebuggerProtocolRequest::RequestMethod.ReverseStepOut if method == DebuggerProtocol::Method.ReverseStepOut
            return DebuggerProtocolRequest::RequestMethod.Seek if method == DebuggerProtocol::Method.Seek
            return DebuggerProtocolRequest::RequestMethod.Threads if method == DebuggerProtocol::Method.Threads
            return DebuggerProtocolRequest::RequestMethod.Stack if method == DebuggerProtocol::Method.Stack
            return DebuggerProtocolRequest::RequestMethod.Scopes if method == DebuggerProtocol::Method.Scopes
            return DebuggerProtocolRequest::RequestMethod.Variables if method == DebuggerProtocol::Method.Variables
            return DebuggerProtocolRequest::RequestMethod.Evaluate if method == DebuggerProtocol::Method.Evaluate
            return DebuggerProtocolRequest::RequestMethod.SetBreakpoints if method == DebuggerProtocol::Method.SetBreakpoints
            return DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints if method == DebuggerProtocol::Method.SetDataBreakpoints
            return DebuggerProtocolRequest::RequestMethod.Checkpoint if method == DebuggerProtocol::Method.Checkpoint
            return DebuggerProtocolRequest::RequestMethod.Branch if method == DebuggerProtocol::Method.Branch
            return DebuggerProtocolRequest::RequestMethod.Compare if method == DebuggerProtocol::Method.Compare
            return DebuggerProtocolRequest::RequestMethod.TraceVerify if method == DebuggerProtocol::Method.TraceVerify
            return DebuggerProtocolRequest::RequestMethod.TraceExport if method == DebuggerProtocol::Method.TraceExport
            return DebuggerProtocolRequest::RequestMethod.Detach if method == DebuggerProtocol::Method.Detach
            return DebuggerProtocolRequest::RequestMethod.Terminate if method == DebuggerProtocol::Method.Terminate
            return DebuggerProtocolRequest::RequestMethod.Close if method == DebuggerProtocol::Method.Close
            return DebuggerProtocolRequest::RequestMethod.Memory if method == DebuggerProtocol::Method.Memory
            return DebuggerProtocolRequest::RequestMethod.Timeline if method == DebuggerProtocol::Method.Timeline
            return DebuggerProtocolRequest::RequestMethod.Cancel

        def service_handle(service: mutable Service&, request: DebuggerProtocol::RequestEnvelope) -> DebuggerProtocol::ResponseEnvelope:
            snapshot: Service = service
            validation: DebuggerErrors::DebuggerError = service_validate(snapshot, request)
            return DebuggerProtocol::response_error(response_id(request), validation, service.session.stop_generation) if not DebuggerErrors::error_is_ok(validation)
            typed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: request_method(request.method), id: response_id(request), has_id: true, expected_generation: request.expected_stop_generation, target_event: request.target_event, valid: true}
            result: mutable DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(service.session, typed, request.expected_stop_generation)
            result <- DebuggerProtocolDispatcher::dispatch_seek(service.session, typed, request.expected_stop_generation) if request.method == DebuggerProtocol::Method.Seek
            service.session <- result.session
            return DebuggerProtocol::response_ok(response_id(request), result.stop_generation) if result.accepted
            return DebuggerProtocol::response_error(response_id(request), result.failure, result.stop_generation)

        # Concrete managed-provider entrypoint. The lightweight Service above
        # remains useful for provider state-machine tests; this helper exposes
        # the same envelope contract while executing the EDIR engine.
        def managed_new(session: DebuggerSession::Session, recording: u64) -> DebuggerManagedService::Service:
            return DebuggerManagedService::service_new(session, DebuggerDefaultImage::image_new(), DebuggerIdentity::debug_id(recording))

        def service_handle_managed(service: mutable DebuggerManagedService::Service&, request: DebuggerProtocol::RequestEnvelope) -> DebuggerProtocol::ResponseEnvelope:
            session: DebuggerSession::Session = service.controller.session
            validation: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::PROTOCOL_SESSION_SERVICE_ERROR_DETAIL_DETAIL_REQUEST_ID) if request.request_id == SessionState::PROTOCOL_SESSION_SERVICE_STATE_NO_REQUEST_ID and request.method != DebuggerProtocol::Method.Discover
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_SESSION_MISMATCH) if DebuggerErrors::error_is_ok(validation) and request.session_id != SessionState::NO_SESSION_ID and request.session_id != session.id.value
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_INVALID_MESSAGE_KIND) if DebuggerErrors::error_is_ok(validation) and (not DebuggerProtocol::message_kind_is_valid(request.kind) or request.kind != DebuggerProtocol::MessageKind.Request)
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, ErrorDetail::DETAIL_INVALID_MESSAGE_KIND) if DebuggerErrors::error_is_ok(validation) and not DebuggerProtocol::method_is_valid(request.method)
            validation <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.StaleGeneration, true, ErrorDetail::PROTOCOL_SESSION_SERVICE_ERROR_DETAIL_DETAIL_STALE_GENERATION) if DebuggerErrors::error_is_ok(validation) and request.expected_stop_generation != SessionState::NO_EXPECTED_STOP_GENERATION and request.expected_stop_generation != session.stop_generation
            return DebuggerProtocol::response_error(response_id(request), validation, session.stop_generation) if not DebuggerErrors::error_is_ok(validation)
            typed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: request_method(request.method), id: response_id(request), has_id: true, expected_generation: request.expected_stop_generation, target_event: request.target_event, valid: true}
            result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, typed)
            return DebuggerProtocol::response_ok(response_id(request), service.controller.session.stop_generation) if result.accepted
            return DebuggerProtocol::response_error(response_id(request), result.failure, service.controller.session.stop_generation)
