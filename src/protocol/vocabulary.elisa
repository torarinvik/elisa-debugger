# Stable wire vocabulary for editor-neutral transports.  Adapters can map
# typed Elisa enums to protocol names without importing a server or parsing
# human-facing diagnostics.

include "./messages.elisa"
include "../core/errors.elisa"

module DebuggerProtocolVocabulary:
    private:

        const module ProtocolVocabulary:
            UNKNOWN_NAME: cstr = "unknown"
            DISCOVER_NAME: cstr = "discover"
            INITIALIZE_NAME: cstr = "initialize"
            CREATE_SESSION_NAME: cstr = "createSession"
            OPEN_TRACE_NAME: cstr = "openTrace"
            LAUNCH_NAME: cstr = "launch"
            ATTACH_NAME: cstr = "attach"
            REPLAY_NAME: cstr = "replay"
            PAUSE_NAME: cstr = "pause"
            CONTINUE_NAME: cstr = "continue"
            STEP_NAME: cstr = "step"
            REVERSE_STEP_NAME: cstr = "reverseStep"
            SEEK_NAME: cstr = "seek"
            THREADS_NAME: cstr = "threads"
            STACK_NAME: cstr = "stack"
            SCOPES_NAME: cstr = "scopes"
            VARIABLES_NAME: cstr = "variables"
            EVALUATE_NAME: cstr = "evaluate"
            SET_BREAKPOINTS_NAME: cstr = "setBreakpoints"
            SET_DATA_BREAKPOINTS_NAME: cstr = "setDataBreakpoints"
            CHECKPOINT_NAME: cstr = "checkpoint"
            BRANCH_NAME: cstr = "branch"
            COMPARE_NAME: cstr = "compare"
            TRACE_VERIFY_NAME: cstr = "trace.verify"
            TRACE_EXPORT_NAME: cstr = "trace.export"
            DETACH_NAME: cstr = "detach"
            TERMINATE_NAME: cstr = "terminate"
            CLOSE_NAME: cstr = "close"
            CANCEL_NAME: cstr = "cancel"
            MEMORY_NAME: cstr = "memory"
            REVERSE_STEP_OVER_NAME: cstr = "reverseStepOver"
            REVERSE_STEP_OUT_NAME: cstr = "reverseStepOut"
            TIMELINE_NAME: cstr = "timeline"
            NONE_ERROR_NAME: cstr = "NONE"
            INVALID_ARGUMENT_ERROR_NAME: cstr = "INVALID_ARGUMENT"
            INVALID_STATE_ERROR_NAME: cstr = "INVALID_STATE"
            STALE_GENERATION_ERROR_NAME: cstr = "STALE_GENERATION"
            UNSUPPORTED_ERROR_NAME: cstr = "UNSUPPORTED"
            UNAVAILABLE_ERROR_NAME: cstr = "UNAVAILABLE"
            CORRUPT_ERROR_NAME: cstr = "CORRUPT"
            DIVERGED_ERROR_NAME: cstr = "DIVERGED"
            CANCELLED_ERROR_NAME: cstr = "CANCELLED"
            RESOURCE_LIMIT_ERROR_NAME: cstr = "RESOURCE_LIMIT"
            PERMISSION_DENIED_ERROR_NAME: cstr = "PERMISSION_DENIED"
            TRANSPORT_ERROR_NAME: cstr = "TRANSPORT"
            INTERNAL_ERROR_NAME: cstr = "INTERNAL"

    public:
        def method_name(method: DebuggerProtocol::Method) -> cstr:
            return ProtocolVocabulary::DISCOVER_NAME if method == DebuggerProtocol::Method.Discover
            return ProtocolVocabulary::INITIALIZE_NAME if method == DebuggerProtocol::Method.Initialize
            return ProtocolVocabulary::CREATE_SESSION_NAME if method == DebuggerProtocol::Method.CreateSession
            return ProtocolVocabulary::OPEN_TRACE_NAME if method == DebuggerProtocol::Method.OpenTrace
            return ProtocolVocabulary::LAUNCH_NAME if method == DebuggerProtocol::Method.Launch
            return ProtocolVocabulary::ATTACH_NAME if method == DebuggerProtocol::Method.Attach
            return ProtocolVocabulary::REPLAY_NAME if method == DebuggerProtocol::Method.Replay
            return ProtocolVocabulary::PAUSE_NAME if method == DebuggerProtocol::Method.Pause
            return ProtocolVocabulary::CONTINUE_NAME if method == DebuggerProtocol::Method.Continue
            return ProtocolVocabulary::STEP_NAME if method == DebuggerProtocol::Method.Step
            return ProtocolVocabulary::REVERSE_STEP_NAME if method == DebuggerProtocol::Method.ReverseStep
            return ProtocolVocabulary::SEEK_NAME if method == DebuggerProtocol::Method.Seek
            return ProtocolVocabulary::THREADS_NAME if method == DebuggerProtocol::Method.Threads
            return ProtocolVocabulary::STACK_NAME if method == DebuggerProtocol::Method.Stack
            return ProtocolVocabulary::SCOPES_NAME if method == DebuggerProtocol::Method.Scopes
            return ProtocolVocabulary::VARIABLES_NAME if method == DebuggerProtocol::Method.Variables
            return ProtocolVocabulary::EVALUATE_NAME if method == DebuggerProtocol::Method.Evaluate
            return ProtocolVocabulary::SET_BREAKPOINTS_NAME if method == DebuggerProtocol::Method.SetBreakpoints
            return ProtocolVocabulary::SET_DATA_BREAKPOINTS_NAME if method == DebuggerProtocol::Method.SetDataBreakpoints
            return ProtocolVocabulary::CHECKPOINT_NAME if method == DebuggerProtocol::Method.Checkpoint
            return ProtocolVocabulary::BRANCH_NAME if method == DebuggerProtocol::Method.Branch
            return ProtocolVocabulary::COMPARE_NAME if method == DebuggerProtocol::Method.Compare
            return ProtocolVocabulary::TRACE_VERIFY_NAME if method == DebuggerProtocol::Method.TraceVerify
            return ProtocolVocabulary::TRACE_EXPORT_NAME if method == DebuggerProtocol::Method.TraceExport
            return ProtocolVocabulary::DETACH_NAME if method == DebuggerProtocol::Method.Detach
            return ProtocolVocabulary::TERMINATE_NAME if method == DebuggerProtocol::Method.Terminate
            return ProtocolVocabulary::CLOSE_NAME if method == DebuggerProtocol::Method.Close
            return ProtocolVocabulary::CANCEL_NAME if method == DebuggerProtocol::Method.Cancel
            return ProtocolVocabulary::MEMORY_NAME if method == DebuggerProtocol::Method.Memory
            return ProtocolVocabulary::REVERSE_STEP_OVER_NAME if method == DebuggerProtocol::Method.ReverseStepOver
            return ProtocolVocabulary::REVERSE_STEP_OUT_NAME if method == DebuggerProtocol::Method.ReverseStepOut
            return ProtocolVocabulary::TIMELINE_NAME if method == DebuggerProtocol::Method.Timeline
            return ProtocolVocabulary::UNKNOWN_NAME

        def error_code_name(code: DebuggerErrors::ErrorCode) -> cstr:
            return ProtocolVocabulary::NONE_ERROR_NAME if code == DebuggerErrors::ErrorCode.None
            return ProtocolVocabulary::INVALID_ARGUMENT_ERROR_NAME if code == DebuggerErrors::ErrorCode.InvalidArgument
            return ProtocolVocabulary::INVALID_STATE_ERROR_NAME if code == DebuggerErrors::ErrorCode.InvalidState
            return ProtocolVocabulary::STALE_GENERATION_ERROR_NAME if code == DebuggerErrors::ErrorCode.StaleGeneration
            return ProtocolVocabulary::UNSUPPORTED_ERROR_NAME if code == DebuggerErrors::ErrorCode.Unsupported
            return ProtocolVocabulary::UNAVAILABLE_ERROR_NAME if code == DebuggerErrors::ErrorCode.Unavailable
            return ProtocolVocabulary::CORRUPT_ERROR_NAME if code == DebuggerErrors::ErrorCode.Corrupt
            return ProtocolVocabulary::DIVERGED_ERROR_NAME if code == DebuggerErrors::ErrorCode.Diverged
            return ProtocolVocabulary::CANCELLED_ERROR_NAME if code == DebuggerErrors::ErrorCode.Cancelled
            return ProtocolVocabulary::RESOURCE_LIMIT_ERROR_NAME if code == DebuggerErrors::ErrorCode.ResourceLimit
            return ProtocolVocabulary::PERMISSION_DENIED_ERROR_NAME if code == DebuggerErrors::ErrorCode.PermissionDenied
            return ProtocolVocabulary::TRANSPORT_ERROR_NAME if code == DebuggerErrors::ErrorCode.Transport
            return ProtocolVocabulary::INTERNAL_ERROR_NAME if code == DebuggerErrors::ErrorCode.Internal
            return ProtocolVocabulary::UNKNOWN_NAME
