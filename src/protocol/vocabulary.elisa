# Stable wire vocabulary for editor-neutral transports.  Adapters can map
# typed Elisa enums to protocol names without importing a server or parsing
# human-facing diagnostics.

include "./messages.elisa"
include "../core/errors.elisa"

module DebuggerProtocolVocabulary:
    private:
        const UNKNOWN_NAME: cstr = "unknown"
        const DISCOVER_NAME: cstr = "discover"
        const INITIALIZE_NAME: cstr = "initialize"
        const CREATE_SESSION_NAME: cstr = "createSession"
        const OPEN_TRACE_NAME: cstr = "openTrace"
        const LAUNCH_NAME: cstr = "launch"
        const ATTACH_NAME: cstr = "attach"
        const REPLAY_NAME: cstr = "replay"
        const PAUSE_NAME: cstr = "pause"
        const CONTINUE_NAME: cstr = "continue"
        const STEP_NAME: cstr = "step"
        const REVERSE_STEP_NAME: cstr = "reverseStep"
        const SEEK_NAME: cstr = "seek"
        const THREADS_NAME: cstr = "threads"
        const STACK_NAME: cstr = "stack"
        const SCOPES_NAME: cstr = "scopes"
        const VARIABLES_NAME: cstr = "variables"
        const EVALUATE_NAME: cstr = "evaluate"
        const SET_BREAKPOINTS_NAME: cstr = "setBreakpoints"
        const SET_DATA_BREAKPOINTS_NAME: cstr = "setDataBreakpoints"
        const CHECKPOINT_NAME: cstr = "checkpoint"
        const BRANCH_NAME: cstr = "branch"
        const COMPARE_NAME: cstr = "compare"
        const TRACE_VERIFY_NAME: cstr = "trace.verify"
        const TRACE_EXPORT_NAME: cstr = "trace.export"
        const DETACH_NAME: cstr = "detach"
        const TERMINATE_NAME: cstr = "terminate"
        const CLOSE_NAME: cstr = "close"
        const CANCEL_NAME: cstr = "cancel"
        const MEMORY_NAME: cstr = "memory"
        const NONE_ERROR_NAME: cstr = "NONE"
        const INVALID_ARGUMENT_ERROR_NAME: cstr = "INVALID_ARGUMENT"
        const INVALID_STATE_ERROR_NAME: cstr = "INVALID_STATE"
        const STALE_GENERATION_ERROR_NAME: cstr = "STALE_GENERATION"
        const UNSUPPORTED_ERROR_NAME: cstr = "UNSUPPORTED"
        const UNAVAILABLE_ERROR_NAME: cstr = "UNAVAILABLE"
        const CORRUPT_ERROR_NAME: cstr = "CORRUPT"
        const DIVERGED_ERROR_NAME: cstr = "DIVERGED"
        const CANCELLED_ERROR_NAME: cstr = "CANCELLED"
        const RESOURCE_LIMIT_ERROR_NAME: cstr = "RESOURCE_LIMIT"
        const PERMISSION_DENIED_ERROR_NAME: cstr = "PERMISSION_DENIED"
        const TRANSPORT_ERROR_NAME: cstr = "TRANSPORT"
        const INTERNAL_ERROR_NAME: cstr = "INTERNAL"

    public:
        def method_name(method: DebuggerProtocol::Method) -> cstr:
            return DISCOVER_NAME if method == DebuggerProtocol::Method.Discover
            return INITIALIZE_NAME if method == DebuggerProtocol::Method.Initialize
            return CREATE_SESSION_NAME if method == DebuggerProtocol::Method.CreateSession
            return OPEN_TRACE_NAME if method == DebuggerProtocol::Method.OpenTrace
            return LAUNCH_NAME if method == DebuggerProtocol::Method.Launch
            return ATTACH_NAME if method == DebuggerProtocol::Method.Attach
            return REPLAY_NAME if method == DebuggerProtocol::Method.Replay
            return PAUSE_NAME if method == DebuggerProtocol::Method.Pause
            return CONTINUE_NAME if method == DebuggerProtocol::Method.Continue
            return STEP_NAME if method == DebuggerProtocol::Method.Step
            return REVERSE_STEP_NAME if method == DebuggerProtocol::Method.ReverseStep
            return SEEK_NAME if method == DebuggerProtocol::Method.Seek
            return THREADS_NAME if method == DebuggerProtocol::Method.Threads
            return STACK_NAME if method == DebuggerProtocol::Method.Stack
            return SCOPES_NAME if method == DebuggerProtocol::Method.Scopes
            return VARIABLES_NAME if method == DebuggerProtocol::Method.Variables
            return EVALUATE_NAME if method == DebuggerProtocol::Method.Evaluate
            return SET_BREAKPOINTS_NAME if method == DebuggerProtocol::Method.SetBreakpoints
            return SET_DATA_BREAKPOINTS_NAME if method == DebuggerProtocol::Method.SetDataBreakpoints
            return CHECKPOINT_NAME if method == DebuggerProtocol::Method.Checkpoint
            return BRANCH_NAME if method == DebuggerProtocol::Method.Branch
            return COMPARE_NAME if method == DebuggerProtocol::Method.Compare
            return TRACE_VERIFY_NAME if method == DebuggerProtocol::Method.TraceVerify
            return TRACE_EXPORT_NAME if method == DebuggerProtocol::Method.TraceExport
            return DETACH_NAME if method == DebuggerProtocol::Method.Detach
            return TERMINATE_NAME if method == DebuggerProtocol::Method.Terminate
            return CLOSE_NAME if method == DebuggerProtocol::Method.Close
            return CANCEL_NAME if method == DebuggerProtocol::Method.Cancel
            return MEMORY_NAME if method == DebuggerProtocol::Method.Memory
            return UNKNOWN_NAME

        def error_code_name(code: DebuggerErrors::ErrorCode) -> cstr:
            return NONE_ERROR_NAME if code == DebuggerErrors::ErrorCode.None
            return INVALID_ARGUMENT_ERROR_NAME if code == DebuggerErrors::ErrorCode.InvalidArgument
            return INVALID_STATE_ERROR_NAME if code == DebuggerErrors::ErrorCode.InvalidState
            return STALE_GENERATION_ERROR_NAME if code == DebuggerErrors::ErrorCode.StaleGeneration
            return UNSUPPORTED_ERROR_NAME if code == DebuggerErrors::ErrorCode.Unsupported
            return UNAVAILABLE_ERROR_NAME if code == DebuggerErrors::ErrorCode.Unavailable
            return CORRUPT_ERROR_NAME if code == DebuggerErrors::ErrorCode.Corrupt
            return DIVERGED_ERROR_NAME if code == DebuggerErrors::ErrorCode.Diverged
            return CANCELLED_ERROR_NAME if code == DebuggerErrors::ErrorCode.Cancelled
            return RESOURCE_LIMIT_ERROR_NAME if code == DebuggerErrors::ErrorCode.ResourceLimit
            return PERMISSION_DENIED_ERROR_NAME if code == DebuggerErrors::ErrorCode.PermissionDenied
            return TRANSPORT_ERROR_NAME if code == DebuggerErrors::ErrorCode.Transport
            return INTERNAL_ERROR_NAME if code == DebuggerErrors::ErrorCode.Internal
            return UNKNOWN_NAME
