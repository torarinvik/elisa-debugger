# Derive committed EDIR memory-write provenance from the replay engine's active
# instruction history. Rebuilding from snapshots keeps reverse and branch
# queries aligned with the selected execution without a second mutable log.
# The synthetic identities are scoped to one active replay branch. Do not merge
# indexes across recordings or branch positions. EDIR's heap is monotonic and
# has no free/reuse operation yet, so generation is one; add runtime generations
# before using these identities across heap reuse.

include "../core/identity.elisa"
include "../replay/engine.elisa"
include "./provenance.elisa"

module DebuggerEDIRProvenance:
    private:
        # Reserve the final EDIR_MEMORY_SLOT_CAPACITY identifiers for slots.
        const module Edir:
            MEMORY_SLOT_CAPACITY: u64 = 64
            PROVENANCE_HISTORY_CAPACITY: usize = 64

        const module Memory:
            BINDING_ID_BASE: u64 = 18446744073709551552
            ALLOCATION_ID_OFFSET: u64 = 1
            ALLOCATION_GENERATION: u64 = 1

        const module Provenance:
            QUERY_EDIR_PROVENANCE_MAX_U64: u64 = 18446744073709551615

        const module Sentinel:
            ALLOCATION_SIZE: i64 = 0
            QUERY_EDIR_PROVENANCE_SENTINEL_ALLOCATION_ID: u64 = 0


    public:
        def edir_provenance_binding(allocation: DebuggerIdentity::AllocationIdentity, slot: u64) -> DebuggerIdentity::BindingIdentity:
            return zeroed if slot >= Edir::MEMORY_SLOT_CAPACITY
            return zeroed if allocation.allocation.value == Sentinel::QUERY_EDIR_PROVENANCE_SENTINEL_ALLOCATION_ID
            return DebuggerIdentity::BindingIdentity{
                declaration: DebuggerIdentity::debug_id(Memory::BINDING_ID_BASE + slot),
                incarnation: allocation.allocation.value
            }

    private:
        def edir_provenance_allocation_at(engine: mutable DebuggerReplayEngine::ReplayEngine&, event: u64, slot: u64) -> DebuggerIdentity::AllocationIdentity:
            result: mutable DebuggerIdentity::AllocationIdentity = zeroed
            return result if event > engine.event_count.u64() or engine.event_count > Edir::PROVENANCE_HISTORY_CAPACITY
            return result if not DebuggerEDIR::verify_image(engine.image).valid
            for candidate_event in 0..<event.usize():
                snapshot: DebuggerCheckpoint::MachineSnapshot = engine.history[candidate_event]
                continue if snapshot.program_counter >= engine.image.program.instruction_count
                instruction: DebuggerEDIR::Instruction = engine.image.instructions[snapshot.program_counter.usize()]
                continue if instruction.opcode != DebuggerEDIR::Opcode.Allocate or instruction.a <= Sentinel::ALLOCATION_SIZE
                allocation_start: u64 = snapshot.heap_next.u64()
                allocation_size: u64 = instruction.a.u64()
                return result if allocation_size > Provenance::QUERY_EDIR_PROVENANCE_MAX_U64 - allocation_start
                allocation_end: u64 = allocation_start + allocation_size
                if slot >= allocation_start and slot < allocation_end:
                    result <- DebuggerIdentity::AllocationIdentity{
                        allocation: DebuggerIdentity::debug_id(candidate_event.u64() + Memory::ALLOCATION_ID_OFFSET),
                        generation: Memory::ALLOCATION_GENERATION,
                        offset: slot - allocation_start
                    }
            return result

        def edir_provenance_event_is_valid(engine: mutable DebuggerReplayEngine::ReplayEngine&, event: usize) -> bool:
            return false if event >= engine.event_count or engine.event_count > Edir::PROVENANCE_HISTORY_CAPACITY
            snapshot: DebuggerCheckpoint::MachineSnapshot = engine.history[event]
            return false if not DebuggerReplayEngine::replay_engine_snapshot_is_valid(engine, event, snapshot)
            return false if snapshot.program_counter >= engine.image.program.instruction_count
            instruction: DebuggerEDIR::Instruction = engine.image.instructions[snapshot.program_counter.usize()]
            machine: mutable DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(snapshot)
            DebuggerEDIR::machine_step_in_place(machine, instruction)
            envelope: DebuggerEvents::EventEnvelope = engine.events[event]
            return false if envelope.ordinal != event.u64() or envelope.kind != DebuggerEvents::EventKind.ExecutionBoundary or envelope.quality != DebuggerEvents::EventQuality.Exact
            return false if envelope.position.recording.value != engine.recording.value or envelope.position.event != event.u64()
            return false if envelope.position.branch.value != DebuggerReplayEngine::replay_engine_branch_at(engine, event.u64()).value
            return false if envelope.position.statement.value != machine.program_counter
            return envelope.state_hash == DebuggerReplayEngine::replay_engine_machine_state_hash(machine, event.u64())

    public:
        def edir_provenance_memory_slot_is_valid(slot: u64) -> bool:
            return slot < Edir::MEMORY_SLOT_CAPACITY

        def edir_provenance_memory_binding(engine: mutable DebuggerReplayEngine::ReplayEngine&, slot: u64) -> DebuggerIdentity::BindingIdentity:
            allocation: DebuggerIdentity::AllocationIdentity = edir_provenance_allocation_at(engine, engine.event_count.u64(), slot)
            return edir_provenance_binding(allocation, slot)

        def edir_provenance_from_engine(engine: mutable DebuggerReplayEngine::ReplayEngine&, index: mutable DebuggerProvenance::ProvenanceIndex&) -> void:
            DebuggerProvenance::provenance_initialize(index)
            if engine.event_count > Edir::PROVENANCE_HISTORY_CAPACITY:
                index.overflowed <- true
                return
            if not DebuggerEDIR::verify_image(engine.image).valid:
                index.overflowed <- true
                return
            for event in 0..<engine.event_count:
                if not edir_provenance_event_is_valid(engine, event):
                    index.overflowed <- true
                    return
                snapshot: DebuggerCheckpoint::MachineSnapshot = engine.history[event]
                instruction: DebuggerEDIR::Instruction = engine.image.instructions[snapshot.program_counter.usize()]
                continue if instruction.opcode != DebuggerEDIR::Opcode.StoreMemory
                machine: mutable DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(snapshot)
                DebuggerEDIR::machine_step_in_place(machine, instruction)
                continue if machine.faulted
                slot: u64 = instruction.a.u64()
                allocation: DebuggerIdentity::AllocationIdentity = edir_provenance_allocation_at(engine, event.u64(), slot)
                if allocation.allocation.value == Sentinel::QUERY_EDIR_PROVENANCE_SENTINEL_ALLOCATION_ID:
                    index.overflowed <- true
                    return
                # Event is the zero-based instruction ordinal. The EDIR
                # memory value is an i64, so its u64 bit-cast is exact.
                mutation: DebuggerProvenance::Mutation = DebuggerProvenance::Mutation{
                    event: event.u64(),
                    binding: edir_provenance_binding(allocation, slot),
                    allocation: allocation,
                    kind: DebuggerProvenance::MutationKind.Assignment,
                    value_hash: machine.memory[slot.usize()].u64(),
                    source: instruction.source
                }
                _ = DebuggerProvenance::provenance_append(index, mutation)

        def edir_provenance_last_memory_write(engine: mutable DebuggerReplayEngine::ReplayEngine&, slot: u64, before_event: u64) -> DebuggerProvenance::Mutation:
            result: mutable DebuggerProvenance::Mutation = zeroed
            index: mutable DebuggerProvenance::ProvenanceIndex = zeroed
            edir_provenance_from_engine(engine, index)
            return result if not DebuggerProvenance::provenance_is_complete(index)
            allocation: DebuggerIdentity::AllocationIdentity = edir_provenance_allocation_at(engine, before_event, slot)
            return result if allocation.allocation.value == Sentinel::QUERY_EDIR_PROVENANCE_SENTINEL_ALLOCATION_ID
            binding: DebuggerIdentity::BindingIdentity = edir_provenance_binding(allocation, slot)
            return DebuggerProvenance::provenance_last_write(index, binding, before_event)
