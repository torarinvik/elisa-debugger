# Cancellable historical query execution.  The planner is intentionally
# bounded and operates on authoritative event/provenance indexes; clients get
# a resumable result instead of an unbounded scan or fabricated answer.

include "./history.elisa"
include "./index.elisa"
include "./provenance.elisa"
include "../core/cancellation.elisa"
include "../core/errors.elisa"

module DebuggerQueryEngine:
    private:
        const module Capacity:
            MATCHES: usize = 64

        const module ExecutionDefaults:
            EMPTY_COUNT: usize = 0
            EMPTY_SCANNED: u64 = 0
            EMPTY_NEXT_INDEX: usize = 0
            INCOMPLETE: bool = false
            NOT_CANCELLED: bool = false
            NOT_FIRST_CHANGE_SEARCH: bool = false
            NO_FIRST_CHANGE: bool = false

        const module Event:
            ENGINE_EVENT_NO_EVENT: u64 = 18446744073709551615
            ENGINE_EVENT_MAX: u64 = 18446744073709551615

        const module Identity:
            NO_ALLOCATION: u64 = 0
            NO_GENERATION: u64 = 0

        const module FailureDetail:
            WINDOW: u32 = 1
            CANCELLED: u32 = 2
            ENGINE_FAILUREDETAIL_CAPACITY: u32 = 3
            ENGINE_FAILUREDETAIL_OVERFLOW: u32 = 4
            FIRST_CHANGE: u32 = 5
            ALLOCATION: u32 = 6

        const module Cancellation:
            INITIAL_TICK: u64 = 1


    public:
        struct QueryMatch:
            event: mutable u64
            mutation: mutable DebuggerProvenance::Mutation

        struct StateSample:
            event: mutable u64
            value_hash: mutable u64

        struct StateDifference:
            left: mutable StateSample
            right: mutable StateSample
            different: mutable bool

        struct QueryExecution:
            window: mutable DebuggerHistory::QueryWindow
            matches: mutable QueryMatch[Capacity::MATCHES]
            count: mutable usize
            scanned: mutable u64
            next_event: mutable u64
            next_index: mutable usize
            complete: mutable bool
            cancelled: mutable bool
            first_change_search: mutable bool
            has_first_change: mutable bool
            first_change: mutable QueryMatch
            failure: mutable DebuggerErrors::DebuggerError

        def query_execution_initialize(execution: mutable QueryExecution&, window: DebuggerHistory::QueryWindow) -> void:
            execution.window <- window
            execution.count <- ExecutionDefaults::EMPTY_COUNT
            execution.scanned <- ExecutionDefaults::EMPTY_SCANNED
            execution.next_event <- window.first_event
            execution.next_index <- ExecutionDefaults::EMPTY_NEXT_INDEX
            execution.complete <- ExecutionDefaults::INCOMPLETE
            execution.cancelled <- ExecutionDefaults::NOT_CANCELLED
            execution.first_change_search <- ExecutionDefaults::NOT_FIRST_CHANGE_SEARCH
            execution.has_first_change <- ExecutionDefaults::NO_FIRST_CHANGE
            execution.first_change <- zeroed
            execution.failure <- DebuggerErrors::no_error()

        def query_execution_is_valid(execution: QueryExecution&) -> bool:
            return false if not DebuggerHistory::query_window_is_valid(execution.window) or execution.count > Capacity::MATCHES or execution.next_event < execution.window.first_event or execution.scanned > execution.window.max_steps or (execution.complete and execution.cancelled)
            return false if execution.has_first_change and not execution.first_change_search
            return false if execution.first_change_search and execution.has_first_change != (execution.count == 1)
            return true

        def query_record(execution: mutable QueryExecution&, mutation: DebuggerProvenance::Mutation) -> bool:
            return false if execution.count >= Capacity::MATCHES
            return false if execution.count.u64() >= execution.window.max_results
            execution.matches[execution.count] <- QueryMatch{event: mutation.event, mutation: mutation}
            execution.count <- execution.count + 1
            return true

        def query_find_writes(index: DebuggerProvenance::ProvenanceIndex&, binding: DebuggerIdentity::BindingIdentity, window: DebuggerHistory::QueryWindow, token: DebuggerCancellation::CancellationToken) -> QueryExecution:
            result: mutable QueryExecution = zeroed
            query_execution_initialize(result, window)
            if not DebuggerHistory::query_window_is_valid(window):
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FailureDetail::WINDOW)
                return result
            if index.count > DebuggerProvenance::provenance_capacity() or index.overflowed:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                return result
            if DebuggerCancellation::cancellation_is_requested(token, Cancellation::INITIAL_TICK):
                result.cancelled <- true
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Cancelled, true, FailureDetail::CANCELLED)
                return result
            for position in 0..<index.count:
                candidate: DebuggerProvenance::Mutation = index.mutations[position]
                result.scanned <- result.scanned + 1
                result.next_index <- position + 1
                result.next_event <- Event::ENGINE_EVENT_MAX if candidate.event == Event::ENGINE_EVENT_MAX and candidate.event >= result.next_event
                result.next_event <- candidate.event + 1 if candidate.event != Event::ENGINE_EVENT_MAX and candidate.event >= result.next_event
                if DebuggerCancellation::cancellation_is_requested(token, result.scanned):
                    result.cancelled <- true
                    result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Cancelled, true, FailureDetail::CANCELLED)
                    return result
                if candidate.event < window.first_event or candidate.event > window.last_event or not DebuggerIdentity::binding_identity_equal(candidate.binding, binding) or not DebuggerProvenance::mutation_is_write(candidate.kind):
                    if result.scanned >= window.max_steps and position + 1 < index.count:
                        result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                        return result
                    continue
                _ = query_record(result, candidate)
                if result.count.u64() >= window.max_results:
                    result.complete <- position + 1 >= index.count
                    if not result.complete and result.scanned >= window.max_steps:
                        result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                    return result
                if result.count >= Capacity::MATCHES:
                    result.complete <- position + 1 >= index.count
                    return result if result.complete
                    result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                    return result
                if result.scanned >= window.max_steps and position + 1 < index.count:
                    result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                    return result
            result.complete <- true
            result.next_index <- index.count
            return result

        # Query allocation, release, and region-reset records without
        # requiring a lexical binding. Storage identity includes generation
        # and byte offset so address reuse cannot merge unrelated lifetimes.
        def query_find_allocation_lifetime(index: DebuggerProvenance::ProvenanceIndex&, allocation: DebuggerIdentity::AllocationIdentity, window: DebuggerHistory::QueryWindow, token: DebuggerCancellation::CancellationToken) -> QueryExecution:
            result: mutable QueryExecution = zeroed
            query_execution_initialize(result, window)
            if not DebuggerHistory::query_window_is_valid(window):
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FailureDetail::WINDOW)
                return result
            if allocation.allocation.value == Identity::NO_ALLOCATION or allocation.generation == Identity::NO_GENERATION:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FailureDetail::ALLOCATION)
                return result
            if index.count > DebuggerProvenance::provenance_capacity() or index.overflowed:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                return result
            if DebuggerCancellation::cancellation_is_requested(token, Cancellation::INITIAL_TICK):
                result.cancelled <- true
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Cancelled, true, FailureDetail::CANCELLED)
                return result
            for position in 0..<index.count:
                candidate: DebuggerProvenance::Mutation = index.mutations[position]
                result.scanned <- result.scanned + 1
                result.next_index <- position + 1
                result.next_event <- Event::ENGINE_EVENT_MAX if candidate.event == Event::ENGINE_EVENT_MAX and candidate.event >= result.next_event
                result.next_event <- candidate.event + 1 if candidate.event != Event::ENGINE_EVENT_MAX and candidate.event >= result.next_event
                if DebuggerCancellation::cancellation_is_requested(token, result.scanned):
                    result.cancelled <- true
                    result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Cancelled, true, FailureDetail::CANCELLED)
                    return result
                matches_allocation: bool = candidate.allocation.allocation.value == allocation.allocation.value and candidate.allocation.generation == allocation.generation and candidate.allocation.offset == allocation.offset
                if candidate.event < window.first_event or candidate.event > window.last_event or not matches_allocation or not DebuggerProvenance::mutation_is_lifetime(candidate.kind):
                    if result.scanned >= window.max_steps and position + 1 < index.count:
                        result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                        return result
                    continue
                _ = query_record(result, candidate)
                if result.count.u64() >= window.max_results:
                    result.complete <- position + 1 >= index.count
                    if not result.complete and result.scanned >= window.max_steps:
                        result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                    return result
                if result.count >= Capacity::MATCHES:
                    result.complete <- position + 1 >= index.count
                    return result if result.complete
                    result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                    return result
                if result.scanned >= window.max_steps and position + 1 < index.count:
                    result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                    return result
            result.complete <- true
            result.next_index <- index.count
            return result

        # Continue a paged write query from the exact index position at which
        # the previous page stopped.  Provenance is append-only but callers
        # may provide an unordered index, so an event number alone cannot be a
        # safe cursor.  The suffix copy keeps the public index immutable while
        # reusing all validation, cancellation, and limit handling above.
        def query_resume_writes(execution: QueryExecution, index: DebuggerProvenance::ProvenanceIndex&, binding: DebuggerIdentity::BindingIdentity, token: DebuggerCancellation::CancellationToken) -> QueryExecution:
            return execution if execution.complete or execution.cancelled
            if execution.next_index > index.count or index.count > DebuggerProvenance::provenance_capacity() or index.overflowed:
                failed: mutable QueryExecution = execution
                failed.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, FailureDetail::ENGINE_FAILUREDETAIL_OVERFLOW)
                return failed
            if execution.scanned >= execution.window.max_steps:
                limited: mutable QueryExecution = execution
                limited.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                return limited
            suffix: mutable DebuggerProvenance::ProvenanceIndex = zeroed
            DebuggerProvenance::provenance_initialize(suffix)
            for position in execution.next_index..<index.count:
                _ = DebuggerProvenance::provenance_append(suffix, index.mutations[position])
            remaining_window: mutable DebuggerHistory::QueryWindow = execution.window
            remaining_window.max_steps <- execution.window.max_steps - execution.scanned
            resumed: mutable QueryExecution = query_find_writes(suffix, binding, remaining_window, token)
            resumed.scanned <- execution.scanned + resumed.scanned
            resumed.next_index <- execution.next_index + resumed.next_index
            return resumed

        def query_resume_allocation_lifetime(execution: QueryExecution, index: DebuggerProvenance::ProvenanceIndex&, allocation: DebuggerIdentity::AllocationIdentity, token: DebuggerCancellation::CancellationToken) -> QueryExecution:
            return execution if execution.complete or execution.cancelled
            if execution.next_index > index.count or index.count > DebuggerProvenance::provenance_capacity() or index.overflowed:
                failed: mutable QueryExecution = execution
                failed.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, FailureDetail::ENGINE_FAILUREDETAIL_OVERFLOW)
                return failed
            if execution.scanned >= execution.window.max_steps:
                limited: mutable QueryExecution = execution
                limited.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, FailureDetail::ENGINE_FAILUREDETAIL_CAPACITY)
                return limited
            suffix: mutable DebuggerProvenance::ProvenanceIndex = zeroed
            DebuggerProvenance::provenance_initialize(suffix)
            for position in execution.next_index..<index.count:
                _ = DebuggerProvenance::provenance_append(suffix, index.mutations[position])
            remaining_window: mutable DebuggerHistory::QueryWindow = execution.window
            remaining_window.max_steps <- execution.window.max_steps - execution.scanned
            resumed: mutable QueryExecution = query_find_allocation_lifetime(suffix, allocation, remaining_window, token)
            resumed.scanned <- execution.scanned + resumed.scanned
            resumed.next_index <- execution.next_index + resumed.next_index
            return resumed

        def query_find_next_write(index: DebuggerProvenance::ProvenanceIndex&, binding: DebuggerIdentity::BindingIdentity, after_event: u64, window: DebuggerHistory::QueryWindow) -> DebuggerProvenance::Mutation:
            result: mutable DebuggerProvenance::Mutation = zeroed
            found: mutable bool = false
            return result if not DebuggerHistory::query_window_is_valid(window) or index.count > DebuggerProvenance::provenance_capacity() or index.overflowed
            for position in 0..<index.count:
                candidate: DebuggerProvenance::Mutation = index.mutations[position]
                if DebuggerProvenance::mutation_is_write(candidate.kind) and DebuggerIdentity::binding_identity_equal(candidate.binding, binding) and candidate.event > after_event and candidate.event >= window.first_event and candidate.event <= window.last_event and (not found or candidate.event < result.event):
                    result <- candidate
                    found <- true
            return result

        private:
            def query_first_change_consider_page(result: mutable QueryExecution&, previous_hash: u64) -> void:
                result.first_change_search <- true
                for position in 0..<result.count:
                    candidate: QueryMatch = result.matches[position]
                    if candidate.mutation.value_hash != previous_hash and (not result.has_first_change or candidate.event < result.first_change.event):
                        result.first_change <- candidate
                        result.has_first_change <- true
                if result.has_first_change:
                    result.matches[0] <- result.first_change
                    result.count <- 1
                else:
                    result.count <- ExecutionDefaults::EMPTY_COUNT

        public:
            def query_first_change(index: DebuggerProvenance::ProvenanceIndex&, binding: DebuggerIdentity::BindingIdentity, window: DebuggerHistory::QueryWindow, previous_hash: u64, token: DebuggerCancellation::CancellationToken) -> QueryExecution:
                result: mutable QueryExecution = query_find_writes(index, binding, window, token)
                return result if result.cancelled or not DebuggerErrors::error_is_ok(result.failure)
                # Keep the earliest candidate found so far in the cursor. It is
                # provisional until every bounded page has been inspected.
                query_first_change_consider_page(result, previous_hash)
                return result

            def query_resume_first_change(execution: QueryExecution, index: DebuggerProvenance::ProvenanceIndex&, binding: DebuggerIdentity::BindingIdentity, previous_hash: u64, token: DebuggerCancellation::CancellationToken) -> QueryExecution:
                if not execution.first_change_search:
                    invalid: mutable QueryExecution = execution
                    invalid.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, FailureDetail::FIRST_CHANGE)
                    return invalid
                return execution if execution.complete or execution.cancelled
                write_cursor: mutable QueryExecution = execution
                write_cursor.count <- 0
                write_cursor.first_change_search <- false
                write_cursor.has_first_change <- false
                resumed: mutable QueryExecution = query_resume_writes(write_cursor, index, binding, token)
                resumed.first_change_search <- true
                resumed.first_change <- execution.first_change
                resumed.has_first_change <- execution.has_first_change
                query_first_change_consider_page(resumed, previous_hash)
                return resumed

        def query_compare(left: StateSample, right: StateSample) -> StateDifference:
            return StateDifference{left: left, right: right, different: left.value_hash != right.value_hash}

        def query_compare_series(left: StateSample&, left_count: usize, right: StateSample&, right_count: usize) -> StateDifference:
            left_sample: mutable StateSample = zeroed
            right_sample: mutable StateSample = zeroed
            return StateDifference{left: left_sample, right: right_sample, different: true} if left_count == 0 or right_count == 0 or left_count > Capacity::MATCHES or right_count > Capacity::MATCHES
            left_sample <- left[0]
            right_sample <- right[0]
            for index in 1..<left_count:
                left_sample <- left[index] if left[index].event <= left_sample.event
            for index in 1..<right_count:
                right_sample <- right[index] if right[index].event <= right_sample.event
            return query_compare(left_sample, right_sample)
