# Historical query execution over rebuildable sparse indexes.  Predicates are
# evaluated at captured boundaries and return explicit cancellation/limits.

include "./index.elisa"
include "../core/cancellation.elisa"

module DebuggerQueryEvaluator:
    private:
        const module PredicateLimits:
            QUERY_EVALUATOR_PREDICATE_LIMITS_KIND_MAX: u16 = 3

        const module Query:
            DEFAULT_BUDGET: u64 = 1000000
            QUERY_EVALUATOR_INDEX_CAPACITY: usize = 512
            QUERY_EVALUATOR_INITIAL_TICK: u64 = 1


    public:
        enum PredicateKind:
            StateHashEquals
            StatementEquals
            TaskEquals
            EventRange

        struct Predicate:
            kind: mutable PredicateKind
            value: mutable u64
            second: mutable u64

        enum QueryStatus:
            Match
            NoMatch
            Cancelled
            ResourceLimit
            InvalidArgument

        struct QueryResult:
            status: mutable QueryStatus
            event: mutable u64
            scanned: mutable u64

        def predicate_matches(entry: DebuggerQueryIndex::EventIndexEntry, predicate: Predicate) -> bool:
            return false if predicate.kind.u16() > PredicateLimits::QUERY_EVALUATOR_PREDICATE_LIMITS_KIND_MAX
            return entry.state_hash == predicate.value if predicate.kind == PredicateKind.StateHashEquals
            return entry.statement.value == predicate.value if predicate.kind == PredicateKind.StatementEquals
            return entry.task.value == predicate.value if predicate.kind == PredicateKind.TaskEquals
            return entry.event >= predicate.value and entry.event <= predicate.second

        def query_first(index: DebuggerQueryIndex::EventIndex, predicate: Predicate, first_event: u64, last_event: u64, token: DebuggerCancellation::CancellationToken, budget: u64) -> QueryResult:
            return QueryResult{status: QueryStatus.ResourceLimit, event: 0, scanned: 0} if index.count > Query::QUERY_EVALUATOR_INDEX_CAPACITY or index.overflowed
            return QueryResult{status: QueryStatus.InvalidArgument, event: 0, scanned: 0} if predicate.kind.u16() > PredicateLimits::QUERY_EVALUATOR_PREDICATE_LIMITS_KIND_MAX or first_event > last_event
            return QueryResult{status: QueryStatus.InvalidArgument, event: 0, scanned: 0} if predicate.kind == PredicateKind.EventRange and predicate.value > predicate.second
            return QueryResult{status: QueryStatus.Cancelled, event: 0, scanned: 0} if DebuggerCancellation::cancellation_is_requested(token, Query::QUERY_EVALUATOR_INITIAL_TICK)
            limit: u64 = Query::DEFAULT_BUDGET if budget == 0 else budget
            scanned: mutable u64 = 0
            found: mutable bool = false
            first_match: mutable u64 = 0
            for position in 0..<index.count:
                entry: DebuggerQueryIndex::EventIndexEntry = index.entries[position]
                return QueryResult{status: QueryStatus.Cancelled, event: 0, scanned: scanned} if DebuggerCancellation::cancellation_is_requested(token, scanned)
                return QueryResult{status: QueryStatus.ResourceLimit, event: 0, scanned: scanned} if scanned >= limit
                scanned <- scanned + 1
                if entry.event < first_event or entry.event > last_event:
                    continue
                if predicate_matches(entry, predicate) and (not found or entry.event < first_match):
                    found <- true
                    first_match <- entry.event
            return QueryResult{status: QueryStatus.Match, event: first_match, scanned: scanned} if found
            return QueryResult{status: QueryStatus.NoMatch, event: 0, scanned: scanned}

        def query_compare_with_cancellation(left: DebuggerQueryIndex::EventIndex, right: DebuggerQueryIndex::EventIndex, token: DebuggerCancellation::CancellationToken, budget: u64) -> QueryResult:
            return QueryResult{status: QueryStatus.ResourceLimit, event: 0, scanned: 0} if left.count > Query::QUERY_EVALUATOR_INDEX_CAPACITY or right.count > Query::QUERY_EVALUATOR_INDEX_CAPACITY or left.overflowed or right.overflowed
            return QueryResult{status: QueryStatus.Cancelled, event: 0, scanned: 0} if DebuggerCancellation::cancellation_is_requested(token, 0)
            limit: u64 = Query::DEFAULT_BUDGET if budget == 0 else budget
            scanned: mutable u64 = 0
            found_difference: mutable bool = false
            first_difference: mutable u64 = 0
            # Event indexes may be appended out of order. Count every inspected
            # entry, including nested event-ID lookups, so budgets and
            # cancellation cover the actual search work.
            for left_position in 0..<left.count:
                return QueryResult{status: QueryStatus.Cancelled, event: 0, scanned: scanned} if DebuggerCancellation::cancellation_is_requested(token, scanned)
                return QueryResult{status: QueryStatus.ResourceLimit, event: 0, scanned: scanned} if scanned >= limit
                scanned <- scanned + 1
                left_entry: DebuggerQueryIndex::EventIndexEntry = left.entries[left_position]
                found_event: mutable bool = false
                for right_position in 0..<right.count:
                    return QueryResult{status: QueryStatus.Cancelled, event: 0, scanned: scanned} if DebuggerCancellation::cancellation_is_requested(token, scanned)
                    return QueryResult{status: QueryStatus.ResourceLimit, event: 0, scanned: scanned} if scanned >= limit
                    if right.entries[right_position].event == left_entry.event:
                        scanned <- scanned + 1
                        found_event <- true
                        if left_entry.state_hash != right.entries[right_position].state_hash or left_entry.statement.value != right.entries[right_position].statement.value or left_entry.task.value != right.entries[right_position].task.value:
                            if not found_difference or left_entry.event < first_difference:
                                first_difference <- left_entry.event
                                found_difference <- true
                        break
                    scanned <- scanned + 1
                if not found_event and (not found_difference or left_entry.event < first_difference):
                    first_difference <- left_entry.event
                    found_difference <- true
            for right_position in 0..<right.count:
                return QueryResult{status: QueryStatus.Cancelled, event: 0, scanned: scanned} if DebuggerCancellation::cancellation_is_requested(token, scanned)
                return QueryResult{status: QueryStatus.ResourceLimit, event: 0, scanned: scanned} if scanned >= limit
                scanned <- scanned + 1
                right_entry: DebuggerQueryIndex::EventIndexEntry = right.entries[right_position]
                found_event: mutable bool = false
                for left_position in 0..<left.count:
                    return QueryResult{status: QueryStatus.Cancelled, event: 0, scanned: scanned} if DebuggerCancellation::cancellation_is_requested(token, scanned)
                    return QueryResult{status: QueryStatus.ResourceLimit, event: 0, scanned: scanned} if scanned >= limit
                    if left.entries[left_position].event == right_entry.event:
                        scanned <- scanned + 1
                        found_event <- true
                        break
                    scanned <- scanned + 1
                if not found_event and (not found_difference or right_entry.event < first_difference):
                    first_difference <- right_entry.event
                    found_difference <- true
            return QueryResult{status: QueryStatus.Match, event: first_difference, scanned: scanned} if found_difference
            return QueryResult{status: QueryStatus.NoMatch, event: 0, scanned: scanned}

        def query_compare(left: DebuggerQueryIndex::EventIndex, right: DebuggerQueryIndex::EventIndex, budget: u64) -> QueryResult:
            token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
            return query_compare_with_cancellation(left, right, token, budget)
