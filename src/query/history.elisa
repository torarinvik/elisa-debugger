# Bounded historical query descriptors.  Indexes can later optimize these
# operations without changing their client-visible semantics.

module DebuggerHistory:
    public:
        enum QueryKind:
            WritesToBinding
            AllocationLifetime
            FirstTrue
            CallsToFunction
            StateDifference
            CausalPredecessors

        struct QueryWindow:
            first_event: mutable u64
            last_event: mutable u64
            max_results: mutable u64
            max_steps: mutable u64

        struct QueryResult:
            complete: mutable bool
            cancelled: mutable bool
            scanned_events: mutable u64
            returned_results: mutable u64
            next_event: mutable u64

        def query_window_is_valid(window: QueryWindow) -> bool:
            return window.last_event >= window.first_event and window.max_results > 0 and window.max_steps > 0

        def query_result_needs_resume(result: QueryResult) -> bool:
            return not result.complete and not result.cancelled
