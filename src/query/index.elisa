# Bounded indexes used by historical queries.  They retain event ranges and
# permit cancellation between entries without exposing storage details.

include "../core/identity.elisa"

module DebuggerQueryIndex:
    private:
        const QUERY_INDEX_CAPACITY: usize = 512

    public:
        struct EventIndexEntry:
            event: mutable u64
            task: mutable DebuggerIdentity::DebugId
            statement: mutable DebuggerIdentity::DebugId
            state_hash: mutable u64

        struct EventIndex:
            entries: mutable EventIndexEntry[QUERY_INDEX_CAPACITY]
            count: mutable usize
            overflowed: mutable bool

        def event_index_new() -> EventIndex:
            index: mutable EventIndex = zeroed
            index.count <- 0
            index.overflowed <- false
            return index

        def event_index_append(index: EventIndex, entry: EventIndexEntry) -> EventIndex:
            updated: mutable EventIndex = index
            if index.count >= QUERY_INDEX_CAPACITY:
                updated.overflowed <- true
                return updated
            for position in 0..<index.count:
                if index.entries[position].event == entry.event:
                    updated.overflowed <- true
                    return updated
            updated.entries[index.count] <- entry
            updated.count <- index.count + 1
            return updated

        def event_index_find(index: EventIndex, event: u64) -> EventIndexEntry:
            result: mutable EventIndexEntry = zeroed
            return result if index.count > QUERY_INDEX_CAPACITY or index.overflowed
            for position in 0..<index.count:
                return index.entries[position] if index.entries[position].event == event
            return result

        def event_index_find_previous(index: EventIndex, event: u64) -> EventIndexEntry:
            result: mutable EventIndexEntry = zeroed
            found: mutable bool = false
            return result if index.count > QUERY_INDEX_CAPACITY or index.overflowed
            for position in 0..<index.count:
                candidate: EventIndexEntry = index.entries[position]
                if candidate.event < event and (not found or candidate.event > result.event):
                    result <- candidate
                    found <- true
            return result

        def event_index_find_next(index: EventIndex, event: u64) -> EventIndexEntry:
            result: mutable EventIndexEntry = zeroed
            found: mutable bool = false
            return result if index.count > QUERY_INDEX_CAPACITY or index.overflowed
            for position in 0..<index.count:
                candidate: EventIndexEntry = index.entries[position]
                if candidate.event > event and (not found or candidate.event < result.event):
                    result <- candidate
                    found <- true
            return result
