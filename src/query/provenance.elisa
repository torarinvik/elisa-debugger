# Mutation provenance index.  Records are append-only and retain allocation
# generations so an address reused by a later allocation cannot alias history.

include "../core/identity.elisa"

module DebuggerProvenance:
    private:
        const PROVENANCE_CAPACITY: usize = 512
        const MUTATION_KIND_MAX: u16 = 5

    public:
        enum MutationKind:
            Assignment
            Allocation
            Deallocation
            RegionReset
            Input
            Foreign

        struct Mutation:
            event: mutable u64
            binding: mutable DebuggerIdentity::BindingIdentity
            allocation: mutable DebuggerIdentity::AllocationIdentity
            kind: mutable MutationKind
            value_hash: mutable u64
            source: mutable DebuggerIdentity::SourceSpan

        struct ProvenanceIndex:
            mutations: mutable Mutation[PROVENANCE_CAPACITY]
            count: mutable usize
            overflowed: mutable bool

        def provenance_new() -> ProvenanceIndex:
            index: mutable ProvenanceIndex = zeroed
            index.count <- 0
            index.overflowed <- false
            return index

        def provenance_append(index: ProvenanceIndex, mutation: Mutation) -> ProvenanceIndex:
            updated: mutable ProvenanceIndex = index
            if mutation.kind.u16() > MUTATION_KIND_MAX or mutation.binding.declaration.value == 0:
                updated.overflowed <- true
                return updated
            if index.count >= PROVENANCE_CAPACITY:
                updated.overflowed <- true
                return updated
            updated.mutations[index.count] <- mutation
            updated.count <- index.count + 1
            return updated

        def mutation_is_write(kind: MutationKind) -> bool:
            return kind == MutationKind.Assignment or kind == MutationKind.Input or kind == MutationKind.Foreign

        def provenance_last_write(index: ProvenanceIndex, binding: DebuggerIdentity::BindingIdentity, before_event: u64) -> Mutation:
            result: mutable Mutation = zeroed
            found: mutable bool = false
            return result if index.count > PROVENANCE_CAPACITY or index.overflowed
            for position in 0..<index.count:
                candidate: Mutation = index.mutations[position]
                if mutation_is_write(candidate.kind) and DebuggerIdentity::binding_identity_equal(candidate.binding, binding) and candidate.event < before_event and (not found or candidate.event > result.event):
                    result <- candidate
                    found <- true
            return result

        def provenance_last_write_at_or_before(index: ProvenanceIndex, binding: DebuggerIdentity::BindingIdentity, event: u64) -> Mutation:
            result: mutable Mutation = zeroed
            found: mutable bool = false
            return result if index.count > PROVENANCE_CAPACITY or index.overflowed
            for position in 0..<index.count:
                candidate: Mutation = index.mutations[position]
                if mutation_is_write(candidate.kind) and DebuggerIdentity::binding_identity_equal(candidate.binding, binding) and candidate.event <= event and (not found or candidate.event > result.event):
                    result <- candidate
                    found <- true
            return result

        def provenance_count(index: ProvenanceIndex) -> usize:
            return index.count

        def provenance_capacity() -> usize:
            return PROVENANCE_CAPACITY

        def provenance_is_complete(index: ProvenanceIndex) -> bool:
            return false if index.overflowed or index.count > PROVENANCE_CAPACITY
            for position in 0..<index.count:
                mutation: Mutation = index.mutations[position]
                return false if mutation.kind.u16() > MUTATION_KIND_MAX or mutation.binding.declaration.value == 0
            return true

        def provenance_first_change(index: ProvenanceIndex, binding: DebuggerIdentity::BindingIdentity, first_event: u64, last_event: u64, previous_hash: u64) -> Mutation:
            result: mutable Mutation = zeroed
            found: mutable bool = false
            return result if index.count > PROVENANCE_CAPACITY or index.overflowed
            for position in 0..<index.count:
                candidate: Mutation = index.mutations[position]
                if DebuggerIdentity::binding_identity_equal(candidate.binding, binding) and candidate.event >= first_event and candidate.event <= last_event and candidate.value_hash != previous_hash and (not found or candidate.event < result.event):
                    result <- candidate
                    found <- true
            return result

        def provenance_last_allocation_write(index: ProvenanceIndex, allocation: DebuggerIdentity::AllocationIdentity, before_event: u64) -> Mutation:
            result: mutable Mutation = zeroed
            found: mutable bool = false
            return result if index.count > PROVENANCE_CAPACITY or index.overflowed
            for position in 0..<index.count:
                candidate: Mutation = index.mutations[position]
                if candidate.allocation.allocation.value == allocation.allocation.value and candidate.allocation.generation == allocation.generation and candidate.event < before_event and (not found or candidate.event > result.event):
                    result <- candidate
                    found <- true
            return result
