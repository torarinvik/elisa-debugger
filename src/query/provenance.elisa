# Mutation provenance index.  Records are append-only and retain allocation
# generations so an address reused by a later allocation cannot alias history.

include "../core/identity.elisa"

module DebuggerProvenance:
    private:
        const PROVENANCE_CAPACITY: usize = 512

    public:
        enum MutationKind:
            Assignment
            Allocation
            Deallocation
            RegionReset
            Input
            Foreign

        struct Mutation:
            event: mutable u64
            binding: mutable DebuggerIdentity::BindingIdentity
            allocation: mutable DebuggerIdentity::AllocationIdentity
            kind: mutable MutationKind
            value_hash: mutable u64
            source: mutable DebuggerIdentity::SourceSpan

        struct ProvenanceIndex:
            mutations: mutable Mutation[PROVENANCE_CAPACITY]
            count: mutable usize

        def provenance_new() -> ProvenanceIndex:
            index: mutable ProvenanceIndex = zeroed
            index.count <- 0
            return index

        def provenance_append(index: ProvenanceIndex, mutation: Mutation) -> ProvenanceIndex:
            updated: mutable ProvenanceIndex = index
            return updated if index.count >= PROVENANCE_CAPACITY
            updated.mutations[index.count] <- mutation
            updated.count <- index.count + 1
            return updated

        def provenance_last_write(index: ProvenanceIndex, binding: DebuggerIdentity::BindingIdentity, before_event: u64) -> Mutation:
            result: mutable Mutation = zeroed
            for reverse in 0..<index.count:
                index_from_end: usize = index.count - 1 - reverse
                candidate: Mutation = index.mutations[index_from_end]
                if DebuggerIdentity::binding_identity_equal(candidate.binding, binding) and candidate.event < before_event:
                    return candidate
            return result

        def provenance_last_write_at_or_before(index: ProvenanceIndex, binding: DebuggerIdentity::BindingIdentity, event: u64) -> Mutation:
            result: mutable Mutation = zeroed
            for reverse in 0..<index.count:
                index_from_end: usize = index.count - 1 - reverse
                candidate: Mutation = index.mutations[index_from_end]
                if DebuggerIdentity::binding_identity_equal(candidate.binding, binding) and candidate.event <= event:
                    return candidate
            return result

        def provenance_count(index: ProvenanceIndex) -> usize:
            return index.count

        def provenance_first_change(index: ProvenanceIndex, binding: DebuggerIdentity::BindingIdentity, first_event: u64, last_event: u64, previous_hash: u64) -> Mutation:
            result: mutable Mutation = zeroed
            for position in 0..<index.count:
                candidate: Mutation = index.mutations[position]
                if DebuggerIdentity::binding_identity_equal(candidate.binding, binding) and candidate.event >= first_event and candidate.event <= last_event and candidate.value_hash != previous_hash:
                    return candidate
            return result

        def provenance_last_allocation_write(index: ProvenanceIndex, allocation: DebuggerIdentity::AllocationIdentity, before_event: u64) -> Mutation:
            result: mutable Mutation = zeroed
            for reverse in 0..<index.count:
                index_from_end: usize = index.count - 1 - reverse
                candidate: Mutation = index.mutations[index_from_end]
                if candidate.allocation.allocation.value == allocation.allocation.value and candidate.allocation.generation == allocation.generation and candidate.event < before_event:
                    return candidate
            return result
