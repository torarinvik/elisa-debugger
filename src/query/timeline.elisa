# Public timeline state for editor-neutral history views.  It describes the
# retained and exact ranges without exposing trace storage or provider internals.

include "../core/identity.elisa"
include "../core/capabilities.elisa"
include "../core/errors.elisa"

module DebuggerTimeline:
    private:
        const module BookmarkLimits:
            QUERY_TIMELINE_BOOKMARK_LIMITS_CAPACITY: usize = 128

        const module Bounds:
            MAX_BOOKMARK_ID: u64 = 18446744073709551615

        const module Detail:
            QUERY_TIMELINE_DETAIL_RANGE: u32 = 1
            QUERY_TIMELINE_DETAIL_CAPABILITY: u32 = 2
            QUERY_TIMELINE_DETAIL_CAPACITY: u32 = 3
            BOOKMARK: u32 = 4

        const module First:
            QUERY_TIMELINE_FIRST_BOOKMARK_ID: u64 = 1

        const module Index:
            FIRST_BOOKMARK_INDEX: usize = 0

        const module Count:
            EMPTY_BOOKMARK_COUNT: usize = 0
            BOOKMARK_COUNT_INCREMENT: usize = 1

        const module Event:
            PREVIOUS_EVENT_DISTANCE: u64 = 1

        const module Sentinel:
            QUERY_TIMELINE_SENTINEL_BOOKMARK_ID: u64 = 0
            QUERY_TIMELINE_SENTINEL_EVENT: u64 = 0


    public:
        struct HistoryBounds:
            has_retained: mutable bool
            retained_first: mutable u64
            retained_last: mutable u64
            has_exact: mutable bool
            exact_first: mutable u64
            exact_last: mutable u64
            current: mutable u64

        struct Bookmark:
            id: mutable DebuggerIdentity::DebugId
            position: mutable DebuggerIdentity::Position
            label: mutable DebuggerIdentity::DebugId
            note: mutable DebuggerIdentity::DebugId
            pinned: mutable bool

        enum HistoryEligibilityReason:
            Ready
            UnsupportedHistory
            SessionNotStopped
            StateNotExact
            SideStateUnaligned
            AtBoundary

        # This is a point-in-time capability snapshot. `reason` describes why
        # reverse navigation is currently unavailable; `can_seek` can still
        # be true at the beginning when retained history exists ahead.
        struct HistoryEligibility:
            can_reverse: mutable bool
            can_seek: mutable bool
            reason: mutable HistoryEligibilityReason

        struct Timeline:
            position: mutable DebuggerIdentity::Position
            bounds: mutable HistoryBounds
            capabilities: mutable DebuggerCapabilities::CapabilitySet
            eligibility: mutable HistoryEligibility
            bookmarks: mutable Bookmark[BookmarkLimits::QUERY_TIMELINE_BOOKMARK_LIMITS_CAPACITY]
            bookmark_count: mutable usize
            next_bookmark_id: mutable u64

        struct TimelineResult:
            timeline: mutable Timeline
            accepted: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def history_bounds_new(current: u64) -> HistoryBounds:
            return HistoryBounds{has_retained: true, retained_first: current, retained_last: current, has_exact: true, exact_first: current, exact_last: current, current: current}

        def history_eligibility_for_capabilities(capabilities: DebuggerCapabilities::CapabilitySet) -> HistoryEligibility:
            return HistoryEligibility{can_reverse: false, can_seek: false, reason: HistoryEligibilityReason.UnsupportedHistory} if capabilities.history != DebuggerCapabilities::HistoryKind.Exact or not capabilities.reverse_execution
            return HistoryEligibility{can_reverse: false, can_seek: false, reason: HistoryEligibilityReason.AtBoundary}

        def history_bounds_is_valid(bounds: HistoryBounds) -> bool:
            return false if bounds.has_retained and bounds.retained_last < bounds.retained_first
            return false if bounds.has_exact and (not bounds.has_retained or bounds.exact_last < bounds.exact_first)
            return false if bounds.has_exact and (bounds.exact_first < bounds.retained_first or bounds.exact_last > bounds.retained_last)
            return false if bounds.has_retained and (bounds.current < bounds.retained_first or bounds.current > bounds.retained_last)
            return false if bounds.has_exact and (bounds.current < bounds.exact_first or bounds.current > bounds.exact_last)
            return bounds.has_retained or bounds.current == Sentinel::QUERY_TIMELINE_SENTINEL_EVENT

        def timeline_new(position: DebuggerIdentity::Position, capabilities: DebuggerCapabilities::CapabilitySet) -> Timeline:
            bounds: mutable HistoryBounds = history_bounds_new(position.event)
            bounds.has_exact <- capabilities.history == DebuggerCapabilities::HistoryKind.Exact
            bounds.exact_first <- position.event
            bounds.exact_last <- position.event
            return Timeline{position: position, bounds: bounds, capabilities: capabilities, eligibility: history_eligibility_for_capabilities(capabilities), bookmarks: zeroed, bookmark_count: Count::EMPTY_BOOKMARK_COUNT, next_bookmark_id: First::QUERY_TIMELINE_FIRST_BOOKMARK_ID}

        def timeline_bookmark_capacity() -> usize:
            return BookmarkLimits::QUERY_TIMELINE_BOOKMARK_LIMITS_CAPACITY

        def timeline_set_bounds(timeline: Timeline, bounds: HistoryBounds) -> TimelineResult:
            updated: mutable Timeline = timeline
            if not history_bounds_is_valid(bounds):
                return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::QUERY_TIMELINE_DETAIL_RANGE)}
            if bounds.has_exact and timeline.capabilities.history != DebuggerCapabilities::HistoryKind.Exact:
                return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::QUERY_TIMELINE_DETAIL_CAPABILITY)}
            updated.bounds <- bounds
            updated.position.event <- bounds.current
            return TimelineResult{timeline: updated, accepted: true, failure: DebuggerErrors::no_error()}

        def timeline_set_capabilities(timeline: Timeline, capabilities: DebuggerCapabilities::CapabilitySet) -> TimelineResult:
            updated: mutable Timeline = timeline
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::QUERY_TIMELINE_DETAIL_RANGE)} if not history_bounds_is_valid(timeline.bounds)
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::QUERY_TIMELINE_DETAIL_CAPABILITY)} if not DebuggerCapabilities::capabilities_is_valid(capabilities)
            updated.capabilities <- capabilities
            if capabilities.history == DebuggerCapabilities::HistoryKind.Exact and not updated.bounds.has_exact:
                updated.bounds.has_exact <- true
                updated.bounds.exact_first <- updated.bounds.current
                updated.bounds.exact_last <- updated.bounds.current
            updated.bounds.has_exact <- false if capabilities.history != DebuggerCapabilities::HistoryKind.Exact
            updated.bounds.exact_first <- updated.bounds.current if capabilities.history != DebuggerCapabilities::HistoryKind.Exact
            updated.bounds.exact_last <- updated.bounds.current if capabilities.history != DebuggerCapabilities::HistoryKind.Exact
            return TimelineResult{timeline: updated, accepted: true, failure: DebuggerErrors::no_error()}

        def timeline_position_is_retained(timeline: Timeline&, event: u64) -> bool:
            return history_bounds_is_valid(timeline.bounds) and timeline.bounds.has_retained and event >= timeline.bounds.retained_first and event <= timeline.bounds.retained_last

        def timeline_position_is_exact(timeline: Timeline&, event: u64) -> bool:
            return history_bounds_is_valid(timeline.bounds) and timeline.bounds.has_exact and event >= timeline.bounds.exact_first and event <= timeline.bounds.exact_last

        def timeline_seek(timeline: Timeline, event: u64) -> TimelineResult:
            updated: mutable Timeline = timeline
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::QUERY_TIMELINE_DETAIL_RANGE)} if not history_bounds_is_valid(timeline.bounds)
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::QUERY_TIMELINE_DETAIL_RANGE)} if not timeline_position_is_retained(timeline, event)
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::QUERY_TIMELINE_DETAIL_CAPABILITY)} if event != timeline.bounds.current and not timeline_position_is_exact(timeline, event)
            updated.bounds.current <- event
            updated.position.event <- event
            return TimelineResult{timeline: updated, accepted: true, failure: DebuggerErrors::no_error()}

        def timeline_reverse(timeline: Timeline) -> TimelineResult:
            return TimelineResult{timeline: timeline, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::QUERY_TIMELINE_DETAIL_RANGE)} if not history_bounds_is_valid(timeline.bounds)
            return TimelineResult{timeline: timeline, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::QUERY_TIMELINE_DETAIL_RANGE)} if timeline.bounds.current == Sentinel::QUERY_TIMELINE_SENTINEL_EVENT
            return timeline_seek(timeline, timeline.bounds.current - Event::PREVIOUS_EVENT_DISTANCE)

        def timeline_add_bookmark(timeline: Timeline, label: DebuggerIdentity::DebugId, note: DebuggerIdentity::DebugId, pinned: bool) -> TimelineResult:
            updated: mutable Timeline = timeline
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::QUERY_TIMELINE_DETAIL_CAPACITY)} if timeline.bookmark_count > BookmarkLimits::QUERY_TIMELINE_BOOKMARK_LIMITS_CAPACITY
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::QUERY_TIMELINE_DETAIL_CAPACITY)} if timeline.bookmark_count >= BookmarkLimits::QUERY_TIMELINE_BOOKMARK_LIMITS_CAPACITY or timeline.next_bookmark_id == Sentinel::QUERY_TIMELINE_SENTINEL_BOOKMARK_ID or timeline.next_bookmark_id == Bounds::MAX_BOOKMARK_ID
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::BOOKMARK)} if not timeline_position_is_retained(timeline, timeline.bounds.current)
            for index in Index::FIRST_BOOKMARK_INDEX..<timeline.bookmark_count:
                return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::BOOKMARK)} if timeline.bookmarks[index].id.value == timeline.next_bookmark_id
            index: usize = timeline.bookmark_count
            updated.bookmarks[index] <- Bookmark{id: DebuggerIdentity::debug_id(timeline.next_bookmark_id), position: timeline.position, label: label, note: note, pinned: pinned}
            updated.bookmarks[index].position.event <- timeline.bounds.current
            updated.bookmark_count <- timeline.bookmark_count + Count::BOOKMARK_COUNT_INCREMENT
            updated.next_bookmark_id <- timeline.next_bookmark_id + First::QUERY_TIMELINE_FIRST_BOOKMARK_ID
            return TimelineResult{timeline: updated, accepted: true, failure: DebuggerErrors::no_error()}

        def timeline_find_bookmark(timeline: Timeline&, id: DebuggerIdentity::DebugId) -> Bookmark:
            result: mutable Bookmark = zeroed
            return result if timeline.bookmark_count > BookmarkLimits::QUERY_TIMELINE_BOOKMARK_LIMITS_CAPACITY
            for index in Index::FIRST_BOOKMARK_INDEX..<timeline.bookmark_count:
                return timeline.bookmarks[index] if timeline.bookmarks[index].id.value == id.value
            return result

        def timeline_seek_bookmark(timeline: Timeline, id: DebuggerIdentity::DebugId) -> TimelineResult:
            bookmark: Bookmark = timeline_find_bookmark(timeline, id)
            return TimelineResult{timeline: timeline, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::BOOKMARK)} if bookmark.id.value == Sentinel::QUERY_TIMELINE_SENTINEL_BOOKMARK_ID
            return timeline_seek(timeline, bookmark.position.event)

        def timeline_remove_bookmark(timeline: Timeline, id: DebuggerIdentity::DebugId) -> TimelineResult:
            updated: mutable Timeline = timeline
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::QUERY_TIMELINE_DETAIL_CAPACITY)} if timeline.bookmark_count > BookmarkLimits::QUERY_TIMELINE_BOOKMARK_LIMITS_CAPACITY
            for index in Index::FIRST_BOOKMARK_INDEX..<timeline.bookmark_count:
                if timeline.bookmarks[index].id.value == id.value:
                    updated.bookmarks[index] <- timeline.bookmarks[timeline.bookmark_count - Count::BOOKMARK_COUNT_INCREMENT]
                    updated.bookmark_count <- timeline.bookmark_count - Count::BOOKMARK_COUNT_INCREMENT
                    return TimelineResult{timeline: updated, accepted: true, failure: DebuggerErrors::no_error()}
            return TimelineResult{timeline: updated, accepted: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::BOOKMARK)}
