# Deterministic managed adapters for clocks, randomness, and console I/O.
# Recording stores call-shaped samples; replay consumes the same shape and
# suppresses real output. Branch callers can append virtual results without
# touching the original recording.

include "../core/errors.elisa"
include "../core/identity.elisa"

module DebuggerReplayAdapters:
    private:
        const module Adapter:
            SAMPLE_CAPACITY: usize = 128
            EMPTY_CURSOR: usize = 0
            MODE_MAX: u16 = 2
            ERROR_CODE_MAX: u16 = 12
            ERROR_SEVERITY_MAX: u16 = 2
            NO_ID: u64 = 0

        const module ConsoleLimits:
            RECORD_CAPACITY: usize = 64
            CHUNK_CAPACITY: usize = 256
            CHANNEL_MAX: u16 = 1
            RECORD_KIND_MAX: u16 = 1

        const module Detail:
            MODE: u32 = 1
            ID: u32 = 2
            CAPACITY: u32 = 3
            SEQUENCE: u32 = 4
            REQUEST: u32 = 5
            OUTPUT: u32 = 6
            INPUT: u32 = 7
            BYTES: u32 = 8


    public:
        const module Limits:
            SAMPLE_CAPACITY: usize = Adapter::SAMPLE_CAPACITY
            CONSOLE_RECORD_CAPACITY: usize = ConsoleLimits::RECORD_CAPACITY
            CONSOLE_CHUNK_CAPACITY: usize = ConsoleLimits::CHUNK_CAPACITY

        enum AdapterMode:
            Recording
            Replaying
            Branch

        enum ConsoleChannel:
            Stdout
            Stderr

        enum ConsoleRecordKind:
            Input
            Output

        struct AdapterSample:
            sequence: mutable u64
            source: mutable DebuggerIdentity::DebugId
            value: mutable u64

        struct Clock:
            samples: mutable AdapterSample[Adapter::SAMPLE_CAPACITY]
            count: mutable usize
            cursor: mutable usize
            mode: mutable AdapterMode
            exact: mutable bool
            last_error: mutable DebuggerErrors::DebuggerError

        struct ClockRead:
            value: mutable u64
            accepted: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        struct Random:
            samples: mutable AdapterSample[Adapter::SAMPLE_CAPACITY]
            count: mutable usize
            cursor: mutable usize
            mode: mutable AdapterMode
            exact: mutable bool
            last_error: mutable DebuggerErrors::DebuggerError

        struct RandomRead:
            value: mutable u64
            accepted: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        struct ConsoleRecord:
            sequence: mutable u64
            channel: mutable ConsoleChannel
            kind: mutable ConsoleRecordKind
            requested: mutable usize
            length: mutable usize
            eof: mutable bool
            bytes: mutable u8[ConsoleLimits::CHUNK_CAPACITY]

        struct Console:
            records: mutable ConsoleRecord[ConsoleLimits::RECORD_CAPACITY]
            count: mutable usize
            cursor: mutable usize
            mode: mutable AdapterMode
            exact: mutable bool
            output_suppressed: mutable bool
            last_error: mutable DebuggerErrors::DebuggerError

        struct ConsoleRead:
            transferred: mutable usize
            eof: mutable bool
            accepted: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        struct ConsoleWrite:
            transferred: mutable usize
            suppressed: mutable bool
            accepted: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        # Logical adapter state captured by a managed checkpoint. Keeping the
        # three streams together prevents callers from restoring only some of
        # the nondeterministic inputs and then claiming an exact replay.
        struct AdapterSnapshot:
            clock: mutable Clock
            random: mutable Random
            console: mutable Console

        def adapter_mode_code_is_valid(mode_code: u16) -> bool:
            return mode_code <= Adapter::MODE_MAX

        def console_channel_is_valid(channel: ConsoleChannel) -> bool:
            return channel.u16() <= ConsoleLimits::CHANNEL_MAX

        def console_record_kind_is_valid(kind: ConsoleRecordKind) -> bool:
            return kind.u16() <= ConsoleLimits::RECORD_KIND_MAX

        def adapter_error(code: DebuggerErrors::ErrorCode, detail: u32, retryable: bool) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(code, retryable, detail)

        def adapter_error_state_is_valid(adapter_failure: DebuggerErrors::DebuggerError) -> bool:
            return adapter_failure.code.u16() <= Adapter::ERROR_CODE_MAX and adapter_failure.severity.u16() <= Adapter::ERROR_SEVERITY_MAX

        # Reset the active extent only. Samples at or beyond count are
        # unreachable to readers and are overwritten before they become live.
        def clock_initialize(clock: mutable Clock&, mode: AdapterMode) -> void:
            clock.count <- 0
            clock.cursor <- 0
            clock.mode <- mode
            clock.exact <- adapter_mode_code_is_valid(mode.u16())
            clock.last_error <- DebuggerErrors::no_error()
            clock.last_error <- adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::MODE, false) if not adapter_mode_code_is_valid(mode.u16())

        def clock_record(clock: mutable Clock&, source: DebuggerIdentity::DebugId, value: u64) -> DebuggerErrors::DebuggerError:
            return clock.last_error if not DebuggerErrors::error_is_ok(clock.last_error)
            if not adapter_mode_code_is_valid(clock.mode.u16()):
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::MODE, false)
                clock.exact <- false
                clock.last_error <- failure
                return failure
            return adapter_error(DebuggerErrors::ErrorCode.InvalidState, Detail::MODE, false) if clock.mode == AdapterMode.Replaying
            if source.value == Adapter::NO_ID:
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::ID, false)
                clock.exact <- false
                clock.last_error <- failure
                return failure
            if clock.count >= Adapter::SAMPLE_CAPACITY:
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.ResourceLimit, Detail::CAPACITY, false)
                clock.exact <- false
                clock.last_error <- failure
                return failure
            clock.samples[clock.count] <- AdapterSample{sequence: clock.count.u64(), source: source, value: value}
            clock.count <- clock.count + 1
            clock.exact <- true
            return DebuggerErrors::no_error()

        def clock_read(clock: mutable Clock&, source: DebuggerIdentity::DebugId) -> ClockRead:
            result: mutable ClockRead = zeroed
            result.failure <- DebuggerErrors::no_error()
            if (clock.mode != AdapterMode.Replaying and clock.mode != AdapterMode.Branch) or not clock.exact or not DebuggerErrors::error_is_ok(clock.last_error):
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.InvalidState, Detail::MODE, false)
                return result
            if source.value == Adapter::NO_ID:
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::ID, false)
                return result
            if clock.count > Adapter::SAMPLE_CAPACITY or clock.cursor > clock.count:
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.Corrupt, Detail::CAPACITY, false)
                clock.exact <- false
                clock.last_error <- result.failure
                return result
            if clock.cursor >= clock.count:
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::SEQUENCE, false)
                clock.exact <- false
                clock.last_error <- result.failure
                return result
            sample: AdapterSample = clock.samples[clock.cursor]
            if sample.sequence != clock.cursor.u64() or sample.source.value != source.value:
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::REQUEST, false)
                clock.exact <- false
                clock.last_error <- result.failure
                return result
            result.value <- sample.value
            result.accepted <- true
            clock.cursor <- clock.cursor + 1
            return result

        def clock_is_exact(clock: Clock&) -> bool:
            return false if not clock.exact or not DebuggerErrors::error_is_ok(clock.last_error) or clock.count > Adapter::SAMPLE_CAPACITY or clock.cursor > clock.count or (clock.mode != AdapterMode.Replaying and clock.mode != AdapterMode.Branch)
            for index in 0..<clock.count:
                return false if clock.samples[index].sequence != index.u64() or clock.samples[index].source.value == Adapter::NO_ID
            return true

        def random_initialize(random: mutable Random&, mode: AdapterMode) -> void:
            random.count <- 0
            random.cursor <- 0
            random.mode <- mode
            random.exact <- adapter_mode_code_is_valid(mode.u16())
            random.last_error <- DebuggerErrors::no_error()
            random.last_error <- adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::MODE, false) if not adapter_mode_code_is_valid(mode.u16())

        def random_record(random: mutable Random&, source: DebuggerIdentity::DebugId, value: u64) -> DebuggerErrors::DebuggerError:
            return random.last_error if not DebuggerErrors::error_is_ok(random.last_error)
            if not adapter_mode_code_is_valid(random.mode.u16()):
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::MODE, false)
                random.exact <- false
                random.last_error <- failure
                return failure
            return adapter_error(DebuggerErrors::ErrorCode.InvalidState, Detail::MODE, false) if random.mode == AdapterMode.Replaying
            if source.value == Adapter::NO_ID:
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::ID, false)
                random.exact <- false
                random.last_error <- failure
                return failure
            if random.count >= Adapter::SAMPLE_CAPACITY:
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.ResourceLimit, Detail::CAPACITY, false)
                random.exact <- false
                random.last_error <- failure
                return failure
            random.samples[random.count] <- AdapterSample{sequence: random.count.u64(), source: source, value: value}
            random.count <- random.count + 1
            random.exact <- true
            return DebuggerErrors::no_error()

        def random_read(random: mutable Random&, source: DebuggerIdentity::DebugId) -> RandomRead:
            result: mutable RandomRead = zeroed
            result.failure <- DebuggerErrors::no_error()
            if (random.mode != AdapterMode.Replaying and random.mode != AdapterMode.Branch) or not random.exact or not DebuggerErrors::error_is_ok(random.last_error):
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.InvalidState, Detail::MODE, false)
                return result
            if source.value == Adapter::NO_ID:
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::ID, false)
                return result
            if random.count > Adapter::SAMPLE_CAPACITY or random.cursor > random.count:
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.Corrupt, Detail::CAPACITY, false)
                random.exact <- false
                random.last_error <- result.failure
                return result
            if random.cursor >= random.count:
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::SEQUENCE, false)
                random.exact <- false
                random.last_error <- result.failure
                return result
            sample: AdapterSample = random.samples[random.cursor]
            if sample.sequence != random.cursor.u64() or sample.source.value != source.value:
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::REQUEST, false)
                random.exact <- false
                random.last_error <- result.failure
                return result
            result.value <- sample.value
            result.accepted <- true
            random.cursor <- random.cursor + 1
            return result

        def random_is_exact(random: Random&) -> bool:
            return false if not random.exact or not DebuggerErrors::error_is_ok(random.last_error) or random.count > Adapter::SAMPLE_CAPACITY or random.cursor > random.count or (random.mode != AdapterMode.Replaying and random.mode != AdapterMode.Branch)
            for index in 0..<random.count:
                return false if random.samples[index].sequence != index.u64() or random.samples[index].source.value == Adapter::NO_ID
            return true

        def console_initialize(console: mutable Console&, mode: AdapterMode) -> void:
            console.count <- 0
            console.cursor <- 0
            console.mode <- mode
            console.exact <- adapter_mode_code_is_valid(mode.u16())
            console.output_suppressed <- mode == AdapterMode.Replaying or mode == AdapterMode.Branch
            console.last_error <- DebuggerErrors::no_error()
            console.last_error <- adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::MODE, false) if not adapter_mode_code_is_valid(mode.u16())

        def console_record(console: mutable Console&, kind: ConsoleRecordKind, channel: ConsoleChannel, bytes: u8&, length: usize) -> DebuggerErrors::DebuggerError:
            return console.last_error if not DebuggerErrors::error_is_ok(console.last_error)
            if not adapter_mode_code_is_valid(console.mode.u16()):
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::MODE, false)
                console.exact <- false
                console.last_error <- failure
                return failure
            return adapter_error(DebuggerErrors::ErrorCode.InvalidState, Detail::MODE, false) if console.mode == AdapterMode.Replaying
            if not console_record_kind_is_valid(kind) or not console_channel_is_valid(channel):
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::MODE, false)
                console.exact <- false
                console.last_error <- failure
                return failure
            if length > ConsoleLimits::CHUNK_CAPACITY or console.count >= ConsoleLimits::RECORD_CAPACITY:
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.ResourceLimit, Detail::BYTES, false)
                console.exact <- false
                console.last_error <- failure
                return failure
            console.records[console.count] <- ConsoleRecord{sequence: console.count.u64(), channel: channel, kind: kind, requested: length, length: length, eof: false, bytes: zeroed}
            for index in 0..<length:
                console.records[console.count].bytes[index] <- bytes[index]
            console.count <- console.count + 1
            console.exact <- true
            return DebuggerErrors::no_error()

        def console_read_input(console: mutable Console&, channel: ConsoleChannel, output: mutable u8&, requested: usize) -> ConsoleRead:
            result: mutable ConsoleRead = zeroed
            result.failure <- DebuggerErrors::no_error()
            if (console.mode != AdapterMode.Replaying and console.mode != AdapterMode.Branch) or not console.exact or not DebuggerErrors::error_is_ok(console.last_error):
                result.failure <- adapter_error(DebuggerErrors::ErrorCode.InvalidState, Detail::MODE, false)
                return result
            return console_read_input_replay(console, channel, output, requested, result)

        def console_read_input_replay(console: mutable Console&, channel: ConsoleChannel, output: mutable u8&, requested: usize, result: ConsoleRead) -> ConsoleRead:
            updated: mutable ConsoleRead = result
            if not console_channel_is_valid(channel) or requested > ConsoleLimits::CHUNK_CAPACITY:
                updated.failure <- adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::INPUT, false)
                return updated
            if console.count > ConsoleLimits::RECORD_CAPACITY or console.cursor > console.count:
                updated.failure <- adapter_error(DebuggerErrors::ErrorCode.Corrupt, Detail::CAPACITY, false)
                console.exact <- false
                console.last_error <- updated.failure
                return updated
            if console.cursor >= console.count:
                updated.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::SEQUENCE, false)
                console.exact <- false
                console.last_error <- updated.failure
                return updated
            record: ConsoleRecord = console.records[console.cursor]
            if record.sequence != console.cursor.u64() or record.kind != ConsoleRecordKind.Input or record.channel != channel or record.requested != requested or record.length > requested:
                updated.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::REQUEST, false)
                console.exact <- false
                console.last_error <- updated.failure
                return updated
            for index in 0..<record.length:
                output[index] <- record.bytes[index]
            updated.transferred <- record.length
            updated.eof <- record.eof
            updated.accepted <- true
            console.cursor <- console.cursor + 1
            return updated

        def console_record_input(console: mutable Console&, channel: ConsoleChannel, bytes: u8&, length: usize) -> DebuggerErrors::DebuggerError:
            return console_record(console, ConsoleRecordKind.Input, channel, bytes, length)

        # Record both sides of the read contract. The requested byte count is
        # part of the call shape, while length is the actual number received;
        # EOF and short reads are observable outcomes that replay must retain.
        def console_record_input_outcome(console: mutable Console&, channel: ConsoleChannel, bytes: u8&, requested: usize, transferred: usize, eof: bool) -> DebuggerErrors::DebuggerError:
            if requested > ConsoleLimits::CHUNK_CAPACITY or transferred > requested:
                failure: DebuggerErrors::DebuggerError = adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::INPUT, false)
                console.exact <- false
                console.last_error <- failure
                return failure
            failure: DebuggerErrors::DebuggerError = console_record(console, ConsoleRecordKind.Input, channel, bytes, transferred)
            return failure if not DebuggerErrors::error_is_ok(failure)
            record_index: usize = console.count - 1
            console.records[record_index].requested <- requested
            console.records[record_index].eof <- eof
            return DebuggerErrors::no_error()

        def console_write(console: mutable Console&, channel: ConsoleChannel, bytes: u8&, length: usize) -> ConsoleWrite:
            result: mutable ConsoleWrite = zeroed
            result.failure <- DebuggerErrors::no_error()
            return console_write_record(console, channel, bytes, length, result) if console.mode != AdapterMode.Replaying
            return console_write_replay(console, channel, bytes, length, result)

        def console_write_record(console: mutable Console&, channel: ConsoleChannel, bytes: u8&, length: usize, result: ConsoleWrite) -> ConsoleWrite:
            updated: mutable ConsoleWrite = result
            failure: DebuggerErrors::DebuggerError = console_record(console, ConsoleRecordKind.Output, channel, bytes, length)
            updated.failure <- failure
            return updated if not DebuggerErrors::error_is_ok(failure)
            updated.transferred <- length
            updated.suppressed <- console.output_suppressed or console.mode == AdapterMode.Branch
            updated.accepted <- true
            return updated

        def console_write_replay(console: mutable Console&, channel: ConsoleChannel, bytes: u8&, length: usize, result: ConsoleWrite) -> ConsoleWrite:
            updated: mutable ConsoleWrite = result
            if not console.exact or not DebuggerErrors::error_is_ok(console.last_error) or not console_channel_is_valid(channel) or length > ConsoleLimits::CHUNK_CAPACITY:
                updated.failure <- adapter_error(DebuggerErrors::ErrorCode.InvalidArgument, Detail::OUTPUT, false)
                return updated
            if console.count > ConsoleLimits::RECORD_CAPACITY or console.cursor > console.count or console.cursor >= console.count:
                updated.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::SEQUENCE, false)
                console.exact <- false
                console.last_error <- updated.failure
                return updated
            record: ConsoleRecord = console.records[console.cursor]
            if record.sequence != console.cursor.u64() or record.kind != ConsoleRecordKind.Output or record.channel != channel or record.requested != length or record.length != length or record.eof:
                updated.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::REQUEST, false)
                console.exact <- false
                console.last_error <- updated.failure
                return updated
            for index in 0..<length:
                if record.bytes[index] != bytes[index]:
                    updated.failure <- adapter_error(DebuggerErrors::ErrorCode.Diverged, Detail::OUTPUT, false)
                    console.exact <- false
                    console.last_error <- updated.failure
                    return updated
            console.cursor <- console.cursor + 1
            updated.transferred <- length
            updated.suppressed <- true
            updated.accepted <- true
            return updated

        def console_is_exact(console: Console&) -> bool:
            return false if not console.exact or not DebuggerErrors::error_is_ok(console.last_error) or console.count > ConsoleLimits::RECORD_CAPACITY or console.cursor > console.count or (console.mode != AdapterMode.Replaying and console.mode != AdapterMode.Branch)
            return false if (console.mode == AdapterMode.Replaying or console.mode == AdapterMode.Branch) and not console.output_suppressed
            for index in 0..<console.count:
                record: ConsoleRecord = console.records[index]
                return false if record.sequence != index.u64() or not console_channel_is_valid(record.channel) or not console_record_kind_is_valid(record.kind) or record.length > ConsoleLimits::CHUNK_CAPACITY
                return false if record.kind == ConsoleRecordKind.Input and (record.requested > ConsoleLimits::CHUNK_CAPACITY or record.length > record.requested)
                return false if record.kind == ConsoleRecordKind.Output and (record.requested != record.length or record.eof)
            return true

        def console_replay_complete(console: Console&) -> bool:
            return console_is_exact(console) and console.cursor == console.count

        def adapter_snapshot_initialize(snapshot: mutable AdapterSnapshot&, mode: AdapterMode) -> void:
            clock_initialize(snapshot.clock, mode)
            random_initialize(snapshot.random, mode)
            console_initialize(snapshot.console, mode)

        def adapter_snapshot_initialize_replay(snapshot: mutable AdapterSnapshot&) -> void:
            adapter_snapshot_initialize(snapshot, AdapterMode.Replaying)

        def adapter_snapshot_initialize_recording(snapshot: mutable AdapterSnapshot&) -> void:
            adapter_snapshot_initialize(snapshot, AdapterMode.Recording)

        def adapter_snapshot_begin_replay(snapshot: mutable AdapterSnapshot&) -> DebuggerErrors::DebuggerError:
            return adapter_error(DebuggerErrors::ErrorCode.Corrupt, Detail::CAPACITY, false) if not adapter_snapshot_is_valid(snapshot)
            return adapter_error(DebuggerErrors::ErrorCode.InvalidState, Detail::MODE, false) if snapshot.clock.mode != AdapterMode.Recording
            snapshot.clock.mode <- AdapterMode.Replaying
            snapshot.clock.cursor <- Adapter::EMPTY_CURSOR
            snapshot.random.mode <- AdapterMode.Replaying
            snapshot.random.cursor <- Adapter::EMPTY_CURSOR
            snapshot.console.mode <- AdapterMode.Replaying
            snapshot.console.cursor <- Adapter::EMPTY_CURSOR
            snapshot.console.output_suppressed <- true
            return DebuggerErrors::no_error()

        def clock_checkpoint_state_is_valid(clock: Clock&) -> bool:
            return false if not adapter_mode_code_is_valid(clock.mode.u16()) or not clock.exact or not DebuggerErrors::error_is_ok(clock.last_error) or not adapter_error_state_is_valid(clock.last_error) or clock.count > Adapter::SAMPLE_CAPACITY or clock.cursor > clock.count
            return false if clock.mode == AdapterMode.Recording and clock.cursor != 0
            return false if clock.mode != AdapterMode.Recording and clock.mode != AdapterMode.Replaying and clock.mode != AdapterMode.Branch
            for index in 0..<clock.count:
                return false if clock.samples[index].sequence != index.u64() or clock.samples[index].source.value == Adapter::NO_ID
            return true

        def random_checkpoint_state_is_valid(random: Random&) -> bool:
            return false if not adapter_mode_code_is_valid(random.mode.u16()) or not random.exact or not DebuggerErrors::error_is_ok(random.last_error) or not adapter_error_state_is_valid(random.last_error) or random.count > Adapter::SAMPLE_CAPACITY or random.cursor > random.count
            return false if random.mode == AdapterMode.Recording and random.cursor != 0
            return false if random.mode != AdapterMode.Recording and random.mode != AdapterMode.Replaying and random.mode != AdapterMode.Branch
            for index in 0..<random.count:
                return false if random.samples[index].sequence != index.u64() or random.samples[index].source.value == Adapter::NO_ID
            return true

        def console_checkpoint_state_is_valid(console: Console&) -> bool:
            return false if not adapter_mode_code_is_valid(console.mode.u16()) or not console.exact or not DebuggerErrors::error_is_ok(console.last_error) or not adapter_error_state_is_valid(console.last_error) or console.count > ConsoleLimits::RECORD_CAPACITY or console.cursor > console.count
            return false if console.mode == AdapterMode.Recording and console.cursor != 0
            return false if console.mode != AdapterMode.Recording and console.mode != AdapterMode.Replaying and console.mode != AdapterMode.Branch
            return false if console.mode == AdapterMode.Recording and console.output_suppressed
            return false if (console.mode == AdapterMode.Replaying or console.mode == AdapterMode.Branch) and not console.output_suppressed
            for index in 0..<console.count:
                record: ConsoleRecord = console.records[index]
                return false if record.sequence != index.u64() or not console_channel_is_valid(record.channel) or not console_record_kind_is_valid(record.kind) or record.length > ConsoleLimits::CHUNK_CAPACITY
                return false if record.kind == ConsoleRecordKind.Input and (record.requested > ConsoleLimits::CHUNK_CAPACITY or record.length > record.requested)
                return false if record.kind == ConsoleRecordKind.Output and (record.requested != record.length or record.eof)
            return true

        def adapter_snapshot_is_valid(snapshot: AdapterSnapshot&) -> bool:
            return false if snapshot.clock.mode != snapshot.random.mode or snapshot.clock.mode != snapshot.console.mode
            return clock_checkpoint_state_is_valid(snapshot.clock) and random_checkpoint_state_is_valid(snapshot.random) and console_checkpoint_state_is_valid(snapshot.console)
