# Immutable branch lineage and safe interventions.  Parent history is never
# mutated; branches reference a verified fork and carry only deltas.

include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerBranches:
    private:
        const BRANCH_CAPACITY: usize = 32
        const INTERVENTION_CAPACITY: usize = 16
        const INTERVENTION_NO_TARGET: u64 = 0
        const INTERVENTION_KIND_MAX: u16 = 3
        const BRANCH_FIRST_ID: u64 = 1
        const BRANCH_MAX_ID: u64 = 18446744073709551615

    public:
        enum InterventionKind:
            Value
            Input
            Schedule
            Error

        struct Intervention:
            event: mutable u64
            kind: mutable InterventionKind
            target: mutable DebuggerIdentity::DebugId
            value_hash: mutable u64

        struct BranchRecord:
            id: mutable DebuggerIdentity::DebugId
            parent: mutable DebuggerIdentity::DebugId
            fork_event: mutable u64
            state_hash: mutable u64
            intervention_count: mutable usize
            interventions: mutable Intervention[INTERVENTION_CAPACITY]

        struct BranchStore:
            branches: mutable BranchRecord[BRANCH_CAPACITY]
            count: mutable usize
            next_id: mutable u64

        def branches_new() -> BranchStore:
            store: mutable BranchStore = zeroed
            store.next_id <- BRANCH_FIRST_ID
            return store

        def branches_parent_exists(store: BranchStore, parent: DebuggerIdentity::DebugId) -> bool:
            return true if parent.value == 0
            return false if store.count > BRANCH_CAPACITY
            for index in 0..<store.count:
                return true if store.branches[index].id.value == parent.value
            return false

        def branches_fork(store: BranchStore, parent: DebuggerIdentity::DebugId, event: u64, state_hash: u64) -> BranchStore:
            updated: mutable BranchStore = store
            return updated if store.count >= BRANCH_CAPACITY or store.next_id == 0 or store.next_id == BRANCH_MAX_ID or not branches_parent_exists(store, parent)
            for index in 0..<store.count:
                return updated if store.branches[index].id.value == store.next_id
            updated.branches[store.count].id <- DebuggerIdentity::debug_id(store.next_id)
            updated.branches[store.count].parent <- parent
            updated.branches[store.count].fork_event <- event
            updated.branches[store.count].state_hash <- state_hash
            updated.branches[store.count].intervention_count <- 0
            updated.count <- store.count + 1
            updated.next_id <- store.next_id + 1
            return updated

        def branches_add_intervention(store: BranchStore, branch: DebuggerIdentity::DebugId, intervention: Intervention) -> BranchStore:
            updated: mutable BranchStore = store
            return updated if store.count > BRANCH_CAPACITY
            for index in 0..<store.count:
                if store.branches[index].id.value == branch.value:
                    return updated if store.branches[index].intervention_count >= INTERVENTION_CAPACITY
                    return updated if not branches_intervention_is_valid(store.branches[index], intervention)
                    if store.branches[index].intervention_count > 0:
                        last: Intervention = store.branches[index].interventions[store.branches[index].intervention_count - 1]
                        return updated if intervention.event < last.event
                    updated.branches[index].interventions[store.branches[index].intervention_count] <- intervention
                    updated.branches[index].intervention_count <- store.branches[index].intervention_count + 1
                    return updated
            return updated

        def branches_intervention_is_valid(branch: BranchRecord, intervention: Intervention) -> bool:
            return intervention.event >= branch.fork_event and intervention.kind.u16() <= INTERVENTION_KIND_MAX and intervention.target.value != INTERVENTION_NO_TARGET and branch.intervention_count < INTERVENTION_CAPACITY

        def branches_first_divergence(left: BranchRecord, right: BranchRecord) -> u64:
            return left.fork_event if left.parent.value != right.parent.value or left.fork_event != right.fork_event
            return left.fork_event if left.state_hash != right.state_hash
            return left.fork_event if left.intervention_count > INTERVENTION_CAPACITY or right.intervention_count > INTERVENTION_CAPACITY
            limit: usize = left.intervention_count if left.intervention_count < right.intervention_count else right.intervention_count
            for index in 0..<limit:
                return left.interventions[index].event if left.interventions[index].event != right.interventions[index].event or left.interventions[index].kind != right.interventions[index].kind or left.interventions[index].target.value != right.interventions[index].target.value or left.interventions[index].value_hash != right.interventions[index].value_hash
            return BRANCH_MAX_ID if left.intervention_count == right.intervention_count
            return left.interventions[limit].event if left.intervention_count > limit
            return right.interventions[limit].event
