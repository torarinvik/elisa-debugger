# Managed checkpoints are complete logical machine state, not raw host memory.
# They can be restored into a fresh VM and compared with forward replay.

include "../core/identity.elisa"
include "../vm/edir.elisa"

module DebuggerCheckpoint:
    private:
        const SNAPSHOT_MAX_LOCALS: usize = 32
        const SNAPSHOT_MAX_CALL_DEPTH: usize = 16

    public:
        struct MachineSnapshot:
            id: mutable DebuggerIdentity::DebugId
            event: mutable u64
            state_hash: mutable u64
            program_counter: mutable u64
            accumulator: mutable i64
            locals: mutable i64[SNAPSHOT_MAX_LOCALS]
            return_stack: mutable u64[SNAPSHOT_MAX_CALL_DEPTH]
            return_stack_pointer: mutable usize
            halted: mutable bool
            faulted: mutable bool
            steps: mutable u64
            result: mutable i64

        def snapshot_capture(machine: DebuggerEDIR::Machine, id: DebuggerIdentity::DebugId, event: u64, state_hash: u64) -> MachineSnapshot:
            snapshot: mutable MachineSnapshot = zeroed
            snapshot.id <- id
            snapshot.event <- event
            snapshot.state_hash <- state_hash
            snapshot.program_counter <- machine.program_counter
            snapshot.accumulator <- machine.accumulator
            snapshot.locals <- machine.locals
            snapshot.return_stack <- machine.return_stack
            snapshot.return_stack_pointer <- machine.return_stack_pointer
            snapshot.halted <- machine.halted
            snapshot.faulted <- machine.faulted
            snapshot.steps <- machine.steps
            snapshot.result <- machine.result
            return snapshot

        def snapshot_restore(snapshot: MachineSnapshot) -> DebuggerEDIR::Machine:
            machine: mutable DebuggerEDIR::Machine = zeroed
            machine.program_counter <- snapshot.program_counter
            machine.accumulator <- snapshot.accumulator
            machine.locals <- snapshot.locals
            machine.return_stack <- snapshot.return_stack
            machine.return_stack_pointer <- snapshot.return_stack_pointer
            machine.halted <- snapshot.halted
            machine.faulted <- snapshot.faulted
            machine.steps <- snapshot.steps
            machine.result <- snapshot.result
            return machine

        def snapshot_matches_machine(snapshot: MachineSnapshot, machine: DebuggerEDIR::Machine) -> bool:
            return snapshot.program_counter == machine.program_counter and snapshot.accumulator == machine.accumulator and snapshot.return_stack_pointer == machine.return_stack_pointer and snapshot.halted == machine.halted and snapshot.faulted == machine.faulted and snapshot.steps == machine.steps and snapshot.result == machine.result
