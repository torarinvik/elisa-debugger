# Managed checkpoints are complete logical machine state, not raw host memory.
# They can be restored into a fresh VM and compared with forward replay.

include "../core/identity.elisa"
include "../vm/edir.elisa"

module DebuggerCheckpoint:
    private:
        const module Capacity:
            REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS: usize = 32
            REPLAY_CHECKPOINT_SNAPSHOT_MAX_GLOBALS: usize = 16
            REPLAY_CHECKPOINT_SNAPSHOT_MAX_MEMORY: usize = 64
            REPLAY_CHECKPOINT_SNAPSHOT_MAX_CALL_DEPTH: usize = 16
            REPLAY_CHECKPOINT_SNAPSHOT_FRAME_LOCAL_CAPACITY: usize = Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_CALL_DEPTH * Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS
            REPLAY_CHECKPOINT_SNAPSHOT_MAX_PROGRAM_COUNTER: u64 = 256

        const module Identity:
            REPLAY_CHECKPOINT_SNAPSHOT_INVALID_ID: u64 = 0

        const module Hash:
            REPLAY_CHECKPOINT_SNAPSHOT_HASH_OFFSET_BASIS: u64 = 1469598103934665603
            REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME: u64 = 1099511628211
            REPLAY_CHECKPOINT_SNAPSHOT_HASH_FALSE: u64 = 0
            REPLAY_CHECKPOINT_SNAPSHOT_HASH_TRUE: u64 = 1


    public:
        struct MachineSnapshot:
            id: mutable DebuggerIdentity::DebugId
            event: mutable u64
            state_hash: mutable u64
            program_counter: mutable u64
            accumulator: mutable i64
            locals: mutable i64[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS]
            locals_initialized: mutable bool[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS]
            frame_locals: mutable i64[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_FRAME_LOCAL_CAPACITY]
            frame_locals_initialized: mutable bool[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_FRAME_LOCAL_CAPACITY]
            globals: mutable i64[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_GLOBALS]
            globals_initialized: mutable bool[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_GLOBALS]
            memory: mutable i64[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_MEMORY]
            memory_initialized: mutable bool[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_MEMORY]
            heap_next: mutable usize
            return_stack: mutable u64[Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_CALL_DEPTH]
            return_stack_pointer: mutable usize
            halted: mutable bool
            faulted: mutable bool
            steps: mutable u64
            result: mutable i64

        def snapshot_capture(machine: DebuggerEDIR::Machine&, id: DebuggerIdentity::DebugId, event: u64, state_hash: u64) -> MachineSnapshot:
            snapshot: mutable MachineSnapshot = zeroed
            snapshot.id <- id
            snapshot.event <- event
            snapshot.state_hash <- state_hash
            snapshot.program_counter <- machine.program_counter
            snapshot.accumulator <- machine.accumulator
            snapshot.locals <- machine.locals
            snapshot.locals_initialized <- machine.locals_initialized
            snapshot.frame_locals <- machine.frame_locals
            snapshot.frame_locals_initialized <- machine.frame_locals_initialized
            snapshot.globals <- machine.globals
            snapshot.globals_initialized <- machine.globals_initialized
            snapshot.memory <- machine.memory
            snapshot.memory_initialized <- machine.memory_initialized
            snapshot.heap_next <- machine.heap_next
            snapshot.return_stack <- machine.return_stack
            snapshot.return_stack_pointer <- machine.return_stack_pointer
            snapshot.halted <- machine.halted
            snapshot.faulted <- machine.faulted
            snapshot.steps <- machine.steps
            snapshot.result <- machine.result
            return snapshot

        def snapshot_restore(snapshot: MachineSnapshot&) -> DebuggerEDIR::Machine:
            machine: mutable DebuggerEDIR::Machine = zeroed
            if not snapshot_shape_is_valid(snapshot):
                machine.halted <- true
                machine.faulted <- true
                return machine
            machine.program_counter <- snapshot.program_counter
            machine.accumulator <- snapshot.accumulator
            machine.locals <- snapshot.locals
            machine.locals_initialized <- snapshot.locals_initialized
            machine.frame_locals <- snapshot.frame_locals
            machine.frame_locals_initialized <- snapshot.frame_locals_initialized
            machine.globals <- snapshot.globals
            machine.globals_initialized <- snapshot.globals_initialized
            machine.memory <- snapshot.memory
            machine.memory_initialized <- snapshot.memory_initialized
            machine.heap_next <- snapshot.heap_next
            machine.return_stack <- snapshot.return_stack
            machine.return_stack_pointer <- snapshot.return_stack_pointer
            machine.halted <- snapshot.halted
            machine.faulted <- snapshot.faulted
            machine.steps <- snapshot.steps
            machine.result <- snapshot.result
            return machine

        def snapshot_shape_is_valid(snapshot: MachineSnapshot&) -> bool:
            return false if snapshot.id.value == Identity::REPLAY_CHECKPOINT_SNAPSHOT_INVALID_ID or snapshot.program_counter >= Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_PROGRAM_COUNTER or snapshot.heap_next > Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_MEMORY or snapshot.return_stack_pointer > Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_CALL_DEPTH or snapshot.faulted and not snapshot.halted
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS:
                return false if not snapshot.locals_initialized[index] and snapshot.locals[index] != 0
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_FRAME_LOCAL_CAPACITY:
                return false if not snapshot.frame_locals_initialized[index] and snapshot.frame_locals[index] != 0
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_GLOBALS:
                return false if not snapshot.globals_initialized[index] and snapshot.globals[index] != 0
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_MEMORY:
                return false if index >= snapshot.heap_next and snapshot.memory_initialized[index]
                return false if not snapshot.memory_initialized[index] and snapshot.memory[index] != 0
            for stack_index in 0..<snapshot.return_stack_pointer:
                return false if snapshot.return_stack[stack_index] >= Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_PROGRAM_COUNTER
            for depth in snapshot.return_stack_pointer..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_CALL_DEPTH:
                for local in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS:
                    frame_index: usize = depth * Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS + local
                    return false if snapshot.frame_locals_initialized[frame_index]
            return true

        def snapshot_state_hash(snapshot: MachineSnapshot&) -> u64:
            hash: mutable u64 = Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_OFFSET_BASIS + snapshot.program_counter
            hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.accumulator.u64()
            hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.result.u64()
            hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.return_stack_pointer.u64()
            hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.heap_next.u64()
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS:
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.locals[index].u64()
                initialized: mutable u64 = Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_FALSE
                initialized <- Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_TRUE if snapshot.locals_initialized[index]
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + initialized
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_FRAME_LOCAL_CAPACITY:
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.frame_locals[index].u64()
                initialized: mutable u64 = Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_FALSE
                initialized <- Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_TRUE if snapshot.frame_locals_initialized[index]
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + initialized
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_CALL_DEPTH:
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.return_stack[index]
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_GLOBALS:
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.globals[index].u64()
                initialized: mutable u64 = Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_FALSE
                initialized <- Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_TRUE if snapshot.globals_initialized[index]
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + initialized
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_MEMORY:
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.memory[index].u64()
                initialized: mutable u64 = Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_FALSE
                initialized <- Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_TRUE if snapshot.memory_initialized[index]
                hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + initialized
            hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.event
            halted: mutable u64 = Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_FALSE
            halted <- Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_TRUE if snapshot.halted
            hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + halted
            faulted: mutable u64 = Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_FALSE
            faulted <- Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_TRUE if snapshot.faulted
            hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + faulted
            hash <- hash * Hash::REPLAY_CHECKPOINT_SNAPSHOT_HASH_PRIME + snapshot.steps
            return hash

        def snapshot_matches_machine(snapshot: MachineSnapshot&, machine: DebuggerEDIR::Machine&) -> bool:
            return false if not snapshot_shape_is_valid(snapshot)
            return false if snapshot.state_hash != snapshot_state_hash(snapshot)
            return false if snapshot.program_counter != machine.program_counter or snapshot.accumulator != machine.accumulator or snapshot.heap_next != machine.heap_next or snapshot.return_stack_pointer != machine.return_stack_pointer or snapshot.halted != machine.halted or snapshot.faulted != machine.faulted or snapshot.steps != machine.steps or snapshot.result != machine.result
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_LOCALS:
                return false if snapshot.locals[index] != machine.locals[index]
                return false if snapshot.locals_initialized[index] != machine.locals_initialized[index]
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_FRAME_LOCAL_CAPACITY:
                return false if snapshot.frame_locals[index] != machine.frame_locals[index] or snapshot.frame_locals_initialized[index] != machine.frame_locals_initialized[index]
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_GLOBALS:
                return false if snapshot.globals[index] != machine.globals[index] or snapshot.globals_initialized[index] != machine.globals_initialized[index]
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_MEMORY:
                return false if snapshot.memory[index] != machine.memory[index] or snapshot.memory_initialized[index] != machine.memory_initialized[index]
            for index in 0..<Capacity::REPLAY_CHECKPOINT_SNAPSHOT_MAX_CALL_DEPTH:
                return false if snapshot.return_stack[index] != machine.return_stack[index]
            return true
