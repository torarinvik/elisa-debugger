# Canonical checkpoint bytes.  This codec serializes logical managed state in
# field order, so a checkpoint can be restored after the debugger process exits.

include "./checkpoint.elisa"
include "../trace/binary.elisa"

module DebuggerCheckpointCodec:
    private:
        const CHECKPOINT_SCHEMA: u32 = 1
        const CHECKPOINT_LOCAL_CAPACITY: usize = 32
        const CHECKPOINT_GLOBAL_CAPACITY: usize = 16
        const CHECKPOINT_MEMORY_CAPACITY: usize = 64
        const CHECKPOINT_STACK_CAPACITY: usize = 16
        const BOOLEAN_FALSE: u8 = 0
        const BOOLEAN_TRUE: u8 = 1
        const CHECKPOINT_SCHEMA_BYTES: usize = 4
        const CHECKPOINT_INTEGER_BYTES: usize = 8
        const CHECKPOINT_SCALAR_COUNT: usize = 9
        const CHECKPOINT_FLAG_COUNT: usize = 2
        const CHECKPOINT_ENCODED_BYTES: usize = CHECKPOINT_SCHEMA_BYTES + CHECKPOINT_INTEGER_BYTES * (CHECKPOINT_SCALAR_COUNT + CHECKPOINT_LOCAL_CAPACITY + CHECKPOINT_GLOBAL_CAPACITY + CHECKPOINT_MEMORY_CAPACITY + CHECKPOINT_STACK_CAPACITY) + CHECKPOINT_MEMORY_CAPACITY + CHECKPOINT_FLAG_COUNT
        const CHECKPOINT_SCHEMA_BYTE_0: u8 = 1
        const CHECKPOINT_SCHEMA_BYTE_1: u8 = 0
        const CHECKPOINT_SCHEMA_BYTE_2: u8 = 0
        const CHECKPOINT_SCHEMA_BYTE_3: u8 = 0
        const CHECKPOINT_MAX_PROGRAM_COUNTER: u64 = 256
        const CHECKPOINT_MAX_HEAP: usize = 64
        const CHECKPOINT_MAX_STACK_POINTER: usize = 16
        const CHECKPOINT_SCALARS_BEFORE_MEMORY: usize = 5
        const CHECKPOINT_PROGRAM_COUNTER_OFFSET: usize = CHECKPOINT_SCHEMA_BYTES + CHECKPOINT_INTEGER_BYTES * 3
        const CHECKPOINT_HEAP_OFFSET: usize = CHECKPOINT_SCHEMA_BYTES + CHECKPOINT_INTEGER_BYTES * (CHECKPOINT_SCALARS_BEFORE_MEMORY + CHECKPOINT_LOCAL_CAPACITY + CHECKPOINT_GLOBAL_CAPACITY + CHECKPOINT_MEMORY_CAPACITY) + CHECKPOINT_MEMORY_CAPACITY
        const CHECKPOINT_STACK_POINTER_OFFSET: usize = CHECKPOINT_HEAP_OFFSET + CHECKPOINT_INTEGER_BYTES * (1 + CHECKPOINT_STACK_CAPACITY)
        const CHECKPOINT_FLAGS_OFFSET: usize = CHECKPOINT_STACK_POINTER_OFFSET + CHECKPOINT_INTEGER_BYTES

    public:
        def checkpoint_encode(snapshot: DebuggerCheckpoint::MachineSnapshot) -> DebuggerTraceBinary::ByteWriter:
            writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
            writer <- DebuggerTraceBinary::writer_put_u32(writer, CHECKPOINT_SCHEMA)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.id.value)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.event)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.state_hash)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.program_counter)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.accumulator.u64())
            for index in 0..<CHECKPOINT_LOCAL_CAPACITY:
                writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.locals[index].u64())
            for index in 0..<CHECKPOINT_GLOBAL_CAPACITY:
                writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.globals[index].u64())
            for index in 0..<CHECKPOINT_MEMORY_CAPACITY:
                writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.memory[index].u64())
                initialized: mutable u8 = BOOLEAN_FALSE
                initialized <- BOOLEAN_TRUE if snapshot.memory_initialized[index]
                writer <- DebuggerTraceBinary::writer_put_byte(writer, initialized)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.heap_next.u64())
            for index in 0..<CHECKPOINT_STACK_CAPACITY:
                writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.return_stack[index])
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.return_stack_pointer.u64())
            halted: mutable u8 = BOOLEAN_FALSE
            halted <- BOOLEAN_TRUE if snapshot.halted
            faulted: mutable u8 = BOOLEAN_FALSE
            faulted <- BOOLEAN_TRUE if snapshot.faulted
            writer <- DebuggerTraceBinary::writer_put_byte(writer, halted)
            writer <- DebuggerTraceBinary::writer_put_byte(writer, faulted)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.steps)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, snapshot.result.u64())
            return writer

        def checkpoint_decode(reader: mutable DebuggerTraceBinary::ByteReader&) -> DebuggerCheckpoint::MachineSnapshot:
            snapshot: mutable DebuggerCheckpoint::MachineSnapshot = zeroed
            schema: u32 = DebuggerTraceBinary::reader_take_u32(reader)
            snapshot.id <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            snapshot.event <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.state_hash <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.program_counter <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.accumulator <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            for index in 0..<CHECKPOINT_LOCAL_CAPACITY:
                snapshot.locals[index] <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            for index in 0..<CHECKPOINT_GLOBAL_CAPACITY:
                snapshot.globals[index] <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            for index in 0..<CHECKPOINT_MEMORY_CAPACITY:
                snapshot.memory[index] <- DebuggerTraceBinary::reader_take_u64(reader).i64()
                snapshot.memory_initialized[index] <- DebuggerTraceBinary::reader_take_byte(reader) == BOOLEAN_TRUE
            snapshot.heap_next <- DebuggerTraceBinary::reader_take_u64(reader).usize()
            for index in 0..<CHECKPOINT_STACK_CAPACITY:
                snapshot.return_stack[index] <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.return_stack_pointer <- DebuggerTraceBinary::reader_take_u64(reader).usize()
            snapshot.halted <- DebuggerTraceBinary::reader_take_byte(reader) == BOOLEAN_TRUE
            snapshot.faulted <- DebuggerTraceBinary::reader_take_byte(reader) == BOOLEAN_TRUE
            snapshot.steps <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.result <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            snapshot.id <- DebuggerIdentity::debug_id(0) if schema != CHECKPOINT_SCHEMA
            return snapshot

        def checkpoint_bytes_are_valid(reader: DebuggerTraceBinary::ByteReader) -> bool:
            return false if not DebuggerTraceBinary::reader_is_valid(reader) or reader.offset != 0 or reader.length != CHECKPOINT_ENCODED_BYTES
            return false if reader.bytes[0] != CHECKPOINT_SCHEMA_BYTE_0 or reader.bytes[1] != CHECKPOINT_SCHEMA_BYTE_1 or reader.bytes[2] != CHECKPOINT_SCHEMA_BYTE_2 or reader.bytes[3] != CHECKPOINT_SCHEMA_BYTE_3
            return false if reader.bytes[CHECKPOINT_FLAGS_OFFSET] > BOOLEAN_TRUE or reader.bytes[CHECKPOINT_FLAGS_OFFSET + 1] > BOOLEAN_TRUE
            for index in 0..<CHECKPOINT_MEMORY_CAPACITY:
                flag_offset: usize = CHECKPOINT_SCHEMA_BYTES + CHECKPOINT_INTEGER_BYTES * (CHECKPOINT_SCALARS_BEFORE_MEMORY + CHECKPOINT_LOCAL_CAPACITY + CHECKPOINT_GLOBAL_CAPACITY) + index * (CHECKPOINT_INTEGER_BYTES + 1) + CHECKPOINT_INTEGER_BYTES
                return false if reader.bytes[flag_offset] > BOOLEAN_TRUE
            heap_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(reader.bytes[CHECKPOINT_HEAP_OFFSET], CHECKPOINT_INTEGER_BYTES)
            heap_next: u64 = DebuggerTraceBinary::reader_take_u64(heap_reader)
            pc_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(reader.bytes[CHECKPOINT_PROGRAM_COUNTER_OFFSET], CHECKPOINT_INTEGER_BYTES)
            program_counter: u64 = DebuggerTraceBinary::reader_take_u64(pc_reader)
            stack_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(reader.bytes[CHECKPOINT_STACK_POINTER_OFFSET], CHECKPOINT_INTEGER_BYTES)
            stack_pointer: u64 = DebuggerTraceBinary::reader_take_u64(stack_reader)
            return false if program_counter >= CHECKPOINT_MAX_PROGRAM_COUNTER or heap_next > CHECKPOINT_MAX_HEAP.u64() or stack_pointer > CHECKPOINT_MAX_STACK_POINTER.u64()
            return true
