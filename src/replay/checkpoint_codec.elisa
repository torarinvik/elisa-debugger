# Canonical checkpoint bytes.  This codec serializes logical managed state in
# field order, so a checkpoint can be restored after the debugger process exits.

include "./checkpoint.elisa"
include "../trace/binary.elisa"

const module DebuggerCheckpointWireLayout:
    CHECKPOINT_LOCAL_CAPACITY: usize = 32
    CHECKPOINT_FRAME_LOCAL_CAPACITY: usize = 512
    CHECKPOINT_GLOBAL_CAPACITY: usize = 16
    CHECKPOINT_MEMORY_CAPACITY: usize = 64
    CHECKPOINT_STACK_CAPACITY: usize = 16
    CHECKPOINT_SCHEMA_BYTES: usize = 4
    CHECKPOINT_INTEGER_BYTES: usize = 8
    CHECKPOINT_SCALAR_COUNT: usize = 9
    CHECKPOINT_FLAG_COUNT: usize = 2
    CHECKPOINT_BOOLEAN_ARRAY_COUNT: usize = CHECKPOINT_LOCAL_CAPACITY + CHECKPOINT_FRAME_LOCAL_CAPACITY + CHECKPOINT_GLOBAL_CAPACITY
    CHECKPOINT_PAYLOAD_BYTES: usize = CHECKPOINT_SCHEMA_BYTES + CHECKPOINT_INTEGER_BYTES * (CHECKPOINT_SCALAR_COUNT + CHECKPOINT_LOCAL_CAPACITY + CHECKPOINT_FRAME_LOCAL_CAPACITY + CHECKPOINT_GLOBAL_CAPACITY + CHECKPOINT_MEMORY_CAPACITY + CHECKPOINT_STACK_CAPACITY) + CHECKPOINT_MEMORY_CAPACITY + CHECKPOINT_BOOLEAN_ARRAY_COUNT + CHECKPOINT_FLAG_COUNT

module DebuggerCheckpointCodec:
    private:
        const module Boolean:
            REPLAY_CHECKPOINT_CODEC_BOOLEAN_FALSE: u8 = 0
            REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE: u8 = 1

        const module SchemaByteOffset:
            BYTE_0: usize = 0
            BYTE_1: usize = 1
            BYTE_2: usize = 2
            BYTE_3: usize = 3

        const module Index:
            FIRST_INDEX: usize = 0

        const module CheckpointCodecLayout:
            REPLAY_CHECKPOINT_CODEC_LAYOUT_SCHEMA: u32 = 3
            REPLAY_CHECKPOINT_CODEC_LAYOUT_LOCAL_CAPACITY: usize = DebuggerCheckpointWireLayout::CHECKPOINT_LOCAL_CAPACITY
            REPLAY_CHECKPOINT_CODEC_LAYOUT_FRAME_LOCAL_CAPACITY: usize = DebuggerCheckpointWireLayout::CHECKPOINT_FRAME_LOCAL_CAPACITY
            REPLAY_CHECKPOINT_CODEC_LAYOUT_GLOBAL_CAPACITY: usize = DebuggerCheckpointWireLayout::CHECKPOINT_GLOBAL_CAPACITY
            REPLAY_CHECKPOINT_CODEC_LAYOUT_MEMORY_CAPACITY: usize = DebuggerCheckpointWireLayout::CHECKPOINT_MEMORY_CAPACITY
            STACK_CAPACITY: usize = DebuggerCheckpointWireLayout::CHECKPOINT_STACK_CAPACITY
            REPLAY_CHECKPOINT_CODEC_LAYOUT_SCHEMA_BYTES: usize = DebuggerCheckpointWireLayout::CHECKPOINT_SCHEMA_BYTES
            INTEGER_BYTES: usize = DebuggerCheckpointWireLayout::CHECKPOINT_INTEGER_BYTES
            SCALAR_COUNT: usize = DebuggerCheckpointWireLayout::CHECKPOINT_SCALAR_COUNT
            FLAG_COUNT: usize = DebuggerCheckpointWireLayout::CHECKPOINT_FLAG_COUNT
            BOOLEAN_ARRAY_COUNT: usize = DebuggerCheckpointWireLayout::CHECKPOINT_BOOLEAN_ARRAY_COUNT
            REPLAY_CHECKPOINT_CODEC_LAYOUT_ENCODED_BYTES: usize = DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES
            SCHEMA_BYTE_0: u8 = 3
            SCHEMA_BYTE_1: u8 = 0
            SCHEMA_BYTE_2: u8 = 0
            SCHEMA_BYTE_3: u8 = 0
            REPLAY_CHECKPOINT_CODEC_LAYOUT_MAX_PROGRAM_COUNTER: u64 = 256
            REPLAY_CHECKPOINT_CODEC_LAYOUT_MAX_HEAP: usize = 64
            MAX_STACK_POINTER: usize = 16
            REPLAY_CHECKPOINT_CODEC_LAYOUT_INVALID_ID: u64 = 0
            REPLAY_CHECKPOINT_CODEC_LAYOUT_ID_OFFSET: usize = CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_SCHEMA_BYTES
            REPLAY_CHECKPOINT_CODEC_LAYOUT_PAYLOAD_BYTES: usize = CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_ENCODED_BYTES


    public:
        # The durable trace container uses this canonical size to reserve a
        # complete machine snapshot in one checkpoint chunk.

        def checkpoint_encode_into(snapshot: DebuggerCheckpoint::MachineSnapshot&, writer: mutable DebuggerTraceBinary::ByteWriter&) -> void:
            DebuggerTraceBinary::writer_initialize(writer)
            if snapshot.id.value == CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_INVALID_ID or not DebuggerCheckpoint::snapshot_shape_is_valid(snapshot) or snapshot.state_hash != DebuggerCheckpoint::snapshot_state_hash(snapshot):
                writer.failed <- true
                return
            DebuggerTraceBinary::writer_put_u32(writer, CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_SCHEMA)
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.id.value)
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.event)
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.state_hash)
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.program_counter)
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.accumulator.u64())
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_LOCAL_CAPACITY:
                DebuggerTraceBinary::writer_put_u64(writer, snapshot.locals[index].u64())
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_GLOBAL_CAPACITY:
                DebuggerTraceBinary::writer_put_u64(writer, snapshot.globals[index].u64())
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_GLOBAL_CAPACITY:
                initialized: mutable u8 = Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_FALSE
                initialized <- Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE if snapshot.globals_initialized[index]
                DebuggerTraceBinary::writer_put_byte(writer, initialized)
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_MEMORY_CAPACITY:
                DebuggerTraceBinary::writer_put_u64(writer, snapshot.memory[index].u64())
                initialized: mutable u8 = Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_FALSE
                initialized <- Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE if snapshot.memory_initialized[index]
                DebuggerTraceBinary::writer_put_byte(writer, initialized)
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.heap_next.u64())
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::STACK_CAPACITY:
                DebuggerTraceBinary::writer_put_u64(writer, snapshot.return_stack[index])
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.return_stack_pointer.u64())
            halted: mutable u8 = Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_FALSE
            halted <- Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE if snapshot.halted
            faulted: mutable u8 = Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_FALSE
            faulted <- Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE if snapshot.faulted
            DebuggerTraceBinary::writer_put_byte(writer, halted)
            DebuggerTraceBinary::writer_put_byte(writer, faulted)
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.steps)
            DebuggerTraceBinary::writer_put_u64(writer, snapshot.result.u64())
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_LOCAL_CAPACITY:
                initialized: mutable u8 = Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_FALSE
                initialized <- Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE if snapshot.locals_initialized[index]
                DebuggerTraceBinary::writer_put_byte(writer, initialized)
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_FRAME_LOCAL_CAPACITY:
                DebuggerTraceBinary::writer_put_u64(writer, snapshot.frame_locals[index].u64())
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_FRAME_LOCAL_CAPACITY:
                initialized: mutable u8 = Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_FALSE
                initialized <- Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE if snapshot.frame_locals_initialized[index]
                DebuggerTraceBinary::writer_put_byte(writer, initialized)
            return

        def checkpoint_encode(snapshot: DebuggerCheckpoint::MachineSnapshot&) -> DebuggerTraceBinary::ByteWriter:
            writer: mutable DebuggerTraceBinary::ByteWriter = zeroed
            checkpoint_encode_into(snapshot, writer)
            return writer

        def checkpoint_decode(reader: mutable DebuggerTraceBinary::ByteReader&) -> DebuggerCheckpoint::MachineSnapshot:
            snapshot: mutable DebuggerCheckpoint::MachineSnapshot = zeroed
            decode_valid: mutable bool = true
            schema: u32 = DebuggerTraceBinary::reader_take_u32(reader)
            snapshot.id <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            snapshot.event <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.state_hash <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.program_counter <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.accumulator <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_LOCAL_CAPACITY:
                snapshot.locals[index] <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_GLOBAL_CAPACITY:
                snapshot.globals[index] <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_GLOBAL_CAPACITY:
                initialized: u8 = DebuggerTraceBinary::reader_take_byte(reader)
                decode_valid <- false if initialized > Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
                snapshot.globals_initialized[index] <- initialized == Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_MEMORY_CAPACITY:
                snapshot.memory[index] <- DebuggerTraceBinary::reader_take_u64(reader).i64()
                initialized: u8 = DebuggerTraceBinary::reader_take_byte(reader)
                decode_valid <- false if initialized > Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
                snapshot.memory_initialized[index] <- initialized == Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
            heap_next: u64 = DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.heap_next <- heap_next.usize()
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::STACK_CAPACITY:
                snapshot.return_stack[index] <- DebuggerTraceBinary::reader_take_u64(reader)
            stack_pointer: u64 = DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.return_stack_pointer <- stack_pointer.usize()
            halted: u8 = DebuggerTraceBinary::reader_take_byte(reader)
            faulted: u8 = DebuggerTraceBinary::reader_take_byte(reader)
            decode_valid <- false if halted > Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE or faulted > Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
            snapshot.halted <- halted == Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
            snapshot.faulted <- faulted == Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
            decode_valid <- false if snapshot.faulted and not snapshot.halted
            snapshot.steps <- DebuggerTraceBinary::reader_take_u64(reader)
            snapshot.result <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_LOCAL_CAPACITY:
                initialized: u8 = DebuggerTraceBinary::reader_take_byte(reader)
                decode_valid <- false if initialized > Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
                snapshot.locals_initialized[index] <- initialized == Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_FRAME_LOCAL_CAPACITY:
                snapshot.frame_locals[index] <- DebuggerTraceBinary::reader_take_u64(reader).i64()
            for index in Index::FIRST_INDEX..<CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_FRAME_LOCAL_CAPACITY:
                initialized: u8 = DebuggerTraceBinary::reader_take_byte(reader)
                decode_valid <- false if initialized > Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
                snapshot.frame_locals_initialized[index] <- initialized == Boolean::REPLAY_CHECKPOINT_CODEC_BOOLEAN_TRUE
            decode_valid <- false if schema != CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_SCHEMA or not DebuggerTraceBinary::reader_is_valid(reader) or reader.offset != reader.length
            decode_valid <- false if snapshot.id.value == CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_INVALID_ID
            decode_valid <- false if snapshot.program_counter >= CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_MAX_PROGRAM_COUNTER or heap_next > CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_MAX_HEAP.u64() or stack_pointer > CheckpointCodecLayout::MAX_STACK_POINTER.u64()
            decode_valid <- false if not DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
            decode_valid <- false if snapshot.state_hash != DebuggerCheckpoint::snapshot_state_hash(snapshot)
            snapshot.id <- DebuggerIdentity::debug_id(CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_INVALID_ID) if not decode_valid
            return snapshot

        def checkpoint_bytes_are_valid(reader: mutable DebuggerTraceBinary::ByteReader&) -> bool:
            return false if not DebuggerTraceBinary::reader_is_valid(reader) or reader.offset != Index::FIRST_INDEX or reader.length != CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_ENCODED_BYTES
            return false if reader.bytes[SchemaByteOffset::BYTE_0] != CheckpointCodecLayout::SCHEMA_BYTE_0 or reader.bytes[SchemaByteOffset::BYTE_1] != CheckpointCodecLayout::SCHEMA_BYTE_1 or reader.bytes[SchemaByteOffset::BYTE_2] != CheckpointCodecLayout::SCHEMA_BYTE_2 or reader.bytes[SchemaByteOffset::BYTE_3] != CheckpointCodecLayout::SCHEMA_BYTE_3
            initial_offset: usize = reader.offset
            initial_failure_state: bool = reader.failed
            decoded: DebuggerCheckpoint::MachineSnapshot = checkpoint_decode(reader)
            valid: bool = decoded.id.value != CheckpointCodecLayout::REPLAY_CHECKPOINT_CODEC_LAYOUT_INVALID_ID and decoded.state_hash == DebuggerCheckpoint::snapshot_state_hash(decoded)
            reader.offset <- initial_offset
            reader.failed <- initial_failure_state
            return valid
