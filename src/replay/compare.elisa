# Branch comparison aligns immutable replay histories by their shared prefix
# and reports the first semantic divergence, never relying on wall time or
# raw host addresses.

include "./engine.elisa"
include "../core/errors.elisa"
include "../core/events.elisa"

module DebuggerReplayCompare:
    private:
        const module Compare:
            MAX_EVENTS: usize = 64

        const module Detail:
            INVALID_LEFT: u32 = 1
            INVALID_RIGHT: u32 = 2
            REPLAY_COMPARE_DETAIL_CAPACITY: u32 = 3
            REPLAY_COMPARE_DETAIL_RECORDING: u32 = 4

        const module Sentinel:
            REPLAY_COMPARE_SENTINEL_DIVERGENCE: u64 = 18446744073709551615


        def events_align(left: DebuggerEvents::EventEnvelope, right: DebuggerEvents::EventEnvelope) -> bool:
            return left.schema == right.schema and left.ordinal == right.ordinal and left.kind == right.kind and left.quality == right.quality and left.payload_hash == right.payload_hash and left.position.recording.value == right.position.recording.value and left.position.event == right.position.event and left.position.task.value == right.position.task.value and left.position.invocation.value == right.position.invocation.value and left.position.statement.value == right.position.statement.value and left.position.microstep == right.position.microstep

    public:
        struct BranchComparison:
            shared_prefix: mutable u64
            left_event: mutable u64
            right_event: mutable u64
            first_divergence: mutable u64
            exact: mutable bool
            heuristic_alignment: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def compare_engines(left: DebuggerReplayEngine::ReplayEngine, right: DebuggerReplayEngine::ReplayEngine) -> BranchComparison:
            result: mutable BranchComparison = zeroed
            result.first_divergence <- Sentinel::REPLAY_COMPARE_SENTINEL_DIVERGENCE
            result.failure <- DebuggerErrors::no_error()
            if left.event_count > Compare::MAX_EVENTS:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Detail::INVALID_LEFT)
                return result
            if right.event_count > Compare::MAX_EVENTS:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Detail::INVALID_RIGHT)
                return result
            return BranchComparison{shared_prefix: 0, left_event: 0, right_event: 0, first_divergence: Sentinel::REPLAY_COMPARE_SENTINEL_DIVERGENCE, exact: false, heuristic_alignment: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_COMPARE_DETAIL_RECORDING)} if left.recording.value == 0 or right.recording.value == 0 or left.recording.value != right.recording.value
            if not DebuggerReplayEngine::replay_engine_is_exact(left):
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::INVALID_LEFT)
                return result
            if not DebuggerReplayEngine::replay_engine_is_exact(right):
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::INVALID_RIGHT)
                return result
            limit: usize = left.event_count if left.event_count < right.event_count else right.event_count
            for index in 0..<limit:
                if not events_align(left.events[index], right.events[index]):
                    result.first_divergence <- index.u64()
                    result.left_event <- index.u64()
                    result.right_event <- index.u64()
                    return result
                result.shared_prefix <- result.shared_prefix + 1
            if left.event_count != right.event_count:
                result.first_divergence <- limit.u64()
                result.left_event <- left.event_count.u64()
                result.right_event <- right.event_count.u64()
                return result
            result.left_event <- left.event_count.u64()
            result.right_event <- right.event_count.u64()
            result.exact <- true
            return result

        def comparison_has_diverged(comparison: BranchComparison) -> bool:
            return comparison.first_divergence != Sentinel::REPLAY_COMPARE_SENTINEL_DIVERGENCE

        def comparison_is_valid(comparison: BranchComparison) -> bool:
            return comparison.shared_prefix <= comparison.left_event and comparison.shared_prefix <= comparison.right_event and (comparison.exact or comparison_has_diverged(comparison) or not DebuggerErrors::error_is_ok(comparison.failure))
