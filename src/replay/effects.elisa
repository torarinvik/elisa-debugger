# Effect virtualization and exactness barriers.  Replay consumes recorded
# replies and never repeats an external write.

include "../core/errors.elisa"

module DebuggerEffects:
    private:
        const module Detail:
            REPLAY_WRITE: u32 = 1
            REPLAY_EFFECTS_DETAIL_ENUM: u32 = 2
            UNSUPPORTED_EFFECT: u32 = 3

        const module Effect:
            ORACLE_CAPACITY: usize = 256
            EMPTY_COUNT: usize = 0
            EMPTY_CURSOR: usize = 0
            COUNT_INCREMENT: usize = 1
            CURSOR_INCREMENT: usize = 1
            PREVIOUS_RECORD_OFFSET: usize = 1
            SEQUENCE_START: u64 = 0
            INITIAL_OVERFLOWED: bool = false
            EMPTY_HASH: u64 = 0
            EMPTY_VALUE: i64 = 0
            NO_WRITE_SUPPRESSION: bool = false
            INITIAL_ACCEPTED: bool = false
            REPLAY_EFFECTS_EFFECT_KIND_MAX: u16 = 9
            REPLAY_EFFECTS_EFFECT_MODE_MAX: u16 = 4
            EXACTNESS_MAX: u16 = 3


    public:
        enum EffectKind:
            Clock
            Random
            ConsoleInput
            ConsoleOutput
            FileRead
            FileWrite
            NetworkRead
            NetworkWrite
            Process
            Foreign

        enum EffectMode:
            Live
            Recording
            Replaying
            Virtualized
            Barrier

        enum Exactness:
            Exact
            Observational
            Incomplete
            Diverged

        struct EffectRecord:
            sequence: mutable u64
            kind: mutable EffectKind
            request_hash: mutable u64
            result_hash: mutable u64
            result_value: mutable i64
            suppress_external_write: mutable bool

        struct EffectOracle:
            records: mutable EffectRecord[Effect::ORACLE_CAPACITY]
            count: mutable usize
            cursor: mutable usize
            mode: mutable EffectMode
            exactness: mutable Exactness
            overflowed: mutable bool
            last_error: mutable DebuggerErrors::DebuggerError

        # A small reply carries the recorded value and write policy. The
        # cursor advances in the caller-owned oracle before this returns.
        struct EffectReplay:
            accepted: mutable bool
            result_hash: mutable u64
            result_value: mutable i64
            suppress_external_write: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        struct RandomEffectReplay:
            accepted: mutable bool
            result_hash: mutable u64
            value: mutable u64
            suppress_external_write: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        # The caller owns the fixed record buffer. Empty logical extent makes
        # old slots unreachable; recording overwrites each slot before commit.
        def effect_oracle_initialize(oracle: mutable EffectOracle&, mode: EffectMode) -> void:
            oracle.count <- Effect::EMPTY_COUNT
            oracle.cursor <- Effect::EMPTY_CURSOR
            oracle.mode <- mode
            oracle.exactness <- Exactness.Observational if mode == EffectMode.Live or mode == EffectMode.Barrier
            oracle.exactness <- Exactness.Exact if mode != EffectMode.Live and mode != EffectMode.Barrier
            if mode.u16() > Effect::REPLAY_EFFECTS_EFFECT_MODE_MAX:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_EFFECTS_DETAIL_ENUM)
            oracle.overflowed <- Effect::INITIAL_OVERFLOWED
            oracle.last_error <- DebuggerErrors::no_error() if mode.u16() <= Effect::REPLAY_EFFECTS_EFFECT_MODE_MAX

        def effect_is_external_write(kind: EffectKind) -> bool:
            return true if kind == EffectKind.ConsoleOutput
            return kind == EffectKind.FileWrite or kind == EffectKind.NetworkWrite or kind == EffectKind.Process or kind == EffectKind.Foreign

        # The generic oracle stores one 64-bit scalar result and opaque
        # request/result hashes. Clock results use the signed scalar API;
        # random results use the typed unsigned API below. The checkpoint codec
        # preserves the scalar's full bit pattern, so both are replayable.
        # Console and resource effects need richer payload records.
        def effect_kind_is_fully_captured(kind: EffectKind) -> bool:
            return kind == EffectKind.Clock or kind == EffectKind.Random

        def effect_oracle_record(oracle: mutable EffectOracle&, kind: EffectKind, request_hash: u64, result_hash: u64, value: i64) -> void:
            return if oracle.exactness == Exactness.Diverged or (not DebuggerErrors::error_is_ok(oracle.last_error) and oracle.last_error.code != DebuggerErrors::ErrorCode.Unsupported)
            if oracle.mode.u16() > Effect::REPLAY_EFFECTS_EFFECT_MODE_MAX:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_EFFECTS_DETAIL_ENUM)
                return
            if kind.u16() > Effect::REPLAY_EFFECTS_EFFECT_KIND_MAX:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_EFFECTS_DETAIL_ENUM)
                return
            if oracle.mode == EffectMode.Replaying:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::REPLAY_WRITE)
                return
            if oracle.count >= Effect::ORACLE_CAPACITY:
                oracle.overflowed <- true
                oracle.exactness <- Exactness.Incomplete
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Effect::ORACLE_CAPACITY.u32())
                return
            oracle.records[oracle.count] <- EffectRecord{sequence: oracle.count.u64(), kind: kind, request_hash: request_hash, result_hash: result_hash, result_value: value, suppress_external_write: effect_is_external_write(kind)}
            oracle.count <- oracle.count + Effect::COUNT_INCREMENT
            oracle.exactness <- Exactness.Observational if oracle.mode == EffectMode.Live or oracle.mode == EffectMode.Barrier
            if oracle.mode != EffectMode.Live and oracle.mode != EffectMode.Barrier:
                if not effect_kind_is_fully_captured(kind):
                    oracle.exactness <- Exactness.Incomplete
                    oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::UNSUPPORTED_EFFECT) if DebuggerErrors::error_is_ok(oracle.last_error)

        # Random samples span the full unsigned 64-bit range. Store their bit
        # pattern in the oracle's fixed-width scalar slot and expose a typed
        # unsigned replay result so callers never need signed arithmetic.
        def effect_oracle_record_random(oracle: mutable EffectOracle&, request_hash: u64, result_hash: u64, value: u64) -> void:
            effect_oracle_record(oracle, EffectKind.Random, request_hash, result_hash, value.i64())

        def effect_oracle_replay(oracle: mutable EffectOracle&, kind: EffectKind, request_hash: u64) -> void:
            if oracle.mode.u16() > Effect::REPLAY_EFFECTS_EFFECT_MODE_MAX:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_EFFECTS_DETAIL_ENUM)
                return
            return if oracle.mode != EffectMode.Replaying
            if oracle.count > Effect::ORACLE_CAPACITY or oracle.cursor > oracle.count:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Effect::ORACLE_CAPACITY.u32())
                return
            if oracle.overflowed:
                oracle.exactness <- Exactness.Incomplete
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Effect::ORACLE_CAPACITY.u32()) if DebuggerErrors::error_is_ok(oracle.last_error)
                return
            if oracle.exactness == Exactness.Exact and DebuggerErrors::error_is_ok(oracle.last_error):
                for index in Effect::EMPTY_COUNT..<oracle.count:
                    if not effect_kind_is_fully_captured(oracle.records[index].kind):
                        oracle.exactness <- Exactness.Incomplete
                        oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::UNSUPPORTED_EFFECT)
                        return
            return if oracle.exactness != Exactness.Exact or not DebuggerErrors::error_is_ok(oracle.last_error)
            if kind.u16() > Effect::REPLAY_EFFECTS_EFFECT_KIND_MAX:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_EFFECTS_DETAIL_ENUM)
                return
            if oracle.cursor >= oracle.count:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, oracle.cursor.u32())
                return
            record: EffectRecord = oracle.records[oracle.cursor]
            if record.suppress_external_write != effect_is_external_write(record.kind):
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::REPLAY_EFFECTS_DETAIL_ENUM)
                return
            if record.sequence != oracle.cursor.u64() or record.kind != kind or record.request_hash != request_hash:
                oracle.exactness <- Exactness.Diverged
                oracle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, oracle.cursor.u32())
                return
            oracle.cursor <- oracle.cursor + Effect::CURSOR_INCREMENT

        def effect_replay_failure(oracle: mutable EffectOracle&, failure: DebuggerErrors::DebuggerError) -> EffectReplay:
            oracle.exactness <- Exactness.Diverged
            oracle.last_error <- failure
            return EffectReplay{accepted: Effect::INITIAL_ACCEPTED, result_hash: Effect::EMPTY_HASH, result_value: Effect::EMPTY_VALUE, suppress_external_write: Effect::NO_WRITE_SUPPRESSION, failure: failure}

        def effect_replay_unavailable(oracle: mutable EffectOracle&, failure: DebuggerErrors::DebuggerError) -> EffectReplay:
            oracle.last_error <- failure if DebuggerErrors::error_is_ok(oracle.last_error)
            return EffectReplay{accepted: Effect::INITIAL_ACCEPTED, result_hash: Effect::EMPTY_HASH, result_value: Effect::EMPTY_VALUE, suppress_external_write: Effect::NO_WRITE_SUPPRESSION, failure: failure}

        # Consume one recorded result and expose the external-write policy
        # together with the value.  Replay callers must use this API instead
        # of reading records directly, so mismatched requests stop at the
        # first divergence and cannot accidentally send a real write.
        def effect_oracle_replay_result(oracle: mutable EffectOracle&, kind: EffectKind, request_hash: u64) -> EffectReplay:
            initial_failure: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if oracle.mode.u16() > Effect::REPLAY_EFFECTS_EFFECT_MODE_MAX:
                initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_EFFECTS_DETAIL_ENUM)
                return effect_replay_failure(oracle, initial_failure)
            if oracle.mode != EffectMode.Replaying:
                initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::REPLAY_WRITE)
                return effect_replay_failure(oracle, initial_failure)
            if oracle.count > Effect::ORACLE_CAPACITY or oracle.cursor > oracle.count:
                initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Effect::ORACLE_CAPACITY.u32())
                return effect_replay_failure(oracle, initial_failure)
            if oracle.overflowed:
                initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Effect::ORACLE_CAPACITY.u32())
                oracle.exactness <- Exactness.Incomplete
                oracle.last_error <- initial_failure if DebuggerErrors::error_is_ok(oracle.last_error)
                return effect_replay_unavailable(oracle, initial_failure)
            if oracle.exactness == Exactness.Incomplete:
                initial_failure <- oracle.last_error if not DebuggerErrors::error_is_ok(oracle.last_error) else DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::UNSUPPORTED_EFFECT)
                return effect_replay_unavailable(oracle, initial_failure)
            if oracle.exactness != Exactness.Exact or not DebuggerErrors::error_is_ok(oracle.last_error):
                initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::REPLAY_WRITE)
                return effect_replay_failure(oracle, initial_failure)
            if kind.u16() > Effect::REPLAY_EFFECTS_EFFECT_KIND_MAX:
                initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_EFFECTS_DETAIL_ENUM)
                return effect_replay_failure(oracle, initial_failure)
            for index in Effect::EMPTY_COUNT..<oracle.count:
                if not effect_kind_is_fully_captured(oracle.records[index].kind):
                    initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::UNSUPPORTED_EFFECT)
                    oracle.exactness <- Exactness.Incomplete
                    return effect_replay_unavailable(oracle, initial_failure)
            if oracle.cursor >= oracle.count:
                initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, oracle.cursor.u32())
                return effect_replay_failure(oracle, initial_failure)
            record: EffectRecord = oracle.records[oracle.cursor]
            if record.suppress_external_write != effect_is_external_write(record.kind) or record.sequence != oracle.cursor.u64() or record.kind != kind or record.request_hash != request_hash:
                initial_failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, oracle.cursor.u32())
                return effect_replay_failure(oracle, initial_failure)
            oracle.cursor <- oracle.cursor + Effect::CURSOR_INCREMENT
            return EffectReplay{accepted: true, result_hash: record.result_hash, result_value: record.result_value, suppress_external_write: record.suppress_external_write, failure: DebuggerErrors::no_error()}

        def effect_oracle_replay_random_result(oracle: mutable EffectOracle&, request_hash: u64) -> RandomEffectReplay:
            replay: EffectReplay = effect_oracle_replay_result(oracle, EffectKind.Random, request_hash)
            return RandomEffectReplay{accepted: replay.accepted, result_hash: replay.result_hash, value: replay.result_value.u64(), suppress_external_write: replay.suppress_external_write, failure: replay.failure}

        def effect_oracle_is_exact(oracle: EffectOracle&) -> bool:
            return false if oracle.count > Effect::ORACLE_CAPACITY or oracle.cursor > oracle.count or oracle.mode.u16() > Effect::REPLAY_EFFECTS_EFFECT_MODE_MAX or oracle.exactness.u16() > Effect::EXACTNESS_MAX or not DebuggerErrors::error_is_ok(oracle.last_error)
            return false if oracle.mode == EffectMode.Live or oracle.mode == EffectMode.Barrier
            return false if (oracle.mode == EffectMode.Recording or oracle.mode == EffectMode.Virtualized) and oracle.cursor != Effect::EMPTY_CURSOR
            for index in Effect::EMPTY_COUNT..<oracle.count:
                return false if oracle.records[index].sequence != index.u64() or oracle.records[index].kind.u16() > Effect::REPLAY_EFFECTS_EFFECT_KIND_MAX or oracle.records[index].suppress_external_write != effect_is_external_write(oracle.records[index].kind)
                return false if not effect_kind_is_fully_captured(oracle.records[index].kind)
            return oracle.exactness == Exactness.Exact and not oracle.overflowed

        def effect_oracle_last_value(oracle: EffectOracle&) -> i64:
            return Effect::EMPTY_VALUE if oracle.count > Effect::ORACLE_CAPACITY or oracle.cursor == Effect::EMPTY_CURSOR or oracle.cursor > oracle.count
            return oracle.records[oracle.cursor - Effect::PREVIOUS_RECORD_OFFSET].result_value

        def effect_oracle_last_record(oracle: EffectOracle&) -> EffectRecord:
            result: mutable EffectRecord = zeroed
            return result if oracle.count > Effect::ORACLE_CAPACITY or oracle.cursor == Effect::EMPTY_CURSOR or oracle.cursor > oracle.count
            return oracle.records[oracle.cursor - Effect::PREVIOUS_RECORD_OFFSET]

        def effect_oracle_replay_complete(oracle: EffectOracle&) -> bool:
            return false if not effect_oracle_is_exact(oracle)
            return oracle.mode != EffectMode.Replaying or oracle.cursor == oracle.count

        def effect_oracle_begin_replay(oracle: mutable EffectOracle&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Effect::ORACLE_CAPACITY.u32()) if oracle.count > Effect::ORACLE_CAPACITY or oracle.cursor > oracle.count
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Effect::ORACLE_CAPACITY.u32()) if oracle.overflowed
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unsupported, false, Detail::UNSUPPORTED_EFFECT) if not effect_oracle_is_exact(oracle)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::REPLAY_WRITE) if oracle.mode != EffectMode.Recording
            oracle.mode <- EffectMode.Replaying
            oracle.cursor <- Effect::EMPTY_CURSOR
            return DebuggerErrors::no_error()

        def effect_record_suppresses_write(record: EffectRecord) -> bool:
            return record.suppress_external_write
