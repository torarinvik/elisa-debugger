# Bounded managed replay engine.  Every step snapshots logical machine state
# before execution, which makes reverse-step and seek exact within the retained
# window without pretending a native heap copy is a resumable checkpoint.

include "../core/identity.elisa"
include "../core/events.elisa"
include "../vm/edir.elisa"
include "./checkpoint.elisa"

module DebuggerReplayEngine:
    private:
        const module Hash:
            REPLAY_ENGINE_HASH_FALSE: u64 = 0
            REPLAY_ENGINE_HASH_TRUE: u64 = 1

        const module Replay:
            HISTORY_CAPACITY: usize = 64
            BRANCH_LINEAGE_CAPACITY: usize = Replay::HISTORY_CAPACITY + 1
            INTERVENTION_CAPACITY: usize = Replay::HISTORY_CAPACITY
            REPLAY_ENGINE_ROOT_BRANCH: u64 = 0
            INITIAL_EVENT_INDEX: usize = 0
            ROOT_LINEAGE_INDEX: usize = 0
            ROOT_LINEAGE_COUNT: usize = 1
            REPLAY_ENGINE_SCHEMA_VERSION: u32 = 1
            REPLAY_ENGINE_HASH_OFFSET_BASIS: u64 = 1469598103934665603
            REPLAY_ENGINE_HASH_PRIME: u64 = 1099511628211
            REPLAY_ENGINE_GLOBAL_CAPACITY: usize = 16
            REPLAY_ENGINE_MEMORY_CAPACITY: usize = 64
            REPLAY_ENGINE_LOCAL_CAPACITY: usize = 32
            REPLAY_ENGINE_FRAME_LOCAL_CAPACITY: usize = 512
            REPLAY_ENGINE_CALL_DEPTH_CAPACITY: usize = 16
            REPLAY_ENGINE_MAX_PROGRAM_COUNTER: u64 = 256
            REPLAY_ENGINE_MAX_HEAP: usize = 64
            REPLAY_ENGINE_FIRST_BRANCH_ID: u64 = 1
            FIRST_CHILD_LINEAGE_INDEX: usize = Replay::ROOT_LINEAGE_COUNT
            NON_ROOT_LINEAGE_MINIMUM: usize = Replay::ROOT_LINEAGE_COUNT + Replay::FIRST_CHILD_LINEAGE_INDEX
            ROOT_FORK_EVENT: u64 = 0
            ROOT_FORK_HASH: u64 = 0
            REPLAY_ENGINE_MAX_BRANCH_ID: u64 = 18446744073709551615
            INVALID_LINEAGE_INDEX: usize = Replay::BRANCH_LINEAGE_CAPACITY
            REPLAY_ENGINE_CHECKPOINT_ID_OFFSET: u64 = 1


        def replay_engine_intervention_applies(engine: ReplayEngine&, index: usize, event: u64) -> bool:
            return false if index >= engine.intervention_count
            return false if engine.intervention_events[index] != event
            return false if engine.branch_lineage_count == 0 or engine.branch_lineage_count > Replay::BRANCH_LINEAGE_CAPACITY
            intervention_branch: u64 = engine.intervention_branches[index].value
            active_branch: u64 = replay_engine_branch_at(engine, event).value
            intervention_lineage_index: mutable usize = Replay::INVALID_LINEAGE_INDEX
            active_lineage_index: mutable usize = Replay::INVALID_LINEAGE_INDEX
            for lineage_index in 0..<engine.branch_lineage_count:
                intervention_lineage_index <- lineage_index if engine.branch_lineage[lineage_index].value == intervention_branch
                active_lineage_index <- lineage_index if engine.branch_lineage[lineage_index].value == active_branch
            return false if intervention_lineage_index == Replay::INVALID_LINEAGE_INDEX or active_lineage_index == Replay::INVALID_LINEAGE_INDEX
            return true if intervention_lineage_index == active_lineage_index
            return false if intervention_lineage_index + Replay::FIRST_CHILD_LINEAGE_INDEX >= engine.branch_lineage_count
            return engine.branch_fork_events[intervention_lineage_index + Replay::FIRST_CHILD_LINEAGE_INDEX] == event

    public:
        enum EngineError:
            None
            HistoryFull
            HistoryUnavailable
            ExecutionFault
            StepLimit

        struct ReplayEngine:
            image: mutable DebuggerEDIR::ProgramImage
            machine: mutable DebuggerEDIR::Machine
            history: mutable DebuggerCheckpoint::MachineSnapshot[Replay::HISTORY_CAPACITY]
            events: mutable DebuggerEvents::EventEnvelope[Replay::HISTORY_CAPACITY]
            event_count: mutable usize
            recording: mutable DebuggerIdentity::DebugId
            branch: mutable DebuggerIdentity::DebugId
            parent_branch: mutable DebuggerIdentity::DebugId
            branch_lineage: mutable DebuggerIdentity::DebugId[Replay::BRANCH_LINEAGE_CAPACITY]
            branch_fork_events: mutable u64[Replay::BRANCH_LINEAGE_CAPACITY]
            branch_fork_hashes: mutable u64[Replay::BRANCH_LINEAGE_CAPACITY]
            branch_fork_accumulators: mutable i64[Replay::BRANCH_LINEAGE_CAPACITY]
            branch_lineage_count: mutable usize
            fork_event: mutable usize
            fork_state_hash: mutable u64
            intervention_events: mutable u64[Replay::INTERVENTION_CAPACITY]
            intervention_branches: mutable DebuggerIdentity::DebugId[Replay::INTERVENTION_CAPACITY]
            intervention_accumulators: mutable i64[Replay::INTERVENTION_CAPACITY]
            intervention_count: mutable usize
            next_branch_id: mutable u64
            engine_error: mutable EngineError

        def replay_engine_new(image: DebuggerEDIR::ProgramImage, recording: DebuggerIdentity::DebugId) -> ReplayEngine:
            engine: mutable ReplayEngine = zeroed
            engine.image <- image
            engine.machine <- DebuggerEDIR::machine_new()
            engine.recording <- recording
            engine.branch <- DebuggerIdentity::debug_id(Replay::REPLAY_ENGINE_ROOT_BRANCH)
            engine.parent_branch <- DebuggerIdentity::debug_id(Replay::REPLAY_ENGINE_ROOT_BRANCH)
            engine.branch_lineage[Replay::ROOT_LINEAGE_INDEX] <- DebuggerIdentity::debug_id(Replay::REPLAY_ENGINE_ROOT_BRANCH)
            engine.branch_fork_events[Replay::ROOT_LINEAGE_INDEX] <- Replay::ROOT_FORK_EVENT
            engine.branch_lineage_count <- 1
            engine.fork_event <- 0
            engine.fork_state_hash <- Replay::ROOT_FORK_HASH
            engine.next_branch_id <- Replay::REPLAY_ENGINE_FIRST_BRANCH_ID
            engine.engine_error <- EngineError.None
            verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(engine.image)
            if not verification.valid:
                engine.machine.faulted <- true
                engine.machine.halted <- true
                engine.engine_error <- EngineError.ExecutionFault
            return engine

        def replay_engine_position(engine: mutable ReplayEngine&) -> DebuggerIdentity::Position:
            position: mutable DebuggerIdentity::Position = DebuggerIdentity::initial_position(engine.recording)
            position.branch <- replay_engine_branch_at(engine, engine.event_count.u64())
            position.event <- engine.event_count.u64()
            position.statement <- DebuggerIdentity::debug_id(engine.machine.program_counter)
            return position

        def replay_engine_history_capacity() -> usize:
            return Replay::HISTORY_CAPACITY

        # A branch only owns events from its fork boundary onward. Earlier
        # events remain in the parent branch even while a child is selected.
        def replay_engine_branch_at(engine: ReplayEngine&, event: u64) -> DebuggerIdentity::DebugId:
            return engine.branch if engine.branch_lineage_count == 0 or engine.branch_lineage_count > Replay::BRANCH_LINEAGE_CAPACITY
            result: mutable DebuggerIdentity::DebugId = engine.branch_lineage[Replay::ROOT_LINEAGE_INDEX]
            for index in Replay::FIRST_CHILD_LINEAGE_INDEX..<engine.branch_lineage_count:
                result <- engine.branch_lineage[index] if event >= engine.branch_fork_events[index]
            return result

        def replay_engine_machine_state_hash(machine: DebuggerEDIR::Machine, event: u64) -> u64:
            hash: mutable u64 = Replay::REPLAY_ENGINE_HASH_OFFSET_BASIS + machine.program_counter
            hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.accumulator.u64()
            hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.result.u64()
            hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.return_stack_pointer.u64()
            hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.heap_next.u64()
            for index in 0..<Replay::REPLAY_ENGINE_LOCAL_CAPACITY:
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.locals[index].u64()
                initialized: mutable u64 = Hash::REPLAY_ENGINE_HASH_FALSE
                initialized <- Hash::REPLAY_ENGINE_HASH_TRUE if machine.locals_initialized[index]
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + initialized
            for index in 0..<Replay::REPLAY_ENGINE_FRAME_LOCAL_CAPACITY:
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.frame_locals[index].u64()
                initialized: mutable u64 = Hash::REPLAY_ENGINE_HASH_FALSE
                initialized <- Hash::REPLAY_ENGINE_HASH_TRUE if machine.frame_locals_initialized[index]
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + initialized
            for index in 0..<Replay::REPLAY_ENGINE_CALL_DEPTH_CAPACITY:
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.return_stack[index]
            for index in 0..<Replay::REPLAY_ENGINE_GLOBAL_CAPACITY:
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.globals[index].u64()
                initialized: mutable u64 = Hash::REPLAY_ENGINE_HASH_FALSE
                initialized <- Hash::REPLAY_ENGINE_HASH_TRUE if machine.globals_initialized[index]
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + initialized
            for index in 0..<Replay::REPLAY_ENGINE_MEMORY_CAPACITY:
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.memory[index].u64()
                initialized: mutable u64 = Hash::REPLAY_ENGINE_HASH_FALSE
                initialized <- Hash::REPLAY_ENGINE_HASH_TRUE if machine.memory_initialized[index]
                hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + initialized
            hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + event
            halted: u64 = Hash::REPLAY_ENGINE_HASH_TRUE if machine.halted else Hash::REPLAY_ENGINE_HASH_FALSE
            faulted: u64 = Hash::REPLAY_ENGINE_HASH_TRUE if machine.faulted else Hash::REPLAY_ENGINE_HASH_FALSE
            hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + halted
            hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + faulted
            hash <- hash * Replay::REPLAY_ENGINE_HASH_PRIME + machine.steps
            return hash

        def replay_engine_state_hash(engine: mutable ReplayEngine&) -> u64:
            return replay_engine_machine_state_hash(engine.machine, engine.event_count.u64())

        def replay_engine_apply_interventions(engine: mutable ReplayEngine&, event: u64) -> bool:
            return false if engine.intervention_count > Replay::INTERVENTION_CAPACITY
            for index in 0..<engine.intervention_count:
                if replay_engine_intervention_applies(engine, index, event):
                    engine.machine.accumulator <- engine.intervention_accumulators[index]
            return true

        def replay_engine_snapshot_state_hash(snapshot: DebuggerCheckpoint::MachineSnapshot) -> u64:
            return DebuggerCheckpoint::snapshot_state_hash(snapshot)

        def replay_engine_snapshot_is_valid(engine: ReplayEngine&, index: usize, snapshot: DebuggerCheckpoint::MachineSnapshot) -> bool:
            return false if not DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
            return false if snapshot.id.value != index.u64() + Replay::REPLAY_ENGINE_CHECKPOINT_ID_OFFSET or snapshot.event != index.u64()
            return false if snapshot.program_counter >= engine.image.program.instruction_count or snapshot.halted or snapshot.faulted
            for stack_index in 0..<snapshot.return_stack_pointer:
                return false if snapshot.return_stack[stack_index] >= engine.image.program.instruction_count
            return snapshot.state_hash == replay_engine_snapshot_state_hash(snapshot)

        def replay_engine_step(engine: mutable ReplayEngine&) -> void:
            return if engine.machine.halted or engine.machine.faulted
            engine.engine_error <- EngineError.None
            verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(engine.image)
            if not verification.valid:
                engine.machine.faulted <- true
                engine.machine.halted <- true
                engine.engine_error <- EngineError.ExecutionFault
                return
            if engine.event_count >= Replay::HISTORY_CAPACITY:
                engine.engine_error <- EngineError.HistoryFull
                return
            if engine.machine.program_counter >= engine.image.program.instruction_count:
                engine.machine.faulted <- true
                engine.machine.halted <- true
                engine.engine_error <- EngineError.ExecutionFault
                return
            if not replay_engine_apply_interventions(engine, engine.event_count.u64()):
                engine.engine_error <- EngineError.HistoryUnavailable
                return
            snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(engine.machine, DebuggerIdentity::debug_id(engine.event_count.u64() + Replay::REPLAY_ENGINE_CHECKPOINT_ID_OFFSET), engine.event_count.u64(), replay_engine_state_hash(engine))
            engine.history[engine.event_count] <- snapshot
            instruction: DebuggerEDIR::Instruction = engine.image.instructions[engine.machine.program_counter.usize()]
            DebuggerEDIR::machine_step_in_place(engine.machine, instruction)
            position: DebuggerIdentity::Position = replay_engine_position(engine)
            engine.events[engine.event_count] <- DebuggerEvents::event_envelope(Replay::REPLAY_ENGINE_SCHEMA_VERSION, engine.event_count.u64(), position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, replay_engine_state_hash(engine))
            engine.event_count <- engine.event_count + 1
            if engine.machine.faulted:
                engine.engine_error <- EngineError.ExecutionFault

        def replay_engine_run(engine: mutable ReplayEngine&, max_steps: u64) -> void:
            engine.engine_error <- EngineError.None if not engine.machine.faulted
            start: u64 = engine.event_count.u64()
            while not engine.machine.halted and not engine.machine.faulted and engine.event_count.u64() - start < max_steps:
                replay_engine_step(engine)
                break if engine.engine_error != EngineError.None
            if not engine.machine.halted and not engine.machine.faulted and engine.event_count.u64() - start >= max_steps:
                engine.engine_error <- EngineError.StepLimit

        def replay_engine_reverse_one(engine: mutable ReplayEngine&) -> void:
            if engine.event_count == 0 or engine.event_count > Replay::HISTORY_CAPACITY:
                engine.engine_error <- EngineError.HistoryUnavailable
                return
            target: usize = engine.event_count - 1
            snapshot: DebuggerCheckpoint::MachineSnapshot = engine.history[target]
            if not replay_engine_snapshot_is_valid(engine, target, snapshot):
                engine.engine_error <- EngineError.HistoryUnavailable
                return
            restored: DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(snapshot)
            original_machine: DebuggerEDIR::Machine = engine.machine
            original_count: usize = engine.event_count
            engine.machine <- restored
            engine.event_count <- target
            if snapshot.state_hash != replay_engine_state_hash(engine):
                engine.machine <- original_machine
                engine.event_count <- original_count
                engine.engine_error <- EngineError.HistoryUnavailable
                return
            engine.engine_error <- EngineError.None

        def replay_engine_apply_seek_boundary(engine: mutable ReplayEngine&) -> bool:
            return false if not replay_engine_apply_interventions(engine, engine.event_count.u64())
            if engine.event_count < Replay::HISTORY_CAPACITY and not engine.machine.halted and not engine.machine.faulted:
                engine.history[engine.event_count] <- DebuggerCheckpoint::snapshot_capture(engine.machine, DebuggerIdentity::debug_id(engine.event_count.u64() + Replay::REPLAY_ENGINE_CHECKPOINT_ID_OFFSET), engine.event_count.u64(), replay_engine_state_hash(engine))
            return true

        def replay_engine_seek(engine: mutable ReplayEngine&, target: usize) -> void:
            original_machine: DebuggerEDIR::Machine = engine.machine
            original_count: usize = engine.event_count
            if target > Replay::HISTORY_CAPACITY or original_count > Replay::HISTORY_CAPACITY:
                engine.engine_error <- EngineError.HistoryUnavailable
                return
            if target == original_count:
                engine.engine_error <- EngineError.None if engine.engine_error == EngineError.StepLimit
                if not replay_engine_apply_seek_boundary(engine):
                    engine.engine_error <- EngineError.HistoryUnavailable
                return
            if target < engine.event_count:
                snapshot: DebuggerCheckpoint::MachineSnapshot = engine.history[target]
                if not replay_engine_snapshot_is_valid(engine, target, snapshot):
                    engine.engine_error <- EngineError.HistoryUnavailable
                    return
                restored: DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(snapshot)
                engine.machine <- restored
                engine.event_count <- target
                if snapshot.state_hash != replay_engine_state_hash(engine):
                    engine.machine <- original_machine
                    engine.event_count <- original_count
                    engine.engine_error <- EngineError.HistoryUnavailable
                    return
                engine.engine_error <- EngineError.None
                if not replay_engine_apply_seek_boundary(engine):
                    engine.machine <- original_machine
                    engine.event_count <- original_count
                    engine.engine_error <- EngineError.HistoryUnavailable
                    return
                return
            while engine.event_count < target and not engine.machine.halted and not engine.machine.faulted:
                previous: usize = engine.event_count
                replay_engine_step(engine)
                break if engine.event_count == previous
            if engine.event_count != target:
                failed_error: EngineError = engine.engine_error
                engine.machine <- original_machine
                engine.event_count <- original_count
                engine.engine_error <- EngineError.HistoryUnavailable if failed_error == EngineError.None
                engine.engine_error <- failed_error if failed_error != EngineError.None
                return
            if not replay_engine_apply_seek_boundary(engine):
                engine.machine <- original_machine
                engine.event_count <- original_count
                engine.engine_error <- EngineError.HistoryUnavailable

        def replay_engine_fork_state_matches(engine: mutable ReplayEngine&, lineage_index: usize, fork_event: u64) -> bool:
            fork_machine: mutable DebuggerEDIR::Machine = zeroed
            if fork_event == engine.event_count.u64():
                fork_machine <- engine.machine
            else:
                fork_snapshot: DebuggerCheckpoint::MachineSnapshot = engine.history[fork_event.usize()]
                return false if not replay_engine_snapshot_is_valid(engine, fork_event.usize(), fork_snapshot)
                fork_machine <- DebuggerCheckpoint::snapshot_restore(fork_snapshot)
            fork_machine.accumulator <- engine.branch_fork_accumulators[lineage_index]
            return engine.branch_fork_hashes[lineage_index] == replay_engine_machine_state_hash(fork_machine, fork_event)

        def replay_engine_is_exact(engine: mutable ReplayEngine&) -> bool:
            return false if engine.event_count > Replay::HISTORY_CAPACITY or engine.engine_error != EngineError.None or engine.machine.faulted
            return false if engine.intervention_count > Replay::INTERVENTION_CAPACITY
            return false if engine.recording.value == Replay::REPLAY_ENGINE_ROOT_BRANCH
            return false if engine.machine.program_counter >= Replay::REPLAY_ENGINE_MAX_PROGRAM_COUNTER or engine.machine.heap_next > Replay::REPLAY_ENGINE_MAX_HEAP or engine.machine.return_stack_pointer > Replay::REPLAY_ENGINE_CALL_DEPTH_CAPACITY
            return false if not DebuggerEDIR::verify_image(engine.image).valid
            if engine.event_count == Replay::INITIAL_EVENT_INDEX and engine.branch.value == Replay::REPLAY_ENGINE_ROOT_BRANCH:
                initial_machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
                return false if replay_engine_machine_state_hash(engine.machine, Replay::INITIAL_EVENT_INDEX.u64()) != replay_engine_machine_state_hash(initial_machine, Replay::INITIAL_EVENT_INDEX.u64())
            return false if engine.next_branch_id == Replay::REPLAY_ENGINE_ROOT_BRANCH or engine.next_branch_id > Replay::REPLAY_ENGINE_MAX_BRANCH_ID
            return false if engine.branch_lineage_count == 0 or engine.branch_lineage_count > Replay::BRANCH_LINEAGE_CAPACITY
            return false if engine.branch_lineage[Replay::ROOT_LINEAGE_INDEX].value != Replay::REPLAY_ENGINE_ROOT_BRANCH or engine.branch_lineage[engine.branch_lineage_count - 1].value != engine.branch.value
            for lineage_index in Replay::FIRST_CHILD_LINEAGE_INDEX..<engine.branch_lineage_count:
                lineage_id: u64 = engine.branch_lineage[lineage_index].value
                return false if lineage_id == Replay::REPLAY_ENGINE_ROOT_BRANCH or lineage_id == Replay::REPLAY_ENGINE_MAX_BRANCH_ID
                for earlier_index in Replay::ROOT_LINEAGE_INDEX..<lineage_index:
                    return false if engine.branch_lineage[earlier_index].value == lineage_id
            if engine.branch.value == Replay::REPLAY_ENGINE_ROOT_BRANCH:
                return false if engine.branch_lineage_count != Replay::ROOT_LINEAGE_COUNT or engine.parent_branch.value != Replay::REPLAY_ENGINE_ROOT_BRANCH or engine.fork_event != Replay::ROOT_FORK_EVENT or engine.fork_state_hash != Replay::ROOT_FORK_HASH
            else:
                return false if engine.branch_lineage_count < Replay::NON_ROOT_LINEAGE_MINIMUM or engine.parent_branch.value != engine.branch_lineage[engine.branch_lineage_count - Replay::NON_ROOT_LINEAGE_MINIMUM].value or engine.fork_event > engine.event_count
                return false if engine.branch_fork_events[engine.branch_lineage_count - 1] != engine.fork_event
                return false if engine.branch_fork_hashes[engine.branch_lineage_count - 1] != engine.fork_state_hash
            return false if engine.branch.value != Replay::REPLAY_ENGINE_ROOT_BRANCH and engine.event_count == engine.fork_event and replay_engine_state_hash(engine) != engine.fork_state_hash
            return false if engine.branch_fork_events[Replay::ROOT_LINEAGE_INDEX] != Replay::ROOT_FORK_EVENT
            for lineage_index in Replay::FIRST_CHILD_LINEAGE_INDEX..<engine.branch_lineage_count:
                fork_event: u64 = engine.branch_fork_events[lineage_index]
                return false if fork_event > engine.event_count
                return false if fork_event < engine.branch_fork_events[lineage_index - 1]
                return false if not replay_engine_fork_state_matches(engine, lineage_index, fork_event)
            previous_intervention_event: mutable u64 = 0
            for intervention_index in 0..<engine.intervention_count:
                intervention_event: u64 = engine.intervention_events[intervention_index]
                return false if intervention_event >= Replay::HISTORY_CAPACITY.u64()
                return false if intervention_index > 0 and intervention_event < previous_intervention_event
                intervention_branch_found: mutable bool = false
                for lineage_index in 0..<engine.branch_lineage_count:
                    if engine.branch_lineage[lineage_index].value == engine.intervention_branches[intervention_index].value and engine.branch_fork_events[lineage_index] <= intervention_event:
                        intervention_branch_found <- true
                return false if not intervention_branch_found
                previous_intervention_event <- intervention_event
            for index in 0..<engine.event_count:
                event: DebuggerEvents::EventEnvelope = engine.events[index]
                return false if event.ordinal != index.u64() or event.schema != Replay::REPLAY_ENGINE_SCHEMA_VERSION or event.kind != DebuggerEvents::EventKind.ExecutionBoundary or event.quality != DebuggerEvents::EventQuality.Exact or event.task.value != event.position.task.value or event.position.recording.value != engine.recording.value or event.position.event != index.u64()
                lineage_event_found: mutable bool = false
                for lineage_index in 0..<engine.branch_lineage_count:
                    lineage_event_found <- true if engine.branch_lineage[lineage_index].value == event.position.branch.value
                return false if not lineage_event_found
                return false if event.position.branch.value != replay_engine_branch_at(engine, index.u64()).value
                return false if not replay_engine_snapshot_is_valid(engine, index, engine.history[index])
                replay_machine: mutable DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(engine.history[index])
                for intervention_index in 0..<engine.intervention_count:
                    replay_machine.accumulator <- engine.intervention_accumulators[intervention_index] if replay_engine_intervention_applies(engine, intervention_index, index.u64())
                DebuggerEDIR::machine_step_in_place(replay_machine, engine.image.instructions[replay_machine.program_counter.usize()])
                return false if event.position.statement.value != replay_machine.program_counter
                return false if event.payload_hash != replay_engine_machine_state_hash(replay_machine, index.u64())
            if engine.event_count > 0:
                final_machine: mutable DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(engine.history[engine.event_count - Replay::REPLAY_ENGINE_CHECKPOINT_ID_OFFSET.usize()])
                DebuggerEDIR::machine_step_in_place(final_machine, engine.image.instructions[final_machine.program_counter.usize()])
                final_event_hash: u64 = replay_engine_machine_state_hash(final_machine, engine.event_count.u64() - Replay::REPLAY_ENGINE_CHECKPOINT_ID_OFFSET)
                return false if engine.events[engine.event_count - 1].payload_hash != final_event_hash
                for intervention_index in 0..<engine.intervention_count:
                    final_machine.accumulator <- engine.intervention_accumulators[intervention_index] if replay_engine_intervention_applies(engine, intervention_index, engine.event_count.u64())
                return false if replay_engine_machine_state_hash(final_machine, engine.event_count.u64() - Replay::REPLAY_ENGINE_CHECKPOINT_ID_OFFSET) != replay_engine_machine_state_hash(engine.machine, engine.event_count.u64() - Replay::REPLAY_ENGINE_CHECKPOINT_ID_OFFSET)
            return true

        def replay_engine_fork(engine: mutable ReplayEngine&, branch: DebuggerIdentity::DebugId) -> ReplayEngine:
            forked: mutable ReplayEngine = engine
            if branch.value == Replay::REPLAY_ENGINE_ROOT_BRANCH or branch.value == Replay::REPLAY_ENGINE_MAX_BRANCH_ID or engine.engine_error != EngineError.None or engine.branch_lineage_count == 0 or engine.branch_lineage_count >= Replay::BRANCH_LINEAGE_CAPACITY:
                forked.engine_error <- EngineError.HistoryUnavailable
                return forked
            if engine.branch_lineage_count > 1 and engine.event_count.u64() < engine.fork_event:
                forked.engine_error <- EngineError.HistoryUnavailable
                return forked
            if engine.branch_fork_events[Replay::ROOT_LINEAGE_INDEX] != Replay::ROOT_FORK_EVENT:
                forked.engine_error <- EngineError.HistoryUnavailable
                return forked
            for lineage_index in Replay::FIRST_CHILD_LINEAGE_INDEX..<engine.branch_lineage_count:
                if engine.branch_fork_events[lineage_index] > engine.event_count.u64() or engine.branch_fork_events[lineage_index] < engine.branch_fork_events[lineage_index - Replay::FIRST_CHILD_LINEAGE_INDEX]:
                    forked.engine_error <- EngineError.HistoryUnavailable
                    return forked
            if engine.branch_lineage_count > 1 and engine.branch_fork_events[engine.branch_lineage_count - 1] != engine.fork_event:
                forked.engine_error <- EngineError.HistoryUnavailable
                return forked
            if not replay_engine_is_exact(engine):
                forked.engine_error <- EngineError.HistoryUnavailable
                return forked
            if engine.branch_lineage[Replay::ROOT_LINEAGE_INDEX].value != Replay::REPLAY_ENGINE_ROOT_BRANCH or engine.branch_lineage[engine.branch_lineage_count - 1].value != engine.branch.value:
                forked.engine_error <- EngineError.HistoryUnavailable
                return forked
            if engine.branch_lineage_count == 1:
                if engine.branch.value != Replay::REPLAY_ENGINE_ROOT_BRANCH or engine.parent_branch.value != Replay::REPLAY_ENGINE_ROOT_BRANCH:
                    forked.engine_error <- EngineError.HistoryUnavailable
                    return forked
            else:
                if engine.parent_branch.value != engine.branch_lineage[engine.branch_lineage_count - 2].value:
                    forked.engine_error <- EngineError.HistoryUnavailable
                    return forked
            for lineage_index in 0..<engine.branch_lineage_count:
                if branch.value == engine.branch_lineage[lineage_index].value:
                    forked.engine_error <- EngineError.HistoryUnavailable
                    return forked
            forked.branch <- branch
            forked.parent_branch <- engine.branch
            forked.branch_lineage[engine.branch_lineage_count] <- branch
            forked.branch_fork_events[engine.branch_lineage_count] <- engine.event_count.u64()
            forked.branch_fork_hashes[engine.branch_lineage_count] <- replay_engine_state_hash(engine)
            forked.branch_fork_accumulators[engine.branch_lineage_count] <- engine.machine.accumulator
            forked.branch_lineage_count <- engine.branch_lineage_count + 1
            forked.fork_event <- engine.event_count
            forked.fork_state_hash <- replay_engine_state_hash(engine)
            forked.engine_error <- EngineError.None
            return forked

        def replay_engine_next_branch(engine: mutable ReplayEngine&) -> DebuggerIdentity::DebugId:
            # The root identifier is reserved as the no-branch sentinel.  Do
            # not emit the maximum value either: doing so would wrap the next
            # allocation back to the root and make a later fork appear valid.
            return DebuggerIdentity::debug_id(Replay::REPLAY_ENGINE_ROOT_BRANCH) if engine.next_branch_id == Replay::REPLAY_ENGINE_ROOT_BRANCH or engine.next_branch_id == Replay::REPLAY_ENGINE_MAX_BRANCH_ID
            result: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(engine.next_branch_id)
            engine.next_branch_id <- Replay::REPLAY_ENGINE_ROOT_BRANCH if engine.next_branch_id == Replay::REPLAY_ENGINE_MAX_BRANCH_ID else engine.next_branch_id + Replay::REPLAY_ENGINE_FIRST_BRANCH_ID
            return result

        def replay_engine_set_accumulator(engine: mutable ReplayEngine&, value: i64) -> bool:
            return false if engine.branch.value == Replay::REPLAY_ENGINE_ROOT_BRANCH or engine.machine.halted or engine.machine.faulted
            return false if engine.engine_error != EngineError.None or engine.event_count >= Replay::HISTORY_CAPACITY or engine.event_count < engine.fork_event
            return false if engine.branch_lineage_count < Replay::NON_ROOT_LINEAGE_MINIMUM or engine.branch_lineage_count > Replay::BRANCH_LINEAGE_CAPACITY
            return false if engine.branch_lineage[engine.branch_lineage_count - 1].value != engine.branch.value
            return false if not replay_engine_is_exact(engine)
            retained_interventions: mutable usize = 0
            for index in 0..<engine.intervention_count:
                if engine.intervention_events[index] <= engine.event_count.u64():
                    engine.intervention_events[retained_interventions] <- engine.intervention_events[index]
                    engine.intervention_branches[retained_interventions] <- engine.intervention_branches[index]
                    engine.intervention_accumulators[retained_interventions] <- engine.intervention_accumulators[index]
                    retained_interventions <- retained_interventions + 1
            engine.intervention_count <- retained_interventions
            return false if engine.intervention_count >= Replay::INTERVENTION_CAPACITY
            engine.intervention_events[engine.intervention_count] <- engine.event_count.u64()
            engine.intervention_branches[engine.intervention_count] <- engine.branch
            engine.intervention_accumulators[engine.intervention_count] <- value
            engine.intervention_count <- engine.intervention_count + 1
            engine.machine.accumulator <- value
            if engine.event_count == engine.fork_event:
                current_fork_index: usize = engine.branch_lineage_count - 1
                engine.branch_fork_accumulators[current_fork_index] <- value
                engine.branch_fork_hashes[current_fork_index] <- replay_engine_state_hash(engine)
                engine.fork_state_hash <- engine.branch_fork_hashes[current_fork_index]
            engine.engine_error <- EngineError.None
            return true
