# Full managed checkpoint envelope.  A checkpoint is usable only when every
# logical component validates as an exact, internally consistent state.

include "./checkpoint.elisa"
include "./effects.elisa"
include "./resources.elisa"
include "./adapters.elisa"
include "../concurrency/checkpoint.elisa"
include "../concurrency/runtime.elisa"
include "../core/errors.elisa"
include "../core/identity.elisa"
include "../vm/edir.elisa"

module DebuggerFullCheckpoint:
    private:
        const module Detail:
            REPLAY_FULL_CHECKPOINT_DETAIL_SCHEMA: u32 = 1
            REPLAY_FULL_CHECKPOINT_DETAIL_RECORDING: u32 = 2
            REPLAY_FULL_CHECKPOINT_DETAIL_BRANCH: u32 = 3
            REPLAY_FULL_CHECKPOINT_DETAIL_MACHINE: u32 = 4
            REPLAY_FULL_CHECKPOINT_DETAIL_TASKS: u32 = 5
            EFFECTS: u32 = 6
            RESOURCES: u32 = 7
            INTEGRITY: u32 = 8
            ADAPTERS: u32 = 9
            BUILD_IDENTITY: u32 = 10
            IMAGE_FINGERPRINT: u32 = 11

        const module Full:
            CHECKPOINT_SCHEMA: u32 = 3
            CHECKPOINT_NO_ID: u64 = 0
            CHECKPOINT_MAX_EVENT: u64 = 18446744073709551615
            CHECKPOINT_MAX_BRANCH: u64 = 18446744073709551615
            REPLAY_FULL_CHECKPOINT_CHECKPOINT_ID_OFFSET: u64 = 1
            CHECKPOINT_HASH_OFFSET_BASIS: u64 = 14695981039346656037
            CHECKPOINT_HASH_PRIME: u64 = 1099511628211
            CHECKPOINT_HASH_BYTE_BITS: u64 = 8
            CHECKPOINT_HASH_BYTE_MASK: u64 = 255
            CHECKPOINT_HASH_U16_BYTES: usize = 2
            CHECKPOINT_HASH_U32_BYTES: usize = 4
            CHECKPOINT_HASH_U64_BYTES: usize = 8
            CHECKPOINT_HASH_FALSE: u8 = 0
            CHECKPOINT_HASH_TRUE: u8 = 1
            CHECKPOINT_INVALID_HASH: u64 = 0
            CHECKPOINT_INVALID_METADATA_VERSION: u32 = 0
            CHECKPOINT_EMPTY_INDEX: usize = 0
            CHECKPOINT_MAX_ERROR_CODE: u16 = 12
            CHECKPOINT_MAX_ERROR_SEVERITY: u16 = 2


        def checkpoint_hash_byte(hash: u64, byte: u8) -> u64:
            return (hash ^ byte.u64()) * Full::CHECKPOINT_HASH_PRIME

        def checkpoint_hash_u16(hash: u64, value: u16) -> u64:
            updated: mutable u64 = hash
            for index in 0..<Full::CHECKPOINT_HASH_U16_BYTES:
                updated <- checkpoint_hash_byte(updated, ((value.u64() >> (Full::CHECKPOINT_HASH_BYTE_BITS * index.u64())) & Full::CHECKPOINT_HASH_BYTE_MASK).u8())
            return updated

        def checkpoint_hash_u32(hash: u64, value: u32) -> u64:
            updated: mutable u64 = hash
            for index in 0..<Full::CHECKPOINT_HASH_U32_BYTES:
                updated <- checkpoint_hash_byte(updated, ((value.u64() >> (Full::CHECKPOINT_HASH_BYTE_BITS * index.u64())) & Full::CHECKPOINT_HASH_BYTE_MASK).u8())
            return updated

        def checkpoint_hash_u64(hash: u64, value: u64) -> u64:
            updated: mutable u64 = hash
            for index in 0..<Full::CHECKPOINT_HASH_U64_BYTES:
                updated <- checkpoint_hash_byte(updated, ((value >> (Full::CHECKPOINT_HASH_BYTE_BITS * index.u64())) & Full::CHECKPOINT_HASH_BYTE_MASK).u8())
            return updated

        def checkpoint_hash_bool(hash: u64, value: bool) -> u64:
            return checkpoint_hash_byte(hash, Full::CHECKPOINT_HASH_TRUE if value else Full::CHECKPOINT_HASH_FALSE)

        def checkpoint_build_identity_is_valid(build: DebuggerIdentity::BuildIdentity) -> bool:
            return build.compiler.value != Full::CHECKPOINT_NO_ID and build.runtime.value != Full::CHECKPOINT_NO_ID and build.source.value != Full::CHECKPOINT_NO_ID and build.target.value != Full::CHECKPOINT_NO_ID and build.metadata_version != Full::CHECKPOINT_INVALID_METADATA_VERSION

        def checkpoint_hash_task(hash: u64, task: DebuggerConcurrency::TaskInfo) -> u64:
            updated: mutable u64 = checkpoint_hash_u64(hash, task.id.value)
            updated <- checkpoint_hash_u64(updated, task.parent.value)
            updated <- checkpoint_hash_u16(updated, task.state.u16())
            # OS thread numbers are host attributes. They can be reused or
            # remapped when a checkpoint is restored on another machine, so
            # canonical checkpoint identity must depend on logical task state.
            return checkpoint_hash_u64(updated, task.logical_time)

        def checkpoint_hash_adapter_error(hash: u64, adapter_failure: DebuggerErrors::DebuggerError) -> u64:
            updated: mutable u64 = checkpoint_hash_u16(hash, adapter_failure.code.u16())
            updated <- checkpoint_hash_u16(updated, adapter_failure.severity.u16())
            updated <- checkpoint_hash_bool(updated, adapter_failure.retryable)
            return checkpoint_hash_u32(updated, adapter_failure.detail)

        def checkpoint_hash_adapter_sample(hash: u64, sample: DebuggerReplayAdapters::AdapterSample) -> u64:
            updated: mutable u64 = checkpoint_hash_u64(hash, sample.sequence)
            updated <- checkpoint_hash_u64(updated, sample.source.value)
            return checkpoint_hash_u64(updated, sample.value)

        def checkpoint_hash_adapter_snapshot(hash: u64, snapshot: DebuggerReplayAdapters::AdapterSnapshot&) -> u64:
            clock: DebuggerReplayAdapters::Clock = snapshot.clock
            updated: mutable u64 = checkpoint_hash_u64(hash, clock.count.u64())
            updated <- checkpoint_hash_u64(updated, clock.cursor.u64())
            updated <- checkpoint_hash_u16(updated, clock.mode.u16())
            updated <- checkpoint_hash_bool(updated, clock.exact)
            updated <- checkpoint_hash_adapter_error(updated, clock.last_error)
            for index in 0..<clock.count:
                updated <- checkpoint_hash_adapter_sample(updated, clock.samples[index])

            random: DebuggerReplayAdapters::Random = snapshot.random
            updated <- checkpoint_hash_u64(updated, random.count.u64())
            updated <- checkpoint_hash_u64(updated, random.cursor.u64())
            updated <- checkpoint_hash_u16(updated, random.mode.u16())
            updated <- checkpoint_hash_bool(updated, random.exact)
            updated <- checkpoint_hash_adapter_error(updated, random.last_error)
            for index in 0..<random.count:
                updated <- checkpoint_hash_adapter_sample(updated, random.samples[index])

            console: DebuggerReplayAdapters::Console = snapshot.console
            updated <- checkpoint_hash_u64(updated, console.count.u64())
            updated <- checkpoint_hash_u64(updated, console.cursor.u64())
            updated <- checkpoint_hash_u16(updated, console.mode.u16())
            updated <- checkpoint_hash_bool(updated, console.exact)
            updated <- checkpoint_hash_bool(updated, console.output_suppressed)
            updated <- checkpoint_hash_adapter_error(updated, console.last_error)
            for index in 0..<console.count:
                record: DebuggerReplayAdapters::ConsoleRecord = console.records[index]
                updated <- checkpoint_hash_u64(updated, record.sequence)
                updated <- checkpoint_hash_u16(updated, record.channel.u16())
                updated <- checkpoint_hash_u16(updated, record.kind.u16())
                updated <- checkpoint_hash_u64(updated, record.requested.u64())
                updated <- checkpoint_hash_u64(updated, record.length.u64())
                updated <- checkpoint_hash_bool(updated, record.eof)
                for byte_index in 0..<record.length:
                    updated <- checkpoint_hash_byte(updated, record.bytes[byte_index])
            return updated

        def checkpoint_hash_side_state(checkpoint: ManagedCheckpoint&) -> u64:
            return Full::CHECKPOINT_INVALID_HASH if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(checkpoint.tasks) or not DebuggerEffects::effect_oracle_is_exact(checkpoint.effects) or not DebuggerVirtualResources::resources_is_valid(checkpoint.resources) or not DebuggerReplayAdapters::adapter_snapshot_is_valid(checkpoint.adapters)
            hash: mutable u64 = Full::CHECKPOINT_HASH_OFFSET_BASIS
            hash <- checkpoint_hash_u32(hash, checkpoint.schema)
            hash <- checkpoint_hash_u64(hash, checkpoint.recording.value)
            hash <- checkpoint_hash_u64(hash, checkpoint.branch.value)
            hash <- checkpoint_hash_u64(hash, checkpoint.event)
            hash <- checkpoint_hash_u64(hash, checkpoint.build.compiler.value)
            hash <- checkpoint_hash_u64(hash, checkpoint.build.runtime.value)
            hash <- checkpoint_hash_u64(hash, checkpoint.build.source.value)
            hash <- checkpoint_hash_u64(hash, checkpoint.build.target.value)
            hash <- checkpoint_hash_u32(hash, checkpoint.build.metadata_version)
            hash <- checkpoint_hash_u64(hash, checkpoint.image_fingerprint)
            hash <- checkpoint_hash_bool(hash, checkpoint.image_fingerprint_valid)

            tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = checkpoint.tasks
            hash <- checkpoint_hash_u64(hash, tasks.task_count.u64())
            hash <- checkpoint_hash_u64(hash, tasks.next_id)
            hash <- checkpoint_hash_u16(hash, tasks.status.u16())
            hash <- checkpoint_hash_u64(hash, tasks.current.value)
            hash <- checkpoint_hash_u64(hash, tasks.wait_count.u64())
            hash <- checkpoint_hash_u64(hash, tasks.scheduler_cursor.u64())
            hash <- checkpoint_hash_u64(hash, tasks.scheduler_count.u64())
            hash <- checkpoint_hash_bool(hash, tasks.scheduler_replaying)
            hash <- checkpoint_hash_bool(hash, tasks.scheduler_diverged)
            hash <- checkpoint_hash_bool(hash, tasks.scheduler_overflowed)
            for index in 0..<tasks.task_count:
                hash <- checkpoint_hash_task(hash, tasks.tasks[index])
            for index in 0..<tasks.wait_count:
                edge: DebuggerConcurrency::WaitEdge = tasks.waits[index]
                hash <- checkpoint_hash_u64(hash, edge.waiter.value)
                hash <- checkpoint_hash_u64(hash, edge.owner.value)
                hash <- checkpoint_hash_u64(hash, edge.resource.value)
                hash <- checkpoint_hash_u16(hash, edge.kind.u16())
            for index in 0..<tasks.scheduler_count:
                decision: DebuggerScheduler::ScheduleDecision = tasks.scheduler_decisions[index]
                hash <- checkpoint_hash_u64(hash, decision.ordinal)
                hash <- checkpoint_hash_task(hash, decision.task)
                hash <- checkpoint_hash_u16(hash, decision.kind.u16())
                hash <- checkpoint_hash_u64(hash, decision.synchronization)

            effects: DebuggerEffects::EffectOracle& = checkpoint.effects
            hash <- checkpoint_hash_u64(hash, effects.count.u64())
            hash <- checkpoint_hash_u64(hash, effects.cursor.u64())
            hash <- checkpoint_hash_u16(hash, effects.mode.u16())
            hash <- checkpoint_hash_u16(hash, effects.exactness.u16())
            hash <- checkpoint_hash_bool(hash, effects.overflowed)
            hash <- checkpoint_hash_u16(hash, effects.last_error.code.u16())
            hash <- checkpoint_hash_u16(hash, effects.last_error.severity.u16())
            hash <- checkpoint_hash_bool(hash, effects.last_error.retryable)
            hash <- checkpoint_hash_u32(hash, effects.last_error.detail)
            for index in 0..<effects.count:
                record: DebuggerEffects::EffectRecord = effects.records[index]
                hash <- checkpoint_hash_u64(hash, record.sequence)
                hash <- checkpoint_hash_u16(hash, record.kind.u16())
                hash <- checkpoint_hash_u64(hash, record.request_hash)
                hash <- checkpoint_hash_u64(hash, record.result_hash)
                hash <- checkpoint_hash_u64(hash, record.result_value.u64())
                hash <- checkpoint_hash_bool(hash, record.suppress_external_write)

            resources: DebuggerVirtualResources::ResourceStore = checkpoint.resources
            hash <- checkpoint_hash_u64(hash, resources.count.u64())
            hash <- checkpoint_hash_u64(hash, resources.next_handle)
            hash <- checkpoint_hash_u16(hash, resources.mode.u16())
            for index in 0..<resources.count:
                file: DebuggerVirtualResources::VirtualFile = resources.files[index]
                hash <- checkpoint_hash_u64(hash, file.handle.value)
                hash <- checkpoint_hash_u64(hash, file.path.value)
                hash <- checkpoint_hash_u64(hash, file.length.u64())
                hash <- checkpoint_hash_u64(hash, file.cursor.u64())
                hash <- checkpoint_hash_bool(hash, file.writable)
                hash <- checkpoint_hash_u64(hash, file.generation)
                for byte_index in 0..<file.length:
                    hash <- checkpoint_hash_byte(hash, file.bytes[byte_index])
            return checkpoint_hash_adapter_snapshot(hash, checkpoint.adapters)

    public:
        struct ManagedCheckpoint:
            schema: mutable u32
            recording: mutable DebuggerIdentity::DebugId
            branch: mutable DebuggerIdentity::DebugId
            event: mutable u64
            state_hash: mutable u64
            build: mutable DebuggerIdentity::BuildIdentity
            image_fingerprint: mutable u64
            image_fingerprint_valid: mutable bool
            # Derived fingerprint catches edits to mutable side state after capture.
            side_state_hash: mutable u64
            machine: mutable DebuggerCheckpoint::MachineSnapshot
            tasks: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot
            effects: mutable DebuggerEffects::EffectOracle
            resources: mutable DebuggerVirtualResources::ResourceStore
            adapters: mutable DebuggerReplayAdapters::AdapterSnapshot

        def full_checkpoint_validate(checkpoint: ManagedCheckpoint&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_FULL_CHECKPOINT_DETAIL_SCHEMA) if checkpoint.schema != Full::CHECKPOINT_SCHEMA
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_FULL_CHECKPOINT_DETAIL_RECORDING) if checkpoint.recording.value == Full::CHECKPOINT_NO_ID
            # Branch zero is the canonical root branch, not a missing value.  A
            # checkpoint taken before the first fork therefore legitimately
            # carries branch 0; only the reserved terminal id is invalid here.
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::REPLAY_FULL_CHECKPOINT_DETAIL_BRANCH) if checkpoint.branch.value == Full::CHECKPOINT_MAX_BRANCH
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::BUILD_IDENTITY) if not checkpoint_build_identity_is_valid(checkpoint.build)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::IMAGE_FINGERPRINT) if not checkpoint.image_fingerprint_valid
            expected_machine_id: u64 = Full::CHECKPOINT_MAX_EVENT if checkpoint.event == Full::CHECKPOINT_MAX_EVENT else checkpoint.event + Full::REPLAY_FULL_CHECKPOINT_CHECKPOINT_ID_OFFSET
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::REPLAY_FULL_CHECKPOINT_DETAIL_MACHINE) if checkpoint.machine.id.value == Full::CHECKPOINT_NO_ID or checkpoint.machine.id.value != expected_machine_id or checkpoint.machine.event != checkpoint.event or checkpoint.machine.state_hash != checkpoint.state_hash or not DebuggerCheckpoint::snapshot_shape_is_valid(checkpoint.machine) or checkpoint.machine.state_hash != DebuggerCheckpoint::snapshot_state_hash(checkpoint.machine)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::REPLAY_FULL_CHECKPOINT_DETAIL_TASKS) if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(checkpoint.tasks)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::EFFECTS) if not DebuggerEffects::effect_oracle_is_exact(checkpoint.effects)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::RESOURCES) if not DebuggerVirtualResources::resources_is_valid(checkpoint.resources)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::ADAPTERS) if not DebuggerReplayAdapters::adapter_snapshot_is_valid(checkpoint.adapters)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::INTEGRITY) if checkpoint.adapters.clock.last_error.code.u16() > Full::CHECKPOINT_MAX_ERROR_CODE or checkpoint.adapters.clock.last_error.severity.u16() > Full::CHECKPOINT_MAX_ERROR_SEVERITY or checkpoint.adapters.random.last_error.code.u16() > Full::CHECKPOINT_MAX_ERROR_CODE or checkpoint.adapters.random.last_error.severity.u16() > Full::CHECKPOINT_MAX_ERROR_SEVERITY or checkpoint.adapters.console.last_error.code.u16() > Full::CHECKPOINT_MAX_ERROR_CODE or checkpoint.adapters.console.last_error.severity.u16() > Full::CHECKPOINT_MAX_ERROR_SEVERITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::INTEGRITY) if checkpoint.side_state_hash != checkpoint_hash_side_state(checkpoint)
            return DebuggerErrors::no_error()

        def full_checkpoint_capture_with_adapters(machine: DebuggerEDIR::Machine, tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot, effects: DebuggerEffects::EffectOracle&, resources: DebuggerVirtualResources::ResourceStore, adapters: DebuggerReplayAdapters::AdapterSnapshot&, recording: DebuggerIdentity::DebugId, branch: DebuggerIdentity::DebugId, event: u64, state_hash: u64, build: DebuggerIdentity::BuildIdentity, image_fingerprint: u64, image_fingerprint_valid: bool) -> ManagedCheckpoint:
            checkpoint: mutable ManagedCheckpoint = ManagedCheckpoint{
                schema: Full::CHECKPOINT_SCHEMA,
                recording: recording,
                branch: branch,
                event: event,
                state_hash: state_hash,
                build: build,
                image_fingerprint: image_fingerprint,
                image_fingerprint_valid: image_fingerprint_valid,
                side_state_hash: Full::CHECKPOINT_INVALID_HASH,
                machine: DebuggerCheckpoint::snapshot_capture(machine, DebuggerIdentity::debug_id(Full::CHECKPOINT_MAX_EVENT if event == Full::CHECKPOINT_MAX_EVENT else event + Full::REPLAY_FULL_CHECKPOINT_CHECKPOINT_ID_OFFSET), event, state_hash),
                tasks: tasks,
                effects: effects,
                resources: DebuggerVirtualResources::resources_clone_snapshot(resources),
                adapters: adapters
            }
            checkpoint.side_state_hash <- checkpoint_hash_side_state(checkpoint)
            return checkpoint

        def full_checkpoint_seal_side_state(checkpoint: mutable ManagedCheckpoint&) -> void:
            checkpoint.side_state_hash <- checkpoint_hash_side_state(checkpoint)

        def full_checkpoint_is_valid(checkpoint: ManagedCheckpoint&) -> bool:
            return DebuggerErrors::error_is_ok(full_checkpoint_validate(checkpoint))

        def full_checkpoint_restore_machine(checkpoint: ManagedCheckpoint&) -> DebuggerEDIR::Machine:
            restored: mutable DebuggerEDIR::Machine = zeroed
            if not full_checkpoint_is_valid(checkpoint):
                restored.halted <- true
                restored.faulted <- true
                return restored
            return DebuggerCheckpoint::snapshot_restore(checkpoint.machine)

        def full_checkpoint_restore_tasks(runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime&, checkpoint: ManagedCheckpoint&) -> DebuggerErrors::DebuggerError:
            failure: DebuggerErrors::DebuggerError = full_checkpoint_validate(checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            DebuggerConcurrencyCheckpoint::task_snapshot_restore(runtime, checkpoint.tasks)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::REPLAY_FULL_CHECKPOINT_DETAIL_TASKS) if not DebuggerConcurrencyCheckpoint::task_snapshot_matches(runtime, checkpoint.tasks)
            return DebuggerErrors::no_error()

        def full_checkpoint_restore_effects(effects: mutable DebuggerEffects::EffectOracle&, checkpoint: ManagedCheckpoint&) -> DebuggerErrors::DebuggerError:
            failure: DebuggerErrors::DebuggerError = full_checkpoint_validate(checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            effects.count <- checkpoint.effects.count
            effects.cursor <- checkpoint.effects.cursor
            effects.mode <- checkpoint.effects.mode
            effects.exactness <- checkpoint.effects.exactness
            effects.overflowed <- checkpoint.effects.overflowed
            effects.last_error <- checkpoint.effects.last_error
            for index in Full::CHECKPOINT_EMPTY_INDEX..<checkpoint.effects.count:
                effects.records[index] <- checkpoint.effects.records[index]
            return DebuggerErrors::no_error()

        def full_checkpoint_resources(checkpoint: ManagedCheckpoint&) -> DebuggerVirtualResources::ResourceStore:
            result: mutable DebuggerVirtualResources::ResourceStore = zeroed
            return result if not full_checkpoint_is_valid(checkpoint)
            return DebuggerVirtualResources::resources_clone_snapshot(checkpoint.resources)

        def full_checkpoint_adapters(checkpoint: ManagedCheckpoint&) -> DebuggerReplayAdapters::AdapterSnapshot:
            result: mutable DebuggerReplayAdapters::AdapterSnapshot = zeroed
            return result if not full_checkpoint_is_valid(checkpoint)
            return checkpoint.adapters

        def full_checkpoint_restore_adapters(adapters: mutable DebuggerReplayAdapters::AdapterSnapshot&, checkpoint: ManagedCheckpoint&) -> DebuggerErrors::DebuggerError:
            failure: DebuggerErrors::DebuggerError = full_checkpoint_validate(checkpoint)
            return failure if not DebuggerErrors::error_is_ok(failure)
            adapters <- checkpoint.adapters
            return DebuggerErrors::no_error()
