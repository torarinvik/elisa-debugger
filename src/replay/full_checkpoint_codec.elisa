# Canonical bounded codec for the complete managed checkpoint envelope.
# Durable values are encoded field-by-field in little-endian order; host
# structure layout and inactive array slots are never serialized.

include "./full_checkpoint.elisa"
include "./checkpoint_codec.elisa"
include "../trace/binary.elisa"

const module DebuggerFullCheckpointCodecCapacity:
    U16_BYTES: usize = 2
    U32_BYTES: usize = 4
    U64_BYTES: usize = 8
    BOOL_BYTES: usize = 1
    TASK_CAPACITY: usize = 64
    WAIT_CAPACITY: usize = 128
    SCHEDULE_CAPACITY: usize = 512
    EFFECT_CAPACITY: usize = 256
    RESOURCE_CAPACITY: usize = 16
    RESOURCE_DATA_CAPACITY: usize = 256
    RESOURCE_OPERATION_CAPACITY: usize = 32
    ADAPTER_SAMPLE_CAPACITY: usize = 128
    CONSOLE_RECORD_CAPACITY: usize = 64
    CONSOLE_DATA_CAPACITY: usize = 256
    TASK_INFO_BYTES: usize = U64_BYTES * 4 + U16_BYTES
    WAIT_EDGE_BYTES: usize = U64_BYTES * 3 + U16_BYTES
    SCHEDULE_DECISION_BYTES: usize = U64_BYTES * 2 + TASK_INFO_BYTES + U16_BYTES
    EFFECT_RECORD_BYTES: usize = U64_BYTES * 6 + U16_BYTES + BOOL_BYTES
    RESOURCE_FILE_HEADER_BYTES: usize = U64_BYTES * 6 + BOOL_BYTES * 2
    RESOURCE_OPERATION_HEADER_BYTES: usize = U64_BYTES * 7 + U16_BYTES + BOOL_BYTES * 2
    # Header/schema fields, recording coordinates, stable build identity,
    # complete-image fingerprint, and its validity bit.
    OUTER_FIXED_BYTES: usize = U32_BYTES * 4 + U64_BYTES * 9 + BOOL_BYTES
    TASK_FIXED_BYTES: usize = U64_BYTES * 6 + U16_BYTES + BOOL_BYTES * 3
    EFFECT_FIXED_BYTES: usize = U64_BYTES * 2 + U16_BYTES * 4 + BOOL_BYTES * 2 + U32_BYTES
    RESOURCE_FIXED_BYTES: usize = U64_BYTES * 4 + U16_BYTES + BOOL_BYTES
    ADAPTER_SAMPLE_BYTES: usize = U64_BYTES * 4
    ADAPTER_FIXED_BYTES: usize = U64_BYTES * 2 + U16_BYTES + BOOL_BYTES + U16_BYTES * 2 + BOOL_BYTES + U32_BYTES
    CONSOLE_RECORD_HEADER_BYTES: usize = U64_BYTES * 3 + U16_BYTES * 2 + BOOL_BYTES
    CONSOLE_FIXED_BYTES: usize = U64_BYTES * 2 + U16_BYTES + BOOL_BYTES * 2 + U16_BYTES * 2 + BOOL_BYTES + U32_BYTES
    CHECKSUM_BYTES: usize = U64_BYTES
    MAX_TASK_BYTES: usize = TASK_FIXED_BYTES + TASK_CAPACITY * TASK_INFO_BYTES + WAIT_CAPACITY * WAIT_EDGE_BYTES + SCHEDULE_CAPACITY * SCHEDULE_DECISION_BYTES
    MAX_EFFECT_BYTES: usize = EFFECT_FIXED_BYTES + EFFECT_CAPACITY * EFFECT_RECORD_BYTES
    MAX_RESOURCE_BYTES: usize = RESOURCE_FIXED_BYTES + RESOURCE_CAPACITY * (RESOURCE_FILE_HEADER_BYTES + RESOURCE_DATA_CAPACITY * 2) + RESOURCE_OPERATION_CAPACITY * (RESOURCE_OPERATION_HEADER_BYTES + RESOURCE_DATA_CAPACITY)
    MAX_CLOCK_BYTES: usize = ADAPTER_FIXED_BYTES + ADAPTER_SAMPLE_CAPACITY * ADAPTER_SAMPLE_BYTES
    MAX_RANDOM_BYTES: usize = ADAPTER_FIXED_BYTES + ADAPTER_SAMPLE_CAPACITY * ADAPTER_SAMPLE_BYTES
    MAX_CONSOLE_BYTES: usize = CONSOLE_FIXED_BYTES + CONSOLE_RECORD_CAPACITY * (CONSOLE_RECORD_HEADER_BYTES + CONSOLE_DATA_CAPACITY)
    MAX_ADAPTER_BYTES: usize = MAX_CLOCK_BYTES + MAX_RANDOM_BYTES + MAX_CONSOLE_BYTES
    FULL_CHECKPOINT_CODEC_CAPACITY: usize = OUTER_FIXED_BYTES + DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES + MAX_TASK_BYTES + MAX_EFFECT_BYTES + MAX_RESOURCE_BYTES + MAX_ADAPTER_BYTES + CHECKSUM_BYTES

module DebuggerFullCheckpointCodec:
    private:
        const module Codec:
            REPLAY_FULL_CHECKPOINT_CODEC_MAGIC: u32 = 1263022918
            REPLAY_FULL_CHECKPOINT_CODEC_SCHEMA: u32 = 10
            LEGACY_CODEC_SCHEMA: u32 = 9
            REPLAY_FULL_CHECKPOINT_CODEC_BYTE_BITS: u64 = 8
            REPLAY_FULL_CHECKPOINT_CODEC_BYTE_MASK: u64 = 255
            FIRST_INDEX: usize = 0
            REPLAY_FULL_CHECKPOINT_CODEC_FALSE: u8 = 0
            REPLAY_FULL_CHECKPOINT_CODEC_TRUE: u8 = 1
            REPLAY_FULL_CHECKPOINT_CODEC_TASK_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::TASK_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_WAIT_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::WAIT_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_SCHEDULE_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::SCHEDULE_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_EFFECT_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::EFFECT_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::RESOURCE_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_DATA_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::RESOURCE_DATA_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_OPERATION_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::RESOURCE_OPERATION_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_ADAPTER_SAMPLE_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::ADAPTER_SAMPLE_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_RECORD_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::CONSOLE_RECORD_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_DATA_CAPACITY: usize = DebuggerFullCheckpointCodecCapacity::CONSOLE_DATA_CAPACITY
            REPLAY_FULL_CHECKPOINT_CODEC_TASK_STATE_MAX: u16 = 5
            SYNC_KIND_MAX: u16 = 4
            RUNTIME_STATUS_MAX: u16 = 4
            SCHEDULE_KIND_MAX: u16 = 6
            EFFECT_KIND_MAX: u16 = 12
            LEGACY_EFFECT_KIND_MAX: u16 = 9
            EFFECT_MODE_MAX: u16 = 4
            EFFECT_EXACTNESS_MAX: u16 = 3
            RESOURCE_MODE_MAX: u16 = 2
            REPLAY_FULL_CHECKPOINT_CODEC_ERROR_CODE_MAX: u16 = 12
            REPLAY_FULL_CHECKPOINT_CODEC_ERROR_SEVERITY_MAX: u16 = 2
            ENUM_ZERO: u16 = 0
            ENUM_ONE: u16 = 1
            ENUM_TWO: u16 = 2
            ENUM_THREE: u16 = 3
            ENUM_FOUR: u16 = 4
            ENUM_FIVE: u16 = 5
            ENUM_SIX: u16 = 6
            ENUM_SEVEN: u16 = 7
            ENUM_EIGHT: u16 = 8
            ENUM_NINE: u16 = 9
            ENUM_TEN: u16 = 10
            ENUM_ELEVEN: u16 = 11
            ENUM_TWELVE: u16 = 12
            REPLAY_FULL_CHECKPOINT_CODEC_U16_BYTES: usize = DebuggerFullCheckpointCodecCapacity::U16_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_U32_BYTES: usize = DebuggerFullCheckpointCodecCapacity::U32_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_U64_BYTES: usize = DebuggerFullCheckpointCodecCapacity::U64_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_BOOL_BYTES: usize = DebuggerFullCheckpointCodecCapacity::BOOL_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_TASK_INFO_BYTES: usize = DebuggerFullCheckpointCodecCapacity::TASK_INFO_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_WAIT_EDGE_BYTES: usize = DebuggerFullCheckpointCodecCapacity::WAIT_EDGE_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_SCHEDULE_DECISION_BYTES: usize = DebuggerFullCheckpointCodecCapacity::SCHEDULE_DECISION_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_EFFECT_RECORD_BYTES: usize = DebuggerFullCheckpointCodecCapacity::EFFECT_RECORD_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_FILE_HEADER_BYTES: usize = DebuggerFullCheckpointCodecCapacity::RESOURCE_FILE_HEADER_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_OUTER_FIXED_BYTES: usize = DebuggerFullCheckpointCodecCapacity::OUTER_FIXED_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_TASK_FIXED_BYTES: usize = DebuggerFullCheckpointCodecCapacity::TASK_FIXED_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_EFFECT_FIXED_BYTES: usize = DebuggerFullCheckpointCodecCapacity::EFFECT_FIXED_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_FIXED_BYTES: usize = DebuggerFullCheckpointCodecCapacity::RESOURCE_FIXED_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_ADAPTER_SAMPLE_BYTES: usize = DebuggerFullCheckpointCodecCapacity::ADAPTER_SAMPLE_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_ADAPTER_FIXED_BYTES: usize = DebuggerFullCheckpointCodecCapacity::ADAPTER_FIXED_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_RECORD_HEADER_BYTES: usize = DebuggerFullCheckpointCodecCapacity::CONSOLE_RECORD_HEADER_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_FIXED_BYTES: usize = DebuggerFullCheckpointCodecCapacity::CONSOLE_FIXED_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_CHECKSUM_BYTES: usize = DebuggerFullCheckpointCodecCapacity::CHECKSUM_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_MAX_TASK_BYTES: usize = DebuggerFullCheckpointCodecCapacity::MAX_TASK_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_MAX_EFFECT_BYTES: usize = DebuggerFullCheckpointCodecCapacity::MAX_EFFECT_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_MAX_RESOURCE_BYTES: usize = DebuggerFullCheckpointCodecCapacity::MAX_RESOURCE_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_MAX_CLOCK_BYTES: usize = DebuggerFullCheckpointCodecCapacity::MAX_CLOCK_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_MAX_RANDOM_BYTES: usize = DebuggerFullCheckpointCodecCapacity::MAX_RANDOM_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_MAX_CONSOLE_BYTES: usize = DebuggerFullCheckpointCodecCapacity::MAX_CONSOLE_BYTES
            REPLAY_FULL_CHECKPOINT_CODEC_MAX_ADAPTER_BYTES: usize = DebuggerFullCheckpointCodecCapacity::MAX_ADAPTER_BYTES
            MAX_PAYLOAD_BYTES: usize = DebuggerFullCheckpointCodecCapacity::FULL_CHECKPOINT_CODEC_CAPACITY

        const module Full:
            CHECKPOINT_CODEC_CAPACITY: usize = Codec::MAX_PAYLOAD_BYTES


    public:

        enum DecodeStatus:
            Ready
            Truncated
            Invalid
            Oversized

        struct EncodedCheckpoint:
            bytes: mutable u8[Codec::MAX_PAYLOAD_BYTES]
            length: mutable usize
            failed: mutable bool

        struct DecodedCheckpoint:
            checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint
            status: mutable DecodeStatus

    private:
        struct CheckpointReader:
            bytes: mutable u8[Codec::MAX_PAYLOAD_BYTES]
            length: mutable usize
            offset: mutable usize
            failed: mutable bool
            truncated: mutable bool

        def writer_put_byte(writer: mutable EncodedCheckpoint&, value: u8) -> void:
            if writer.failed or writer.length >= Codec::MAX_PAYLOAD_BYTES:
                writer.failed <- true
                return
            writer.bytes[writer.length] <- value
            writer.length <- writer.length + 1

        def writer_put_u16(writer: mutable EncodedCheckpoint&, value: u16) -> void:
            writer_put_byte(writer, (value.u64() & Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_MASK).u8())
            writer_put_byte(writer, ((value.u64() >> Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_BITS) & Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_MASK).u8())

        def writer_put_u32(writer: mutable EncodedCheckpoint&, value: u32) -> void:
            for shift in Codec::FIRST_INDEX..<Codec::REPLAY_FULL_CHECKPOINT_CODEC_U32_BYTES:
                writer_put_byte(writer, ((value.u64() >> (Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_BITS * shift.u64())) & Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_MASK).u8())

        def writer_put_u64(writer: mutable EncodedCheckpoint&, value: u64) -> void:
            for shift in Codec::FIRST_INDEX..<Codec::REPLAY_FULL_CHECKPOINT_CODEC_U64_BYTES:
                writer_put_byte(writer, ((value >> (Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_BITS * shift.u64())) & Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_MASK).u8())

        def writer_put_build_identity(writer: mutable EncodedCheckpoint&, build: DebuggerIdentity::BuildIdentity) -> void:
            writer_put_u64(writer, build.compiler.value)
            writer_put_u64(writer, build.runtime.value)
            writer_put_u64(writer, build.source.value)
            writer_put_u64(writer, build.target.value)
            writer_put_u32(writer, build.metadata_version)

        def writer_put_bool(writer: mutable EncodedCheckpoint&, value: bool) -> void:
            writer_put_byte(writer, Codec::REPLAY_FULL_CHECKPOINT_CODEC_TRUE if value else Codec::REPLAY_FULL_CHECKPOINT_CODEC_FALSE)

        def writer_put_task_info(writer: mutable EncodedCheckpoint&, task: DebuggerConcurrency::TaskInfo) -> void:
            writer_put_u64(writer, task.id.value)
            writer_put_u64(writer, task.parent.value)
            writer_put_u16(writer, task.state.u16())
            writer_put_u64(writer, task.logical_time)
            writer_put_u64(writer, task.os_thread)

        def writer_put_wait_edge(writer: mutable EncodedCheckpoint&, edge: DebuggerConcurrency::WaitEdge) -> void:
            writer_put_u64(writer, edge.waiter.value)
            writer_put_u64(writer, edge.owner.value)
            writer_put_u64(writer, edge.resource.value)
            writer_put_u16(writer, edge.kind.u16())

        def writer_put_schedule_decision(writer: mutable EncodedCheckpoint&, decision: DebuggerScheduler::ScheduleDecision) -> void:
            writer_put_u64(writer, decision.ordinal)
            writer_put_task_info(writer, decision.task)
            writer_put_u16(writer, decision.kind.u16())
            writer_put_u64(writer, decision.synchronization)

        def writer_put_effect_record(writer: mutable EncodedCheckpoint&, record: DebuggerEffects::EffectRecord) -> void:
            writer_put_u64(writer, record.sequence)
            writer_put_u16(writer, record.kind.u16())
            writer_put_u64(writer, record.call_site.value)
            writer_put_u64(writer, record.invocation.value)
            writer_put_u64(writer, record.request_hash)
            writer_put_u64(writer, record.result_hash)
            writer_put_u64(writer, record.result_value.u64())
            writer_put_bool(writer, record.suppress_external_write)

        def writer_put_adapter_error(writer: mutable EncodedCheckpoint&, adapter_failure: DebuggerErrors::DebuggerError) -> void:
            writer_put_u16(writer, adapter_failure.code.u16())
            writer_put_u16(writer, adapter_failure.severity.u16())
            writer_put_bool(writer, adapter_failure.retryable)
            writer_put_u32(writer, adapter_failure.detail)

        def writer_put_adapter_sample(writer: mutable EncodedCheckpoint&, sample: DebuggerReplayAdapters::AdapterSample) -> void:
            writer_put_u64(writer, sample.sequence)
            writer_put_u64(writer, sample.source.value)
            writer_put_u64(writer, sample.invocation.value)
            writer_put_u64(writer, sample.value)

        def writer_put_clock(writer: mutable EncodedCheckpoint&, clock: DebuggerReplayAdapters::Clock&) -> void:
            writer_put_u64(writer, clock.count.u64())
            writer_put_u64(writer, clock.cursor.u64())
            writer_put_u16(writer, clock.mode.u16())
            writer_put_bool(writer, clock.exact)
            writer_put_adapter_error(writer, clock.last_error)
            for index in Codec::FIRST_INDEX..<clock.count:
                writer_put_adapter_sample(writer, clock.samples[index])

        def writer_put_random(writer: mutable EncodedCheckpoint&, random: DebuggerReplayAdapters::Random&) -> void:
            writer_put_u64(writer, random.count.u64())
            writer_put_u64(writer, random.cursor.u64())
            writer_put_u16(writer, random.mode.u16())
            writer_put_bool(writer, random.exact)
            writer_put_adapter_error(writer, random.last_error)
            for index in Codec::FIRST_INDEX..<random.count:
                writer_put_adapter_sample(writer, random.samples[index])

        def writer_put_console(writer: mutable EncodedCheckpoint&, console: DebuggerReplayAdapters::Console&) -> void:
            writer_put_u64(writer, console.count.u64())
            writer_put_u64(writer, console.cursor.u64())
            writer_put_u16(writer, console.mode.u16())
            writer_put_bool(writer, console.exact)
            writer_put_bool(writer, console.output_suppressed)
            writer_put_adapter_error(writer, console.last_error)
            for index in Codec::FIRST_INDEX..<console.count:
                record: DebuggerReplayAdapters::ConsoleRecord = console.records[index]
                writer_put_u64(writer, record.sequence)
                writer_put_u16(writer, record.channel.u16())
                writer_put_u16(writer, record.kind.u16())
                writer_put_u64(writer, record.requested.u64())
                writer_put_u64(writer, record.length.u64())
                writer_put_bool(writer, record.eof)
                for byte_index in Codec::FIRST_INDEX..<record.length:
                    writer_put_byte(writer, record.bytes[byte_index])

        def writer_put_adapter_snapshot(writer: mutable EncodedCheckpoint&, snapshot: DebuggerReplayAdapters::AdapterSnapshot&) -> void:
            writer_put_clock(writer, snapshot.clock)
            writer_put_random(writer, snapshot.random)
            writer_put_console(writer, snapshot.console)

        def writer_put_task_snapshot(writer: mutable EncodedCheckpoint&, snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot&) -> void:
            writer_put_u64(writer, snapshot.task_count.u64())
            writer_put_u64(writer, snapshot.next_id)
            writer_put_u16(writer, snapshot.status.u16())
            writer_put_u64(writer, snapshot.current.value)
            writer_put_u64(writer, snapshot.wait_count.u64())
            writer_put_u64(writer, snapshot.scheduler_cursor.u64())
            writer_put_u64(writer, snapshot.scheduler_count.u64())
            writer_put_bool(writer, snapshot.scheduler_replaying)
            writer_put_bool(writer, snapshot.scheduler_diverged)
            writer_put_bool(writer, snapshot.scheduler_overflowed)
            for index in Codec::FIRST_INDEX..<snapshot.task_count:
                writer_put_task_info(writer, snapshot.tasks[index])
            for index in Codec::FIRST_INDEX..<snapshot.wait_count:
                writer_put_wait_edge(writer, snapshot.waits[index])
            for index in Codec::FIRST_INDEX..<snapshot.scheduler_count:
                writer_put_schedule_decision(writer, snapshot.scheduler_decisions[index])

        def writer_put_effect_oracle(writer: mutable EncodedCheckpoint&, oracle: DebuggerEffects::EffectOracle&) -> void:
            writer_put_u64(writer, oracle.count.u64())
            writer_put_u64(writer, oracle.cursor.u64())
            writer_put_u16(writer, oracle.mode.u16())
            writer_put_u16(writer, oracle.exactness.u16())
            writer_put_bool(writer, oracle.overflowed)
            writer_put_u16(writer, oracle.last_error.code.u16())
            writer_put_u16(writer, oracle.last_error.severity.u16())
            writer_put_bool(writer, oracle.last_error.retryable)
            writer_put_u32(writer, oracle.last_error.detail)
            for index in Codec::FIRST_INDEX..<oracle.count:
                writer_put_effect_record(writer, oracle.records[index])

        def writer_put_resource_store(writer: mutable EncodedCheckpoint&, resources: DebuggerVirtualResources::ResourceStore&) -> void:
            writer_put_u64(writer, resources.count.u64())
            writer_put_u64(writer, resources.next_handle)
            writer_put_u16(writer, resources.mode.u16())
            writer_put_u64(writer, resources.operation_count.u64())
            writer_put_u64(writer, resources.operation_cursor.u64())
            writer_put_bool(writer, resources.operation_overflowed)
            for index in Codec::FIRST_INDEX..<resources.count:
                file: DebuggerVirtualResources::VirtualFile = resources.files[index]
                writer_put_u64(writer, file.handle.value)
                writer_put_u64(writer, file.path.value)
                writer_put_u64(writer, file.length.u64())
                writer_put_u64(writer, file.cursor.u64())
                writer_put_u64(writer, file.initial_length.u64())
                writer_put_bool(writer, file.writable)
                writer_put_bool(writer, file.mounted)
                writer_put_u64(writer, file.generation)
                for byte_index in Codec::FIRST_INDEX..<file.length:
                    writer_put_byte(writer, file.bytes[byte_index])
                for byte_index in Codec::FIRST_INDEX..<file.initial_length:
                    writer_put_byte(writer, file.initial_bytes[byte_index])
            for index in Codec::FIRST_INDEX..<resources.operation_count:
                operation: DebuggerVirtualResources::ResourceOperation = resources.operations[index]
                writer_put_u64(writer, operation.sequence)
                writer_put_u16(writer, operation.kind.u16())
                writer_put_u64(writer, operation.handle.value)
                writer_put_u64(writer, operation.path.value)
                writer_put_u64(writer, operation.generation)
                writer_put_bool(writer, operation.writable)
                writer_put_u64(writer, operation.offset.u64())
                writer_put_u64(writer, operation.requested.u64())
                writer_put_u64(writer, operation.transferred.u64())
                writer_put_bool(writer, operation.eof)
                for byte_index in Codec::FIRST_INDEX..<operation.transferred:
                    writer_put_byte(writer, operation.bytes[byte_index])

        def reader_initialize(reader: mutable CheckpointReader&, bytes: u8&, length: usize) -> void:
            reader.length <- Codec::FIRST_INDEX
            reader.offset <- Codec::FIRST_INDEX
            reader.failed <- false
            reader.truncated <- false
            if length > Codec::MAX_PAYLOAD_BYTES:
                reader.failed <- true
                return
            reader.length <- length
            # Only the declared payload is live; every reader operation is
            # bounded by length, so the inactive capacity remains untouched.
            for index in Codec::FIRST_INDEX..<length:
                reader.bytes[index] <- bytes[index]
            return

        def reader_take_byte(reader: mutable CheckpointReader&) -> u8:
            if reader.failed or reader.length > Codec::MAX_PAYLOAD_BYTES or reader.offset >= reader.length:
                reader.failed <- true
                reader.truncated <- true
                return 0
            value: u8 = reader.bytes[reader.offset]
            reader.offset <- reader.offset + 1
            return value

        def reader_take_u16(reader: mutable CheckpointReader&) -> u16:
            low: u64 = reader_take_byte(reader).u64()
            high: u64 = reader_take_byte(reader).u64()
            return (low | (high << Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_BITS)).u16()

        def reader_take_u32(reader: mutable CheckpointReader&) -> u32:
            value: mutable u64 = 0
            for shift in Codec::FIRST_INDEX..<Codec::REPLAY_FULL_CHECKPOINT_CODEC_U32_BYTES:
                value <- value | (reader_take_byte(reader).u64() << (Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_BITS * shift.u64()))
            return value.u32()

        def reader_take_u64(reader: mutable CheckpointReader&) -> u64:
            value: mutable u64 = 0
            for shift in Codec::FIRST_INDEX..<Codec::REPLAY_FULL_CHECKPOINT_CODEC_U64_BYTES:
                value <- value | (reader_take_byte(reader).u64() << (Codec::REPLAY_FULL_CHECKPOINT_CODEC_BYTE_BITS * shift.u64()))
            return value

        def reader_take_build_identity(reader: mutable CheckpointReader&) -> DebuggerIdentity::BuildIdentity:
            return DebuggerIdentity::BuildIdentity{
                compiler: DebuggerIdentity::debug_id(reader_take_u64(reader)),
                runtime: DebuggerIdentity::debug_id(reader_take_u64(reader)),
                source: DebuggerIdentity::debug_id(reader_take_u64(reader)),
                target: DebuggerIdentity::debug_id(reader_take_u64(reader)),
                metadata_version: reader_take_u32(reader)
            }

        def reader_take_bool(reader: mutable CheckpointReader&) -> bool:
            value: u8 = reader_take_byte(reader)
            reader.failed <- true if value > Codec::REPLAY_FULL_CHECKPOINT_CODEC_TRUE
            return value == Codec::REPLAY_FULL_CHECKPOINT_CODEC_TRUE

        def reader_take_count(reader: mutable CheckpointReader&, maximum: usize) -> usize:
            count: u64 = reader_take_u64(reader)
            if count > maximum.u64():
                reader.failed <- true
                return 0
            return count.usize()

        def reader_take_task_state(reader: mutable CheckpointReader&) -> DebuggerConcurrency::TaskState:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::REPLAY_FULL_CHECKPOINT_CODEC_TASK_STATE_MAX
            return DebuggerConcurrency::TaskState.Created if code == Codec::ENUM_ZERO
            return DebuggerConcurrency::TaskState.Runnable if code == Codec::ENUM_ONE
            return DebuggerConcurrency::TaskState.Running if code == Codec::ENUM_TWO
            return DebuggerConcurrency::TaskState.Blocked if code == Codec::ENUM_THREE
            return DebuggerConcurrency::TaskState.Completed if code == Codec::ENUM_FOUR
            return DebuggerConcurrency::TaskState.Cancelled if code == Codec::ENUM_FIVE
            reader.failed <- true
            return DebuggerConcurrency::TaskState.Created

        def reader_take_sync_kind(reader: mutable CheckpointReader&) -> DebuggerConcurrency::SynchronizationKind:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::SYNC_KIND_MAX
            return DebuggerConcurrency::SynchronizationKind.Mutex if code == Codec::ENUM_ZERO
            return DebuggerConcurrency::SynchronizationKind.Condition if code == Codec::ENUM_ONE
            return DebuggerConcurrency::SynchronizationKind.Join if code == Codec::ENUM_TWO
            return DebuggerConcurrency::SynchronizationKind.Channel if code == Codec::ENUM_THREE
            return DebuggerConcurrency::SynchronizationKind.Atomic if code == Codec::ENUM_FOUR
            reader.failed <- true
            return DebuggerConcurrency::SynchronizationKind.Mutex

        def reader_take_runtime_status(reader: mutable CheckpointReader&) -> DebuggerConcurrencyRuntime::RuntimeStatus:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::RUNTIME_STATUS_MAX
            return DebuggerConcurrencyRuntime::RuntimeStatus.Ready if code == Codec::ENUM_ZERO
            return DebuggerConcurrencyRuntime::RuntimeStatus.Running if code == Codec::ENUM_ONE
            return DebuggerConcurrencyRuntime::RuntimeStatus.Blocked if code == Codec::ENUM_TWO
            return DebuggerConcurrencyRuntime::RuntimeStatus.Completed if code == Codec::ENUM_THREE
            return DebuggerConcurrencyRuntime::RuntimeStatus.Diverged if code == Codec::ENUM_FOUR
            reader.failed <- true
            return DebuggerConcurrencyRuntime::RuntimeStatus.Ready

        def reader_take_schedule_kind(reader: mutable CheckpointReader&) -> DebuggerScheduler::ScheduleKind:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::SCHEDULE_KIND_MAX
            return DebuggerScheduler::ScheduleKind.Run if code == Codec::ENUM_ZERO
            return DebuggerScheduler::ScheduleKind.Yield if code == Codec::ENUM_ONE
            return DebuggerScheduler::ScheduleKind.LockAcquire if code == Codec::ENUM_TWO
            return DebuggerScheduler::ScheduleKind.LockRelease if code == Codec::ENUM_THREE
            return DebuggerScheduler::ScheduleKind.Wait if code == Codec::ENUM_FOUR
            return DebuggerScheduler::ScheduleKind.Wake if code == Codec::ENUM_FIVE
            return DebuggerScheduler::ScheduleKind.Join if code == Codec::ENUM_SIX
            reader.failed <- true
            return DebuggerScheduler::ScheduleKind.Run

        def reader_take_effect_kind(reader: mutable CheckpointReader&) -> DebuggerEffects::EffectKind:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::EFFECT_KIND_MAX
            return DebuggerEffects::EffectKind.Clock if code == Codec::ENUM_ZERO
            return DebuggerEffects::EffectKind.Random if code == Codec::ENUM_ONE
            return DebuggerEffects::EffectKind.ConsoleInput if code == Codec::ENUM_TWO
            return DebuggerEffects::EffectKind.ConsoleOutput if code == Codec::ENUM_THREE
            return DebuggerEffects::EffectKind.FileRead if code == Codec::ENUM_FOUR
            return DebuggerEffects::EffectKind.FileWrite if code == Codec::ENUM_FIVE
            return DebuggerEffects::EffectKind.NetworkRead if code == Codec::ENUM_SIX
            return DebuggerEffects::EffectKind.NetworkWrite if code == Codec::ENUM_SEVEN
            return DebuggerEffects::EffectKind.Process if code == Codec::ENUM_EIGHT
            return DebuggerEffects::EffectKind.Foreign if code == Codec::ENUM_NINE
            return DebuggerEffects::EffectKind.VirtualFileTryReadByte if code == Codec::ENUM_TEN
            return DebuggerEffects::EffectKind.VirtualFileTryWriteByte if code == Codec::ENUM_ELEVEN
            return DebuggerEffects::EffectKind.VirtualFileTrySeek if code == Codec::ENUM_TWELVE
            reader.failed <- true
            return DebuggerEffects::EffectKind.Clock

        def reader_take_effect_mode(reader: mutable CheckpointReader&) -> DebuggerEffects::EffectMode:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::EFFECT_MODE_MAX
            return DebuggerEffects::EffectMode.Live if code == Codec::ENUM_ZERO
            return DebuggerEffects::EffectMode.Recording if code == Codec::ENUM_ONE
            return DebuggerEffects::EffectMode.Replaying if code == Codec::ENUM_TWO
            return DebuggerEffects::EffectMode.Virtualized if code == Codec::ENUM_THREE
            return DebuggerEffects::EffectMode.Barrier if code == Codec::ENUM_FOUR
            reader.failed <- true
            return DebuggerEffects::EffectMode.Live

        def reader_take_effect_exactness(reader: mutable CheckpointReader&) -> DebuggerEffects::Exactness:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::EFFECT_EXACTNESS_MAX
            return DebuggerEffects::Exactness.Exact if code == Codec::ENUM_ZERO
            return DebuggerEffects::Exactness.Observational if code == Codec::ENUM_ONE
            return DebuggerEffects::Exactness.Incomplete if code == Codec::ENUM_TWO
            return DebuggerEffects::Exactness.Diverged if code == Codec::ENUM_THREE
            reader.failed <- true
            return DebuggerEffects::Exactness.Diverged

        def reader_take_error_code(reader: mutable CheckpointReader&) -> DebuggerErrors::ErrorCode:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::REPLAY_FULL_CHECKPOINT_CODEC_ERROR_CODE_MAX
            return DebuggerErrors::ErrorCode.None if code == Codec::ENUM_ZERO
            return DebuggerErrors::ErrorCode.InvalidArgument if code == Codec::ENUM_ONE
            return DebuggerErrors::ErrorCode.InvalidState if code == Codec::ENUM_TWO
            return DebuggerErrors::ErrorCode.StaleGeneration if code == Codec::ENUM_THREE
            return DebuggerErrors::ErrorCode.Unsupported if code == Codec::ENUM_FOUR
            return DebuggerErrors::ErrorCode.Unavailable if code == Codec::ENUM_FIVE
            return DebuggerErrors::ErrorCode.Corrupt if code == Codec::ENUM_SIX
            return DebuggerErrors::ErrorCode.Diverged if code == Codec::ENUM_SEVEN
            return DebuggerErrors::ErrorCode.Cancelled if code == Codec::ENUM_EIGHT
            return DebuggerErrors::ErrorCode.ResourceLimit if code == Codec::ENUM_NINE
            return DebuggerErrors::ErrorCode.PermissionDenied if code == Codec::ENUM_TEN
            return DebuggerErrors::ErrorCode.Transport if code == Codec::ENUM_ELEVEN
            return DebuggerErrors::ErrorCode.Internal if code == Codec::ENUM_TWELVE
            reader.failed <- true
            return DebuggerErrors::ErrorCode.None

        def reader_take_error_severity(reader: mutable CheckpointReader&) -> DebuggerErrors::ErrorSeverity:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::REPLAY_FULL_CHECKPOINT_CODEC_ERROR_SEVERITY_MAX
            return DebuggerErrors::ErrorSeverity.Info if code == Codec::ENUM_ZERO
            return DebuggerErrors::ErrorSeverity.Warning if code == Codec::ENUM_ONE
            return DebuggerErrors::ErrorSeverity.Failure if code == Codec::ENUM_TWO
            reader.failed <- true
            return DebuggerErrors::ErrorSeverity.Info

        def reader_take_resource_mode(reader: mutable CheckpointReader&) -> DebuggerVirtualResources::ResourceMode:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::RESOURCE_MODE_MAX
            return DebuggerVirtualResources::ResourceMode.Recording if code == Codec::ENUM_ZERO
            return DebuggerVirtualResources::ResourceMode.Replaying if code == Codec::ENUM_ONE
            return DebuggerVirtualResources::ResourceMode.Branch if code == Codec::ENUM_TWO
            reader.failed <- true
            return DebuggerVirtualResources::ResourceMode.Recording

        def reader_take_resource_operation_kind(reader: mutable CheckpointReader&) -> DebuggerVirtualResources::ResourceOperationKind:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::ENUM_THREE
            return DebuggerVirtualResources::ResourceOperationKind.Open if code == Codec::ENUM_ZERO
            return DebuggerVirtualResources::ResourceOperationKind.Read if code == Codec::ENUM_ONE
            return DebuggerVirtualResources::ResourceOperationKind.Write if code == Codec::ENUM_TWO
            return DebuggerVirtualResources::ResourceOperationKind.Seek if code == Codec::ENUM_THREE
            reader.failed <- true
            return DebuggerVirtualResources::ResourceOperationKind.Open

        def reader_take_adapter_mode(reader: mutable CheckpointReader&) -> DebuggerReplayAdapters::AdapterMode:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::ENUM_TWO
            return DebuggerReplayAdapters::AdapterMode.Recording if code == Codec::ENUM_ZERO
            return DebuggerReplayAdapters::AdapterMode.Replaying if code == Codec::ENUM_ONE
            return DebuggerReplayAdapters::AdapterMode.Branch if code == Codec::ENUM_TWO
            reader.failed <- true
            return DebuggerReplayAdapters::AdapterMode.Recording

        def reader_take_console_channel(reader: mutable CheckpointReader&) -> DebuggerReplayAdapters::ConsoleChannel:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::ENUM_TWO
            return DebuggerReplayAdapters::ConsoleChannel.Stdout if code == Codec::ENUM_ZERO
            return DebuggerReplayAdapters::ConsoleChannel.Stderr if code == Codec::ENUM_ONE
            return DebuggerReplayAdapters::ConsoleChannel.Stdin if code == Codec::ENUM_TWO
            reader.failed <- true
            return DebuggerReplayAdapters::ConsoleChannel.Stdout

        def reader_take_console_record_kind(reader: mutable CheckpointReader&) -> DebuggerReplayAdapters::ConsoleRecordKind:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > Codec::ENUM_ONE
            return DebuggerReplayAdapters::ConsoleRecordKind.Input if code == Codec::ENUM_ZERO
            return DebuggerReplayAdapters::ConsoleRecordKind.Output if code == Codec::ENUM_ONE
            reader.failed <- true
            return DebuggerReplayAdapters::ConsoleRecordKind.Input

        def reader_take_task_info(reader: mutable CheckpointReader&) -> DebuggerConcurrency::TaskInfo:
            task: mutable DebuggerConcurrency::TaskInfo = zeroed
            task.id <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            task.parent <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            task.state <- reader_take_task_state(reader)
            task.logical_time <- reader_take_u64(reader)
            task.os_thread <- reader_take_u64(reader)
            return task

        def reader_take_wait_edge(reader: mutable CheckpointReader&) -> DebuggerConcurrency::WaitEdge:
            edge: mutable DebuggerConcurrency::WaitEdge = zeroed
            edge.waiter <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            edge.owner <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            edge.resource <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            edge.kind <- reader_take_sync_kind(reader)
            return edge

        def reader_take_schedule_decision(reader: mutable CheckpointReader&) -> DebuggerScheduler::ScheduleDecision:
            decision: mutable DebuggerScheduler::ScheduleDecision = zeroed
            decision.ordinal <- reader_take_u64(reader)
            decision.task <- reader_take_task_info(reader)
            decision.kind <- reader_take_schedule_kind(reader)
            decision.synchronization <- reader_take_u64(reader)
            return decision

        def reader_take_effect_record(reader: mutable CheckpointReader&) -> DebuggerEffects::EffectRecord:
            record: mutable DebuggerEffects::EffectRecord = zeroed
            record.sequence <- reader_take_u64(reader)
            record.kind <- reader_take_effect_kind(reader)
            record.call_site <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            record.invocation <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            record.request_hash <- reader_take_u64(reader)
            record.result_hash <- reader_take_u64(reader)
            record.result_value <- reader_take_u64(reader).i64()
            record.suppress_external_write <- reader_take_bool(reader)
            return record

        def reader_take_task_snapshot(reader: mutable CheckpointReader&) -> DebuggerConcurrencyCheckpoint::TaskSnapshot:
            snapshot: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = zeroed
            snapshot.task_count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_TASK_CAPACITY)
            snapshot.next_id <- reader_take_u64(reader)
            snapshot.status <- reader_take_runtime_status(reader)
            snapshot.current <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            snapshot.wait_count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_WAIT_CAPACITY)
            snapshot.scheduler_cursor <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_SCHEDULE_CAPACITY)
            snapshot.scheduler_count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_SCHEDULE_CAPACITY)
            snapshot.scheduler_replaying <- reader_take_bool(reader)
            snapshot.scheduler_diverged <- reader_take_bool(reader)
            snapshot.scheduler_overflowed <- reader_take_bool(reader)
            return snapshot if reader.failed
            if snapshot.scheduler_cursor > snapshot.scheduler_count:
                reader.failed <- true
                return snapshot
            for index in Codec::FIRST_INDEX..<snapshot.task_count:
                snapshot.tasks[index] <- reader_take_task_info(reader)
            for index in Codec::FIRST_INDEX..<snapshot.wait_count:
                snapshot.waits[index] <- reader_take_wait_edge(reader)
            for index in Codec::FIRST_INDEX..<snapshot.scheduler_count:
                snapshot.scheduler_decisions[index] <- reader_take_schedule_decision(reader)
            return snapshot

        def reader_take_effect_oracle(reader: mutable CheckpointReader&) -> DebuggerEffects::EffectOracle:
            oracle: mutable DebuggerEffects::EffectOracle = zeroed
            oracle.count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_EFFECT_CAPACITY)
            oracle.cursor <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_EFFECT_CAPACITY)
            oracle.mode <- reader_take_effect_mode(reader)
            oracle.exactness <- reader_take_effect_exactness(reader)
            oracle.overflowed <- reader_take_bool(reader)
            oracle.last_error.code <- reader_take_error_code(reader)
            oracle.last_error.severity <- reader_take_error_severity(reader)
            oracle.last_error.retryable <- reader_take_bool(reader)
            oracle.last_error.detail <- reader_take_u32(reader)
            return oracle if reader.failed
            return oracle if oracle.cursor > oracle.count
            for index in Codec::FIRST_INDEX..<oracle.count:
                oracle.records[index] <- reader_take_effect_record(reader)
            return oracle

        def reader_take_resource_store(reader: mutable CheckpointReader&) -> DebuggerVirtualResources::ResourceStore:
            resources: mutable DebuggerVirtualResources::ResourceStore = zeroed
            resources.count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_CAPACITY)
            resources.next_handle <- reader_take_u64(reader)
            resources.mode <- reader_take_resource_mode(reader)
            resources.operation_count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_OPERATION_CAPACITY)
            resources.operation_cursor <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_OPERATION_CAPACITY)
            resources.operation_overflowed <- reader_take_bool(reader)
            return resources if reader.failed
            return resources if resources.operation_cursor > resources.operation_count
            for index in Codec::FIRST_INDEX..<resources.count:
                resources.files[index].handle <- DebuggerIdentity::debug_id(reader_take_u64(reader))
                resources.files[index].path <- DebuggerIdentity::debug_id(reader_take_u64(reader))
                resources.files[index].length <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_DATA_CAPACITY)
                resources.files[index].cursor <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_DATA_CAPACITY)
                resources.files[index].initial_length <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_DATA_CAPACITY)
                resources.files[index].writable <- reader_take_bool(reader)
                resources.files[index].mounted <- reader_take_bool(reader)
                resources.files[index].generation <- reader_take_u64(reader)
                return resources if reader.failed
                if resources.files[index].cursor > resources.files[index].length or resources.files[index].cursor > Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_DATA_CAPACITY:
                    reader.failed <- true
                    return resources
                for byte_index in Codec::FIRST_INDEX..<resources.files[index].length:
                    resources.files[index].bytes[byte_index] <- reader_take_byte(reader)
                for byte_index in Codec::FIRST_INDEX..<resources.files[index].initial_length:
                    resources.files[index].initial_bytes[byte_index] <- reader_take_byte(reader)
            for index in Codec::FIRST_INDEX..<resources.operation_count:
                operation: mutable DebuggerVirtualResources::ResourceOperation = zeroed
                operation.sequence <- reader_take_u64(reader)
                operation.kind <- reader_take_resource_operation_kind(reader)
                operation.handle <- DebuggerIdentity::debug_id(reader_take_u64(reader))
                operation.path <- DebuggerIdentity::debug_id(reader_take_u64(reader))
                operation.generation <- reader_take_u64(reader)
                operation.writable <- reader_take_bool(reader)
                operation.offset <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_DATA_CAPACITY)
                operation.requested <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_DATA_CAPACITY)
                operation.transferred <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_DATA_CAPACITY)
                operation.eof <- reader_take_bool(reader)
                return resources if reader.failed
                for byte_index in Codec::FIRST_INDEX..<operation.transferred:
                    operation.bytes[byte_index] <- reader_take_byte(reader)
                resources.operations[index] <- operation
                return resources if reader.failed
            return resources

        def reader_take_adapter_error(reader: mutable CheckpointReader&) -> DebuggerErrors::DebuggerError:
            adapter_failure: mutable DebuggerErrors::DebuggerError = zeroed
            adapter_failure.code <- reader_take_error_code(reader)
            adapter_failure.severity <- reader_take_error_severity(reader)
            adapter_failure.retryable <- reader_take_bool(reader)
            adapter_failure.detail <- reader_take_u32(reader)
            return adapter_failure

        def reader_take_adapter_sample(reader: mutable CheckpointReader&) -> DebuggerReplayAdapters::AdapterSample:
            sample: mutable DebuggerReplayAdapters::AdapterSample = zeroed
            sample.sequence <- reader_take_u64(reader)
            sample.source <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            sample.invocation <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            sample.value <- reader_take_u64(reader)
            return sample

        def reader_take_clock(reader: mutable CheckpointReader&) -> DebuggerReplayAdapters::Clock:
            clock: mutable DebuggerReplayAdapters::Clock = zeroed
            clock.count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_ADAPTER_SAMPLE_CAPACITY)
            clock.cursor <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_ADAPTER_SAMPLE_CAPACITY)
            clock.mode <- reader_take_adapter_mode(reader)
            clock.exact <- reader_take_bool(reader)
            clock.last_error <- reader_take_adapter_error(reader)
            return clock if reader.failed or clock.cursor > clock.count
            for index in Codec::FIRST_INDEX..<clock.count:
                clock.samples[index] <- reader_take_adapter_sample(reader)
            return clock

        def reader_take_random(reader: mutable CheckpointReader&) -> DebuggerReplayAdapters::Random:
            random: mutable DebuggerReplayAdapters::Random = zeroed
            random.count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_ADAPTER_SAMPLE_CAPACITY)
            random.cursor <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_ADAPTER_SAMPLE_CAPACITY)
            random.mode <- reader_take_adapter_mode(reader)
            random.exact <- reader_take_bool(reader)
            random.last_error <- reader_take_adapter_error(reader)
            return random if reader.failed or random.cursor > random.count
            for index in Codec::FIRST_INDEX..<random.count:
                random.samples[index] <- reader_take_adapter_sample(reader)
            return random

        def reader_take_console(reader: mutable CheckpointReader&) -> DebuggerReplayAdapters::Console:
            console: mutable DebuggerReplayAdapters::Console = zeroed
            console.count <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_RECORD_CAPACITY)
            console.cursor <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_RECORD_CAPACITY)
            console.mode <- reader_take_adapter_mode(reader)
            console.exact <- reader_take_bool(reader)
            console.output_suppressed <- reader_take_bool(reader)
            console.last_error <- reader_take_adapter_error(reader)
            return console if reader.failed or console.cursor > console.count
            for index in Codec::FIRST_INDEX..<console.count:
                console.records[index].sequence <- reader_take_u64(reader)
                console.records[index].channel <- reader_take_console_channel(reader)
                console.records[index].kind <- reader_take_console_record_kind(reader)
                console.records[index].requested <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_DATA_CAPACITY)
                console.records[index].length <- reader_take_count(reader, Codec::REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_DATA_CAPACITY)
                console.records[index].eof <- reader_take_bool(reader)
                if reader.failed or console.records[index].length > console.records[index].requested:
                    reader.failed <- true
                    return console
                for byte_index in Codec::FIRST_INDEX..<console.records[index].length:
                    console.records[index].bytes[byte_index] <- reader_take_byte(reader)
            return console

        def reader_take_adapter_snapshot(reader: mutable CheckpointReader&) -> DebuggerReplayAdapters::AdapterSnapshot:
            snapshot: mutable DebuggerReplayAdapters::AdapterSnapshot = zeroed
            snapshot.clock <- reader_take_clock(reader)
            snapshot.random <- reader_take_random(reader)
            snapshot.console <- reader_take_console(reader)
            return snapshot

        def checkpoint_checksum(bytes: u8&, length: usize) -> u64:
            return DebuggerTraceBinary::bytes_checksum(bytes, length)

        def checkpoint_checksum_matches(bytes: u8&, length: usize, expected: u64) -> bool:
            return DebuggerTraceBinary::bytes_checksum_matches(bytes, length, expected)

        def decode_failure(status: DecodeStatus) -> DecodedCheckpoint:
            return DecodedCheckpoint{checkpoint: zeroed, status: status}

    public:
        # Encode directly into caller-owned storage to avoid a second full
        # checkpoint buffer and aggregate copy on durable trace writes.
        def full_checkpoint_encode_into(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&, encoded: mutable EncodedCheckpoint&) -> void:
            encoded.length <- Codec::FIRST_INDEX
            encoded.failed <- false
            if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint):
                encoded.failed <- true
                return
            writer_put_u32(encoded, Codec::REPLAY_FULL_CHECKPOINT_CODEC_MAGIC)
            # Preserve canonical schema-9 bytes when the recording uses only
            # legacy kinds, including immutable rewind export of existing traces.
            codec_schema: mutable u32 = Codec::LEGACY_CODEC_SCHEMA
            for effect_index in Codec::FIRST_INDEX..<checkpoint.effects.count:
                codec_schema <- Codec::REPLAY_FULL_CHECKPOINT_CODEC_SCHEMA if checkpoint.effects.records[effect_index].kind.u16() > Codec::LEGACY_EFFECT_KIND_MAX
            writer_put_u32(encoded, codec_schema)
            writer_put_u32(encoded, checkpoint.schema)
            writer_put_u64(encoded, checkpoint.recording.value)
            writer_put_u64(encoded, checkpoint.branch.value)
            writer_put_u64(encoded, checkpoint.event)
            writer_put_u64(encoded, checkpoint.state_hash)
            writer_put_build_identity(encoded, checkpoint.build)
            writer_put_u64(encoded, checkpoint.image_fingerprint)
            writer_put_bool(encoded, checkpoint.image_fingerprint_valid)
            machine_bytes: mutable DebuggerTraceBinary::ByteWriter
            DebuggerCheckpointCodec::checkpoint_encode_into(checkpoint.machine, machine_bytes)
            if not DebuggerTraceBinary::writer_is_valid(machine_bytes) or machine_bytes.length != DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES:
                encoded.failed <- true
                encoded.length <- Codec::FIRST_INDEX
                return
            for index in Codec::FIRST_INDEX..<machine_bytes.length:
                writer_put_byte(encoded, machine_bytes.bytes[index])
            writer_put_task_snapshot(encoded, checkpoint.tasks)
            writer_put_effect_oracle(encoded, checkpoint.effects)
            writer_put_resource_store(encoded, checkpoint.resources)
            writer_put_adapter_snapshot(encoded, checkpoint.adapters)
            if encoded.failed:
                encoded.failed <- true
                encoded.length <- Codec::FIRST_INDEX
                return
            checksum: u64 = checkpoint_checksum(encoded.bytes[0], encoded.length)
            writer_put_u64(encoded, checksum)
            if encoded.failed or encoded.length > Codec::MAX_PAYLOAD_BYTES:
                encoded.failed <- true
                encoded.length <- Codec::FIRST_INDEX
                return
            return

        def full_checkpoint_encode(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&) -> EncodedCheckpoint:
            encoded: mutable EncodedCheckpoint = zeroed
            full_checkpoint_encode_into(checkpoint, encoded)
            return encoded

        def full_checkpoint_decode(bytes: u8&, length: usize) -> DecodedCheckpoint:
            return decode_failure(DecodeStatus.Oversized) if length > Codec::MAX_PAYLOAD_BYTES
            minimum_length: usize = Codec::REPLAY_FULL_CHECKPOINT_CODEC_OUTER_FIXED_BYTES + DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES + Codec::REPLAY_FULL_CHECKPOINT_CODEC_TASK_FIXED_BYTES + Codec::REPLAY_FULL_CHECKPOINT_CODEC_EFFECT_FIXED_BYTES + Codec::REPLAY_FULL_CHECKPOINT_CODEC_RESOURCE_FIXED_BYTES + Codec::REPLAY_FULL_CHECKPOINT_CODEC_ADAPTER_FIXED_BYTES * 2 + Codec::REPLAY_FULL_CHECKPOINT_CODEC_CONSOLE_FIXED_BYTES + Codec::REPLAY_FULL_CHECKPOINT_CODEC_CHECKSUM_BYTES
            return decode_failure(DecodeStatus.Truncated) if length < minimum_length
            reader: mutable CheckpointReader
            reader_initialize(reader, bytes, length)
            return decode_failure(DecodeStatus.Oversized) if reader.failed
            magic: u32 = reader_take_u32(reader)
            codec_schema: u32 = reader_take_u32(reader)
            checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = zeroed
            checkpoint.schema <- reader_take_u32(reader)
            checkpoint.recording <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            checkpoint.branch <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            checkpoint.event <- reader_take_u64(reader)
            checkpoint.state_hash <- reader_take_u64(reader)
            checkpoint.build <- reader_take_build_identity(reader)
            checkpoint.image_fingerprint <- reader_take_u64(reader)
            checkpoint.image_fingerprint_valid <- reader_take_bool(reader)
            if reader.failed or magic != Codec::REPLAY_FULL_CHECKPOINT_CODEC_MAGIC or (codec_schema != Codec::REPLAY_FULL_CHECKPOINT_CODEC_SCHEMA and codec_schema != Codec::LEGACY_CODEC_SCHEMA):
                return decode_failure(DecodeStatus.Invalid)
            machine_bytes: mutable u8[DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES] = zeroed
            for index in Codec::FIRST_INDEX..<DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES:
                machine_bytes[index] <- reader_take_byte(reader)
            if reader.failed:
                return decode_failure(DecodeStatus.Truncated)
            machine_reader: mutable DebuggerTraceBinary::ByteReader
            DebuggerTraceBinary::reader_initialize(machine_reader, machine_bytes[0], DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES)
            if not DebuggerCheckpointCodec::checkpoint_bytes_are_valid(machine_reader):
                return decode_failure(DecodeStatus.Invalid)
            DebuggerTraceBinary::reader_initialize(machine_reader, machine_bytes[0], DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES)
            checkpoint.machine <- DebuggerCheckpointCodec::checkpoint_decode(machine_reader)
            checkpoint.tasks <- reader_take_task_snapshot(reader)
            checkpoint.effects <- reader_take_effect_oracle(reader)
            return decode_failure(DecodeStatus.Invalid if not reader.truncated else DecodeStatus.Truncated) if reader.failed
            if codec_schema == Codec::LEGACY_CODEC_SCHEMA:
                for effect_index in 0..<checkpoint.effects.count:
                    return decode_failure(DecodeStatus.Invalid) if checkpoint.effects.records[effect_index].kind.u16() > Codec::LEGACY_EFFECT_KIND_MAX
            checkpoint.resources <- reader_take_resource_store(reader)
            checkpoint.adapters <- reader_take_adapter_snapshot(reader)
            if reader.failed:
                return decode_failure(DecodeStatus.Invalid if not reader.truncated else DecodeStatus.Truncated)
            checksum_offset: usize = reader.offset
            return decode_failure(DecodeStatus.Truncated) if reader.length - checksum_offset < Codec::REPLAY_FULL_CHECKPOINT_CODEC_CHECKSUM_BYTES
            return decode_failure(DecodeStatus.Invalid) if reader.length - checksum_offset > Codec::REPLAY_FULL_CHECKPOINT_CODEC_CHECKSUM_BYTES
            stored_checksum: u64 = reader_take_u64(reader)
            return decode_failure(DecodeStatus.Truncated) if reader.truncated
            return decode_failure(DecodeStatus.Invalid) if reader.failed or reader.offset != reader.length
            return decode_failure(DecodeStatus.Invalid) if not checkpoint_checksum_matches(bytes[0], checksum_offset, stored_checksum)
            # The wire checksum is verified first; the in-memory side-state fingerprint is derived from the decoded logical contents.
            DebuggerFullCheckpoint::full_checkpoint_seal_side_state(checkpoint)
            return decode_failure(DecodeStatus.Invalid) if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
            return DecodedCheckpoint{checkpoint: checkpoint, status: DecodeStatus.Ready}
