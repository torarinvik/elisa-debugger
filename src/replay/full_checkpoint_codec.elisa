# Canonical bounded codec for the complete managed checkpoint envelope.
# Durable values are encoded field-by-field in little-endian order; host
# structure layout and inactive array slots are never serialized.

include "./full_checkpoint.elisa"
include "./checkpoint_codec.elisa"
include "../trace/binary.elisa"

module DebuggerFullCheckpointCodec:
    private:
        const CODEC_MAGIC: u32 = 1263022918
        const CODEC_SCHEMA: u32 = 1
        const CODEC_BYTE_BITS: u64 = 8
        const CODEC_BYTE_MASK: u64 = 255
        const CODEC_FIRST_INDEX: usize = 0
        const CODEC_FALSE: u8 = 0
        const CODEC_TRUE: u8 = 1
        const CODEC_CHECKSUM_OFFSET_BASIS: u64 = 1469598103934665603
        const CODEC_CHECKSUM_PRIME: u64 = 1099511628211
        const CODEC_TASK_CAPACITY: usize = 64
        const CODEC_WAIT_CAPACITY: usize = 128
        const CODEC_SCHEDULE_CAPACITY: usize = 512
        const CODEC_EFFECT_CAPACITY: usize = 256
        const CODEC_RESOURCE_CAPACITY: usize = 16
        const CODEC_RESOURCE_DATA_CAPACITY: usize = 256
        const CODEC_TASK_STATE_MAX: u16 = 5
        const CODEC_SYNC_KIND_MAX: u16 = 4
        const CODEC_RUNTIME_STATUS_MAX: u16 = 4
        const CODEC_SCHEDULE_KIND_MAX: u16 = 6
        const CODEC_EFFECT_KIND_MAX: u16 = 9
        const CODEC_EFFECT_MODE_MAX: u16 = 4
        const CODEC_EFFECT_EXACTNESS_MAX: u16 = 3
        const CODEC_RESOURCE_MODE_MAX: u16 = 2
        const CODEC_ERROR_CODE_MAX: u16 = 12
        const CODEC_ERROR_SEVERITY_MAX: u16 = 2
        const CODEC_ENUM_ZERO: u16 = 0
        const CODEC_ENUM_ONE: u16 = 1
        const CODEC_ENUM_TWO: u16 = 2
        const CODEC_ENUM_THREE: u16 = 3
        const CODEC_ENUM_FOUR: u16 = 4
        const CODEC_ENUM_FIVE: u16 = 5
        const CODEC_ENUM_SIX: u16 = 6
        const CODEC_ENUM_SEVEN: u16 = 7
        const CODEC_ENUM_EIGHT: u16 = 8
        const CODEC_ENUM_NINE: u16 = 9
        const CODEC_ENUM_TEN: u16 = 10
        const CODEC_ENUM_ELEVEN: u16 = 11
        const CODEC_ENUM_TWELVE: u16 = 12
        const CODEC_U16_BYTES: usize = 2
        const CODEC_U32_BYTES: usize = 4
        const CODEC_U64_BYTES: usize = 8
        const CODEC_BOOL_BYTES: usize = 1
        const CODEC_TASK_INFO_BYTES: usize = CODEC_U64_BYTES * 4 + CODEC_U16_BYTES
        const CODEC_WAIT_EDGE_BYTES: usize = CODEC_U64_BYTES * 3 + CODEC_U16_BYTES
        const CODEC_SCHEDULE_DECISION_BYTES: usize = CODEC_U64_BYTES * 2 + CODEC_TASK_INFO_BYTES + CODEC_U16_BYTES
        const CODEC_EFFECT_RECORD_BYTES: usize = CODEC_U64_BYTES * 4 + CODEC_U16_BYTES + CODEC_BOOL_BYTES
        const CODEC_RESOURCE_FILE_HEADER_BYTES: usize = CODEC_U64_BYTES * 5 + CODEC_BOOL_BYTES
        const CODEC_OUTER_FIXED_BYTES: usize = CODEC_U32_BYTES * 3 + CODEC_U64_BYTES * 4
        const CODEC_TASK_FIXED_BYTES: usize = CODEC_U64_BYTES * 6 + CODEC_U16_BYTES + CODEC_BOOL_BYTES * 3
        const CODEC_EFFECT_FIXED_BYTES: usize = CODEC_U64_BYTES * 2 + CODEC_U16_BYTES * 4 + CODEC_BOOL_BYTES * 2 + CODEC_U32_BYTES
        const CODEC_RESOURCE_FIXED_BYTES: usize = CODEC_U64_BYTES * 2 + CODEC_U16_BYTES
        const CODEC_CHECKSUM_BYTES: usize = CODEC_U64_BYTES
        const CODEC_MAX_TASK_BYTES: usize = CODEC_TASK_FIXED_BYTES + CODEC_TASK_CAPACITY * CODEC_TASK_INFO_BYTES + CODEC_WAIT_CAPACITY * CODEC_WAIT_EDGE_BYTES + CODEC_SCHEDULE_CAPACITY * CODEC_SCHEDULE_DECISION_BYTES
        const CODEC_MAX_EFFECT_BYTES: usize = CODEC_EFFECT_FIXED_BYTES + CODEC_EFFECT_CAPACITY * CODEC_EFFECT_RECORD_BYTES
        const CODEC_MAX_RESOURCE_BYTES: usize = CODEC_RESOURCE_FIXED_BYTES + CODEC_RESOURCE_CAPACITY * (CODEC_RESOURCE_FILE_HEADER_BYTES + CODEC_RESOURCE_DATA_CAPACITY)
        const CODEC_MAX_PAYLOAD_BYTES: usize = CODEC_OUTER_FIXED_BYTES + DebuggerCheckpointCodec::CHECKPOINT_PAYLOAD_BYTES + CODEC_MAX_TASK_BYTES + CODEC_MAX_EFFECT_BYTES + CODEC_MAX_RESOURCE_BYTES + CODEC_CHECKSUM_BYTES

    public:
        const FULL_CHECKPOINT_CODEC_CAPACITY: usize = CODEC_MAX_PAYLOAD_BYTES

        enum DecodeStatus:
            Ready
            Truncated
            Invalid
            Oversized

        struct EncodedCheckpoint:
            bytes: mutable u8[CODEC_MAX_PAYLOAD_BYTES]
            length: mutable usize
            failed: mutable bool

        struct DecodedCheckpoint:
            checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint
            status: mutable DecodeStatus

    private:
        struct CheckpointWriter:
            bytes: mutable u8[CODEC_MAX_PAYLOAD_BYTES]
            length: mutable usize
            failed: mutable bool

        struct CheckpointReader:
            bytes: mutable u8[CODEC_MAX_PAYLOAD_BYTES]
            length: mutable usize
            offset: mutable usize
            failed: mutable bool
            truncated: mutable bool

        def writer_put_byte(writer: mutable CheckpointWriter&, value: u8) -> void:
            if writer.failed or writer.length >= CODEC_MAX_PAYLOAD_BYTES:
                writer.failed <- true
                return
            writer.bytes[writer.length] <- value
            writer.length <- writer.length + 1

        def writer_put_u16(writer: mutable CheckpointWriter&, value: u16) -> void:
            writer_put_byte(writer, (value.u64() & CODEC_BYTE_MASK).u8())
            writer_put_byte(writer, ((value.u64() >> CODEC_BYTE_BITS) & CODEC_BYTE_MASK).u8())

        def writer_put_u32(writer: mutable CheckpointWriter&, value: u32) -> void:
            for shift in CODEC_FIRST_INDEX..<CODEC_U32_BYTES:
                writer_put_byte(writer, ((value.u64() >> (CODEC_BYTE_BITS * shift.u64())) & CODEC_BYTE_MASK).u8())

        def writer_put_u64(writer: mutable CheckpointWriter&, value: u64) -> void:
            for shift in CODEC_FIRST_INDEX..<CODEC_U64_BYTES:
                writer_put_byte(writer, ((value >> (CODEC_BYTE_BITS * shift.u64())) & CODEC_BYTE_MASK).u8())

        def writer_put_bool(writer: mutable CheckpointWriter&, value: bool) -> void:
            writer_put_byte(writer, CODEC_TRUE if value else CODEC_FALSE)

        def writer_put_task_info(writer: mutable CheckpointWriter&, task: DebuggerConcurrency::TaskInfo) -> void:
            writer_put_u64(writer, task.id.value)
            writer_put_u64(writer, task.parent.value)
            writer_put_u16(writer, task.state.u16())
            writer_put_u64(writer, task.logical_time)
            writer_put_u64(writer, task.os_thread)

        def writer_put_wait_edge(writer: mutable CheckpointWriter&, edge: DebuggerConcurrency::WaitEdge) -> void:
            writer_put_u64(writer, edge.waiter.value)
            writer_put_u64(writer, edge.owner.value)
            writer_put_u64(writer, edge.resource.value)
            writer_put_u16(writer, edge.kind.u16())

        def writer_put_schedule_decision(writer: mutable CheckpointWriter&, decision: DebuggerScheduler::ScheduleDecision) -> void:
            writer_put_u64(writer, decision.ordinal)
            writer_put_task_info(writer, decision.task)
            writer_put_u16(writer, decision.kind.u16())
            writer_put_u64(writer, decision.synchronization)

        def writer_put_effect_record(writer: mutable CheckpointWriter&, record: DebuggerEffects::EffectRecord) -> void:
            writer_put_u64(writer, record.sequence)
            writer_put_u16(writer, record.kind.u16())
            writer_put_u64(writer, record.request_hash)
            writer_put_u64(writer, record.result_hash)
            writer_put_u64(writer, record.result_value.u64())
            writer_put_bool(writer, record.suppress_external_write)

        def writer_put_task_snapshot(writer: mutable CheckpointWriter&, snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot) -> void:
            writer_put_u64(writer, snapshot.task_count.u64())
            writer_put_u64(writer, snapshot.next_id)
            writer_put_u16(writer, snapshot.status.u16())
            writer_put_u64(writer, snapshot.current.value)
            writer_put_u64(writer, snapshot.wait_count.u64())
            writer_put_u64(writer, snapshot.scheduler_cursor.u64())
            writer_put_u64(writer, snapshot.scheduler_count.u64())
            writer_put_bool(writer, snapshot.scheduler_replaying)
            writer_put_bool(writer, snapshot.scheduler_diverged)
            writer_put_bool(writer, snapshot.scheduler_overflowed)
            for index in CODEC_FIRST_INDEX..<snapshot.task_count:
                writer_put_task_info(writer, snapshot.tasks[index])
            for index in CODEC_FIRST_INDEX..<snapshot.wait_count:
                writer_put_wait_edge(writer, snapshot.waits[index])
            for index in CODEC_FIRST_INDEX..<snapshot.scheduler_count:
                writer_put_schedule_decision(writer, snapshot.scheduler_decisions[index])

        def writer_put_effect_oracle(writer: mutable CheckpointWriter&, oracle: DebuggerEffects::EffectOracle) -> void:
            writer_put_u64(writer, oracle.count.u64())
            writer_put_u64(writer, oracle.cursor.u64())
            writer_put_u16(writer, oracle.mode.u16())
            writer_put_u16(writer, oracle.exactness.u16())
            writer_put_bool(writer, oracle.overflowed)
            writer_put_u16(writer, oracle.last_error.code.u16())
            writer_put_u16(writer, oracle.last_error.severity.u16())
            writer_put_bool(writer, oracle.last_error.retryable)
            writer_put_u32(writer, oracle.last_error.detail)
            for index in CODEC_FIRST_INDEX..<oracle.count:
                writer_put_effect_record(writer, oracle.records[index])

        def writer_put_resource_store(writer: mutable CheckpointWriter&, resources: DebuggerVirtualResources::ResourceStore) -> void:
            writer_put_u64(writer, resources.count.u64())
            writer_put_u64(writer, resources.next_handle)
            writer_put_u16(writer, resources.mode.u16())
            for index in CODEC_FIRST_INDEX..<resources.count:
                file: DebuggerVirtualResources::VirtualFile = resources.files[index]
                writer_put_u64(writer, file.handle.value)
                writer_put_u64(writer, file.path.value)
                writer_put_u64(writer, file.length.u64())
                writer_put_u64(writer, file.cursor.u64())
                writer_put_bool(writer, file.writable)
                writer_put_u64(writer, file.generation)
                for byte_index in CODEC_FIRST_INDEX..<file.length:
                    writer_put_byte(writer, file.bytes[byte_index])

        def reader_from_bytes(bytes: u8&, length: usize) -> CheckpointReader:
            reader: mutable CheckpointReader = zeroed
            if length > CODEC_MAX_PAYLOAD_BYTES:
                reader.failed <- true
                return reader
            reader.length <- length
            reader.offset <- 0
            reader.failed <- false
            reader.truncated <- false
            for index in CODEC_FIRST_INDEX..<length:
                reader.bytes[index] <- bytes[index]
            return reader

        def reader_take_byte(reader: mutable CheckpointReader&) -> u8:
            if reader.failed or reader.length > CODEC_MAX_PAYLOAD_BYTES or reader.offset >= reader.length:
                reader.failed <- true
                reader.truncated <- true
                return 0
            value: u8 = reader.bytes[reader.offset]
            reader.offset <- reader.offset + 1
            return value

        def reader_take_u16(reader: mutable CheckpointReader&) -> u16:
            low: u64 = reader_take_byte(reader).u64()
            high: u64 = reader_take_byte(reader).u64()
            return (low | (high << CODEC_BYTE_BITS)).u16()

        def reader_take_u32(reader: mutable CheckpointReader&) -> u32:
            value: mutable u64 = 0
            for shift in CODEC_FIRST_INDEX..<CODEC_U32_BYTES:
                value <- value | (reader_take_byte(reader).u64() << (CODEC_BYTE_BITS * shift.u64()))
            return value.u32()

        def reader_take_u64(reader: mutable CheckpointReader&) -> u64:
            value: mutable u64 = 0
            for shift in CODEC_FIRST_INDEX..<CODEC_U64_BYTES:
                value <- value | (reader_take_byte(reader).u64() << (CODEC_BYTE_BITS * shift.u64()))
            return value

        def reader_take_bool(reader: mutable CheckpointReader&) -> bool:
            value: u8 = reader_take_byte(reader)
            reader.failed <- true if value > CODEC_TRUE
            return value == CODEC_TRUE

        def reader_take_count(reader: mutable CheckpointReader&, maximum: usize) -> usize:
            count: u64 = reader_take_u64(reader)
            if count > maximum.u64():
                reader.failed <- true
                return 0
            return count.usize()

        def reader_take_task_state(reader: mutable CheckpointReader&) -> DebuggerConcurrency::TaskState:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_TASK_STATE_MAX
            return DebuggerConcurrency::TaskState.Created if code == CODEC_ENUM_ZERO
            return DebuggerConcurrency::TaskState.Runnable if code == CODEC_ENUM_ONE
            return DebuggerConcurrency::TaskState.Running if code == CODEC_ENUM_TWO
            return DebuggerConcurrency::TaskState.Blocked if code == CODEC_ENUM_THREE
            return DebuggerConcurrency::TaskState.Completed if code == CODEC_ENUM_FOUR
            return DebuggerConcurrency::TaskState.Cancelled if code == CODEC_ENUM_FIVE
            reader.failed <- true
            return DebuggerConcurrency::TaskState.Created

        def reader_take_sync_kind(reader: mutable CheckpointReader&) -> DebuggerConcurrency::SynchronizationKind:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_SYNC_KIND_MAX
            return DebuggerConcurrency::SynchronizationKind.Mutex if code == CODEC_ENUM_ZERO
            return DebuggerConcurrency::SynchronizationKind.Condition if code == CODEC_ENUM_ONE
            return DebuggerConcurrency::SynchronizationKind.Join if code == CODEC_ENUM_TWO
            return DebuggerConcurrency::SynchronizationKind.Channel if code == CODEC_ENUM_THREE
            return DebuggerConcurrency::SynchronizationKind.Atomic if code == CODEC_ENUM_FOUR
            reader.failed <- true
            return DebuggerConcurrency::SynchronizationKind.Mutex

        def reader_take_runtime_status(reader: mutable CheckpointReader&) -> DebuggerConcurrencyRuntime::RuntimeStatus:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_RUNTIME_STATUS_MAX
            return DebuggerConcurrencyRuntime::RuntimeStatus.Ready if code == CODEC_ENUM_ZERO
            return DebuggerConcurrencyRuntime::RuntimeStatus.Running if code == CODEC_ENUM_ONE
            return DebuggerConcurrencyRuntime::RuntimeStatus.Blocked if code == CODEC_ENUM_TWO
            return DebuggerConcurrencyRuntime::RuntimeStatus.Completed if code == CODEC_ENUM_THREE
            return DebuggerConcurrencyRuntime::RuntimeStatus.Diverged if code == CODEC_ENUM_FOUR
            reader.failed <- true
            return DebuggerConcurrencyRuntime::RuntimeStatus.Ready

        def reader_take_schedule_kind(reader: mutable CheckpointReader&) -> DebuggerScheduler::ScheduleKind:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_SCHEDULE_KIND_MAX
            return DebuggerScheduler::ScheduleKind.Run if code == CODEC_ENUM_ZERO
            return DebuggerScheduler::ScheduleKind.Yield if code == CODEC_ENUM_ONE
            return DebuggerScheduler::ScheduleKind.LockAcquire if code == CODEC_ENUM_TWO
            return DebuggerScheduler::ScheduleKind.LockRelease if code == CODEC_ENUM_THREE
            return DebuggerScheduler::ScheduleKind.Wait if code == CODEC_ENUM_FOUR
            return DebuggerScheduler::ScheduleKind.Wake if code == CODEC_ENUM_FIVE
            return DebuggerScheduler::ScheduleKind.Join if code == CODEC_ENUM_SIX
            reader.failed <- true
            return DebuggerScheduler::ScheduleKind.Run

        def reader_take_effect_kind(reader: mutable CheckpointReader&) -> DebuggerEffects::EffectKind:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_EFFECT_KIND_MAX
            return DebuggerEffects::EffectKind.Clock if code == CODEC_ENUM_ZERO
            return DebuggerEffects::EffectKind.Random if code == CODEC_ENUM_ONE
            return DebuggerEffects::EffectKind.ConsoleInput if code == CODEC_ENUM_TWO
            return DebuggerEffects::EffectKind.ConsoleOutput if code == CODEC_ENUM_THREE
            return DebuggerEffects::EffectKind.FileRead if code == CODEC_ENUM_FOUR
            return DebuggerEffects::EffectKind.FileWrite if code == CODEC_ENUM_FIVE
            return DebuggerEffects::EffectKind.NetworkRead if code == CODEC_ENUM_SIX
            return DebuggerEffects::EffectKind.NetworkWrite if code == CODEC_ENUM_SEVEN
            return DebuggerEffects::EffectKind.Process if code == CODEC_ENUM_EIGHT
            return DebuggerEffects::EffectKind.Foreign if code == CODEC_ENUM_NINE
            reader.failed <- true
            return DebuggerEffects::EffectKind.Clock

        def reader_take_effect_mode(reader: mutable CheckpointReader&) -> DebuggerEffects::EffectMode:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_EFFECT_MODE_MAX
            return DebuggerEffects::EffectMode.Live if code == CODEC_ENUM_ZERO
            return DebuggerEffects::EffectMode.Recording if code == CODEC_ENUM_ONE
            return DebuggerEffects::EffectMode.Replaying if code == CODEC_ENUM_TWO
            return DebuggerEffects::EffectMode.Virtualized if code == CODEC_ENUM_THREE
            return DebuggerEffects::EffectMode.Barrier if code == CODEC_ENUM_FOUR
            reader.failed <- true
            return DebuggerEffects::EffectMode.Live

        def reader_take_effect_exactness(reader: mutable CheckpointReader&) -> DebuggerEffects::Exactness:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_EFFECT_EXACTNESS_MAX
            return DebuggerEffects::Exactness.Exact if code == CODEC_ENUM_ZERO
            return DebuggerEffects::Exactness.Observational if code == CODEC_ENUM_ONE
            return DebuggerEffects::Exactness.Incomplete if code == CODEC_ENUM_TWO
            return DebuggerEffects::Exactness.Diverged if code == CODEC_ENUM_THREE
            reader.failed <- true
            return DebuggerEffects::Exactness.Diverged

        def reader_take_error_code(reader: mutable CheckpointReader&) -> DebuggerErrors::ErrorCode:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_ERROR_CODE_MAX
            return DebuggerErrors::ErrorCode.None if code == CODEC_ENUM_ZERO
            return DebuggerErrors::ErrorCode.InvalidArgument if code == CODEC_ENUM_ONE
            return DebuggerErrors::ErrorCode.InvalidState if code == CODEC_ENUM_TWO
            return DebuggerErrors::ErrorCode.StaleGeneration if code == CODEC_ENUM_THREE
            return DebuggerErrors::ErrorCode.Unsupported if code == CODEC_ENUM_FOUR
            return DebuggerErrors::ErrorCode.Unavailable if code == CODEC_ENUM_FIVE
            return DebuggerErrors::ErrorCode.Corrupt if code == CODEC_ENUM_SIX
            return DebuggerErrors::ErrorCode.Diverged if code == CODEC_ENUM_SEVEN
            return DebuggerErrors::ErrorCode.Cancelled if code == CODEC_ENUM_EIGHT
            return DebuggerErrors::ErrorCode.ResourceLimit if code == CODEC_ENUM_NINE
            return DebuggerErrors::ErrorCode.PermissionDenied if code == CODEC_ENUM_TEN
            return DebuggerErrors::ErrorCode.Transport if code == CODEC_ENUM_ELEVEN
            return DebuggerErrors::ErrorCode.Internal if code == CODEC_ENUM_TWELVE
            reader.failed <- true
            return DebuggerErrors::ErrorCode.None

        def reader_take_error_severity(reader: mutable CheckpointReader&) -> DebuggerErrors::ErrorSeverity:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_ERROR_SEVERITY_MAX
            return DebuggerErrors::ErrorSeverity.Info if code == CODEC_ENUM_ZERO
            return DebuggerErrors::ErrorSeverity.Warning if code == CODEC_ENUM_ONE
            return DebuggerErrors::ErrorSeverity.Failure if code == CODEC_ENUM_TWO
            reader.failed <- true
            return DebuggerErrors::ErrorSeverity.Info

        def reader_take_resource_mode(reader: mutable CheckpointReader&) -> DebuggerVirtualResources::ResourceMode:
            code: u16 = reader_take_u16(reader)
            reader.failed <- true if code > CODEC_RESOURCE_MODE_MAX
            return DebuggerVirtualResources::ResourceMode.Recording if code == CODEC_ENUM_ZERO
            return DebuggerVirtualResources::ResourceMode.Replaying if code == CODEC_ENUM_ONE
            return DebuggerVirtualResources::ResourceMode.Branch if code == CODEC_ENUM_TWO
            reader.failed <- true
            return DebuggerVirtualResources::ResourceMode.Recording

        def reader_take_task_info(reader: mutable CheckpointReader&) -> DebuggerConcurrency::TaskInfo:
            task: mutable DebuggerConcurrency::TaskInfo = zeroed
            task.id <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            task.parent <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            task.state <- reader_take_task_state(reader)
            task.logical_time <- reader_take_u64(reader)
            task.os_thread <- reader_take_u64(reader)
            return task

        def reader_take_wait_edge(reader: mutable CheckpointReader&) -> DebuggerConcurrency::WaitEdge:
            edge: mutable DebuggerConcurrency::WaitEdge = zeroed
            edge.waiter <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            edge.owner <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            edge.resource <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            edge.kind <- reader_take_sync_kind(reader)
            return edge

        def reader_take_schedule_decision(reader: mutable CheckpointReader&) -> DebuggerScheduler::ScheduleDecision:
            decision: mutable DebuggerScheduler::ScheduleDecision = zeroed
            decision.ordinal <- reader_take_u64(reader)
            decision.task <- reader_take_task_info(reader)
            decision.kind <- reader_take_schedule_kind(reader)
            decision.synchronization <- reader_take_u64(reader)
            return decision

        def reader_take_effect_record(reader: mutable CheckpointReader&) -> DebuggerEffects::EffectRecord:
            record: mutable DebuggerEffects::EffectRecord = zeroed
            record.sequence <- reader_take_u64(reader)
            record.kind <- reader_take_effect_kind(reader)
            record.request_hash <- reader_take_u64(reader)
            record.result_hash <- reader_take_u64(reader)
            record.result_value <- reader_take_u64(reader).i64()
            record.suppress_external_write <- reader_take_bool(reader)
            return record

        def reader_take_task_snapshot(reader: mutable CheckpointReader&) -> DebuggerConcurrencyCheckpoint::TaskSnapshot:
            snapshot: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = zeroed
            snapshot.task_count <- reader_take_count(reader, CODEC_TASK_CAPACITY)
            snapshot.next_id <- reader_take_u64(reader)
            snapshot.status <- reader_take_runtime_status(reader)
            snapshot.current <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            snapshot.wait_count <- reader_take_count(reader, CODEC_WAIT_CAPACITY)
            snapshot.scheduler_cursor <- reader_take_count(reader, CODEC_SCHEDULE_CAPACITY)
            snapshot.scheduler_count <- reader_take_count(reader, CODEC_SCHEDULE_CAPACITY)
            snapshot.scheduler_replaying <- reader_take_bool(reader)
            snapshot.scheduler_diverged <- reader_take_bool(reader)
            snapshot.scheduler_overflowed <- reader_take_bool(reader)
            return snapshot if reader.failed
            if snapshot.scheduler_cursor > snapshot.scheduler_count:
                reader.failed <- true
                return snapshot
            for index in CODEC_FIRST_INDEX..<snapshot.task_count:
                snapshot.tasks[index] <- reader_take_task_info(reader)
            for index in CODEC_FIRST_INDEX..<snapshot.wait_count:
                snapshot.waits[index] <- reader_take_wait_edge(reader)
            for index in CODEC_FIRST_INDEX..<snapshot.scheduler_count:
                snapshot.scheduler_decisions[index] <- reader_take_schedule_decision(reader)
            return snapshot

        def reader_take_effect_oracle(reader: mutable CheckpointReader&) -> DebuggerEffects::EffectOracle:
            oracle: mutable DebuggerEffects::EffectOracle = zeroed
            oracle.count <- reader_take_count(reader, CODEC_EFFECT_CAPACITY)
            oracle.cursor <- reader_take_count(reader, CODEC_EFFECT_CAPACITY)
            oracle.mode <- reader_take_effect_mode(reader)
            oracle.exactness <- reader_take_effect_exactness(reader)
            oracle.overflowed <- reader_take_bool(reader)
            oracle.last_error.code <- reader_take_error_code(reader)
            oracle.last_error.severity <- reader_take_error_severity(reader)
            oracle.last_error.retryable <- reader_take_bool(reader)
            oracle.last_error.detail <- reader_take_u32(reader)
            return oracle if reader.failed
            return oracle if oracle.cursor > oracle.count
            for index in CODEC_FIRST_INDEX..<oracle.count:
                oracle.records[index] <- reader_take_effect_record(reader)
            return oracle

        def reader_take_resource_store(reader: mutable CheckpointReader&) -> DebuggerVirtualResources::ResourceStore:
            resources: mutable DebuggerVirtualResources::ResourceStore = zeroed
            resources.count <- reader_take_count(reader, CODEC_RESOURCE_CAPACITY)
            resources.next_handle <- reader_take_u64(reader)
            resources.mode <- reader_take_resource_mode(reader)
            return resources if reader.failed
            for index in 0..<resources.count:
                resources.files[index].handle <- DebuggerIdentity::debug_id(reader_take_u64(reader))
                resources.files[index].path <- DebuggerIdentity::debug_id(reader_take_u64(reader))
                resources.files[index].length <- reader_take_count(reader, CODEC_RESOURCE_DATA_CAPACITY)
                resources.files[index].cursor <- reader_take_count(reader, CODEC_RESOURCE_DATA_CAPACITY)
                resources.files[index].writable <- reader_take_bool(reader)
                resources.files[index].generation <- reader_take_u64(reader)
                return resources if reader.failed
                if resources.files[index].cursor > resources.files[index].length:
                    reader.failed <- true
                    return resources
                for byte_index in CODEC_FIRST_INDEX..<resources.files[index].length:
                    resources.files[index].bytes[byte_index] <- reader_take_byte(reader)
            return resources

        def checkpoint_checksum(bytes: u8&, length: usize) -> u64:
            hash: mutable u64 = CODEC_CHECKSUM_OFFSET_BASIS
            for index in CODEC_FIRST_INDEX..<length:
                hash <- (hash ^ bytes[index].u64()) * CODEC_CHECKSUM_PRIME
            return hash

        def decode_failure(status: DecodeStatus) -> DecodedCheckpoint:
            return DecodedCheckpoint{checkpoint: zeroed, status: status}

    public:
        def full_checkpoint_encode(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> EncodedCheckpoint:
            encoded: mutable EncodedCheckpoint = zeroed
            if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint):
                encoded.failed <- true
                return encoded
            writer: mutable CheckpointWriter = zeroed
            writer_put_u32(writer, CODEC_MAGIC)
            writer_put_u32(writer, CODEC_SCHEMA)
            writer_put_u32(writer, checkpoint.schema)
            writer_put_u64(writer, checkpoint.recording.value)
            writer_put_u64(writer, checkpoint.branch.value)
            writer_put_u64(writer, checkpoint.event)
            writer_put_u64(writer, checkpoint.state_hash)
            machine_bytes: DebuggerTraceBinary::ByteWriter = DebuggerCheckpointCodec::checkpoint_encode(checkpoint.machine)
            if not DebuggerTraceBinary::writer_is_valid(machine_bytes) or machine_bytes.length != DebuggerCheckpointCodec::CHECKPOINT_PAYLOAD_BYTES:
                encoded.failed <- true
                return encoded
            for index in CODEC_FIRST_INDEX..<machine_bytes.length:
                writer_put_byte(writer, machine_bytes.bytes[index])
            writer_put_task_snapshot(writer, checkpoint.tasks)
            writer_put_effect_oracle(writer, checkpoint.effects)
            writer_put_resource_store(writer, checkpoint.resources)
            if writer.failed:
                encoded.failed <- true
                return encoded
            checksum: u64 = checkpoint_checksum(writer.bytes[0], writer.length)
            writer_put_u64(writer, checksum)
            if writer.failed or writer.length > CODEC_MAX_PAYLOAD_BYTES:
                encoded.failed <- true
                return encoded
            encoded.bytes <- writer.bytes
            encoded.length <- writer.length
            encoded.failed <- false
            return encoded

        def full_checkpoint_decode(bytes: u8&, length: usize) -> DecodedCheckpoint:
            return decode_failure(DecodeStatus.Oversized) if length > CODEC_MAX_PAYLOAD_BYTES
            return decode_failure(DecodeStatus.Truncated) if length < CODEC_OUTER_FIXED_BYTES + DebuggerCheckpointCodec::CHECKPOINT_PAYLOAD_BYTES + CODEC_CHECKSUM_BYTES
            reader: mutable CheckpointReader = reader_from_bytes(bytes, length)
            return decode_failure(DecodeStatus.Oversized) if reader.failed
            magic: u32 = reader_take_u32(reader)
            codec_schema: u32 = reader_take_u32(reader)
            checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = zeroed
            checkpoint.schema <- reader_take_u32(reader)
            checkpoint.recording <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            checkpoint.branch <- DebuggerIdentity::debug_id(reader_take_u64(reader))
            checkpoint.event <- reader_take_u64(reader)
            checkpoint.state_hash <- reader_take_u64(reader)
            if reader.failed or magic != CODEC_MAGIC or codec_schema != CODEC_SCHEMA:
                return decode_failure(DecodeStatus.Invalid)
            machine_bytes: mutable u8[DebuggerCheckpointCodec::CHECKPOINT_PAYLOAD_BYTES] = zeroed
            for index in CODEC_FIRST_INDEX..<DebuggerCheckpointCodec::CHECKPOINT_PAYLOAD_BYTES:
                machine_bytes[index] <- reader_take_byte(reader)
            if reader.failed:
                return decode_failure(DecodeStatus.Truncated)
            machine_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(machine_bytes[0], DebuggerCheckpointCodec::CHECKPOINT_PAYLOAD_BYTES)
            if not DebuggerCheckpointCodec::checkpoint_bytes_are_valid(machine_reader):
                return decode_failure(DecodeStatus.Invalid)
            machine_reader <- DebuggerTraceBinary::reader_new(machine_bytes[0], DebuggerCheckpointCodec::CHECKPOINT_PAYLOAD_BYTES)
            checkpoint.machine <- DebuggerCheckpointCodec::checkpoint_decode(machine_reader)
            checkpoint.tasks <- reader_take_task_snapshot(reader)
            checkpoint.effects <- reader_take_effect_oracle(reader)
            checkpoint.resources <- reader_take_resource_store(reader)
            if reader.failed:
                return decode_failure(DecodeStatus.Invalid if not reader.truncated else DecodeStatus.Truncated)
            checksum_offset: usize = reader.offset
            return decode_failure(DecodeStatus.Truncated) if reader.length - checksum_offset < CODEC_CHECKSUM_BYTES
            return decode_failure(DecodeStatus.Invalid) if reader.length - checksum_offset > CODEC_CHECKSUM_BYTES
            stored_checksum: u64 = reader_take_u64(reader)
            return decode_failure(DecodeStatus.Truncated) if reader.truncated
            return decode_failure(DecodeStatus.Invalid) if reader.failed or reader.offset != reader.length
            return decode_failure(DecodeStatus.Invalid) if stored_checksum != checkpoint_checksum(bytes[0], checksum_offset)
            return decode_failure(DecodeStatus.Invalid) if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
            return DecodedCheckpoint{checkpoint: checkpoint, status: DecodeStatus.Ready}
