# Virtual resource adapters used by managed recording, replay, and branches.
# Reads are served from captured bytes; writes update only the virtual copy.

include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerVirtualResources:
    private:
        const module Detail:
            REPLAY_RESOURCES_DETAIL_CAPACITY: u32 = 1
            HANDLE: u32 = 2
            REPLAY_RESOURCES_DETAIL_DIVERGENCE: u32 = 3
            OFFSET: u32 = 4
            CORRUPT: u32 = 5
            REPLAY_RESOURCES_DETAIL_OPEN_REQUEST: u32 = 6
            REPLAY_RESOURCES_DETAIL_OPEN_MISSING: u32 = 7
            REPLAY_RESOURCES_DETAIL_SEED_MODE: u32 = 8

        const module Resource:
            REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY: usize = 16
            DATA_CAPACITY: usize = 256
            FIRST_HANDLE: u64 = 1
            MAX_HANDLE: u64 = 18446744073709551615
            NO_HANDLE: u64 = 0
            EMPTY_FILE_COUNT: usize = 0
            REPLAY_RESOURCES_RESOURCE_NO_GENERATION: u64 = 0
            REPLAY_RESOURCES_RESOURCE_MODE_MAX: u16 = 2


    public:
        enum ResourceMode:
            Recording
            Replaying
            Branch

        struct VirtualFile:
            handle: mutable DebuggerIdentity::DebugId
            path: mutable DebuggerIdentity::DebugId
            bytes: mutable u8[Resource::DATA_CAPACITY]
            length: mutable usize
            cursor: mutable usize
            writable: mutable bool
            generation: mutable u64

        struct ResourceStore:
            files: mutable VirtualFile[Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY]
            count: mutable usize
            next_handle: mutable u64
            mode: mutable ResourceMode

        struct IoResult:
            transferred: mutable usize
            eof: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        struct ResourceOpenResult:
            accepted: mutable bool
            handle: mutable DebuggerIdentity::DebugId
            failure: mutable DebuggerErrors::DebuggerError

        def resources_initialize(store: mutable ResourceStore&, mode: ResourceMode) -> void:
            store.count <- Resource::EMPTY_FILE_COUNT
            store.next_handle <- Resource::FIRST_HANDLE
            store.mode <- mode

        def resources_open(store: mutable ResourceStore&, path: DebuggerIdentity::DebugId, writable: bool, generation: u64) -> DebuggerIdentity::DebugId:
            result: ResourceOpenResult = resources_open_checked(store, path, writable, generation)
            return result.handle

        def resources_open_checked(store: mutable ResourceStore&, path: DebuggerIdentity::DebugId, writable: bool, generation: u64) -> ResourceOpenResult:
            result: mutable ResourceOpenResult = zeroed
            result.handle <- DebuggerIdentity::debug_id(Resource::NO_HANDLE)
            result.failure <- DebuggerErrors::no_error()
            if not resources_is_valid(store):
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CORRUPT)
                return result
            if path.value == Resource::NO_HANDLE or generation == Resource::REPLAY_RESOURCES_RESOURCE_NO_GENERATION:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HANDLE)
                return result
            for index in 0..<store.count:
                if store.files[index].path.value == path.value and store.files[index].generation == generation:
                    if store.files[index].writable != writable:
                        result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::REPLAY_RESOURCES_DETAIL_OPEN_REQUEST)
                        return result
                    result.handle <- store.files[index].handle
                    result.accepted <- true
                    return result
            if store.mode == ResourceMode.Replaying:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::REPLAY_RESOURCES_DETAIL_OPEN_MISSING)
                return result
            if store.count >= Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::REPLAY_RESOURCES_DETAIL_CAPACITY)
                return result
            if store.next_handle == Resource::NO_HANDLE or store.next_handle == Resource::MAX_HANDLE:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::REPLAY_RESOURCES_DETAIL_CAPACITY)
                return result
            for index in 0..<store.count:
                if store.files[index].handle.value == store.next_handle:
                    result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CORRUPT)
                    return result
            index: usize = store.count
            store.files[index].handle <- DebuggerIdentity::debug_id(store.next_handle)
            store.files[index].path <- path
            store.files[index].writable <- writable
            store.files[index].generation <- generation
            store.count <- store.count + 1
            store.next_handle <- store.next_handle + Resource::FIRST_HANDLE
            result.handle <- store.files[index].handle
            result.accepted <- true
            return result

        def resources_find(store: mutable ResourceStore&, handle: DebuggerIdentity::DebugId) -> usize:
            return Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY if store.count > Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY
            for index in 0..<store.count:
                return index if store.files[index].handle.value == handle.value
            return Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY

        # Install captured initial bytes while recording. Replay must read the
        # checkpointed resource and cannot reseed it with fresh host data.
        def resources_seed(store: mutable ResourceStore&, handle: DebuggerIdentity::DebugId, bytes: u8&, length: usize) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CORRUPT) if not resources_is_valid(store)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::REPLAY_RESOURCES_DETAIL_SEED_MODE) if store.mode != ResourceMode.Recording
            index: usize = resources_find(store, handle)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HANDLE) if index >= Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::REPLAY_RESOURCES_DETAIL_CAPACITY) if length > Resource::DATA_CAPACITY
            for byte_index in 0..<length:
                store.files[index].bytes[byte_index] <- bytes[byte_index]
            store.files[index].length <- length
            store.files[index].cursor <- 0
            return DebuggerErrors::no_error()

        def resources_clone_snapshot(store: ResourceStore&) -> ResourceStore:
            snapshot: mutable ResourceStore = zeroed
            snapshot.count <- store.count
            snapshot.next_handle <- store.next_handle
            snapshot.mode <- store.mode
            copy_count: usize = store.count if store.count <= Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY else Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY
            for index in 0..<copy_count:
                snapshot.files[index].handle <- store.files[index].handle
                snapshot.files[index].path <- store.files[index].path
                snapshot.files[index].length <- store.files[index].length
                snapshot.files[index].cursor <- store.files[index].cursor
                snapshot.files[index].writable <- store.files[index].writable
                snapshot.files[index].generation <- store.files[index].generation
                for byte_index in 0..<Resource::DATA_CAPACITY:
                    snapshot.files[index].bytes[byte_index] <- store.files[index].bytes[byte_index]
            return snapshot

        def resources_read(store: mutable ResourceStore&, handle: DebuggerIdentity::DebugId, output: mutable u8&, length: usize) -> IoResult:
            result: mutable IoResult = zeroed
            result.failure <- DebuggerErrors::no_error()
            index: usize = resources_find(store, handle)
            if index >= Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HANDLE)
                return result
            if length > Resource::DATA_CAPACITY:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::REPLAY_RESOURCES_DETAIL_CAPACITY)
                return result
            if store.files[index].length > Resource::DATA_CAPACITY or store.files[index].cursor > store.files[index].length or store.files[index].cursor > Resource::DATA_CAPACITY:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CORRUPT)
                return result
            available: usize = store.files[index].length - store.files[index].cursor
            result.transferred <- available
            result.transferred <- length if length < available
            for byte_index in 0..<result.transferred:
                output[byte_index] <- store.files[index].bytes[store.files[index].cursor + byte_index]
            store.files[index].cursor <- store.files[index].cursor + result.transferred
            # A zero-byte probe does not consume data and must not claim EOF
            # merely because the requested length is zero.
            result.eof <- length > 0 and result.transferred < length
            return result

        def resources_seek(store: mutable ResourceStore&, handle: DebuggerIdentity::DebugId, offset: usize) -> DebuggerErrors::DebuggerError:
            index: usize = resources_find(store, handle)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HANDLE) if index >= Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CORRUPT) if store.files[index].length > Resource::DATA_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::OFFSET) if offset > store.files[index].length
            store.files[index].cursor <- offset
            return DebuggerErrors::no_error()

        def resources_clone_branch(store: ResourceStore&) -> ResourceStore:
            # Do not rely on aggregate assignment for branch isolation. A branch must own an
            # independent byte snapshot: a write in the child is an intervention, never a
            # mutation of the parent recording. Copy the bounded representation explicitly so
            # this remains true even when a backend lowers nested fixed-array assignment as a
            # shallow aggregate copy. Clamp a corrupted count before indexing so cloning an
            # invalid store cannot turn validation input into an out-of-bounds read.
            branch: mutable ResourceStore = zeroed
            branch.count <- store.count if store.count <= Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY else Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY
            branch.next_handle <- store.next_handle
            branch.mode <- ResourceMode.Branch
            for index in 0..<branch.count:
                branch.files[index].handle <- store.files[index].handle
                branch.files[index].path <- store.files[index].path
                branch.files[index].length <- store.files[index].length
                branch.files[index].cursor <- store.files[index].cursor
                branch.files[index].writable <- store.files[index].writable
                branch.files[index].generation <- store.files[index].generation
                for byte_index in 0..<Resource::DATA_CAPACITY:
                    branch.files[index].bytes[byte_index] <- store.files[index].bytes[byte_index]
            return branch

        def resources_is_valid(store: ResourceStore&) -> bool:
            return false if store.count > Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY or store.next_handle == Resource::NO_HANDLE or store.mode.u16() > Resource::REPLAY_RESOURCES_RESOURCE_MODE_MAX
            return false if store.next_handle != store.count.u64() + Resource::FIRST_HANDLE
            for index in 0..<store.count:
                file: VirtualFile = store.files[index]
                return false if file.handle.value == Resource::NO_HANDLE or file.path.value == Resource::NO_HANDLE or file.generation == Resource::REPLAY_RESOURCES_RESOURCE_NO_GENERATION or file.length > Resource::DATA_CAPACITY or file.cursor > file.length
                return false if file.handle.value >= store.next_handle
                for previous in 0..<index:
                    return false if store.files[previous].handle.value == file.handle.value
                    return false if store.files[previous].path.value == file.path.value and store.files[previous].generation == file.generation
            return true

        def resources_write(store: mutable ResourceStore&, handle: DebuggerIdentity::DebugId, input: u8&, length: usize) -> IoResult:
            result: mutable IoResult = zeroed
            result.failure <- DebuggerErrors::no_error()
            if store.mode.u16() > Resource::REPLAY_RESOURCES_RESOURCE_MODE_MAX:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CORRUPT)
                return result
            index: usize = resources_find(store, handle)
            if index >= Resource::REPLAY_RESOURCES_RESOURCE_FILE_CAPACITY:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Detail::HANDLE)
                return result
            if store.mode == ResourceMode.Replaying and not store.files[index].writable:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Detail::REPLAY_RESOURCES_DETAIL_DIVERGENCE)
                return result
            if not store.files[index].writable:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.PermissionDenied, false, Detail::HANDLE)
                return result
            if store.files[index].length > Resource::DATA_CAPACITY or store.files[index].cursor > store.files[index].length or store.files[index].cursor > Resource::DATA_CAPACITY:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CORRUPT)
                return result
            if length > Resource::DATA_CAPACITY - store.files[index].cursor:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::REPLAY_RESOURCES_DETAIL_CAPACITY)
                return result
            for byte_index in 0..<length:
                store.files[index].bytes[store.files[index].cursor + byte_index] <- input[byte_index]
            store.files[index].cursor <- store.files[index].cursor + length
            store.files[index].length <- store.files[index].cursor if store.files[index].length < store.files[index].cursor
            result.transferred <- length
            return result
