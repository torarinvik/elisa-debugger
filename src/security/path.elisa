module DebuggerPathPolicy:
    private:
        const ASCII_NUL: u8 = 0
        const ASCII_SLASH: u8 = 47
        const ASCII_BACKSLASH: u8 = 92
        const ASCII_DELETE: u8 = 127
        const ASCII_COLON: u8 = 58
        const ASCII_DOT: u8 = 46
        const ASCII_SPACE: u8 = 32
        const ASCII_UPPER_A: u8 = 65
        const ASCII_UPPER_Z: u8 = 90
        const ASCII_LOWER_A: u8 = 97
        const ASCII_LOWER_Z: u8 = 122
        const MAX_PATH_BYTES: usize = 1024

    public:
        def path_is_safe(path: cstr) -> bool:
            length: mutable usize = 0
            while path[length] != ASCII_NUL:
                return false if length >= MAX_PATH_BYTES
                byte: u8 = path[length].u8()
                return false if byte < ASCII_SPACE or byte == ASCII_DELETE
                return false if length == 0 and (byte == ASCII_SLASH or byte == ASCII_BACKSLASH)
                return false if length == 1 and (path[0].u8() >= ASCII_UPPER_A and path[0].u8() <= ASCII_UPPER_Z or path[0].u8() >= ASCII_LOWER_A and path[0].u8() <= ASCII_LOWER_Z) and byte == ASCII_COLON
                length <- length + 1
            return false if length == 0
            segment_start: mutable usize = 0
            for index in 0..<length:
                separator: bool = path[index].u8() == ASCII_SLASH or path[index].u8() == ASCII_BACKSLASH
                if separator:
                    return false if index == segment_start + 2 and path[segment_start].u8() == ASCII_DOT and path[segment_start + 1].u8() == ASCII_DOT
                    segment_start <- index + 1
            return false if length == segment_start + 2 and path[segment_start].u8() == ASCII_DOT and path[segment_start + 1].u8() == ASCII_DOT
            return true
