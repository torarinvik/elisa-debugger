module DebuggerPathPolicy:
    private:
        const module Bounds:
            MAX_PATH_BYTES: usize = 1024

        const module Encoding:
            SECURITY_PATH_ENCODING_ASCII_NUL: u8 = 0
            SECURITY_PATH_ENCODING_ASCII_SLASH: u8 = 47
            SECURITY_PATH_ENCODING_ASCII_BACKSLASH: u8 = 92
            SECURITY_PATH_ENCODING_ASCII_DELETE: u8 = 127
            SECURITY_PATH_ENCODING_ASCII_COLON: u8 = 58
            SECURITY_PATH_ENCODING_ASCII_DOT: u8 = 46
            SECURITY_PATH_ENCODING_ASCII_SPACE: u8 = 32
            SECURITY_PATH_ENCODING_ASCII_UPPER_A: u8 = 65
            SECURITY_PATH_ENCODING_ASCII_UPPER_Z: u8 = 90
            ASCII_LOWER_A: u8 = 97
            ASCII_LOWER_Z: u8 = 122

        const module Parent:
            SEGMENT_LENGTH: usize = 2


        def path_segment_is_parent(path: cstr, start: usize, end: usize) -> bool:
            return false if end - start < Parent::SEGMENT_LENGTH
            return false if path[start].u8() != Encoding::SECURITY_PATH_ENCODING_ASCII_DOT or path[start + 1].u8() != Encoding::SECURITY_PATH_ENCODING_ASCII_DOT
            return true if end - start == Parent::SEGMENT_LENGTH
            padded_parent: mutable bool = true
            has_trailing_space: mutable bool = false
            for index in start + Parent::SEGMENT_LENGTH..<end:
                byte: u8 = path[index].u8()
                padded_parent <- false if byte != Encoding::SECURITY_PATH_ENCODING_ASCII_DOT and byte != Encoding::SECURITY_PATH_ENCODING_ASCII_SPACE
                has_trailing_space <- true if byte == Encoding::SECURITY_PATH_ENCODING_ASCII_SPACE
            return padded_parent and has_trailing_space

    public:
        def path_is_safe(path: cstr) -> bool:
            length: mutable usize = 0
            while path[length] != Encoding::SECURITY_PATH_ENCODING_ASCII_NUL:
                return false if length >= Bounds::MAX_PATH_BYTES
                byte: u8 = path[length].u8()
                return false if byte < Encoding::SECURITY_PATH_ENCODING_ASCII_SPACE or byte == Encoding::SECURITY_PATH_ENCODING_ASCII_DELETE
                return false if length == 0 and (byte == Encoding::SECURITY_PATH_ENCODING_ASCII_SLASH or byte == Encoding::SECURITY_PATH_ENCODING_ASCII_BACKSLASH)
                return false if length == 1 and (path[0].u8() >= Encoding::SECURITY_PATH_ENCODING_ASCII_UPPER_A and path[0].u8() <= Encoding::SECURITY_PATH_ENCODING_ASCII_UPPER_Z or path[0].u8() >= Encoding::ASCII_LOWER_A and path[0].u8() <= Encoding::ASCII_LOWER_Z) and byte == Encoding::SECURITY_PATH_ENCODING_ASCII_COLON
                length <- length + 1
            return false if length == 0
            segment_start: mutable usize = 0
            for index in 0..<length:
                separator: bool = path[index].u8() == Encoding::SECURITY_PATH_ENCODING_ASCII_SLASH or path[index].u8() == Encoding::SECURITY_PATH_ENCODING_ASCII_BACKSLASH
                if separator:
                    return false if path_segment_is_parent(path, segment_start, index)
                    segment_start <- index + 1
            return false if path_segment_is_parent(path, segment_start, length)
            return true
