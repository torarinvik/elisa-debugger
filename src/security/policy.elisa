# Explicit permission and resource policy for local and remote sessions.

include "../core/errors.elisa"

module DebuggerSecurity:
    private:
        const module Default:
            TRACE_BYTES: u64 = 1073741824
            QUERY_STEPS: u64 = 1000000
            REMOTE_PAYLOAD: u64 = 1048576

        const module Detail:
            TRACE_QUOTA: u32 = 1
            QUERY_QUOTA: u32 = 2
            REMOTE_QUOTA: u32 = 3
            PROCESS_QUOTA: u32 = 4


    public:
        enum Permission:
            Inspect
            Execute
            WriteFiles
            Network
            SpawnProcess
            ExportTrace
            Mutate

        struct Quotas:
            trace_bytes: mutable u64
            query_steps: mutable u64
            remote_payload_bytes: mutable u64
            processes: mutable u64

        struct Policy:
            inspect: mutable bool
            execute: mutable bool
            write_files: mutable bool
            network: mutable bool
            spawn_process: mutable bool
            export_trace: mutable bool
            mutate: mutable bool
            quotas: mutable Quotas

        def default_policy() -> Policy:
            return Policy{inspect: true, execute: true, write_files: false, network: false, spawn_process: false, export_trace: true, mutate: false, quotas: Quotas{trace_bytes: Default::TRACE_BYTES, query_steps: Default::QUERY_STEPS, remote_payload_bytes: Default::REMOTE_PAYLOAD, processes: 1}}

        def policy_allows(policy: Policy, permission: Permission) -> bool:
            return policy.inspect if permission == Permission.Inspect
            return policy.execute if permission == Permission.Execute
            return policy.write_files if permission == Permission.WriteFiles
            return policy.network if permission == Permission.Network
            return policy.spawn_process if permission == Permission.SpawnProcess
            return policy.export_trace if permission == Permission.ExportTrace
            return policy.mutate if permission == Permission.Mutate
            return false

        def policy_check_quota(policy: Policy, trace_bytes: u64, query_steps: u64, payload_bytes: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::TRACE_QUOTA) if trace_bytes > policy.quotas.trace_bytes
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Detail::QUERY_QUOTA) if query_steps > policy.quotas.query_steps
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Detail::REMOTE_QUOTA) if payload_bytes > policy.quotas.remote_payload_bytes
            return DebuggerErrors::no_error()

        def policy_check_all_quotas(policy: Policy, trace_bytes: u64, query_steps: u64, payload_bytes: u64, process_count: u64) -> DebuggerErrors::DebuggerError:
            failure: DebuggerErrors::DebuggerError = policy_check_quota(policy, trace_bytes, query_steps, payload_bytes)
            return failure if not DebuggerErrors::error_is_ok(failure)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::PROCESS_QUOTA) if process_count > policy.quotas.processes
            return DebuggerErrors::no_error()
