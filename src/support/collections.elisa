# Small bounded collections used at protocol and trace boundaries.  These are
# deliberately fixed-capacity so malformed clients cannot force unbounded work.

module DebuggerSupport:
    private:
        const RING_CAPACITY: usize = 256

    public:
        struct U64Ring:
            values: mutable u64[RING_CAPACITY]
            start: mutable usize
            count: mutable usize

        def ring_new() -> U64Ring:
            ring: mutable U64Ring = zeroed
            ring.start <- 0
            ring.count <- 0
            return ring

        def ring_push(ring: U64Ring, value: u64) -> U64Ring:
            updated: mutable U64Ring = ring
            return updated if ring.start >= RING_CAPACITY or ring.count > RING_CAPACITY
            index: usize = (ring.start + ring.count) % RING_CAPACITY
            updated.values[index] <- value
            if ring.count < RING_CAPACITY:
                updated.count <- ring.count + 1
            else:
                updated.start <- (ring.start + 1) % RING_CAPACITY
            return updated

        def ring_get(ring: U64Ring, offset: usize) -> u64:
            return 0 if ring.start >= RING_CAPACITY or ring.count > RING_CAPACITY or offset >= ring.count
            return ring.values[(ring.start + offset) % RING_CAPACITY]
