# Canonical little-endian byte reader/writer.  Durable trace fields never use
# host struct layout, pointer values, or implicit integer endianness.

module DebuggerTraceBinary:
    private:
        # One bounded frame can contain the largest supported full managed
        # checkpoint plus its canonical storage header. Larger traces are
        # scanned from caller-owned byte ranges instead of one writer buffer.
        const module Buffer:
            BINARY_BUFFER_CAPACITY: usize = 131072

        const module Checksum:
            BINARY_CHECKSUM_OFFSET_BASIS: u64 = 14695981039346656037
            LEGACY_OFFSET_BASIS: u64 = 1469598103934665603
            BINARY_CHECKSUM_PRIME: u64 = 1099511628211
            INVALID: u64 = 0

        const module ByteEncoding:
            BITS: u64 = 8
            MASK: u64 = 255


    public:
        struct ByteWriter:
            bytes: mutable u8[Buffer::BINARY_BUFFER_CAPACITY]
            length: mutable usize
            failed: mutable bool

        struct ByteReader:
            bytes: mutable u8[Buffer::BINARY_BUFFER_CAPACITY]
            length: mutable usize
            offset: mutable usize
            failed: mutable bool

        def writer_new() -> ByteWriter:
            writer: mutable ByteWriter = zeroed
            writer.length <- 0
            writer.failed <- false
            return writer

        def writer_put_byte(writer: ByteWriter, value: u8) -> ByteWriter:
            updated: mutable ByteWriter = writer
            if writer.failed or writer.length >= Buffer::BINARY_BUFFER_CAPACITY:
                updated.failed <- true
                return updated
            updated.bytes[writer.length] <- value
            updated.length <- writer.length + 1
            return updated

        def writer_put_u16(writer: ByteWriter, value: u16) -> ByteWriter:
            updated: mutable ByteWriter = writer_put_byte(writer, (value.u64() & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value.u64() >> ByteEncoding::BITS) & ByteEncoding::MASK).u8())
            return updated

        def writer_put_u32(writer: ByteWriter, value: u32) -> ByteWriter:
            updated: mutable ByteWriter = writer
            updated <- writer_put_byte(updated, (value.u64() & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value.u64() >> ByteEncoding::BITS) & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value.u64() >> (ByteEncoding::BITS * 2)) & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value.u64() >> (ByteEncoding::BITS * 3)) & ByteEncoding::MASK).u8())
            return updated

        def writer_put_u64(writer: ByteWriter, value: u64) -> ByteWriter:
            updated: mutable ByteWriter = writer
            updated <- writer_put_byte(updated, (value & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value >> ByteEncoding::BITS) & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value >> (ByteEncoding::BITS * 2)) & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value >> (ByteEncoding::BITS * 3)) & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value >> (ByteEncoding::BITS * 4)) & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value >> (ByteEncoding::BITS * 5)) & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value >> (ByteEncoding::BITS * 6)) & ByteEncoding::MASK).u8())
            updated <- writer_put_byte(updated, ((value >> (ByteEncoding::BITS * 7)) & ByteEncoding::MASK).u8())
            return updated

    private:
        def bytes_checksum_with_basis(bytes: u8&, length: usize, offset_basis: u64) -> u64:
            return Checksum::INVALID if length > Buffer::BINARY_BUFFER_CAPACITY
            checksum: mutable u64 = offset_basis
            for index in 0..<length:
                checksum <- (checksum ^ bytes[index].u64()) * Checksum::BINARY_CHECKSUM_PRIME
            return checksum

    public:
        def bytes_checksum(bytes: u8&, length: usize) -> u64:
            return bytes_checksum_with_basis(bytes, length, Checksum::BINARY_CHECKSUM_OFFSET_BASIS)

        def bytes_checksum_matches(bytes: u8&, length: usize, expected: u64) -> bool:
            return false if length > Buffer::BINARY_BUFFER_CAPACITY
            return bytes_checksum_with_basis(bytes, length, Checksum::BINARY_CHECKSUM_OFFSET_BASIS) == expected or bytes_checksum_with_basis(bytes, length, Checksum::LEGACY_OFFSET_BASIS) == expected

        def writer_checksum(writer: ByteWriter) -> u64:
            return Checksum::INVALID if writer.failed or writer.length > Buffer::BINARY_BUFFER_CAPACITY
            return bytes_checksum(writer.bytes[0], writer.length)

        def writer_checksum_matches(writer: ByteWriter, expected: u64) -> bool:
            return false if writer.failed or writer.length > Buffer::BINARY_BUFFER_CAPACITY
            return bytes_checksum_matches(writer.bytes[0], writer.length, expected)

        def writer_is_valid(writer: ByteWriter) -> bool:
            return not writer.failed and writer.length <= Buffer::BINARY_BUFFER_CAPACITY

        def reader_new(bytes: u8&, length: usize) -> ByteReader:
            reader: mutable ByteReader = zeroed
            if length > Buffer::BINARY_BUFFER_CAPACITY:
                reader.failed <- true
                return reader
            for index in 0..<length:
                reader.bytes[index] <- bytes[index]
            reader.length <- length
            reader.offset <- 0
            reader.failed <- false
            return reader

        def reader_take_byte(reader: mutable ByteReader&) -> u8:
            if reader.failed or reader.length > Buffer::BINARY_BUFFER_CAPACITY or reader.offset >= reader.length:
                reader.failed <- true
                return 0
            value: u8 = reader.bytes[reader.offset]
            reader.offset <- reader.offset + 1
            return value

        def reader_take_u16(reader: mutable ByteReader&) -> u16:
            low: u64 = reader_take_byte(reader).u64()
            high: u64 = reader_take_byte(reader).u64()
            return (low | (high << ByteEncoding::BITS)).u16()

        def reader_take_u32(reader: mutable ByteReader&) -> u32:
            value: mutable u64 = 0
            for shift in 0..<4:
                value <- value | (reader_take_byte(reader).u64() << (ByteEncoding::BITS * shift.u64()))
            return value.u32()

        def reader_take_u64(reader: mutable ByteReader&) -> u64:
            value: mutable u64 = 0
            for shift in 0..<8:
                value <- value | (reader_take_byte(reader).u64() << (ByteEncoding::BITS * shift.u64()))
            return value

        def reader_is_valid(reader: ByteReader) -> bool:
            return not reader.failed and reader.length <= Buffer::BINARY_BUFFER_CAPACITY and reader.offset <= reader.length
