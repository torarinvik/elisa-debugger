# In-memory durable bundle assembly.  A bundle is append-only until sealed;
# every adapter can verify the same prefix before exposing a trace to replay.

include "./storage.elisa"
include "./manifest.elisa"
include "./binary.elisa"
include "./reader.elisa"
include "../core/errors.elisa"

module DebuggerTraceBundle:
    private:
        const BUNDLE_CHUNK_CAPACITY: usize = 8
        const BUNDLE_PAYLOAD_CAPACITY: usize = 4048
        const BUNDLE_FIRST_SEQUENCE: u64 = 0
        const DETAIL_CAPACITY: u32 = 1
        const DETAIL_SEQUENCE: u32 = 2
        const DETAIL_CHECKSUM: u32 = 3
        const DETAIL_RANGE: u32 = 4
        const DETAIL_STATE: u32 = 5
        const DETAIL_SCHEMA: u32 = 6
        const BUNDLE_MANIFEST_SEQUENCE: u64 = 0
        const BUNDLE_EVENT_SEQUENCE_OFFSET: u64 = 1
        const BUNDLE_MAX_EVENT: u64 = 18446744073709551615

    public:
        enum BundleState:
            Open
            Exact
            Partial
            Corrupt

        struct TraceBundle:
            manifest: mutable DebuggerTraceManifest::BundleManifest
            chunks: mutable DebuggerTraceStorage::StoredChunk[BUNDLE_CHUNK_CAPACITY]
            chunk_count: mutable usize
            state: mutable BundleState
            last_error: mutable DebuggerErrors::DebuggerError

        def bundle_new(build: DebuggerIdentity::BuildIdentity) -> TraceBundle:
            return TraceBundle{manifest: DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact), chunks: zeroed, chunk_count: 0, state: BundleState.Open, last_error: DebuggerErrors::no_error()}

        def bundle_verify_chunk_at(bundle: mutable TraceBundle&, chunk: DebuggerTraceStorage::StoredChunk, expected_sequence: u64) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, DETAIL_CAPACITY) if chunk.payload_length > BUNDLE_PAYLOAD_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_CHECKSUM) if chunk.header.payload_length != chunk.payload_length.u64() or chunk.header.checksum != chunk.checksum
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_SCHEMA) if chunk.header.schema != bundle.manifest.schema.u32()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_RANGE) if not DebuggerTrace::trace_chunk_range_valid(chunk.header)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_SEQUENCE) if chunk.header.sequence != expected_sequence
            payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
            for index in 0..<chunk.payload_length:
                payload <- DebuggerTraceBinary::writer_put_byte(payload, chunk.payload[index])
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_CHECKSUM) if not DebuggerTraceBinary::writer_is_valid(payload) or DebuggerTraceBinary::writer_checksum(payload) != chunk.checksum
            return DebuggerErrors::no_error()

        def bundle_verify_chunk(bundle: mutable TraceBundle&, chunk: DebuggerTraceStorage::StoredChunk) -> DebuggerErrors::DebuggerError:
            return bundle_verify_chunk_at(bundle, chunk, bundle.chunk_count.u64())

        def bundle_manifest_matches_chunks(bundle: TraceBundle) -> bool:
            return bundle.manifest.first_event == 0 and bundle.manifest.last_event == 0 and bundle.manifest.checkpoint_count == 0 if bundle.chunk_count == 0
            return false if bundle.chunk_count > BUNDLE_CHUNK_CAPACITY
            event_chunks: u64 = bundle_event_chunk_count(bundle)
            return bundle.manifest.first_event == 0 and bundle.manifest.last_event == 0 and bundle.manifest.checkpoint_count == event_chunks if event_chunks == 0
            first_event: mutable u64 = 0
            last_event: mutable u64 = 0
            seen_events: mutable bool = false
            for index in 0..<bundle.chunk_count:
                if bundle.chunks[index].header.kind == DebuggerTrace::ChunkKind.Events:
                    first_event <- bundle.chunks[index].header.first_event if not seen_events
                    return false if seen_events and (last_event == BUNDLE_MAX_EVENT or bundle.chunks[index].header.first_event != last_event + 1)
                    last_event <- bundle.chunks[index].header.last_event
                    seen_events <- true
            return bundle.manifest.first_event == first_event and bundle.manifest.last_event == last_event and bundle.manifest.checkpoint_count == event_chunks

        def bundle_event_chunk_count(bundle: TraceBundle) -> u64:
            count: mutable u64 = 0
            return 0 if bundle.chunk_count > BUNDLE_CHUNK_CAPACITY
            for index in 0..<bundle.chunk_count:
                count <- count + 1 if bundle.chunks[index].header.kind == DebuggerTrace::ChunkKind.Events
            return count

        def bundle_append(bundle: mutable TraceBundle&, chunk: DebuggerTraceStorage::StoredChunk) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_SEQUENCE) if bundle.state != BundleState.Open
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, DETAIL_CAPACITY) if bundle.chunk_count >= BUNDLE_CHUNK_CAPACITY
            verified: DebuggerErrors::DebuggerError = bundle_verify_chunk(bundle, chunk)
            if not DebuggerErrors::error_is_ok(verified):
                bundle.state <- BundleState.Corrupt
                bundle.last_error <- verified
                return verified
            bundle.chunks[bundle.chunk_count] <- chunk
            bundle.chunk_count <- bundle.chunk_count + 1
            updated: mutable DebuggerTraceManifest::BundleManifest = bundle.manifest
            count_snapshot: TraceBundle = bundle
            updated.checkpoint_count <- bundle_event_chunk_count(count_snapshot)
            if chunk.header.kind == DebuggerTrace::ChunkKind.Events:
                updated.first_event <- chunk.header.first_event if updated.checkpoint_count == 1
                updated.last_event <- chunk.header.last_event
            bundle.manifest <- updated
            return DebuggerErrors::no_error()

        def bundle_seal(bundle: mutable TraceBundle&, partial: bool) -> DebuggerErrors::DebuggerError:
            return bundle.last_error if bundle.state == BundleState.Corrupt
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, DETAIL_STATE) if bundle.state != BundleState.Open
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_RANGE) if bundle.chunk_count == 0
            if not partial:
                bundle.state <- BundleState.Exact
                if not bundle_is_replayable(bundle):
                    bundle.state <- BundleState.Partial
                    partial_manifest: mutable DebuggerTraceManifest::BundleManifest = bundle.manifest
                    partial_manifest.status <- DebuggerTraceManifest::ManifestStatus.Partial
                    bundle.manifest <- partial_manifest
                    bundle.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_RANGE)
                    return bundle.last_error
            bundle.state <- BundleState.Partial if partial
            bundle.state <- BundleState.Exact if not partial
            updated: mutable DebuggerTraceManifest::BundleManifest = bundle.manifest
            updated.status <- DebuggerTraceManifest::ManifestStatus.Partial if partial
            updated.status <- DebuggerTraceManifest::ManifestStatus.Exact if not partial
            bundle.manifest <- updated
            bundle.last_error <- DebuggerErrors::no_error()
            return DebuggerErrors::no_error()

        def bundle_scan(bundle: mutable TraceBundle&) -> DebuggerErrors::DebuggerError:
            return bundle.last_error if bundle.state == BundleState.Corrupt and not DebuggerErrors::error_is_ok(bundle.last_error)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_STATE) if bundle.state == BundleState.Corrupt
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, DETAIL_CAPACITY) if bundle.chunk_count > BUNDLE_CHUNK_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_SCHEMA) if bundle.manifest.schema == 0 or bundle.manifest.status == DebuggerTraceManifest::ManifestStatus.Corrupt
            for index in 0..<bundle.chunk_count:
                verified: DebuggerErrors::DebuggerError = bundle_verify_chunk_at(bundle, bundle.chunks[index], index.u64())
                return verified if not DebuggerErrors::error_is_ok(verified)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_RANGE) if not bundle_manifest_matches_chunks(bundle)
            return DebuggerErrors::no_error()

        def bundle_manifest_bytes(bundle: TraceBundle) -> DebuggerTraceBinary::ByteWriter:
            return DebuggerTraceManifest::manifest_encode(bundle.manifest)

        def bundle_is_replayable(bundle: TraceBundle) -> bool:
            return false if bundle.chunk_count == 0 or bundle.chunk_count > BUNDLE_CHUNK_CAPACITY or bundle.state != BundleState.Exact or not DebuggerTraceManifest::manifest_is_replayable(bundle.manifest) or not DebuggerErrors::error_is_ok(bundle.last_error) or not bundle_manifest_matches_chunks(bundle)
            checked_bundle: mutable TraceBundle = bundle
            saw_events: mutable bool = false
            for index in 0..<bundle.chunk_count:
                return false if bundle.chunks[index].header.kind == DebuggerTrace::ChunkKind.Manifest
                return false if not DebuggerErrors::error_is_ok(bundle_verify_chunk_at(checked_bundle, bundle.chunks[index], index.u64()))
                saw_events <- true if bundle.chunks[index].header.kind == DebuggerTrace::ChunkKind.Events
            return false if not saw_events
            manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(bundle.manifest)
            return false if not DebuggerTraceBinary::writer_is_valid(manifest_bytes)
            manifest_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
            manifest_chunk.header <- DebuggerTrace::ChunkHeader{schema: bundle.manifest.schema.u32(), kind: DebuggerTrace::ChunkKind.Manifest, sequence: BUNDLE_MANIFEST_SEQUENCE, first_event: bundle.manifest.first_event, last_event: bundle.manifest.last_event, payload_length: manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_bytes)}
            manifest_chunk.payload_length <- manifest_bytes.length
            manifest_chunk.checksum <- DebuggerTraceBinary::writer_checksum(manifest_bytes)
            for byte_index in 0..<manifest_bytes.length:
                manifest_chunk.payload[byte_index] <- manifest_bytes.bytes[byte_index]
            reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
            return false if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, manifest_chunk))
            for index in 0..<bundle.chunk_count:
                checked_chunk: mutable DebuggerTraceStorage::StoredChunk = bundle.chunks[index]
                checked_chunk.header.sequence <- index.u64() + BUNDLE_EVENT_SEQUENCE_OFFSET
                return false if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, checked_chunk))
            return DebuggerTraceReader::reader_is_exact(reader)

        def bundle_chunk_count(bundle: TraceBundle) -> usize:
            return bundle.chunk_count
