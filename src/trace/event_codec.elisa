# Version-3 trace event codec. Event bodies carry only their declared payload
# bytes; the in-memory envelope remains fixed-capacity and canonically padded.

include "./binary.elisa"
include "../core/events.elisa"
include "../core/identity.elisa"

module DebuggerTraceEventCodec:
    private:
        const module Record:
            SCHEMA_BYTES: usize = 4
            ORDINAL_BYTES: usize = 8
            ID_BYTES: usize = 8
            ID_FIELD_COUNT: usize = 7
            MICROSTEP_BYTES: usize = 4
            ENUM_BYTES: usize = 2
            ENUM_FIELD_COUNT: usize = 2
            STATE_HASH_BYTES: usize = 8
            PAYLOAD_KIND_BYTES: usize = 2
            PAYLOAD_LENGTH_BYTES: usize = 2
            PAYLOAD_HASH_BYTES: usize = 8
            FIXED_BYTES: usize = Record::SCHEMA_BYTES + Record::ORDINAL_BYTES + Record::ID_BYTES * Record::ID_FIELD_COUNT + Record::MICROSTEP_BYTES + Record::ENUM_BYTES * Record::ENUM_FIELD_COUNT + Record::STATE_HASH_BYTES + Record::PAYLOAD_KIND_BYTES + Record::PAYLOAD_LENGTH_BYTES + Record::PAYLOAD_HASH_BYTES

        const module Version:
            LEGACY_FIXED_PAYLOAD: u32 = 2
            LEGACY_FIXED_PAYLOAD_BYTES: usize = 64
            VARIABLE_PAYLOAD: u32 = 3

        const module Index:
            FIRST_PAYLOAD_BYTE: usize = 0

    public:
        enum DecodeStatus:
            Ready
            Invalid

        struct DecodeResult:
            event: mutable DebuggerEvents::EventEnvelope
            status: mutable DecodeStatus

        def event_record_fixed_size() -> usize:
            return Record::FIXED_BYTES

        def event_record_maximum_size() -> usize:
            return Record::FIXED_BYTES + DebuggerEvents::event_payload_capacity()

        def event_record_schema_is_supported(schema: u32) -> bool:
            return schema == Version::LEGACY_FIXED_PAYLOAD or schema == Version::VARIABLE_PAYLOAD

        def event_record_encoded_size(event: DebuggerEvents::EventEnvelope) -> usize:
            return Record::FIXED_BYTES + event.payload_length.usize() if event.schema == Version::VARIABLE_PAYLOAD and DebuggerEvents::event_envelope_is_well_formed(event) else 0

        def event_record_encode(event: DebuggerEvents::EventEnvelope, writer: mutable DebuggerTraceBinary::ByteWriter&) -> bool:
            return false if event.schema != Version::VARIABLE_PAYLOAD or not DebuggerEvents::event_envelope_is_well_formed(event)
            DebuggerTraceBinary::writer_put_u32(writer, event.schema)
            DebuggerTraceBinary::writer_put_u64(writer, event.ordinal)
            DebuggerTraceBinary::writer_put_u64(writer, event.task.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.recording.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.branch.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.event)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.task.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.invocation.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.statement.value)
            DebuggerTraceBinary::writer_put_u32(writer, event.position.microstep)
            DebuggerTraceBinary::writer_put_u16(writer, event.kind.u16())
            DebuggerTraceBinary::writer_put_u16(writer, event.quality.u16())
            DebuggerTraceBinary::writer_put_u64(writer, event.state_hash)
            DebuggerTraceBinary::writer_put_u16(writer, event.payload_kind.u16())
            DebuggerTraceBinary::writer_put_u16(writer, event.payload_length)
            DebuggerTraceBinary::writer_put_u64(writer, event.payload_hash)
            for index in Index::FIRST_PAYLOAD_BYTE..<event.payload_length.usize():
                DebuggerTraceBinary::writer_put_byte(writer, event.payload[index])
            return DebuggerTraceBinary::writer_is_valid(writer)

    private:
        def event_kind_from_code(code: u16) -> DebuggerEvents::EventKind:
            return DebuggerEvents::EventKind.ExecutionBoundary if code == DebuggerEvents::EventKind.ExecutionBoundary.u16()
            return DebuggerEvents::EventKind.CallEntry if code == DebuggerEvents::EventKind.CallEntry.u16()
            return DebuggerEvents::EventKind.CallExit if code == DebuggerEvents::EventKind.CallExit.u16()
            return DebuggerEvents::EventKind.Unwind if code == DebuggerEvents::EventKind.Unwind.u16()
            return DebuggerEvents::EventKind.ScopeEnter if code == DebuggerEvents::EventKind.ScopeEnter.u16()
            return DebuggerEvents::EventKind.ScopeExit if code == DebuggerEvents::EventKind.ScopeExit.u16()
            return DebuggerEvents::EventKind.Allocation if code == DebuggerEvents::EventKind.Allocation.u16()
            return DebuggerEvents::EventKind.Release if code == DebuggerEvents::EventKind.Release.u16()
            return DebuggerEvents::EventKind.RegionReset if code == DebuggerEvents::EventKind.RegionReset.u16()
            return DebuggerEvents::EventKind.MutationAttempt if code == DebuggerEvents::EventKind.MutationAttempt.u16()
            return DebuggerEvents::EventKind.MutationCommit if code == DebuggerEvents::EventKind.MutationCommit.u16()
            return DebuggerEvents::EventKind.Input if code == DebuggerEvents::EventKind.Input.u16()
            return DebuggerEvents::EventKind.Output if code == DebuggerEvents::EventKind.Output.u16()
            return DebuggerEvents::EventKind.Scheduler if code == DebuggerEvents::EventKind.Scheduler.u16()
            return DebuggerEvents::EventKind.Synchronization if code == DebuggerEvents::EventKind.Synchronization.u16()
            return DebuggerEvents::EventKind.Atomic if code == DebuggerEvents::EventKind.Atomic.u16()
            return DebuggerEvents::EventKind.Fault if code == DebuggerEvents::EventKind.Fault.u16()
            return DebuggerEvents::EventKind.Checkpoint if code == DebuggerEvents::EventKind.Checkpoint.u16()
            return DebuggerEvents::EventKind.Module if code == DebuggerEvents::EventKind.Module.u16()
            return DebuggerEvents::EventKind.DebuggerMutation if code == DebuggerEvents::EventKind.DebuggerMutation.u16()
            return DebuggerEvents::EventKind.TraceHealth

        def event_quality_from_code(code: u16) -> DebuggerEvents::EventQuality:
            return DebuggerEvents::EventQuality.Exact if code == DebuggerEvents::EventQuality.Exact.u16()
            return DebuggerEvents::EventQuality.Partial if code == DebuggerEvents::EventQuality.Partial.u16()
            return DebuggerEvents::EventQuality.Observational if code == DebuggerEvents::EventQuality.Observational.u16()
            return DebuggerEvents::EventQuality.Diverged if code == DebuggerEvents::EventQuality.Diverged.u16()
            return DebuggerEvents::EventQuality.Corrupt

    public:
        def event_record_decode(reader: mutable DebuggerTraceBinary::ByteReader&) -> DecodeResult:
            result: mutable DecodeResult = zeroed
            result.status <- DecodeStatus.Invalid
            event: mutable DebuggerEvents::EventEnvelope = zeroed
            event.schema <- DebuggerTraceBinary::reader_take_u32(reader)
            event.ordinal <- DebuggerTraceBinary::reader_take_u64(reader)
            event.task <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            recording: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            branch: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            position_event: u64 = DebuggerTraceBinary::reader_take_u64(reader)
            position_task: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            statement: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            microstep: u32 = DebuggerTraceBinary::reader_take_u32(reader)
            kind: u16 = DebuggerTraceBinary::reader_take_u16(reader)
            quality: u16 = DebuggerTraceBinary::reader_take_u16(reader)
            event.state_hash <- DebuggerTraceBinary::reader_take_u64(reader)
            payload_kind: u16 = DebuggerTraceBinary::reader_take_u16(reader)
            event.payload_length <- DebuggerTraceBinary::reader_take_u16(reader)
            event.payload_hash <- DebuggerTraceBinary::reader_take_u64(reader)
            return result if not DebuggerTraceBinary::reader_is_valid(reader)
            legacy_length_invalid: bool = event.schema == Version::LEGACY_FIXED_PAYLOAD and event.payload_length.usize() > Version::LEGACY_FIXED_PAYLOAD_BYTES
            if not event_record_schema_is_supported(event.schema) or kind > DebuggerEvents::EventKind.TraceHealth.u16() or quality > DebuggerEvents::EventQuality.Corrupt.u16() or payload_kind > DebuggerEvents::EventPayloadKind.Error.u16() or event.payload_length.usize() > DebuggerEvents::event_payload_capacity() or legacy_length_invalid:
                reader.failed <- true
                return result
            event.position <- DebuggerIdentity::Position{recording: recording, branch: branch, event: position_event, task: position_task, invocation: invocation, statement: statement, microstep: microstep}
            event.kind <- event_kind_from_code(kind)
            event.quality <- event_quality_from_code(quality)
            event.payload_kind <- DebuggerEvents::event_payload_kind_from_code(payload_kind)
            stored_payload_length: usize = Version::LEGACY_FIXED_PAYLOAD_BYTES if event.schema == Version::LEGACY_FIXED_PAYLOAD else event.payload_length.usize()
            for index in Index::FIRST_PAYLOAD_BYTE..<stored_payload_length:
                event.payload[index] <- DebuggerTraceBinary::reader_take_byte(reader)
            if DebuggerTraceBinary::reader_is_valid(reader) and DebuggerEvents::event_envelope_is_well_formed(event):
                result.event <- event
                result.status <- DecodeStatus.Ready
            return result
