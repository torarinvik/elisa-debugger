# Canonical bounded export for a verified trace bundle.  The returned bytes are
# ready for a file or transport; oversized exports fail explicitly.

include "./bundle.elisa"
include "./storage.elisa"
include "./binary.elisa"
include "./manifest.elisa"
include "../core/errors.elisa"

module DebuggerTraceExport:
    private:
        const module Detail:
            INVALID_BUNDLE: u32 = 1
            SIZE: u32 = 2

        const module Export:
            TRACE_EXPORT_MANIFEST_SEQUENCE: u64 = 0
            TRACE_EXPORT_EVENT_SEQUENCE_OFFSET: u64 = 1
            TRACE_EXPORT_SCHEMA_VERSION: u32 = 1


    public:
        struct ExportResult:
            bytes: mutable DebuggerTraceBinary::ByteWriter
            chunk_count: mutable usize
            failure: mutable DebuggerErrors::DebuggerError

        def append_bytes(writer: mutable DebuggerTraceBinary::ByteWriter&, source: DebuggerTraceBinary::ByteWriter&) -> void:
            DebuggerTraceBinary::writer_append_bytes(writer, source)

        def export_bundle(bundle: mutable DebuggerTraceBundle::TraceBundle&) -> ExportResult can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            result: mutable ExportResult = zeroed
            DebuggerTraceBinary::writer_initialize(result.bytes)
            result.failure <- DebuggerErrors::no_error()
            verification: DebuggerErrors::DebuggerError = DebuggerTraceBundle::bundle_scan(bundle)
            if not DebuggerErrors::error_is_ok(verification):
                result.failure <- verification
                return result
            replayable: bool = DebuggerTraceBundle::bundle_is_replayable(bundle) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
            if not replayable:
                result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::INVALID_BUNDLE)
                return result
            manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(bundle.manifest)
            manifest_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
            manifest_chunk.header <- DebuggerTrace::ChunkHeader{schema: Export::TRACE_EXPORT_SCHEMA_VERSION, kind: DebuggerTrace::ChunkKind.Manifest, sequence: Export::TRACE_EXPORT_MANIFEST_SEQUENCE, first_event: bundle.manifest.first_event, last_event: bundle.manifest.last_event, payload_length: manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_bytes)}
            manifest_chunk.payload_length <- manifest_bytes.length
            manifest_chunk.checksum <- DebuggerTraceBinary::writer_checksum(manifest_bytes)
            for index in 0..<manifest_bytes.length:
                manifest_chunk.payload[index] <- manifest_bytes.bytes[index]
            append_bytes(result.bytes, DebuggerTraceStorage::storage_encode_chunk(manifest_chunk))
            for index in 0..<bundle.chunk_count:
                chunk: mutable DebuggerTraceStorage::StoredChunk = bundle.chunks[index]
                chunk.header.sequence <- index.u64() + Export::TRACE_EXPORT_EVENT_SEQUENCE_OFFSET
                append_bytes(result.bytes, DebuggerTraceStorage::storage_encode_chunk(chunk))
                result.chunk_count <- result.chunk_count + 1
            append_bytes(result.bytes, DebuggerTraceStorage::storage_encode_footer(result.chunk_count.u64() + Export::TRACE_EXPORT_EVENT_SEQUENCE_OFFSET, bundle.manifest.last_event))
            result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::SIZE) if not DebuggerTraceBinary::writer_is_valid(result.bytes)
            result.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::INVALID_BUNDLE) if bundle.state == DebuggerTraceBundle::BundleState.Corrupt
            return result
