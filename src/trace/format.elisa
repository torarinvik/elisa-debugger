# Versioned trace metadata and chunk validation.  The byte stream itself is
# deliberately opaque to clients; this module is the authority for its status.

include "../core/identity.elisa"

module DebuggerTrace:
    private:
        const TRACE_HASH_OFFSET_BASIS: u64 = 1469598103934665603
        const TRACE_HASH_PRIME: u64 = 1099511628211
        const TRACE_CHUNK_SCHEMA_MIN: u32 = 1
        const TRACE_CHUNK_KIND_MAX: u16 = 5
        const TRACE_HASH_BYTE_BITS: u64 = 8
        const TRACE_HASH_BYTE_MASK: u64 = 255
        const TRACE_HASH_U32_BYTES: usize = 4
        const TRACE_HASH_U64_BYTES: usize = 8

    public:
        enum TraceStatus:
            Exact
            Partial
            Observational
            Diverged
            Corrupt

        enum ChunkKind:
            Manifest
            Metadata
            Events
            Checkpoint
            Resource
            Index

        struct TraceManifest:
            schema: mutable u32
            recording: mutable DebuggerIdentity::DebugId
            build: mutable DebuggerIdentity::BuildIdentity
            status: mutable TraceStatus
            first_event: mutable u64
            last_event: mutable u64
            checkpoint_count: mutable u64
            source_embedded: mutable bool

        struct ChunkHeader:
            schema: mutable u32
            kind: mutable ChunkKind
            sequence: mutable u64
            first_event: mutable u64
            last_event: mutable u64
            payload_length: mutable u64
            checksum: mutable u64

        def trace_hash_byte(hash: u64, byte: u8) -> u64:
            mixed: u64 = hash ^ byte.u64()
            return mixed * TRACE_HASH_PRIME

        def trace_hash_u64(hash: u64, value: u64) -> u64:
            updated: mutable u64 = hash
            for index in 0..<TRACE_HASH_U64_BYTES:
                updated <- trace_hash_byte(updated, ((value >> (TRACE_HASH_BYTE_BITS * index.u64())) & TRACE_HASH_BYTE_MASK).u8())
            return updated

        def trace_hash_u32(hash: u64, value: u32) -> u64:
            updated: mutable u64 = hash
            for index in 0..<TRACE_HASH_U32_BYTES:
                updated <- trace_hash_byte(updated, ((value.u64() >> (TRACE_HASH_BYTE_BITS * index.u64())) & TRACE_HASH_BYTE_MASK).u8())
            return updated

        def trace_chunk_checksum(header: ChunkHeader, first_byte: u8) -> u64:
            hash: mutable u64 = trace_hash_byte(TRACE_HASH_OFFSET_BASIS, first_byte)
            hash <- trace_hash_u32(hash, header.schema)
            hash <- trace_hash_u64(hash, header.sequence)
            hash <- trace_hash_u64(hash, header.first_event)
            hash <- trace_hash_u64(hash, header.last_event)
            return hash

        def trace_chunk_range_valid(header: ChunkHeader) -> bool:
            return false if header.schema < TRACE_CHUNK_SCHEMA_MIN
            return false if header.kind.u16() > TRACE_CHUNK_KIND_MAX
            return false if header.payload_length == 0 and header.kind == ChunkKind.Events
            return false if header.last_event < header.first_event
            return true

        def trace_manifest_is_replayable(manifest: TraceManifest) -> bool:
            return false if manifest.status != TraceStatus.Exact or manifest.schema == 0 or manifest.recording.value == 0 or manifest.build.compiler.value == 0 or manifest.build.runtime.value == 0 or manifest.build.source.value == 0 or manifest.build.target.value == 0 or manifest.build.metadata_version == 0
            return manifest.last_event >= manifest.first_event
