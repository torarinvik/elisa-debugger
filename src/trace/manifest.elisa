# Durable bundle manifest.  It records the compatibility inputs needed before
# opening event chunks or claiming exact replay.

include "./binary.elisa"
include "./format.elisa"
include "../core/identity.elisa"

module DebuggerTraceManifest:
    private:
        const module Manifest:
            TRACE_MANIFEST_MAGIC: u32 = 1296649556
            TRACE_MANIFEST_SCHEMA: u16 = 2
            INVALID_SCHEMA: u16 = 0


    public:
        enum ManifestStatus:
            Exact
            Partial
            Observational
            Corrupt

        struct BundleManifest:
            schema: mutable u16
            compiler: mutable DebuggerIdentity::DebugId
            runtime: mutable DebuggerIdentity::DebugId
            source: mutable DebuggerIdentity::DebugId
            target: mutable DebuggerIdentity::DebugId
            metadata_version: mutable u32
            pointer_bits: mutable u16
            status: mutable ManifestStatus
            first_event: mutable u64
            last_event: mutable u64
            # Counts Checkpoint kind chunks; event chunks are counted separately.
            checkpoint_count: mutable u64

        def manifest_new(build: DebuggerIdentity::BuildIdentity, status: ManifestStatus) -> BundleManifest:
            return BundleManifest{schema: Manifest::TRACE_MANIFEST_SCHEMA, compiler: build.compiler, runtime: build.runtime, source: build.source, target: build.target, metadata_version: build.metadata_version, pointer_bits: 64, status: status, first_event: 0, last_event: 0, checkpoint_count: 0}

        def manifest_status_code(status: ManifestStatus) -> u16:
            return 0 if status == ManifestStatus.Exact
            return 1 if status == ManifestStatus.Partial
            return 2 if status == ManifestStatus.Observational
            return 3

        def manifest_status_from_code(code: u16) -> ManifestStatus:
            return ManifestStatus.Exact if code == 0
            return ManifestStatus.Partial if code == 1
            return ManifestStatus.Observational if code == 2
            return ManifestStatus.Corrupt

        def manifest_encode(manifest: BundleManifest) -> DebuggerTraceBinary::ByteWriter:
            writer: mutable DebuggerTraceBinary::ByteWriter = zeroed
            DebuggerTraceBinary::writer_initialize(writer)
            DebuggerTraceBinary::writer_put_u32(writer, Manifest::TRACE_MANIFEST_MAGIC)
            DebuggerTraceBinary::writer_put_u16(writer, manifest.schema)
            DebuggerTraceBinary::writer_put_u16(writer, manifest_status_code(manifest.status))
            DebuggerTraceBinary::writer_put_u64(writer, manifest.compiler.value)
            DebuggerTraceBinary::writer_put_u64(writer, manifest.runtime.value)
            DebuggerTraceBinary::writer_put_u64(writer, manifest.source.value)
            DebuggerTraceBinary::writer_put_u64(writer, manifest.target.value)
            DebuggerTraceBinary::writer_put_u32(writer, manifest.metadata_version)
            DebuggerTraceBinary::writer_put_u16(writer, manifest.pointer_bits)
            DebuggerTraceBinary::writer_put_u64(writer, manifest.first_event)
            DebuggerTraceBinary::writer_put_u64(writer, manifest.last_event)
            DebuggerTraceBinary::writer_put_u64(writer, manifest.checkpoint_count)
            return writer

        def manifest_decode(reader: mutable DebuggerTraceBinary::ByteReader&) -> BundleManifest:
            decoded: mutable BundleManifest = zeroed
            magic: u32 = DebuggerTraceBinary::reader_take_u32(reader)
            decoded.schema <- DebuggerTraceBinary::reader_take_u16(reader)
            decoded.status <- manifest_status_from_code(DebuggerTraceBinary::reader_take_u16(reader))
            decoded.compiler <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            decoded.runtime <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            decoded.source <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            decoded.target <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            decoded.metadata_version <- DebuggerTraceBinary::reader_take_u32(reader)
            decoded.pointer_bits <- DebuggerTraceBinary::reader_take_u16(reader)
            decoded.first_event <- DebuggerTraceBinary::reader_take_u64(reader)
            decoded.last_event <- DebuggerTraceBinary::reader_take_u64(reader)
            decoded.checkpoint_count <- DebuggerTraceBinary::reader_take_u64(reader)
            decoded.schema <- Manifest::INVALID_SCHEMA if magic != Manifest::TRACE_MANIFEST_MAGIC or not DebuggerTraceBinary::reader_is_valid(reader) or reader.offset != reader.length
            return decoded

        def manifest_is_well_formed(manifest: BundleManifest) -> bool:
            return false if manifest.schema != Manifest::TRACE_MANIFEST_SCHEMA or manifest.status == ManifestStatus.Corrupt
            return false if manifest.pointer_bits != 64 or manifest.metadata_version == 0
            return false if DebuggerIdentity::debug_id_is_zero(manifest.compiler) or DebuggerIdentity::debug_id_is_zero(manifest.runtime) or DebuggerIdentity::debug_id_is_zero(manifest.source) or DebuggerIdentity::debug_id_is_zero(manifest.target)
            return false if manifest.last_event < manifest.first_event
            return true

        def manifest_is_replayable(manifest: BundleManifest) -> bool:
            return false if not manifest_is_well_formed(manifest) or manifest.status != ManifestStatus.Exact
            return true
