# Lossless event reader for recorder chunks.  It verifies every chunk before
# decoding event envelopes and exposes only the verified prefix after damage.

include "./binary.elisa"
include "./event_codec.elisa"
include "./storage.elisa"
include "./manifest.elisa"
include "../core/events.elisa"
include "../core/identity.elisa"
include "../core/errors.elisa"

extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]
extern free(storage: heap void&) can[Memory.Release]

module DebuggerTraceReader:
    private:
        const module Detail:
            SEQUENCE: u32 = 1
            CHECKSUM: u32 = 2
            ENCODING: u32 = 3
            READER_DETAIL_CAPACITY: u32 = 4
            READER_DETAIL_ENUM: u32 = 5
            TASK: u32 = 6
            STORAGE_STATUS: u32 = 7
            EVENT_ENVELOPE: u32 = 8

        const module Capacity:
            READER_CAPACITY_EVENTS: usize = 256
            READER_CAPACITY_EVENT_CHUNKS: usize = 8
            CHECKPOINTS: usize = Capacity::READER_CAPACITY_EVENT_CHUNKS
            READER_CAPACITY_MANIFEST_CHUNKS: usize = 1
            READER_CAPACITY_CHUNKS: usize = Capacity::READER_CAPACITY_EVENT_CHUNKS + Capacity::READER_CAPACITY_MANIFEST_CHUNKS
            READER_CAPACITY_MAX_PAYLOAD_BYTES: usize = DebuggerTraceStorageCapacity::TRACE_STORAGE_PAYLOAD_CAPACITY

        const module Sequence:
            FIRST: u64 = 0
            READER_SEQUENCE_MAX_EVENT: u64 = 18446744073709551615
            MAX_CHUNK: u64 = 18446744073709551615
            EVENT_INDEX_OFFSET: usize = 1

        const module ChunkKind:
            READER_CHUNKKIND_MAX_CHUNK_KIND: u16 = 5

        const module Identity:
            READER_IDENTITY_ROOT_BRANCH: u64 = 0

    public:
        enum ReaderState:
            Empty
            Ready
            Partial
            Corrupt

        struct TraceReader:
            # Checkpoints are separately allocated so ordinary construction
            # does not clear the maximum checkpoint payload.
            manifest: mutable DebuggerTraceManifest::BundleManifest
            events: mutable DebuggerEvents::EventEnvelope[Capacity::READER_CAPACITY_EVENTS]
            full_checkpoints: mutable heap DebuggerFullCheckpoint::ManagedCheckpoint&
            event_count: mutable usize
            full_checkpoint_count: mutable usize
            next_sequence: mutable u64
            next_event: mutable u64
            event_exhausted: mutable bool
            recording: mutable DebuggerIdentity::DebugId
            recording_seen: mutable bool
            manifest_seen: mutable bool
            event_chunk_count: mutable usize
            checkpoint_chunk_count: mutable usize
            chunk_count: mutable usize
            state: mutable ReaderState
            last_error: mutable DebuggerErrors::DebuggerError

        def reader_from_raw(storage: mutable heap void&) -> mutable heap TraceReader& can Unsafe.PointerCast:
            trusted Unsafe.PointerCast:
                return storage.cast[mutable heap TraceReader&]

        def reader_initialize(reader: mutable heap TraceReader&) -> void:
            # Events and checkpoints are count-gated. Keep only the small
            # manifest sentinel initialized because ingestion snapshots it
            # before validating each chunk.
            reader.manifest <- zeroed
            reader.event_count <- 0
            reader.full_checkpoint_count <- 0
            reader.next_sequence <- Sequence::FIRST
            reader.next_event <- 0
            reader.event_exhausted <- false
            reader.recording <- DebuggerIdentity::debug_id(0)
            reader.recording_seen <- false
            reader.manifest_seen <- false
            reader.event_chunk_count <- 0
            reader.checkpoint_chunk_count <- 0
            reader.chunk_count <- 0
            reader.state <- ReaderState.Empty
            reader.last_error <- DebuggerErrors::no_error()

        def reader_counts_are_within_capacity(reader: TraceReader&) -> bool:
            return reader.event_count <= Capacity::READER_CAPACITY_EVENTS and reader.full_checkpoint_count <= Capacity::CHECKPOINTS and reader.event_chunk_count <= Capacity::READER_CAPACITY_EVENT_CHUNKS and reader.checkpoint_chunk_count <= Capacity::CHECKPOINTS and reader.chunk_count <= Capacity::READER_CAPACITY_CHUNKS

        def reader_new() -> mutable heap TraceReader& can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            storage: mutable heap void&? = malloc(size_of(TraceReader))
            if storage == null:
                panic("trace reader allocation failed")
            reader: mutable heap TraceReader& = reader_from_raw(storage)
            checkpoint_storage: mutable heap void&? = malloc(size_of(DebuggerFullCheckpoint::ManagedCheckpoint) * Capacity::CHECKPOINTS)
            if checkpoint_storage == null:
                trusted Unsafe.PointerCast:
                    free(storage) can Memory.Release
                panic("trace checkpoint storage allocation failed")
            trusted Unsafe.PointerCast:
                reader.full_checkpoints <- checkpoint_storage.cast[mutable heap DebuggerFullCheckpoint::ManagedCheckpoint&]
            reader_initialize(reader)
            return reader

        # Each reader owns its object and checkpoint allocation. Copies must
        # use this operation so checkpoint storage never aliases unexpectedly.
        def reader_clone(reader: TraceReader&) -> mutable heap TraceReader& can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            clone: mutable heap TraceReader& = reader_new() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
            if not reader_counts_are_within_capacity(reader):
                clone.state <- ReaderState.Corrupt
                clone.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY)
                return clone
            clone.manifest <- reader.manifest
            clone.event_count <- reader.event_count
            clone.full_checkpoint_count <- reader.full_checkpoint_count
            clone.next_sequence <- reader.next_sequence
            clone.next_event <- reader.next_event
            clone.event_exhausted <- reader.event_exhausted
            clone.recording <- reader.recording
            clone.recording_seen <- reader.recording_seen
            clone.manifest_seen <- reader.manifest_seen
            clone.event_chunk_count <- reader.event_chunk_count
            clone.checkpoint_chunk_count <- reader.checkpoint_chunk_count
            clone.chunk_count <- reader.chunk_count
            clone.state <- reader.state
            clone.last_error <- reader.last_error
            for index in 0..<reader.event_count:
                clone.events[index] <- reader.events[index]
            for index in 0..<reader.full_checkpoint_count:
                clone.full_checkpoints[index] <- reader.full_checkpoints[index]
            return clone

        def reader_destroy(reader: mutable heap TraceReader&) -> void can[Memory.Release, Unsafe.PointerCast]:
            # Call exactly once after the owning handle is no longer in use.
            reader.state <- ReaderState.Corrupt
            trusted Unsafe.PointerCast:
                free(reader.full_checkpoints.cast[heap void&]) can Memory.Release
                free(reader.cast[heap void&]) can Memory.Release

        def reader_ingest_manifest(reader: mutable TraceReader&, chunk: DebuggerTraceStorage::StoredChunk&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if reader.manifest_seen
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if chunk.header.sequence != reader.next_sequence
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if not DebuggerTrace::trace_chunk_range_valid(chunk.header)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.header.payload_length != chunk.payload_length.u64() or chunk.header.checksum != chunk.checksum
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY) if chunk.payload_length > Capacity::READER_CAPACITY_MAX_PAYLOAD_BYTES
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.payload_length == 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CHECKSUM) if not DebuggerTraceBinary::bytes_checksum_matches(chunk.payload[0], chunk.payload_length, chunk.checksum)
            payload_reader: mutable DebuggerTraceBinary::ByteReader
            DebuggerTraceBinary::reader_initialize(payload_reader, chunk.payload[0], chunk.payload_length)
            reader.manifest <- DebuggerTraceManifest::manifest_decode(payload_reader)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if not DebuggerTraceBinary::reader_is_valid(payload_reader) or payload_reader.offset != payload_reader.length or reader.manifest.schema == 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if reader.manifest.status == DebuggerTraceManifest::ManifestStatus.Corrupt
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if not DebuggerTraceManifest::manifest_is_well_formed(reader.manifest)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if chunk.header.schema != reader.manifest.schema.u32() or chunk.header.first_event != reader.manifest.first_event or chunk.header.last_event != reader.manifest.last_event
            reader.next_event <- reader.manifest.first_event
            reader.event_exhausted <- false
            reader.manifest_seen <- true
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if reader.next_sequence == Sequence::MAX_CHUNK
            reader.next_sequence <- reader.next_sequence + 1
            reader.state <- ReaderState.Ready
            return DebuggerErrors::no_error()

        def reader_ingest_events(reader: mutable TraceReader&, chunk: DebuggerTraceStorage::StoredChunk&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if not reader.manifest_seen
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.payload_length == 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.header.payload_length != chunk.payload_length.u64() or chunk.header.checksum != chunk.checksum
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY) if chunk.payload_length > Capacity::READER_CAPACITY_MAX_PAYLOAD_BYTES
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if chunk.header.sequence != reader.next_sequence
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if chunk.header.schema != reader.manifest.schema.u32()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if not DebuggerTrace::trace_chunk_range_valid(chunk.header)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CHECKSUM) if not DebuggerTraceBinary::bytes_checksum_matches(chunk.payload[0], chunk.payload_length, chunk.checksum)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if not DebuggerTraceStorage::storage_event_payload_is_valid(chunk.payload[0], 0, chunk.payload_length, chunk.header.schema, chunk.header.first_event, chunk.header.last_event)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if reader.event_exhausted
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if chunk.header.first_event != reader.next_event
            event_offset_in_chunk: u64 = chunk.header.last_event - chunk.header.first_event
            remaining_capacity: usize = Capacity::READER_CAPACITY_EVENTS - reader.event_count
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY) if event_offset_in_chunk >= remaining_capacity.u64()
            expected_event_count: u64 = event_offset_in_chunk + Sequence::EVENT_INDEX_OFFSET.u64()
            event_reader: mutable DebuggerTraceBinary::ByteReader
            DebuggerTraceBinary::reader_initialize(event_reader, chunk.payload[0], chunk.payload_length)
            events_decoded: mutable u64 = Sequence::FIRST
            while event_reader.offset < event_reader.length:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if reader.event_exhausted
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY) if reader.event_count >= Capacity::READER_CAPACITY_EVENTS
                decoded: DebuggerTraceEventCodec::DecodeResult = DebuggerTraceEventCodec::event_record_decode(event_reader)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if decoded.status != DebuggerTraceEventCodec::DecodeStatus.Ready
                event: DebuggerEvents::EventEnvelope = decoded.event
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if event.ordinal != reader.next_event
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TASK) if event.task.value != event.position.task.value
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if event.position.recording.value == 0
                if not reader.recording_seen:
                    reader.recording <- event.position.recording
                    reader.recording_seen <- true
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if event.position.recording.value != reader.recording.value
                for checkpoint_index in 0..<reader.full_checkpoint_count:
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if reader.full_checkpoints[checkpoint_index].recording.value != event.position.recording.value
                envelope_failure: u32 = DebuggerEvents::event_envelope_validation_detail(event)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::EVENT_ENVELOPE + envelope_failure) if envelope_failure != 0
                reader.events[reader.event_count] <- event
                reader.event_count <- reader.event_count + 1
                events_decoded <- events_decoded + Sequence::EVENT_INDEX_OFFSET.u64()
                if event.ordinal == Sequence::READER_SEQUENCE_MAX_EVENT:
                    reader.event_exhausted <- true
                else:
                    reader.next_event <- reader.next_event + 1
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING + 10) if not DebuggerTraceBinary::reader_is_valid(event_reader)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING + 20) if event_reader.offset != event_reader.length
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if events_decoded != expected_event_count
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if reader.next_sequence == Sequence::MAX_CHUNK
            reader.next_sequence <- reader.next_sequence + 1
            reader.event_chunk_count <- reader.event_chunk_count + 1
            reader.state <- ReaderState.Ready
            return DebuggerErrors::no_error()

        def reader_ingest_opaque(reader: mutable TraceReader&, chunk: DebuggerTraceStorage::StoredChunk&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if not reader.manifest_seen
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY) if chunk.payload_length > Capacity::READER_CAPACITY_MAX_PAYLOAD_BYTES
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.header.payload_length != chunk.payload_length.u64() or chunk.header.checksum != chunk.checksum
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if chunk.header.sequence != reader.next_sequence
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::CHECKSUM) if not DebuggerTraceBinary::bytes_checksum_matches(chunk.payload[0], chunk.payload_length, chunk.checksum)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if chunk.header.schema != reader.manifest.schema.u32() or not DebuggerTrace::trace_chunk_range_valid(chunk.header)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.header.kind == DebuggerTrace::ChunkKind.Checkpoint and not DebuggerTraceStorage::storage_checkpoint_chunk_is_valid(chunk)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if chunk.header.kind == DebuggerTrace::ChunkKind.Checkpoint and not DebuggerTraceStorage::storage_checkpoint_event_is_within_trace(chunk.header.first_event, reader.manifest.first_event, reader.manifest.last_event)
            if chunk.header.kind == DebuggerTrace::ChunkKind.Checkpoint and chunk.payload_length != DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY) if reader.full_checkpoint_count >= Capacity::CHECKPOINTS
                checkpoint: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerTraceStorage::storage_checkpoint_chunk_decode(chunk)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if checkpoint.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if reader.recording_seen and checkpoint.checkpoint.recording.value != reader.recording.value
                reader.full_checkpoints[reader.full_checkpoint_count] <- checkpoint.checkpoint
                reader.full_checkpoint_count <- reader.full_checkpoint_count + 1
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::SEQUENCE) if reader.next_sequence == Sequence::MAX_CHUNK
            reader.next_sequence <- reader.next_sequence + 1
            reader.checkpoint_chunk_count <- reader.checkpoint_chunk_count + 1 if chunk.header.kind == DebuggerTrace::ChunkKind.Checkpoint
            reader.state <- ReaderState.Ready
            return DebuggerErrors::no_error()

        def reader_ingest(reader: mutable TraceReader&, chunk: DebuggerTraceStorage::StoredChunk&) -> DebuggerErrors::DebuggerError:
            return reader.last_error if reader.state == ReaderState.Corrupt
            if not reader_counts_are_within_capacity(reader):
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            if chunk.header.kind.u16() > ChunkKind::READER_CHUNKKIND_MAX_CHUNK_KIND:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::READER_DETAIL_ENUM)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            if reader.chunk_count >= Capacity::READER_CAPACITY_CHUNKS:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::READER_DETAIL_CAPACITY)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            previous_manifest: DebuggerTraceManifest::BundleManifest = reader.manifest
            previous_event_count: usize = reader.event_count
            previous_full_checkpoint_count: usize = reader.full_checkpoint_count
            previous_next_sequence: u64 = reader.next_sequence
            previous_next_event: u64 = reader.next_event
            previous_event_exhausted: bool = reader.event_exhausted
            previous_recording: DebuggerIdentity::DebugId = reader.recording
            previous_recording_seen: bool = reader.recording_seen
            previous_manifest_seen: bool = reader.manifest_seen
            previous_event_chunk_count: usize = reader.event_chunk_count
            previous_checkpoint_chunk_count: usize = reader.checkpoint_chunk_count
            result: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if chunk.header.kind == DebuggerTrace::ChunkKind.Manifest:
                result <- reader_ingest_manifest(reader, chunk)
            if chunk.header.kind == DebuggerTrace::ChunkKind.Events:
                result <- reader_ingest_events(reader, chunk)
            if chunk.header.kind != DebuggerTrace::ChunkKind.Manifest and chunk.header.kind != DebuggerTrace::ChunkKind.Events:
                result <- reader_ingest_opaque(reader, chunk)
            if not DebuggerErrors::error_is_ok(result):
                # Chunk validation can fail after decoding earlier records in
                # the same chunk. Roll back all prefix metadata so callers see
                # only complete, verified chunks after the reader is poisoned.
                for index in previous_event_count..<reader.event_count:
                    reader.events[index] <- zeroed
                for index in previous_full_checkpoint_count..<reader.full_checkpoint_count:
                    reader.full_checkpoints[index] <- zeroed
                reader.manifest <- previous_manifest
                reader.event_count <- previous_event_count
                reader.full_checkpoint_count <- previous_full_checkpoint_count
                reader.next_sequence <- previous_next_sequence
                reader.next_event <- previous_next_event
                reader.event_exhausted <- previous_event_exhausted
                reader.recording <- previous_recording
                reader.recording_seen <- previous_recording_seen
                reader.manifest_seen <- previous_manifest_seen
                reader.event_chunk_count <- previous_event_chunk_count
                reader.checkpoint_chunk_count <- previous_checkpoint_chunk_count
                reader.state <- ReaderState.Corrupt
                reader.last_error <- result
                return result
            reader.chunk_count <- reader.chunk_count + 1
            return result

        # Decode and ingest one canonical storage frame at the reader boundary.
        # Keeping this path beside reader_ingest prevents transports from
        # manufacturing StoredChunk values that bypass checksum and length
        # validation.  A truncated frame is retryable; every other malformed
        # frame permanently poisons the reader so callers cannot inspect a
        # prefix that was never verified.
        def reader_ingest_encoded(reader: mutable TraceReader&, bytes: u8&, length: usize) -> DebuggerErrors::DebuggerError:
            decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(bytes, length)
            if decoded.status == DebuggerTraceStorage::StorageStatus.Truncated:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Detail::STORAGE_STATUS)
            if decoded.status == DebuggerTraceStorage::StorageStatus.Oversized:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::STORAGE_STATUS)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            if decoded.status != DebuggerTraceStorage::StorageStatus.Ready:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::STORAGE_STATUS)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            return reader_ingest(reader, decoded.chunk)

        def reader_is_exact(reader: TraceReader&) -> bool:
            return false if not reader_counts_are_within_capacity(reader) or reader.state != ReaderState.Ready or not DebuggerErrors::error_is_ok(reader.last_error) or not DebuggerTraceManifest::manifest_is_replayable(reader.manifest)
            return false if reader.event_count == 0 or not reader.recording_seen
            return false if reader.event_count > 0 and reader.manifest.first_event > Sequence::READER_SEQUENCE_MAX_EVENT - (reader.event_count - Sequence::EVENT_INDEX_OFFSET).u64()
            expected_last: mutable u64 = reader.manifest.first_event
            expected_last <- reader.manifest.first_event + (reader.event_count - Sequence::EVENT_INDEX_OFFSET).u64() if reader.event_count > 0
            return false if reader.manifest.last_event != expected_last
            return false if reader.manifest.checkpoint_count != reader.checkpoint_chunk_count.u64()
            for index in 0..<reader.event_count:
                event: DebuggerEvents::EventEnvelope = reader.events[index]
                return false if index.u64() > Sequence::READER_SEQUENCE_MAX_EVENT - reader.manifest.first_event
                return false if event.ordinal != reader.manifest.first_event + index.u64() or not DebuggerTraceEventCodec::event_record_schema_is_supported(event.schema) or event.position.recording.value != reader.recording.value or event.position.branch.value != Identity::READER_IDENTITY_ROOT_BRANCH or event.position.event != event.ordinal or event.task.value != event.position.task.value or event.quality != DebuggerEvents::EventQuality.Exact
            for index in 0..<reader.full_checkpoint_count:
                return false if reader.full_checkpoints[index].branch.value != Identity::READER_IDENTITY_ROOT_BRANCH
            return true

        def reader_event_count(reader: TraceReader&) -> usize:
            return reader.event_count

        struct FullCheckpointLookup:
            found: mutable bool
            checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint

        def reader_full_checkpoint_count(reader: TraceReader&) -> usize:
            return reader.full_checkpoint_count

        def reader_full_checkpoint_at(reader: TraceReader&, index: usize) -> FullCheckpointLookup:
            return FullCheckpointLookup{found: false, checkpoint: zeroed} if not reader_counts_are_within_capacity(reader) or index >= reader.full_checkpoint_count
            return FullCheckpointLookup{found: true, checkpoint: reader.full_checkpoints[index]}

        # Replay starts from the latest validated full checkpoint that does not
        # lie after the requested boundary.  A raw index lookup is useful for
        # inspection, but it is not sufficient for replay: partial traces,
        # another recording, or a checkpoint from the future must never seed
        # reconstruction.
        def reader_nearest_checkpoint_at_or_before(reader: TraceReader&, event: u64) -> FullCheckpointLookup:
            result: mutable FullCheckpointLookup = zeroed
            return result if not reader_counts_are_within_capacity(reader)
            return result if not reader_is_exact(reader)
            final_boundary: mutable u64 = reader.manifest.last_event
            final_boundary <- final_boundary + Sequence::EVENT_INDEX_OFFSET.u64() if final_boundary != Sequence::READER_SEQUENCE_MAX_EVENT
            return result if event < reader.manifest.first_event or event > final_boundary
            selected_event: mutable u64 = 0
            for index in 0..<reader.full_checkpoint_count:
                checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = reader.full_checkpoints[index]
                continue if checkpoint.event < reader.manifest.first_event or checkpoint.event > final_boundary or checkpoint.event > event
                continue if checkpoint.recording.value != reader.recording.value or checkpoint.branch.value != Identity::READER_IDENTITY_ROOT_BRANCH
                continue if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
                if not result.found or checkpoint.event >= selected_event:
                    result.found <- true
                    result.checkpoint <- checkpoint
                    selected_event <- checkpoint.event
            return result
