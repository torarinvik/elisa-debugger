# Lossless event reader for recorder chunks.  It verifies every chunk before
# decoding event envelopes and exposes only the verified prefix after damage.

include "./binary.elisa"
include "./storage.elisa"
include "./manifest.elisa"
include "../core/events.elisa"
include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerTraceReader:
    private:
        const module Detail:
            TRACE_READER_DETAIL_SEQUENCE: u32 = 1
            TRACE_READER_DETAIL_CHECKSUM: u32 = 2
            ENCODING: u32 = 3
            TRACE_READER_DETAIL_CAPACITY: u32 = 4
            TRACE_READER_DETAIL_ENUM: u32 = 5
            TASK: u32 = 6

        const module Event:
            TRACE_READER_EVENT_SCHEMA_BYTES: usize = 4
            ORDINAL_BYTES: usize = 8
            ID_BYTES: usize = 8
            MICROSTEP_BYTES: usize = 4
            ENUM_BYTES: usize = 2
            TRACE_READER_EVENT_PAYLOAD_BYTES: usize = 8
            TRACE_READER_EVENT_ENCODED_BYTES: usize = Event::TRACE_READER_EVENT_SCHEMA_BYTES + Event::ORDINAL_BYTES + Event::ID_BYTES * 7 + Event::MICROSTEP_BYTES + Event::ENUM_BYTES * 2 + Event::TRACE_READER_EVENT_PAYLOAD_BYTES
            TRACE_READER_EVENT_KIND_MAX: u16 = 20
            TRACE_READER_EVENT_QUALITY_MAX: u16 = 4

        const module Reader:
            TRACE_READER_EVENT_CAPACITY: usize = 256
            TRACE_READER_EVENT_CHUNK_CAPACITY: usize = 8
            FULL_CHECKPOINT_CAPACITY: usize = Reader::TRACE_READER_EVENT_CHUNK_CAPACITY
            TRACE_READER_MANIFEST_CHUNK_COUNT: usize = 1
            TRACE_READER_CHUNK_CAPACITY: usize = Reader::TRACE_READER_EVENT_CHUNK_CAPACITY + Reader::TRACE_READER_MANIFEST_CHUNK_COUNT
            TRACE_READER_FIRST_SEQUENCE: u64 = 0
            TRACE_READER_PAYLOAD_CAPACITY: usize = DebuggerTraceStorageCapacity::TRACE_STORAGE_PAYLOAD_CAPACITY
            TRACE_READER_CHUNK_KIND_MAX: u16 = 5
            TRACE_READER_MAX_EVENT: u64 = 18446744073709551615
            TRACE_READER_MAX_SEQUENCE: u64 = 18446744073709551615
            TRACE_READER_ROOT_BRANCH: u64 = 0
            EVENT_INDEX_OFFSET: usize = 1
            STORAGE_DETAIL_STATUS: u32 = 7

        # A bundle stores up to eight non-manifest chunks plus one manifest.

    public:
        enum ReaderState:
            Empty
            Ready
            Partial
            Corrupt

        struct TraceReader:
            manifest: mutable DebuggerTraceManifest::BundleManifest
            events: mutable DebuggerEvents::EventEnvelope[Reader::TRACE_READER_EVENT_CAPACITY]
            full_checkpoints: mutable DebuggerFullCheckpoint::ManagedCheckpoint[Reader::FULL_CHECKPOINT_CAPACITY]
            event_count: mutable usize
            full_checkpoint_count: mutable usize
            next_sequence: mutable u64
            next_event: mutable u64
            event_exhausted: mutable bool
            recording: mutable DebuggerIdentity::DebugId
            recording_seen: mutable bool
            manifest_seen: mutable bool
            event_chunk_count: mutable usize
            checkpoint_chunk_count: mutable usize
            chunk_count: mutable usize
            state: mutable ReaderState
            last_error: mutable DebuggerErrors::DebuggerError

        def reader_new() -> TraceReader:
            reader: mutable TraceReader = zeroed
            reader.next_sequence <- Reader::TRACE_READER_FIRST_SEQUENCE
            reader.next_event <- 0
            reader.event_exhausted <- false
            reader.full_checkpoint_count <- 0
            reader.recording <- DebuggerIdentity::debug_id(0)
            reader.recording_seen <- false
            reader.manifest_seen <- false
            reader.event_chunk_count <- 0
            reader.checkpoint_chunk_count <- 0
            reader.chunk_count <- 0
            reader.state <- ReaderState.Empty
            reader.last_error <- DebuggerErrors::no_error()
            return reader

        def event_kind_from_code(code: u16) -> DebuggerEvents::EventKind:
            return DebuggerEvents::EventKind.ExecutionBoundary if code == 0
            return DebuggerEvents::EventKind.CallEntry if code == 1
            return DebuggerEvents::EventKind.CallExit if code == 2
            return DebuggerEvents::EventKind.Unwind if code == 3
            return DebuggerEvents::EventKind.ScopeEnter if code == 4
            return DebuggerEvents::EventKind.ScopeExit if code == 5
            return DebuggerEvents::EventKind.Allocation if code == 6
            return DebuggerEvents::EventKind.Release if code == 7
            return DebuggerEvents::EventKind.RegionReset if code == 8
            return DebuggerEvents::EventKind.MutationAttempt if code == 9
            return DebuggerEvents::EventKind.MutationCommit if code == 10
            return DebuggerEvents::EventKind.Input if code == 11
            return DebuggerEvents::EventKind.Output if code == 12
            return DebuggerEvents::EventKind.Scheduler if code == 13
            return DebuggerEvents::EventKind.Synchronization if code == 14
            return DebuggerEvents::EventKind.Atomic if code == 15
            return DebuggerEvents::EventKind.Fault if code == 16
            return DebuggerEvents::EventKind.Checkpoint if code == 17
            return DebuggerEvents::EventKind.Module if code == 18
            return DebuggerEvents::EventKind.DebuggerMutation if code == 19
            return DebuggerEvents::EventKind.TraceHealth

        def event_quality_from_code(code: u16) -> DebuggerEvents::EventQuality:
            return DebuggerEvents::EventQuality.Exact if code == 0
            return DebuggerEvents::EventQuality.Partial if code == 1
            return DebuggerEvents::EventQuality.Observational if code == 2
            return DebuggerEvents::EventQuality.Diverged if code == 3
            return DebuggerEvents::EventQuality.Corrupt

        def reader_ingest_manifest(reader: mutable TraceReader&, chunk: DebuggerTraceStorage::StoredChunk) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if reader.manifest_seen
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if chunk.header.sequence != reader.next_sequence
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if not DebuggerTrace::trace_chunk_range_valid(chunk.header)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.header.payload_length != chunk.payload_length.u64() or chunk.header.checksum != chunk.checksum
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::TRACE_READER_DETAIL_CAPACITY) if chunk.payload_length > Reader::TRACE_READER_PAYLOAD_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.payload_length == 0
            payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
            for index in 0..<chunk.payload_length:
                payload <- DebuggerTraceBinary::writer_put_byte(payload, chunk.payload[index])
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_CHECKSUM) if not DebuggerTraceBinary::writer_checksum_matches(payload, chunk.checksum)
            payload_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(chunk.payload[0], chunk.payload_length)
            reader.manifest <- DebuggerTraceManifest::manifest_decode(payload_reader)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if not DebuggerTraceBinary::reader_is_valid(payload_reader) or payload_reader.offset != payload_reader.length or reader.manifest.schema == 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if reader.manifest.status == DebuggerTraceManifest::ManifestStatus.Corrupt
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if not DebuggerTraceManifest::manifest_is_well_formed(reader.manifest)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if chunk.header.schema != reader.manifest.schema.u32() or chunk.header.first_event != reader.manifest.first_event or chunk.header.last_event != reader.manifest.last_event
            reader.next_event <- reader.manifest.first_event
            reader.event_exhausted <- false
            reader.manifest_seen <- true
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if reader.next_sequence == Reader::TRACE_READER_MAX_SEQUENCE
            reader.next_sequence <- reader.next_sequence + 1
            reader.state <- ReaderState.Ready
            return DebuggerErrors::no_error()

        def reader_ingest_events(reader: mutable TraceReader&, chunk: DebuggerTraceStorage::StoredChunk) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if not reader.manifest_seen
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.payload_length == 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.header.payload_length != chunk.payload_length.u64() or chunk.header.checksum != chunk.checksum
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::TRACE_READER_DETAIL_CAPACITY) if chunk.payload_length > Reader::TRACE_READER_PAYLOAD_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.payload_length % Event::TRACE_READER_EVENT_ENCODED_BYTES != 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if chunk.header.sequence != reader.next_sequence
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if chunk.header.schema != reader.manifest.schema.u32()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if not DebuggerTrace::trace_chunk_range_valid(chunk.header)
            payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
            for index in 0..<chunk.payload_length:
                payload <- DebuggerTraceBinary::writer_put_byte(payload, chunk.payload[index])
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_CHECKSUM) if not DebuggerTraceBinary::writer_checksum_matches(payload, chunk.checksum)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::TRACE_READER_DETAIL_CAPACITY) if reader.event_count >= Reader::TRACE_READER_EVENT_CAPACITY
            event_count_in_chunk: u64 = (chunk.payload_length / Event::TRACE_READER_EVENT_ENCODED_BYTES).u64()
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if reader.event_exhausted
            # Check the last ordinal so one event at u64::MAX remains valid without increment overflow.
            event_offset_in_chunk: u64 = event_count_in_chunk - 1
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if event_offset_in_chunk > Reader::TRACE_READER_MAX_EVENT - reader.next_event
            expected_last_event: u64 = reader.next_event + event_offset_in_chunk
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if chunk.header.first_event != reader.next_event or chunk.header.last_event != expected_last_event
            event_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(chunk.payload[0], chunk.payload_length)
            while event_reader.offset + Event::TRACE_READER_EVENT_ENCODED_BYTES <= event_reader.length:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if reader.event_exhausted
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::TRACE_READER_DETAIL_CAPACITY) if reader.event_count >= Reader::TRACE_READER_EVENT_CAPACITY
                event: mutable DebuggerEvents::EventEnvelope = zeroed
                schema: u32 = DebuggerTraceBinary::reader_take_u32(event_reader)
                ordinal: u64 = DebuggerTraceBinary::reader_take_u64(event_reader)
                task: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                recording: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                branch: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                event_id: u64 = DebuggerTraceBinary::reader_take_u64(event_reader)
                position_task: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                statement: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                microstep: u32 = DebuggerTraceBinary::reader_take_u32(event_reader)
                kind: u16 = DebuggerTraceBinary::reader_take_u16(event_reader)
                quality: u16 = DebuggerTraceBinary::reader_take_u16(event_reader)
                payload_hash: u64 = DebuggerTraceBinary::reader_take_u64(event_reader)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_ENUM) if kind > Event::TRACE_READER_EVENT_KIND_MAX or quality > Event::TRACE_READER_EVENT_QUALITY_MAX or quality == DebuggerEvents::EventQuality.Corrupt.u16()
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if schema != reader.manifest.schema.u32()
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if ordinal != reader.next_event
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TASK) if task.value != position_task.value
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if recording.value == 0
                if not reader.recording_seen:
                    reader.recording <- recording
                    reader.recording_seen <- true
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if recording.value != reader.recording.value
                for checkpoint_index in 0..<reader.full_checkpoint_count:
                    return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if reader.full_checkpoints[checkpoint_index].recording.value != recording.value
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if event_id != ordinal
                event.schema <- schema
                event.ordinal <- ordinal
                event.task <- task
                event.position <- DebuggerIdentity::Position{recording: recording, branch: branch, event: event_id, task: position_task, invocation: invocation, statement: statement, microstep: microstep}
                event.kind <- event_kind_from_code(kind)
                event.quality <- event_quality_from_code(quality)
                event.payload_hash <- payload_hash
                reader.events[reader.event_count] <- event
                reader.event_count <- reader.event_count + 1
                if ordinal == Reader::TRACE_READER_MAX_EVENT:
                    reader.event_exhausted <- true
                else:
                    reader.next_event <- reader.next_event + 1
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING + 10) if not DebuggerTraceBinary::reader_is_valid(event_reader)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING + 20) if event_reader.offset != event_reader.length
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if reader.next_sequence == Reader::TRACE_READER_MAX_SEQUENCE
            reader.next_sequence <- reader.next_sequence + 1
            reader.event_chunk_count <- reader.event_chunk_count + 1
            reader.state <- ReaderState.Ready
            return DebuggerErrors::no_error()

        def reader_ingest_opaque(reader: mutable TraceReader&, chunk: DebuggerTraceStorage::StoredChunk) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if not reader.manifest_seen
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::TRACE_READER_DETAIL_CAPACITY) if chunk.payload_length > Reader::TRACE_READER_PAYLOAD_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.header.payload_length != chunk.payload_length.u64() or chunk.header.checksum != chunk.checksum
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if chunk.header.sequence != reader.next_sequence
            payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
            for index in 0..<chunk.payload_length:
                payload <- DebuggerTraceBinary::writer_put_byte(payload, chunk.payload[index])
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_CHECKSUM) if not DebuggerTraceBinary::writer_checksum_matches(payload, chunk.checksum)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if chunk.header.schema != reader.manifest.schema.u32() or not DebuggerTrace::trace_chunk_range_valid(chunk.header)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if chunk.header.kind == DebuggerTrace::ChunkKind.Checkpoint and not DebuggerTraceStorage::storage_checkpoint_chunk_is_valid(chunk)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if chunk.header.kind == DebuggerTrace::ChunkKind.Checkpoint and not DebuggerTraceStorage::storage_checkpoint_event_is_within_trace(chunk.header.first_event, reader.manifest.first_event, reader.manifest.last_event)
            if chunk.header.kind == DebuggerTrace::ChunkKind.Checkpoint and chunk.payload_length != DebuggerCheckpointWireLayout::CHECKPOINT_PAYLOAD_BYTES:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::TRACE_READER_DETAIL_CAPACITY) if reader.full_checkpoint_count >= Reader::FULL_CHECKPOINT_CAPACITY
                checkpoint: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerTraceStorage::storage_checkpoint_chunk_decode(chunk)
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if checkpoint.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::ENCODING) if reader.recording_seen and checkpoint.checkpoint.recording.value != reader.recording.value
                reader.full_checkpoints[reader.full_checkpoint_count] <- checkpoint.checkpoint
                reader.full_checkpoint_count <- reader.full_checkpoint_count + 1
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_SEQUENCE) if reader.next_sequence == Reader::TRACE_READER_MAX_SEQUENCE
            reader.next_sequence <- reader.next_sequence + 1
            reader.checkpoint_chunk_count <- reader.checkpoint_chunk_count + 1 if chunk.header.kind == DebuggerTrace::ChunkKind.Checkpoint
            reader.state <- ReaderState.Ready
            return DebuggerErrors::no_error()

        def reader_ingest(reader: mutable TraceReader&, chunk: DebuggerTraceStorage::StoredChunk) -> DebuggerErrors::DebuggerError:
            return reader.last_error if reader.state == ReaderState.Corrupt
            if chunk.header.kind.u16() > Reader::TRACE_READER_CHUNK_KIND_MAX:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_READER_DETAIL_ENUM)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            if reader.chunk_count >= Reader::TRACE_READER_CHUNK_CAPACITY:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::TRACE_READER_DETAIL_CAPACITY)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            previous_manifest: DebuggerTraceManifest::BundleManifest = reader.manifest
            previous_event_count: usize = reader.event_count
            previous_full_checkpoint_count: usize = reader.full_checkpoint_count
            previous_next_sequence: u64 = reader.next_sequence
            previous_next_event: u64 = reader.next_event
            previous_event_exhausted: bool = reader.event_exhausted
            previous_recording: DebuggerIdentity::DebugId = reader.recording
            previous_recording_seen: bool = reader.recording_seen
            previous_manifest_seen: bool = reader.manifest_seen
            previous_event_chunk_count: usize = reader.event_chunk_count
            previous_checkpoint_chunk_count: usize = reader.checkpoint_chunk_count
            result: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
            if chunk.header.kind == DebuggerTrace::ChunkKind.Manifest:
                result <- reader_ingest_manifest(reader, chunk)
            if chunk.header.kind == DebuggerTrace::ChunkKind.Events:
                result <- reader_ingest_events(reader, chunk)
            if chunk.header.kind != DebuggerTrace::ChunkKind.Manifest and chunk.header.kind != DebuggerTrace::ChunkKind.Events:
                result <- reader_ingest_opaque(reader, chunk)
            if not DebuggerErrors::error_is_ok(result):
                # Chunk validation can fail after decoding earlier records in
                # the same chunk. Roll back all prefix metadata so callers see
                # only complete, verified chunks after the reader is poisoned.
                for index in previous_event_count..<reader.event_count:
                    reader.events[index] <- zeroed
                for index in previous_full_checkpoint_count..<reader.full_checkpoint_count:
                    reader.full_checkpoints[index] <- zeroed
                reader.manifest <- previous_manifest
                reader.event_count <- previous_event_count
                reader.full_checkpoint_count <- previous_full_checkpoint_count
                reader.next_sequence <- previous_next_sequence
                reader.next_event <- previous_next_event
                reader.event_exhausted <- previous_event_exhausted
                reader.recording <- previous_recording
                reader.recording_seen <- previous_recording_seen
                reader.manifest_seen <- previous_manifest_seen
                reader.event_chunk_count <- previous_event_chunk_count
                reader.checkpoint_chunk_count <- previous_checkpoint_chunk_count
                reader.state <- ReaderState.Corrupt
                reader.last_error <- result
                return result
            reader.chunk_count <- reader.chunk_count + 1
            return result

        # Decode and ingest one canonical storage frame at the reader boundary.
        # Keeping this path beside reader_ingest prevents transports from
        # manufacturing StoredChunk values that bypass checksum and length
        # validation.  A truncated frame is retryable; every other malformed
        # frame permanently poisons the reader so callers cannot inspect a
        # prefix that was never verified.
        def reader_ingest_encoded(reader: mutable TraceReader&, bytes: u8&, length: usize) -> DebuggerErrors::DebuggerError:
            decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(bytes, length)
            if decoded.status == DebuggerTraceStorage::StorageStatus.Truncated:
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Reader::STORAGE_DETAIL_STATUS)
            if decoded.status == DebuggerTraceStorage::StorageStatus.Oversized:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Reader::STORAGE_DETAIL_STATUS)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            if decoded.status != DebuggerTraceStorage::StorageStatus.Ready:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Reader::STORAGE_DETAIL_STATUS)
                reader.state <- ReaderState.Corrupt
                reader.last_error <- failure
                return failure
            return reader_ingest(reader, decoded.chunk)

        def reader_is_exact(reader: TraceReader) -> bool:
            return false if reader.event_count > Reader::TRACE_READER_EVENT_CAPACITY or reader.chunk_count > Reader::TRACE_READER_CHUNK_CAPACITY or reader.state != ReaderState.Ready or not DebuggerErrors::error_is_ok(reader.last_error) or not DebuggerTraceManifest::manifest_is_replayable(reader.manifest)
            return false if reader.event_count == 0 or not reader.recording_seen
            return false if reader.event_count > 0 and reader.manifest.first_event > Reader::TRACE_READER_MAX_EVENT - (reader.event_count - Reader::EVENT_INDEX_OFFSET).u64()
            expected_last: mutable u64 = reader.manifest.first_event
            expected_last <- reader.manifest.first_event + (reader.event_count - Reader::EVENT_INDEX_OFFSET).u64() if reader.event_count > 0
            return false if reader.manifest.last_event != expected_last
            return false if reader.manifest.checkpoint_count != reader.checkpoint_chunk_count.u64()
            for index in 0..<reader.event_count:
                event: DebuggerEvents::EventEnvelope = reader.events[index]
                return false if index.u64() > Reader::TRACE_READER_MAX_EVENT - reader.manifest.first_event
                return false if event.ordinal != reader.manifest.first_event + index.u64() or event.schema != reader.manifest.schema.u32() or event.position.recording.value != reader.recording.value or event.position.branch.value != Reader::TRACE_READER_ROOT_BRANCH or event.position.event != event.ordinal or event.task.value != event.position.task.value or event.quality != DebuggerEvents::EventQuality.Exact
            for index in 0..<reader.full_checkpoint_count:
                return false if reader.full_checkpoints[index].branch.value != Reader::TRACE_READER_ROOT_BRANCH
            return true

        def reader_event_count(reader: TraceReader) -> usize:
            return reader.event_count

        struct FullCheckpointLookup:
            found: mutable bool
            checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint

        def reader_full_checkpoint_count(reader: TraceReader) -> usize:
            return reader.full_checkpoint_count

        def reader_full_checkpoint_at(reader: TraceReader, index: usize) -> FullCheckpointLookup:
            return FullCheckpointLookup{found: false, checkpoint: zeroed} if index >= reader.full_checkpoint_count
            return FullCheckpointLookup{found: true, checkpoint: reader.full_checkpoints[index]}

        # Replay starts from the latest validated full checkpoint that does not
        # lie after the requested boundary.  A raw index lookup is useful for
        # inspection, but it is not sufficient for replay: partial traces,
        # another recording, or a checkpoint from the future must never seed
        # reconstruction.
        def reader_nearest_checkpoint_at_or_before(reader: TraceReader, event: u64) -> FullCheckpointLookup:
            result: mutable FullCheckpointLookup = zeroed
            return result if reader.full_checkpoint_count > Reader::FULL_CHECKPOINT_CAPACITY or reader.event_count > Reader::TRACE_READER_EVENT_CAPACITY or reader.chunk_count > Reader::TRACE_READER_CHUNK_CAPACITY
            return result if not reader_is_exact(reader)
            final_boundary: mutable u64 = reader.manifest.last_event
            final_boundary <- final_boundary + Reader::EVENT_INDEX_OFFSET.u64() if final_boundary != Reader::TRACE_READER_MAX_EVENT
            return result if event < reader.manifest.first_event or event > final_boundary
            selected_event: mutable u64 = 0
            for index in 0..<reader.full_checkpoint_count:
                checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = reader.full_checkpoints[index]
                continue if checkpoint.event < reader.manifest.first_event or checkpoint.event > final_boundary or checkpoint.event > event
                continue if checkpoint.recording.value != reader.recording.value or checkpoint.branch.value != Reader::TRACE_READER_ROOT_BRANCH
                continue if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
                if not result.found or checkpoint.event >= selected_event:
                    result.found <- true
                    result.checkpoint <- checkpoint
                    selected_event <- checkpoint.event
            return result
