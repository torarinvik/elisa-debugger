# Exact event recorder.  Events are accumulated in bounded Elisa storage,
# encoded canonically, checksummed, and committed as immutable chunks.  A full
# buffer ends exact recording with a verified prefix instead of dropping events.

include "./binary.elisa"
include "./format.elisa"
include "./storage.elisa"
include "./manifest.elisa"
include "../core/events.elisa"
include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerTraceRecorder:
    private:
        const module Capacity:
            RECORDER_CAPACITY_EVENTS: usize = 16
            RECORDER_CAPACITY_CHUNKS: usize = 8
            RECORDER_CAPACITY_MAX_PAYLOAD_BYTES: usize = 4048

        const module Version:
            EVENT_SCHEMA: u32 = 1

        const module Sequence:
            RECORDER_SEQUENCE_MANIFEST: u64 = 0
            EVENT_OFFSET: u64 = 1
            CHECKPOINT_OFFSET: u64 = 1
            MAX_ORDINAL: u64 = 18446744073709551615

        const module Detail:
            NON_MONOTONIC: u32 = 1
            RESOURCE_LIMIT: u32 = 2
            RECORDER_DETAIL_ENCODING: u32 = 3
            SCHEMA_MISMATCH: u32 = 4
            RECORDING: u32 = 5
            RECORDER_DETAIL_TASK: u32 = 6
            RECORDER_DETAIL_ENUM: u32 = 7
            RECORDER_DETAIL_BRANCH: u32 = 8

        const module Identity:
            RECORDER_IDENTITY_NO_EVENT: u64 = 0
            RECORDER_IDENTITY_NO_RECORDING: u64 = 0
            RECORDER_IDENTITY_ROOT_BRANCH: u64 = 0

        const module EventEncoding:
            RECORDER_EVENTENCODING_SCHEMA_BYTES: usize = 4
            RECORDER_EVENTENCODING_ORDINAL_BYTES: usize = 8
            RECORDER_EVENTENCODING_ID_BYTES: usize = 8
            RECORDER_EVENTENCODING_MICROSTEP_BYTES: usize = 4
            RECORDER_EVENTENCODING_ENUM_BYTES: usize = 2
            RECORDER_EVENTENCODING_EVENT_PAYLOAD_HASH_BYTES: usize = 8
            RECORDER_EVENTENCODING_ENCODED_BYTES: usize = EventEncoding::RECORDER_EVENTENCODING_SCHEMA_BYTES + EventEncoding::RECORDER_EVENTENCODING_ORDINAL_BYTES + EventEncoding::RECORDER_EVENTENCODING_ID_BYTES * 7 + EventEncoding::RECORDER_EVENTENCODING_MICROSTEP_BYTES + EventEncoding::RECORDER_EVENTENCODING_ENUM_BYTES * 2 + EventEncoding::RECORDER_EVENTENCODING_EVENT_PAYLOAD_HASH_BYTES
            POSITION_EVENT_OFFSET: usize = EventEncoding::RECORDER_EVENTENCODING_SCHEMA_BYTES + EventEncoding::RECORDER_EVENTENCODING_ORDINAL_BYTES + EventEncoding::RECORDER_EVENTENCODING_ID_BYTES * 3


    public:
        enum RecorderStatus:
            Recording
            Complete
            Partial
            Corrupt
            ResourceLimit

        struct TraceRecorder:
            manifest: mutable DebuggerTraceManifest::BundleManifest
            recording: mutable DebuggerIdentity::DebugId
            pending: mutable DebuggerEvents::EventEnvelope[Capacity::RECORDER_CAPACITY_EVENTS]
            pending_count: mutable usize
            chunks: mutable DebuggerTraceStorage::StoredChunk[Capacity::RECORDER_CAPACITY_CHUNKS]
            chunk_count: mutable usize
            next_ordinal: mutable u64
            status: mutable RecorderStatus
            last_error: mutable DebuggerErrors::DebuggerError
            exact: mutable bool

        def recorder_new(build: DebuggerIdentity::BuildIdentity, recording: DebuggerIdentity::DebugId) -> TraceRecorder:
            recorder: mutable TraceRecorder = zeroed
            recorder.manifest <- DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
            recorder.recording <- recording
            recorder.status <- RecorderStatus.Recording
            recorder.last_error <- DebuggerErrors::no_error()
            recorder.next_ordinal <- Identity::RECORDER_IDENTITY_NO_EVENT
            recorder.exact <- true
            return recorder

    private:
        def encode_event(event: DebuggerEvents::EventEnvelope) -> DebuggerTraceBinary::ByteWriter:
            writer: mutable DebuggerTraceBinary::ByteWriter = zeroed
            DebuggerTraceBinary::writer_initialize(writer)
            DebuggerTraceBinary::writer_put_u32(writer, event.schema)
            DebuggerTraceBinary::writer_put_u64(writer, event.ordinal)
            DebuggerTraceBinary::writer_put_u64(writer, event.task.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.recording.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.branch.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.event)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.task.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.invocation.value)
            DebuggerTraceBinary::writer_put_u64(writer, event.position.statement.value)
            DebuggerTraceBinary::writer_put_u32(writer, event.position.microstep)
            DebuggerTraceBinary::writer_put_u16(writer, event.kind.u16())
            DebuggerTraceBinary::writer_put_u16(writer, event.quality.u16())
            DebuggerTraceBinary::writer_put_u64(writer, event.payload_hash)
            return writer

        def recorder_event_is_valid(recorder: TraceRecorder, event: DebuggerEvents::EventEnvelope) -> bool:
            return event.schema == Version::EVENT_SCHEMA and recorder.recording.value != Identity::RECORDER_IDENTITY_NO_RECORDING and event.position.recording.value == recorder.recording.value and event.position.branch.value == Identity::RECORDER_IDENTITY_ROOT_BRANCH and event.task.value == event.position.task.value and event.position.event == event.ordinal and DebuggerEvents::event_kind_is_valid(event.kind) and DebuggerEvents::event_quality_is_valid(event.quality) and event.quality != DebuggerEvents::EventQuality.Corrupt

        def recorder_flush(recorder: mutable TraceRecorder&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::no_error() if recorder.pending_count == 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::RESOURCE_LIMIT) if recorder.pending_count > Capacity::RECORDER_CAPACITY_EVENTS
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::RESOURCE_LIMIT) if recorder.chunk_count >= Capacity::RECORDER_CAPACITY_CHUNKS
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::NON_MONOTONIC) if recorder.next_ordinal < recorder.pending_count.u64()
            pending_first: u64 = recorder.next_ordinal - recorder.pending_count.u64()
            for index in 0..<recorder.pending_count:
                event: DebuggerEvents::EventEnvelope = recorder.pending[index]
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::NON_MONOTONIC) if pending_first > Sequence::MAX_ORDINAL - index.u64() or event.ordinal != pending_first + index.u64()
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::RECORDING) if not recorder_event_is_valid(recorder, event)
            encoded: mutable DebuggerTraceBinary::ByteWriter = zeroed
            DebuggerTraceBinary::writer_initialize(encoded)
            for index in 0..<recorder.pending_count:
                event_bytes: DebuggerTraceBinary::ByteWriter = encode_event(recorder.pending[index])
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::RECORDER_DETAIL_ENCODING) if not DebuggerTraceBinary::writer_is_valid(event_bytes) or encoded.length + event_bytes.length > Capacity::RECORDER_CAPACITY_MAX_PAYLOAD_BYTES
                for byte_index in 0..<event_bytes.length:
                    DebuggerTraceBinary::writer_put_byte(encoded, event_bytes.bytes[byte_index])
            chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
            chunk.header <- DebuggerTrace::ChunkHeader{schema: Version::EVENT_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: recorder.chunk_count.u64() + Sequence::EVENT_OFFSET, first_event: recorder.pending[0].ordinal, last_event: recorder.pending[recorder.pending_count - 1].ordinal, payload_length: encoded.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(encoded)}
            chunk.payload_length <- encoded.length
            chunk.checksum <- DebuggerTraceBinary::writer_checksum(encoded)
            for index in 0..<encoded.length:
                chunk.payload[index] <- encoded.bytes[index]
            recorder.chunks[recorder.chunk_count] <- chunk
            recorder.chunk_count <- recorder.chunk_count + 1
            recorder.pending_count <- 0
            manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            manifest.last_event <- chunk.header.last_event
            recorder.manifest <- manifest
            return DebuggerErrors::no_error()

        def recorder_verified_next_event(recorder: mutable TraceRecorder&) -> u64:
            next_event: mutable u64 = Identity::RECORDER_IDENTITY_NO_EVENT
            for index in 0..<recorder.chunk_count:
                chunk: DebuggerTraceStorage::StoredChunk = recorder.chunks[index]
                continue if chunk.header.kind != DebuggerTrace::ChunkKind.Events
                return Sequence::MAX_ORDINAL if chunk.header.last_event == Sequence::MAX_ORDINAL
                verified_next: u64 = chunk.header.last_event + Sequence::EVENT_OFFSET
                next_event <- verified_next if verified_next > next_event
            return next_event

        def recorder_mark_resource_limit(recorder: mutable TraceRecorder&, failure: DebuggerErrors::DebuggerError) -> DebuggerErrors::DebuggerError:
            verified_next: u64 = recorder_verified_next_event(recorder)
            recorder.pending_count <- 0
            recorder.status <- RecorderStatus.ResourceLimit
            recorder.exact <- false
            manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            manifest.status <- DebuggerTraceManifest::ManifestStatus.Partial
            manifest.last_event <- verified_next - Sequence::EVENT_OFFSET if verified_next > Identity::RECORDER_IDENTITY_NO_EVENT
            manifest.last_event <- Identity::RECORDER_IDENTITY_NO_EVENT if verified_next == Identity::RECORDER_IDENTITY_NO_EVENT
            recorder.manifest <- manifest
            recorder.last_error <- failure
            return failure

        def recorder_mark_corrupt(recorder: mutable TraceRecorder&, failure: DebuggerErrors::DebuggerError) -> DebuggerErrors::DebuggerError:
            recorder.status <- RecorderStatus.Corrupt
            recorder.exact <- false
            manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
            recorder.manifest <- manifest
            recorder.last_error <- failure
            return failure

        def recorder_mark_flush_failure(recorder: mutable TraceRecorder&, failure: DebuggerErrors::DebuggerError) -> DebuggerErrors::DebuggerError:
            return recorder_mark_resource_limit(recorder, failure) if failure.code == DebuggerErrors::ErrorCode.ResourceLimit
            return recorder_mark_corrupt(recorder, failure)

        def recorder_mark_io_failure(recorder: mutable TraceRecorder&) -> void:
            recorder.status <- RecorderStatus.Partial
            recorder.exact <- false
            manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            manifest.status <- DebuggerTraceManifest::ManifestStatus.Partial
            recorder.manifest <- manifest
            recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Transport, true, Detail::RECORDING)

        def recorder_inactive_error(recorder: mutable TraceRecorder&) -> DebuggerErrors::DebuggerError:
            return recorder.last_error if not DebuggerErrors::error_is_ok(recorder.last_error)
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidState, false, Detail::RECORDING)

    public:
        def recorder_append(recorder: mutable TraceRecorder&, event: DebuggerEvents::EventEnvelope) -> DebuggerErrors::DebuggerError:
            return recorder_inactive_error(recorder) if recorder.status != RecorderStatus.Recording
            if not recorder_event_is_valid(recorder, event):
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                detail: u32 = Detail::RECORDING if recorder.recording.value == Identity::RECORDER_IDENTITY_NO_RECORDING else Detail::SCHEMA_MISMATCH if event.schema != Version::EVENT_SCHEMA else Detail::RECORDING if event.position.recording.value != recorder.recording.value else Detail::RECORDER_DETAIL_BRANCH if event.position.branch.value != Identity::RECORDER_IDENTITY_ROOT_BRANCH else Detail::RECORDER_DETAIL_TASK if event.task.value != event.position.task.value else Detail::NON_MONOTONIC if event.position.event != event.ordinal else Detail::RECORDER_DETAIL_ENUM
                recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, detail)
                return recorder.last_error
            if event.ordinal != recorder.next_ordinal:
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::NON_MONOTONIC)
                return recorder.last_error
            if event.ordinal == Sequence::MAX_ORDINAL:
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::NON_MONOTONIC)
                return recorder.last_error
            recorder.exact <- false if event.quality != DebuggerEvents::EventQuality.Exact
            partial_manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            partial_manifest.status <- DebuggerTraceManifest::ManifestStatus.Partial if event.quality != DebuggerEvents::EventQuality.Exact
            recorder.manifest <- partial_manifest
            if recorder.pending_count >= Capacity::RECORDER_CAPACITY_EVENTS:
                flushed: DebuggerErrors::DebuggerError = recorder_flush(recorder)
                if not DebuggerErrors::error_is_ok(flushed):
                    return recorder_mark_flush_failure(recorder, flushed)
            if recorder.chunk_count >= Capacity::RECORDER_CAPACITY_CHUNKS:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::RESOURCE_LIMIT)
                return recorder_mark_resource_limit(recorder, failure)
            recorder.pending[recorder.pending_count] <- event
            recorder.pending_count <- recorder.pending_count + 1
            recorder.next_ordinal <- recorder.next_ordinal + 1
            manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            manifest.last_event <- event.ordinal
            recorder.manifest <- manifest
            return DebuggerErrors::no_error()

        def recorder_finalize(recorder: mutable TraceRecorder&) -> DebuggerErrors::DebuggerError:
            return recorder.last_error if recorder.status == RecorderStatus.Corrupt or recorder.status == RecorderStatus.ResourceLimit or recorder.status == RecorderStatus.Partial
            flushed: DebuggerErrors::DebuggerError = recorder_flush(recorder)
            if not DebuggerErrors::error_is_ok(flushed):
                return recorder_mark_flush_failure(recorder, flushed)
            recorder.status <- RecorderStatus.Complete
            recorder.last_error <- DebuggerErrors::no_error()
            return DebuggerErrors::no_error()

        def recorder_append_checkpoint(recorder: mutable TraceRecorder&, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> DebuggerErrors::DebuggerError:
            return recorder_inactive_error(recorder) if recorder.status != RecorderStatus.Recording
            if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint) or checkpoint.recording.value != recorder.recording.value or checkpoint.branch.value != Identity::RECORDER_IDENTITY_ROOT_BRANCH or checkpoint.event > recorder.next_ordinal:
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                detail: u32 = Detail::RECORDER_DETAIL_BRANCH if checkpoint.branch.value != Identity::RECORDER_IDENTITY_ROOT_BRANCH else Detail::RECORDING
                recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, detail)
                return recorder.last_error
            flushed: DebuggerErrors::DebuggerError = recorder_flush(recorder)
            if not DebuggerErrors::error_is_ok(flushed):
                return recorder_mark_flush_failure(recorder, flushed)
            if recorder.chunk_count >= Capacity::RECORDER_CAPACITY_CHUNKS:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::RESOURCE_LIMIT)
                return recorder_mark_resource_limit(recorder, failure)
            if not DebuggerTraceStorage::storage_checkpoint_event_is_within_trace(checkpoint.event, recorder.manifest.first_event, recorder.manifest.last_event):
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::NON_MONOTONIC)
                return recorder.last_error
            encoded: mutable DebuggerTraceStorage::CheckpointChunkEncoding = zeroed
            DebuggerTraceStorage::storage_checkpoint_chunk_new(encoded, checkpoint, recorder.chunk_count.u64() + Sequence::EVENT_OFFSET)
            if encoded.status != DebuggerTraceStorage::StorageStatus.Ready:
                failure: DebuggerErrors::DebuggerError = DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, Detail::RECORDER_DETAIL_ENCODING) if encoded.status == DebuggerTraceStorage::StorageStatus.Oversized else DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::RECORDER_DETAIL_ENCODING)
                return recorder_mark_resource_limit(recorder, failure) if encoded.status == DebuggerTraceStorage::StorageStatus.Oversized
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                recorder.last_error <- failure
                return failure
            recorder.chunks[recorder.chunk_count] <- encoded.chunk
            recorder.chunk_count <- recorder.chunk_count + 1
            manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            manifest.checkpoint_count <- manifest.checkpoint_count + Sequence::CHECKPOINT_OFFSET
            recorder.manifest <- manifest
            return DebuggerErrors::no_error()

    private:
        def recorder_chunk_is_exact(chunk: DebuggerTraceStorage::StoredChunk, expected_first: u64, recording: DebuggerIdentity::DebugId) -> bool:
            return false if chunk.header.kind != DebuggerTrace::ChunkKind.Events or chunk.payload_length == 0 or chunk.payload_length % EventEncoding::RECORDER_EVENTENCODING_ENCODED_BYTES != 0
            event_count: usize = chunk.payload_length / EventEncoding::RECORDER_EVENTENCODING_ENCODED_BYTES
            return false if event_count == 0 or expected_first > Sequence::MAX_ORDINAL - (event_count - 1).u64()
            return false if chunk.header.first_event != expected_first or chunk.header.last_event != expected_first + (event_count - 1).u64()
            event_reader: mutable DebuggerTraceBinary::ByteReader = zeroed
            DebuggerTraceBinary::reader_initialize(event_reader, chunk.payload[0], chunk.payload_length)
            for index in 0..<event_count:
                schema: u32 = DebuggerTraceBinary::reader_take_u32(event_reader)
                ordinal: u64 = DebuggerTraceBinary::reader_take_u64(event_reader)
                task: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                event_recording: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                branch: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                position_event: u64 = DebuggerTraceBinary::reader_take_u64(event_reader)
                position_task: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                _ = DebuggerTraceBinary::reader_take_u64(event_reader)
                _ = DebuggerTraceBinary::reader_take_u64(event_reader)
                _ = DebuggerTraceBinary::reader_take_u32(event_reader)
                kind: u16 = DebuggerTraceBinary::reader_take_u16(event_reader)
                quality: u16 = DebuggerTraceBinary::reader_take_u16(event_reader)
                _ = DebuggerTraceBinary::reader_take_u64(event_reader)
                return false if schema != Version::EVENT_SCHEMA or ordinal != expected_first + index.u64() or position_event != ordinal or event_recording.value != recording.value or branch.value != Identity::RECORDER_IDENTITY_ROOT_BRANCH or task.value != position_task.value or kind > DebuggerEvents::EventKind.TraceHealth.u16() or quality != DebuggerEvents::EventQuality.Exact.u16()
            return DebuggerTraceBinary::reader_is_valid(event_reader) and event_reader.offset == event_reader.length

        def recorder_checkpoint_chunk_is_exact(chunk: DebuggerTraceStorage::StoredChunk, recording: DebuggerIdentity::DebugId, first_event: u64, last_event: u64) -> bool:
            return false if not DebuggerTraceStorage::storage_checkpoint_chunk_is_valid(chunk)
            return false if not DebuggerTraceStorage::storage_checkpoint_event_is_within_trace(chunk.header.first_event, first_event, last_event)
            decoded: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerTraceStorage::storage_checkpoint_chunk_decode(chunk)
            return decoded.status == DebuggerFullCheckpointCodec::DecodeStatus.Ready and decoded.checkpoint.recording.value == recording.value and decoded.checkpoint.branch.value == Identity::RECORDER_IDENTITY_ROOT_BRANCH

    public:
        def recorder_write(fd: int, recorder: mutable TraceRecorder&) -> DebuggerTraceStorage::StorageStatus can[Blocking.IO]:
            return DebuggerTraceStorage::StorageStatus.Invalid if recorder.status == RecorderStatus.Corrupt or recorder.recording.value == Identity::RECORDER_IDENTITY_NO_RECORDING
            return DebuggerTraceStorage::StorageStatus.Oversized if recorder.chunk_count > Capacity::RECORDER_CAPACITY_CHUNKS or recorder.pending_count > Capacity::RECORDER_CAPACITY_EVENTS
            return DebuggerTraceStorage::StorageStatus.Invalid if recorder.status == RecorderStatus.Partial
            if recorder.status != RecorderStatus.ResourceLimit:
                finalized: DebuggerErrors::DebuggerError = recorder_finalize(recorder)
                return DebuggerTraceStorage::StorageStatus.Invalid if not DebuggerErrors::error_is_ok(finalized) and recorder.status != RecorderStatus.ResourceLimit
            has_event_chunk: mutable bool = false
            for index in 0..<recorder.chunk_count:
                has_event_chunk <- true if recorder.chunks[index].header.kind == DebuggerTrace::ChunkKind.Events
            return DebuggerTraceStorage::StorageStatus.Invalid if not has_event_chunk
            manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(recorder.manifest)
            return DebuggerTraceStorage::StorageStatus.Oversized if not DebuggerTraceBinary::writer_is_valid(manifest_bytes)
            manifest_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
            manifest_chunk.header <- DebuggerTrace::ChunkHeader{schema: Version::EVENT_SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: Sequence::RECORDER_SEQUENCE_MANIFEST, first_event: recorder.manifest.first_event, last_event: recorder.manifest.last_event, payload_length: manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_bytes)}
            manifest_chunk.payload_length <- manifest_bytes.length
            manifest_chunk.checksum <- DebuggerTraceBinary::writer_checksum(manifest_bytes)
            for index in 0..<manifest_bytes.length:
                manifest_chunk.payload[index] <- manifest_bytes.bytes[index]
            manifest_result: DebuggerTraceStorage::StorageStatus = DebuggerTraceStorage::storage_write_chunk(fd, manifest_chunk) can Blocking.IO
            if manifest_result != DebuggerTraceStorage::StorageStatus.Ready:
                recorder_mark_io_failure(recorder)
                return manifest_result
            for index in 0..<recorder.chunk_count:
                result: DebuggerTraceStorage::StorageStatus = DebuggerTraceStorage::storage_write_chunk(fd, recorder.chunks[index]) can Blocking.IO
                if result != DebuggerTraceStorage::StorageStatus.Ready:
                    recorder_mark_io_failure(recorder)
                    return result
            manifest: DebuggerTraceManifest::BundleManifest = recorder.manifest
            footer_result: DebuggerTraceStorage::StorageStatus = DebuggerTraceStorage::storage_write_footer(fd, recorder.chunk_count.u64() + Sequence::EVENT_OFFSET, manifest.last_event) can Blocking.IO
            if footer_result != DebuggerTraceStorage::StorageStatus.Ready:
                recorder_mark_io_failure(recorder)
            return footer_result

        def recorder_is_exact(recorder: TraceRecorder) -> bool:
            return false if recorder.pending_count > Capacity::RECORDER_CAPACITY_EVENTS or recorder.chunk_count > Capacity::RECORDER_CAPACITY_CHUNKS
            return false if recorder.recording.value == Identity::RECORDER_IDENTITY_NO_RECORDING or not recorder.exact
            return false if recorder.next_ordinal == Identity::RECORDER_IDENTITY_NO_EVENT
            return false if not DebuggerErrors::error_is_ok(recorder.last_error)
            return false if not DebuggerTraceManifest::manifest_is_replayable(recorder.manifest)
            return false if recorder.manifest.first_event != Identity::RECORDER_IDENTITY_NO_EVENT or recorder.manifest.last_event != recorder.next_ordinal - Sequence::EVENT_OFFSET
            return false if recorder.status == RecorderStatus.Complete and recorder.pending_count != 0
            expected_event: mutable u64 = Identity::RECORDER_IDENTITY_NO_EVENT
            checkpoint_count: mutable u64 = 0
            for index in 0..<recorder.chunk_count:
                return false if recorder.chunks[index].header.sequence != index.u64() + Sequence::EVENT_OFFSET
                encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(recorder.chunks[index])
                return false if not DebuggerTraceBinary::writer_is_valid(encoded)
                if recorder.chunks[index].header.kind == DebuggerTrace::ChunkKind.Events:
                    return false if not recorder_chunk_is_exact(recorder.chunks[index], expected_event, recorder.recording)
                    event_count: u64 = (recorder.chunks[index].payload_length / EventEncoding::RECORDER_EVENTENCODING_ENCODED_BYTES).u64()
                    return false if event_count == 0 or expected_event > Sequence::MAX_ORDINAL - event_count
                    expected_event <- expected_event + event_count
                elif recorder.chunks[index].header.kind == DebuggerTrace::ChunkKind.Checkpoint:
                    return false if not recorder_checkpoint_chunk_is_exact(recorder.chunks[index], recorder.recording, recorder.manifest.first_event, recorder.manifest.last_event)
                    checkpoint_count <- checkpoint_count + Sequence::CHECKPOINT_OFFSET
                else:
                    return false
            return false if recorder.manifest.checkpoint_count != checkpoint_count
            return false if recorder.next_ordinal < recorder.pending_count.u64()
            pending_first: u64 = recorder.next_ordinal - recorder.pending_count.u64()
            return false if pending_first != expected_event
            for index in 0..<recorder.pending_count:
                event: DebuggerEvents::EventEnvelope = recorder.pending[index]
                return false if event.schema != Version::EVENT_SCHEMA or event.ordinal != pending_first + index.u64() or event.position.event != event.ordinal or event.position.recording.value != recorder.recording.value or event.task.value != event.position.task.value or not DebuggerEvents::event_kind_is_valid(event.kind) or event.quality != DebuggerEvents::EventQuality.Exact
            return recorder.status == RecorderStatus.Recording or recorder.status == RecorderStatus.Complete

        def recorder_chunk_count(recorder: TraceRecorder) -> usize:
            return recorder.chunk_count
