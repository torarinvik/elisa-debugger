# Exact event recorder.  Events are accumulated in bounded Elisa storage,
# encoded canonically, checksummed, and committed as immutable chunks.  A full
# buffer ends exact recording with a verified prefix instead of dropping events.

include "./binary.elisa"
include "./format.elisa"
include "./storage.elisa"
include "./manifest.elisa"
include "../core/events.elisa"
include "../core/identity.elisa"
include "../core/errors.elisa"

module DebuggerTraceRecorder:
    private:
        const RECORDER_EVENT_CAPACITY: usize = 16
        const RECORDER_CHUNK_CAPACITY: usize = 8
        const RECORDER_PAYLOAD_CAPACITY: usize = 4048
        const RECORDER_SCHEMA_VERSION: u32 = 1
        const RECORDER_MANIFEST_SEQUENCE: u64 = 0
        const RECORDER_EVENT_SEQUENCE_OFFSET: u64 = 1
        const RECORDER_DETAIL_NON_MONOTONIC: u32 = 1
        const RECORDER_DETAIL_RESOURCE_LIMIT: u32 = 2
        const RECORDER_DETAIL_ENCODING: u32 = 3
        const RECORDER_DETAIL_SCHEMA: u32 = 4
        const RECORDER_DETAIL_RECORDING: u32 = 5
        const RECORDER_DETAIL_TASK: u32 = 6
        const RECORDER_DETAIL_ENUM: u32 = 7
        const RECORDER_NO_EVENT: u64 = 0
        const RECORDER_NO_RECORDING: u64 = 0
        const RECORDER_MAX_ORDINAL: u64 = 18446744073709551615
        const RECORDER_EVENT_SCHEMA_BYTES: usize = 4
        const RECORDER_EVENT_ORDINAL_BYTES: usize = 8
        const RECORDER_EVENT_ID_BYTES: usize = 8
        const RECORDER_EVENT_MICROSTEP_BYTES: usize = 4
        const RECORDER_EVENT_ENUM_BYTES: usize = 2
        const RECORDER_EVENT_PAYLOAD_BYTES: usize = 8
        const RECORDER_EVENT_ENCODED_BYTES: usize = RECORDER_EVENT_SCHEMA_BYTES + RECORDER_EVENT_ORDINAL_BYTES + RECORDER_EVENT_ID_BYTES * 7 + RECORDER_EVENT_MICROSTEP_BYTES + RECORDER_EVENT_ENUM_BYTES * 2 + RECORDER_EVENT_PAYLOAD_BYTES
        const RECORDER_EVENT_POSITION_EVENT_OFFSET: usize = RECORDER_EVENT_SCHEMA_BYTES + RECORDER_EVENT_ORDINAL_BYTES + RECORDER_EVENT_ID_BYTES * 3

    public:
        enum RecorderStatus:
            Recording
            Complete
            Partial
            Corrupt
            ResourceLimit

        struct TraceRecorder:
            manifest: mutable DebuggerTraceManifest::BundleManifest
            recording: mutable DebuggerIdentity::DebugId
            pending: mutable DebuggerEvents::EventEnvelope[RECORDER_EVENT_CAPACITY]
            pending_count: mutable usize
            chunks: mutable DebuggerTraceStorage::StoredChunk[RECORDER_CHUNK_CAPACITY]
            chunk_count: mutable usize
            next_ordinal: mutable u64
            status: mutable RecorderStatus
            last_error: mutable DebuggerErrors::DebuggerError
            exact: mutable bool

        def recorder_new(build: DebuggerIdentity::BuildIdentity, recording: DebuggerIdentity::DebugId) -> TraceRecorder:
            recorder: mutable TraceRecorder = zeroed
            recorder.manifest <- DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
            recorder.recording <- recording
            recorder.status <- RecorderStatus.Recording
            recorder.last_error <- DebuggerErrors::no_error()
            recorder.next_ordinal <- RECORDER_NO_EVENT
            recorder.exact <- true
            return recorder

        def encode_event(event: DebuggerEvents::EventEnvelope) -> DebuggerTraceBinary::ByteWriter:
            writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
            writer <- DebuggerTraceBinary::writer_put_u32(writer, event.schema)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.ordinal)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.task.value)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.position.recording.value)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.position.branch.value)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.position.event)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.position.task.value)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.position.invocation.value)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.position.statement.value)
            writer <- DebuggerTraceBinary::writer_put_u32(writer, event.position.microstep)
            writer <- DebuggerTraceBinary::writer_put_u16(writer, event.kind.u16())
            writer <- DebuggerTraceBinary::writer_put_u16(writer, event.quality.u16())
            writer <- DebuggerTraceBinary::writer_put_u64(writer, event.payload_hash)
            return writer

        def recorder_event_is_valid(recorder: TraceRecorder, event: DebuggerEvents::EventEnvelope) -> bool:
            return event.schema == RECORDER_SCHEMA_VERSION and recorder.recording.value != RECORDER_NO_RECORDING and event.position.recording.value == recorder.recording.value and event.task.value == event.position.task.value and event.position.event == event.ordinal and DebuggerEvents::event_kind_is_valid(event.kind) and DebuggerEvents::event_quality_is_valid(event.quality)

        def recorder_flush(recorder: mutable TraceRecorder&) -> DebuggerErrors::DebuggerError:
            return DebuggerErrors::no_error() if recorder.pending_count == 0
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, RECORDER_DETAIL_RESOURCE_LIMIT) if recorder.pending_count > RECORDER_EVENT_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, RECORDER_DETAIL_RESOURCE_LIMIT) if recorder.chunk_count >= RECORDER_CHUNK_CAPACITY
            return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, RECORDER_DETAIL_NON_MONOTONIC) if recorder.next_ordinal < recorder.pending_count.u64()
            pending_first: u64 = recorder.next_ordinal - recorder.pending_count.u64()
            for index in 0..<recorder.pending_count:
                event: DebuggerEvents::EventEnvelope = recorder.pending[index]
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, RECORDER_DETAIL_NON_MONOTONIC) if pending_first > RECORDER_MAX_ORDINAL - index.u64() or event.ordinal != pending_first + index.u64()
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, RECORDER_DETAIL_RECORDING) if not recorder_event_is_valid(recorder, event)
            encoded: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
            for index in 0..<recorder.pending_count:
                event_bytes: DebuggerTraceBinary::ByteWriter = encode_event(recorder.pending[index])
                return DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, RECORDER_DETAIL_ENCODING) if not DebuggerTraceBinary::writer_is_valid(event_bytes) or encoded.length + event_bytes.length > RECORDER_PAYLOAD_CAPACITY
                for byte_index in 0..<event_bytes.length:
                    encoded <- DebuggerTraceBinary::writer_put_byte(encoded, event_bytes.bytes[byte_index])
            chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
            chunk.header <- DebuggerTrace::ChunkHeader{schema: RECORDER_SCHEMA_VERSION, kind: DebuggerTrace::ChunkKind.Events, sequence: recorder.chunk_count.u64() + RECORDER_EVENT_SEQUENCE_OFFSET, first_event: recorder.pending[0].ordinal, last_event: recorder.pending[recorder.pending_count - 1].ordinal, payload_length: encoded.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(encoded)}
            chunk.payload_length <- encoded.length
            chunk.checksum <- DebuggerTraceBinary::writer_checksum(encoded)
            for index in 0..<encoded.length:
                chunk.payload[index] <- encoded.bytes[index]
            recorder.chunks[recorder.chunk_count] <- chunk
            recorder.chunk_count <- recorder.chunk_count + 1
            recorder.pending_count <- 0
            manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            manifest.last_event <- chunk.header.last_event
            manifest.checkpoint_count <- recorder.chunk_count.u64()
            recorder.manifest <- manifest
            return DebuggerErrors::no_error()

        def recorder_append(recorder: mutable TraceRecorder&, event: DebuggerEvents::EventEnvelope) -> DebuggerErrors::DebuggerError:
            return recorder.last_error if recorder.status != RecorderStatus.Recording
            if not recorder_event_is_valid(recorder, event):
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                detail: u32 = RECORDER_DETAIL_RECORDING if recorder.recording.value == RECORDER_NO_RECORDING else RECORDER_DETAIL_SCHEMA if event.schema != RECORDER_SCHEMA_VERSION else RECORDER_DETAIL_RECORDING if event.position.recording.value != recorder.recording.value else RECORDER_DETAIL_TASK if event.task.value != event.position.task.value else RECORDER_DETAIL_NON_MONOTONIC if event.position.event != event.ordinal else RECORDER_DETAIL_ENUM
                recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, detail)
                return recorder.last_error
            if event.ordinal != recorder.next_ordinal:
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, RECORDER_DETAIL_NON_MONOTONIC)
                return recorder.last_error
            if event.ordinal == RECORDER_MAX_ORDINAL:
                recorder.status <- RecorderStatus.Corrupt
                manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                manifest.status <- DebuggerTraceManifest::ManifestStatus.Corrupt
                recorder.manifest <- manifest
                recorder.last_error <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, RECORDER_DETAIL_NON_MONOTONIC)
                return recorder.last_error
            recorder.exact <- false if event.quality != DebuggerEvents::EventQuality.Exact
            partial_manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            partial_manifest.status <- DebuggerTraceManifest::ManifestStatus.Partial if event.quality != DebuggerEvents::EventQuality.Exact
            recorder.manifest <- partial_manifest
            if recorder.pending_count >= RECORDER_EVENT_CAPACITY:
                flushed: DebuggerErrors::DebuggerError = recorder_flush(recorder)
                if not DebuggerErrors::error_is_ok(flushed):
                    recorder.status <- RecorderStatus.ResourceLimit
                    manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
                    manifest.status <- DebuggerTraceManifest::ManifestStatus.Partial
                    recorder.manifest <- manifest
                    recorder.last_error <- flushed
                    return flushed
            recorder.pending[recorder.pending_count] <- event
            recorder.pending_count <- recorder.pending_count + 1
            recorder.next_ordinal <- recorder.next_ordinal + 1
            manifest: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
            manifest.last_event <- event.ordinal
            recorder.manifest <- manifest
            return DebuggerErrors::no_error()

        def recorder_finalize(recorder: mutable TraceRecorder&) -> DebuggerErrors::DebuggerError:
            return recorder.last_error if recorder.status == RecorderStatus.Corrupt or recorder.status == RecorderStatus.ResourceLimit or recorder.status == RecorderStatus.Partial
            flushed: DebuggerErrors::DebuggerError = recorder_flush(recorder)
            if not DebuggerErrors::error_is_ok(flushed):
                recorder.status <- RecorderStatus.Partial
                recorder.last_error <- flushed
                return flushed
            recorder.status <- RecorderStatus.Complete
            recorder.last_error <- DebuggerErrors::no_error()
            return DebuggerErrors::no_error()

        def recorder_chunk_is_exact(chunk: DebuggerTraceStorage::StoredChunk, expected_first: u64, recording: DebuggerIdentity::DebugId) -> bool:
            return false if chunk.header.kind != DebuggerTrace::ChunkKind.Events or chunk.payload_length == 0 or chunk.payload_length % RECORDER_EVENT_ENCODED_BYTES != 0
            event_count: usize = chunk.payload_length / RECORDER_EVENT_ENCODED_BYTES
            return false if event_count == 0 or expected_first > RECORDER_MAX_ORDINAL - (event_count - 1).u64()
            return false if chunk.header.first_event != expected_first or chunk.header.last_event != expected_first + (event_count - 1).u64()
            event_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(chunk.payload[0], chunk.payload_length)
            for index in 0..<event_count:
                schema: u32 = DebuggerTraceBinary::reader_take_u32(event_reader)
                ordinal: u64 = DebuggerTraceBinary::reader_take_u64(event_reader)
                task: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                event_recording: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                _ = DebuggerTraceBinary::reader_take_u64(event_reader)
                position_event: u64 = DebuggerTraceBinary::reader_take_u64(event_reader)
                position_task: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(event_reader))
                _ = DebuggerTraceBinary::reader_take_u64(event_reader)
                _ = DebuggerTraceBinary::reader_take_u64(event_reader)
                _ = DebuggerTraceBinary::reader_take_u32(event_reader)
                kind: u16 = DebuggerTraceBinary::reader_take_u16(event_reader)
                quality: u16 = DebuggerTraceBinary::reader_take_u16(event_reader)
                _ = DebuggerTraceBinary::reader_take_u64(event_reader)
                return false if schema != RECORDER_SCHEMA_VERSION or ordinal != expected_first + index.u64() or position_event != ordinal or event_recording.value != recording.value or task.value != position_task.value or kind > DebuggerEvents::EventKind.TraceHealth.u16() or quality != DebuggerEvents::EventQuality.Exact.u16()
            return DebuggerTraceBinary::reader_is_valid(event_reader) and event_reader.offset == event_reader.length

        def recorder_write(fd: int, recorder: mutable TraceRecorder&) -> DebuggerTraceStorage::StorageStatus can[Blocking.IO]:
            return DebuggerTraceStorage::StorageStatus.Invalid if recorder.status == RecorderStatus.Corrupt or recorder.recording.value == RECORDER_NO_RECORDING
            return DebuggerTraceStorage::StorageStatus.Oversized if recorder.chunk_count > RECORDER_CHUNK_CAPACITY or recorder.pending_count > RECORDER_EVENT_CAPACITY
            finalized: DebuggerErrors::DebuggerError = recorder_finalize(recorder)
            return DebuggerTraceStorage::StorageStatus.Invalid if not DebuggerErrors::error_is_ok(finalized)
            manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(recorder.manifest)
            return DebuggerTraceStorage::StorageStatus.Oversized if not DebuggerTraceBinary::writer_is_valid(manifest_bytes)
            manifest_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
            manifest_chunk.header <- DebuggerTrace::ChunkHeader{schema: RECORDER_SCHEMA_VERSION, kind: DebuggerTrace::ChunkKind.Manifest, sequence: RECORDER_MANIFEST_SEQUENCE, first_event: recorder.manifest.first_event, last_event: recorder.manifest.last_event, payload_length: manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_bytes)}
            manifest_chunk.payload_length <- manifest_bytes.length
            manifest_chunk.checksum <- DebuggerTraceBinary::writer_checksum(manifest_bytes)
            for index in 0..<manifest_bytes.length:
                manifest_chunk.payload[index] <- manifest_bytes.bytes[index]
            manifest_result: DebuggerTraceStorage::StorageStatus = DebuggerTraceStorage::storage_write_chunk(fd, manifest_chunk) can Blocking.IO
            if manifest_result != DebuggerTraceStorage::StorageStatus.Ready:
                recorder.status <- RecorderStatus.Partial
                recorder.exact <- false
                return manifest_result
            for index in 0..<recorder.chunk_count:
                result: DebuggerTraceStorage::StorageStatus = DebuggerTraceStorage::storage_write_chunk(fd, recorder.chunks[index]) can Blocking.IO
                if result != DebuggerTraceStorage::StorageStatus.Ready:
                    recorder.status <- RecorderStatus.Partial
                    recorder.exact <- false
                    return result
            manifest: DebuggerTraceManifest::BundleManifest = recorder.manifest
            footer_result: DebuggerTraceStorage::StorageStatus = DebuggerTraceStorage::storage_write_footer(fd, recorder.chunk_count.u64() + RECORDER_EVENT_SEQUENCE_OFFSET, manifest.last_event) can Blocking.IO
            if footer_result != DebuggerTraceStorage::StorageStatus.Ready:
                recorder.status <- RecorderStatus.Partial
                recorder.exact <- false
            return footer_result

        def recorder_is_exact(recorder: TraceRecorder) -> bool:
            return false if recorder.pending_count > RECORDER_EVENT_CAPACITY or recorder.chunk_count > RECORDER_CHUNK_CAPACITY
            return false if recorder.recording.value == RECORDER_NO_RECORDING or not recorder.exact
            return false if recorder.next_ordinal == RECORDER_NO_EVENT
            return false if not DebuggerErrors::error_is_ok(recorder.last_error)
            return false if not DebuggerTraceManifest::manifest_is_replayable(recorder.manifest)
            return false if recorder.manifest.first_event != RECORDER_NO_EVENT or recorder.manifest.last_event != recorder.next_ordinal - RECORDER_EVENT_SEQUENCE_OFFSET or recorder.manifest.checkpoint_count != recorder.chunk_count.u64()
            return false if recorder.status == RecorderStatus.Complete and recorder.pending_count != 0
            expected_event: mutable u64 = RECORDER_NO_EVENT
            for index in 0..<recorder.chunk_count:
                return false if recorder.chunks[index].header.sequence != index.u64() + RECORDER_EVENT_SEQUENCE_OFFSET
                encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(recorder.chunks[index])
                return false if not DebuggerTraceBinary::writer_is_valid(encoded)
                return false if not recorder_chunk_is_exact(recorder.chunks[index], expected_event, recorder.recording)
                event_count: u64 = (recorder.chunks[index].payload_length / RECORDER_EVENT_ENCODED_BYTES).u64()
                return false if event_count == 0 or expected_event > RECORDER_MAX_ORDINAL - event_count
                expected_event <- expected_event + event_count
            return false if recorder.next_ordinal < recorder.pending_count.u64()
            pending_first: u64 = recorder.next_ordinal - recorder.pending_count.u64()
            return false if pending_first != expected_event
            for index in 0..<recorder.pending_count:
                event: DebuggerEvents::EventEnvelope = recorder.pending[index]
                return false if event.schema != RECORDER_SCHEMA_VERSION or event.ordinal != pending_first + index.u64() or event.position.event != event.ordinal or event.position.recording.value != recorder.recording.value or event.task.value != event.position.task.value or not DebuggerEvents::event_kind_is_valid(event.kind) or event.quality != DebuggerEvents::EventQuality.Exact
            return recorder.status == RecorderStatus.Recording or recorder.status == RecorderStatus.Complete

        def recorder_chunk_count(recorder: TraceRecorder) -> usize:
            return recorder.chunk_count
