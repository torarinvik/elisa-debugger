# Retention bookkeeping protects checkpoint and branch dependency closures.
# Collection only marks unpinned, unreferenced chunks; a caller can then delete
# them atomically from its durable store.

include "../core/errors.elisa"

module DebuggerTraceRetention:
    private:
        const module Detail:
            TRACE_RETENTION_DETAIL_CAPACITY: u32 = 1
            REFERENCE: u32 = 2
            PIN: u32 = 3

        const module Retention:
            TRACE_RETENTION_CHUNK_CAPACITY: usize = 128
            PIN_CAPACITY: usize = 64
            MAX_REFCOUNT: u64 = 18446744073709551615
            EMPTY_COUNT: usize = 0
            NO_SEQUENCE: u64 = 0
            NO_REFERENCE_COUNT: u64 = 0
            COUNT_STEP: usize = 1
            REFERENCE_STEP: u64 = 1
            INITIAL_INCOMPLETE: bool = false
            INITIAL_COMPLETE: bool = true
            INITIAL_LIVE: bool = true
            INITIAL_PINNED: bool = false


        def collection_plan_contains(plan: CollectionPlan&, sequence: u64) -> bool:
            for index in Retention::EMPTY_COUNT..<plan.count:
                return true if plan.sequences[index] == sequence
            return false

    public:
        struct ChunkReference:
            sequence: mutable u64
            parent: mutable u64
            references: mutable u64
            pinned: mutable bool
            live: mutable bool

        struct RetentionStore:
            chunks: mutable ChunkReference[Retention::TRACE_RETENTION_CHUNK_CAPACITY]
            count: mutable usize
            pins: mutable u64[Retention::PIN_CAPACITY]
            pin_count: mutable usize
            last_error: mutable DebuggerErrors::DebuggerError

        struct CollectionPlan:
            sequences: mutable u64[Retention::TRACE_RETENTION_CHUNK_CAPACITY]
            count: mutable usize
            complete: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def retention_initialize(store: mutable RetentionStore&) -> void:
            store.count <- Retention::EMPTY_COUNT
            store.pin_count <- Retention::EMPTY_COUNT
            store.last_error <- DebuggerErrors::no_error()

        def retention_find(store: RetentionStore&, sequence: u64) -> usize:
            return Retention::TRACE_RETENTION_CHUNK_CAPACITY if store.count > Retention::TRACE_RETENTION_CHUNK_CAPACITY
            for index in Retention::EMPTY_COUNT..<store.count:
                return index if store.chunks[index].sequence == sequence
            return Retention::TRACE_RETENTION_CHUNK_CAPACITY

        def retention_add_chunk(store: mutable RetentionStore&, sequence: u64, parent: u64) -> bool:
            return false if store.count >= Retention::TRACE_RETENTION_CHUNK_CAPACITY or sequence == Retention::NO_SEQUENCE or (parent != Retention::NO_SEQUENCE and retention_find(store, parent) >= Retention::TRACE_RETENTION_CHUNK_CAPACITY)
            return false if parent != Retention::NO_SEQUENCE and not retention_chain_is_valid(store, parent)
            for index in Retention::EMPTY_COUNT..<store.count:
                return false if store.chunks[index].sequence == sequence
            store.chunks[store.count] <- ChunkReference{sequence: sequence, parent: parent, references: Retention::NO_REFERENCE_COUNT, pinned: Retention::INITIAL_PINNED, live: Retention::INITIAL_LIVE}
            store.count <- store.count + Retention::COUNT_STEP
            return true

        def retention_chain_is_valid(store: RetentionStore&, sequence: u64) -> bool:
            current: mutable u64 = sequence
            steps: mutable usize = Retention::EMPTY_COUNT
            while current != Retention::NO_SEQUENCE:
                index: usize = retention_find(store, current)
                return false if index >= Retention::TRACE_RETENTION_CHUNK_CAPACITY
                return false if not store.chunks[index].live
                steps <- steps + Retention::COUNT_STEP
                return false if steps > store.count
                current <- store.chunks[index].parent
            return true

        def retention_adjust_chain(store: mutable RetentionStore&, sequence: u64, increase: bool) -> bool:
            return false if sequence == Retention::NO_SEQUENCE or not retention_chain_is_valid(store, sequence)
            current: mutable u64 = sequence
            while current != Retention::NO_SEQUENCE:
                index: usize = retention_find(store, current)
                return false if index >= Retention::TRACE_RETENTION_CHUNK_CAPACITY or not store.chunks[index].live
                return false if increase and store.chunks[index].references == Retention::MAX_REFCOUNT
                return false if not increase and store.chunks[index].references == Retention::NO_REFERENCE_COUNT
                current <- store.chunks[index].parent
            current <- sequence
            while current != Retention::NO_SEQUENCE:
                index: usize = retention_find(store, current)
                if increase:
                    store.chunks[index].references <- store.chunks[index].references + Retention::REFERENCE_STEP
                else:
                    store.chunks[index].references <- store.chunks[index].references - Retention::REFERENCE_STEP
                current <- store.chunks[index].parent
            return true

        def retention_add_reference(store: mutable RetentionStore&, sequence: u64) -> bool:
            return retention_adjust_chain(store, sequence, true)

        def retention_remove_reference(store: mutable RetentionStore&, sequence: u64) -> bool:
            return retention_adjust_chain(store, sequence, false)

        def retention_pin(store: mutable RetentionStore&, sequence: u64) -> bool:
            index: usize = retention_find(store, sequence)
            return false if store.count > Retention::TRACE_RETENTION_CHUNK_CAPACITY or store.pin_count >= Retention::PIN_CAPACITY or index >= Retention::TRACE_RETENTION_CHUNK_CAPACITY
            for pin in Retention::EMPTY_COUNT..<store.pin_count:
                return false if store.pins[pin] == sequence
            return false if store.chunks[index].pinned or not retention_adjust_chain(store, sequence, true)
            store.chunks[index].pinned <- not Retention::INITIAL_PINNED
            store.pins[store.pin_count] <- sequence
            store.pin_count <- store.pin_count + Retention::COUNT_STEP
            return true

        def retention_unpin(store: mutable RetentionStore&, sequence: u64) -> bool:
            return false if store.count > Retention::TRACE_RETENTION_CHUNK_CAPACITY or store.pin_count > Retention::PIN_CAPACITY
            index: usize = retention_find(store, sequence)
            return false if index >= Retention::TRACE_RETENTION_CHUNK_CAPACITY or not store.chunks[index].pinned
            found: mutable bool = false
            for pin in Retention::EMPTY_COUNT..<store.pin_count:
                found <- true if store.pins[pin] == sequence
            return false if not found or not retention_adjust_chain(store, sequence, false)
            store.chunks[index].pinned <- Retention::INITIAL_PINNED
            for pin in Retention::EMPTY_COUNT..<store.pin_count:
                if store.pins[pin] == sequence:
                    store.pins[pin] <- store.pins[store.pin_count - Retention::COUNT_STEP]
                    store.pin_count <- store.pin_count - Retention::COUNT_STEP
                    break
            return true

        def retention_plan_collection(store: RetentionStore&) -> CollectionPlan:
            plan: mutable CollectionPlan = zeroed
            plan.complete <- Retention::INITIAL_COMPLETE
            return CollectionPlan{sequences: plan.sequences, count: Retention::EMPTY_COUNT, complete: Retention::INITIAL_INCOMPLETE, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, Detail::TRACE_RETENTION_DETAIL_CAPACITY)} if store.count > Retention::TRACE_RETENTION_CHUNK_CAPACITY or store.pin_count > Retention::PIN_CAPACITY
            for index in Retention::EMPTY_COUNT..<store.count:
                chunk: ChunkReference = store.chunks[index]
                continue if not chunk.live or chunk.pinned or chunk.references != Retention::NO_REFERENCE_COUNT
                return CollectionPlan{sequences: plan.sequences, count: plan.count, complete: Retention::INITIAL_INCOMPLETE, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, true, Detail::TRACE_RETENTION_DETAIL_CAPACITY)} if plan.count >= Retention::TRACE_RETENTION_CHUNK_CAPACITY
                plan.sequences[plan.count] <- chunk.sequence
                plan.count <- plan.count + Retention::COUNT_STEP
            return plan

        def retention_apply_collection(store: mutable RetentionStore&, plan: CollectionPlan&) -> bool:
            return false if store.count > Retention::TRACE_RETENTION_CHUNK_CAPACITY or store.pin_count > Retention::PIN_CAPACITY
            return false if not plan.complete or plan.count > Retention::TRACE_RETENTION_CHUNK_CAPACITY
            collectible: mutable bool[Retention::TRACE_RETENTION_CHUNK_CAPACITY] = zeroed
            for index in Retention::EMPTY_COUNT..<store.count:
                chunk: ChunkReference = store.chunks[index]
                collectible[index] <- true if collection_plan_contains(plan, chunk.sequence) and chunk.live and not chunk.pinned and chunk.references == Retention::NO_REFERENCE_COUNT
            # A plan is a snapshot. Recheck both direct dependencies and
            # retention counts when applying it so a child added after planning
            # cannot be left pointing at a collected parent. Pruning until
            # stable also keeps ancestors live when a planned child became
            # pinned or referenced after the snapshot.
            for iteration in Retention::EMPTY_COUNT..<Retention::TRACE_RETENTION_CHUNK_CAPACITY:
                changed: mutable bool = false
                for candidate in Retention::EMPTY_COUNT..<store.count:
                    continue if not collectible[candidate]
                    sequence: u64 = store.chunks[candidate].sequence
                    for child in Retention::EMPTY_COUNT..<store.count:
                        if store.chunks[child].live and store.chunks[child].parent == sequence and not collectible[child]:
                            collectible[candidate] <- false
                            changed <- true
                            break
                break if not changed
            for index in Retention::EMPTY_COUNT..<store.count:
                store.chunks[index].live <- not Retention::INITIAL_LIVE if collectible[index]
            return true
