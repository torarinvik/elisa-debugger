# Lossless trace stream primitives.  The durable writer stores complete
# chunks, validates checksums, and reports the last verified prefix after a
# torn write or corruption.

include "./format.elisa"

module DebuggerTraceStream:
    private:
        const TRACE_CHUNK_CAPACITY: usize = 8
        const TRACE_MAX_PAYLOAD: usize = 512
        const TRACE_FIRST_SEQUENCE: u64 = 0
        const TRACE_SEQUENCE_INCREMENT: u64 = 1
        const TRACE_MAX_SEQUENCE: u64 = 18446744073709551615
        const TRACE_HASH_OFFSET_BASIS: u64 = 1469598103934665603
        const TRACE_HASH_PRIME: u64 = 1099511628211

    public:
        enum TraceReadStatus:
            Empty
            Complete
            Truncated
            Corrupt
            ResourceLimit

        struct TraceChunk:
            header: mutable DebuggerTrace::ChunkHeader
            payload: mutable u8[TRACE_MAX_PAYLOAD]
            payload_received: mutable usize
            checksum: mutable u64
            complete: mutable bool

        struct TraceStream:
            chunks: mutable TraceChunk[TRACE_CHUNK_CAPACITY]
            chunk_count: mutable usize
            next_sequence: mutable u64
            verified_event: mutable u64
            status: mutable TraceReadStatus

        def trace_stream_new() -> TraceStream:
            stream: TraceStream = zeroed
            stream.next_sequence <- TRACE_FIRST_SEQUENCE
            stream.status <- TraceReadStatus.Empty
            return stream

        def trace_stream_begin(stream: TraceStream, header: DebuggerTrace::ChunkHeader) -> TraceStream:
            updated: mutable TraceStream = stream
            return updated if stream.status == TraceReadStatus.Corrupt or stream.status == TraceReadStatus.ResourceLimit
            if stream.chunk_count >= TRACE_CHUNK_CAPACITY or header.payload_length > TRACE_MAX_PAYLOAD.u64():
                updated.status <- TraceReadStatus.ResourceLimit
                return updated
            if header.kind == DebuggerTrace::ChunkKind.Events and header.payload_length == 0:
                updated.status <- TraceReadStatus.Corrupt
                return updated
            if header.sequence != stream.next_sequence:
                updated.status <- TraceReadStatus.Corrupt
                return updated
            if header.sequence == TRACE_MAX_SEQUENCE:
                updated.status <- TraceReadStatus.ResourceLimit
                return updated
            if stream.status == TraceReadStatus.Truncated or not DebuggerTrace::trace_chunk_range_valid(header):
                updated.status <- TraceReadStatus.Corrupt
                return updated
            updated.chunks[stream.chunk_count].header <- header
            updated.chunks[stream.chunk_count].payload_received <- 0
            updated.chunks[stream.chunk_count].checksum <- TRACE_HASH_OFFSET_BASIS
            updated.chunks[stream.chunk_count].complete <- header.payload_length == 0
            if header.payload_length == 0:
                updated.chunk_count <- updated.chunk_count + 1
                updated.next_sequence <- stream.next_sequence + TRACE_SEQUENCE_INCREMENT
                updated.verified_event <- header.last_event if header.checksum == TRACE_HASH_OFFSET_BASIS
                updated.status <- TraceReadStatus.Complete if header.checksum == TRACE_HASH_OFFSET_BASIS else TraceReadStatus.Corrupt
                return updated
            updated.status <- TraceReadStatus.Truncated
            return updated

        def trace_stream_append(stream: TraceStream, byte: u8) -> TraceStream:
            updated: mutable TraceStream = stream
            return updated if stream.status != TraceReadStatus.Truncated
            return updated if stream.chunk_count >= TRACE_CHUNK_CAPACITY
            index: usize = stream.chunk_count
            chunk: mutable TraceChunk = stream.chunks[index]
            return updated if chunk.payload_received >= TRACE_MAX_PAYLOAD
            chunk.payload[chunk.payload_received] <- byte
            chunk.checksum <- (chunk.checksum ^ byte.u64()) * TRACE_HASH_PRIME
            chunk.payload_received <- chunk.payload_received + 1
            updated.chunks[index] <- chunk
            if chunk.payload_received == chunk.header.payload_length.usize():
                chunk.complete <- true
                updated.chunks[index] <- chunk
                updated.chunk_count <- updated.chunk_count + 1
                if stream.next_sequence == TRACE_MAX_SEQUENCE:
                    updated.status <- TraceReadStatus.ResourceLimit
                    return updated
                updated.next_sequence <- stream.next_sequence + TRACE_SEQUENCE_INCREMENT
                updated.verified_event <- chunk.header.last_event if chunk.checksum == chunk.header.checksum
                updated.status <- TraceReadStatus.Complete if chunk.checksum == chunk.header.checksum else TraceReadStatus.Corrupt
            return updated

        def trace_stream_verify(stream: TraceStream) -> TraceReadStatus:
            return TraceReadStatus.ResourceLimit if stream.chunk_count > TRACE_CHUNK_CAPACITY
            return stream.status if stream.status == TraceReadStatus.Truncated or stream.status == TraceReadStatus.Corrupt or stream.status == TraceReadStatus.ResourceLimit
            return TraceReadStatus.Empty if stream.chunk_count == 0
            return TraceReadStatus.Corrupt if stream.status == TraceReadStatus.Empty
            for index in 0..<stream.chunk_count:
                chunk: TraceChunk = stream.chunks[index]
                return TraceReadStatus.ResourceLimit if chunk.header.payload_length > TRACE_MAX_PAYLOAD.u64() or chunk.payload_received > TRACE_MAX_PAYLOAD
                return TraceReadStatus.Corrupt if chunk.header.sequence != TRACE_FIRST_SEQUENCE + index.u64()
                return TraceReadStatus.Corrupt if chunk.payload_received > chunk.header.payload_length.usize()
                return TraceReadStatus.Truncated if not chunk.complete
                return TraceReadStatus.Corrupt if chunk.payload_received != chunk.header.payload_length.usize()
                return TraceReadStatus.Corrupt if not DebuggerTrace::trace_chunk_range_valid(chunk.header)
                computed: mutable u64 = TRACE_HASH_OFFSET_BASIS
                for payload_index in 0..<chunk.payload_received:
                    computed <- (computed ^ chunk.payload[payload_index].u64()) * TRACE_HASH_PRIME
                return TraceReadStatus.Corrupt if chunk.checksum != computed
                return TraceReadStatus.Corrupt if chunk.checksum != chunk.header.checksum
            return TraceReadStatus.Corrupt if stream.next_sequence != TRACE_FIRST_SEQUENCE + stream.chunk_count.u64()
            return TraceReadStatus.Complete

        def trace_stream_verified_event(stream: TraceStream) -> u64:
            return stream.verified_event
