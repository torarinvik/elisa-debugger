# Lossless bounded event tape for the first managed recording slice.  Exact
# mode refuses an append after capacity rather than silently dropping history.

include "../core/events.elisa"

module DebuggerTraceTape:
    private:
        const TRACE_TAPE_CAPACITY: usize = 1024
        const TRACE_TAPE_SCHEMA: u32 = 1
        const TRACE_TAPE_MAX_ORDINAL: u64 = 18446744073709551615
        const TRACE_TAPE_NO_RECORDING: u64 = 0

    public:
        struct TraceTape:
            events: mutable DebuggerEvents::EventEnvelope[TRACE_TAPE_CAPACITY]
            count: mutable usize
            next_ordinal: mutable u64
            overflowed: mutable bool

        def trace_tape_new() -> TraceTape:
            tape: TraceTape = zeroed
            return tape

        def trace_tape_append(tape: mutable TraceTape&, event: DebuggerEvents::EventEnvelope) -> bool:
            return false if tape.overflowed
            if tape.count >= TRACE_TAPE_CAPACITY:
                tape.overflowed <- true
                return false
            if tape.next_ordinal == TRACE_TAPE_MAX_ORDINAL:
                tape.overflowed <- true
                return false
            return false if event.schema != TRACE_TAPE_SCHEMA or event.position.recording.value == TRACE_TAPE_NO_RECORDING or event.task.value != event.position.task.value or not DebuggerEvents::event_kind_is_valid(event.kind) or not DebuggerEvents::event_quality_is_valid(event.quality)
            stored: mutable DebuggerEvents::EventEnvelope = event
            stored.ordinal <- tape.next_ordinal
            stored.position.event <- tape.next_ordinal
            tape.events[tape.count] <- stored
            tape.count <- tape.count + 1
            tape.next_ordinal <- tape.next_ordinal + 1
            return true

        def trace_tape_is_exact(tape: TraceTape) -> bool:
            return false if tape.overflowed or tape.count > TRACE_TAPE_CAPACITY
            return false if tape.next_ordinal != tape.count.u64()
            for index in 0..<tape.count:
                return false if tape.events[index].ordinal != index.u64() or tape.events[index].position.event != index.u64() or tape.events[index].schema != TRACE_TAPE_SCHEMA or tape.events[index].task.value != tape.events[index].position.task.value or tape.events[index].position.recording.value == TRACE_TAPE_NO_RECORDING or not DebuggerEvents::event_kind_is_valid(tape.events[index].kind) or tape.events[index].quality != DebuggerEvents::EventQuality.Exact
            return true

        def trace_tape_count(tape: TraceTape) -> usize:
            return tape.count
