# Lossless bounded event tape for the first managed recording slice.  Exact
# mode refuses an append after capacity rather than silently dropping history.

include "../core/events.elisa"

module DebuggerTraceTape:
    private:
        const module Trace:
            TAPE_CAPACITY: usize = 1024
            TAPE_SCHEMA: u32 = 2
            TAPE_MAX_ORDINAL: u64 = 18446744073709551615
            TAPE_NO_RECORDING: u64 = 0

        const module Index:
            FIRST_EVENT_INDEX: usize = 0

        const module Count:
            EMPTY_EVENT_COUNT: usize = 0
            EVENT_COUNT_INCREMENT: usize = 1

        const module Ordinal:
            EVENT_ORDINAL_INCREMENT: u64 = 1


    public:
        struct TraceTape:
            events: mutable DebuggerEvents::EventEnvelope[Trace::TAPE_CAPACITY]
            count: mutable usize
            next_ordinal: mutable u64
            recording: mutable DebuggerIdentity::DebugId
            overflowed: mutable bool

        def trace_tape_new() -> TraceTape:
            tape: TraceTape = zeroed
            return tape

        def trace_tape_append(tape: mutable TraceTape&, event: DebuggerEvents::EventEnvelope) -> bool:
            return false if tape.overflowed
            if tape.count >= Trace::TAPE_CAPACITY:
                tape.overflowed <- true
                return false
            if tape.next_ordinal == Trace::TAPE_MAX_ORDINAL:
                tape.overflowed <- true
                return false
            return false if event.schema != Trace::TAPE_SCHEMA or event.position.recording.value == Trace::TAPE_NO_RECORDING or event.task.value != event.position.task.value or not DebuggerEvents::event_kind_is_valid(event.kind) or not DebuggerEvents::event_quality_is_valid(event.quality) or event.quality == DebuggerEvents::EventQuality.Corrupt
            return false if tape.recording.value != Trace::TAPE_NO_RECORDING and tape.recording.value != event.position.recording.value
            stored: mutable DebuggerEvents::EventEnvelope = event
            stored.ordinal <- tape.next_ordinal
            stored.position.event <- tape.next_ordinal
            return false if not DebuggerEvents::event_envelope_is_well_formed(stored)
            tape.recording <- event.position.recording if tape.recording.value == Trace::TAPE_NO_RECORDING
            tape.events[tape.count] <- stored
            tape.count <- tape.count + Count::EVENT_COUNT_INCREMENT
            tape.next_ordinal <- tape.next_ordinal + Ordinal::EVENT_ORDINAL_INCREMENT
            return true

        def trace_tape_is_exact(tape: TraceTape&) -> bool:
            return false if tape.overflowed or tape.count > Trace::TAPE_CAPACITY
            return false if tape.next_ordinal != tape.count.u64()
            return false if tape.count > Count::EMPTY_EVENT_COUNT and tape.recording.value == Trace::TAPE_NO_RECORDING
            for index in Index::FIRST_EVENT_INDEX..<tape.count:
                return false if not DebuggerEvents::event_envelope_is_well_formed(tape.events[index]) or tape.events[index].ordinal != index.u64() or tape.events[index].schema != Trace::TAPE_SCHEMA or tape.events[index].position.recording.value == Trace::TAPE_NO_RECORDING or tape.events[index].position.recording.value != tape.recording.value or tape.events[index].quality != DebuggerEvents::EventQuality.Exact
            return true

        def trace_tape_count(tape: TraceTape&) -> usize:
            return tape.count
