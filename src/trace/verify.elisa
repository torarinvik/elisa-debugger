# Verification report shared by `trace.verify`, remote transfer validation,
# and editor status views.  A report never upgrades a partial prefix to exact.

include "./bundle.elisa"
include "./storage.elisa"
include "../core/errors.elisa"

module DebuggerTraceVerify:
    private:
        const BUNDLE_CHUNK_CAPACITY: usize = 8
        const DETAIL_BUNDLE: u32 = 1
        const DETAIL_STORAGE: u32 = 2

    public:
        enum VerificationState:
            Exact
            Partial
            Corrupt
            Empty

        struct VerificationReport:
            state: mutable VerificationState
            verified_chunks: mutable u64
            verified_event: mutable u64
            replayable: mutable bool
            failure: mutable DebuggerErrors::DebuggerError

        def verify_bundle(bundle: mutable DebuggerTraceBundle::TraceBundle&) -> VerificationReport:
            report: mutable VerificationReport = zeroed
            report.state <- VerificationState.Empty if bundle.chunk_count == 0
            report.failure <- DebuggerErrors::no_error()
            return VerificationReport{state: VerificationState.Corrupt, verified_chunks: 0, verified_event: 0, replayable: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_BUNDLE)} if bundle.state == DebuggerTraceBundle::BundleState.Corrupt
            return report if bundle.chunk_count == 0
            return VerificationReport{state: VerificationState.Corrupt, verified_chunks: 0, verified_event: 0, replayable: false, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.ResourceLimit, false, DETAIL_BUNDLE)} if bundle.chunk_count > BUNDLE_CHUNK_CAPACITY
            for index in 0..<bundle.chunk_count:
                bundle_error: DebuggerErrors::DebuggerError = DebuggerTraceBundle::bundle_verify_chunk_at(bundle, bundle.chunks[index], index.u64())
                return VerificationReport{state: VerificationState.Corrupt, verified_chunks: report.verified_chunks, verified_event: report.verified_event, replayable: false, failure: bundle_error} if not DebuggerErrors::error_is_ok(bundle_error)
                report.verified_chunks <- report.verified_chunks + 1
                report.verified_event <- bundle.chunks[index].header.last_event if bundle.chunks[index].header.kind == DebuggerTrace::ChunkKind.Events
            report.replayable <- DebuggerTraceBundle::bundle_is_replayable(bundle)
            report.state <- VerificationState.Exact if report.replayable
            report.state <- VerificationState.Partial if not report.replayable
            return report

        def verify_storage(bytes: u8&, length: usize) -> VerificationReport:
            return VerificationReport{state: VerificationState.Empty, verified_chunks: 0, verified_event: 0, replayable: false, failure: DebuggerErrors::no_error()} if length == 0
            scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(bytes, length)
            report: mutable VerificationReport = zeroed
            report.verified_chunks <- scan.verified_chunks
            report.verified_event <- scan.verified_event
            report.replayable <- scan.status == DebuggerTraceStorage::StorageStatus.Ready and scan.footer_verified and scan.manifest_seen and scan.manifest_exact and scan.event_chunk_seen
            report.state <- VerificationState.Exact if report.replayable
            report.state <- VerificationState.Partial if scan.status == DebuggerTraceStorage::StorageStatus.Ready and scan.verified_chunks > 0 and (not scan.footer_verified or not scan.manifest_seen or not scan.manifest_exact or not scan.event_chunk_seen)
            report.state <- VerificationState.Partial if scan.status == DebuggerTraceStorage::StorageStatus.Truncated
            report.state <- VerificationState.Empty if scan.verified_chunks == 0 and scan.status == DebuggerTraceStorage::StorageStatus.Ready
            report.state <- VerificationState.Corrupt if scan.status == DebuggerTraceStorage::StorageStatus.Invalid or scan.status == DebuggerTraceStorage::StorageStatus.Oversized
            report.state <- VerificationState.Corrupt if scan.status == DebuggerTraceStorage::StorageStatus.IoFailure
            report.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Corrupt, false, DETAIL_STORAGE) if report.state == VerificationState.Corrupt
            report.failure <- DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, DETAIL_STORAGE) if report.state == VerificationState.Partial
            return report
