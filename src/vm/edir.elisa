# EDIR is the managed execution representation.  This first instruction slice
# is intentionally small and typed; the verifier is the security boundary for
# future trace loading and remote execution.

include "../core/identity.elisa"
include "../metadata/source.elisa"

const module DebuggerEDIRCapacity:
    EDIR_INSTRUCTION_CAPACITY: usize = 256
    EDIR_SOURCE_FILE_CAPACITY: usize = 16
    EDIR_FUNCTION_CAPACITY: usize = 64
    EDIR_FUNCTION_NAME_CAPACITY: usize = 128
    EDIR_CALL_DEPTH_CAPACITY: usize = 16
    EDIR_CURRENT_FRAME_SLOT_COUNT: usize = 1
    EDIR_CALL_FRAME_CAPACITY: usize = DebuggerEDIRCapacity::EDIR_CALL_DEPTH_CAPACITY + DebuggerEDIRCapacity::EDIR_CURRENT_FRAME_SLOT_COUNT

module DebuggerEDIR:
    private:
        const module Format:
            PROGRAM_VERSION: u32 = 1
            MAX_OPCODE: u16 = 19

        const module Limit:
            INSTRUCTIONS: usize = DebuggerEDIRCapacity::EDIR_INSTRUCTION_CAPACITY
            SOURCE_FILES: usize = DebuggerEDIRCapacity::EDIR_SOURCE_FILE_CAPACITY
            FUNCTIONS: usize = DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY
            FUNCTION_NAME_BYTES: usize = DebuggerEDIRCapacity::EDIR_FUNCTION_NAME_CAPACITY

        const module FunctionIndex:
            FIRST_FUNCTION_INDEX: usize = 0

        const module MachineCapacity:
            VM_EDIR_MAX_LOCALS: usize = 32
            VM_EDIR_MAX_GLOBALS: usize = 16
            VM_EDIR_MAX_MEMORY: usize = 64
            VM_EDIR_MAX_CALL_DEPTH: usize = DebuggerEDIRCapacity::EDIR_CALL_DEPTH_CAPACITY
            VM_EDIR_FRAME_LOCAL_CAPACITY: usize = MachineCapacity::VM_EDIR_MAX_CALL_DEPTH * MachineCapacity::VM_EDIR_MAX_LOCALS

        const module Index:
            MAX_LOCALS: i64 = 32
            MAX_GLOBALS: i64 = 16
            MAX_MEMORY: i64 = 64

        const module Sentinel:
            NO_SOURCE_FILE_ID: u64 = 0
            NO_SOURCE_LINE: u32 = 0

        const module Step:
            EDIR_STEP_INCREMENT: u64 = 1
            MAX_COUNT: u64 = 18446744073709551615

        const module Mask:
            LOCAL_INITIALIZED_BASE: u64 = 1

        const module Integer:
            I64_MAX: i64 = 9223372036854775807
            I64_MIN: i64 = -9223372036854775807 - 1


        def add_overflows(left: i64, right: i64) -> bool:
            return left > Integer::I64_MAX - right if right > 0
            return left < Integer::I64_MIN - right if right < 0
            return false

        def subtract_overflows(left: i64, right: i64) -> bool:
            return left < Integer::I64_MIN + right if right > 0
            return left > Integer::I64_MAX + right if right < 0
            return false

        def multiply_overflows(left: i64, right: i64) -> bool:
            return false if left == 0 or right == 0
            return true if left == Integer::I64_MIN and right == -1
            return true if right == Integer::I64_MIN and left == -1
            if left > 0:
                return left > Integer::I64_MAX / right if right > 0
                return right < Integer::I64_MIN / left
            if right > 0:
                return left < Integer::I64_MIN / right
            return right < Integer::I64_MAX / left

        def negate_overflows(value: i64) -> bool:
            return value == Integer::I64_MIN

        def divide_overflows(left: i64, right: i64) -> bool:
            return left == Integer::I64_MIN and right == -1

        def source_range_is_valid(source: DebuggerIdentity::SourceSpan) -> bool:
            return false if source.end_byte < source.start_byte or source.end_line < source.start_line
            return false if source.start_line == source.end_line and source.end_column < source.start_column
            return true

        def source_file_index(image: ProgramImage, file_id: DebuggerIdentity::DebugId) -> usize:
            return Limit::SOURCE_FILES if image.source_file_count > Limit::SOURCE_FILES
            for index in 0..<image.source_file_count:
                return index if image.source_files[index].id.value == file_id.value
            return Limit::SOURCE_FILES

        def source_file_table_is_valid(image: ProgramImage) -> bool:
            return false if image.source_file_count > Limit::SOURCE_FILES
            for index in 0..<image.source_file_count:
                file: DebuggerMetadata::SourceFile = image.source_files[index]
                return false if not DebuggerMetadata::source_file_is_valid(file)
                for previous in 0..<index:
                    prior: DebuggerMetadata::SourceFile = image.source_files[previous]
                    return false if prior.id.value == file.id.value or prior.logical_path.value == file.logical_path.value
                    return false if DebuggerMetadata::source_file_paths_equal(prior, file)
            for index in 0..<image.program.instruction_count.usize():
                span: DebuggerIdentity::SourceSpan = image.instructions[index].source
                continue if span.file.value == Sentinel::NO_SOURCE_FILE_ID
                file_index: usize = source_file_index(image, span.file)
                return false if file_index == Limit::SOURCE_FILES
                file: DebuggerMetadata::SourceFile = image.source_files[file_index]
                return false if span.start_line == Sentinel::NO_SOURCE_LINE or span.end_line == Sentinel::NO_SOURCE_LINE or span.start_line.u64() > file.line_count or span.end_line.u64() > file.line_count
            return true

        def function_source_is_valid(image: ProgramImage, source: DebuggerIdentity::SourceSpan) -> bool:
            return false if not source_range_is_valid(source) or source.file.value == Sentinel::NO_SOURCE_FILE_ID
            return false if source.start_line == Sentinel::NO_SOURCE_LINE or source.end_line == Sentinel::NO_SOURCE_LINE
            file_index: usize = source_file_index(image, source.file)
            return false if file_index == Limit::SOURCE_FILES
            file: DebuggerMetadata::SourceFile = image.source_files[file_index]
            return source.start_line.u64() <= file.line_count and source.end_line.u64() <= file.line_count

        def function_table_is_valid(image: ProgramImage) -> bool:
            return false if image.function_count > Limit::FUNCTIONS
            for index in 0..<image.function_count:
                function: FunctionDescriptor = image.functions[index]
                return false if DebuggerIdentity::debug_id_is_zero(function.id)
                return false if function.name_length == 0 or function.name_length > Limit::FUNCTION_NAME_BYTES
                return false if not DebuggerMetadata::metadata_text_utf8_is_valid(function.name_bytes[0], function.name_length, Limit::FUNCTION_NAME_BYTES)
                return false if function.entry_instruction >= function.end_instruction_exclusive or function.end_instruction_exclusive > image.program.instruction_count
                return false if not function_source_is_valid(image, function.source)
                for previous in 0..<index:
                    previous_function: FunctionDescriptor = image.functions[previous]
                    return false if previous_function.id.value == function.id.value
                    return false if function.entry_instruction < previous_function.end_instruction_exclusive and previous_function.entry_instruction < function.end_instruction_exclusive
            return true

    public:

        enum Opcode:
            Nop
            Constant
            Add
            Subtract
            LoadLocal
            StoreLocal
            LoadGlobal
            StoreGlobal
            LoadMemory
            StoreMemory
            Allocate
            Multiply
            Divide
            Negate
            CompareEqual
            CompareLess
            Jump
            BranchZero
            Call
            Return

        enum VerificationError:
            None
            UnknownVersion
            InvalidOpcode
            InvalidOperand
            InvalidRegister
            InvalidTarget
            UninitializedLocal
            MissingReturn
            InvalidSourceRange
            InvalidSourceTable
            InvalidFunctionTable
            InvalidCallDepth

        struct Instruction:
            opcode: mutable Opcode
            a: mutable i64
            b: mutable i64
            source: mutable DebuggerIdentity::SourceSpan

        struct Program:
            version: mutable u32
            instruction_count: mutable u64
            local_count: mutable u64
            has_return: mutable bool

        # Instruction ranges are half-open: entry_instruction is included and
        # end_instruction_exclusive is the first instruction outside the body.
        # Descriptors are compiler-supplied artifact metadata; the VM never
        # derives them from branch targets or instruction addresses.
        struct FunctionDescriptor:
            id: mutable DebuggerIdentity::DebugId
            name_bytes: mutable u8[Limit::FUNCTION_NAME_BYTES]
            name_length: mutable usize
            entry_instruction: mutable u64
            end_instruction_exclusive: mutable u64
            source: mutable DebuggerIdentity::SourceSpan

        struct ProgramImage:
            program: mutable Program
            instructions: mutable Instruction[Limit::INSTRUCTIONS]
            source_file_count: mutable usize
            source_files: mutable DebuggerMetadata::SourceFile[Limit::SOURCE_FILES]
            function_count: mutable usize
            functions: mutable FunctionDescriptor[Limit::FUNCTIONS]

        struct Verification:
            valid: mutable bool
            verification_error: mutable VerificationError
            instruction: mutable u64

        struct Machine:
            program_counter: mutable u64
            accumulator: mutable i64
            locals: mutable i64[MachineCapacity::VM_EDIR_MAX_LOCALS]
            locals_initialized: mutable bool[MachineCapacity::VM_EDIR_MAX_LOCALS]
            frame_locals: mutable i64[MachineCapacity::VM_EDIR_FRAME_LOCAL_CAPACITY]
            frame_locals_initialized: mutable bool[MachineCapacity::VM_EDIR_FRAME_LOCAL_CAPACITY]
            globals: mutable i64[MachineCapacity::VM_EDIR_MAX_GLOBALS]
            globals_initialized: mutable bool[MachineCapacity::VM_EDIR_MAX_GLOBALS]
            memory: mutable i64[MachineCapacity::VM_EDIR_MAX_MEMORY]
            memory_initialized: mutable bool[MachineCapacity::VM_EDIR_MAX_MEMORY]
            heap_next: mutable usize
            return_stack: mutable u64[MachineCapacity::VM_EDIR_MAX_CALL_DEPTH]
            return_stack_pointer: mutable usize
            halted: mutable bool
            faulted: mutable bool
            steps: mutable u64
            result: mutable i64

        def frame_local_slot(depth: usize, local: usize) -> usize:
            return depth * MachineCapacity::VM_EDIR_MAX_LOCALS + local

        def source_file_capacity() -> usize:
            return Limit::SOURCE_FILES

        def function_capacity() -> usize:
            return Limit::FUNCTIONS

        def function_name_capacity() -> usize:
            return Limit::FUNCTION_NAME_BYTES

        def call_depth_capacity() -> usize:
            return MachineCapacity::VM_EDIR_MAX_CALL_DEPTH

        def call_frame_capacity() -> usize:
            return DebuggerEDIRCapacity::EDIR_CALL_FRAME_CAPACITY

        def function_index_for_instruction(image: ProgramImage, instruction_index: u64) -> usize:
            return image.function_count if image.function_count > Limit::FUNCTIONS
            for function_index in FunctionIndex::FIRST_FUNCTION_INDEX..<image.function_count:
                function: FunctionDescriptor = image.functions[function_index]
                if instruction_index >= function.entry_instruction and instruction_index < function.end_instruction_exclusive:
                    return function_index
            return image.function_count

        def frame_save(machine: mutable Machine&, depth: usize) -> void:
            return if depth >= MachineCapacity::VM_EDIR_MAX_CALL_DEPTH
            for local in 0..<MachineCapacity::VM_EDIR_MAX_LOCALS:
                slot: usize = frame_local_slot(depth, local)
                machine.frame_locals[slot] <- machine.locals[local]
                machine.frame_locals_initialized[slot] <- machine.locals_initialized[local]

        def frame_restore(machine: mutable Machine&, depth: usize) -> void:
            return if depth >= MachineCapacity::VM_EDIR_MAX_CALL_DEPTH
            for local in 0..<MachineCapacity::VM_EDIR_MAX_LOCALS:
                slot: usize = frame_local_slot(depth, local)
                machine.locals[local] <- machine.frame_locals[slot]
                machine.locals_initialized[local] <- machine.frame_locals_initialized[slot]

        def frame_clear_current(machine: mutable Machine&) -> void:
            for local in 0..<MachineCapacity::VM_EDIR_MAX_LOCALS:
                machine.locals[local] <- 0
                machine.locals_initialized[local] <- false

        def frame_clear_saved(machine: mutable Machine&, depth: usize) -> void:
            return if depth >= MachineCapacity::VM_EDIR_MAX_CALL_DEPTH
            for local in 0..<MachineCapacity::VM_EDIR_MAX_LOCALS:
                slot: usize = frame_local_slot(depth, local)
                machine.frame_locals[slot] <- 0
                machine.frame_locals_initialized[slot] <- false

        def verify_program(program: Program) -> Verification:
            verification: Verification = zeroed
            verification.valid <- true
            verification.verification_error <- VerificationError.None
            verification.instruction <- 0
            if program.version != Format::PROGRAM_VERSION:
                verification.valid <- false
                verification.verification_error <- VerificationError.UnknownVersion
                return verification
            if program.instruction_count == 0 or not program.has_return:
                verification.valid <- false
                verification.verification_error <- VerificationError.MissingReturn
                return verification
            if program.instruction_count > Limit::INSTRUCTIONS.u64():
                verification.valid <- false
                verification.verification_error <- VerificationError.InvalidTarget
                return verification
            if program.local_count > Index::MAX_LOCALS.u64():
                verification.valid <- false
                verification.verification_error <- VerificationError.InvalidRegister
                return verification
            return verification

        def verification_failure(reason: VerificationError, instruction: u64) -> Verification:
            return Verification{valid: false, verification_error: reason, instruction: instruction}

        def verify_instruction_operands(instruction: Instruction, index: u64) -> Verification:
            return verification_failure(VerificationError.InvalidOpcode, index) if instruction.opcode.u16() > Format::MAX_OPCODE
            if instruction.opcode == Opcode.Nop or instruction.opcode == Opcode.Return:
                return verification_failure(VerificationError.InvalidOperand, index) if instruction.a != 0 or instruction.b != 0
            if instruction.opcode == Opcode.LoadLocal or instruction.opcode == Opcode.StoreLocal or instruction.opcode == Opcode.LoadGlobal or instruction.opcode == Opcode.StoreGlobal or instruction.opcode == Opcode.LoadMemory or instruction.opcode == Opcode.StoreMemory or instruction.opcode == Opcode.Allocate:
                return verification_failure(VerificationError.InvalidOperand, index) if instruction.b != 0
            if instruction.opcode == Opcode.Add or instruction.opcode == Opcode.Subtract or instruction.opcode == Opcode.Multiply or instruction.opcode == Opcode.Divide or instruction.opcode == Opcode.CompareEqual or instruction.opcode == Opcode.CompareLess or instruction.opcode == Opcode.Constant or instruction.opcode == Opcode.Negate:
                return verification_failure(VerificationError.InvalidOperand, index) if instruction.b != 0
            if instruction.opcode == Opcode.Jump or instruction.opcode == Opcode.BranchZero:
                return verification_failure(VerificationError.InvalidOperand, index) if instruction.b != 0
            if instruction.opcode == Opcode.Call:
                return verification_failure(VerificationError.InvalidOperand, index) if instruction.b < 0
            return Verification{valid: true, verification_error: VerificationError.None, instruction: 0}

        def verify_local_initialization(image: ProgramImage&) -> Verification:
            return verification_failure(VerificationError.InvalidTarget, image.program.instruction_count) if image.program.instruction_count == 0 or image.program.instruction_count > Limit::INSTRUCTIONS.u64()
            return verification_failure(VerificationError.InvalidRegister, image.program.local_count) if image.program.local_count > Index::MAX_LOCALS.u64()
            count: usize = image.program.instruction_count.usize()
            entry_masks: mutable u64[Limit::INSTRUCTIONS] = zeroed
            seen: mutable bool[Limit::INSTRUCTIONS] = zeroed
            seen[0] <- true
            changed: mutable bool = true
            while changed:
                changed <- false
                for index in 0..<count:
                    continue if not seen[index]
                    instruction: Instruction = image.instructions[index]
                    if instruction.opcode == Opcode.LoadLocal or instruction.opcode == Opcode.StoreLocal:
                        return verification_failure(VerificationError.InvalidRegister, index.u64()) if instruction.a < 0 or instruction.a >= image.program.local_count.i64()
                    if instruction.opcode == Opcode.Jump or instruction.opcode == Opcode.BranchZero or instruction.opcode == Opcode.Call:
                        return verification_failure(VerificationError.InvalidTarget, index.u64()) if instruction.a < 0 or instruction.a >= count.i64()
                    outgoing: mutable u64 = entry_masks[index]
                    outgoing <- outgoing | (Mask::LOCAL_INITIALIZED_BASE << instruction.a.u64()) if instruction.opcode == Opcode.StoreLocal
                    if instruction.opcode == Opcode.Return:
                        continue
                    if instruction.opcode == Opcode.Jump:
                        successor: usize = instruction.a.usize()
                        if not seen[successor]:
                            seen[successor] <- true
                            entry_masks[successor] <- outgoing
                            changed <- true
                        else:
                            merged: u64 = entry_masks[successor] & outgoing
                            if merged != entry_masks[successor]:
                                entry_masks[successor] <- merged
                                changed <- true
                        continue
                    if instruction.opcode == Opcode.Call:
                        target: usize = instruction.a.usize()
                        callee_entry: mutable u64 = 0
                        callee_entry <- Mask::LOCAL_INITIALIZED_BASE if image.program.local_count > 0
                        if not seen[target]:
                            seen[target] <- true
                            entry_masks[target] <- callee_entry
                            changed <- true
                        else:
                            merged_target: u64 = entry_masks[target] & callee_entry
                            if merged_target != entry_masks[target]:
                                entry_masks[target] <- merged_target
                                changed <- true
                    fallthrough: usize = index + 1
                    return verification_failure(VerificationError.InvalidTarget, index.u64()) if fallthrough >= count
                    if instruction.opcode == Opcode.BranchZero:
                        target: usize = instruction.a.usize()
                        if not seen[target]:
                            seen[target] <- true
                            entry_masks[target] <- outgoing
                            changed <- true
                        else:
                            merged_target: u64 = entry_masks[target] & outgoing
                            if merged_target != entry_masks[target]:
                                entry_masks[target] <- merged_target
                                changed <- true
                        if fallthrough < count:
                            if not seen[fallthrough]:
                                seen[fallthrough] <- true
                                entry_masks[fallthrough] <- outgoing
                                changed <- true
                            else:
                                merged_fallthrough: u64 = entry_masks[fallthrough] & outgoing
                                if merged_fallthrough != entry_masks[fallthrough]:
                                    entry_masks[fallthrough] <- merged_fallthrough
                                    changed <- true
                        continue
                    if not seen[fallthrough]:
                        seen[fallthrough] <- true
                        entry_masks[fallthrough] <- outgoing
                        changed <- true
                    else:
                        merged_next: u64 = entry_masks[fallthrough] & outgoing
                        if merged_next != entry_masks[fallthrough]:
                            entry_masks[fallthrough] <- merged_next
                            changed <- true
            reachable_return: mutable bool = false
            for index in 0..<count:
                continue if not seen[index]
                instruction: Instruction = image.instructions[index]
                reachable_return <- true if instruction.opcode == Opcode.Return
                if instruction.opcode == Opcode.LoadLocal:
                    bit: u64 = Mask::LOCAL_INITIALIZED_BASE << instruction.a.u64()
                    return verification_failure(VerificationError.UninitializedLocal, index.u64()) if (entry_masks[index] & bit) == 0
            return verification_failure(VerificationError.MissingReturn, image.program.instruction_count) if not reachable_return
            return Verification{valid: true, verification_error: VerificationError.None, instruction: 0}

        def verify_image(image: ProgramImage&) -> Verification:
            program_verification: Verification = verify_program(image.program)
            return program_verification if not program_verification.valid
            saw_return: mutable bool = false
            for index in 0..<image.program.instruction_count.usize():
                instruction: Instruction = image.instructions[index]
                operand_verification: Verification = verify_instruction_operands(instruction, index.u64())
                return operand_verification if not operand_verification.valid
                if instruction.opcode == Opcode.LoadLocal or instruction.opcode == Opcode.StoreLocal:
                    return verification_failure(VerificationError.InvalidRegister, index.u64()) if instruction.a < 0 or instruction.a >= image.program.local_count.i64()
                if instruction.opcode == Opcode.LoadGlobal or instruction.opcode == Opcode.StoreGlobal:
                    return verification_failure(VerificationError.InvalidRegister, index.u64()) if instruction.a < 0 or instruction.a >= Index::MAX_GLOBALS
                if instruction.opcode == Opcode.LoadMemory or instruction.opcode == Opcode.StoreMemory:
                    return verification_failure(VerificationError.InvalidRegister, index.u64()) if instruction.a < 0 or instruction.a >= Index::MAX_MEMORY
                if instruction.opcode == Opcode.Allocate:
                    return verification_failure(VerificationError.InvalidRegister, index.u64()) if instruction.a <= 0 or instruction.a > Index::MAX_MEMORY
                if instruction.opcode == Opcode.Jump or instruction.opcode == Opcode.BranchZero or instruction.opcode == Opcode.Call:
                    return verification_failure(VerificationError.InvalidTarget, index.u64()) if instruction.a < 0 or instruction.a >= image.program.instruction_count.i64()
                if instruction.opcode == Opcode.Call and instruction.b > MachineCapacity::VM_EDIR_MAX_CALL_DEPTH.i64():
                    return verification_failure(VerificationError.InvalidCallDepth, index.u64())
                return verification_failure(VerificationError.InvalidSourceRange, index.u64()) if not source_range_is_valid(instruction.source)
                saw_return <- true if instruction.opcode == Opcode.Return
            return verification_failure(VerificationError.MissingReturn, image.program.instruction_count) if not saw_return
            initialization_verification: Verification = verify_local_initialization(image)
            return initialization_verification if not initialization_verification.valid
            return Verification{valid: true, verification_error: VerificationError.None, instruction: 0}

        def verify_image_with_source_table(image: ProgramImage&) -> Verification:
            verification: Verification = verify_image(image)
            return verification if not verification.valid
            return verification_failure(VerificationError.InvalidSourceTable, Sentinel::NO_SOURCE_FILE_ID) if not source_file_table_is_valid(image)
            return verification_failure(VerificationError.InvalidFunctionTable, 0) if not function_table_is_valid(image)
            return verification

        def machine_new() -> Machine:
            machine: Machine = zeroed
            machine.halted <- false
            machine.faulted <- false
            machine.steps <- 0
            machine.return_stack_pointer <- 0
            return machine

        def machine_step(machine: Machine, instruction: Instruction) -> Machine:
            updated: mutable Machine = machine
            machine_step_in_place(updated, instruction)
            return updated

        def machine_step_in_place(machine: mutable Machine&, instruction: Instruction) -> void:
            if machine.halted or machine.faulted:
                return
            operand_verification: Verification = verify_instruction_operands(instruction, machine.program_counter)
            if not operand_verification.valid:
                machine.faulted <- true
                machine.halted <- true
                return
            if machine.program_counter >= Limit::INSTRUCTIONS.u64() or machine.return_stack_pointer > MachineCapacity::VM_EDIR_MAX_CALL_DEPTH or machine.heap_next > MachineCapacity::VM_EDIR_MAX_MEMORY:
                machine.faulted <- true
                machine.halted <- true
                return
            if (instruction.opcode == Opcode.Jump or instruction.opcode == Opcode.BranchZero or instruction.opcode == Opcode.Call) and (instruction.a < 0 or instruction.a >= Limit::INSTRUCTIONS.i64()):
                machine.faulted <- true
                machine.halted <- true
                return
            if instruction.opcode == Opcode.Call and instruction.b > MachineCapacity::VM_EDIR_MAX_CALL_DEPTH.i64():
                machine.faulted <- true
                machine.halted <- true
                return
            if machine.steps >= Step::MAX_COUNT:
                machine.faulted <- true
                machine.halted <- true
                return
            if instruction.opcode == Opcode.Nop:
                machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Constant:
                machine.accumulator <- instruction.a
                machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Add:
                if add_overflows(machine.accumulator, instruction.a):
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- machine.accumulator + instruction.a
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Subtract:
                if subtract_overflows(machine.accumulator, instruction.a):
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- machine.accumulator - instruction.a
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Multiply:
                if multiply_overflows(machine.accumulator, instruction.a):
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- machine.accumulator * instruction.a
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Divide:
                if instruction.a == 0 or divide_overflows(machine.accumulator, instruction.a):
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- machine.accumulator / instruction.a
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Negate:
                if negate_overflows(machine.accumulator):
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- 0 - machine.accumulator
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.CompareEqual:
                if machine.accumulator == instruction.a:
                    machine.accumulator <- 1
                else:
                    machine.accumulator <- 0
                machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.CompareLess:
                if machine.accumulator < instruction.a:
                    machine.accumulator <- 1
                else:
                    machine.accumulator <- 0
                machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.LoadLocal:
                if instruction.a < 0 or instruction.a >= Index::MAX_LOCALS or not machine.locals_initialized[instruction.a.usize()]:
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- machine.locals[instruction.a.usize()]
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.StoreLocal:
                if instruction.a < 0 or instruction.a >= Index::MAX_LOCALS:
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.locals[instruction.a.usize()] <- machine.accumulator
                    machine.locals_initialized[instruction.a.usize()] <- true
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.LoadGlobal:
                if instruction.a < 0 or instruction.a >= Index::MAX_GLOBALS or not machine.globals_initialized[instruction.a.usize()]:
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- machine.globals[instruction.a.usize()]
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.StoreGlobal:
                if instruction.a < 0 or instruction.a >= Index::MAX_GLOBALS:
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.globals[instruction.a.usize()] <- machine.accumulator
                    machine.globals_initialized[instruction.a.usize()] <- true
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.LoadMemory:
                if instruction.a < 0 or instruction.a >= Index::MAX_MEMORY or instruction.a >= machine.heap_next.i64() or not machine.memory_initialized[instruction.a.usize()]:
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- machine.memory[instruction.a.usize()]
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.StoreMemory:
                if instruction.a < 0 or instruction.a >= Index::MAX_MEMORY or instruction.a >= machine.heap_next.i64():
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.memory[instruction.a.usize()] <- machine.accumulator
                    machine.memory_initialized[instruction.a.usize()] <- true
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Allocate:
                requested: mutable usize = 0
                requested <- instruction.a.usize() if instruction.a > 0
                if instruction.a <= 0 or instruction.a > Index::MAX_MEMORY or machine.heap_next > MachineCapacity::VM_EDIR_MAX_MEMORY - requested:
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.accumulator <- machine.heap_next.i64()
                    machine.heap_next <- machine.heap_next + requested
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Jump:
                if instruction.a < 0:
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    machine.program_counter <- instruction.a.u64()
            if instruction.opcode == Opcode.BranchZero:
                if machine.accumulator == 0:
                    if instruction.a < 0:
                        machine.faulted <- true
                        machine.halted <- true
                    else:
                        machine.program_counter <- instruction.a.u64()
                else:
                    machine.program_counter <- machine.program_counter + Step::EDIR_STEP_INCREMENT
            if instruction.opcode == Opcode.Call:
                if instruction.a < 0:
                    machine.faulted <- true
                    machine.halted <- true
                else:
                    if machine.return_stack_pointer >= MachineCapacity::VM_EDIR_MAX_CALL_DEPTH:
                        machine.faulted <- true
                        machine.halted <- true
                    else:
                        machine.return_stack[machine.return_stack_pointer] <- machine.program_counter + Step::EDIR_STEP_INCREMENT
                        frame_save(machine, machine.return_stack_pointer)
                        machine.return_stack_pointer <- machine.return_stack_pointer + 1
                        frame_clear_current(machine)
                        if MachineCapacity::VM_EDIR_MAX_LOCALS > 0:
                            machine.locals[0] <- machine.accumulator
                            machine.locals_initialized[0] <- true
                        machine.program_counter <- instruction.a.u64()
            if instruction.opcode == Opcode.Return:
                if machine.return_stack_pointer == 0:
                    machine.result <- machine.accumulator
                    machine.halted <- true
                else:
                    machine.return_stack_pointer <- machine.return_stack_pointer - 1
                    returned_value: i64 = machine.accumulator
                    frame_restore(machine, machine.return_stack_pointer)
                    frame_clear_saved(machine, machine.return_stack_pointer)
                    machine.accumulator <- returned_value
                    machine.program_counter <- machine.return_stack[machine.return_stack_pointer]
            machine.steps <- machine.steps + Step::EDIR_STEP_INCREMENT
            return

        def machine_run(image: mutable ProgramImage&, machine: Machine, max_steps: u64) -> Machine:
            updated: mutable Machine = machine
            start_steps: u64 = updated.steps
            if updated.program_counter >= Limit::INSTRUCTIONS.u64() or updated.return_stack_pointer > MachineCapacity::VM_EDIR_MAX_CALL_DEPTH or updated.heap_next > MachineCapacity::VM_EDIR_MAX_MEMORY:
                updated.faulted <- true
                updated.halted <- true
                return updated
            verification: Verification = verify_image(image)
            if not verification.valid:
                updated.faulted <- true
                updated.halted <- true
                return updated
            while not updated.halted and not updated.faulted and updated.steps - start_steps < max_steps:
                if updated.program_counter >= image.program.instruction_count:
                    updated.faulted <- true
                    updated.halted <- true
                else:
                    instruction: Instruction = image.instructions[updated.program_counter.usize()]
                    machine_step_in_place(updated, instruction)
            return updated

        def machine_is_halted(machine: Machine) -> bool:
            return machine.halted

        def machine_is_faulted(machine: Machine) -> bool:
            return machine.faulted
