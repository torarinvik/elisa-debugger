# Versioned, portable EDIR artifact codec.  The decoder never exposes a
# partially decoded image: malformed bytes return a failed result and a zeroed
# image for the caller to discard.

include "./edir.elisa"
include "../trace/binary.elisa"

module DebuggerEDIRCodec:
    private:
        const module Boolean:
            VM_EDIR_CODEC_BOOLEAN_FALSE: u8 = 0
            VM_EDIR_CODEC_BOOLEAN_TRUE: u8 = 1

        const module Edir:
            CODEC_SCHEMA: u32 = 3
            CODEC_LEGACY_SCHEMA: u32 = 2
            CODEC_MAX_INSTRUCTIONS: usize = 128
            CODEC_MAX_SOURCE_FILES: usize = DebuggerEDIRCapacity::EDIR_SOURCE_FILE_CAPACITY
            CODEC_MAX_FUNCTIONS: usize = DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY
            CODEC_FUNCTION_NAME_CAPACITY: usize = DebuggerEDIRCapacity::EDIR_FUNCTION_NAME_CAPACITY
            CODEC_U8_FIELD_BYTES: usize = 1
            CODEC_U16_FIELD_BYTES: usize = 2
            CODEC_U64_FIELD_BYTES: usize = 8
            CODEC_U32_FIELD_BYTES: usize = 4
            CODEC_SOURCE_FILE_FIXED_BYTES: usize = Edir::CODEC_U64_FIELD_BYTES * 4 + Edir::CODEC_U32_FIELD_BYTES
            CODEC_SOURCE_SPAN_BYTES: usize = Edir::CODEC_U64_FIELD_BYTES * 3 + Edir::CODEC_U32_FIELD_BYTES * 5
            CODEC_INSTRUCTION_BYTES: usize = Edir::CODEC_U16_FIELD_BYTES + Edir::CODEC_U64_FIELD_BYTES * 2 + Edir::CODEC_SOURCE_SPAN_BYTES
            CODEC_SOURCE_PATH_CAPACITY: usize = DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
            CODEC_HEADER_BYTES: usize = Edir::CODEC_U32_FIELD_BYTES * 3 + Edir::CODEC_U64_FIELD_BYTES * 2 + Edir::CODEC_U8_FIELD_BYTES
            CODEC_MAX_SOURCE_FILE_BYTES: usize = Edir::CODEC_SOURCE_FILE_FIXED_BYTES + Edir::CODEC_SOURCE_PATH_CAPACITY
            CODEC_FUNCTION_FIXED_BYTES: usize = Edir::CODEC_U64_FIELD_BYTES * 3 + Edir::CODEC_SOURCE_SPAN_BYTES + Edir::CODEC_U32_FIELD_BYTES
            CODEC_MAX_FUNCTION_BYTES: usize = Edir::CODEC_U32_FIELD_BYTES + Edir::CODEC_MAX_FUNCTIONS * (Edir::CODEC_FUNCTION_FIXED_BYTES + Edir::CODEC_FUNCTION_NAME_CAPACITY)
            CODEC_MAX_BYTES: usize = Edir::CODEC_HEADER_BYTES + Edir::CODEC_MAX_INSTRUCTIONS * Edir::CODEC_INSTRUCTION_BYTES + Edir::CODEC_MAX_SOURCE_FILES * Edir::CODEC_MAX_SOURCE_FILE_BYTES + Edir::CODEC_MAX_FUNCTION_BYTES

        const module Opcode:
            NOP: u16 = 0
            CONSTANT: u16 = 1
            ADD: u16 = 2
            SUBTRACT: u16 = 3
            LOAD_LOCAL: u16 = 4
            STORE_LOCAL: u16 = 5
            LOAD_GLOBAL: u16 = 6
            STORE_GLOBAL: u16 = 7
            LOAD_MEMORY: u16 = 8
            STORE_MEMORY: u16 = 9
            ALLOCATE: u16 = 10
            MULTIPLY: u16 = 11
            DIVIDE: u16 = 12
            NEGATE: u16 = 13
            COMPARE_EQUAL: u16 = 14
            COMPARE_LESS: u16 = 15
            JUMP: u16 = 16
            BRANCH_ZERO: u16 = 17
            CALL: u16 = 18
            RETURN: u16 = 19
            MAX: u16 = Opcode::RETURN

        # Each instruction stores opcode (2), two i64 operands (16), and a
        # SourceSpan containing three u64 values plus five u32 values (44).
        # Keep this derived layout size in sync with put_source above so the
        # advertised artifact bound accepts every encodable image.

        def opcode_from_u16(value: u16, valid: mutable bool&) -> DebuggerEDIR::Opcode:
            valid <- false if value > Opcode::MAX
            return DebuggerEDIR::Opcode.Nop if value == Opcode::NOP
            return DebuggerEDIR::Opcode.Constant if value == Opcode::CONSTANT
            return DebuggerEDIR::Opcode.Add if value == Opcode::ADD
            return DebuggerEDIR::Opcode.Subtract if value == Opcode::SUBTRACT
            return DebuggerEDIR::Opcode.LoadLocal if value == Opcode::LOAD_LOCAL
            return DebuggerEDIR::Opcode.StoreLocal if value == Opcode::STORE_LOCAL
            return DebuggerEDIR::Opcode.LoadGlobal if value == Opcode::LOAD_GLOBAL
            return DebuggerEDIR::Opcode.StoreGlobal if value == Opcode::STORE_GLOBAL
            return DebuggerEDIR::Opcode.LoadMemory if value == Opcode::LOAD_MEMORY
            return DebuggerEDIR::Opcode.StoreMemory if value == Opcode::STORE_MEMORY
            return DebuggerEDIR::Opcode.Allocate if value == Opcode::ALLOCATE
            return DebuggerEDIR::Opcode.Multiply if value == Opcode::MULTIPLY
            return DebuggerEDIR::Opcode.Divide if value == Opcode::DIVIDE
            return DebuggerEDIR::Opcode.Negate if value == Opcode::NEGATE
            return DebuggerEDIR::Opcode.CompareEqual if value == Opcode::COMPARE_EQUAL
            return DebuggerEDIR::Opcode.CompareLess if value == Opcode::COMPARE_LESS
            return DebuggerEDIR::Opcode.Jump if value == Opcode::JUMP
            return DebuggerEDIR::Opcode.BranchZero if value == Opcode::BRANCH_ZERO
            return DebuggerEDIR::Opcode.Call if value == Opcode::CALL
            return DebuggerEDIR::Opcode.Return if value == Opcode::RETURN
            return DebuggerEDIR::Opcode.Nop

        def put_source(writer: DebuggerTraceBinary::ByteWriter, source: DebuggerIdentity::SourceSpan) -> DebuggerTraceBinary::ByteWriter:
            updated: mutable DebuggerTraceBinary::ByteWriter = writer
            updated <- DebuggerTraceBinary::writer_put_u64(updated, source.file.value)
            updated <- DebuggerTraceBinary::writer_put_u64(updated, source.start_byte)
            updated <- DebuggerTraceBinary::writer_put_u64(updated, source.end_byte)
            updated <- DebuggerTraceBinary::writer_put_u32(updated, source.start_line)
            updated <- DebuggerTraceBinary::writer_put_u32(updated, source.start_column)
            updated <- DebuggerTraceBinary::writer_put_u32(updated, source.end_line)
            updated <- DebuggerTraceBinary::writer_put_u32(updated, source.end_column)
            updated <- DebuggerTraceBinary::writer_put_u32(updated, source.discriminator)
            return updated

        def take_source(reader: mutable DebuggerTraceBinary::ByteReader&) -> DebuggerIdentity::SourceSpan:
            return DebuggerIdentity::SourceSpan{
                file: DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader)),
                start_byte: DebuggerTraceBinary::reader_take_u64(reader),
                end_byte: DebuggerTraceBinary::reader_take_u64(reader),
                start_line: DebuggerTraceBinary::reader_take_u32(reader),
                start_column: DebuggerTraceBinary::reader_take_u32(reader),
                end_line: DebuggerTraceBinary::reader_take_u32(reader),
                end_column: DebuggerTraceBinary::reader_take_u32(reader),
                discriminator: DebuggerTraceBinary::reader_take_u32(reader)
            }

        def put_source_file(writer: DebuggerTraceBinary::ByteWriter, file: DebuggerMetadata::SourceFile) -> DebuggerTraceBinary::ByteWriter:
            updated: mutable DebuggerTraceBinary::ByteWriter = writer
            updated <- DebuggerTraceBinary::writer_put_u64(updated, file.id.value)
            updated <- DebuggerTraceBinary::writer_put_u64(updated, file.logical_path.value)
            updated <- DebuggerTraceBinary::writer_put_u64(updated, file.content.value)
            updated <- DebuggerTraceBinary::writer_put_u64(updated, file.line_count)
            updated <- DebuggerTraceBinary::writer_put_u32(updated, file.path_length.u32())
            for index in 0..<file.path_length:
                updated <- DebuggerTraceBinary::writer_put_byte(updated, file.path_bytes[index])
            return updated

        def take_source_file(reader: mutable DebuggerTraceBinary::ByteReader&, valid: mutable bool&) -> DebuggerMetadata::SourceFile:
            file: mutable DebuggerMetadata::SourceFile = zeroed
            file.id <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            file.logical_path <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            file.content <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            file.line_count <- DebuggerTraceBinary::reader_take_u64(reader)
            path_length: u32 = DebuggerTraceBinary::reader_take_u32(reader)
            valid <- false if path_length == 0 or path_length.usize() > Edir::CODEC_SOURCE_PATH_CAPACITY
            if path_length.usize() <= Edir::CODEC_SOURCE_PATH_CAPACITY:
                file.path_length <- path_length.usize()
                for index in 0..<file.path_length:
                    file.path_bytes[index] <- DebuggerTraceBinary::reader_take_byte(reader)
            return file

        def put_function(writer: DebuggerTraceBinary::ByteWriter, function: DebuggerEDIR::FunctionDescriptor) -> DebuggerTraceBinary::ByteWriter:
            updated: mutable DebuggerTraceBinary::ByteWriter = writer
            updated <- DebuggerTraceBinary::writer_put_u64(updated, function.id.value)
            updated <- DebuggerTraceBinary::writer_put_u64(updated, function.entry_instruction)
            updated <- DebuggerTraceBinary::writer_put_u64(updated, function.end_instruction_exclusive)
            updated <- put_source(updated, function.source)
            updated <- DebuggerTraceBinary::writer_put_u32(updated, function.name_length.u32())
            for index in 0..<function.name_length:
                updated <- DebuggerTraceBinary::writer_put_byte(updated, function.name_bytes[index])
            return updated

        def take_function(reader: mutable DebuggerTraceBinary::ByteReader&, valid: mutable bool&) -> DebuggerEDIR::FunctionDescriptor:
            function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
            function.id <- DebuggerIdentity::debug_id(DebuggerTraceBinary::reader_take_u64(reader))
            function.entry_instruction <- DebuggerTraceBinary::reader_take_u64(reader)
            function.end_instruction_exclusive <- DebuggerTraceBinary::reader_take_u64(reader)
            function.source <- take_source(reader)
            name_length: u32 = DebuggerTraceBinary::reader_take_u32(reader)
            valid <- false if name_length == 0 or name_length.usize() > Edir::CODEC_FUNCTION_NAME_CAPACITY
            if name_length.usize() <= Edir::CODEC_FUNCTION_NAME_CAPACITY:
                function.name_length <- name_length.usize()
                for index in 0..<function.name_length:
                    function.name_bytes[index] <- DebuggerTraceBinary::reader_take_byte(reader)
            return function

    public:
        struct ArtifactFingerprint:
            value: mutable u64
            valid: mutable bool

        struct DecodeResult:
            image: mutable DebuggerEDIR::ProgramImage
            valid: mutable bool

        def artifact_max_instruction_count() -> usize:
            return Edir::CODEC_MAX_INSTRUCTIONS

        def artifact_max_source_file_count() -> usize:
            return Edir::CODEC_MAX_SOURCE_FILES

        def artifact_max_function_count() -> usize:
            return Edir::CODEC_MAX_FUNCTIONS

        def artifact_function_name_capacity() -> usize:
            return Edir::CODEC_FUNCTION_NAME_CAPACITY

        def artifact_source_path_capacity() -> usize:
            return Edir::CODEC_SOURCE_PATH_CAPACITY

        def artifact_max_bytes() -> usize:
            return Edir::CODEC_MAX_BYTES

        def artifact_encode_internal(image: mutable DebuggerEDIR::ProgramImage&, require_source_table: bool) -> DebuggerTraceBinary::ByteWriter:
            writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
            verification: mutable DebuggerEDIR::Verification = DebuggerEDIR::verify_image(image)
            verification <- DebuggerEDIR::verify_image_with_source_table(image) if require_source_table or image.source_file_count > 0 or image.function_count > 0
            if not verification.valid or image.program.instruction_count > Edir::CODEC_MAX_INSTRUCTIONS.u64():
                writer.failed <- true
                return writer
            writer <- DebuggerTraceBinary::writer_put_u32(writer, Edir::CODEC_SCHEMA)
            writer <- DebuggerTraceBinary::writer_put_u32(writer, image.program.version)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, image.program.instruction_count)
            writer <- DebuggerTraceBinary::writer_put_u64(writer, image.program.local_count)
            has_return: mutable u8 = Boolean::VM_EDIR_CODEC_BOOLEAN_FALSE
            has_return <- Boolean::VM_EDIR_CODEC_BOOLEAN_TRUE if image.program.has_return
            writer <- DebuggerTraceBinary::writer_put_byte(writer, has_return)
            writer <- DebuggerTraceBinary::writer_put_u32(writer, image.source_file_count.u32())
            for index in 0..<image.source_file_count:
                writer <- put_source_file(writer, image.source_files[index])
            for index in 0..<image.program.instruction_count.usize():
                instruction: DebuggerEDIR::Instruction = image.instructions[index]
                writer <- DebuggerTraceBinary::writer_put_u16(writer, instruction.opcode.u16())
                writer <- DebuggerTraceBinary::writer_put_u64(writer, instruction.a.u64())
                writer <- DebuggerTraceBinary::writer_put_u64(writer, instruction.b.u64())
                writer <- put_source(writer, instruction.source)
            writer <- DebuggerTraceBinary::writer_put_u32(writer, image.function_count.u32())
            for index in 0..<image.function_count:
                writer <- put_function(writer, image.functions[index])
            return writer

        def artifact_encode(image: mutable DebuggerEDIR::ProgramImage&) -> DebuggerTraceBinary::ByteWriter:
            return artifact_encode_internal(image, true)

        # Fingerprints are derived only from the complete, validated canonical
        # artifact. The validity bit distinguishes a rejected/overflowed image
        # from a legitimate checksum whose numeric value happens to be zero.
        def artifact_fingerprint(image: mutable DebuggerEDIR::ProgramImage&) -> ArtifactFingerprint:
            # Synthetic managed images may intentionally omit a source table;
            # they are still valid executable EDIR and need a stable checkpoint
            # identity. Fingerprinting uses the same canonical bytes while the
            # public artifact encoder keeps its stricter metadata boundary.
            encoded: DebuggerTraceBinary::ByteWriter = artifact_encode_internal(image, false)
            valid: bool = DebuggerTraceBinary::writer_is_valid(encoded)
            return ArtifactFingerprint{value: DebuggerTraceBinary::writer_checksum(encoded), valid: valid}

        def artifact_decode(reader: mutable DebuggerTraceBinary::ByteReader&) -> DecodeResult:
            result: mutable DecodeResult = zeroed
            schema: u32 = DebuggerTraceBinary::reader_take_u32(reader)
            result.image.program.version <- DebuggerTraceBinary::reader_take_u32(reader)
            result.image.program.instruction_count <- DebuggerTraceBinary::reader_take_u64(reader)
            result.image.program.local_count <- DebuggerTraceBinary::reader_take_u64(reader)
            has_return: u8 = DebuggerTraceBinary::reader_take_byte(reader)
            result.image.program.has_return <- has_return == Boolean::VM_EDIR_CODEC_BOOLEAN_TRUE
            source_file_count: u32 = DebuggerTraceBinary::reader_take_u32(reader)
            decode_valid: mutable bool = (schema == Edir::CODEC_SCHEMA or schema == Edir::CODEC_LEGACY_SCHEMA) and has_return <= Boolean::VM_EDIR_CODEC_BOOLEAN_TRUE
            decode_valid <- false if result.image.program.instruction_count > Edir::CODEC_MAX_INSTRUCTIONS.u64()
            decode_valid <- false if source_file_count.usize() > Edir::CODEC_MAX_SOURCE_FILES
            if decode_valid:
                result.image.source_file_count <- source_file_count.usize()
                for index in 0..<result.image.source_file_count:
                    result.image.source_files[index] <- take_source_file(reader, decode_valid)
                for index in 0..<result.image.program.instruction_count.usize():
                    opcode_valid: mutable bool = true
                    opcode: DebuggerEDIR::Opcode = opcode_from_u16(DebuggerTraceBinary::reader_take_u16(reader), opcode_valid)
                    result.image.instructions[index] <- DebuggerEDIR::Instruction{
                        opcode: opcode,
                        a: DebuggerTraceBinary::reader_take_u64(reader).i64(),
                        b: DebuggerTraceBinary::reader_take_u64(reader).i64(),
                        source: take_source(reader)
                    }
                    decode_valid <- false if not opcode_valid
                if schema == Edir::CODEC_SCHEMA:
                    function_count: u32 = DebuggerTraceBinary::reader_take_u32(reader)
                    decode_valid <- false if function_count.usize() > Edir::CODEC_MAX_FUNCTIONS
                    if decode_valid:
                        result.image.function_count <- function_count.usize()
                        for index in 0..<result.image.function_count:
                            result.image.functions[index] <- take_function(reader, decode_valid)
            decode_valid <- false if not DebuggerTraceBinary::reader_is_valid(reader) or reader.offset != reader.length
            verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image_with_source_table(result.image)
            result.valid <- decode_valid and verification.valid
            result.image <- zeroed if not result.valid
            return result

        def artifact_is_valid(reader: DebuggerTraceBinary::ByteReader) -> bool:
            return false if reader.length < Edir::CODEC_HEADER_BYTES or reader.length > Edir::CODEC_MAX_BYTES
            copy: mutable DebuggerTraceBinary::ByteReader = reader
            decoded: DecodeResult = artifact_decode(copy)
            return decoded.valid
