# Recording-side failures must remain visible after a caller switches an
# adapter into replay mode.

include "../src/replay/adapters.elisa"

const module Test:
    const module Bounds:
        FIRST_INDEX: usize = 0
        EMPTY_COUNT: usize = 0
        ZERO_SAMPLE: u64 = 0
        SINGLE_BYTE_BUFFER: usize = 1

    const module Values:
        SOURCE_ID: u64 = 7
        BYTE: u8 = 1
        EMPTY_RECORDING_CLOCK_SAMPLE: u64 = 1
        EMPTY_RECORDING_RANDOM_SAMPLE: u64 = 2
        EMPTY_RECORDING_SAMPLE_LENGTH: usize = 1
        RECORDING_STARTS_EXACT: bool = true

    const module Failure:
        CLOCK_STARTS_INEXACT: i64 = 12
        CLOCK_SAMPLE_REJECTED: i64 = 1
        CLOCK_OVERFLOW_ACCEPTED: i64 = 2
        CLOCK_OVERFLOW_EXACT: i64 = 3
        RANDOM_STARTS_INEXACT: i64 = 13
        RANDOM_SAMPLE_REJECTED: i64 = 4
        RANDOM_OVERFLOW_ACCEPTED: i64 = 5
        RANDOM_OVERFLOW_EXACT: i64 = 6
        CONSOLE_STARTS_INEXACT: i64 = 14
        CONSOLE_SAMPLE_REJECTED: i64 = 7
        CONSOLE_OVERFLOW_ACCEPTED: i64 = 8
        CONSOLE_OVERFLOW_EXACT: i64 = 9
        CONSOLE_EMPTY_INPUT_REJECTED: i64 = 10
        CONSOLE_EMPTY_INPUT_RESULT: i64 = 11
        EMPTY_RECORDING_SNAPSHOT: i64 = 15
        EMPTY_RECORDING_MODES: i64 = 16
        EMPTY_RECORDING_SAMPLE: i64 = 17
        EMPTY_RECORDING_UPDATE: i64 = 18
        RECORDING_OUTPUT_MUST_PASS_THROUGH: i64 = 19
        SUCCESS: i64 = 0

def main() -> i64:
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::Values::SOURCE_ID)
    clock: mutable DebuggerReplayAdapters::Clock = zeroed
    DebuggerReplayAdapters::clock_initialize(clock, DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::Failure::CLOCK_STARTS_INEXACT if clock.exact != Test::Values::RECORDING_STARTS_EXACT
    for index in Test::Bounds::FIRST_INDEX..<DebuggerReplayAdapters::Limits::SAMPLE_CAPACITY:
        return Test::Failure::CLOCK_SAMPLE_REJECTED if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record(clock, source, index.u64()))
    return Test::Failure::CLOCK_OVERFLOW_ACCEPTED if DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record(clock, source, Test::Bounds::ZERO_SAMPLE))
    clock.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    return Test::Failure::CLOCK_OVERFLOW_EXACT if DebuggerReplayAdapters::clock_is_exact(clock)
    random: mutable DebuggerReplayAdapters::Random = zeroed
    DebuggerReplayAdapters::random_initialize(random, DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::Failure::RANDOM_STARTS_INEXACT if random.exact != Test::Values::RECORDING_STARTS_EXACT
    for index in Test::Bounds::FIRST_INDEX..<DebuggerReplayAdapters::Limits::SAMPLE_CAPACITY:
        return Test::Failure::RANDOM_SAMPLE_REJECTED if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::random_record(random, source, index.u64()))
    return Test::Failure::RANDOM_OVERFLOW_ACCEPTED if DebuggerErrors::error_is_ok(DebuggerReplayAdapters::random_record(random, source, Test::Bounds::ZERO_SAMPLE))
    random.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    return Test::Failure::RANDOM_OVERFLOW_EXACT if DebuggerReplayAdapters::random_is_exact(random)
    bytes: mutable u8[DebuggerReplayAdapters::Limits::CONSOLE_CHUNK_CAPACITY] = zeroed
    bytes[Test::Bounds::FIRST_INDEX] <- Test::Values::BYTE
    console: mutable DebuggerReplayAdapters::Console = zeroed
    DebuggerReplayAdapters::console_initialize(console, DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::Failure::CONSOLE_STARTS_INEXACT if console.exact != Test::Values::RECORDING_STARTS_EXACT
    for index in Test::Bounds::FIRST_INDEX..<DebuggerReplayAdapters::Limits::CONSOLE_RECORD_CAPACITY:
        return Test::Failure::CONSOLE_SAMPLE_REJECTED if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[Test::Bounds::FIRST_INDEX], Test::Bounds::SINGLE_BYTE_BUFFER))
    return Test::Failure::CONSOLE_OVERFLOW_ACCEPTED if DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[Test::Bounds::FIRST_INDEX], Test::Bounds::SINGLE_BYTE_BUFFER))
    console.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    return Test::Failure::CONSOLE_OVERFLOW_EXACT if DebuggerReplayAdapters::console_is_exact(console)
    zero_console: mutable DebuggerReplayAdapters::Console = zeroed
    DebuggerReplayAdapters::console_initialize(zero_console, DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::Failure::CONSOLE_EMPTY_INPUT_REJECTED if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(zero_console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[Test::Bounds::FIRST_INDEX], Test::Bounds::EMPTY_COUNT))
    zero_console.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    zero_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(zero_console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[Test::Bounds::FIRST_INDEX], Test::Bounds::EMPTY_COUNT)
    return Test::Failure::CONSOLE_EMPTY_INPUT_RESULT if not zero_read.accepted or zero_read.eof or zero_read.transferred != Test::Bounds::EMPTY_COUNT

    empty_recording: mutable DebuggerReplayAdapters::AdapterSnapshot = zeroed
    DebuggerReplayAdapters::adapter_snapshot_initialize_recording(empty_recording)
    return Test::Failure::EMPTY_RECORDING_SNAPSHOT if not DebuggerReplayAdapters::adapter_snapshot_is_valid(empty_recording)
    empty_recording.console.output_suppressed <- true
    return Test::Failure::RECORDING_OUTPUT_MUST_PASS_THROUGH if DebuggerReplayAdapters::adapter_snapshot_is_valid(empty_recording)
    empty_recording.console.output_suppressed <- false
    return Test::Failure::EMPTY_RECORDING_MODES if empty_recording.clock.count != Test::Bounds::EMPTY_COUNT or empty_recording.random.count != Test::Bounds::EMPTY_COUNT or empty_recording.console.count != Test::Bounds::EMPTY_COUNT or empty_recording.clock.mode != DebuggerReplayAdapters::AdapterMode.Recording or empty_recording.random.mode != DebuggerReplayAdapters::AdapterMode.Recording or empty_recording.console.mode != DebuggerReplayAdapters::AdapterMode.Recording
    return Test::Failure::EMPTY_RECORDING_SAMPLE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record(empty_recording.clock, source, Test::Values::EMPTY_RECORDING_CLOCK_SAMPLE)) or not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::random_record(empty_recording.random, source, Test::Values::EMPTY_RECORDING_RANDOM_SAMPLE)) or not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(empty_recording.console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[Test::Bounds::FIRST_INDEX], Test::Values::EMPTY_RECORDING_SAMPLE_LENGTH))
    return Test::Failure::EMPTY_RECORDING_UPDATE if not DebuggerReplayAdapters::adapter_snapshot_is_valid(empty_recording)
    return Test::Failure::SUCCESS
