# Recording-side failures must remain visible after a caller switches an
# adapter into replay mode.

include "../src/replay/adapters.elisa"

const module Test:
    CAPACITY: usize = 128
    CONSOLE_CAPACITY: usize = 64
    SOURCE: u64 = 7
    BYTE: u8 = 1
    EMPTY_RECORDING_SNAPSHOT_FAILURE: i64 = 15
    EMPTY_RECORDING_MODES_FAILURE: i64 = 16
    EMPTY_RECORDING_SAMPLE_FAILURE: i64 = 17
    EMPTY_RECORDING_UPDATE_FAILURE: i64 = 18
    RECORDING_STARTS_EXACT: bool = true
    EMPTY_RECORDING_CLOCK_SAMPLE_VALUE: u64 = 1
    EMPTY_RECORDING_RANDOM_SAMPLE_VALUE: u64 = 2
    EMPTY_RECORDING_SAMPLE_LENGTH: usize = 1
    EMPTY_RECORDING_SAMPLE_COUNT: usize = 0


def main() -> i64:
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::SOURCE)
    clock: mutable DebuggerReplayAdapters::Clock = zeroed
    DebuggerReplayAdapters::clock_initialize(clock, DebuggerReplayAdapters::AdapterMode.Recording)
    return 12 if clock.exact != Test::RECORDING_STARTS_EXACT
    for index in 0..<Test::CAPACITY:
        return 1 if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record(clock, source, index.u64()))
    return 2 if DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record(clock, source, 0))
    clock.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    return 3 if DebuggerReplayAdapters::clock_is_exact(clock)
    random: mutable DebuggerReplayAdapters::Random = zeroed
    DebuggerReplayAdapters::random_initialize(random, DebuggerReplayAdapters::AdapterMode.Recording)
    return 13 if random.exact != Test::RECORDING_STARTS_EXACT
    for index in 0..<Test::CAPACITY:
        return 4 if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::random_record(random, source, index.u64()))
    return 5 if DebuggerErrors::error_is_ok(DebuggerReplayAdapters::random_record(random, source, 0))
    random.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    return 6 if DebuggerReplayAdapters::random_is_exact(random)
    bytes: mutable u8[1] = [Test::BYTE]
    console: mutable DebuggerReplayAdapters::Console = zeroed
    DebuggerReplayAdapters::console_initialize(console, DebuggerReplayAdapters::AdapterMode.Recording)
    return 14 if console.exact != Test::RECORDING_STARTS_EXACT
    for index in 0..<Test::CONSOLE_CAPACITY:
        return 7 if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[0], 1))
    return 8 if DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[0], 1))
    console.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    return 9 if DebuggerReplayAdapters::console_is_exact(console)
    zero_console: mutable DebuggerReplayAdapters::Console = zeroed
    DebuggerReplayAdapters::console_initialize(zero_console, DebuggerReplayAdapters::AdapterMode.Recording)
    return 10 if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(zero_console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[0], 0))
    zero_console.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    zero_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(zero_console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[0], 0)
    return 11 if not zero_read.accepted or zero_read.eof or zero_read.transferred != 0

    empty_recording: mutable DebuggerReplayAdapters::AdapterSnapshot = zeroed
    DebuggerReplayAdapters::adapter_snapshot_initialize_recording(empty_recording)
    return Test::EMPTY_RECORDING_SNAPSHOT_FAILURE if not DebuggerReplayAdapters::adapter_snapshot_is_valid(empty_recording)
    return Test::EMPTY_RECORDING_MODES_FAILURE if empty_recording.clock.count != Test::EMPTY_RECORDING_SAMPLE_COUNT or empty_recording.random.count != Test::EMPTY_RECORDING_SAMPLE_COUNT or empty_recording.console.count != Test::EMPTY_RECORDING_SAMPLE_COUNT or empty_recording.clock.mode != DebuggerReplayAdapters::AdapterMode.Recording or empty_recording.random.mode != DebuggerReplayAdapters::AdapterMode.Recording or empty_recording.console.mode != DebuggerReplayAdapters::AdapterMode.Recording
    return Test::EMPTY_RECORDING_SAMPLE_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record(empty_recording.clock, source, Test::EMPTY_RECORDING_CLOCK_SAMPLE_VALUE)) or not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::random_record(empty_recording.random, source, Test::EMPTY_RECORDING_RANDOM_SAMPLE_VALUE)) or not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(empty_recording.console, DebuggerReplayAdapters::ConsoleChannel.Stdout, bytes[0], Test::EMPTY_RECORDING_SAMPLE_LENGTH))
    return Test::EMPTY_RECORDING_UPDATE_FAILURE if not DebuggerReplayAdapters::adapter_snapshot_is_valid(empty_recording)
    return 0
