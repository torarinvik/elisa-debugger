include "../src/replay/compare.elisa"
include "../src/concurrency/exploration.elisa"
include "../src/vm/edir.elisa"
include "../src/core/identity.elisa"

const module Test:
    PROGRAM_VERSION: u32 = 1
    INSTRUCTION_COUNT: u64 = 2
    RECORDING_ID: u64 = 1
    TASK_ONE: u64 = 1
    TASK_TWO: u64 = 2
    ALLOCATION_ID: u64 = 3
    SECOND_RECORDING_ID: u64 = 2
    TASK_LIMIT_ONE: u64 = 1
    PREEMPTION_LIMIT_ONE: u64 = 1
    EVENT_LIMIT_ONE: u64 = 1
    BRANCH_LIMIT_ONE: u64 = 1
    RACE_RESULT: i64 = 1
    COMPARE_RESULT: i64 = 2
    DISTINCT_CONSTANT: i64 = 8
    HIGH_TASK_CLOCK_INDEX: usize = 63


def main() -> i64:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::INSTRUCTION_COUNT, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 7, b: 0, source: zeroed}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    left: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(Test::RECORDING_ID))
    right: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(Test::RECORDING_ID))
    DebuggerReplayEngine::replay_engine_run(left, 4)
    DebuggerReplayEngine::replay_engine_run(right, 4)
    comparison: DebuggerReplayCompare::BranchComparison = DebuggerReplayCompare::compare_engines(left, right)
    return Test::COMPARE_RESULT if not comparison.exact or not DebuggerReplayCompare::comparison_is_valid(comparison)
    distinct_image: mutable DebuggerEDIR::ProgramImage = image
    distinct_image.instructions[0].a <- Test::DISTINCT_CONSTANT
    distinct_event: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(distinct_image, DebuggerIdentity::debug_id(Test::RECORDING_ID))
    DebuggerReplayEngine::replay_engine_run(distinct_event, 4)
    distinct_comparison: DebuggerReplayCompare::BranchComparison = DebuggerReplayCompare::compare_engines(left, distinct_event)
    return Test::COMPARE_RESULT if distinct_comparison.exact or distinct_comparison.first_divergence != 0
    other_recording: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(Test::SECOND_RECORDING_ID))
    DebuggerReplayEngine::replay_engine_run(other_recording, 4)
    cross_recording: DebuggerReplayCompare::BranchComparison = DebuggerReplayCompare::compare_engines(left, other_recording)
    return Test::COMPARE_RESULT if cross_recording.exact or cross_recording.failure.code != DebuggerErrors::ErrorCode.InvalidArgument or not DebuggerReplayCompare::comparison_is_valid(cross_recording)
    task_one: DebuggerConcurrency::TaskInfo = DebuggerConcurrency::TaskInfo{id: DebuggerIdentity::debug_id(Test::TASK_ONE), parent: DebuggerIdentity::debug_id(0), state: DebuggerConcurrency::TaskState.Runnable, logical_time: 1, os_thread: 1}
    task_two: DebuggerConcurrency::TaskInfo = DebuggerConcurrency::TaskInfo{id: DebuggerIdentity::debug_id(Test::TASK_TWO), parent: DebuggerIdentity::debug_id(0), state: DebuggerConcurrency::TaskState.Runnable, logical_time: 1, os_thread: 2}
    tasks: mutable DebuggerConcurrency::TaskInfo[32] = zeroed
    tasks[0] <- task_one
    tasks[1] <- task_two
    scheduler: mutable DebuggerScheduler::DeterministicScheduler = DebuggerScheduler::scheduler_new(false)
    scheduler <- DebuggerScheduler::scheduler_append(scheduler, DebuggerScheduler::ScheduleDecision{ordinal: 0, task: task_one, kind: DebuggerScheduler::ScheduleKind.Run, synchronization: 0})
    explored: DebuggerConcurrencyExploration::ExplorationResult = DebuggerConcurrencyExploration::explore_schedules(scheduler, tasks, 2, DebuggerConcurrencyExploration::exploration_limits_default())
    return 3 if explored.count == 0 or explored.bounded
    zero_exploration_limits: DebuggerConcurrencyExploration::ExplorationLimits = DebuggerConcurrencyExploration::ExplorationLimits{max_tasks: 2, max_preemptions: 0, max_events: 1, max_branches: 1}
    rejected_exploration: DebuggerConcurrencyExploration::ExplorationResult = DebuggerConcurrencyExploration::explore_schedules(scheduler, tasks, 2, zero_exploration_limits)
    return 4 if rejected_exploration.failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    task_limited: DebuggerConcurrencyExploration::ExplorationLimits = DebuggerConcurrencyExploration::ExplorationLimits{max_tasks: Test::TASK_LIMIT_ONE, max_preemptions: Test::PREEMPTION_LIMIT_ONE, max_events: Test::EVENT_LIMIT_ONE, max_branches: Test::BRANCH_LIMIT_ONE}
    task_limited_result: DebuggerConcurrencyExploration::ExplorationResult = DebuggerConcurrencyExploration::explore_schedules(scheduler, tasks, 2, task_limited)
    return 5 if task_limited_result.failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    clock_one: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_tick(DebuggerConcurrencyAnalysis::vector_clock_new(), 0)
    clock_two: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_tick(DebuggerConcurrencyAnalysis::vector_clock_new(), 1)
    high_task_clock: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_tick(DebuggerConcurrencyAnalysis::vector_clock_new(), Test::HIGH_TASK_CLOCK_INDEX)
    later_high_task_clock: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_tick(high_task_clock, Test::HIGH_TASK_CLOCK_INDEX)
    return 6 if not DebuggerConcurrencyAnalysis::vector_clock_happens_before(high_task_clock, later_high_task_clock)
    records: mutable DebuggerConcurrencyExploration::AccessRecord[256] = zeroed
    records[0] <- DebuggerConcurrencyExploration::AccessRecord{event: 1, task: task_one.id, allocation: DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(Test::ALLOCATION_ID), generation: 1, offset: 0}, write: true, clock: clock_one}
    records[1] <- DebuggerConcurrencyExploration::AccessRecord{event: 2, task: task_two.id, allocation: DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(Test::ALLOCATION_ID), generation: 1, offset: 0}, write: false, clock: clock_two}
    race: DebuggerConcurrencyExploration::RaceResult = DebuggerConcurrencyExploration::find_observed_race(records, 2)
    return Test::RACE_RESULT if not race.race
    equal_clock: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_new()
    equal_clock_records: mutable DebuggerConcurrencyExploration::AccessRecord[256] = zeroed
    equal_clock_records[0] <- DebuggerConcurrencyExploration::AccessRecord{event: 3, task: task_one.id, allocation: DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(Test::ALLOCATION_ID), generation: 1, offset: 0}, write: true, clock: equal_clock}
    equal_clock_records[1] <- DebuggerConcurrencyExploration::AccessRecord{event: 4, task: task_two.id, allocation: DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(Test::ALLOCATION_ID), generation: 1, offset: 0}, write: false, clock: equal_clock}
    equal_clock_race: DebuggerConcurrencyExploration::RaceResult = DebuggerConcurrencyExploration::find_observed_race(equal_clock_records, 2)
    return Test::RACE_RESULT if not equal_clock_race.race
    return 0
