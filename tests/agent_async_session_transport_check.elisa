include "../src/agent/async_session.elisa"

const module Argument:
    PARENT_COUNT: i64 = 4
    CHILD_COUNT: i64 = 2
    FIRST_ARGUMENT: usize = 0
    CHILD_MODE_INDEX: usize = 1
    ARGUMENT_TERMINATOR_INDEX: usize = 2
    PARENT_MODE_INDEX: usize = 1
    PARENT_RESERVED_FIRST_INDEX: usize = 2
    PARENT_RESERVED_SECOND_INDEX: usize = 3
    CHILD_SWITCH: cstr = "--agent-session-child"
    PARENT_MODE: cstr = "--agent-session-parent"
    RESERVED_FIRST: cstr = "reserved-first"
    RESERVED_SECOND: cstr = "reserved-second"
    CHANNEL_DESCRIPTOR: i32 = 3
    MINIMUM_CHANNEL_DESCRIPTOR: i32 = 3
    NULL_TERMINATOR: u8 = 0
    INDEX_INCREMENT: usize = 1
    NULL_POINTER_VALUE: usize = 0
    NO_PROCESS_ID: i32 = 0

const module Frame:
    FRAME_CAPACITY: usize = 32
    FRAME_LENGTH: usize = 32
    FIRST_BYTE: usize = 0
    EMPTY_LENGTH: usize = 0

const module TestAgent:
    PROTOCOL_MAJOR: u32 = 1
    PROTOCOL_MINOR: u32 = 4
    BUILD: u64 = 11
    TARGET: u64 = 22
    CAPABILITIES: u64 = 31
    REQUIRED_CAPABILITIES: u64 = 3
    ZERO_EVENT_COUNT: u64 = 0

const module TestAsync:
    NOW_NS: u64 = 1
    DEADLINE_NS: u64 = 1000000000000
    TIMEOUT_NS: u64 = 2
    MAX_POLL_CALLS: usize = 1000000
    FIRST_POLL_CALL: usize = 0
    POLL_CALL_INCREMENT: usize = 1

const module TestResult:
    CHILD_MODE_FAILURE: i64 = 1
    CHILD_READ_FAILURE: i64 = 2
    CHILD_HELLO_DECODE_FAILURE: i64 = 3
    CHILD_HELLO_ENCODE_FAILURE: i64 = 4
    CHILD_HELLO_SEND_FAILURE: i64 = 5
    CHILD_STOP_DECODE_FAILURE: i64 = 6
    CHILD_STOP_APPLY_FAILURE: i64 = 7
    CHILD_ACK_ENCODE_FAILURE: i64 = 8
    CHILD_ACK_SEND_FAILURE: i64 = 9
    CHILD_RESUME_DECODE_FAILURE: i64 = 10
    CHILD_RESUME_APPLY_FAILURE: i64 = 11
    CHILD_CLOSE_FAILURE: i64 = 12
    PARENT_ARGUMENT_FAILURE: i64 = 13
    PARENT_LAUNCH_FAILURE: i64 = 14
    PARENT_CHANNEL_FAILURE: i64 = 15
    PARENT_HANDSHAKE_FAILURE: i64 = 16
    PARENT_CONTROLLER_FAILURE: i64 = 17
    MISSING_CAPABILITY_FAILURE: i64 = 18
    PARENT_RESUME_FAILURE: i64 = 20
    PARENT_WAIT_FAILURE: i64 = 21
    PARENT_CLOSE_FAILURE: i64 = 22
    CHILD_CONTROL_ACK_ENCODE_FAILURE: i64 = 23
    CHILD_CONTROL_ACK_SEND_FAILURE: i64 = 24
    CHILD_RESUME_ACK_ENCODE_FAILURE: i64 = 25
    CHILD_RESUME_ACK_SEND_FAILURE: i64 = 26
    PARENT_PAUSE_SESSION_STATUS_FAILURE: i64 = 28
    PARENT_PAUSE_CONTROLLER_STATUS_FAILURE: i64 = 29
    PARENT_PAUSE_INSPECTION_FAILURE: i64 = 30
    PARENT_PAUSE_TRANSPORT_FAILURE: i64 = 31
    PARENT_PAUSE_WIRE_FAILURE: i64 = 32
    PARENT_PAUSE_RESPONSE_FAILURE: i64 = 33
    PARENT_PAUSE_AGENT_FAILURE: i64 = 34
    PARENT_PAUSE_CONTROLLER_FAILURE: i64 = 35
    CHILD_SAFE_POINT_FAILURE: i64 = 36
    PARENT_ASYNC_HANDSHAKE_BEGIN_FAILURE: i64 = 37
    PARENT_ASYNC_HANDSHAKE_FAILURE: i64 = 38
    PARENT_ASYNC_STATE_FAILURE: i64 = 39
    PARENT_ASYNC_PAUSE_BEGIN_FAILURE: i64 = 40
    PARENT_ASYNC_PAUSE_FAILURE: i64 = 41
    PARENT_ASYNC_RESUME_BEGIN_FAILURE: i64 = 42
    PARENT_ASYNC_RESUME_FAILURE: i64 = 43
    PARENT_ASYNC_TIMEOUT_VALIDATION_FAILURE: i64 = 44
    PARENT_ASYNC_INTEREST_FAILURE: i64 = 45
    PARENT_ASYNC_TIMEOUT_FAILURE: i64 = 46
    PARENT_ASYNC_CANCEL_FAILURE: i64 = 47
    SUCCESS: i64 = 0

def test_cstr_equal(left: cstr, right: cstr) -> bool:
    index: mutable usize = Frame::EMPTY_LENGTH
    while left[index].u8() == right[index].u8():
        return true if left[index].u8() == Argument::NULL_TERMINATOR
        index <- index + Argument::INDEX_INCREMENT
    return false

def read_frame(session: mutable DebuggerLocalAgentTransport::LocalAgentSession&, bytes: mutable u8&, expected_length: usize) -> bool can[Blocking.IO, Unsafe.PointerCast]:
    received_total: mutable usize = Frame::EMPTY_LENGTH
    while received_total < expected_length:
        transfer: DebuggerLocalAgentTransport::TransferResult = DebuggerLocalAgentTransport::local_agent_channel_receive(session, bytes[received_total], expected_length - received_total) can Blocking.IO, Unsafe.PointerCast
        return false if transfer.status != DebuggerLocalAgentTransport::TransportStatus.Ready or transfer.bytes_transferred == Frame::EMPTY_LENGTH
        received_total <- received_total + transfer.bytes_transferred
    return true

def drive_async_operation(async_session: mutable DebuggerAgentAsyncSession::AsyncSession&, transport: mutable DebuggerLocalAgentTransport::LocalAgentSession&, controller: mutable DebuggerNative::NativeController&) -> DebuggerAgentAsyncSession::AsyncResult can[Unsafe.PointerCast]:
    result: mutable DebuggerAgentAsyncSession::AsyncResult = zeroed
    result.status <- DebuggerAgentAsyncSession::AsyncStatus.Pending
    poll_calls: mutable usize = TestAsync::FIRST_POLL_CALL
    while result.status == DebuggerAgentAsyncSession::AsyncStatus.Pending and poll_calls < TestAsync::MAX_POLL_CALLS:
        result <- DebuggerAgentAsyncSession::async_session_poll(async_session, transport, controller, TestAsync::NOW_NS) can Unsafe.PointerCast
        poll_calls <- poll_calls + TestAsync::POLL_CALL_INCREMENT
    return result

def child_main(argc: i64) -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    return TestResult::CHILD_MODE_FAILURE if argc != Argument::CHILD_COUNT
    session: mutable DebuggerLocalAgentTransport::LocalAgentSession = zeroed
    DebuggerLocalAgentTransport::local_agent_session_initialize(session)
    adoption: DebuggerLocalAgentTransport::TransportStatus = DebuggerLocalAgentTransport::local_agent_channel_adopt(session, Argument::CHANNEL_DESCRIPTOR) can Blocking.IO, Unsafe.PointerCast
    return TestResult::CHILD_MODE_FAILURE if adoption != DebuggerLocalAgentTransport::TransportStatus.Ready

    hello_request_bytes: mutable u8[Frame::FRAME_CAPACITY] = zeroed
    return TestResult::CHILD_READ_FAILURE if not read_frame(session, hello_request_bytes[Frame::FIRST_BYTE], Frame::FRAME_LENGTH) can Blocking.IO, Unsafe.PointerCast
    hello_request: DebuggerAgentWire::DecodedAgentHello = DebuggerAgentWire::agent_hello_request_decode(hello_request_bytes[Frame::FIRST_BYTE], Frame::FRAME_LENGTH)
    return TestResult::CHILD_HELLO_DECODE_FAILURE if hello_request.status != DebuggerAgentWire::WireStatus.Ready
    local_hello: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestAgent::PROTOCOL_MAJOR, protocol_minor: TestAgent::PROTOCOL_MINOR, capabilities: TestAgent::CAPABILITIES}
    negotiated: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(local_hello, hello_request.hello, TestAgent::REQUIRED_CAPABILITIES)
    return TestResult::CHILD_HELLO_DECODE_FAILURE if negotiated.status != DebuggerAgentHandshake::HandshakeStatus.Ready
    hello_response: DebuggerAgentWire::EncodedAgentHello = DebuggerAgentWire::agent_hello_response_encode(local_hello)
    return TestResult::CHILD_HELLO_ENCODE_FAILURE if hello_response.status != DebuggerAgentWire::WireStatus.Ready
    hello_sent: DebuggerLocalAgentTransport::TransferResult = DebuggerLocalAgentTransport::local_agent_channel_send(session, hello_response.bytes[Frame::FIRST_BYTE], hello_response.length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::CHILD_HELLO_SEND_FAILURE if hello_sent.status != DebuggerLocalAgentTransport::TransportStatus.Ready or hello_sent.bytes_transferred != Frame::FRAME_LENGTH

    agent_buffer: mutable DebuggerAgent::AgentBuffer = DebuggerAgent::agent_buffer_new()
    stop_bytes: mutable u8[Frame::FRAME_CAPACITY] = zeroed
    return TestResult::CHILD_READ_FAILURE if not read_frame(session, stop_bytes[Frame::FIRST_BYTE], Frame::FRAME_LENGTH) can Blocking.IO, Unsafe.PointerCast
    stop_request: DebuggerAgentWire::DecodedAgentControlRequest = DebuggerAgentWire::agent_control_request_decode(stop_bytes[Frame::FIRST_BYTE], Frame::FRAME_LENGTH)
    return TestResult::CHILD_STOP_DECODE_FAILURE if stop_request.status != DebuggerAgentWire::WireStatus.Ready or stop_request.request.kind != DebuggerAgentWire::AgentControlKind.StopRequest
    applied_stop: DebuggerAgentControl::DispatchResult = DebuggerAgentControl::agent_control_apply_request(stop_request.request, agent_buffer)
    return TestResult::CHILD_STOP_APPLY_FAILURE if applied_stop.status != DebuggerAgentControl::DispatchStatus.Applied or applied_stop.buffer.stopped or not applied_stop.buffer.stop_requested
    agent_buffer <- applied_stop.buffer
    stop_control_acknowledgement: DebuggerAgentWire::AgentControlAcknowledgement = DebuggerAgentControl::agent_control_acknowledgement_for(stop_request.request, applied_stop)
    stop_control_ack_frame: DebuggerAgentWire::EncodedAgentControlAcknowledgement = DebuggerAgentWire::agent_control_acknowledgement_encode(stop_control_acknowledgement)
    return TestResult::CHILD_CONTROL_ACK_ENCODE_FAILURE if stop_control_ack_frame.status != DebuggerAgentWire::WireStatus.Ready
    stop_control_ack_sent: DebuggerLocalAgentTransport::TransferResult = DebuggerLocalAgentTransport::local_agent_channel_send(session, stop_control_ack_frame.bytes[Frame::FIRST_BYTE], stop_control_ack_frame.length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::CHILD_CONTROL_ACK_SEND_FAILURE if stop_control_ack_sent.status != DebuggerLocalAgentTransport::TransportStatus.Ready or stop_control_ack_sent.bytes_transferred != Frame::FRAME_LENGTH
    agent_buffer <- DebuggerAgent::agent_safe_point_reached(agent_buffer)
    return TestResult::CHILD_SAFE_POINT_FAILURE if not agent_buffer.stopped or agent_buffer.stop_requested
    acknowledgement: DebuggerAgent::AgentStopAcknowledgement = DebuggerAgent::AgentStopAcknowledgement{generation: agent_buffer.stop_generation, event_count: agent_buffer.count.u64()}
    agent_buffer <- DebuggerAgent::agent_acknowledge_stop(agent_buffer, acknowledgement)
    ack_frame: DebuggerAgentWire::EncodedStopAcknowledgement = DebuggerAgentWire::stop_acknowledgement_encode(acknowledgement)
    return TestResult::CHILD_ACK_ENCODE_FAILURE if ack_frame.status != DebuggerAgentWire::WireStatus.Ready
    ack_sent: DebuggerLocalAgentTransport::TransferResult = DebuggerLocalAgentTransport::local_agent_channel_send(session, ack_frame.bytes[Frame::FIRST_BYTE], ack_frame.length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::CHILD_ACK_SEND_FAILURE if ack_sent.status != DebuggerLocalAgentTransport::TransportStatus.Ready or ack_sent.bytes_transferred != Frame::FRAME_LENGTH

    resume_bytes: mutable u8[Frame::FRAME_CAPACITY] = zeroed
    return TestResult::CHILD_READ_FAILURE if not read_frame(session, resume_bytes[Frame::FIRST_BYTE], Frame::FRAME_LENGTH) can Blocking.IO, Unsafe.PointerCast
    resume_request: DebuggerAgentWire::DecodedAgentControlRequest = DebuggerAgentWire::agent_control_request_decode(resume_bytes[Frame::FIRST_BYTE], Frame::FRAME_LENGTH)
    return TestResult::CHILD_RESUME_DECODE_FAILURE if resume_request.status != DebuggerAgentWire::WireStatus.Ready or resume_request.request.kind != DebuggerAgentWire::AgentControlKind.ResumeRequest
    applied_resume: DebuggerAgentControl::DispatchResult = DebuggerAgentControl::agent_control_apply_request(resume_request.request, agent_buffer)
    return TestResult::CHILD_RESUME_APPLY_FAILURE if applied_resume.status != DebuggerAgentControl::DispatchStatus.Applied or applied_resume.buffer.stopped or not DebuggerAgent::agent_is_exact(applied_resume.buffer)
    resume_control_acknowledgement: DebuggerAgentWire::AgentControlAcknowledgement = DebuggerAgentControl::agent_control_acknowledgement_for(resume_request.request, applied_resume)
    resume_control_ack_frame: DebuggerAgentWire::EncodedAgentControlAcknowledgement = DebuggerAgentWire::agent_control_acknowledgement_encode(resume_control_acknowledgement)
    return TestResult::CHILD_RESUME_ACK_ENCODE_FAILURE if resume_control_ack_frame.status != DebuggerAgentWire::WireStatus.Ready
    resume_control_ack_sent: DebuggerLocalAgentTransport::TransferResult = DebuggerLocalAgentTransport::local_agent_channel_send(session, resume_control_ack_frame.bytes[Frame::FIRST_BYTE], resume_control_ack_frame.length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::CHILD_RESUME_ACK_SEND_FAILURE if resume_control_ack_sent.status != DebuggerLocalAgentTransport::TransportStatus.Ready or resume_control_ack_sent.bytes_transferred != Frame::FRAME_LENGTH
    closed: DebuggerLocalAgentTransport::TransportStatus = DebuggerLocalAgentTransport::local_agent_channel_close(session) can Blocking.IO, Unsafe.PointerCast
    return TestResult::CHILD_CLOSE_FAILURE if closed != DebuggerLocalAgentTransport::TransportStatus.Ready
    return TestResult::SUCCESS

def main(argc: i64, argv: mutable void&) -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    arguments: mutable cstr&& = argv.cast[mutable cstr&&] can Unsafe.PointerCast
    if argc == Argument::CHILD_COUNT:
        return TestResult::CHILD_MODE_FAILURE if not test_cstr_equal(arguments[Argument::CHILD_MODE_INDEX].cast[cstr], Argument::CHILD_SWITCH)
        return child_main(argc) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PARENT_ARGUMENT_FAILURE if argc != Argument::PARENT_COUNT
    return TestResult::PARENT_ARGUMENT_FAILURE if not test_cstr_equal(arguments[Argument::PARENT_MODE_INDEX].cast[cstr], Argument::PARENT_MODE) or not test_cstr_equal(arguments[Argument::PARENT_RESERVED_FIRST_INDEX].cast[cstr], Argument::RESERVED_FIRST) or not test_cstr_equal(arguments[Argument::PARENT_RESERVED_SECOND_INDEX].cast[cstr], Argument::RESERVED_SECOND)

    executable: cstr = arguments[Argument::FIRST_ARGUMENT].cast[cstr]
    mutable_arguments: mutable void&& = argv.cast[mutable void&&] can Unsafe.PointerCast
    mutable_arguments[Argument::CHILD_MODE_INDEX] <- Argument::CHILD_SWITCH.cast[mutable void&] can Unsafe.PointerCast
    null_argument: mutable void& = Argument::NULL_POINTER_VALUE.cast[mutable void&] can Unsafe.PointerCast
    mutable_arguments[Argument::ARGUMENT_TERMINATOR_INDEX] <- null_argument
    child_arguments: mutable cstr&& = mutable_arguments.cast[mutable cstr&&] can Unsafe.PointerCast

    session: mutable DebuggerLocalAgentTransport::LocalAgentSession = zeroed
    DebuggerLocalAgentTransport::local_agent_session_initialize(session)
    launch: DebuggerLocalAgentTransport::TransportStatus = DebuggerLocalAgentTransport::local_agent_session_launch(session, executable, child_arguments, Argument::CHANNEL_DESCRIPTOR) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PARENT_LAUNCH_FAILURE if launch != DebuggerLocalAgentTransport::TransportStatus.Ready
    return TestResult::PARENT_CHANNEL_FAILURE if session.process_id == Argument::NO_PROCESS_ID or session.channel_descriptor < Argument::MINIMUM_CHANNEL_DESCRIPTOR

    provider: DebuggerEngine::Provider = DebuggerEngine::provider_new(DebuggerCapabilities::EngineKind.InstrumentedNative, DebuggerCapabilities::native_live_capabilities())
    controller: mutable DebuggerNative::NativeController = DebuggerNative::native_controller_new(provider)
    controller <- DebuggerNative::native_attach(controller, DebuggerNative::AgentIdentity{protocol_major: TestAgent::PROTOCOL_MAJOR, build: TestAgent::BUILD, target: TestAgent::TARGET})
    return TestResult::PARENT_CONTROLLER_FAILURE if controller.status != DebuggerNative::NativeStopStatus.Attached

    local_hello: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestAgent::PROTOCOL_MAJOR, protocol_minor: TestAgent::PROTOCOL_MINOR, capabilities: TestAgent::CAPABILITIES}
    async_session: mutable DebuggerAgentAsyncSession::AsyncSession = zeroed
    DebuggerAgentAsyncSession::async_session_initialize(async_session)
    return TestResult::PARENT_ASYNC_INTEREST_FAILURE if DebuggerAgentAsyncSession::async_session_interest(async_session) != DebuggerAgentAsyncSession::AsyncInterest.NoInterest
    handshake_begin: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_handshake_begin(async_session, local_hello, TestAgent::REQUIRED_CAPABILITIES, TestAsync::NOW_NS, TestAsync::DEADLINE_NS)
    return TestResult::PARENT_ASYNC_HANDSHAKE_BEGIN_FAILURE if handshake_begin.status != DebuggerAgentAsyncSession::AsyncStatus.Accepted or not DebuggerAgentAsyncSession::async_session_is_exact(async_session) or DebuggerAgentAsyncSession::async_session_interest(async_session) != DebuggerAgentAsyncSession::AsyncInterest.Writable
    first_handshake_step: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_session_poll(async_session, session, controller, TestAsync::NOW_NS) can Unsafe.PointerCast
    return TestResult::PARENT_ASYNC_INTEREST_FAILURE if first_handshake_step.status != DebuggerAgentAsyncSession::AsyncStatus.Pending or DebuggerAgentAsyncSession::async_session_interest(async_session) == DebuggerAgentAsyncSession::AsyncInterest.NoInterest
    handshake: DebuggerAgentAsyncSession::AsyncResult = drive_async_operation(async_session, session, controller) can Unsafe.PointerCast
    return TestResult::PARENT_ASYNC_HANDSHAKE_FAILURE if handshake.status != DebuggerAgentAsyncSession::AsyncStatus.Completed or not DebuggerAgentAsyncSession::async_session_is_ready(async_session) or async_session.negotiated.capabilities != TestAgent::CAPABILITIES

    invalid_deadline: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_pause_begin(async_session, controller, TestAsync::NOW_NS, TestAsync::NOW_NS)
    return TestResult::PARENT_ASYNC_TIMEOUT_VALIDATION_FAILURE if invalid_deadline.status != DebuggerAgentAsyncSession::AsyncStatus.Rejected or controller.status != DebuggerNative::NativeStopStatus.Attached

    pause_begin: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_pause_begin(async_session, controller, TestAsync::NOW_NS, TestAsync::DEADLINE_NS)
    return TestResult::PARENT_ASYNC_PAUSE_BEGIN_FAILURE if pause_begin.status != DebuggerAgentAsyncSession::AsyncStatus.Accepted or controller.status != DebuggerNative::NativeStopStatus.Pausing or DebuggerAgentAsyncSession::async_session_interest(async_session) != DebuggerAgentAsyncSession::AsyncInterest.Writable
    paused: DebuggerAgentAsyncSession::AsyncResult = drive_async_operation(async_session, session, controller) can Unsafe.PointerCast
    return TestResult::PARENT_ASYNC_PAUSE_FAILURE if paused.status != DebuggerAgentAsyncSession::AsyncStatus.Completed or controller.status != DebuggerNative::NativeStopStatus.Stopped or not DebuggerNative::native_can_inspect(controller)

    resume_begin: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_resume_begin(async_session, controller, TestAsync::NOW_NS, TestAsync::DEADLINE_NS)
    return TestResult::PARENT_ASYNC_RESUME_BEGIN_FAILURE if resume_begin.status != DebuggerAgentAsyncSession::AsyncStatus.Accepted or DebuggerAgentAsyncSession::async_session_interest(async_session) != DebuggerAgentAsyncSession::AsyncInterest.Writable
    resumed: DebuggerAgentAsyncSession::AsyncResult = drive_async_operation(async_session, session, controller) can Unsafe.PointerCast
    return TestResult::PARENT_ASYNC_RESUME_FAILURE if resumed.status != DebuggerAgentAsyncSession::AsyncStatus.Completed or controller.status != DebuggerNative::NativeStopStatus.Attached or controller.agent_buffer.stopped

    cancel_begin: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_pause_begin(async_session, controller, TestAsync::NOW_NS, TestAsync::DEADLINE_NS)
    return TestResult::PARENT_ASYNC_CANCEL_FAILURE if cancel_begin.status != DebuggerAgentAsyncSession::AsyncStatus.Accepted
    cancelled: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_session_cancel(async_session, controller)
    return TestResult::PARENT_ASYNC_CANCEL_FAILURE if cancelled.status != DebuggerAgentAsyncSession::AsyncStatus.Cancelled or controller.status != DebuggerNative::NativeStopStatus.AgentFailed or DebuggerAgentAsyncSession::async_session_interest(async_session) != DebuggerAgentAsyncSession::AsyncInterest.NoInterest

    timeout_session: mutable DebuggerAgentAsyncSession::AsyncSession = zeroed
    DebuggerAgentAsyncSession::async_session_initialize(timeout_session)
    timeout_begin: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_handshake_begin(timeout_session, local_hello, TestAgent::REQUIRED_CAPABILITIES, TestAsync::NOW_NS, TestAsync::TIMEOUT_NS)
    return TestResult::PARENT_ASYNC_TIMEOUT_FAILURE if timeout_begin.status != DebuggerAgentAsyncSession::AsyncStatus.Accepted
    timeout_poll: DebuggerAgentAsyncSession::AsyncResult = DebuggerAgentAsyncSession::async_session_poll(timeout_session, session, controller, TestAsync::TIMEOUT_NS) can Unsafe.PointerCast
    return TestResult::PARENT_ASYNC_TIMEOUT_FAILURE if timeout_poll.status != DebuggerAgentAsyncSession::AsyncStatus.TimedOut or timeout_session.state != DebuggerAgentAsyncSession::AsyncState.Failed or controller.status != DebuggerNative::NativeStopStatus.AgentFailed

    waited: DebuggerLocalAgentTransport::TransportStatus = DebuggerLocalAgentTransport::local_agent_process_wait(session) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PARENT_WAIT_FAILURE if waited != DebuggerLocalAgentTransport::TransportStatus.ChildReaped or session.exit_code != TestResult::SUCCESS.i32() or session.terminated_by_signal
    closed: DebuggerLocalAgentTransport::TransportStatus = DebuggerLocalAgentTransport::local_agent_channel_close(session) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PARENT_CLOSE_FAILURE if closed != DebuggerLocalAgentTransport::TransportStatus.Ready or session.owned_descriptor_count != Frame::EMPTY_LENGTH
    return TestResult::SUCCESS
