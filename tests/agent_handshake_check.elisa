include "../src/agent/handshake.elisa"

const module Frame:
    LENGTH: usize = 32
    FIRST_BYTE: usize = 0
    VERSION_OFFSET: usize = 4
    MESSAGE_KIND_OFFSET: usize = 6
    FIRST_PAYLOAD_OFFSET: usize = 8
    SECOND_PAYLOAD_OFFSET: usize = 16
    CHECKSUM_OFFSET: usize = 24
    CHECKSUM_PAYLOAD_LENGTH: usize = 24
    LAST_CAPABILITY_BYTE_OFFSET: usize = 7
    PROTOCOL_MAJOR_LOW_BYTE_OFFSET: usize = 4
    TRUNCATED_LENGTH: usize = 31
    SECOND_BYTE_OFFSET: usize = 1
    U64_BYTE_COUNT: usize = 8
    U64_BITS_PER_BYTE: u64 = 8
    U64_BYTE_MASK: u64 = 255
    U64_ZERO: u64 = 0
    EMPTY_LENGTH: usize = 0

const module TestHello:
    PROTOCOL_MAJOR: u32 = 1
    PROTOCOL_MINOR: u32 = 5
    LOCAL_SUPPORTED_MINOR: u32 = 4
    PROTOCOL_MINOR_PEER: u32 = 2
    PROTOCOL_MINOR_NEWER_PEER: u32 = 7
    VERSION_WORD: u64 = 4294967301
    CAPABILITIES: u64 = 9223372036854775839
    CAPABILITY_LOW_BYTE: u8 = 31
    CAPABILITY_HIGH_BYTE: u8 = 128
    ZERO_BYTE: u8 = 0
    REQUEST_KIND: u8 = 2
    RESPONSE_KIND: u8 = 3
    MUTATED_CHECKSUM_BYTE: u8 = 0
    ALTERNATE_CHECKSUM_BYTE: u8 = 1
    INVALID_PROTOCOL_MAJOR: u32 = 0
    OTHER_PROTOCOL_MAJOR: u32 = 2
    LOCAL_CAPABILITIES: u64 = 31
    PEER_CAPABILITIES: u64 = 7
    REQUIRED_CAPABILITIES: u64 = 3
    REQUIRED_PEER_MISSING: u64 = 9
    REQUIRED_LOCAL_MISSING: u64 = 32
    EXPECTED_NEGOTIATED_CAPABILITIES: u64 = 7

const module TestResult:
    REQUEST_ENCODE_FAILURE: i64 = 1
    REQUEST_LAYOUT_FAILURE: i64 = 2
    REQUEST_DECODE_FAILURE: i64 = 3
    RESPONSE_ENCODE_FAILURE: i64 = 4
    RESPONSE_DECODE_FAILURE: i64 = 5
    MESSAGE_KIND_FAILURE: i64 = 6
    INVALID_MAJOR_FAILURE: i64 = 7
    CHECKSUM_FAILURE: i64 = 8
    TRUNCATED_FRAME_FAILURE: i64 = 9
    NEGOTIATION_FAILURE: i64 = 10
    NEGOTIATED_VERSION_FAILURE: i64 = 11
    NEGOTIATED_CAPABILITY_FAILURE: i64 = 12
    MAJOR_MISMATCH_FAILURE: i64 = 13
    PEER_CAPABILITY_FAILURE: i64 = 14
    LOCAL_CAPABILITY_FAILURE: i64 = 15
    INVALID_PEER_MAJOR_FAILURE: i64 = 16
    UNSUPPORTED_LOCAL_MAJOR_FAILURE: i64 = 17
    UNSUPPORTED_LOCAL_MINOR_FAILURE: i64 = 18
    CURRENT_LOCAL_MINOR_FAILURE: i64 = 19
    SUCCESS: i64 = 0

def read_u64(bytes: u8&, offset: usize) -> u64:
    value: mutable u64 = Frame::U64_ZERO
    for index in Frame::EMPTY_LENGTH..<Frame::U64_BYTE_COUNT:
        value <- value | (bytes[offset + index].u64() << (Frame::U64_BITS_PER_BYTE * index.u64()))
    return value

def write_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
    for index in Frame::EMPTY_LENGTH..<Frame::U64_BYTE_COUNT:
        bytes[offset + index] <- ((value >> (Frame::U64_BITS_PER_BYTE * index.u64())) & Frame::U64_BYTE_MASK).u8()

def main() -> i64:
    return TestResult::CURRENT_LOCAL_MINOR_FAILURE if DebuggerAgentHandshake::current_protocol_minor() != TestHello::LOCAL_SUPPORTED_MINOR
    local_hello: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestHello::PROTOCOL_MAJOR, protocol_minor: TestHello::PROTOCOL_MINOR, capabilities: TestHello::CAPABILITIES}
    request: DebuggerAgentWire::EncodedAgentHello = DebuggerAgentWire::agent_hello_request_encode(local_hello)
    return TestResult::REQUEST_ENCODE_FAILURE if request.status != DebuggerAgentWire::WireStatus.Ready or request.length != Frame::LENGTH
    return TestResult::REQUEST_LAYOUT_FAILURE if request.bytes[Frame::VERSION_OFFSET] != TestHello::PROTOCOL_MAJOR.u8() or request.bytes[Frame::MESSAGE_KIND_OFFSET] != TestHello::REQUEST_KIND
    return TestResult::REQUEST_LAYOUT_FAILURE if request.bytes[Frame::MESSAGE_KIND_OFFSET + Frame::SECOND_BYTE_OFFSET] != TestHello::ZERO_BYTE
    return TestResult::REQUEST_LAYOUT_FAILURE if read_u64(request.bytes[Frame::FIRST_BYTE], Frame::FIRST_PAYLOAD_OFFSET) != TestHello::VERSION_WORD
    return TestResult::REQUEST_LAYOUT_FAILURE if request.bytes[Frame::SECOND_PAYLOAD_OFFSET] != TestHello::CAPABILITY_LOW_BYTE or request.bytes[Frame::SECOND_PAYLOAD_OFFSET + Frame::LAST_CAPABILITY_BYTE_OFFSET] != TestHello::CAPABILITY_HIGH_BYTE

    request_decoded: DebuggerAgentWire::DecodedAgentHello = DebuggerAgentWire::agent_hello_request_decode(request.bytes[Frame::FIRST_BYTE], request.length)
    return TestResult::REQUEST_DECODE_FAILURE if request_decoded.status != DebuggerAgentWire::WireStatus.Ready or request_decoded.hello.protocol_major != local_hello.protocol_major or request_decoded.hello.protocol_minor != local_hello.protocol_minor or request_decoded.hello.capabilities != local_hello.capabilities

    peer_hello: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestHello::PROTOCOL_MAJOR, protocol_minor: TestHello::PROTOCOL_MINOR_PEER, capabilities: TestHello::PEER_CAPABILITIES}
    response: DebuggerAgentWire::EncodedAgentHello = DebuggerAgentWire::agent_hello_response_encode(peer_hello)
    return TestResult::RESPONSE_ENCODE_FAILURE if response.status != DebuggerAgentWire::WireStatus.Ready or response.length != Frame::LENGTH or response.bytes[Frame::MESSAGE_KIND_OFFSET] != TestHello::RESPONSE_KIND
    response_decoded: DebuggerAgentWire::DecodedAgentHello = DebuggerAgentWire::agent_hello_response_decode(response.bytes[Frame::FIRST_BYTE], response.length)
    return TestResult::RESPONSE_DECODE_FAILURE if response_decoded.status != DebuggerAgentWire::WireStatus.Ready or response_decoded.hello.protocol_minor != peer_hello.protocol_minor or response_decoded.hello.capabilities != peer_hello.capabilities
    wrong_decoder: DebuggerAgentWire::DecodedAgentHello = DebuggerAgentWire::agent_hello_request_decode(response.bytes[Frame::FIRST_BYTE], response.length)
    return TestResult::MESSAGE_KIND_FAILURE if wrong_decoder.status != DebuggerAgentWire::WireStatus.UnsupportedMessage

    invalid_hello: DebuggerAgentWire::EncodedAgentHello = DebuggerAgentWire::agent_hello_request_encode(DebuggerAgentWire::AgentHello{protocol_major: TestHello::INVALID_PROTOCOL_MAJOR, protocol_minor: TestHello::PROTOCOL_MINOR, capabilities: TestHello::CAPABILITIES})
    return TestResult::INVALID_MAJOR_FAILURE if invalid_hello.status != DebuggerAgentWire::WireStatus.InvalidProtocolMajor or invalid_hello.length != Frame::EMPTY_LENGTH
    invalid_wire_major: mutable DebuggerAgentWire::EncodedAgentHello = response
    invalid_wire_major.bytes[Frame::FIRST_PAYLOAD_OFFSET + Frame::PROTOCOL_MAJOR_LOW_BYTE_OFFSET] <- TestHello::ZERO_BYTE
    invalid_wire_checksum: u64 = DebuggerTraceBinary::bytes_checksum(invalid_wire_major.bytes[Frame::FIRST_BYTE], Frame::CHECKSUM_PAYLOAD_LENGTH)
    write_u64(invalid_wire_major.bytes[Frame::FIRST_BYTE], Frame::CHECKSUM_OFFSET, invalid_wire_checksum)
    invalid_wire_major_decoded: DebuggerAgentWire::DecodedAgentHello = DebuggerAgentWire::agent_hello_response_decode(invalid_wire_major.bytes[Frame::FIRST_BYTE], invalid_wire_major.length)
    return TestResult::INVALID_MAJOR_FAILURE if invalid_wire_major_decoded.status != DebuggerAgentWire::WireStatus.InvalidProtocolMajor
    corrupt_frame: mutable DebuggerAgentWire::EncodedAgentHello = response
    corrupt_frame.bytes[Frame::CHECKSUM_OFFSET] <- TestHello::MUTATED_CHECKSUM_BYTE if response.bytes[Frame::CHECKSUM_OFFSET] != TestHello::MUTATED_CHECKSUM_BYTE
    corrupt_frame.bytes[Frame::CHECKSUM_OFFSET] <- TestHello::ALTERNATE_CHECKSUM_BYTE if response.bytes[Frame::CHECKSUM_OFFSET] == TestHello::MUTATED_CHECKSUM_BYTE
    corrupt: DebuggerAgentWire::DecodedAgentHello = DebuggerAgentWire::agent_hello_response_decode(corrupt_frame.bytes[Frame::FIRST_BYTE], corrupt_frame.length)
    return TestResult::CHECKSUM_FAILURE if corrupt.status != DebuggerAgentWire::WireStatus.ChecksumMismatch
    truncated: DebuggerAgentWire::DecodedAgentHello = DebuggerAgentWire::agent_hello_response_decode(response.bytes[Frame::FIRST_BYTE], Frame::TRUNCATED_LENGTH)
    return TestResult::TRUNCATED_FRAME_FAILURE if truncated.status != DebuggerAgentWire::WireStatus.Truncated

    local: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestHello::PROTOCOL_MAJOR, protocol_minor: TestHello::LOCAL_SUPPORTED_MINOR, capabilities: TestHello::LOCAL_CAPABILITIES}
    peer: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestHello::PROTOCOL_MAJOR, protocol_minor: TestHello::PROTOCOL_MINOR_PEER, capabilities: TestHello::PEER_CAPABILITIES}
    negotiated: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(local, peer, TestHello::REQUIRED_CAPABILITIES)
    return TestResult::NEGOTIATION_FAILURE if negotiated.status != DebuggerAgentHandshake::HandshakeStatus.Ready
    return TestResult::NEGOTIATED_VERSION_FAILURE if negotiated.protocol_major != TestHello::PROTOCOL_MAJOR or negotiated.protocol_minor != TestHello::PROTOCOL_MINOR_PEER
    return TestResult::NEGOTIATED_CAPABILITY_FAILURE if negotiated.capabilities != TestHello::EXPECTED_NEGOTIATED_CAPABILITIES

    older_peer: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestHello::OTHER_PROTOCOL_MAJOR, protocol_minor: TestHello::PROTOCOL_MINOR_PEER, capabilities: TestHello::PEER_CAPABILITIES}
    major_mismatch: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(local, older_peer, TestHello::REQUIRED_CAPABILITIES)
    return TestResult::MAJOR_MISMATCH_FAILURE if major_mismatch.status != DebuggerAgentHandshake::HandshakeStatus.MajorVersionMismatch
    peer_missing: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(local, peer, TestHello::REQUIRED_PEER_MISSING)
    return TestResult::PEER_CAPABILITY_FAILURE if peer_missing.status != DebuggerAgentHandshake::HandshakeStatus.PeerMissingRequiredCapabilities
    local_missing: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(local, peer, TestHello::REQUIRED_LOCAL_MISSING)
    return TestResult::LOCAL_CAPABILITY_FAILURE if local_missing.status != DebuggerAgentHandshake::HandshakeStatus.LocalMissingRequiredCapabilities
    invalid_peer: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestHello::INVALID_PROTOCOL_MAJOR, protocol_minor: TestHello::PROTOCOL_MINOR_PEER, capabilities: TestHello::PEER_CAPABILITIES}
    invalid_negotiation: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(local, invalid_peer, TestHello::REQUIRED_CAPABILITIES)
    return TestResult::INVALID_PEER_MAJOR_FAILURE if invalid_negotiation.status != DebuggerAgentHandshake::HandshakeStatus.InvalidProtocolMajor
    unsupported_local_major: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestHello::OTHER_PROTOCOL_MAJOR, protocol_minor: TestHello::LOCAL_SUPPORTED_MINOR, capabilities: TestHello::LOCAL_CAPABILITIES}
    unsupported_local_major_result: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(unsupported_local_major, peer, TestHello::REQUIRED_CAPABILITIES)
    return TestResult::UNSUPPORTED_LOCAL_MAJOR_FAILURE if unsupported_local_major_result.status != DebuggerAgentHandshake::HandshakeStatus.UnsupportedLocalMajor
    unsupported_local_minor: DebuggerAgentWire::AgentHello = DebuggerAgentWire::AgentHello{protocol_major: TestHello::PROTOCOL_MAJOR, protocol_minor: TestHello::PROTOCOL_MINOR_NEWER_PEER, capabilities: TestHello::LOCAL_CAPABILITIES}
    unsupported_local_minor_result: DebuggerAgentHandshake::NegotiatedProtocol = DebuggerAgentHandshake::agent_handshake_negotiate(unsupported_local_minor, peer, TestHello::REQUIRED_CAPABILITIES)
    return TestResult::UNSUPPORTED_LOCAL_MINOR_FAILURE if unsupported_local_minor_result.status != DebuggerAgentHandshake::HandshakeStatus.UnsupportedLocalMinor
    return TestResult::SUCCESS
