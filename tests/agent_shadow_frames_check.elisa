include "../src/agent/frames.elisa"

const module Identity:
    THREAD: u64 = 501
    FUNCTION: u64 = 601
    TASK: u64 = 701
    SOURCE: u64 = 801
    ROOT_INVOCATION: u64 = 901
    CHILD_INVOCATION: u64 = 902
    INVALID_PARENT: u64 = 903
    ROOT_BINDING: u64 = 1001
    OPTIMIZED_BINDING: u64 = 1002
    CHILD_BINDING: u64 = 1003
    INVALID_BINDING: u64 = 1004
    ROOT_SCOPE: u64 = 1101
    INNER_SCOPE: u64 = 1102
    CHILD_SCOPE: u64 = 1103
    TYPE: u64 = 1201
    CAPACITY_BINDING_BASE: u64 = 2000
    CAPACITY_SCOPE: u64 = 3000

const module ValueSize:
    BYTE_COUNT: usize = 8
    INVALID_BYTE_COUNT: usize = 7
    MAX_INLINE_BYTES: usize = 32
    FIRST_BYTE: usize = 0
    SECOND_BYTE: usize = 1
    FIRST_VALUE_BYTE: u8 = 42
    SECOND_VALUE_BYTE: u8 = 99
    UPDATED_VALUE_BYTE: u8 = 255

const module Generation:
    FIRST: u64 = 1
    SECOND: u64 = 2
    INVALID: u64 = 0

const module Location:
    ROOT_STACK_OFFSET: i64 = -8
    ZERO: i64 = 0

const module SourcePosition:
    ROOT_LINE: u32 = 14
    ROOT_COLUMN: u32 = 5
    CHILD_LINE: u32 = 20
    CHILD_COLUMN: u32 = 9

const module StackShape:
    MAX_FRAMES: usize = 32
    MAX_BINDINGS: usize = 32
    EMPTY: usize = 0
    ONE: usize = 1
    FRAME_ADVANCE: usize = 1
    RECURSIVE_INVOCATION_BASE: u64 = 5000

const module TestResult:
    SUCCESS: i64 = 0
    INVALID_THREAD: i64 = 1
    INITIALIZE: i64 = 2
    ROOT_FRAME: i64 = 3
    WRONG_PARENT: i64 = 4
    DUPLICATE_INVOCATION: i64 = 5
    CHILD_FRAME: i64 = 6
    STACK_VALIDITY: i64 = 7
    AVAILABLE_DECLARATION: i64 = 8
    DUPLICATE_BINDING: i64 = 9
    INVALID_BYTE_COUNT: i64 = 10
    OPTIMIZED_DECLARATION: i64 = 11
    CHILD_DECLARATION: i64 = 12
    BEGIN_STOP: i64 = 13
    STOP_REENTRY: i64 = 14
    AVAILABLE_READ: i64 = 15
    BYTE_CONTENT: i64 = 16
    OPTIMIZED_READ: i64 = 17
    OPTIMIZED_STATE: i64 = 18
    UNINITIALIZED_READ: i64 = 19
    GENERATION_GUARD: i64 = 20
    FROZEN_WRITE: i64 = 21
    FROZEN_POP: i64 = 22
    RESUME_MISMATCH: i64 = 23
    RESUME: i64 = 24
    BINDING_WRITE: i64 = 25
    SCOPE_EXIT: i64 = 26
    BINDING_CAPACITY: i64 = 27
    BINDING_OVERFLOW: i64 = 28
    STALE_STOP: i64 = 29
    SECOND_STOP: i64 = 30
    EXPIRED_SCOPE: i64 = 31
    CHILD_POP: i64 = 32
    ROOT_POP: i64 = 33
    STACK_DEPTH: i64 = 34
    FRAME_CAPACITY: i64 = 35
    FRAME_OVERFLOW: i64 = 36
    RECURSIVE_UNWIND: i64 = 37
    INVALID_POP: i64 = 38
    INVALID_WRITE: i64 = 39
    INVALID_READ: i64 = 40
    READ_WHILE_RUNNING: i64 = 41

def debug_id(value: u64) -> DebuggerIdentity::DebugId:
    return DebuggerIdentity::DebugId{value: value}

def main() -> i64:
    shadow_stack: mutable DebuggerAgentFrames::AgentShadowStack = zeroed
    return TestResult::INVALID_THREAD if DebuggerAgentFrames::agent_shadow_stack_initialize(shadow_stack, debug_id(Generation::INVALID)) != DebuggerAgentFrames::ShadowStatus.InvalidIdentifier
    return TestResult::INITIALIZE if DebuggerAgentFrames::agent_shadow_stack_initialize(shadow_stack, debug_id(Identity::THREAD)) != DebuggerAgentFrames::ShadowStatus.Ready or not DebuggerAgentFrames::agent_shadow_stack_is_exact(shadow_stack)

    root_invocation: DebuggerIdentity::DebugId = debug_id(Identity::ROOT_INVOCATION)
    child_invocation: DebuggerIdentity::DebugId = debug_id(Identity::CHILD_INVOCATION)
    no_invocation: DebuggerIdentity::DebugId = debug_id(Generation::INVALID)
    function_id: DebuggerIdentity::DebugId = debug_id(Identity::FUNCTION)
    task_id: DebuggerIdentity::DebugId = debug_id(Identity::TASK)
    source_id: DebuggerIdentity::DebugId = debug_id(Identity::SOURCE)
    return TestResult::ROOT_FRAME if DebuggerAgentFrames::agent_shadow_frame_push(shadow_stack, root_invocation, no_invocation, function_id, task_id, source_id, SourcePosition::ROOT_LINE, SourcePosition::ROOT_COLUMN) != DebuggerAgentFrames::ShadowStatus.Ready
    return TestResult::INVALID_POP if DebuggerAgentFrames::agent_shadow_frame_pop(shadow_stack, no_invocation) != DebuggerAgentFrames::ShadowStatus.InvalidIdentifier
    return TestResult::WRONG_PARENT if DebuggerAgentFrames::agent_shadow_frame_push(shadow_stack, debug_id(Identity::INVALID_PARENT), debug_id(Identity::INVALID_PARENT), function_id, task_id, source_id, SourcePosition::ROOT_LINE, SourcePosition::ROOT_COLUMN) != DebuggerAgentFrames::ShadowStatus.ParentMismatch
    return TestResult::DUPLICATE_INVOCATION if DebuggerAgentFrames::agent_shadow_frame_push(shadow_stack, root_invocation, no_invocation, function_id, task_id, source_id, SourcePosition::ROOT_LINE, SourcePosition::ROOT_COLUMN) != DebuggerAgentFrames::ShadowStatus.DuplicateInvocation
    return TestResult::CHILD_FRAME if DebuggerAgentFrames::agent_shadow_frame_push(shadow_stack, child_invocation, root_invocation, function_id, task_id, source_id, SourcePosition::CHILD_LINE, SourcePosition::CHILD_COLUMN) != DebuggerAgentFrames::ShadowStatus.Ready
    return TestResult::STACK_VALIDITY if not DebuggerAgentFrames::agent_shadow_stack_is_exact(shadow_stack) or DebuggerAgentFrames::agent_shadow_frame_depth(shadow_stack) != StackShape::ONE + StackShape::FRAME_ADVANCE

    value_bytes: mutable u8[ValueSize::MAX_INLINE_BYTES] = zeroed
    value_bytes[ValueSize::FIRST_BYTE] <- ValueSize::FIRST_VALUE_BYTE
    value_bytes[ValueSize::SECOND_BYTE] <- ValueSize::SECOND_VALUE_BYTE
    scope_bytes: mutable u8[ValueSize::MAX_INLINE_BYTES] = zeroed
    return TestResult::INVALID_WRITE if DebuggerAgentFrames::agent_shadow_binding_write(shadow_stack, no_invocation, debug_id(Identity::ROOT_BINDING), value_bytes[ValueSize::FIRST_BYTE], ValueSize::BYTE_COUNT) != DebuggerAgentFrames::ShadowStatus.InvalidIdentifier
    invalid_available: DebuggerAgentFrames::ShadowStatus = DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, root_invocation, debug_id(Identity::INVALID_BINDING), debug_id(Identity::ROOT_SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentValueKind.Unsigned, DebuggerAgentFrames::AgentValueState.Available, DebuggerAgentFrames::AgentStorageKind.Register, Location::ZERO, ValueSize::BYTE_COUNT.u64(), value_bytes[ValueSize::FIRST_BYTE], ValueSize::INVALID_BYTE_COUNT)
    return TestResult::INVALID_BYTE_COUNT if invalid_available != DebuggerAgentFrames::ShadowStatus.InvalidByteCount

    available: DebuggerAgentFrames::ShadowStatus = DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, root_invocation, debug_id(Identity::ROOT_BINDING), debug_id(Identity::ROOT_SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentValueKind.Signed, DebuggerAgentFrames::AgentValueState.Available, DebuggerAgentFrames::AgentStorageKind.StackSlot, Location::ROOT_STACK_OFFSET, ValueSize::BYTE_COUNT.u64(), value_bytes[ValueSize::FIRST_BYTE], ValueSize::BYTE_COUNT)
    return TestResult::AVAILABLE_DECLARATION if available != DebuggerAgentFrames::ShadowStatus.Ready
    duplicate: DebuggerAgentFrames::ShadowStatus = DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, root_invocation, debug_id(Identity::ROOT_BINDING), debug_id(Identity::ROOT_SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentValueKind.Signed, DebuggerAgentFrames::AgentValueState.Available, DebuggerAgentFrames::AgentStorageKind.StackSlot, Location::ROOT_STACK_OFFSET, ValueSize::BYTE_COUNT.u64(), value_bytes[ValueSize::FIRST_BYTE], ValueSize::BYTE_COUNT)
    return TestResult::DUPLICATE_BINDING if duplicate != DebuggerAgentFrames::ShadowStatus.DuplicateBinding

    optimized: DebuggerAgentFrames::ShadowStatus = DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, root_invocation, debug_id(Identity::OPTIMIZED_BINDING), debug_id(Identity::INNER_SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentValueKind.Unsigned, DebuggerAgentFrames::AgentValueState.OptimizedAway, DebuggerAgentFrames::AgentStorageKind.Unknown, Location::ZERO, ValueSize::BYTE_COUNT.u64(), scope_bytes[ValueSize::FIRST_BYTE], StackShape::EMPTY)
    return TestResult::OPTIMIZED_DECLARATION if optimized != DebuggerAgentFrames::ShadowStatus.Ready
    child_value: DebuggerAgentFrames::ShadowStatus = DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, child_invocation, debug_id(Identity::CHILD_BINDING), debug_id(Identity::CHILD_SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentValueKind.Signed, DebuggerAgentFrames::AgentValueState.Uninitialized, DebuggerAgentFrames::AgentStorageKind.Unknown, Location::ZERO, ValueSize::BYTE_COUNT.u64(), scope_bytes[ValueSize::FIRST_BYTE], StackShape::EMPTY)
    return TestResult::CHILD_DECLARATION if child_value != DebuggerAgentFrames::ShadowStatus.Ready or not DebuggerAgentFrames::agent_shadow_stack_is_exact(shadow_stack)
    running_read: DebuggerAgentFrames::BindingReadResult = DebuggerAgentFrames::agent_shadow_binding_read(shadow_stack, root_invocation, debug_id(Identity::ROOT_BINDING), Generation::FIRST)
    return TestResult::READ_WHILE_RUNNING if running_read.status != DebuggerAgentFrames::ShadowStatus.SnapshotRequired

    return TestResult::BEGIN_STOP if DebuggerAgentFrames::agent_shadow_stack_begin_stop(shadow_stack, Generation::FIRST) != DebuggerAgentFrames::ShadowStatus.Ready
    return TestResult::STOP_REENTRY if DebuggerAgentFrames::agent_shadow_stack_begin_stop(shadow_stack, Generation::SECOND) != DebuggerAgentFrames::ShadowStatus.SnapshotAlreadyActive
    invalid_read: DebuggerAgentFrames::BindingReadResult = DebuggerAgentFrames::agent_shadow_binding_read(shadow_stack, no_invocation, debug_id(Identity::ROOT_BINDING), Generation::FIRST)
    return TestResult::INVALID_READ if invalid_read.status != DebuggerAgentFrames::ShadowStatus.InvalidIdentifier
    available_read: DebuggerAgentFrames::BindingReadResult = DebuggerAgentFrames::agent_shadow_binding_read(shadow_stack, root_invocation, debug_id(Identity::ROOT_BINDING), Generation::FIRST)
    return TestResult::AVAILABLE_READ if available_read.status != DebuggerAgentFrames::ShadowStatus.Ready or available_read.descriptor.state != DebuggerAgentFrames::AgentValueState.Available
    return TestResult::BYTE_CONTENT if available_read.descriptor.bytes[ValueSize::FIRST_BYTE] != ValueSize::FIRST_VALUE_BYTE or available_read.descriptor.bytes[ValueSize::SECOND_BYTE] != ValueSize::SECOND_VALUE_BYTE or available_read.descriptor.storage_location != Location::ROOT_STACK_OFFSET
    optimized_read: DebuggerAgentFrames::BindingReadResult = DebuggerAgentFrames::agent_shadow_binding_read(shadow_stack, root_invocation, debug_id(Identity::OPTIMIZED_BINDING), Generation::FIRST)
    return TestResult::OPTIMIZED_READ if optimized_read.status != DebuggerAgentFrames::ShadowStatus.ValueNotAvailable
    return TestResult::OPTIMIZED_STATE if optimized_read.descriptor.state != DebuggerAgentFrames::AgentValueState.OptimizedAway
    uninitialized_read: DebuggerAgentFrames::BindingReadResult = DebuggerAgentFrames::agent_shadow_binding_read(shadow_stack, child_invocation, debug_id(Identity::CHILD_BINDING), Generation::FIRST)
    return TestResult::UNINITIALIZED_READ if uninitialized_read.status != DebuggerAgentFrames::ShadowStatus.ValueNotAvailable or uninitialized_read.descriptor.state != DebuggerAgentFrames::AgentValueState.Uninitialized
    wrong_generation: DebuggerAgentFrames::BindingReadResult = DebuggerAgentFrames::agent_shadow_binding_read(shadow_stack, root_invocation, debug_id(Identity::ROOT_BINDING), Generation::SECOND)
    return TestResult::GENERATION_GUARD if wrong_generation.status != DebuggerAgentFrames::ShadowStatus.GenerationMismatch
    return TestResult::FROZEN_WRITE if DebuggerAgentFrames::agent_shadow_binding_write(shadow_stack, root_invocation, debug_id(Identity::ROOT_BINDING), value_bytes[ValueSize::FIRST_BYTE], ValueSize::BYTE_COUNT) != DebuggerAgentFrames::ShadowStatus.Frozen
    return TestResult::FROZEN_POP if DebuggerAgentFrames::agent_shadow_frame_pop(shadow_stack, child_invocation) != DebuggerAgentFrames::ShadowStatus.Frozen
    return TestResult::RESUME_MISMATCH if DebuggerAgentFrames::agent_shadow_stack_resume(shadow_stack, Generation::SECOND) != DebuggerAgentFrames::ShadowStatus.GenerationMismatch
    return TestResult::RESUME if DebuggerAgentFrames::agent_shadow_stack_resume(shadow_stack, Generation::FIRST) != DebuggerAgentFrames::ShadowStatus.Ready

    updated_bytes: mutable u8[ValueSize::MAX_INLINE_BYTES] = zeroed
    updated_bytes[ValueSize::FIRST_BYTE] <- ValueSize::UPDATED_VALUE_BYTE
    return TestResult::BINDING_WRITE if DebuggerAgentFrames::agent_shadow_binding_write(shadow_stack, root_invocation, debug_id(Identity::ROOT_BINDING), updated_bytes[ValueSize::FIRST_BYTE], ValueSize::BYTE_COUNT) != DebuggerAgentFrames::ShadowStatus.Ready
    return TestResult::SCOPE_EXIT if DebuggerAgentFrames::agent_shadow_scope_exit(shadow_stack, root_invocation, debug_id(Identity::ROOT_SCOPE)) != DebuggerAgentFrames::ShadowStatus.Ready

    for offset in StackShape::EMPTY..<StackShape::MAX_BINDINGS - StackShape::ONE:
        binding_value: u64 = Identity::CAPACITY_BINDING_BASE + offset.u64()
        declaration_status: DebuggerAgentFrames::ShadowStatus = DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, root_invocation, debug_id(binding_value), debug_id(Identity::CAPACITY_SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentValueKind.Signed, DebuggerAgentFrames::AgentValueState.Uninitialized, DebuggerAgentFrames::AgentStorageKind.Unknown, Location::ZERO, ValueSize::BYTE_COUNT.u64(), scope_bytes[ValueSize::FIRST_BYTE], StackShape::EMPTY)
        return TestResult::BINDING_CAPACITY if declaration_status != DebuggerAgentFrames::ShadowStatus.Ready
    overflow_binding: u64 = Identity::CAPACITY_BINDING_BASE + (StackShape::MAX_BINDINGS - StackShape::ONE).u64()
    return TestResult::BINDING_OVERFLOW if DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, root_invocation, debug_id(overflow_binding), debug_id(Identity::CAPACITY_SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentValueKind.Signed, DebuggerAgentFrames::AgentValueState.Uninitialized, DebuggerAgentFrames::AgentStorageKind.Unknown, Location::ZERO, ValueSize::BYTE_COUNT.u64(), scope_bytes[ValueSize::FIRST_BYTE], StackShape::EMPTY) != DebuggerAgentFrames::ShadowStatus.BindingCapacityReached
    return TestResult::STALE_STOP if DebuggerAgentFrames::agent_shadow_stack_begin_stop(shadow_stack, Generation::FIRST) != DebuggerAgentFrames::ShadowStatus.StaleGeneration
    return TestResult::SECOND_STOP if DebuggerAgentFrames::agent_shadow_stack_begin_stop(shadow_stack, Generation::SECOND) != DebuggerAgentFrames::ShadowStatus.Ready
    expired_scope: DebuggerAgentFrames::BindingReadResult = DebuggerAgentFrames::agent_shadow_binding_read(shadow_stack, root_invocation, debug_id(Identity::ROOT_BINDING), Generation::SECOND)
    return TestResult::EXPIRED_SCOPE if expired_scope.status != DebuggerAgentFrames::ShadowStatus.UnknownBinding
    return TestResult::RESUME if DebuggerAgentFrames::agent_shadow_stack_resume(shadow_stack, Generation::SECOND) != DebuggerAgentFrames::ShadowStatus.Ready
    return TestResult::CHILD_POP if DebuggerAgentFrames::agent_shadow_frame_pop(shadow_stack, child_invocation) != DebuggerAgentFrames::ShadowStatus.Ready
    return TestResult::ROOT_POP if DebuggerAgentFrames::agent_shadow_frame_pop(shadow_stack, root_invocation) != DebuggerAgentFrames::ShadowStatus.Ready
    return TestResult::STACK_DEPTH if DebuggerAgentFrames::agent_shadow_frame_depth(shadow_stack) != StackShape::EMPTY

    for offset in StackShape::EMPTY..<StackShape::MAX_FRAMES:
        invocation_value: u64 = StackShape::RECURSIVE_INVOCATION_BASE + offset.u64()
        parent_value: mutable u64 = Generation::INVALID
        parent_value <- StackShape::RECURSIVE_INVOCATION_BASE + (offset - StackShape::FRAME_ADVANCE).u64() if offset > StackShape::EMPTY
        pushed: DebuggerAgentFrames::ShadowStatus = DebuggerAgentFrames::agent_shadow_frame_push(shadow_stack, debug_id(invocation_value), debug_id(parent_value), function_id, task_id, source_id, SourcePosition::CHILD_LINE, SourcePosition::CHILD_COLUMN)
        return TestResult::FRAME_CAPACITY if pushed != DebuggerAgentFrames::ShadowStatus.Ready
    extra_invocation: DebuggerIdentity::DebugId = debug_id(StackShape::RECURSIVE_INVOCATION_BASE + StackShape::MAX_FRAMES.u64())
    return TestResult::FRAME_OVERFLOW if DebuggerAgentFrames::agent_shadow_frame_push(shadow_stack, extra_invocation, debug_id(StackShape::RECURSIVE_INVOCATION_BASE + (StackShape::MAX_FRAMES - StackShape::FRAME_ADVANCE).u64()), function_id, task_id, source_id, SourcePosition::CHILD_LINE, SourcePosition::CHILD_COLUMN) != DebuggerAgentFrames::ShadowStatus.FrameCapacityReached
    for offset in StackShape::EMPTY..<StackShape::MAX_FRAMES:
        reverse_offset: usize = StackShape::MAX_FRAMES - StackShape::FRAME_ADVANCE - offset
        invocation_value: DebuggerIdentity::DebugId = debug_id(StackShape::RECURSIVE_INVOCATION_BASE + reverse_offset.u64())
        return TestResult::RECURSIVE_UNWIND if DebuggerAgentFrames::agent_shadow_frame_pop(shadow_stack, invocation_value) != DebuggerAgentFrames::ShadowStatus.Ready
    return TestResult::STACK_VALIDITY if not DebuggerAgentFrames::agent_shadow_stack_is_exact(shadow_stack) or DebuggerAgentFrames::agent_shadow_frame_depth(shadow_stack) != StackShape::EMPTY
    return TestResult::SUCCESS
