include "../src/agent/threads.elisa"

const module ThreadId:
    FIRST: u64 = 101
    SECOND: u64 = 202
    THIRD: u64 = 303
    MISSING: u64 = 404
    INVALID: u64 = 0
    CAPACITY_BASE: u64 = 1000

const module Generation:
    FIRST: u64 = 1
    SECOND: u64 = 2
    THIRD: u64 = 3
    FOURTH: u64 = 4
    FIFTH: u64 = 5
    SIXTH: u64 = 6
    INVALID: u64 = 0

const module Time:
    FIRST_NOW: u64 = 100
    FIRST_DEADLINE: u64 = 200
    FIRST_POLL: u64 = 110
    SECOND_POLL: u64 = 120
    FIRST_TIMEOUT_NOW: u64 = 250
    SECOND_NOW: u64 = 300
    SECOND_DEADLINE: u64 = 350
    BEFORE_DEADLINE: u64 = 349
    SECOND_TIMEOUT_NOW: u64 = 350
    THIRD_NOW: u64 = 400
    THIRD_DEADLINE: u64 = 500
    THIRD_POLL: u64 = 450
    THIRD_BEFORE_DEADLINE: u64 = 499
    THIRD_TIMEOUT_NOW: u64 = 500
    FOURTH_NOW: u64 = 600
    FOURTH_DEADLINE: u64 = 700
    FOURTH_POLL: u64 = 650
    FOURTH_AFTER_DEADLINE: u64 = 701
    FIFTH_NOW: u64 = 800
    FIFTH_DEADLINE: u64 = 850
    FIFTH_TIMEOUT_NOW: u64 = 850
    SIXTH_NOW: u64 = 900
    SIXTH_DEADLINE: u64 = 950
    SIXTH_POLL: u64 = 925
    SIXTH_TIMEOUT_NOW: u64 = 950

const module Count:
    EMPTY: usize = 0
    ONE: usize = 1
    TWO: usize = 2
    THREE: usize = 3
    FIRST_SLOT: usize = 0
    SECOND_SLOT: usize = 1
    THIRD_SLOT: usize = 2
    EXPECTED_THREAD_CAPACITY: usize = 64

const module Failure:
    SUCCESS: i64 = 0
    INITIALIZE: i64 = 1
    REGISTER: i64 = 2
    DUPLICATE: i64 = 3
    INVALID_ID: i64 = 4
    STOP_REQUEST: i64 = 5
    FIRST_PARK: i64 = 6
    PARTIAL_READY: i64 = 7
    LATE_REGISTER: i64 = 8
    NOT_ALL_PARKED: i64 = 9
    SECOND_PARK: i64 = 10
    THIRD_PARK: i64 = 11
    READY: i64 = 12
    PARKED_COUNT: i64 = 13
    GENERATION_MISMATCH: i64 = 14
    RESUME: i64 = 15
    RESUME_STATE: i64 = 16
    UNREGISTER: i64 = 17
    COMPACTION: i64 = 18
    UNKNOWN_THREAD: i64 = 19
    SECOND_STOP: i64 = 20
    SAFE_POINT_TIMEOUT: i64 = 21
    TIMEOUT_STATE: i64 = 22
    STALE_GENERATION: i64 = 23
    THIRD_STOP: i64 = 24
    EARLY_EXPIRY: i64 = 25
    DUE_EXPIRY: i64 = 26
    EXPIRY_STATE: i64 = 27
    FOURTH_STOP: i64 = 28
    FOURTH_PARK: i64 = 29
    EXIT_RENDEZVOUS: i64 = 30
    FINAL_RESUME: i64 = 31
    EMPTY_STOP_REQUEST: i64 = 32
    INVALID_DEADLINE: i64 = 33
    ALREADY_PARKED: i64 = 34
    CAPACITY_FILL: i64 = 35
    CAPACITY_REJECT: i64 = 36
    READY_DEADLINE: i64 = 37
    REGISTER_WHILE_READY: i64 = 38
    EXPIRED_REGISTER: i64 = 39
    EXIT_AFTER_DEADLINE: i64 = 40

def main() -> i64:
    registry: mutable DebuggerAgentThreads::AgentThreadRegistry = zeroed
    DebuggerAgentThreads::agent_threads_initialize(registry)
    return Failure::INITIALIZE if not DebuggerAgentThreads::agent_thread_registry_is_exact(registry) or DebuggerAgentThreads::agent_thread_registry_capacity() != Count::EXPECTED_THREAD_CAPACITY

    return Failure::INVALID_ID if DebuggerAgentThreads::agent_thread_register(registry, ThreadId::INVALID, Time::FIRST_NOW) != DebuggerAgentThreads::ThreadStatus.InvalidThreadId
    return Failure::REGISTER if DebuggerAgentThreads::agent_thread_register(registry, ThreadId::FIRST, Time::FIRST_NOW) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::REGISTER if DebuggerAgentThreads::agent_thread_register(registry, ThreadId::SECOND, Time::FIRST_NOW) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::DUPLICATE if DebuggerAgentThreads::agent_thread_register(registry, ThreadId::FIRST, Time::FIRST_NOW) != DebuggerAgentThreads::ThreadStatus.DuplicateThread
    return Failure::REGISTER if DebuggerAgentThreads::agent_thread_registry_is_exact(registry) == false or DebuggerAgentThreads::agent_threads_live_count(registry) != Count::TWO

    return Failure::STOP_REQUEST if DebuggerAgentThreads::agent_threads_request_stop(registry, Generation::INVALID, Time::FIRST_NOW, Time::FIRST_DEADLINE) != DebuggerAgentThreads::ThreadStatus.InvalidGeneration
    return Failure::STOP_REQUEST if DebuggerAgentThreads::agent_threads_request_stop(registry, Generation::FIRST, Time::FIRST_NOW, Time::FIRST_DEADLINE) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::FIRST_PARK if DebuggerAgentThreads::agent_thread_safe_point(registry, ThreadId::FIRST, Time::FIRST_POLL) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::ALREADY_PARKED if DebuggerAgentThreads::agent_thread_safe_point(registry, ThreadId::FIRST, Time::FIRST_POLL) != DebuggerAgentThreads::ThreadStatus.AlreadyParked
    return Failure::PARTIAL_READY if DebuggerAgentThreads::agent_threads_stop_is_ready(registry, Generation::FIRST) or DebuggerAgentThreads::agent_threads_parked_count(registry) != Count::ONE
    return Failure::LATE_REGISTER if DebuggerAgentThreads::agent_thread_register(registry, ThreadId::THIRD, Time::SECOND_POLL) != DebuggerAgentThreads::ThreadStatus.Applied or registry.threads[Count::THIRD_SLOT].state != DebuggerAgentThreads::ThreadState.StopRequested
    return Failure::NOT_ALL_PARKED if DebuggerAgentThreads::agent_threads_resume(registry, Generation::FIRST) != DebuggerAgentThreads::ThreadStatus.StopNotReady
    return Failure::SECOND_PARK if DebuggerAgentThreads::agent_thread_safe_point(registry, ThreadId::SECOND, Time::SECOND_POLL) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::THIRD_PARK if DebuggerAgentThreads::agent_thread_safe_point(registry, ThreadId::THIRD, Time::SECOND_POLL) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::READY if not DebuggerAgentThreads::agent_threads_stop_is_ready(registry, Generation::FIRST)
    return Failure::PARKED_COUNT if DebuggerAgentThreads::agent_threads_parked_count(registry) != Count::THREE
    return Failure::GENERATION_MISMATCH if DebuggerAgentThreads::agent_threads_resume(registry, Generation::SECOND) != DebuggerAgentThreads::ThreadStatus.GenerationMismatch or not registry.stop_pending
    return Failure::RESUME if DebuggerAgentThreads::agent_threads_resume(registry, Generation::FIRST) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::RESUME_STATE if registry.stop_pending or registry.last_stop_timed_out or registry.threads[Count::FIRST_SLOT].state != DebuggerAgentThreads::ThreadState.Running or not DebuggerAgentThreads::agent_thread_registry_is_exact(registry)

    return Failure::UNREGISTER if DebuggerAgentThreads::agent_thread_unregister(registry, ThreadId::SECOND, Time::SECOND_POLL) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::COMPACTION if registry.active_count != Count::TWO or registry.threads[Count::SECOND_SLOT].thread_id != ThreadId::THIRD or not DebuggerAgentThreads::agent_thread_registry_is_exact(registry)
    return Failure::UNKNOWN_THREAD if DebuggerAgentThreads::agent_thread_unregister(registry, ThreadId::MISSING, Time::SECOND_POLL) != DebuggerAgentThreads::ThreadStatus.UnknownThread

    return Failure::SECOND_STOP if DebuggerAgentThreads::agent_threads_request_stop(registry, Generation::SECOND, Time::SECOND_NOW, Time::SECOND_DEADLINE) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::SAFE_POINT_TIMEOUT if DebuggerAgentThreads::agent_thread_safe_point(registry, ThreadId::FIRST, Time::SECOND_TIMEOUT_NOW) != DebuggerAgentThreads::ThreadStatus.StopTimedOut
    return Failure::TIMEOUT_STATE if registry.stop_pending or not registry.last_stop_timed_out or registry.threads[Count::FIRST_SLOT].state != DebuggerAgentThreads::ThreadState.Running or registry.threads[Count::SECOND_SLOT].state != DebuggerAgentThreads::ThreadState.Running or not DebuggerAgentThreads::agent_thread_registry_is_exact(registry)
    return Failure::STALE_GENERATION if DebuggerAgentThreads::agent_threads_request_stop(registry, Generation::SECOND, Time::SECOND_NOW, Time::SECOND_DEADLINE) != DebuggerAgentThreads::ThreadStatus.StaleGeneration

    return Failure::THIRD_STOP if DebuggerAgentThreads::agent_threads_request_stop(registry, Generation::THIRD, Time::THIRD_NOW, Time::THIRD_DEADLINE) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::FOURTH_PARK if DebuggerAgentThreads::agent_thread_safe_point(registry, ThreadId::FIRST, Time::THIRD_POLL) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::EARLY_EXPIRY if DebuggerAgentThreads::agent_threads_expire_stop(registry, Time::THIRD_BEFORE_DEADLINE) != DebuggerAgentThreads::ThreadStatus.StopNotReady or registry.threads[Count::FIRST_SLOT].state != DebuggerAgentThreads::ThreadState.Parked
    return Failure::DUE_EXPIRY if DebuggerAgentThreads::agent_threads_expire_stop(registry, Time::THIRD_TIMEOUT_NOW) != DebuggerAgentThreads::ThreadStatus.StopTimedOut
    return Failure::EXPIRY_STATE if registry.stop_pending or not registry.last_stop_timed_out or registry.threads[Count::FIRST_SLOT].state != DebuggerAgentThreads::ThreadState.Running or registry.threads[Count::SECOND_SLOT].state != DebuggerAgentThreads::ThreadState.Running

    return Failure::FOURTH_STOP if DebuggerAgentThreads::agent_threads_request_stop(registry, Generation::FOURTH, Time::FOURTH_NOW, Time::FOURTH_DEADLINE) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::FOURTH_PARK if DebuggerAgentThreads::agent_thread_safe_point(registry, ThreadId::FIRST, Time::FOURTH_POLL) != DebuggerAgentThreads::ThreadStatus.Applied
    return Failure::EXIT_RENDEZVOUS if DebuggerAgentThreads::agent_thread_unregister(registry, ThreadId::THIRD, Time::FOURTH_POLL) != DebuggerAgentThreads::ThreadStatus.Applied or not DebuggerAgentThreads::agent_threads_stop_is_ready(registry, Generation::FOURTH)
    return Failure::READY_DEADLINE if DebuggerAgentThreads::agent_threads_expire_stop(registry, Time::FOURTH_AFTER_DEADLINE) != DebuggerAgentThreads::ThreadStatus.StopAlreadyReady or not DebuggerAgentThreads::agent_threads_stop_is_ready(registry, Generation::FOURTH)
    return Failure::REGISTER_WHILE_READY if DebuggerAgentThreads::agent_thread_register(registry, ThreadId::MISSING, Time::FOURTH_AFTER_DEADLINE) != DebuggerAgentThreads::ThreadStatus.StopAlreadyReady or registry.active_count != Count::ONE
    return Failure::FINAL_RESUME if DebuggerAgentThreads::agent_threads_resume(registry, Generation::FOURTH) != DebuggerAgentThreads::ThreadStatus.Applied or not DebuggerAgentThreads::agent_thread_registry_is_exact(registry)

    return Failure::EXPIRED_REGISTER if DebuggerAgentThreads::agent_threads_request_stop(registry, Generation::FIFTH, Time::FIFTH_NOW, Time::FIFTH_DEADLINE) != DebuggerAgentThreads::ThreadStatus.Applied or DebuggerAgentThreads::agent_thread_register(registry, ThreadId::MISSING, Time::FIFTH_TIMEOUT_NOW) != DebuggerAgentThreads::ThreadStatus.StopTimedOutAndRegistered or registry.stop_pending or not registry.last_stop_timed_out or registry.active_count != Count::TWO or registry.threads[Count::SECOND_SLOT].thread_id != ThreadId::MISSING or not DebuggerAgentThreads::agent_thread_registry_is_exact(registry)
    return Failure::EXIT_AFTER_DEADLINE if DebuggerAgentThreads::agent_threads_request_stop(registry, Generation::SIXTH, Time::SIXTH_NOW, Time::SIXTH_DEADLINE) != DebuggerAgentThreads::ThreadStatus.Applied or DebuggerAgentThreads::agent_thread_safe_point(registry, ThreadId::FIRST, Time::SIXTH_POLL) != DebuggerAgentThreads::ThreadStatus.Applied or DebuggerAgentThreads::agent_thread_unregister(registry, ThreadId::MISSING, Time::SIXTH_TIMEOUT_NOW) != DebuggerAgentThreads::ThreadStatus.StopTimedOutAndUnregistered or registry.stop_pending or not registry.last_stop_timed_out or registry.active_count != Count::ONE or registry.threads[Count::FIRST_SLOT].state != DebuggerAgentThreads::ThreadState.Running or not DebuggerAgentThreads::agent_thread_registry_is_exact(registry)

    empty_registry: mutable DebuggerAgentThreads::AgentThreadRegistry = zeroed
    DebuggerAgentThreads::agent_threads_initialize(empty_registry)
    return Failure::EMPTY_STOP_REQUEST if DebuggerAgentThreads::agent_threads_request_stop(empty_registry, Generation::FIRST, Time::FIRST_NOW, Time::FIRST_DEADLINE) != DebuggerAgentThreads::ThreadStatus.NoLiveThreads
    return Failure::INVALID_DEADLINE if DebuggerAgentThreads::agent_thread_register(empty_registry, ThreadId::FIRST, Time::FIRST_NOW) != DebuggerAgentThreads::ThreadStatus.Applied or DebuggerAgentThreads::agent_threads_request_stop(empty_registry, Generation::FIRST, Time::FIRST_NOW, Time::FIRST_NOW) != DebuggerAgentThreads::ThreadStatus.InvalidDeadline

    capacity_registry: mutable DebuggerAgentThreads::AgentThreadRegistry = zeroed
    DebuggerAgentThreads::agent_threads_initialize(capacity_registry)
    for offset in Count::EMPTY..<Count::EXPECTED_THREAD_CAPACITY:
        thread_id: u64 = ThreadId::CAPACITY_BASE + offset.u64()
        return Failure::CAPACITY_FILL if DebuggerAgentThreads::agent_thread_register(capacity_registry, thread_id, Time::FIRST_NOW) != DebuggerAgentThreads::ThreadStatus.Applied
    overflow_thread_id: u64 = ThreadId::CAPACITY_BASE + Count::EXPECTED_THREAD_CAPACITY.u64()
    return Failure::CAPACITY_REJECT if DebuggerAgentThreads::agent_thread_register(capacity_registry, overflow_thread_id, Time::FIRST_NOW) != DebuggerAgentThreads::ThreadStatus.ThreadCapacityReached or DebuggerAgentThreads::agent_threads_live_count(capacity_registry) != Count::EXPECTED_THREAD_CAPACITY
    return Failure::SUCCESS
