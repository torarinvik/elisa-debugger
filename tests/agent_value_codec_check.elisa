include "../src/agent/value_codec.elisa"

const module Width:
    ZERO_BYTES: usize = 0
    ONE_BYTE: usize = 1
    FOUR_BYTES: usize = 4
    EIGHT_BYTES: usize = 8
    TOO_MANY_BYTES: usize = 9

const module Identity:
    BINDING: u64 = 101
    SCOPE: u64 = 102
    TYPE: u64 = 103

const module SignedValue:
    NEGATIVE_EIGHT: i64 = -8
    NEGATIVE_ONE_TWENTY_NINE: i64 = -129
    POSITIVE_ONE_TWENTY_EIGHT: i64 = 128
    MINIMUM: i64 = -9223372036854775807 - 1

const module UnsignedValue:
    MAXIMUM_FOUR_BYTE: u64 = 4294967295
    OVERFLOW_FOUR_BYTE: u64 = 4294967296
    MAXIMUM: u64 = 18446744073709551615

const module EncodedByte:
    NEGATIVE_EIGHT: u8 = 248
    SIGNED_MINIMUM_HIGH: u8 = 128
    UNSIGNED_MAXIMUM: u8 = 255
    INVALID_BOOLEAN: u8 = 2
    TRUE: u8 = 1
    ZERO: u8 = 0
    FIRST: usize = 0
    LAST: usize = 7

const module Storage:
    STACK_OFFSET: i64 = -8
    ZERO: i64 = 0

const module TestResult:
    SUCCESS: i64 = 0
    SIGNED_ENCODE: i64 = 1
    SIGNED_DESCRIPTOR: i64 = 2
    SIGNED_DECODE: i64 = 3
    SIGNED_RANGE: i64 = 4
    MINIMUM_ENCODE: i64 = 5
    MINIMUM_DECODE: i64 = 6
    UNSIGNED_ENCODE: i64 = 7
    UNSIGNED_DECODE: i64 = 8
    UNSIGNED_RANGE: i64 = 9
    BOOLEAN_ENCODE: i64 = 10
    BOOLEAN_DECODE: i64 = 11
    INVALID_BOOLEAN: i64 = 12
    UNAVAILABLE: i64 = 13
    UNSUPPORTED_KIND: i64 = 14
    MALFORMED_ENCODED_DESCRIPTOR: i64 = 15

def debug_id(value: u64) -> DebuggerIdentity::DebugId:
    return DebuggerIdentity::DebugId{value: value}

def descriptor_for(encoded: DebuggerAgentValueCodec::EncodedScalar) -> DebuggerAgentValueCodec::EncodedDescriptor:
    return DebuggerAgentValueCodec::agent_scalar_descriptor(debug_id(Identity::BINDING), debug_id(Identity::SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentStorageKind.StackSlot, Storage::STACK_OFFSET, encoded)

def main() -> i64:
    encoded_negative: DebuggerAgentValueCodec::EncodedScalar = DebuggerAgentValueCodec::agent_scalar_encode_signed(SignedValue::NEGATIVE_EIGHT, Width::ONE_BYTE)
    return TestResult::SIGNED_ENCODE if encoded_negative.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or encoded_negative.byte_count != Width::ONE_BYTE or encoded_negative.value_kind != DebuggerAgentFrames::AgentValueKind.Signed or encoded_negative.bytes[EncodedByte::FIRST] != EncodedByte::NEGATIVE_EIGHT
    negative_descriptor: DebuggerAgentValueCodec::EncodedDescriptor = descriptor_for(encoded_negative)
    return TestResult::SIGNED_DESCRIPTOR if negative_descriptor.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or not DebuggerAgentFrames::agent_storage_descriptor_is_exact(negative_descriptor.descriptor)
    decoded_negative: DebuggerAgentValueCodec::DecodedScalar = DebuggerAgentValueCodec::agent_scalar_decode(negative_descriptor.descriptor)
    return TestResult::SIGNED_DECODE if decoded_negative.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_negative.signed_value != SignedValue::NEGATIVE_EIGHT
    return TestResult::SIGNED_RANGE if DebuggerAgentValueCodec::agent_scalar_encode_signed(SignedValue::POSITIVE_ONE_TWENTY_EIGHT, Width::ONE_BYTE).status != DebuggerAgentValueCodec::ValueCodecStatus.ValueOutOfRange or DebuggerAgentValueCodec::agent_scalar_encode_signed(SignedValue::NEGATIVE_ONE_TWENTY_NINE, Width::ONE_BYTE).status != DebuggerAgentValueCodec::ValueCodecStatus.ValueOutOfRange

    encoded_minimum: DebuggerAgentValueCodec::EncodedScalar = DebuggerAgentValueCodec::agent_scalar_encode_signed(SignedValue::MINIMUM, Width::EIGHT_BYTES)
    return TestResult::MINIMUM_ENCODE if encoded_minimum.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or encoded_minimum.bytes[EncodedByte::FIRST] != Storage::ZERO.u8() or encoded_minimum.bytes[EncodedByte::LAST] != EncodedByte::SIGNED_MINIMUM_HIGH
    minimum_descriptor: DebuggerAgentValueCodec::EncodedDescriptor = descriptor_for(encoded_minimum)
    decoded_minimum: DebuggerAgentValueCodec::DecodedScalar = DebuggerAgentValueCodec::agent_scalar_decode(minimum_descriptor.descriptor)
    return TestResult::MINIMUM_DECODE if minimum_descriptor.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_minimum.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_minimum.signed_value != SignedValue::MINIMUM

    encoded_unsigned: DebuggerAgentValueCodec::EncodedScalar = DebuggerAgentValueCodec::agent_scalar_encode_unsigned(UnsignedValue::MAXIMUM_FOUR_BYTE, Width::FOUR_BYTES)
    return TestResult::UNSIGNED_ENCODE if encoded_unsigned.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or encoded_unsigned.byte_count != Width::FOUR_BYTES or encoded_unsigned.bytes[EncodedByte::FIRST] != EncodedByte::UNSIGNED_MAXIMUM
    unsigned_descriptor: DebuggerAgentValueCodec::EncodedDescriptor = descriptor_for(encoded_unsigned)
    decoded_unsigned: DebuggerAgentValueCodec::DecodedScalar = DebuggerAgentValueCodec::agent_scalar_decode(unsigned_descriptor.descriptor)
    return TestResult::UNSIGNED_DECODE if unsigned_descriptor.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_unsigned.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_unsigned.unsigned_value != UnsignedValue::MAXIMUM_FOUR_BYTE
    return TestResult::UNSIGNED_RANGE if DebuggerAgentValueCodec::agent_scalar_encode_unsigned(UnsignedValue::OVERFLOW_FOUR_BYTE, Width::FOUR_BYTES).status != DebuggerAgentValueCodec::ValueCodecStatus.ValueOutOfRange
    maximum_descriptor: DebuggerAgentValueCodec::EncodedDescriptor = descriptor_for(DebuggerAgentValueCodec::agent_scalar_encode_unsigned(UnsignedValue::MAXIMUM, Width::EIGHT_BYTES))
    decoded_maximum: DebuggerAgentValueCodec::DecodedScalar = DebuggerAgentValueCodec::agent_scalar_decode(maximum_descriptor.descriptor)
    return TestResult::UNSIGNED_DECODE if decoded_maximum.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_maximum.unsigned_value != UnsignedValue::MAXIMUM

    encoded_boolean: DebuggerAgentValueCodec::EncodedScalar = DebuggerAgentValueCodec::agent_scalar_encode_boolean(true)
    boolean_descriptor: DebuggerAgentValueCodec::EncodedDescriptor = descriptor_for(encoded_boolean)
    decoded_boolean: DebuggerAgentValueCodec::DecodedScalar = DebuggerAgentValueCodec::agent_scalar_decode(boolean_descriptor.descriptor)
    return TestResult::BOOLEAN_ENCODE if encoded_boolean.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or encoded_boolean.byte_count != Width::ONE_BYTE or encoded_boolean.bytes[EncodedByte::FIRST] != EncodedByte::TRUE
    return TestResult::BOOLEAN_DECODE if boolean_descriptor.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_boolean.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or not decoded_boolean.boolean_value
    encoded_false: DebuggerAgentValueCodec::EncodedScalar = DebuggerAgentValueCodec::agent_scalar_encode_boolean(false)
    false_descriptor: DebuggerAgentValueCodec::EncodedDescriptor = descriptor_for(encoded_false)
    decoded_false: DebuggerAgentValueCodec::DecodedScalar = DebuggerAgentValueCodec::agent_scalar_decode(false_descriptor.descriptor)
    return TestResult::BOOLEAN_DECODE if encoded_false.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or encoded_false.bytes[EncodedByte::FIRST] != EncodedByte::ZERO or false_descriptor.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_false.status != DebuggerAgentValueCodec::ValueCodecStatus.Ready or decoded_false.boolean_value
    boolean_descriptor.descriptor.bytes[EncodedByte::FIRST] <- EncodedByte::INVALID_BOOLEAN
    return TestResult::INVALID_BOOLEAN if DebuggerAgentValueCodec::agent_scalar_decode(boolean_descriptor.descriptor).status != DebuggerAgentValueCodec::ValueCodecStatus.InvalidBoolean

    unavailable: mutable DebuggerAgentFrames::AgentStorageDescriptor = negative_descriptor.descriptor
    unavailable.state <- DebuggerAgentFrames::AgentValueState.OptimizedAway
    unavailable.byte_size <- Width::ZERO_BYTES.u64()
    return TestResult::UNAVAILABLE if DebuggerAgentValueCodec::agent_scalar_decode(unavailable).status != DebuggerAgentValueCodec::ValueCodecStatus.Unavailable

    unsupported: mutable DebuggerAgentFrames::AgentStorageDescriptor = negative_descriptor.descriptor
    unsupported.value_kind <- DebuggerAgentFrames::AgentValueKind.Floating
    return TestResult::UNSUPPORTED_KIND if DebuggerAgentValueCodec::agent_scalar_decode(unsupported).status != DebuggerAgentValueCodec::ValueCodecStatus.UnsupportedKind
    malformed_encoded: mutable DebuggerAgentValueCodec::EncodedScalar = encoded_negative
    malformed_encoded.byte_count <- Width::TOO_MANY_BYTES
    return TestResult::MALFORMED_ENCODED_DESCRIPTOR if DebuggerAgentValueCodec::agent_scalar_descriptor(debug_id(Identity::BINDING), debug_id(Identity::SCOPE), debug_id(Identity::TYPE), DebuggerAgentFrames::AgentStorageKind.StackSlot, Storage::STACK_OFFSET, malformed_encoded).status != DebuggerAgentValueCodec::ValueCodecStatus.InvalidWidth
    return TestResult::SUCCESS
