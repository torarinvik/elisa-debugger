include "../src/breakpoint/manager.elisa"

const module Test:
    NO_BREAKPOINTS: usize = 0
    SOURCE_ID: u64 = 77
    SOURCE_LINE: u32 = 3
    SOURCE_START_COLUMN: u32 = 0
    SOURCE_END_COLUMN: u32 = 8
    CURRENT_COLUMN: u32 = 2
    FIRST_HIT_TARGET: u64 = 2
    SECOND_HIT_TARGET: u64 = 1
    EXPECTED_FIRST_HIT_COUNT: u64 = 1
    EXPECTED_SECOND_HIT_COUNT: u64 = 1
    EXPECTED_REPEATED_HIT_COUNT: u64 = Test::EXPECTED_FIRST_HIT_COUNT + 1
    OTHER_SOURCE_ID: u64 = 88
    REPLACEMENT_LINE: u32 = Test::SOURCE_LINE + 1
    REPLACEMENT_BRANCH_ID: u64 = 9
    REPLACEMENT_BREAKPOINT_COUNT: usize = 1
    EXPECTED_REPLACED_TABLE_COUNT: usize = 2


def breakpoint_for(source: DebuggerMetadata::SourceLocation, target: u64) -> DebuggerBreakpoints::Breakpoint:
    return DebuggerBreakpoints::Breakpoint{id: zeroed, branch: DebuggerIdentity::debug_id(0), kind: DebuggerBreakpoints::BreakpointKind.Source, status: DebuggerBreakpoints::BreakpointStatus.Pending, source: source, condition: DebuggerIdentity::debug_id(0), condition_expression: zeroed, condition_length: 0, function_name: zeroed, function_name_length: DebuggerBreakpoints::breakpoint_empty_function_name_length(), log_message: zeroed, log_message_length: 0, hit_target: target, hit_count: 0, hit_stride: 0, task: DebuggerIdentity::debug_id(0), logpoint: false, temporary: false}

def main() -> i64:
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::SOURCE_ID), line: Test::SOURCE_LINE, column: Test::CURRENT_COLUMN, discriminator: 0}
    span: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(Test::SOURCE_ID), start_byte: 0, end_byte: 8, start_line: Test::SOURCE_LINE, start_column: Test::SOURCE_START_COLUMN, end_line: Test::SOURCE_LINE, end_column: Test::SOURCE_END_COLUMN, discriminator: 0}
    table: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_new()
    _ = DebuggerBreakpointManager::breakpoint_table_add(table, breakpoint_for(location, Test::FIRST_HIT_TARGET))
    table <- DebuggerBreakpointManager::breakpoint_table_resolve(table, DebuggerIdentity::debug_id(Test::SOURCE_ID), Test::SOURCE_LINE.u64())
    return 10 if not DebuggerBreakpointManager::breakpoint_table_is_valid(table)
    _ = DebuggerBreakpointManager::breakpoint_table_add(table, breakpoint_for(location, Test::SECOND_HIT_TARGET))
    table <- DebuggerBreakpointManager::breakpoint_table_resolve(table, DebuggerIdentity::debug_id(Test::SOURCE_ID), Test::SOURCE_LINE.u64())
    return 1 if not DebuggerBreakpointManager::breakpoint_table_should_stop(table, DebuggerIdentity::debug_id(0), span)
    return 2 if table.points[0].hit_count != Test::EXPECTED_FIRST_HIT_COUNT or table.points[1].hit_count != Test::EXPECTED_SECOND_HIT_COUNT
    return 19 if not DebuggerBreakpointManager::breakpoint_table_should_stop(table, DebuggerIdentity::debug_id(0), span)
    return 19 if table.points[0].hit_count != Test::EXPECTED_REPEATED_HIT_COUNT or table.points[1].hit_count != Test::EXPECTED_REPEATED_HIT_COUNT

    pending: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_new()
    _ = DebuggerBreakpointManager::breakpoint_table_add(pending, breakpoint_for(location, Test::SECOND_HIT_TARGET))
    return 3 if DebuggerBreakpointManager::breakpoint_table_should_stop(pending, DebuggerIdentity::debug_id(0), span)
    return 4 if pending.points[0].hit_count != 0
    non_source: DebuggerBreakpoints::Breakpoint = breakpoint_for(location, 0)
    non_source.kind <- DebuggerBreakpoints::BreakpointKind.Function
    non_source_table: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_new()
    _ = DebuggerBreakpointManager::breakpoint_table_add(non_source_table, non_source)
    non_source_table <- DebuggerBreakpointManager::breakpoint_table_resolve(non_source_table, DebuggerIdentity::debug_id(Test::SOURCE_ID), Test::SOURCE_LINE.u64())
    return 9 if non_source_table.points[0].status != DebuggerBreakpoints::BreakpointStatus.Pending
    return 7 if DebuggerBreakpointManager::breakpoint_table_should_stop(non_source_table, DebuggerIdentity::debug_id(0), span)
    return 8 if DebuggerBreakpointManager::breakpoint_table_would_stop(non_source_table, DebuggerIdentity::debug_id(0), span)
    logpoint: DebuggerBreakpoints::Breakpoint = breakpoint_for(location, 0)
    logpoint.status <- DebuggerBreakpoints::BreakpointStatus.Verified
    logpoint.logpoint <- true
    return 5 if DebuggerBreakpoints::breakpoint_should_stop(logpoint, DebuggerIdentity::debug_id(0))
    invalid_source: DebuggerBreakpoints::Breakpoint = breakpoint_for(DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(0), line: Test::SOURCE_LINE, column: Test::CURRENT_COLUMN, discriminator: 0}, 0)
    previous_table_count: usize = table.count
    rejected_source: bool = DebuggerBreakpointManager::breakpoint_table_add(table, invalid_source)
    return 6 if rejected_source or table.count != previous_table_count
    invalid_table: mutable DebuggerBreakpointManager::BreakpointTable = table
    invalid_table.next_id <- 0
    return 11 if DebuggerBreakpointManager::breakpoint_table_is_valid(invalid_table)
    invalid_counter: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_new()
    _ = DebuggerBreakpointManager::breakpoint_table_add(invalid_counter, breakpoint_for(location, 0))
    invalid_counter.next_id <- 9
    invalid_counter.points[0].id <- DebuggerIdentity::debug_id(invalid_counter.next_id)
    return 12 if DebuggerBreakpointManager::breakpoint_table_is_valid(invalid_counter)
    multi_source: mutable DebuggerBreakpointManager::BreakpointTable = table
    other_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::OTHER_SOURCE_ID), line: Test::SOURCE_LINE, column: Test::CURRENT_COLUMN, discriminator: 0}
    _ = DebuggerBreakpointManager::breakpoint_table_add(multi_source, breakpoint_for(other_location, 0))
    replacement_lines: mutable u32[Test::REPLACEMENT_BREAKPOINT_COUNT] = [Test::REPLACEMENT_LINE]
    first_replacement_id: u64 = multi_source.next_id
    replacement: DebuggerBreakpointManager::BreakpointReplacement = DebuggerBreakpointManager::breakpoint_table_replace_source(multi_source, DebuggerIdentity::debug_id(Test::SOURCE_ID), DebuggerIdentity::debug_id(Test::REPLACEMENT_BRANCH_ID), replacement_lines[0], Test::REPLACEMENT_BREAKPOINT_COUNT)
    return 13 if not replacement.accepted or replacement.count != Test::REPLACEMENT_BREAKPOINT_COUNT or multi_source.count != Test::EXPECTED_REPLACED_TABLE_COUNT
    return 14 if replacement.results[0].id.value != first_replacement_id or replacement.results[0].line != Test::REPLACEMENT_LINE or replacement.results[0].verified
    return 15 if multi_source.points[0].source.file.value != Test::OTHER_SOURCE_ID or multi_source.points[1].source.file.value != Test::SOURCE_ID
    return 16 if not DebuggerBreakpointManager::breakpoint_table_is_valid(multi_source)
    empty_lines: mutable u32[Test::REPLACEMENT_BREAKPOINT_COUNT] = zeroed
    cleared: DebuggerBreakpointManager::BreakpointReplacement = DebuggerBreakpointManager::breakpoint_table_replace_source(multi_source, DebuggerIdentity::debug_id(Test::SOURCE_ID), DebuggerIdentity::debug_id(Test::REPLACEMENT_BRANCH_ID), empty_lines[0], 0)
    return 17 if not cleared.accepted or cleared.count != Test::NO_BREAKPOINTS or multi_source.count != Test::REPLACEMENT_BREAKPOINT_COUNT or multi_source.points[0].source.file.value != Test::OTHER_SOURCE_ID
    invalid_lines: mutable u32[Test::REPLACEMENT_BREAKPOINT_COUNT] = [0]
    rejected_replacement: DebuggerBreakpointManager::BreakpointReplacement = DebuggerBreakpointManager::breakpoint_table_replace_source(multi_source, DebuggerIdentity::debug_id(Test::SOURCE_ID), DebuggerIdentity::debug_id(Test::REPLACEMENT_BRANCH_ID), invalid_lines[0], Test::REPLACEMENT_BREAKPOINT_COUNT)
    return 18 if rejected_replacement.accepted or multi_source.count != Test::REPLACEMENT_BREAKPOINT_COUNT
    return 0
