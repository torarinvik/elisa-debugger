include "../src/breakpoint/manager.elisa"

const SOURCE_ID: u64 = 77
const SOURCE_LINE: u32 = 3
const SOURCE_START_COLUMN: u32 = 0
const SOURCE_END_COLUMN: u32 = 8
const CURRENT_COLUMN: u32 = 2
const FIRST_HIT_TARGET: u64 = 2
const SECOND_HIT_TARGET: u64 = 1
const EXPECTED_FIRST_HIT_COUNT: u64 = 1
const EXPECTED_SECOND_HIT_COUNT: u64 = 1

def breakpoint_for(source: DebuggerMetadata::SourceLocation, target: u64) -> DebuggerBreakpoints::Breakpoint:
    return DebuggerBreakpoints::Breakpoint{id: zeroed, branch: DebuggerIdentity::debug_id(0), kind: DebuggerBreakpoints::BreakpointKind.Source, status: DebuggerBreakpoints::BreakpointStatus.Pending, source: source, condition: DebuggerIdentity::debug_id(0), hit_target: target, hit_count: 0, hit_stride: 0, task: DebuggerIdentity::debug_id(0), logpoint: false, temporary: false}

def main() -> i64:
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(SOURCE_ID), line: SOURCE_LINE, column: CURRENT_COLUMN, discriminator: 0}
    span: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(SOURCE_ID), start_byte: 0, end_byte: 8, start_line: SOURCE_LINE, start_column: SOURCE_START_COLUMN, end_line: SOURCE_LINE, end_column: SOURCE_END_COLUMN, discriminator: 0}
    table: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_new()
    table <- DebuggerBreakpointManager::breakpoint_table_add(table, breakpoint_for(location, FIRST_HIT_TARGET))
    table <- DebuggerBreakpointManager::breakpoint_table_resolve(table, DebuggerIdentity::debug_id(SOURCE_ID), SOURCE_LINE.u64())
    table <- DebuggerBreakpointManager::breakpoint_table_add(table, breakpoint_for(location, SECOND_HIT_TARGET))
    table <- DebuggerBreakpointManager::breakpoint_table_resolve(table, DebuggerIdentity::debug_id(SOURCE_ID), SOURCE_LINE.u64())
    return 1 if not DebuggerBreakpointManager::breakpoint_table_should_stop(table, DebuggerIdentity::debug_id(0), span)
    return 2 if table.points[0].hit_count != EXPECTED_FIRST_HIT_COUNT or table.points[1].hit_count != EXPECTED_SECOND_HIT_COUNT

    pending: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_new()
    pending <- DebuggerBreakpointManager::breakpoint_table_add(pending, breakpoint_for(location, SECOND_HIT_TARGET))
    return 3 if DebuggerBreakpointManager::breakpoint_table_should_stop(pending, DebuggerIdentity::debug_id(0), span)
    return 4 if pending.points[0].hit_count != 0
    non_source: DebuggerBreakpoints::Breakpoint = breakpoint_for(location, 0)
    non_source.kind <- DebuggerBreakpoints::BreakpointKind.Function
    non_source_table: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_new()
    non_source_table <- DebuggerBreakpointManager::breakpoint_table_add(non_source_table, non_source)
    non_source_table <- DebuggerBreakpointManager::breakpoint_table_resolve(non_source_table, DebuggerIdentity::debug_id(SOURCE_ID), SOURCE_LINE.u64())
    return 9 if non_source_table.points[0].status != DebuggerBreakpoints::BreakpointStatus.Pending
    return 7 if DebuggerBreakpointManager::breakpoint_table_should_stop(non_source_table, DebuggerIdentity::debug_id(0), span)
    return 8 if DebuggerBreakpointManager::breakpoint_table_would_stop(non_source_table, DebuggerIdentity::debug_id(0), span)
    logpoint: DebuggerBreakpoints::Breakpoint = breakpoint_for(location, 0)
    logpoint.status <- DebuggerBreakpoints::BreakpointStatus.Verified
    logpoint.logpoint <- true
    return 5 if DebuggerBreakpoints::breakpoint_should_stop(logpoint, DebuggerIdentity::debug_id(0))
    invalid_source: DebuggerBreakpoints::Breakpoint = breakpoint_for(DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(0), line: SOURCE_LINE, column: CURRENT_COLUMN, discriminator: 0}, 0)
    rejected_source: DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_add(table, invalid_source)
    return 6 if rejected_source.count != table.count
    return 0
