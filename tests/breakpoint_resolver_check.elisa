include "../src/breakpoint/resolver.elisa"

const module Test:
    FUNCTION_NAME_CAPACITY: usize = DebuggerEDIRCapacity::EDIR_FUNCTION_NAME_CAPACITY
    FUNCTION_SCHEMA_VERSION: u32 = 1
    FUNCTION_NAME_FOO_LENGTH: usize = 3
    FUNCTION_NAME_FO_LENGTH: usize = 2
    FUNCTION_NAME_BAR_LENGTH: usize = 3
    FUNCTION_NAME_BAZ_LENGTH: usize = 3
    FUNCTION_BAD_UTF8_LENGTH: usize = 1
    FUNCTION_EMPTY_NAME_LENGTH: usize = 0
    ONE_U64: u64 = 1
    ONE_USIZE: usize = 1
    FUNCTION_ENTRY_STRIDE: u64 = 2
    FUNCTION_INSTRUCTION_COUNT: u64 = 6
    FUNCTION_COUNT: usize = 3
    FUNCTION_CAPACITY_INSTRUCTION_COUNT: u64 = DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY.u64() * Test::FUNCTION_ENTRY_STRIDE
    FUNCTION_FIRST_INDEX: usize = 0
    FUNCTION_SECOND_INDEX: usize = 1
    FUNCTION_THIRD_INDEX: usize = 2
    FIRST_OVERLOAD_INDEX: usize = 0
    SECOND_OVERLOAD_INDEX: usize = 1
    SINGLE_MATCH_INDEX: usize = 0
    FUNCTION_FIRST_ID: u64 = 10
    FUNCTION_SECOND_ID: u64 = 11
    FUNCTION_THIRD_ID: u64 = 12
    FUNCTION_FIRST_ENTRY: u64 = 1
    FUNCTION_FIRST_END: u64 = 2
    FUNCTION_SECOND_ENTRY: u64 = 3
    FUNCTION_SECOND_END: u64 = 4
    FUNCTION_THIRD_ENTRY: u64 = 5
    FUNCTION_THIRD_END: u64 = 6
    NO_INSTRUCTION: u64 = 18446744073709551615
    RESULT_OVERLOAD_RESOLUTION_FAILED: i64 = 11
    RESULT_EXACT_NAME_RESOLUTION_FAILED: i64 = 12
    RESULT_UNRESOLVED_FAILED: i64 = 13
    RESULT_INVALID_QUERY_FAILED: i64 = 14
    RESULT_INVALID_METADATA_FAILED: i64 = 15
    RESULT_CAPACITY_RESOLUTION_FAILED: i64 = 16
    SOURCE_MATCH_COUNT: usize = DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY + Test::ONE_USIZE
    SOURCE_MATCH_ID_BASE: u64 = 100
    SOURCE_MATCH_FUNCTION_ID: u64 = 200
    SOURCE_MATCH_RESULT: i64 = 17
    SOURCE_LAST_MATCH_INDEX: usize = Test::SOURCE_MATCH_COUNT - Test::ONE_USIZE
    SOURCE_FILE_ID: u64 = 1


def main() -> i64:
    fixture_function_bad_utf8_bytes: mutable u8[Test::FUNCTION_BAD_UTF8_LENGTH] = [255]
    fixture_function_missing_name_bytes: mutable u8[Test::FUNCTION_NAME_BAZ_LENGTH] = [98, 97, 122]
    fixture_function_name_bytes: mutable u8[Test::FUNCTION_NAME_FOO_LENGTH] = [102, 111, 111]
    fixture_function_other_name_bytes: mutable u8[Test::FUNCTION_NAME_BAR_LENGTH] = [98, 97, 114]
    fixture_function_prefix_bytes: mutable u8[Test::FUNCTION_NAME_FO_LENGTH] = [102, 111]
    resolver: mutable DebuggerBreakpointResolver::Resolver = DebuggerBreakpointResolver::resolver_new()
    source: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(1), start_byte: 0, end_byte: 1, start_line: 1, start_column: 0, end_line: 1, end_column: 1, discriminator: 0}
    return 1 if not DebuggerBreakpointResolver::resolver_add(resolver, DebuggerBreakpointResolver::Candidate{id: DebuggerIdentity::debug_id(1), function: DebuggerIdentity::debug_id(2), source: source, instruction: 0})
    invalid_location: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_source(resolver, zeroed)
    return 2 if invalid_location.status != DebuggerMetadata::BreakpointResolution.Invalid
    invalid_function: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_function(resolver, DebuggerIdentity::debug_id(0))
    return 3 if invalid_function.status != DebuggerMetadata::BreakpointResolution.Invalid
    valid_location: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_source(resolver, DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(1), line: 1, column: 0, discriminator: 0})
    return 4 if valid_location.status != DebuggerMetadata::BreakpointResolution.Resolved or valid_location.instruction != 0
    many_source_matches: mutable DebuggerBreakpointResolver::Resolver = DebuggerBreakpointResolver::resolver_new()
    for candidate_index in 0..<Test::SOURCE_MATCH_COUNT:
        candidate: DebuggerBreakpointResolver::Candidate = DebuggerBreakpointResolver::Candidate{id: DebuggerIdentity::debug_id(Test::SOURCE_MATCH_ID_BASE + candidate_index.u64()), function: DebuggerIdentity::debug_id(Test::SOURCE_MATCH_FUNCTION_ID), source: source, instruction: candidate_index.u64()}
        return Test::SOURCE_MATCH_RESULT if not DebuggerBreakpointResolver::resolver_add(many_source_matches, candidate)
    many_source_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::SOURCE_FILE_ID), line: source.start_line, column: source.start_column, discriminator: source.discriminator}
    many_source_resolution: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_source(many_source_matches, many_source_location)
    return Test::SOURCE_MATCH_RESULT if many_source_resolution.matched != Test::SOURCE_MATCH_COUNT or DebuggerBreakpointResolver::resolution_instruction_at(many_source_resolution, Test::SOURCE_LAST_MATCH_INDEX) != Test::SOURCE_LAST_MATCH_INDEX.u64()

    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::FUNCTION_SCHEMA_VERSION, instruction_count: Test::FUNCTION_INSTRUCTION_COUNT, local_count: 0, has_return: true}
    image.function_count <- Test::FUNCTION_COUNT
    first_function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
    first_function.id <- DebuggerIdentity::debug_id(Test::FUNCTION_FIRST_ID)
    first_function.name_length <- Test::FUNCTION_NAME_FOO_LENGTH
    for name_index in 0..<Test::FUNCTION_NAME_FOO_LENGTH:
        first_function.name_bytes[name_index] <- fixture_function_name_bytes[name_index]
    first_function.entry_instruction <- Test::FUNCTION_FIRST_ENTRY
    first_function.end_instruction_exclusive <- Test::FUNCTION_FIRST_END
    image.functions[Test::FUNCTION_FIRST_INDEX] <- first_function
    second_function: mutable DebuggerEDIR::FunctionDescriptor = first_function
    second_function.id <- DebuggerIdentity::debug_id(Test::FUNCTION_SECOND_ID)
    second_function.entry_instruction <- Test::FUNCTION_SECOND_ENTRY
    second_function.end_instruction_exclusive <- Test::FUNCTION_SECOND_END
    image.functions[Test::FUNCTION_SECOND_INDEX] <- second_function
    third_function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
    third_function.id <- DebuggerIdentity::debug_id(Test::FUNCTION_THIRD_ID)
    third_function.name_length <- Test::FUNCTION_NAME_BAR_LENGTH
    for name_index in 0..<Test::FUNCTION_NAME_BAR_LENGTH:
        third_function.name_bytes[name_index] <- fixture_function_other_name_bytes[name_index]
    third_function.entry_instruction <- Test::FUNCTION_THIRD_ENTRY
    third_function.end_instruction_exclusive <- Test::FUNCTION_THIRD_END
    image.functions[Test::FUNCTION_THIRD_INDEX] <- third_function

    overloads: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(image, fixture_function_name_bytes[0], Test::FUNCTION_NAME_FOO_LENGTH)
    return Test::RESULT_OVERLOAD_RESOLUTION_FAILED if overloads.status != DebuggerMetadata::BreakpointResolution.PartiallyResolved or overloads.matched != 2 or overloads.instruction != Test::FUNCTION_FIRST_ENTRY
    return Test::RESULT_OVERLOAD_RESOLUTION_FAILED if DebuggerBreakpointResolver::resolution_instruction_at(overloads, Test::FIRST_OVERLOAD_INDEX) != Test::FUNCTION_FIRST_ENTRY or DebuggerBreakpointResolver::resolution_instruction_at(overloads, Test::SECOND_OVERLOAD_INDEX) != Test::FUNCTION_SECOND_ENTRY

    exact_name: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(image, fixture_function_other_name_bytes[0], Test::FUNCTION_NAME_BAR_LENGTH)
    return Test::RESULT_EXACT_NAME_RESOLUTION_FAILED if exact_name.status != DebuggerMetadata::BreakpointResolution.Resolved or exact_name.matched != 1 or exact_name.instruction != Test::FUNCTION_THIRD_ENTRY
    return Test::RESULT_EXACT_NAME_RESOLUTION_FAILED if DebuggerBreakpointResolver::resolution_instruction_at(exact_name, Test::SINGLE_MATCH_INDEX) != Test::FUNCTION_THIRD_ENTRY
    prefix_name: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(image, fixture_function_prefix_bytes[0], Test::FUNCTION_NAME_FO_LENGTH)
    return Test::RESULT_UNRESOLVED_FAILED if prefix_name.status != DebuggerMetadata::BreakpointResolution.Unresolved or prefix_name.matched != 0 or prefix_name.instruction != Test::NO_INSTRUCTION
    missing_name: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(image, fixture_function_missing_name_bytes[0], Test::FUNCTION_NAME_BAZ_LENGTH)
    return Test::RESULT_UNRESOLVED_FAILED if missing_name.status != DebuggerMetadata::BreakpointResolution.Unresolved or missing_name.matched != 0

    invalid_utf8: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(image, fixture_function_bad_utf8_bytes[0], Test::FUNCTION_BAD_UTF8_LENGTH)
    empty_name: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(image, fixture_function_bad_utf8_bytes[0], Test::FUNCTION_EMPTY_NAME_LENGTH)
    return Test::RESULT_INVALID_QUERY_FAILED if invalid_utf8.status != DebuggerMetadata::BreakpointResolution.Invalid or empty_name.status != DebuggerMetadata::BreakpointResolution.Invalid
    invalid_name_image: mutable DebuggerEDIR::ProgramImage = image
    invalid_name_image.functions[Test::FUNCTION_SECOND_INDEX].name_length <- Test::FUNCTION_NAME_CAPACITY + Test::ONE_USIZE
    invalid_name: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(invalid_name_image, fixture_function_name_bytes[0], Test::FUNCTION_NAME_FOO_LENGTH)
    invalid_range_image: mutable DebuggerEDIR::ProgramImage = image
    invalid_range_image.functions[Test::FUNCTION_SECOND_INDEX].end_instruction_exclusive <- Test::FUNCTION_INSTRUCTION_COUNT + Test::ONE_U64
    invalid_range: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(invalid_range_image, fixture_function_name_bytes[0], Test::FUNCTION_NAME_FOO_LENGTH)
    overlapping_range_image: mutable DebuggerEDIR::ProgramImage = image
    overlapping_range_image.functions[Test::FUNCTION_SECOND_INDEX].entry_instruction <- Test::FUNCTION_FIRST_END - Test::ONE_U64
    overlapping_range: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(overlapping_range_image, fixture_function_name_bytes[0], Test::FUNCTION_NAME_FOO_LENGTH)
    duplicate_id_image: mutable DebuggerEDIR::ProgramImage = image
    duplicate_id_image.functions[Test::FUNCTION_SECOND_INDEX].id <- DebuggerIdentity::debug_id(Test::FUNCTION_FIRST_ID)
    duplicate_id: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(duplicate_id_image, fixture_function_name_bytes[0], Test::FUNCTION_NAME_FOO_LENGTH)
    invalid_count_image: mutable DebuggerEDIR::ProgramImage = image
    invalid_count_image.function_count <- DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY + Test::ONE_USIZE
    invalid_count: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(invalid_count_image, fixture_function_name_bytes[0], Test::FUNCTION_NAME_FOO_LENGTH)
    return Test::RESULT_INVALID_METADATA_FAILED if invalid_name.status != DebuggerMetadata::BreakpointResolution.Invalid or invalid_range.status != DebuggerMetadata::BreakpointResolution.Invalid or overlapping_range.status != DebuggerMetadata::BreakpointResolution.Invalid or duplicate_id.status != DebuggerMetadata::BreakpointResolution.Invalid or invalid_count.status != DebuggerMetadata::BreakpointResolution.Invalid

    full_overload_image: mutable DebuggerEDIR::ProgramImage = zeroed
    full_overload_image.program <- DebuggerEDIR::Program{version: Test::FUNCTION_SCHEMA_VERSION, instruction_count: Test::FUNCTION_CAPACITY_INSTRUCTION_COUNT, local_count: 0, has_return: true}
    full_overload_image.function_count <- DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY
    for function_index in 0..<DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY:
        function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
        function.id <- DebuggerIdentity::debug_id(Test::FUNCTION_FIRST_ID + function_index.u64())
        function.name_length <- Test::FUNCTION_NAME_FOO_LENGTH
        for name_index in 0..<Test::FUNCTION_NAME_FOO_LENGTH:
            function.name_bytes[name_index] <- fixture_function_name_bytes[name_index]
        function.entry_instruction <- function_index.u64() * Test::FUNCTION_ENTRY_STRIDE
        function.end_instruction_exclusive <- function.entry_instruction + Test::ONE_U64
        full_overload_image.functions[function_index] <- function
    full_overloads: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_edir_function_name(full_overload_image, fixture_function_name_bytes[0], Test::FUNCTION_NAME_FOO_LENGTH)
    return Test::RESULT_CAPACITY_RESOLUTION_FAILED if full_overloads.status != DebuggerMetadata::BreakpointResolution.PartiallyResolved or full_overloads.matched != DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY
    for function_index in 0..<DebuggerEDIRCapacity::EDIR_FUNCTION_CAPACITY:
        expected_entry: u64 = function_index.u64() * Test::FUNCTION_ENTRY_STRIDE
        return Test::RESULT_CAPACITY_RESOLUTION_FAILED if DebuggerBreakpointResolver::resolution_instruction_at(full_overloads, function_index) != expected_entry
    return 0
