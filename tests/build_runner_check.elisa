include "../src/build/runner.elisa"

@link_name("write")
extern build_runner_check_write(fd: i32, bytes: void&, length: usize) -> isize can[Blocking.IO]
@link_name("unlink")
extern build_runner_check_unlink(path: cstr) -> i32 can[Blocking.IO]
@link_name("access")
extern build_runner_check_access(path: cstr, mode: i32) -> i32 can[Blocking.IO]

const CHILD_ARGUMENT_COUNT: i64 = 8
const TEST_STANDARD_ARGUMENT_COUNT: usize = 7
const CHILD_EMIT_FLAG_INDEX: usize = 1
const CHILD_EMIT_MODE_INDEX: usize = 2
const CHILD_OPTIMIZATION_INDEX: usize = 3
const CHILD_DEBUG_FLAG_INDEX: usize = 4
const CHILD_OUTPUT_FLAG_INDEX: usize = 5
const CHILD_OUTPUT_PATH_INDEX: usize = 6
const CHILD_SOURCE_PATH_INDEX: usize = 7
const CHILD_NO_DEBUG_OUTPUT_FLAG_INDEX: usize = 4
const CHILD_NO_DEBUG_OUTPUT_PATH_INDEX: usize = 5
const CHILD_NO_DEBUG_SOURCE_PATH_INDEX: usize = 6
const PARENT_ARGUMENT_INDEX: usize = 0
const TEST_TOOLCHAIN_MAJOR: u32 = 1
const TEST_TOOLCHAIN_REVISION: u64 = 17
const TEST_RUNTIME_PATH_ID: u64 = 2
const TEST_RUNTIME_REVISION: u64 = TEST_TOOLCHAIN_REVISION
const TEST_SOURCE_PATH: cstr = "fixtures/source ;$(touch build/build-runner-shell-marker).elisa"
const TEST_OUTPUT_PATH: cstr = "build/output with spaces ;$(touch build/build-runner-shell-marker).edir"
const TEST_SHELL_MARKER_PATH: cstr = "build/build-runner-shell-marker"
const TEST_MISSING_COMPILER: cstr = "build/build-runner-missing-compiler"
const TEST_CHILD_SUCCESS_SOURCE: cstr = "fixtures/source ;$(touch build/build-runner-shell-marker).elisa"
const TEST_CHILD_FAILURE_SOURCE: cstr = "fixtures/compiler-rejects-source.elisa"
const TEST_CHILD_FLAG_EMIT: cstr = "-emit"
const TEST_CHILD_MODE_EDIR: cstr = "edir"
const TEST_CHILD_MODE_EXECUTABLE: cstr = "exe"
const TEST_CHILD_OPTIMIZATION: cstr = "-O0"
const TEST_CHILD_OPTIMIZATION_THREE: cstr = "-O3"
const TEST_CHILD_DEBUG_FLAG: cstr = "-g"
const TEST_CHILD_OUTPUT_FLAG: cstr = "-o"
const TEST_CHILD_SUCCESS_EXIT: i64 = 0
const TEST_CHILD_FAILURE_EXIT: i64 = 29
const TEST_CHILD_BAD_ARGUMENT: i64 = 30
const TEST_PARENT_BUILD_FAILURE: i64 = 31
const TEST_PARENT_COMMAND_FAILURE: i64 = 32
const TEST_PARENT_TOOLCHAIN_FAILURE: i64 = 33
const TEST_PARENT_SPAWN_FAILURE: i64 = 34
const TEST_PARENT_COMPILER_FAILURE: i64 = 35
const TEST_PARENT_OUTPUT_LIMIT_FAILURE: i64 = 36
const TEST_PARENT_SHELL_EXECUTED_FAILURE: i64 = 37
const TEST_PARENT_OUTPUT_TRUNCATED_FAILURE: i64 = 38
const TEST_OUTPUT_CAPACITY: usize = 128
const TEST_CAPTURE_CAPACITY: usize = 64
const TEST_SHORT_OUTPUT_CAPACITY: usize = 4
const TEST_OUTPUT_LIMIT_INCREMENT: usize = 1
const TEST_PROCESS_EXIT_SUCCESS: i32 = 0
const TEST_PROCESS_NO_SIGNAL: i32 = 0
const TEST_CHILD_STDOUT_FD: i32 = 1
const TEST_CHILD_RESULT_TEXT: cstr = "ARGV_VALID\n"
const TEST_CHILD_RESULT_LENGTH: usize = 11
const TEST_NO_FILE_ACCESS: i32 = -1
const TEST_FILE_ACCESS_MODE: i32 = 0
const NO_ARGUMENT_COUNT: i64 = 0

def build_runner_check_cstr_equal(actual: cstr, expected: cstr) -> bool:
    for index in 0..<TEST_OUTPUT_CAPACITY:
        actual_byte: u8 = actual[index].u8()
        expected_byte: u8 = expected[index].u8()
        return actual_byte == expected_byte if actual_byte == 0 or expected_byte == 0
        return false if actual_byte != expected_byte
    return false

def main(argc: i64, argv: mutable void&) -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    arguments: mutable cstr&& = argv.cast[mutable cstr&&]
    if argc == CHILD_ARGUMENT_COUNT:
        return TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[CHILD_EMIT_FLAG_INDEX].cast[cstr], TEST_CHILD_FLAG_EMIT)
        return TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[CHILD_EMIT_MODE_INDEX].cast[cstr], TEST_CHILD_MODE_EDIR)
        return TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[CHILD_OPTIMIZATION_INDEX].cast[cstr], TEST_CHILD_OPTIMIZATION)
        return TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[CHILD_DEBUG_FLAG_INDEX].cast[cstr], TEST_CHILD_DEBUG_FLAG)
        return TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[CHILD_OUTPUT_FLAG_INDEX].cast[cstr], TEST_CHILD_OUTPUT_FLAG)
        return TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[CHILD_OUTPUT_PATH_INDEX].cast[cstr], TEST_OUTPUT_PATH)
        failed_source: bool = build_runner_check_cstr_equal(arguments[CHILD_SOURCE_PATH_INDEX].cast[cstr], TEST_CHILD_FAILURE_SOURCE)
        return TEST_CHILD_BAD_ARGUMENT if not failed_source and not build_runner_check_cstr_equal(arguments[CHILD_SOURCE_PATH_INDEX].cast[cstr], TEST_CHILD_SUCCESS_SOURCE)
        return TEST_CHILD_FAILURE_EXIT if failed_source
        written: isize = build_runner_check_write(TEST_CHILD_STDOUT_FD, TEST_CHILD_RESULT_TEXT.cast[void&], TEST_CHILD_RESULT_LENGTH) can Blocking.IO, Unsafe.PointerCast
        return TEST_CHILD_BAD_ARGUMENT if written != TEST_CHILD_RESULT_LENGTH.isize()
        return TEST_CHILD_SUCCESS_EXIT

    return TEST_PARENT_COMMAND_FAILURE if argc <= NO_ARGUMENT_COUNT
    compiler_path: cstr = arguments[PARENT_ARGUMENT_INDEX].cast[cstr]
    toolchain: mutable DebuggerCompilerDiscovery::Toolchain = DebuggerCompilerDiscovery::toolchain_new()
    toolchain.compiler.present <- true
    toolchain.compiler.path_id <- DebuggerCompilerDiscovery::tool_path_identity(compiler_path)
    toolchain.compiler.revision <- TEST_TOOLCHAIN_REVISION
    toolchain.compiler.major <- TEST_TOOLCHAIN_MAJOR
    toolchain.runtime.present <- true
    toolchain.runtime.path_id <- TEST_RUNTIME_PATH_ID
    toolchain.runtime.revision <- TEST_RUNTIME_REVISION
    toolchain.runtime.major <- TEST_TOOLCHAIN_MAJOR
    toolchain.compatible <- true
    command: DebuggerBuildRunner::CompilerCommand = DebuggerBuildRunner::compiler_command_build(toolchain, compiler_path, TEST_SOURCE_PATH, TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true)
    return TEST_PARENT_COMMAND_FAILURE if not DebuggerErrors::error_is_ok(command.failure) or command.count != CHILD_ARGUMENT_COUNT.usize()
    return TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(command.arguments[CHILD_EMIT_FLAG_INDEX], TEST_CHILD_FLAG_EMIT) or not build_runner_check_cstr_equal(command.arguments[CHILD_EMIT_MODE_INDEX], TEST_CHILD_MODE_EDIR)
    return TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(command.arguments[CHILD_OPTIMIZATION_INDEX], TEST_CHILD_OPTIMIZATION) or not build_runner_check_cstr_equal(command.arguments[CHILD_DEBUG_FLAG_INDEX], TEST_CHILD_DEBUG_FLAG)
    return TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(command.arguments[CHILD_OUTPUT_PATH_INDEX], TEST_OUTPUT_PATH) or not build_runner_check_cstr_equal(command.arguments[CHILD_SOURCE_PATH_INDEX], TEST_SOURCE_PATH)
    native_command: DebuggerBuildRunner::CompilerCommand = DebuggerBuildRunner::compiler_command_build(toolchain, compiler_path, TEST_SOURCE_PATH, TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.NativeExecutable, DebuggerBuildRunner::Optimization.O3, false)
    return TEST_PARENT_COMMAND_FAILURE if not DebuggerErrors::error_is_ok(native_command.failure) or native_command.count != TEST_STANDARD_ARGUMENT_COUNT
    return TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(native_command.arguments[CHILD_EMIT_MODE_INDEX], TEST_CHILD_MODE_EXECUTABLE) or not build_runner_check_cstr_equal(native_command.arguments[CHILD_OPTIMIZATION_INDEX], TEST_CHILD_OPTIMIZATION_THREE)
    return TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(native_command.arguments[CHILD_NO_DEBUG_OUTPUT_FLAG_INDEX], TEST_CHILD_OUTPUT_FLAG) or not build_runner_check_cstr_equal(native_command.arguments[CHILD_NO_DEBUG_OUTPUT_PATH_INDEX], TEST_OUTPUT_PATH) or not build_runner_check_cstr_equal(native_command.arguments[CHILD_NO_DEBUG_SOURCE_PATH_INDEX], TEST_SOURCE_PATH)

    rejected_path: mutable DebuggerCompilerDiscovery::Toolchain = toolchain
    rejected_path.compiler.path_id <- TEST_RUNTIME_PATH_ID
    invalid_command: DebuggerBuildRunner::CompilerCommand = DebuggerBuildRunner::compiler_command_build(rejected_path, compiler_path, TEST_SOURCE_PATH, TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true)
    return TEST_PARENT_TOOLCHAIN_FAILURE if DebuggerErrors::error_is_ok(invalid_command.failure)

    _ = build_runner_check_unlink(TEST_OUTPUT_PATH) can Blocking.IO
    _ = build_runner_check_unlink(TEST_SHELL_MARKER_PATH) can Blocking.IO
    output: mutable u8[TEST_OUTPUT_CAPACITY] = zeroed
    built: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(toolchain, compiler_path, TEST_SOURCE_PATH, TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, output[0], TEST_CAPTURE_CAPACITY) can Blocking.IO, Unsafe.PointerCast
    marker_status: i32 = build_runner_check_access(TEST_SHELL_MARKER_PATH, TEST_FILE_ACCESS_MODE) can Blocking.IO
    return TEST_PARENT_BUILD_FAILURE if built.outcome != DebuggerBuildRunner::BuildOutcome.Complete or built.process.failure != DebuggerHostProcess::SpawnFailure.None or not built.process.child_spawned or not built.process.child_reaped or built.process.exit_code != TEST_PROCESS_EXIT_SUCCESS or built.process.terminated_by_signal or built.process.signal_number != TEST_PROCESS_NO_SIGNAL
    return TEST_PARENT_BUILD_FAILURE if built.process.output_length != TEST_CHILD_RESULT_LENGTH
    for index in 0..<TEST_CHILD_RESULT_LENGTH:
        return TEST_PARENT_BUILD_FAILURE if output[index] != TEST_CHILD_RESULT_TEXT[index].u8()
    return TEST_PARENT_SHELL_EXECUTED_FAILURE if marker_status != TEST_NO_FILE_ACCESS

    short_output: mutable u8[TEST_OUTPUT_CAPACITY] = zeroed
    truncated_build: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(toolchain, compiler_path, TEST_SOURCE_PATH, TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, short_output[0], TEST_SHORT_OUTPUT_CAPACITY) can Blocking.IO, Unsafe.PointerCast
    return TEST_PARENT_OUTPUT_TRUNCATED_FAILURE if truncated_build.outcome != DebuggerBuildRunner::BuildOutcome.OutputTruncated or not truncated_build.process.output_truncated or not truncated_build.process.child_reaped

    failure_output: mutable u8[TEST_OUTPUT_CAPACITY] = zeroed
    failed_build: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(toolchain, compiler_path, TEST_CHILD_FAILURE_SOURCE, TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, failure_output[0], TEST_CAPTURE_CAPACITY) can Blocking.IO, Unsafe.PointerCast
    return TEST_PARENT_COMPILER_FAILURE if failed_build.outcome != DebuggerBuildRunner::BuildOutcome.CompilerFailed or failed_build.process.exit_code != TEST_CHILD_FAILURE_EXIT.i32() or not failed_build.process.child_reaped

    missing_toolchain: mutable DebuggerCompilerDiscovery::Toolchain = toolchain
    missing_toolchain.compiler.path_id <- DebuggerCompilerDiscovery::tool_path_identity(TEST_MISSING_COMPILER)
    missing_output: mutable u8[TEST_OUTPUT_CAPACITY] = zeroed
    spawn_failure: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(missing_toolchain, TEST_MISSING_COMPILER, TEST_SOURCE_PATH, TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, missing_output[0], TEST_CAPTURE_CAPACITY) can Blocking.IO, Unsafe.PointerCast
    return TEST_PARENT_SPAWN_FAILURE if spawn_failure.outcome != DebuggerBuildRunner::BuildOutcome.SpawnFailed or spawn_failure.process.child_spawned or spawn_failure.process.child_reaped

    oversized_output: mutable u8[TEST_OUTPUT_CAPACITY] = zeroed
    output_limit: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(toolchain, compiler_path, TEST_SOURCE_PATH, TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, oversized_output[0], DebuggerHostProcess::spawn_output_capacity() + TEST_OUTPUT_LIMIT_INCREMENT) can Blocking.IO, Unsafe.PointerCast
    return TEST_PARENT_OUTPUT_LIMIT_FAILURE if output_limit.outcome != DebuggerBuildRunner::BuildOutcome.InvalidRequest or DebuggerErrors::error_is_ok(output_limit.failure)

    _ = build_runner_check_unlink(TEST_OUTPUT_PATH) can Blocking.IO
    _ = build_runner_check_unlink(TEST_SHELL_MARKER_PATH) can Blocking.IO
    return 0
