include "../src/build/runner.elisa"

@link_name("write")
extern build_runner_check_write(fd: i32, bytes: void&, length: usize) -> isize can[Blocking.IO]
@link_name("unlink")
extern build_runner_check_unlink(path: cstr) -> i32 can[Blocking.IO]
@link_name("access")
extern build_runner_check_access(path: cstr, mode: i32) -> i32 can[Blocking.IO]

const module Test:
    CHILD_ARGUMENT_COUNT: i64 = 8
    TEST_STANDARD_ARGUMENT_COUNT: usize = 7
    CHILD_EMIT_FLAG_INDEX: usize = 1
    CHILD_EMIT_MODE_INDEX: usize = 2
    CHILD_OPTIMIZATION_INDEX: usize = 3
    CHILD_DEBUG_FLAG_INDEX: usize = 4
    CHILD_OUTPUT_FLAG_INDEX: usize = 5
    CHILD_OUTPUT_PATH_INDEX: usize = 6
    CHILD_SOURCE_PATH_INDEX: usize = 7
    CHILD_NO_DEBUG_OUTPUT_FLAG_INDEX: usize = 4
    CHILD_NO_DEBUG_OUTPUT_PATH_INDEX: usize = 5
    CHILD_NO_DEBUG_SOURCE_PATH_INDEX: usize = 6
    PARENT_ARGUMENT_INDEX: usize = 0
    TEST_TOOLCHAIN_MAJOR: u32 = 1
    TEST_TOOLCHAIN_REVISION: u64 = 17
    TEST_RUNTIME_PATH_ID: u64 = 2
    TEST_RUNTIME_REVISION: u64 = Test::TEST_TOOLCHAIN_REVISION
    TEST_SOURCE_PATH: cstr = "fixtures/source ;$(touch build/build-runner-shell-marker).elisa"
    TEST_OUTPUT_PATH: cstr = "build/output with spaces ;$(touch build/build-runner-shell-marker).edir"
    TEST_SHELL_MARKER_PATH: cstr = "build/build-runner-shell-marker"
    TEST_MISSING_COMPILER: cstr = "build/build-runner-missing-compiler"
    TEST_CHILD_SUCCESS_SOURCE: cstr = "fixtures/source ;$(touch build/build-runner-shell-marker).elisa"
    TEST_CHILD_FAILURE_SOURCE: cstr = "fixtures/compiler-rejects-source.elisa"
    TEST_CHILD_FLAG_EMIT: cstr = "-emit"
    TEST_CHILD_MODE_EDIR: cstr = "edir"
    TEST_CHILD_MODE_EXECUTABLE: cstr = "exe"
    TEST_CHILD_OPTIMIZATION: cstr = "-O0"
    TEST_CHILD_OPTIMIZATION_THREE: cstr = "-O3"
    TEST_CHILD_DEBUG_FLAG: cstr = "-g"
    TEST_CHILD_OUTPUT_FLAG: cstr = "-o"
    TEST_CHILD_SUCCESS_EXIT: i64 = 0
    TEST_CHILD_FAILURE_EXIT: i64 = 29
    TEST_CHILD_BAD_ARGUMENT: i64 = 30
    TEST_PARENT_BUILD_FAILURE: i64 = 31
    TEST_PARENT_COMMAND_FAILURE: i64 = 32
    TEST_PARENT_TOOLCHAIN_FAILURE: i64 = 33
    TEST_PARENT_SPAWN_FAILURE: i64 = 34
    TEST_PARENT_COMPILER_FAILURE: i64 = 35
    TEST_PARENT_OUTPUT_LIMIT_FAILURE: i64 = 36
    TEST_PARENT_SHELL_EXECUTED_FAILURE: i64 = 37
    TEST_PARENT_OUTPUT_TRUNCATED_FAILURE: i64 = 38
    TEST_OUTPUT_CAPACITY: usize = 128
    TEST_CAPTURE_CAPACITY: usize = 64
    TEST_SHORT_OUTPUT_CAPACITY: usize = 4
    TEST_OUTPUT_LIMIT_INCREMENT: usize = 1
    TEST_PROCESS_EXIT_SUCCESS: i32 = 0
    TEST_PROCESS_NO_SIGNAL: i32 = 0
    TEST_CHILD_STDOUT_FD: i32 = 1
    TEST_CHILD_RESULT_TEXT: cstr = "ARGV_VALID\n"
    TEST_CHILD_RESULT_LENGTH: usize = 11
    TEST_NO_FILE_ACCESS: i32 = -1
    TEST_FILE_ACCESS_MODE: i32 = 0
    NO_ARGUMENT_COUNT: i64 = 0


def build_runner_check_cstr_equal(actual: cstr, expected: cstr) -> bool:
    for index in 0..<Test::TEST_OUTPUT_CAPACITY:
        actual_byte: u8 = actual[index].u8()
        expected_byte: u8 = expected[index].u8()
        return actual_byte == expected_byte if actual_byte == 0 or expected_byte == 0
        return false if actual_byte != expected_byte
    return false

def main(argc: i64, argv: mutable void&) -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    arguments: mutable cstr&& = argv.cast[mutable cstr&&]
    if argc == Test::CHILD_ARGUMENT_COUNT:
        return Test::TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[Test::CHILD_EMIT_FLAG_INDEX].cast[cstr], Test::TEST_CHILD_FLAG_EMIT)
        return Test::TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[Test::CHILD_EMIT_MODE_INDEX].cast[cstr], Test::TEST_CHILD_MODE_EDIR)
        return Test::TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[Test::CHILD_OPTIMIZATION_INDEX].cast[cstr], Test::TEST_CHILD_OPTIMIZATION)
        return Test::TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[Test::CHILD_DEBUG_FLAG_INDEX].cast[cstr], Test::TEST_CHILD_DEBUG_FLAG)
        return Test::TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[Test::CHILD_OUTPUT_FLAG_INDEX].cast[cstr], Test::TEST_CHILD_OUTPUT_FLAG)
        return Test::TEST_CHILD_BAD_ARGUMENT if not build_runner_check_cstr_equal(arguments[Test::CHILD_OUTPUT_PATH_INDEX].cast[cstr], Test::TEST_OUTPUT_PATH)
        failed_source: bool = build_runner_check_cstr_equal(arguments[Test::CHILD_SOURCE_PATH_INDEX].cast[cstr], Test::TEST_CHILD_FAILURE_SOURCE)
        return Test::TEST_CHILD_BAD_ARGUMENT if not failed_source and not build_runner_check_cstr_equal(arguments[Test::CHILD_SOURCE_PATH_INDEX].cast[cstr], Test::TEST_CHILD_SUCCESS_SOURCE)
        return Test::TEST_CHILD_FAILURE_EXIT if failed_source
        written: isize = build_runner_check_write(Test::TEST_CHILD_STDOUT_FD, Test::TEST_CHILD_RESULT_TEXT.cast[void&], Test::TEST_CHILD_RESULT_LENGTH) can Blocking.IO, Unsafe.PointerCast
        return Test::TEST_CHILD_BAD_ARGUMENT if written != Test::TEST_CHILD_RESULT_LENGTH.isize()
        return Test::TEST_CHILD_SUCCESS_EXIT

    return Test::TEST_PARENT_COMMAND_FAILURE if argc <= Test::NO_ARGUMENT_COUNT
    compiler_path: cstr = arguments[Test::PARENT_ARGUMENT_INDEX].cast[cstr]
    toolchain: mutable DebuggerCompilerDiscovery::Toolchain = DebuggerCompilerDiscovery::toolchain_new()
    toolchain.compiler.present <- true
    toolchain.compiler.path_id <- DebuggerCompilerDiscovery::tool_path_identity(compiler_path)
    toolchain.compiler.revision <- Test::TEST_TOOLCHAIN_REVISION
    toolchain.compiler.major <- Test::TEST_TOOLCHAIN_MAJOR
    toolchain.runtime.present <- true
    toolchain.runtime.path_id <- Test::TEST_RUNTIME_PATH_ID
    toolchain.runtime.revision <- Test::TEST_RUNTIME_REVISION
    toolchain.runtime.major <- Test::TEST_TOOLCHAIN_MAJOR
    toolchain.compatible <- true
    command: DebuggerBuildRunner::CompilerCommand = DebuggerBuildRunner::compiler_command_build(toolchain, compiler_path, Test::TEST_SOURCE_PATH, Test::TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true)
    return Test::TEST_PARENT_COMMAND_FAILURE if not DebuggerErrors::error_is_ok(command.failure) or command.count != Test::CHILD_ARGUMENT_COUNT.usize()
    return Test::TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(command.arguments[Test::CHILD_EMIT_FLAG_INDEX], Test::TEST_CHILD_FLAG_EMIT) or not build_runner_check_cstr_equal(command.arguments[Test::CHILD_EMIT_MODE_INDEX], Test::TEST_CHILD_MODE_EDIR)
    return Test::TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(command.arguments[Test::CHILD_OPTIMIZATION_INDEX], Test::TEST_CHILD_OPTIMIZATION) or not build_runner_check_cstr_equal(command.arguments[Test::CHILD_DEBUG_FLAG_INDEX], Test::TEST_CHILD_DEBUG_FLAG)
    return Test::TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(command.arguments[Test::CHILD_OUTPUT_PATH_INDEX], Test::TEST_OUTPUT_PATH) or not build_runner_check_cstr_equal(command.arguments[Test::CHILD_SOURCE_PATH_INDEX], Test::TEST_SOURCE_PATH)
    native_command: DebuggerBuildRunner::CompilerCommand = DebuggerBuildRunner::compiler_command_build(toolchain, compiler_path, Test::TEST_SOURCE_PATH, Test::TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.NativeExecutable, DebuggerBuildRunner::Optimization.O3, false)
    return Test::TEST_PARENT_COMMAND_FAILURE if not DebuggerErrors::error_is_ok(native_command.failure) or native_command.count != Test::TEST_STANDARD_ARGUMENT_COUNT
    return Test::TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(native_command.arguments[Test::CHILD_EMIT_MODE_INDEX], Test::TEST_CHILD_MODE_EXECUTABLE) or not build_runner_check_cstr_equal(native_command.arguments[Test::CHILD_OPTIMIZATION_INDEX], Test::TEST_CHILD_OPTIMIZATION_THREE)
    return Test::TEST_PARENT_COMMAND_FAILURE if not build_runner_check_cstr_equal(native_command.arguments[Test::CHILD_NO_DEBUG_OUTPUT_FLAG_INDEX], Test::TEST_CHILD_OUTPUT_FLAG) or not build_runner_check_cstr_equal(native_command.arguments[Test::CHILD_NO_DEBUG_OUTPUT_PATH_INDEX], Test::TEST_OUTPUT_PATH) or not build_runner_check_cstr_equal(native_command.arguments[Test::CHILD_NO_DEBUG_SOURCE_PATH_INDEX], Test::TEST_SOURCE_PATH)

    rejected_path: mutable DebuggerCompilerDiscovery::Toolchain = toolchain
    rejected_path.compiler.path_id <- Test::TEST_RUNTIME_PATH_ID
    invalid_command: DebuggerBuildRunner::CompilerCommand = DebuggerBuildRunner::compiler_command_build(rejected_path, compiler_path, Test::TEST_SOURCE_PATH, Test::TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true)
    return Test::TEST_PARENT_TOOLCHAIN_FAILURE if DebuggerErrors::error_is_ok(invalid_command.failure)

    _ = build_runner_check_unlink(Test::TEST_OUTPUT_PATH) can Blocking.IO
    _ = build_runner_check_unlink(Test::TEST_SHELL_MARKER_PATH) can Blocking.IO
    output: mutable u8[Test::TEST_OUTPUT_CAPACITY] = zeroed
    built: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(toolchain, compiler_path, Test::TEST_SOURCE_PATH, Test::TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, output[0], Test::TEST_CAPTURE_CAPACITY) can Blocking.IO, Unsafe.PointerCast
    marker_status: i32 = build_runner_check_access(Test::TEST_SHELL_MARKER_PATH, Test::TEST_FILE_ACCESS_MODE) can Blocking.IO
    return Test::TEST_PARENT_BUILD_FAILURE if built.outcome != DebuggerBuildRunner::BuildOutcome.Complete or built.process.failure != DebuggerHostProcess::SpawnFailure.None or not built.process.child_spawned or not built.process.child_reaped or built.process.exit_code != Test::TEST_PROCESS_EXIT_SUCCESS or built.process.terminated_by_signal or built.process.signal_number != Test::TEST_PROCESS_NO_SIGNAL
    return Test::TEST_PARENT_BUILD_FAILURE if built.process.output_length != Test::TEST_CHILD_RESULT_LENGTH
    for index in 0..<Test::TEST_CHILD_RESULT_LENGTH:
        return Test::TEST_PARENT_BUILD_FAILURE if output[index] != Test::TEST_CHILD_RESULT_TEXT[index].u8()
    return Test::TEST_PARENT_SHELL_EXECUTED_FAILURE if marker_status != Test::TEST_NO_FILE_ACCESS

    short_output: mutable u8[Test::TEST_OUTPUT_CAPACITY] = zeroed
    truncated_build: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(toolchain, compiler_path, Test::TEST_SOURCE_PATH, Test::TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, short_output[0], Test::TEST_SHORT_OUTPUT_CAPACITY) can Blocking.IO, Unsafe.PointerCast
    return Test::TEST_PARENT_OUTPUT_TRUNCATED_FAILURE if truncated_build.outcome != DebuggerBuildRunner::BuildOutcome.OutputTruncated or not truncated_build.process.output_truncated or not truncated_build.process.child_reaped

    failure_output: mutable u8[Test::TEST_OUTPUT_CAPACITY] = zeroed
    failed_build: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(toolchain, compiler_path, Test::TEST_CHILD_FAILURE_SOURCE, Test::TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, failure_output[0], Test::TEST_CAPTURE_CAPACITY) can Blocking.IO, Unsafe.PointerCast
    return Test::TEST_PARENT_COMPILER_FAILURE if failed_build.outcome != DebuggerBuildRunner::BuildOutcome.CompilerFailed or failed_build.process.exit_code != Test::TEST_CHILD_FAILURE_EXIT.i32() or not failed_build.process.child_reaped

    missing_toolchain: mutable DebuggerCompilerDiscovery::Toolchain = toolchain
    missing_toolchain.compiler.path_id <- DebuggerCompilerDiscovery::tool_path_identity(Test::TEST_MISSING_COMPILER)
    missing_output: mutable u8[Test::TEST_OUTPUT_CAPACITY] = zeroed
    spawn_failure: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(missing_toolchain, Test::TEST_MISSING_COMPILER, Test::TEST_SOURCE_PATH, Test::TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, missing_output[0], Test::TEST_CAPTURE_CAPACITY) can Blocking.IO, Unsafe.PointerCast
    return Test::TEST_PARENT_SPAWN_FAILURE if spawn_failure.outcome != DebuggerBuildRunner::BuildOutcome.SpawnFailed or spawn_failure.process.child_spawned or spawn_failure.process.child_reaped

    oversized_output: mutable u8[Test::TEST_OUTPUT_CAPACITY] = zeroed
    output_limit: DebuggerBuildRunner::BuildResult = DebuggerBuildRunner::compiler_build(toolchain, compiler_path, Test::TEST_SOURCE_PATH, Test::TEST_OUTPUT_PATH, DebuggerBuildRunner::ArtifactMode.ManagedEDIR, DebuggerBuildRunner::Optimization.O0, true, oversized_output[0], DebuggerHostProcess::spawn_output_capacity() + Test::TEST_OUTPUT_LIMIT_INCREMENT) can Blocking.IO, Unsafe.PointerCast
    return Test::TEST_PARENT_OUTPUT_LIMIT_FAILURE if output_limit.outcome != DebuggerBuildRunner::BuildOutcome.InvalidRequest or DebuggerErrors::error_is_ok(output_limit.failure)

    _ = build_runner_check_unlink(Test::TEST_OUTPUT_PATH) can Blocking.IO
    _ = build_runner_check_unlink(Test::TEST_SHELL_MARKER_PATH) can Blocking.IO
    return 0
