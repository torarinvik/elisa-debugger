include "../src/core/capabilities.elisa"

def main() -> i64:
    managed: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    return 1 if not DebuggerCapabilities::capabilities_is_valid(managed) or not DebuggerCapabilities::capability_supports_history(managed, DebuggerCapabilities::HistoryKind.Exact) or not managed.trace_verification or not managed.trace_export or not managed.historical_queries or not managed.schedule_exploration or not managed.memory_read
    native: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::native_attach_capabilities()
    return 2 if not DebuggerCapabilities::capabilities_is_valid(native) or native.engine != DebuggerCapabilities::EngineKind.AttachedNative or not native.native_attach or native.trace_export or native.historical_queries
    invalid: mutable DebuggerCapabilities::CapabilitySet = managed
    invalid.reverse_execution <- true
    invalid.history <- DebuggerCapabilities::HistoryKind.None
    return 3 if DebuggerCapabilities::capabilities_is_valid(invalid)
    postmortem: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::postmortem_capabilities()
    return 4 if postmortem.reverse_execution or postmortem.remote_transport or not postmortem.postmortem_inspection or not postmortem.memory_read
    return 0
