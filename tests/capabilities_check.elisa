include "../src/core/capabilities.elisa"
include "../src/core/session.elisa"
include "../src/protocol/dap.elisa"

def main() -> i64:
    managed: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    return 1 if not DebuggerCapabilities::capabilities_is_valid(managed) or not DebuggerCapabilities::capability_supports_history(managed, DebuggerCapabilities::HistoryKind.Exact) or not managed.trace_verification or not managed.trace_export or not managed.historical_queries or not managed.schedule_exploration or not managed.memory_read
    native: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::native_attach_capabilities()
    return 2 if not DebuggerCapabilities::capabilities_is_valid(native) or native.engine != DebuggerCapabilities::EngineKind.AttachedNative or not native.native_attach or native.trace_export or native.historical_queries
    native_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), zeroed, native)
    dap_native: DebuggerDAP::AdapterCapabilities = DebuggerDAP::capabilities_for(native_session)
    return 5 if dap_native.supports_conditional_breakpoints or dap_native.supports_hit_conditional_breakpoints or dap_native.supports_terminate_request
    dap_managed: DebuggerDAP::AdapterCapabilities = DebuggerDAP::capabilities_for(DebuggerSession::new_session(DebuggerIdentity::debug_id(3), zeroed, managed))
    return 6 if dap_managed.supports_function_breakpoints or dap_managed.supports_conditional_breakpoints or dap_managed.supports_hit_conditional_breakpoints or dap_managed.supports_data_breakpoints or dap_managed.supports_evaluate_for_hovers
    invalid: mutable DebuggerCapabilities::CapabilitySet = managed
    invalid.reverse_execution <- true
    invalid.history <- DebuggerCapabilities::HistoryKind.None
    return 3 if DebuggerCapabilities::capabilities_is_valid(invalid)
    postmortem: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::postmortem_capabilities()
    return 4 if postmortem.reverse_execution or postmortem.remote_transport or not postmortem.postmortem_inspection or not postmortem.memory_read or DebuggerDAP::capabilities_for(DebuggerSession::new_session(DebuggerIdentity::debug_id(2), zeroed, postmortem)).supports_terminate_request
    return 0
