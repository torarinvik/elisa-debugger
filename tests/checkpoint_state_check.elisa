include "../src/replay/checkpoint.elisa"

const module Test:
    CHECKPOINT_ID: u64 = 1
    FIRST_SLOT: usize = 0
    FIRST_STACK_SLOT: usize = 0
    EMPTY_STACK_POINTER: usize = 0
    EMPTY_RETURN_PC: u64 = 0
    ACTIVE_STACK_POINTER: usize = 1
    LAST_GENERIC_RETURN_PC: u64 = 255
    INVALID_GENERIC_RETURN_PC: u64 = 256
    LAST_MEMORY_SLOT: usize = 63
    VALID_RETURN_PC_RESULT: i64 = 8
    INVALID_RETURN_PC_RESULT: i64 = 9


def main() -> i64:
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    snapshot: mutable DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(machine, DebuggerIdentity::debug_id(Test::CHECKPOINT_ID), 0, 0)
    snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(snapshot)
    return 6 if not DebuggerCheckpoint::snapshot_matches_machine(snapshot, machine)
    snapshot.state_hash <- snapshot.state_hash + 1
    return 7 if DebuggerCheckpoint::snapshot_matches_machine(snapshot, machine)
    snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(snapshot)
    return 1 if not DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.return_stack_pointer <- Test::ACTIVE_STACK_POINTER
    snapshot.return_stack[Test::FIRST_STACK_SLOT] <- Test::LAST_GENERIC_RETURN_PC
    return Test::VALID_RETURN_PC_RESULT if not DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.return_stack[Test::FIRST_STACK_SLOT] <- Test::INVALID_GENERIC_RETURN_PC
    return Test::INVALID_RETURN_PC_RESULT if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.return_stack_pointer <- Test::EMPTY_STACK_POINTER
    snapshot.return_stack[Test::FIRST_STACK_SLOT] <- Test::EMPTY_RETURN_PC
    snapshot.locals[Test::FIRST_SLOT] <- 1
    return 2 if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.locals[Test::FIRST_SLOT] <- 0
    snapshot.frame_locals[Test::FIRST_SLOT] <- 1
    return 3 if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.frame_locals[Test::FIRST_SLOT] <- 0
    snapshot.memory[Test::FIRST_SLOT] <- 1
    return 4 if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.memory[Test::FIRST_SLOT] <- 0
    snapshot.memory_initialized[Test::LAST_MEMORY_SLOT] <- true
    return 5 if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    return 0
