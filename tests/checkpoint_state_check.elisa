include "../src/replay/checkpoint.elisa"

const CHECKPOINT_ID: u64 = 1
const FIRST_SLOT: usize = 0
const LAST_MEMORY_SLOT: usize = 63

def main() -> i64:
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    snapshot: mutable DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(machine, DebuggerIdentity::debug_id(CHECKPOINT_ID), 0, 0)
    snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(snapshot)
    return 6 if not DebuggerCheckpoint::snapshot_matches_machine(snapshot, machine)
    snapshot.state_hash <- snapshot.state_hash + 1
    return 7 if DebuggerCheckpoint::snapshot_matches_machine(snapshot, machine)
    snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(snapshot)
    return 1 if not DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.locals[FIRST_SLOT] <- 1
    return 2 if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.locals[FIRST_SLOT] <- 0
    snapshot.frame_locals[FIRST_SLOT] <- 1
    return 3 if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.frame_locals[FIRST_SLOT] <- 0
    snapshot.memory[FIRST_SLOT] <- 1
    return 4 if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    snapshot.memory[FIRST_SLOT] <- 0
    snapshot.memory_initialized[LAST_MEMORY_SLOT] <- true
    return 5 if DebuggerCheckpoint::snapshot_shape_is_valid(snapshot)
    return 0
