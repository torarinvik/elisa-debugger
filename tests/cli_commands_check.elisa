include "../src/cli/commands.elisa"
include "../src/cli/runner.elisa"
include "../src/core/capabilities.elisa"
include "../src/core/identity.elisa"
include "../src/core/session.elisa"

const EXPECTED_GENERATION: u64 = 4
const STALE_GENERATION_DETAIL: u32 = 1
const CLI_RUNNER_SEEK_RESULT: i64 = 4
const CLI_COLLISION_REJECTED_RESULT: i64 = 5
const CLI_COLLISION_MUTATION_RESULT: i64 = 6
const CLI_ALIAS_RESULT: i64 = 7
const EXPECTED_SEEK_EVENT: u64 = 1
const COLLIDING_CONTINUE_LENGTH: usize = 8
const NEXT_COMMAND_LENGTH: usize = 4
const STEP_COMMAND_LENGTH: usize = 4
const CLOSE_COMMAND_LENGTH: usize = 5
const COLLIDING_CONTINUE_TOKEN: u8[COLLIDING_CONTINUE_LENGTH] = [100, 80, 110, 116, 105, 110, 117, 101]
const NEXT_COMMAND_TOKEN: u8[NEXT_COMMAND_LENGTH] = [110, 101, 120, 116]
const STEP_COMMAND_TOKEN: u8[STEP_COMMAND_LENGTH] = [115, 116, 101, 112]
const CLOSE_COMMAND_TOKEN: u8[CLOSE_COMMAND_LENGTH] = [99, 108, 111, 115, 101]

def main() -> i64:
    run_request: DebuggerCLI::CommandRequest = DebuggerCLI::CommandRequest{command: DebuggerCLI::Command.Run, argument: 0, expected_generation: EXPECTED_GENERATION}
    return 1 if not DebuggerCLI::command_is_mutating(run_request.command)
    return 2 if not DebuggerErrors::error_is_ok(DebuggerCLI::command_validate(run_request, EXPECTED_GENERATION))
    stale_request: DebuggerCLI::CommandRequest = DebuggerCLI::CommandRequest{command: DebuggerCLI::Command.Step, argument: 0, expected_generation: EXPECTED_GENERATION + 1}
    stale: DebuggerErrors::DebuggerError = DebuggerCLI::command_validate(stale_request, EXPECTED_GENERATION)
    return 3 if stale.code != DebuggerErrors::ErrorCode.StaleGeneration or stale.detail != STALE_GENERATION_DETAIL
    next_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(NEXT_COMMAND_TOKEN[0], NEXT_COMMAND_LENGTH)
    step_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(STEP_COMMAND_TOKEN[0], STEP_COMMAND_LENGTH)
    close_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(CLOSE_COMMAND_TOKEN[0], CLOSE_COMMAND_LENGTH)
    return CLI_ALIAS_RESULT if not next_command.valid or next_command.command != DebuggerCLI::Command.Step or not step_command.valid or step_command.command != DebuggerCLI::Command.Step or not close_command.valid or close_command.command != DebuggerCLI::Command.Quit
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(5), build, DebuggerCapabilities::managed_capabilities())
    session.state <- DebuggerSession::SessionState.Stopped
    session.retained_last <- EXPECTED_SEEK_EVENT
    runner: DebuggerCLIRunner::Runner = DebuggerCLIRunner::runner_new(session, DebuggerCLIRunner::OutputMode.Quiet)
    collision_result: DebuggerCLIRunner::Runner = DebuggerCLIRunner::runner_dispatch_line(runner, COLLIDING_CONTINUE_TOKEN[0], COLLIDING_CONTINUE_LENGTH, 7, 0)
    return CLI_COLLISION_REJECTED_RESULT if DebuggerErrors::error_is_ok(collision_result.last_status) or collision_result.last_status.code != DebuggerErrors::ErrorCode.InvalidArgument
    return CLI_COLLISION_MUTATION_RESULT if collision_result.session.state != runner.session.state or collision_result.session.position.event != runner.session.position.event or collision_result.session.stop_generation != runner.session.stop_generation
    seek_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Seek, id: 6, has_id: true, expected_generation: 0, target_event: EXPECTED_SEEK_EVENT, valid: true}
    seek_result: DebuggerCLIRunner::Runner = DebuggerCLIRunner::runner_dispatch(runner, seek_request, 0)
    return CLI_RUNNER_SEEK_RESULT if not DebuggerErrors::error_is_ok(seek_result.last_status) or seek_result.session.position.event != EXPECTED_SEEK_EVENT or seek_result.session.stop_generation != 1
    return 0
