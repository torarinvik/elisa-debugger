include "../src/cli/commands.elisa"
include "../src/cli/runner.elisa"
include "../src/core/capabilities.elisa"
include "../src/core/identity.elisa"
include "../src/core/session.elisa"

const module Test:
    EXPECTED_GENERATION: u64 = 4
    CLI_ARGUMENT_REQUEST_ID: u64 = 8
    STALE_GENERATION_DETAIL: u32 = 1
    CLI_RUNNER_SEEK_RESULT: i64 = 4
    CLI_COLLISION_REJECTED_RESULT: i64 = 5
    CLI_COLLISION_MUTATION_RESULT: i64 = 6
    CLI_ALIAS_RESULT: i64 = 7
    CLI_ARGUMENT_REJECTED_RESULT: i64 = 8
    CLI_ARGUMENT_MUTATION_RESULT: i64 = 9
    EXPECTED_SEEK_EVENT: u64 = 1
    COLLIDING_CONTINUE_LENGTH: usize = 8
    NEXT_COMMAND_LENGTH: usize = 4
    STEP_COMMAND_LENGTH: usize = 4
    CLOSE_COMMAND_LENGTH: usize = 5
    LOCALS_COMMAND_LENGTH: usize = 6
    INSPECT_COMMAND_LENGTH: usize = 7
    TRACE_VERIFY_COMMAND_LENGTH: usize = 11
    COMPARE_COMMAND_LENGTH: usize = 7
    CHECKPOINT_COMMAND_LENGTH: usize = 10
    TASKS_COMMAND_LENGTH: usize = 5
    CONTINUE_ARGUMENT_LENGTH: usize = 10

const module CliReverseCommandTest:
    REVERSE_STEP_OVER_NAME: cstr = "reverseStepOver"
    REVERSE_STEP_OUT_NAME: cstr = "reverseStepOut"
    REVERSE_STEP_OVER_LENGTH: usize = 15
    REVERSE_STEP_OUT_LENGTH: usize = 14

const module CliTraceExportCommandTest:
    SAVE_TRACE: cstr = "saveTrace build/managed trace.elisat"
    SAVE_TRACE_NAME: cstr = "saveTrace"
    EXPECTED_PATH: cstr = "build/managed trace.elisat"
    FIRST_BYTE_INDEX: usize = 0
    NUL: u8 = 0
    INCREMENT: usize = 1

def cstr_length(value: cstr) -> usize:
    length: mutable usize = CliTraceExportCommandTest::FIRST_BYTE_INDEX
    while value[length].u8() != CliTraceExportCommandTest::NUL:
        length <- length + CliTraceExportCommandTest::INCREMENT
    return length

def save_trace_command_is_exact() -> bool:
    line_length: usize = cstr_length(CliTraceExportCommandTest::SAVE_TRACE)
    command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(CliTraceExportCommandTest::SAVE_TRACE.cast[u8&], line_length, Test::EXPECTED_GENERATION)
    expected_path_length: usize = cstr_length(CliTraceExportCommandTest::EXPECTED_PATH)
    return false if not command.valid or command.command != DebuggerCLI::Command.SaveTrace or not command.text_argument_present or command.text_argument_length != expected_path_length
    for index in CliTraceExportCommandTest::FIRST_BYTE_INDEX..<expected_path_length:
        return false if command.text_argument[index] != CliTraceExportCommandTest::EXPECTED_PATH[index].u8()
    missing_path_length: usize = cstr_length(CliTraceExportCommandTest::SAVE_TRACE_NAME)
    missing_path: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(CliTraceExportCommandTest::SAVE_TRACE_NAME.cast[u8&], missing_path_length, Test::EXPECTED_GENERATION)
    return false if missing_path.valid or missing_path.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    return DebuggerCLI::command_is_mutating(command.command)


def command_mappings_are_exact() -> bool:
    fixture_checkpoint_command_token: mutable u8[Test::CHECKPOINT_COMMAND_LENGTH] = [99, 104, 101, 99, 107, 112, 111, 105, 110, 116]
    fixture_close_command_token: mutable u8[Test::CLOSE_COMMAND_LENGTH] = [99, 108, 111, 115, 101]
    fixture_colliding_continue_token: mutable u8[Test::COLLIDING_CONTINUE_LENGTH] = [100, 80, 110, 116, 105, 110, 117, 101]
    fixture_compare_command_token: mutable u8[Test::COMPARE_COMMAND_LENGTH] = [99, 111, 109, 112, 97, 114, 101]
    fixture_inspect_command_token: mutable u8[Test::INSPECT_COMMAND_LENGTH] = [105, 110, 115, 112, 101, 99, 116]
    fixture_locals_command_token: mutable u8[Test::LOCALS_COMMAND_LENGTH] = [108, 111, 99, 97, 108, 115]
    fixture_tasks_command_token: mutable u8[Test::TASKS_COMMAND_LENGTH] = [116, 97, 115, 107, 115]
    fixture_trace_verify_command_token: mutable u8[Test::TRACE_VERIFY_COMMAND_LENGTH] = [116, 114, 97, 99, 101, 86, 101, 114, 105, 102, 121]
    reverse_step_over: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(CliReverseCommandTest::REVERSE_STEP_OVER_NAME.cast[u8&], CliReverseCommandTest::REVERSE_STEP_OVER_LENGTH)
    reverse_step_out: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(CliReverseCommandTest::REVERSE_STEP_OUT_NAME.cast[u8&], CliReverseCommandTest::REVERSE_STEP_OUT_LENGTH)
    locals_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_locals_command_token[0], Test::LOCALS_COMMAND_LENGTH)
    inspect_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_inspect_command_token[0], Test::INSPECT_COMMAND_LENGTH)
    verify_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_trace_verify_command_token[0], Test::TRACE_VERIFY_COMMAND_LENGTH)
    compare_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_compare_command_token[0], Test::COMPARE_COMMAND_LENGTH)
    checkpoint_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_checkpoint_command_token[0], Test::CHECKPOINT_COMMAND_LENGTH)
    tasks_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_tasks_command_token[0], Test::TASKS_COMMAND_LENGTH)
    collision_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_colliding_continue_token[0], Test::COLLIDING_CONTINUE_LENGTH)
    empty_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_close_command_token[0], 0)
    return false if not locals_command.valid or locals_command.command != DebuggerCLI::Command.Locals
    return false if not inspect_command.valid or inspect_command.command != DebuggerCLI::Command.Inspect
    return false if not verify_command.valid or verify_command.command != DebuggerCLI::Command.TraceVerify
    return false if not compare_command.valid or compare_command.command != DebuggerCLI::Command.Compare
    return false if not checkpoint_command.valid or checkpoint_command.command != DebuggerCLI::Command.Checkpoint
    return false if not tasks_command.valid or tasks_command.command != DebuggerCLI::Command.Tasks
    return false if not save_trace_command_is_exact()
    return false if not reverse_step_over.valid or reverse_step_over.command != DebuggerCLI::Command.ReverseStepOver
    return false if not reverse_step_out.valid or reverse_step_out.command != DebuggerCLI::Command.ReverseStepOut
    reverse_step_over_request: DebuggerProtocolRequest::Request = DebuggerCLIRunner::request_for_command(reverse_step_over.command, Test::CLI_ARGUMENT_REQUEST_ID, Test::EXPECTED_GENERATION)
    reverse_step_out_request: DebuggerProtocolRequest::Request = DebuggerCLIRunner::request_for_command(reverse_step_out.command, Test::CLI_ARGUMENT_REQUEST_ID, Test::EXPECTED_GENERATION)
    return false if not reverse_step_over_request.valid or reverse_step_over_request.method != DebuggerProtocolRequest::RequestMethod.ReverseStepOver
    return false if not reverse_step_out_request.valid or reverse_step_out_request.method != DebuggerProtocolRequest::RequestMethod.ReverseStepOut
    return false if not DebuggerCLI::command_is_mutating(reverse_step_over.command) or not DebuggerCLI::command_is_mutating(reverse_step_out.command)
    return false if collision_command.valid or collision_command.command != DebuggerCLI::Command.Unknown
    return false if empty_command.valid or empty_command.command != DebuggerCLI::Command.Unknown
    return true

def main() -> i64:
    fixture_close_command_token: mutable u8[Test::CLOSE_COMMAND_LENGTH] = [99, 108, 111, 115, 101]
    fixture_colliding_continue_token: mutable u8[Test::COLLIDING_CONTINUE_LENGTH] = [100, 80, 110, 116, 105, 110, 117, 101]
    fixture_continue_argument_token: mutable u8[Test::CONTINUE_ARGUMENT_LENGTH] = [99, 111, 110, 116, 105, 110, 117, 101, 32, 49]
    fixture_next_command_token: mutable u8[Test::NEXT_COMMAND_LENGTH] = [110, 101, 120, 116]
    fixture_step_command_token: mutable u8[Test::STEP_COMMAND_LENGTH] = [115, 116, 101, 112]
    return Test::CLI_ALIAS_RESULT if not command_mappings_are_exact()
    run_request: DebuggerCLI::CommandRequest = DebuggerCLI::CommandRequest{command: DebuggerCLI::Command.Run, argument: 0, expected_generation: Test::EXPECTED_GENERATION}
    return 1 if not DebuggerCLI::command_is_mutating(run_request.command)
    return 2 if not DebuggerErrors::error_is_ok(DebuggerCLI::command_validate(run_request, Test::EXPECTED_GENERATION))
    stale_request: DebuggerCLI::CommandRequest = DebuggerCLI::CommandRequest{command: DebuggerCLI::Command.Step, argument: 0, expected_generation: Test::EXPECTED_GENERATION + 1}
    stale: DebuggerErrors::DebuggerError = DebuggerCLI::command_validate(stale_request, Test::EXPECTED_GENERATION)
    return 3 if stale.code != DebuggerErrors::ErrorCode.StaleGeneration or stale.detail != Test::STALE_GENERATION_DETAIL
    next_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_next_command_token[0], Test::NEXT_COMMAND_LENGTH)
    step_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_step_command_token[0], Test::STEP_COMMAND_LENGTH)
    close_command: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_close_command_token[0], Test::CLOSE_COMMAND_LENGTH)
    return Test::CLI_ALIAS_RESULT if not next_command.valid or next_command.command != DebuggerCLI::Command.Step or not step_command.valid or step_command.command != DebuggerCLI::Command.Step or not close_command.valid or close_command.command != DebuggerCLI::Command.Quit
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(5), build, DebuggerCapabilities::managed_capabilities())
    session.state <- DebuggerSession::SessionState.Stopped
    session.retained_last <- Test::EXPECTED_SEEK_EVENT
    runner: DebuggerCLIRunner::Runner = DebuggerCLIRunner::runner_new(session, DebuggerCLIRunner::OutputMode.Quiet)
    collision_result: DebuggerCLIRunner::Runner = DebuggerCLIRunner::runner_dispatch_line(runner, fixture_colliding_continue_token[0], Test::COLLIDING_CONTINUE_LENGTH, 7, 0)
    return Test::CLI_COLLISION_REJECTED_RESULT if DebuggerErrors::error_is_ok(collision_result.last_status) or collision_result.last_status.code != DebuggerErrors::ErrorCode.InvalidArgument
    return Test::CLI_COLLISION_MUTATION_RESULT if collision_result.session.state != runner.session.state or collision_result.session.position.event != runner.session.position.event or collision_result.session.stop_generation != runner.session.stop_generation
    continue_argument: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(fixture_continue_argument_token[0], Test::CONTINUE_ARGUMENT_LENGTH)
    return Test::CLI_ARGUMENT_REJECTED_RESULT if continue_argument.valid or continue_argument.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    ignored_argument_result: DebuggerCLIRunner::Runner = DebuggerCLIRunner::runner_dispatch_line(runner, fixture_continue_argument_token[0], Test::CONTINUE_ARGUMENT_LENGTH, Test::CLI_ARGUMENT_REQUEST_ID, 0)
    return Test::CLI_ARGUMENT_MUTATION_RESULT if ignored_argument_result.last_status.code != DebuggerErrors::ErrorCode.InvalidArgument or ignored_argument_result.session.state != runner.session.state or ignored_argument_result.session.position.event != runner.session.position.event or ignored_argument_result.session.stop_generation != runner.session.stop_generation
    seek_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Seek, id: 6, has_id: true, expected_generation: 0, target_event: Test::EXPECTED_SEEK_EVENT, valid: true}
    seek_result: DebuggerCLIRunner::Runner = DebuggerCLIRunner::runner_dispatch(runner, seek_request, 0)
    return Test::CLI_RUNNER_SEEK_RESULT if not DebuggerErrors::error_is_ok(seek_result.last_status) or seek_result.session.position.event != Test::EXPECTED_SEEK_EVENT or seek_result.session.stop_generation != 1
    return 0
