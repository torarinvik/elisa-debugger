include "../src/cli/commands.elisa"

const module Test:
    SEEK_LINE_LENGTH: usize = 8
    NEXT_LINE_LENGTH: usize = 4
    UNKNOWN_LINE_LENGTH: usize = 7
    OVERFLOW_LINE_LENGTH: usize = 25
    EXTRA_ARGUMENT_LENGTH: usize = 10
    EXPECTED_GENERATION: u64 = 12
    EXPECTED_SEEK: u64 = 17
    SEEK_WITH_GENERATION_LENGTH: usize = 10
    SEEK_WITH_GENERATION_VALUE: u64 = 12
    SEEK_WITH_GENERATION_OVERFLOW_LENGTH: usize = 27

    OPEN_LINE_CAPACITY: usize = 128
    PATH_CAPACITY: usize = 64
    FIRST_BYTE: usize = 0
    INCREMENT: usize = 1
    NUL: u8 = 0
    EXPECTED_TRACE_EVENT: u64 = 17

const module TestText:
    OPEN_LINE: cstr = "openTrace 17 build/cli trace restart.eltr"
    TRACE_PATH: cstr = "build/cli trace restart.eltr"
    MISSING_PATH_LINE: cstr = "openTrace 17   "
    OVERFLOW_EVENT_LINE: cstr = "openTrace 18446744073709551616 trace.eltr"
    LAUNCH_LINE: cstr = "launch build/compiler image.edir  \t"
    RUN_LINE: cstr = "run build/compiler image.edir"
    IMAGE_PATH: cstr = "build/compiler image.edir"

const module TestResult:
    SUCCESS: i64 = 0
    OPEN_TRACE_PARSE: i64 = 9
    OPEN_TRACE_PATH: i64 = 10
    OPEN_TRACE_MUTATING: i64 = 11
    OPEN_TRACE_MISSING_PATH: i64 = 12
    OPEN_TRACE_OVERFLOW: i64 = 13
    IMAGE_PATH_PARSE: i64 = 14

def copy_text(source: cstr, destination: mutable u8&, capacity: usize) -> usize:
    length: mutable usize = Test::FIRST_BYTE
    while length < capacity:
        byte: u8 = source[length].u8()
        break if byte == Test::NUL
        destination[length] <- byte
        length <- length + Test::INCREMENT
    return length

def image_path_is_exact(line: cstr, command: DebuggerCLI::Command) -> bool:
    bytes: mutable u8[Test::OPEN_LINE_CAPACITY] = zeroed
    expected: mutable u8[Test::PATH_CAPACITY] = zeroed
    length: usize = copy_text(line, bytes[Test::FIRST_BYTE], Test::OPEN_LINE_CAPACITY)
    path_length: usize = copy_text(TestText::IMAGE_PATH, expected[Test::FIRST_BYTE], Test::PATH_CAPACITY)
    parsed: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(bytes[Test::FIRST_BYTE], length, Test::EXPECTED_GENERATION)
    return false if not parsed.valid or parsed.command != command or parsed.argument_present or not parsed.text_argument_present or parsed.text_argument_length != path_length or parsed.expected_generation != Test::EXPECTED_GENERATION
    for index in Test::FIRST_BYTE..<path_length:
        return false if parsed.text_argument[index] != expected[index]
    # An embedded NUL must not make the loader open a different path.
    bytes[length - Test::INCREMENT] <- Test::NUL
    nul: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(bytes[Test::FIRST_BYTE], length, Test::EXPECTED_GENERATION)
    return not nul.valid


def main() -> i64:
    seek_line: mutable u8[Test::SEEK_LINE_LENGTH] = [115, 101, 101, 107, 32, 49, 55, 10]
    seek: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(seek_line[0], Test::SEEK_LINE_LENGTH, Test::EXPECTED_GENERATION)
    return 1 if not seek.valid or seek.command != DebuggerCLI::Command.Seek or not seek.argument_present or seek.argument != Test::EXPECTED_SEEK or seek.expected_generation != Test::EXPECTED_GENERATION or seek.consumed != Test::SEEK_LINE_LENGTH

    seek_with_generation_line: mutable u8[Test::SEEK_WITH_GENERATION_LENGTH] = [115, 101, 101, 107, 32, 49, 55, 32, 49, 50]
    seek_with_generation: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(seek_with_generation_line[0], Test::SEEK_WITH_GENERATION_LENGTH)
    return 6 if not seek_with_generation.valid or seek_with_generation.command != DebuggerCLI::Command.Seek or seek_with_generation.argument != Test::EXPECTED_SEEK or seek_with_generation.expected_generation != Test::SEEK_WITH_GENERATION_VALUE

    seek_with_generation_overflow_line: mutable u8[Test::SEEK_WITH_GENERATION_OVERFLOW_LENGTH] = [115, 101, 101, 107, 32, 49, 32, 49, 56, 52, 52, 54, 55, 52, 52, 48, 55, 51, 55, 48, 57, 53, 53, 49, 54, 49, 54]
    seek_with_generation_overflow: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(seek_with_generation_overflow_line[0], Test::SEEK_WITH_GENERATION_OVERFLOW_LENGTH)
    return 8 if seek_with_generation_overflow.valid

    next_line: mutable u8[Test::NEXT_LINE_LENGTH] = [110, 101, 120, 116]
    next: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(next_line[0], Test::NEXT_LINE_LENGTH)
    return 2 if not next.valid or next.command != DebuggerCLI::Command.Step or next.argument_present

    unknown_line: mutable u8[Test::UNKNOWN_LINE_LENGTH] = [117, 110, 107, 110, 111, 119, 110]
    unknown: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(unknown_line[0], Test::UNKNOWN_LINE_LENGTH)
    return 3 if unknown.valid or unknown.failure.code != DebuggerErrors::ErrorCode.InvalidArgument

    overflow_line: mutable u8[Test::OVERFLOW_LINE_LENGTH] = [115, 101, 101, 107, 32, 49, 56, 52, 52, 54, 55, 52, 52, 48, 55, 51, 55, 48, 57, 53, 53, 49, 54, 49, 54]
    overflow: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(overflow_line[0], Test::OVERFLOW_LINE_LENGTH)
    return 4 if overflow.valid

    extra_line: mutable u8[Test::EXTRA_ARGUMENT_LENGTH] = [115, 101, 101, 107, 32, 49, 32, 50, 32, 51]
    extra: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(extra_line[0], Test::EXTRA_ARGUMENT_LENGTH)
    return 5 if extra.valid

    missing_seek_target: mutable u8[Test::SEEK_LINE_LENGTH] = [115, 101, 101, 107, 32, 32, 32, 32]
    missing_seek: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse(missing_seek_target[0], Test::SEEK_LINE_LENGTH)
    return 7 if missing_seek.valid
    open_line: mutable u8[Test::OPEN_LINE_CAPACITY] = zeroed
    trace_path: mutable u8[Test::PATH_CAPACITY] = zeroed
    open_length: usize = copy_text(TestText::OPEN_LINE, open_line[Test::FIRST_BYTE], Test::OPEN_LINE_CAPACITY)
    path_length: usize = copy_text(TestText::TRACE_PATH, trace_path[Test::FIRST_BYTE], Test::PATH_CAPACITY)
    open: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(open_line[Test::FIRST_BYTE], open_length, Test::EXPECTED_GENERATION)
    return TestResult::OPEN_TRACE_PARSE if not open.valid or open.command != DebuggerCLI::Command.OpenTrace or not open.argument_present or open.argument != Test::EXPECTED_TRACE_EVENT or not open.text_argument_present or open.text_argument_length != path_length
    return TestResult::OPEN_TRACE_MUTATING if not DebuggerCLI::command_is_mutating(open.command)
    for index in Test::FIRST_BYTE..<path_length:
        return TestResult::OPEN_TRACE_PATH if open.text_argument[index] != trace_path[index]

    missing_path_line: mutable u8[Test::OPEN_LINE_CAPACITY] = zeroed
    missing_path_length: usize = copy_text(TestText::MISSING_PATH_LINE, missing_path_line[Test::FIRST_BYTE], Test::OPEN_LINE_CAPACITY)
    missing_path: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(missing_path_line[Test::FIRST_BYTE], missing_path_length, Test::EXPECTED_GENERATION)
    return TestResult::OPEN_TRACE_MISSING_PATH if missing_path.valid

    overflow_event_line: mutable u8[Test::OPEN_LINE_CAPACITY] = zeroed
    overflow_event_length: usize = copy_text(TestText::OVERFLOW_EVENT_LINE, overflow_event_line[Test::FIRST_BYTE], Test::OPEN_LINE_CAPACITY)
    overflow_event: DebuggerCLI::ParsedCommand = DebuggerCLI::command_parse_line(overflow_event_line[Test::FIRST_BYTE], overflow_event_length, Test::EXPECTED_GENERATION)
    return TestResult::OPEN_TRACE_OVERFLOW if overflow_event.valid
    return TestResult::IMAGE_PATH_PARSE if not image_path_is_exact(TestText::LAUNCH_LINE, DebuggerCLI::Command.Launch) or not image_path_is_exact(TestText::RUN_LINE, DebuggerCLI::Command.Run)
    return TestResult::SUCCESS
