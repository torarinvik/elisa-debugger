include "../src/vm/edir_file.elisa"

const module Test:
    ARTIFACT_PATH_LENGTH: usize = 37
    ARTIFACT_PATH: cstr = "build/compiler_edir_counted_loop.edir"
    EXPECTED_RESULT: i64 = 10
    EXPECTED_COUNTER: i64 = 5
    EXPECTED_TOTAL: i64 = 10
    EXPECTED_LOCAL_COUNT: u64 = 2
    EXPECTED_SOURCE_FILE_COUNT: usize = 1
    EXPECTED_SOURCE_FILE_ID: u64 = 1
    EMPTY_IDENTITY_VALUE: u64 = 0
    EXPECTED_SOURCE_LINE_COUNT: u64 = 8
    EXPECTED_INSTRUCTION_COUNT: u64 = 16
    COUNTER_LOCAL_INDEX: usize = 0
    TOTAL_LOCAL_INDEX: usize = 1
    CONDITION_LOAD_INSTRUCTION_INDEX: usize = 4
    CONDITION_COMPARE_INSTRUCTION_INDEX: usize = 5
    CONDITION_BRANCH_INSTRUCTION_INDEX: usize = 6
    LOOP_BACK_EDGE_INSTRUCTION_INDEX: usize = 13
    TOTAL_UPDATE_LOAD_INSTRUCTION_INDEX: usize = 7
    COUNTER_UPDATE_LOAD_INSTRUCTION_INDEX: usize = 10
    UPDATE_ADD_INSTRUCTION_OFFSET: usize = 1
    UPDATE_STORE_INSTRUCTION_OFFSET: usize = 2
    EXPECTED_LOOP_START: i64 = 4
    EXPECTED_LOOP_EXIT: i64 = 14
    EXPECTED_LOOP_LIMIT: i64 = 5
    EXPECTED_LOOP_START_LINE: u32 = 4
    EXPECTED_LOOP_END_LINE: u32 = 4
    EXPECTED_TOTAL_UPDATE_LINE: u32 = 5
    EXPECTED_COUNTER_UPDATE_LINE: u32 = 6
    RUN_STEP_BUDGET: u64 = 128
    RESULT_ARTIFACT_LOAD: i64 = 1
    RESULT_IMAGE_VERIFICATION: i64 = 2
    RESULT_LOOP_SHAPE: i64 = 3
    RESULT_SOURCE_SPAN: i64 = 4
    RESULT_EXECUTION: i64 = 5



def source_spans_equal(left: DebuggerIdentity::SourceSpan, right: DebuggerIdentity::SourceSpan) -> bool:
    return left.file.value == right.file.value and left.start_byte == right.start_byte and left.end_byte == right.end_byte and left.start_line == right.start_line and left.start_column == right.start_column and left.end_line == right.end_line and left.end_column == right.end_column and left.discriminator == right.discriminator

def main() -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(Test::ARTIFACT_PATH.cast[u8&], Test::ARTIFACT_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return Test::RESULT_ARTIFACT_LOAD if not loaded.valid or loaded.status != DebuggerEDIRFile::LoadStatus.Ready
    return Test::RESULT_IMAGE_VERIFICATION if not DebuggerEDIR::verify_image(loaded.image).valid
    return Test::RESULT_LOOP_SHAPE if loaded.image.program.instruction_count != Test::EXPECTED_INSTRUCTION_COUNT or loaded.image.program.local_count != Test::EXPECTED_LOCAL_COUNT or not loaded.image.program.has_return
    return Test::RESULT_SOURCE_SPAN if loaded.image.source_file_count != Test::EXPECTED_SOURCE_FILE_COUNT or loaded.image.source_files[0].id.value != Test::EXPECTED_SOURCE_FILE_ID or loaded.image.source_files[0].logical_path.value == Test::EMPTY_IDENTITY_VALUE or loaded.image.source_files[0].content.value == Test::EMPTY_IDENTITY_VALUE or loaded.image.source_files[0].line_count != Test::EXPECTED_SOURCE_LINE_COUNT

    compare: DebuggerEDIR::Instruction = loaded.image.instructions[Test::CONDITION_COMPARE_INSTRUCTION_INDEX]
    branch: DebuggerEDIR::Instruction = loaded.image.instructions[Test::CONDITION_BRANCH_INSTRUCTION_INDEX]
    jump: DebuggerEDIR::Instruction = loaded.image.instructions[Test::LOOP_BACK_EDGE_INSTRUCTION_INDEX]
    return Test::RESULT_LOOP_SHAPE if compare.opcode != DebuggerEDIR::Opcode.CompareLess or compare.a != Test::EXPECTED_LOOP_LIMIT or branch.opcode != DebuggerEDIR::Opcode.BranchZero or branch.a != Test::EXPECTED_LOOP_EXIT or jump.opcode != DebuggerEDIR::Opcode.Jump or jump.a != Test::EXPECTED_LOOP_START
    loop_span: DebuggerIdentity::SourceSpan = loaded.image.instructions[Test::CONDITION_LOAD_INSTRUCTION_INDEX].source
    return Test::RESULT_SOURCE_SPAN if loop_span.start_line != Test::EXPECTED_LOOP_START_LINE or loop_span.end_line != Test::EXPECTED_LOOP_END_LINE or loop_span.start_byte >= loop_span.end_byte or not source_spans_equal(loop_span, compare.source) or not source_spans_equal(loop_span, branch.source) or not source_spans_equal(loop_span, jump.source)
    total_update_span: DebuggerIdentity::SourceSpan = loaded.image.instructions[Test::TOTAL_UPDATE_LOAD_INSTRUCTION_INDEX].source
    counter_update_span: DebuggerIdentity::SourceSpan = loaded.image.instructions[Test::COUNTER_UPDATE_LOAD_INSTRUCTION_INDEX].source
    return Test::RESULT_SOURCE_SPAN if total_update_span.start_line != Test::EXPECTED_TOTAL_UPDATE_LINE or total_update_span.end_line != Test::EXPECTED_TOTAL_UPDATE_LINE or counter_update_span.start_line != Test::EXPECTED_COUNTER_UPDATE_LINE or counter_update_span.end_line != Test::EXPECTED_COUNTER_UPDATE_LINE
    return Test::RESULT_SOURCE_SPAN if not source_spans_equal(total_update_span, loaded.image.instructions[Test::TOTAL_UPDATE_LOAD_INSTRUCTION_INDEX + Test::UPDATE_ADD_INSTRUCTION_OFFSET].source) or not source_spans_equal(total_update_span, loaded.image.instructions[Test::TOTAL_UPDATE_LOAD_INSTRUCTION_INDEX + Test::UPDATE_STORE_INSTRUCTION_OFFSET].source) or not source_spans_equal(counter_update_span, loaded.image.instructions[Test::COUNTER_UPDATE_LOAD_INSTRUCTION_INDEX + Test::UPDATE_ADD_INSTRUCTION_OFFSET].source) or not source_spans_equal(counter_update_span, loaded.image.instructions[Test::COUNTER_UPDATE_LOAD_INSTRUCTION_INDEX + Test::UPDATE_STORE_INSTRUCTION_OFFSET].source)
    return Test::RESULT_SOURCE_SPAN if source_spans_equal(loop_span, total_update_span) or source_spans_equal(loop_span, counter_update_span) or source_spans_equal(total_update_span, counter_update_span)

    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_run(loaded.image, DebuggerEDIR::machine_new(), Test::RUN_STEP_BUDGET)
    return Test::RESULT_EXECUTION if machine.faulted or not machine.halted or machine.result != Test::EXPECTED_RESULT or not machine.locals_initialized[Test::COUNTER_LOCAL_INDEX] or not machine.locals_initialized[Test::TOTAL_LOCAL_INDEX] or machine.locals[Test::COUNTER_LOCAL_INDEX] != Test::EXPECTED_COUNTER or machine.locals[Test::TOTAL_LOCAL_INDEX] != Test::EXPECTED_TOTAL
    return 0
