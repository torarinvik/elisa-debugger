# Compiler-produced host effects must reach managed providers as exact events.

include "../src/engine/managed.elisa"
include "../src/vm/edir_file.elisa"

const module Test:
    const module Artifact:
        PATH: cstr = "build/host.edir"
        PATH_LENGTH: usize = 15
        EXPECTED_PROGRAM_VERSION: u32 = 2

    const module Identity:
        SESSION_ID: u64 = 9101
        RECORDING_ID: u64 = 9102
        COMPILER_ID: u64 = 9103
        RUNTIME_ID: u64 = 9104
        SOURCE_ID: u64 = 9105
        TARGET_ID: u64 = 9106
        METADATA_VERSION: u32 = 1

    const module Provider:
        CLOCK_VALUE: i64 = 3
        CLOCK_RESULT_HASH: u64 = 9201
        RANDOM_VALUE: u64 = 13
        RANDOM_RESULT_HASH: u64 = 9202
        EXPECTED_RESULT: i64 = 42

    const module Bounds:
        FIRST_INDEX: usize = 0
        EVENT_INCREMENT: usize = 1
        MAX_RUN_TURNS: usize = 8
        MAX_CONTINUE_STEPS: u64 = 64
        NO_TARGET_EVENT: usize = 0
        EXPECTED_MAX_CALL_DEPTH: usize = 4

    const module Failure:
        SUCCESS: i64 = 0
        ARTIFACT_LOAD: i64 = 1
        ARTIFACT_VERSION: i64 = 2
        ARTIFACT_EFFECT_ORDER: i64 = 3
        SESSION_SETUP: i64 = 4
        HOST_REQUEST: i64 = 5
        CLOCK_RECORD: i64 = 6
        RANDOM_RECORD: i64 = 7
        EXECUTION: i64 = 8
        RESULT: i64 = 9
        EXACTNESS: i64 = 10
        REVERSE_RANDOM: i64 = 11
        RANDOM_NOT_RESTORED: i64 = 12
        REVERSE_CLOCK: i64 = 13
        CLOCK_NOT_RESTORED: i64 = 14
        REPLAY_SETUP: i64 = 15
        REPLAY_CLOCK: i64 = 16
        REPLAY_RANDOM: i64 = 17
        REPLAY_EXECUTION: i64 = 18
        REPLAY_RESULT: i64 = 19


def replay_compiled_host_effects(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&, recorded_state: DebuggerManagedState::State&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    replay_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(replay_controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return Test::Failure::REPLAY_SETUP if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(replay_controller))
    return Test::Failure::REPLAY_SETUP if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(replay_controller))
    replay_controller.state <- recorded_state
    return Test::Failure::REPLAY_SETUP if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_begin_side_effect_replay(replay_controller))

    turns: mutable usize = Test::Bounds::FIRST_INDEX
    while turns < Test::Bounds::MAX_RUN_TURNS and not replay_controller.engine.machine.halted:
        outcome: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(replay_controller, Test::Bounds::MAX_CONTINUE_STEPS)
        if outcome.kind == DebuggerManagedEngine::ExecutionOutcomeKind.AwaitingHostEffect:
            return Test::Failure::HOST_REQUEST if not outcome.host_effect.valid
            if outcome.host_effect.kind == DebuggerManagedEngine::HostEffectKind.ClockNow:
                clock_replay: DebuggerEffects::EffectReplay = DebuggerManagedEngine::managed_replay_clock_effect(replay_controller, outcome.host_effect.request_hash)
                return Test::Failure::REPLAY_CLOCK if not clock_replay.accepted or clock_replay.result_value != Test::Provider::CLOCK_VALUE.u64()
            elif outcome.host_effect.kind == DebuggerManagedEngine::HostEffectKind.RandomU64:
                random_replay: DebuggerEffects::RandomEffectReplay = DebuggerManagedEngine::managed_replay_random_effect(replay_controller, outcome.host_effect.request_hash)
                return Test::Failure::REPLAY_RANDOM if not random_replay.accepted or random_replay.value != Test::Provider::RANDOM_VALUE
            else:
                return Test::Failure::HOST_REQUEST
        elif outcome.kind == DebuggerManagedEngine::ExecutionOutcomeKind.Failed:
            return Test::Failure::REPLAY_EXECUTION
        turns <- turns + Test::Bounds::EVENT_INCREMENT

    return Test::Failure::REPLAY_EXECUTION if not replay_controller.engine.machine.halted
    return Test::Failure::REPLAY_RESULT if replay_controller.engine.machine.result != Test::Provider::EXPECTED_RESULT
    return Test::Failure::REPLAY_RESULT if replay_controller.state.effects.cursor != Test::Bounds::EVENT_INCREMENT + Test::Bounds::EVENT_INCREMENT or replay_controller.state.adapters.clock.cursor != Test::Bounds::EVENT_INCREMENT or replay_controller.state.adapters.random.cursor != Test::Bounds::EVENT_INCREMENT
    return Test::Failure::REPLAY_RESULT if not DebuggerManagedEngine::managed_is_exact(replay_controller)
    return Test::Failure::SUCCESS


def main() -> i64 can[Blocking.IO, Unsafe.PointerCast, Memory.Allocate, Abort.Panic]:
    loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(Test::Artifact::PATH.cast[u8&], Test::Artifact::PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return Test::Failure::ARTIFACT_LOAD if not loaded.valid
    return Test::Failure::ARTIFACT_VERSION if loaded.image.program.version != Test::Artifact::EXPECTED_PROGRAM_VERSION or loaded.image.program.instruction_count == Test::Bounds::NO_TARGET_EVENT.u64()

    clock_index: mutable usize = DebuggerEDIR::instruction_capacity()
    random_index: mutable usize = DebuggerEDIR::instruction_capacity()
    for instruction_index in Test::Bounds::FIRST_INDEX..<loaded.image.program.instruction_count.usize():
        instruction: DebuggerEDIR::Instruction = loaded.image.instructions[instruction_index]
        if instruction.opcode == DebuggerEDIR::Opcode.ClockNow:
            return Test::Failure::ARTIFACT_EFFECT_ORDER if clock_index != DebuggerEDIR::instruction_capacity()
            clock_index <- instruction_index
        if instruction.opcode == DebuggerEDIR::Opcode.RandomU64:
            return Test::Failure::ARTIFACT_EFFECT_ORDER if random_index != DebuggerEDIR::instruction_capacity()
            random_index <- instruction_index
    return Test::Failure::ARTIFACT_EFFECT_ORDER if clock_index >= random_index or random_index >= loaded.image.program.instruction_count.usize()

    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::Identity::COMPILER_ID), runtime: DebuggerIdentity::debug_id(Test::Identity::RUNTIME_ID), source: DebuggerIdentity::debug_id(Test::Identity::SOURCE_ID), target: DebuggerIdentity::debug_id(Test::Identity::TARGET_ID), metadata_version: Test::Identity::METADATA_VERSION}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::Identity::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, loaded.image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return Test::Failure::SESSION_SETUP if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))

    clock_event: mutable usize = Test::Bounds::NO_TARGET_EVENT
    random_event: mutable usize = Test::Bounds::NO_TARGET_EVENT
    turns: mutable usize = Test::Bounds::FIRST_INDEX
    maximum_call_depth: mutable usize = Test::Bounds::FIRST_INDEX
    while turns < Test::Bounds::MAX_RUN_TURNS and not controller.engine.machine.halted:
        outcome: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(controller, Test::Bounds::MAX_CONTINUE_STEPS)
        maximum_call_depth <- controller.engine.machine.return_stack_pointer if controller.engine.machine.return_stack_pointer > maximum_call_depth
        if outcome.kind == DebuggerManagedEngine::ExecutionOutcomeKind.AwaitingHostEffect:
            return Test::Failure::HOST_REQUEST if not outcome.host_effect.valid
            if outcome.host_effect.kind == DebuggerManagedEngine::HostEffectKind.ClockNow:
                return Test::Failure::CLOCK_RECORD if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_record_clock_effect(controller, outcome.host_effect.request_hash, Test::Provider::CLOCK_RESULT_HASH, Test::Provider::CLOCK_VALUE))
                clock_event <- controller.engine.event_count
            elif outcome.host_effect.kind == DebuggerManagedEngine::HostEffectKind.RandomU64:
                return Test::Failure::RANDOM_RECORD if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_record_random_effect(controller, outcome.host_effect.request_hash, Test::Provider::RANDOM_RESULT_HASH, Test::Provider::RANDOM_VALUE))
                random_event <- controller.engine.event_count
            else:
                return Test::Failure::HOST_REQUEST
        elif outcome.kind == DebuggerManagedEngine::ExecutionOutcomeKind.Failed:
            return Test::Failure::EXECUTION
        turns <- turns + Test::Bounds::EVENT_INCREMENT

    return Test::Failure::EXECUTION if not controller.engine.machine.halted or clock_event == Test::Bounds::NO_TARGET_EVENT or random_event == Test::Bounds::NO_TARGET_EVENT
    return Test::Failure::RESULT if controller.engine.machine.result != Test::Provider::EXPECTED_RESULT
    return Test::Failure::RESULT if maximum_call_depth != Test::Bounds::EXPECTED_MAX_CALL_DEPTH
    return Test::Failure::EXACTNESS if controller.state.effects.count != Test::Bounds::EVENT_INCREMENT + Test::Bounds::EVENT_INCREMENT or controller.state.adapters.clock.count != Test::Bounds::EVENT_INCREMENT or controller.state.adapters.random.count != Test::Bounds::EVENT_INCREMENT or not DebuggerManagedEngine::managed_is_exact(controller)

    final_event: usize = controller.engine.event_count
    reverse_before_clock: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, clock_event - Test::Bounds::EVENT_INCREMENT)
    return Test::Failure::REVERSE_CLOCK if not DebuggerErrors::error_is_ok(reverse_before_clock) or controller.engine.event_count != clock_event - Test::Bounds::EVENT_INCREMENT
    return Test::Failure::REVERSE_CLOCK if controller.state.effects.count != Test::Bounds::NO_TARGET_EVENT or controller.state.adapters.clock.count != Test::Bounds::NO_TARGET_EVENT or controller.state.adapters.random.count != Test::Bounds::NO_TARGET_EVENT
    forward_after_clock: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, clock_event)
    return Test::Failure::CLOCK_NOT_RESTORED if not DebuggerErrors::error_is_ok(forward_after_clock) or controller.engine.event_count != clock_event
    return Test::Failure::CLOCK_NOT_RESTORED if controller.state.effects.count != Test::Bounds::EVENT_INCREMENT or controller.state.adapters.clock.count != Test::Bounds::EVENT_INCREMENT or controller.state.adapters.random.count != Test::Bounds::NO_TARGET_EVENT
    return Test::Failure::CLOCK_NOT_RESTORED if controller.state.adapters.clock.samples[Test::Bounds::FIRST_INDEX].value != Test::Provider::CLOCK_VALUE.u64()

    reverse_before_random: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, random_event - Test::Bounds::EVENT_INCREMENT)
    return Test::Failure::REVERSE_RANDOM if not DebuggerErrors::error_is_ok(reverse_before_random) or controller.engine.event_count != random_event - Test::Bounds::EVENT_INCREMENT
    return Test::Failure::REVERSE_RANDOM if controller.state.effects.count != Test::Bounds::EVENT_INCREMENT or controller.state.adapters.random.count != Test::Bounds::NO_TARGET_EVENT
    forward_after_random: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, random_event)
    return Test::Failure::RANDOM_NOT_RESTORED if not DebuggerErrors::error_is_ok(forward_after_random) or controller.engine.event_count != random_event
    return Test::Failure::RANDOM_NOT_RESTORED if controller.state.adapters.random.count != Test::Bounds::EVENT_INCREMENT or controller.engine.effect_result_bits[random_event - Test::Bounds::EVENT_INCREMENT] != Test::Provider::RANDOM_VALUE
    final_seek: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, final_event)
    return Test::Failure::EXACTNESS if not DebuggerErrors::error_is_ok(final_seek) or not controller.engine.machine.halted or not DebuggerManagedEngine::managed_is_exact(controller)
    replay_result: i64 = replay_compiled_host_effects(session, loaded.image, controller.state)
    return replay_result if replay_result != Test::Failure::SUCCESS
    return Test::Failure::SUCCESS
