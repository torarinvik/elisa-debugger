module DebuggerHostEffects:
    extern clock_now() -> i64 can[Console]
    extern random_u64() -> i64 can[Console]

def main() -> i64 can[Console]:
    return random_after_clock(DebuggerHostEffects::clock_now())

def random_after_clock(timestamp: i64) -> i64 can[Console]:
    return DebuggerHostEffects::random_u64()
