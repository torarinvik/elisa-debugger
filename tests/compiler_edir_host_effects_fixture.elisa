module DebuggerHostEffects:
    extern clock_now() -> i64 can[Console]
    extern random_u64() -> i64 can[Console]
    extern console_write_byte(value: i64) -> i64 can[Console]

def main() -> i64 can[Console]:
    return result_for_random(clock_gate(DebuggerHostEffects::clock_now()))

def clock_gate(timestamp: i64) -> i64 can[Console]:
    if timestamp < 1:
        return timestamp
    else:
        return descend_clock(timestamp - 1)

def descend_clock(counter: i64) -> i64 can[Console]:
    if counter < 1:
        return DebuggerHostEffects::random_u64()
    else:
        return descend_clock(counter - 1)

def result_for_random(sample: i64) -> i64:
    if sample < 1:
        return 0
    else:
        return DebuggerHostEffects::console_write_byte(67)
