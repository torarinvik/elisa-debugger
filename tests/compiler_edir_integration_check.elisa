include "../src/vm/edir_file.elisa"

const module Test:
    ARTIFACT_PATH_LENGTH: usize = 35
    ARTIFACT_PATH: cstr = "build/compiler_edir_arithmetic.edir"
    EXPECTED_RESULT: i64 = 42
    EXPECTED_SOURCE_FILE_ID: u64 = 1
    EXPECTED_SOURCE_LINE_COUNT: u64 = 4
    EXPECTED_INITIALIZER_SOURCE_LINE: u32 = 2
    EXPECTED_DECLARATION_SOURCE_LINE: u32 = 2
    EXPECTED_EXPRESSION_SOURCE_LINE: u32 = 3
    EXPECTED_RETURN_SOURCE_LINE: u32 = 3
    EXPECTED_LEFT_OPERAND: i64 = 40
    EXPECTED_RIGHT_OPERAND: i64 = 2
    EXPECTED_LOCAL_COUNT: u64 = 1
    EXPECTED_LOCAL_INDEX: i64 = 0
    EXPECTED_INSTRUCTION_COUNT: u64 = 5
    CONSTANT_INSTRUCTION_INDEX: usize = 0
    STORE_LOCAL_INSTRUCTION_INDEX: usize = 1
    LOAD_LOCAL_INSTRUCTION_INDEX: usize = 2
    ARITHMETIC_INSTRUCTION_INDEX: usize = 3
    EXPECTED_RETURN_INSTRUCTION_INDEX: usize = 4
    RUN_STEP_BUDGET: u64 = Test::EXPECTED_INSTRUCTION_COUNT
    RESULT_ARTIFACT_LOAD: i64 = 1
    RESULT_IMAGE_VERIFICATION: i64 = 2
    RESULT_INSTRUCTION_SHAPE: i64 = 3
    RESULT_SOURCE_SPAN: i64 = 4
    RESULT_EXECUTION: i64 = 5



def main() -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(Test::ARTIFACT_PATH.cast[u8&], Test::ARTIFACT_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return Test::RESULT_ARTIFACT_LOAD if not loaded.valid or loaded.status != DebuggerEDIRFile::LoadStatus.Ready
    return Test::RESULT_IMAGE_VERIFICATION if not DebuggerEDIR::verify_image(loaded.image).valid
    return Test::RESULT_SOURCE_SPAN if loaded.image.source_file_count != 1
    return Test::RESULT_SOURCE_SPAN if loaded.image.source_files[0].id.value != Test::EXPECTED_SOURCE_FILE_ID or loaded.image.source_files[0].logical_path.value == 0 or loaded.image.source_files[0].content.value == 0 or loaded.image.source_files[0].line_count != Test::EXPECTED_SOURCE_LINE_COUNT
    return Test::RESULT_INSTRUCTION_SHAPE if loaded.image.program.instruction_count != Test::EXPECTED_INSTRUCTION_COUNT or loaded.image.program.local_count != Test::EXPECTED_LOCAL_COUNT or not loaded.image.program.has_return or loaded.image.instructions[Test::CONSTANT_INSTRUCTION_INDEX].opcode != DebuggerEDIR::Opcode.Constant or loaded.image.instructions[Test::CONSTANT_INSTRUCTION_INDEX].a != Test::EXPECTED_LEFT_OPERAND or loaded.image.instructions[Test::STORE_LOCAL_INSTRUCTION_INDEX].opcode != DebuggerEDIR::Opcode.StoreLocal or loaded.image.instructions[Test::STORE_LOCAL_INSTRUCTION_INDEX].a != Test::EXPECTED_LOCAL_INDEX or loaded.image.instructions[Test::LOAD_LOCAL_INSTRUCTION_INDEX].opcode != DebuggerEDIR::Opcode.LoadLocal or loaded.image.instructions[Test::LOAD_LOCAL_INSTRUCTION_INDEX].a != Test::EXPECTED_LOCAL_INDEX or loaded.image.instructions[Test::ARITHMETIC_INSTRUCTION_INDEX].opcode != DebuggerEDIR::Opcode.Add or loaded.image.instructions[Test::ARITHMETIC_INSTRUCTION_INDEX].a != Test::EXPECTED_RIGHT_OPERAND or loaded.image.instructions[Test::EXPECTED_RETURN_INSTRUCTION_INDEX].opcode != DebuggerEDIR::Opcode.Return
    source: DebuggerIdentity::SourceSpan = loaded.image.instructions[Test::CONSTANT_INSTRUCTION_INDEX].source
    return Test::RESULT_SOURCE_SPAN if source.file.value != Test::EXPECTED_SOURCE_FILE_ID or source.start_line != Test::EXPECTED_INITIALIZER_SOURCE_LINE or source.start_byte >= source.end_byte or source.start_column == 0
    declaration: DebuggerIdentity::SourceSpan = loaded.image.instructions[Test::STORE_LOCAL_INSTRUCTION_INDEX].source
    return Test::RESULT_SOURCE_SPAN if declaration.file.value != Test::EXPECTED_SOURCE_FILE_ID or declaration.start_line != Test::EXPECTED_DECLARATION_SOURCE_LINE or declaration.start_byte >= declaration.end_byte
    expression: DebuggerIdentity::SourceSpan = loaded.image.instructions[Test::ARITHMETIC_INSTRUCTION_INDEX].source
    return Test::RESULT_SOURCE_SPAN if expression.file.value != Test::EXPECTED_SOURCE_FILE_ID or expression.start_line != Test::EXPECTED_EXPRESSION_SOURCE_LINE or expression.start_byte >= expression.end_byte
    returned: DebuggerIdentity::SourceSpan = loaded.image.instructions[Test::EXPECTED_RETURN_INSTRUCTION_INDEX].source
    return Test::RESULT_SOURCE_SPAN if returned.file.value != Test::EXPECTED_SOURCE_FILE_ID or returned.start_line != Test::EXPECTED_RETURN_SOURCE_LINE or returned.start_byte >= returned.end_byte
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_run(loaded.image, DebuggerEDIR::machine_new(), Test::RUN_STEP_BUDGET)
    return Test::RESULT_EXECUTION if machine.faulted or not machine.halted or machine.result != Test::EXPECTED_RESULT or not machine.locals_initialized[Test::EXPECTED_LOCAL_INDEX.usize()] or machine.locals[Test::EXPECTED_LOCAL_INDEX.usize()] != Test::EXPECTED_LEFT_OPERAND
    return 0
