module DebuggerHostEffects:
    extern clock_now() -> i64 can[IO]
    extern random_u64() -> i64 can[IO]
    extern console_write_byte(value: i64) -> i64 can[IO]
    extern console_read_byte() -> i64 can[IO]
    extern virtual_file_read_byte(handle: i64) -> i64 can[IO]

def main() -> i64 can[IO]:
    return descend_clock(DebuggerHostEffects::clock_now())

def descend_clock(counter: i64) -> i64 can[IO]:
    if counter < 1:
        return accept_random(DebuggerHostEffects::random_u64())
    else:
        return descend_clock(counter - 1)

def accept_random(sample: i64) -> i64 can[IO]:
    if sample < 0:
        return accept_output(DebuggerHostEffects::console_write_byte(67))
    else:
        return 0

def accept_output(transferred: i64) -> i64 can[IO]:
    if transferred == 1:
        return accept_input(DebuggerHostEffects::console_read_byte())
    else:
        return 0

def accept_input(value: i64) -> i64 can[IO]:
    if value == 66:
        return accept_eof(DebuggerHostEffects::console_read_byte())
    else:
        return 0

def accept_eof(value: i64) -> i64 can[IO]:
    if value < 0:
        return accept_file(DebuggerHostEffects::virtual_file_read_byte(1))
    else:
        return 0

def accept_file(value: i64) -> i64 can[IO]:
    if value == 65:
        return DebuggerHostEffects::virtual_file_read_byte(1)
    else:
        return 0
