# Four guest branches keep this chain within the 64-event retained window.
# The driver verifies every scalar result, including the other error cases.
module DebuggerHostEffects:
    extern virtual_file_try_read_byte(handle: i64) -> i64 can[IO]
    extern virtual_file_try_write_byte(handle: i64, value: i64) -> i64 can[IO]
    extern virtual_file_try_seek(handle: i64, offset: i64) -> i64 can[IO]
    extern virtual_file_try_close(handle: i64) -> i64 can[IO]
    extern virtual_file_try_reopen(handle: i64) -> i64 can[IO]

def main() -> i64 can[IO]:
    return after_closed(DebuggerHostEffects::virtual_file_try_close(1))

def after_closed(value: i64) -> i64 can[IO]:
    if value == 0:
        return after_closed_read(DebuggerHostEffects::virtual_file_try_read_byte(1))
    else:
        return 0

def after_closed_read(value: i64) -> i64 can[IO]:
    if value == -5:
        return after_closed_write(DebuggerHostEffects::virtual_file_try_write_byte(1, 90))
    else:
        return 0

def after_closed_write(value: i64) -> i64 can[IO]:
    return after_closed_seek(DebuggerHostEffects::virtual_file_try_seek(1, 0))

def after_closed_seek(value: i64) -> i64 can[IO]:
    return after_closed_again(DebuggerHostEffects::virtual_file_try_close(1))

def after_closed_again(value: i64) -> i64 can[IO]:
    return after_reopened(DebuggerHostEffects::virtual_file_try_reopen(1))

def after_reopened(value: i64) -> i64 can[IO]:
    return after_first_read(DebuggerHostEffects::virtual_file_try_read_byte(1))

def after_first_read(value: i64) -> i64 can[IO]:
    return after_already_open(DebuggerHostEffects::virtual_file_try_reopen(1))

def after_already_open(value: i64) -> i64 can[IO]:
    if value == -6:
        return after_unknown_close(DebuggerHostEffects::virtual_file_try_close(7))
    else:
        return 0

def after_unknown_close(value: i64) -> i64 can[IO]:
    return after_unknown_reopen(DebuggerHostEffects::virtual_file_try_reopen(7))

def after_unknown_reopen(value: i64) -> i64 can[IO]:
    return after_closed_at_end(DebuggerHostEffects::virtual_file_try_close(1))

def after_closed_at_end(value: i64) -> i64 can[IO]:
    return after_rewound(DebuggerHostEffects::virtual_file_try_reopen(1))

def after_rewound(value: i64) -> i64 can[IO]:
    return after_reread(DebuggerHostEffects::virtual_file_try_read_byte(1))

def after_reread(value: i64) -> i64 can[IO]:
    if value == 65:
        return DebuggerHostEffects::virtual_file_try_read_byte(1)
    else:
        return 0
