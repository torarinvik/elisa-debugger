module DebuggerHostEffects:
    extern virtual_file_read_byte(handle: i64) -> i64 can[IO]
    extern virtual_file_write_byte(handle: i64, value: i64) -> i64 can[IO]
    extern virtual_file_seek(handle: i64, offset: i64) -> i64 can[IO]

def main() -> i64 can[IO]:
    return after_write(DebuggerHostEffects::virtual_file_write_byte(1, 90))

def after_write(transferred: i64) -> i64 can[IO]:
    return after_seek(DebuggerHostEffects::virtual_file_seek(1, 0))

def after_seek(offset: i64) -> i64 can[IO]:
    return after_read(DebuggerHostEffects::virtual_file_read_byte(1))

def after_read(value: i64) -> i64 can[IO]:
    if value == 90:
        return after_end(DebuggerHostEffects::virtual_file_seek(1, 1))
    else:
        return 0

def after_end(offset: i64) -> i64 can[IO]:
    return after_append(DebuggerHostEffects::virtual_file_write_byte(1, 255))

def after_append(transferred: i64) -> i64 can[IO]:
    return after_backseek(DebuggerHostEffects::virtual_file_seek(1, 0))

def after_backseek(offset: i64) -> i64 can[IO]:
    return after_second_read(DebuggerHostEffects::virtual_file_read_byte(1))

def after_second_read(value: i64) -> i64 can[IO]:
    if value == 90:
        return after_last_read(DebuggerHostEffects::virtual_file_read_byte(1))
    else:
        return 0

def after_last_read(value: i64) -> i64 can[IO]:
    if value == 255:
        return DebuggerHostEffects::virtual_file_read_byte(1)
    else:
        return 0
