module DebuggerHostEffects:
    extern virtual_file_try_read_byte(handle: i64) -> i64 can[IO]
    extern virtual_file_try_write_byte(handle: i64, value: i64) -> i64 can[IO]
    extern virtual_file_try_seek(handle: i64, offset: i64) -> i64 can[IO]

def main() -> i64 can[IO]:
    return after_denied(DebuggerHostEffects::virtual_file_try_write_byte(1, 90))

def after_denied(value: i64) -> i64 can[IO]:
    if value == -3:
        return after_invalid_read(DebuggerHostEffects::virtual_file_try_read_byte(7))
    else:
        return 0

def after_invalid_read(value: i64) -> i64 can[IO]:
    if value == -2:
        return after_invalid_write(DebuggerHostEffects::virtual_file_try_write_byte(7, 90))
    else:
        return 0

def after_invalid_write(value: i64) -> i64 can[IO]:
    if value == -2:
        return after_invalid_seek(DebuggerHostEffects::virtual_file_try_seek(7, 0))
    else:
        return 0

def after_invalid_seek(value: i64) -> i64 can[IO]:
    if value == -2:
        return after_bad_offset(DebuggerHostEffects::virtual_file_try_seek(1, 2))
    else:
        return 0

def after_bad_offset(value: i64) -> i64 can[IO]:
    if value == -4:
        return after_read(DebuggerHostEffects::virtual_file_try_read_byte(1))
    else:
        return 0

def after_read(value: i64) -> i64 can[IO]:
    if value == 65:
        return after_eof(DebuggerHostEffects::virtual_file_try_read_byte(1))
    else:
        return 0

def after_eof(value: i64) -> i64 can[IO]:
    if value == -1:
        return after_rewind(DebuggerHostEffects::virtual_file_try_seek(1, 0))
    else:
        return 0

def after_rewind(value: i64) -> i64 can[IO]:
    if value == 0:
        return after_reread(DebuggerHostEffects::virtual_file_try_read_byte(1))
    else:
        return 0

def after_reread(value: i64) -> i64 can[IO]:
    if value == 65:
        return DebuggerHostEffects::virtual_file_try_read_byte(1)
    else:
        return 0
