include "../src/concurrency/runtime.elisa"
include "../src/concurrency/checkpoint.elisa"

const module Test:
    ROOT_TASK_ID: u64 = 0
    FIRST_TASK_ID: u64 = 1
    SECOND_TASK_ID: u64 = 2
    OWNER_TASK_INDEX: usize = 0
    WAITER_TASK_INDEX: usize = 1
    FIRST_RESOURCE_ID: u64 = 100
    WRONG_RESOURCE_ID: u64 = 101
    FIRST_SCHEDULE_INDEX: usize = 0
    SECOND_SCHEDULE_INDEX: usize = 1
    ONE_SCHEDULE_DECISION: usize = 1
    TWO_SCHEDULE_DECISIONS: usize = 2
    FIRST_WAIT_RESULT: i64 = 1
    SECOND_WAIT_RESULT: i64 = 2
    WAIT_RECORD_RESULT: i64 = 3
    WAIT_CHECKPOINT_RESULT: i64 = 4
    RESTORE_BLOCKED_RESULT: i64 = 5
    WAKE_RECORD_RESULT: i64 = 6
    WAKE_CHECKPOINT_RESULT: i64 = 7
    REPLAY_WAIT_RESULT: i64 = 8
    REPLAY_WAKE_RESULT: i64 = 9
    REPLAY_EXACT_RESULT: i64 = 10
    WAIT_DIVERGENCE_RESULT: i64 = 11
    WAKE_DIVERGENCE_RESULT: i64 = 12
    INVALID_WAKE_STATE_RESULT: i64 = 13
    POST_DIVERGENCE_SPAWN_RESULT: i64 = 14
    PORTABLE_OS_THREAD_RESULT: i64 = 15
    REMAPPED_OS_THREAD: u64 = 99
    EXPECTED_TASK_COUNT_AFTER_DIVERGENCE: usize = 1


def runtime_with_running_owner_and_waiter(runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime&, replaying: bool) -> void:
    DebuggerConcurrencyRuntime::runtime_initialize(runtime, replaying)
    owner: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(Test::ROOT_TASK_ID))
    waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(Test::ROOT_TASK_ID))
    _ = DebuggerConcurrencyRuntime::runtime_transition(runtime, owner, DebuggerConcurrency::TaskState.Running)
    _ = DebuggerConcurrencyRuntime::runtime_transition(runtime, waiter, DebuggerConcurrency::TaskState.Running)

def main() -> i64:
    recorded: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    runtime_with_running_owner_and_waiter(recorded, false)
    owner: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::FIRST_TASK_ID)
    waiter: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::SECOND_TASK_ID)
    resource: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::FIRST_RESOURCE_ID)
    return Test::FIRST_WAIT_RESULT if not DebuggerConcurrencyRuntime::runtime_wait(recorded, waiter, owner, resource, DebuggerConcurrency::SynchronizationKind.Mutex)
    return Test::WAIT_RECORD_RESULT if recorded.scheduler.count != Test::ONE_SCHEDULE_DECISION or recorded.scheduler.decisions[Test::FIRST_SCHEDULE_INDEX].kind != DebuggerScheduler::ScheduleKind.Wait or recorded.scheduler.decisions[Test::FIRST_SCHEDULE_INDEX].task.id.value != waiter.value or recorded.scheduler.decisions[Test::FIRST_SCHEDULE_INDEX].task.state != DebuggerConcurrency::TaskState.Running or recorded.scheduler.decisions[Test::FIRST_SCHEDULE_INDEX].synchronization != resource.value

    blocked_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(recorded)
    return Test::WAIT_CHECKPOINT_RESULT if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(blocked_snapshot)
    restored_blocked: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    DebuggerConcurrencyRuntime::runtime_initialize(restored_blocked, false)
    DebuggerConcurrencyCheckpoint::task_snapshot_restore(restored_blocked, blocked_snapshot)
    return Test::RESTORE_BLOCKED_RESULT if not DebuggerConcurrencyCheckpoint::task_snapshot_matches(restored_blocked, blocked_snapshot) or restored_blocked.tasks[Test::OWNER_TASK_INDEX].state != DebuggerConcurrency::TaskState.Running or restored_blocked.tasks[Test::WAITER_TASK_INDEX].state != DebuggerConcurrency::TaskState.Blocked or restored_blocked.wait_count != Test::ONE_SCHEDULE_DECISION
    # OS thread IDs are observational host attributes; restoring the same
    # logical task state on another host may assign different IDs.
    restored_blocked.tasks[Test::OWNER_TASK_INDEX].os_thread <- Test::REMAPPED_OS_THREAD
    return Test::PORTABLE_OS_THREAD_RESULT if not DebuggerConcurrencyCheckpoint::task_snapshot_matches(restored_blocked, blocked_snapshot)

    return Test::SECOND_WAIT_RESULT if not DebuggerConcurrencyRuntime::runtime_wake(recorded, waiter)
    return Test::WAKE_RECORD_RESULT if recorded.scheduler.count != Test::TWO_SCHEDULE_DECISIONS or recorded.scheduler.decisions[Test::SECOND_SCHEDULE_INDEX].kind != DebuggerScheduler::ScheduleKind.Wake or recorded.scheduler.decisions[Test::SECOND_SCHEDULE_INDEX].task.id.value != waiter.value or recorded.scheduler.decisions[Test::SECOND_SCHEDULE_INDEX].task.state != DebuggerConcurrency::TaskState.Blocked or recorded.scheduler.decisions[Test::SECOND_SCHEDULE_INDEX].synchronization != resource.value
    return Test::REPLAY_EXACT_RESULT if not DebuggerScheduler::scheduler_is_exact(recorded.scheduler) or recorded.scheduler.cursor != 0
    wake_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(recorded)
    return Test::WAKE_CHECKPOINT_RESULT if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(wake_snapshot)
    invalid_wake_state: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = wake_snapshot
    invalid_wake_state.scheduler_decisions[Test::SECOND_SCHEDULE_INDEX].task.state <- DebuggerConcurrency::TaskState.Running
    return Test::INVALID_WAKE_STATE_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_wake_state)

    replayed: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    runtime_with_running_owner_and_waiter(replayed, true)
    replayed.scheduler.count <- recorded.scheduler.count
    replayed.scheduler.decisions <- recorded.scheduler.decisions
    return Test::REPLAY_WAIT_RESULT if not DebuggerConcurrencyRuntime::runtime_wait(replayed, waiter, owner, resource, DebuggerConcurrency::SynchronizationKind.Mutex)
    return Test::REPLAY_WAKE_RESULT if not DebuggerConcurrencyRuntime::runtime_wake(replayed, waiter)
    return Test::REPLAY_EXACT_RESULT if replayed.scheduler.cursor != recorded.scheduler.count or not DebuggerScheduler::scheduler_is_exact(replayed.scheduler) or not DebuggerConcurrencyRuntime::runtime_is_valid(replayed)
    replayed_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(replayed)
    return Test::WAKE_CHECKPOINT_RESULT if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(replayed_snapshot)

    wrong_wait: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    runtime_with_running_owner_and_waiter(wrong_wait, true)
    wrong_wait.scheduler.count <- recorded.scheduler.count
    wrong_wait.scheduler.decisions <- recorded.scheduler.decisions
    return Test::WAIT_DIVERGENCE_RESULT if DebuggerConcurrencyRuntime::runtime_wait(wrong_wait, waiter, owner, DebuggerIdentity::debug_id(Test::WRONG_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex) or not wrong_wait.scheduler.diverged or wrong_wait.status != DebuggerConcurrencyRuntime::RuntimeStatus.Diverged or wrong_wait.wait_count != 0 or wrong_wait.tasks[Test::WAITER_TASK_INDEX].state != DebuggerConcurrency::TaskState.Running

    wrong_wake: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    runtime_with_running_owner_and_waiter(wrong_wake, true)
    wrong_wake.scheduler.count <- recorded.scheduler.count
    wrong_wake.scheduler.decisions <- recorded.scheduler.decisions
    return Test::WAKE_DIVERGENCE_RESULT if not DebuggerConcurrencyRuntime::runtime_wait(wrong_wake, waiter, owner, resource, DebuggerConcurrency::SynchronizationKind.Mutex)
    wrong_wake.scheduler.decisions[Test::SECOND_SCHEDULE_INDEX].synchronization <- Test::WRONG_RESOURCE_ID
    return Test::WAKE_DIVERGENCE_RESULT if DebuggerConcurrencyRuntime::runtime_wake(wrong_wake, waiter) or not wrong_wake.scheduler.diverged or wrong_wake.status != DebuggerConcurrencyRuntime::RuntimeStatus.Diverged or wrong_wake.wait_count != Test::ONE_SCHEDULE_DECISION or wrong_wake.tasks[Test::WAITER_TASK_INDEX].state != DebuggerConcurrency::TaskState.Blocked

    post_divergence_spawn: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    DebuggerConcurrencyRuntime::runtime_initialize(post_divergence_spawn, true)
    first_divergence_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(post_divergence_spawn, DebuggerIdentity::debug_id(Test::ROOT_TASK_ID))
    _ = DebuggerConcurrencyRuntime::runtime_schedule(post_divergence_spawn, first_divergence_task, DebuggerScheduler::ScheduleKind.Run, DebuggerIdentity::debug_id(Test::ROOT_TASK_ID))
    rejected_spawn: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(post_divergence_spawn, DebuggerIdentity::debug_id(Test::ROOT_TASK_ID))
    return Test::POST_DIVERGENCE_SPAWN_RESULT if rejected_spawn.value != Test::ROOT_TASK_ID or post_divergence_spawn.task_count != Test::EXPECTED_TASK_COUNT_AFTER_DIVERGENCE or not post_divergence_spawn.scheduler.diverged
    return 0
