include "../src/engine/coordinator.elisa"
include "../src/core/identity.elisa"
include "../src/core/capabilities.elisa"
include "../src/core/cancellation.elisa"

const module Test:
    SESSION_ID: u64 = 1
    REQUEST_ID: u64 = 2
    STALE_GENERATION: u64 = 9
    NO_ACTIVE_REQUEST: u64 = 0
    UNSUPPORTED_INSPECTION_RESULT: i64 = 5


def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    session.state <- DebuggerSession::SessionState.Stopped
    coordinator: DebuggerCoordinator::Coordinator = DebuggerCoordinator::coordinator_new(session)
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
    expired_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(1)
    expired: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_seek(coordinator, Test::REQUEST_ID, 0, 0, expired_token)
    return 7 if expired.accepted or expired.failure.code != DebuggerErrors::ErrorCode.Cancelled or not DebuggerCoordinator::coordinator_is_idle(expired.coordinator)
    seek: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_seek(coordinator, Test::REQUEST_ID, 0, 0, token)
    return 1 if not seek.accepted or not DebuggerCoordinator::coordinator_is_idle(seek.coordinator) or seek.coordinator.active_request != Test::NO_ACTIVE_REQUEST or not DebuggerErrors::error_is_ok(seek.coordinator.last_error)
    stale: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_seek(seek.coordinator, Test::REQUEST_ID, Test::STALE_GENERATION, 0, token)
    return 2 if stale.accepted or stale.failure.code != DebuggerErrors::ErrorCode.StaleGeneration or stale.coordinator.active_request != Test::NO_ACTIVE_REQUEST
    busy: mutable DebuggerCoordinator::Coordinator = seek.coordinator
    busy.busy <- true
    cancelled: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_cancel(busy, Test::REQUEST_ID)
    return 3 if cancelled.accepted or cancelled.failure.code != DebuggerErrors::ErrorCode.Cancelled or not DebuggerCoordinator::coordinator_is_idle(cancelled.coordinator)
    busy.busy <- true
    busy.active_request <- Test::REQUEST_ID + 1
    mismatched_cancel: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_cancel(busy, Test::REQUEST_ID)
    return 6 if mismatched_cancel.accepted or mismatched_cancel.failure.code != DebuggerErrors::ErrorCode.InvalidArgument or not mismatched_cancel.coordinator.busy
    busy.busy <- true
    busy.active_request <- Test::NO_ACTIVE_REQUEST
    cancelled_via_operation: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(busy, Test::REQUEST_ID, DebuggerCoordinator::Operation.Cancel, 0, token)
    return 4 if cancelled_via_operation.accepted or cancelled_via_operation.failure.code != DebuggerErrors::ErrorCode.Cancelled or not DebuggerCoordinator::coordinator_is_idle(cancelled_via_operation.coordinator)
    failed_pause: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(coordinator, Test::REQUEST_ID, DebuggerCoordinator::Operation.Pause, 0, token)
    inspected: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(failed_pause.coordinator, Test::REQUEST_ID, DebuggerCoordinator::Operation.Stack, 0, token)
    return Test::UNSUPPORTED_INSPECTION_RESULT if failed_pause.accepted or inspected.accepted or inspected.failure.code != DebuggerErrors::ErrorCode.Unsupported or inspected.coordinator.session.last_error != DebuggerSession::SessionError.None
    return 0
