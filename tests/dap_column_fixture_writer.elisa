# Emits an EDIR fixture with two executable source spans on the same line.
# The coordinates are deliberately ASCII-compatible zero-based editor units so
# the adapter's protocol conversion can be checked independently of compiler
# producer normalization.

extern write(fd: int, buf: void&, count: usize) -> isize can[Blocking.IO]

include "../src/vm/edir_codec.elisa"

const module DapColumnFixture:
    DAP_COLUMN_FIXTURE_STDOUT_FD: int = 1
    DAP_COLUMN_FIXTURE_PROGRAM_VERSION: u32 = 1
    DAP_COLUMN_FIXTURE_INSTRUCTION_COUNT: u64 = 2
    DAP_COLUMN_FIXTURE_SOURCE_FILE_ID: u64 = 7
    DAP_COLUMN_FIXTURE_SOURCE_LOGICAL_PATH_ID: u64 = 7001
    DAP_COLUMN_FIXTURE_SOURCE_CONTENT_DIGEST: u64 = 7002
    DAP_COLUMN_FIXTURE_SOURCE_LINE_COUNT: u64 = 50
    DAP_COLUMN_FIXTURE_SOURCE_PATH_LENGTH: usize = 10
    DAP_COLUMN_FIXTURE_SOURCE_PATH: cstr = "main.elisa"
    DAP_COLUMN_FIXTURE_SOURCE_FILE_COUNT: usize = 1
    DAP_COLUMN_FIXTURE_SOURCE_FILE_INDEX: usize = 0
    DAP_COLUMN_FIXTURE_FIRST_BUFFER_INDEX: usize = 0
    DAP_COLUMN_FIXTURE_FIRST_INSTRUCTION_INDEX: usize = 0
    DAP_COLUMN_FIXTURE_SECOND_INSTRUCTION_INDEX: usize = 1
    DAP_COLUMN_FIXTURE_FIRST_LINE: u32 = 41
    DAP_COLUMN_FIXTURE_FIRST_START_COLUMN: u32 = 3
    DAP_COLUMN_FIXTURE_FIRST_END_COLUMN: u32 = 4
    DAP_COLUMN_FIXTURE_SECOND_START_COLUMN: u32 = 8
    DAP_COLUMN_FIXTURE_SECOND_END_COLUMN: u32 = 9
    DAP_COLUMN_FIXTURE_FIRST_START_BYTE: u64 = 0
    DAP_COLUMN_FIXTURE_FIRST_END_BYTE: u64 = 1
    DAP_COLUMN_FIXTURE_SECOND_START_BYTE: u64 = 1
    DAP_COLUMN_FIXTURE_SECOND_END_BYTE: u64 = 2
    DAP_COLUMN_FIXTURE_NO_DISCRIMINATOR: u32 = 0
    DAP_COLUMN_FIXTURE_NO_LOCAL_COUNT: u64 = 0
    DAP_COLUMN_FIXTURE_CONSTANT_VALUE: i64 = 17
    DAP_COLUMN_FIXTURE_UNUSED_OPERAND: i64 = 0
    DAP_COLUMN_FIXTURE_WRITE_NO_PROGRESS: isize = 0
    DAP_COLUMN_FIXTURE_ENCODING_FAILURE: i64 = 1
    DAP_COLUMN_FIXTURE_WRITE_FAILURE: i64 = 2
    DAP_COLUMN_FIXTURE_SUCCESS: i64 = 0

def dap_column_fixture_span(start_byte: u64, end_byte: u64, start_column: u32, end_column: u32) -> DebuggerIdentity::SourceSpan:
    return DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_FILE_ID),
        start_byte: start_byte,
        end_byte: end_byte,
        start_line: DapColumnFixture::DAP_COLUMN_FIXTURE_FIRST_LINE,
        start_column: start_column,
        end_line: DapColumnFixture::DAP_COLUMN_FIXTURE_FIRST_LINE,
        end_column: end_column,
        discriminator: DapColumnFixture::DAP_COLUMN_FIXTURE_NO_DISCRIMINATOR
    }

def dap_column_fixture_write_all(bytes: u8&, length: usize) -> bool can[Blocking.IO, Unsafe.PointerCast]:
    offset: mutable usize = 0
    while offset < length:
        written: isize = write(DapColumnFixture::DAP_COLUMN_FIXTURE_STDOUT_FD, (&bytes[offset]).cast[void&], length - offset) can Blocking.IO, Unsafe.PointerCast
        return false if written <= DapColumnFixture::DAP_COLUMN_FIXTURE_WRITE_NO_PROGRESS
        return false if written.usize() > length - offset
        offset <- offset + written.usize()
    return true

def main() -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: DapColumnFixture::DAP_COLUMN_FIXTURE_PROGRAM_VERSION, instruction_count: DapColumnFixture::DAP_COLUMN_FIXTURE_INSTRUCTION_COUNT, local_count: DapColumnFixture::DAP_COLUMN_FIXTURE_NO_LOCAL_COUNT, has_return: true}
    image.source_file_count <- DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_FILE_COUNT
    source_file: mutable DebuggerMetadata::SourceFile = zeroed
    source_file.id <- DebuggerIdentity::debug_id(DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_FILE_ID)
    source_file.logical_path <- DebuggerIdentity::debug_id(DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_LOGICAL_PATH_ID)
    source_file.content <- DebuggerIdentity::debug_id(DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_CONTENT_DIGEST)
    source_file.line_count <- DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_LINE_COUNT
    source_file.path_length <- DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_PATH_LENGTH
    for path_index in 0..<DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_PATH_LENGTH:
        source_file.path_bytes[path_index] <- DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_PATH.cast[u8&][path_index]
    image.source_files[DapColumnFixture::DAP_COLUMN_FIXTURE_SOURCE_FILE_INDEX] <- source_file
    image.instructions[DapColumnFixture::DAP_COLUMN_FIXTURE_FIRST_INSTRUCTION_INDEX] <- DebuggerEDIR::Instruction{
        opcode: DebuggerEDIR::Opcode.Constant,
        a: DapColumnFixture::DAP_COLUMN_FIXTURE_CONSTANT_VALUE,
        b: DapColumnFixture::DAP_COLUMN_FIXTURE_UNUSED_OPERAND,
        source: dap_column_fixture_span(DapColumnFixture::DAP_COLUMN_FIXTURE_FIRST_START_BYTE, DapColumnFixture::DAP_COLUMN_FIXTURE_FIRST_END_BYTE, DapColumnFixture::DAP_COLUMN_FIXTURE_FIRST_START_COLUMN, DapColumnFixture::DAP_COLUMN_FIXTURE_FIRST_END_COLUMN)
    }
    image.instructions[DapColumnFixture::DAP_COLUMN_FIXTURE_SECOND_INSTRUCTION_INDEX] <- DebuggerEDIR::Instruction{
        opcode: DebuggerEDIR::Opcode.Return,
        a: DapColumnFixture::DAP_COLUMN_FIXTURE_UNUSED_OPERAND,
        b: DapColumnFixture::DAP_COLUMN_FIXTURE_UNUSED_OPERAND,
        source: dap_column_fixture_span(DapColumnFixture::DAP_COLUMN_FIXTURE_SECOND_START_BYTE, DapColumnFixture::DAP_COLUMN_FIXTURE_SECOND_END_BYTE, DapColumnFixture::DAP_COLUMN_FIXTURE_SECOND_START_COLUMN, DapColumnFixture::DAP_COLUMN_FIXTURE_SECOND_END_COLUMN)
    }
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(image)
    return DapColumnFixture::DAP_COLUMN_FIXTURE_ENCODING_FAILURE if not DebuggerTraceBinary::writer_is_valid(encoded)
    return DapColumnFixture::DAP_COLUMN_FIXTURE_WRITE_FAILURE if not dap_column_fixture_write_all(encoded.bytes[DapColumnFixture::DAP_COLUMN_FIXTURE_FIRST_BUFFER_INDEX], encoded.length) can Blocking.IO, Unsafe.PointerCast
    return DapColumnFixture::DAP_COLUMN_FIXTURE_SUCCESS
