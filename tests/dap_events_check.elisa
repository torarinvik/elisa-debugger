include "../src/protocol/dap.elisa"

const module Test:
    const module Failure:
        SUCCESS: i64 = 0
        INITIALIZE: i64 = 1
        LAUNCH: i64 = 2
        PAUSE: i64 = 3
        STEP: i64 = 4
        CONTINUE_BREAKPOINT: i64 = 5
        CONTINUE_EXIT: i64 = 6
        TERMINATE: i64 = 7
        FAILED_REQUEST: i64 = 8
        OTHER_REQUEST: i64 = 9
        HOST_EFFECT_YIELD: i64 = 10

    const module EventCount:
        NONE: usize = 0
        ONE: usize = 1
        CONTINUE_AND_STOP: usize = 2
        TERMINAL_SEQUENCE: usize = 3

    const module EventIndex:
        FIRST: usize = 0
        SECOND: usize = 1
        THIRD: usize = 2

    const module ProcessExit:
        NONE: i64 = 0
        EXPECTED: i64 = 42


def main() -> i64:
    initialized: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Initialize, true, false, DebuggerSession::SessionState.Created, false, false, Test::ProcessExit::NONE)
    return Test::Failure::INITIALIZE if initialized.count != Test::EventCount::NONE

    launched: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Launch, true, false, DebuggerSession::SessionState.Running, false, false, Test::ProcessExit::NONE)
    return Test::Failure::LAUNCH if launched.count != Test::EventCount::ONE or launched.events[Test::EventIndex::FIRST].kind != DebuggerDAP::EventKind.Initialized

    rejected_launch: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Launch, false, false, DebuggerSession::SessionState.Created, false, false, Test::ProcessExit::NONE)
    return Test::Failure::FAILED_REQUEST if rejected_launch.count != Test::EventCount::NONE

    paused: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Pause, true, false, DebuggerSession::SessionState.Stopped, false, false, Test::ProcessExit::NONE)
    return Test::Failure::PAUSE if paused.count != Test::EventCount::ONE or paused.events[Test::EventIndex::FIRST].kind != DebuggerDAP::EventKind.Stopped or paused.events[Test::EventIndex::FIRST].reason != DebuggerDAP::StopReason.Pause

    stepped: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Step, true, false, DebuggerSession::SessionState.Stopped, false, false, Test::ProcessExit::NONE)
    return Test::Failure::STEP if stepped.count != Test::EventCount::ONE or stepped.events[Test::EventIndex::FIRST].kind != DebuggerDAP::EventKind.Stopped or stepped.events[Test::EventIndex::FIRST].reason != DebuggerDAP::StopReason.Step

    continued_to_breakpoint: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Continue, true, false, DebuggerSession::SessionState.Stopped, false, false, Test::ProcessExit::NONE)
    return Test::Failure::CONTINUE_BREAKPOINT if continued_to_breakpoint.count != Test::EventCount::CONTINUE_AND_STOP or continued_to_breakpoint.events[Test::EventIndex::FIRST].kind != DebuggerDAP::EventKind.Continued or continued_to_breakpoint.events[Test::EventIndex::SECOND].kind != DebuggerDAP::EventKind.Stopped or continued_to_breakpoint.events[Test::EventIndex::SECOND].reason != DebuggerDAP::StopReason.Breakpoint

    host_effect_yield: DebuggerDAP::EventBatch = DebuggerDAP::events_after_host_effect_request(true, DebuggerSession::SessionState.Stopped, false, false, Test::ProcessExit::NONE)
    return Test::Failure::HOST_EFFECT_YIELD if host_effect_yield.count != Test::EventCount::CONTINUE_AND_STOP or host_effect_yield.events[Test::EventIndex::FIRST].kind != DebuggerDAP::EventKind.Continued or host_effect_yield.events[Test::EventIndex::SECOND].kind != DebuggerDAP::EventKind.Stopped or host_effect_yield.events[Test::EventIndex::SECOND].reason != DebuggerDAP::StopReason.Pause

    continued_to_exit: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Continue, true, false, DebuggerSession::SessionState.Stopped, true, false, Test::ProcessExit::EXPECTED)
    return Test::Failure::CONTINUE_EXIT if continued_to_exit.count != Test::EventCount::TERMINAL_SEQUENCE or continued_to_exit.events[Test::EventIndex::FIRST].kind != DebuggerDAP::EventKind.Continued or continued_to_exit.events[Test::EventIndex::SECOND].kind != DebuggerDAP::EventKind.Terminated or continued_to_exit.events[Test::EventIndex::THIRD].kind != DebuggerDAP::EventKind.Exited or continued_to_exit.events[Test::EventIndex::THIRD].exit_code != Test::ProcessExit::EXPECTED

    terminated: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Terminate, true, false, DebuggerSession::SessionState.Exited, false, false, Test::ProcessExit::EXPECTED)
    return Test::Failure::TERMINATE if terminated.count != Test::EventCount::CONTINUE_AND_STOP or terminated.events[Test::EventIndex::FIRST].kind != DebuggerDAP::EventKind.Terminated or terminated.events[Test::EventIndex::SECOND].kind != DebuggerDAP::EventKind.Exited

    no_events: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Other, true, false, DebuggerSession::SessionState.Running, false, false, Test::ProcessExit::NONE)
    return Test::Failure::OTHER_REQUEST if no_events.count != Test::EventCount::NONE
    return Test::Failure::SUCCESS
