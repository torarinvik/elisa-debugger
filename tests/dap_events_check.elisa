include "../src/protocol/dap.elisa"

const module Test:
    CHECK_OK: i64 = 0
    CHECK_INITIALIZE: i64 = 1
    CHECK_LAUNCH: i64 = 2
    CHECK_PAUSE: i64 = 3
    CHECK_STEP: i64 = 4
    CHECK_CONTINUE_BREAKPOINT: i64 = 5
    CHECK_CONTINUE_EXIT: i64 = 6
    CHECK_TERMINATE: i64 = 7
    CHECK_FAILED_REQUEST: i64 = 8
    CHECK_OTHER_REQUEST: i64 = 9
    EXPECTED_EXIT_CODE: i64 = 42


def main() -> i64:
    initialized: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Initialize, true, false, DebuggerSession::SessionState.Created, false, false, 0)
    return Test::CHECK_INITIALIZE if initialized.count != 0

    launched: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Launch, true, false, DebuggerSession::SessionState.Running, false, false, 0)
    return Test::CHECK_LAUNCH if launched.count != 1 or launched.events[0].kind != DebuggerDAP::EventKind.Initialized

    rejected_launch: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Launch, false, false, DebuggerSession::SessionState.Created, false, false, 0)
    return Test::CHECK_FAILED_REQUEST if rejected_launch.count != 0

    paused: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Pause, true, false, DebuggerSession::SessionState.Stopped, false, false, 0)
    return Test::CHECK_PAUSE if paused.count != 1 or paused.events[0].kind != DebuggerDAP::EventKind.Stopped or paused.events[0].reason != DebuggerDAP::StopReason.Pause

    stepped: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Step, true, false, DebuggerSession::SessionState.Stopped, false, false, 0)
    return Test::CHECK_STEP if stepped.count != 1 or stepped.events[0].kind != DebuggerDAP::EventKind.Stopped or stepped.events[0].reason != DebuggerDAP::StopReason.Step

    continued_to_breakpoint: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Continue, true, false, DebuggerSession::SessionState.Stopped, false, false, 0)
    return Test::CHECK_CONTINUE_BREAKPOINT if continued_to_breakpoint.count != 2 or continued_to_breakpoint.events[0].kind != DebuggerDAP::EventKind.Continued or continued_to_breakpoint.events[1].kind != DebuggerDAP::EventKind.Stopped or continued_to_breakpoint.events[1].reason != DebuggerDAP::StopReason.Breakpoint

    continued_to_exit: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Continue, true, false, DebuggerSession::SessionState.Stopped, true, false, Test::EXPECTED_EXIT_CODE)
    return Test::CHECK_CONTINUE_EXIT if continued_to_exit.count != 3 or continued_to_exit.events[0].kind != DebuggerDAP::EventKind.Continued or continued_to_exit.events[1].kind != DebuggerDAP::EventKind.Terminated or continued_to_exit.events[2].kind != DebuggerDAP::EventKind.Exited or continued_to_exit.events[2].exit_code != Test::EXPECTED_EXIT_CODE

    terminated: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Terminate, true, false, DebuggerSession::SessionState.Exited, false, false, Test::EXPECTED_EXIT_CODE)
    return Test::CHECK_TERMINATE if terminated.count != 2 or terminated.events[0].kind != DebuggerDAP::EventKind.Terminated or terminated.events[1].kind != DebuggerDAP::EventKind.Exited

    no_events: DebuggerDAP::EventBatch = DebuggerDAP::events_after_request(DebuggerDAP::RequestKind.Other, true, false, DebuggerSession::SessionState.Running, false, false, 0)
    return Test::CHECK_OTHER_REQUEST if no_events.count != 0
    return Test::CHECK_OK
