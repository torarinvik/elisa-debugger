include "../src/protocol/dap_native_variables.elisa"

const module DAPNativeVariablesFixture:
    THREAD: u64 = 700
    INVOCATION: u64 = 701
    FUNCTION: u64 = 702
    CHILD_INVOCATION: u64 = 709
    CHILD_FUNCTION: u64 = 710
    TASK: u64 = 703
    GENERATION: u64 = 9
    SCOPE: u64 = 800
    COUNTER_BINDING: u64 = 901
    BLOB_BINDING: u64 = 902
    GONE_BINDING: u64 = 903
    SECRET_BINDING: u64 = 904
    RETRIES_BINDING: u64 = 905
    UNAVAILABLE_BINDING: u64 = 906
    UNINITIALIZED_BINDING: u64 = 907
    ENABLED_BINDING: u64 = 908
    INTEGER_TYPE: u64 = 1001
    INTEGER_NAME: u64 = 1002
    BLOB_TYPE: u64 = 1003
    BLOB_NAME: u64 = 1004
    BOOLEAN_TYPE: u64 = 1005
    BOOLEAN_NAME: u64 = 1006
    ZERO_ID: u64 = 0
    COUNTER_NAME: cstr = "counter"
    COUNTER_NAME_LENGTH: usize = 7
    GONE_NAME: cstr = "gone"
    GONE_NAME_LENGTH: usize = 4
    SECRET_NAME: cstr = "secret"
    SECRET_NAME_LENGTH: usize = 6
    RETRIES_NAME: cstr = "retries"
    RETRIES_NAME_LENGTH: usize = 7
    ENABLED_NAME: cstr = "enabled"
    ENABLED_NAME_LENGTH: usize = 7
    INTEGER_TYPE_TEXT: cstr = "Int64"
    INTEGER_TYPE_TEXT_LENGTH: usize = 5
    BLOB_TYPE_TEXT: cstr = "Bytes"
    BLOB_TYPE_TEXT_LENGTH: usize = 5
    BOOLEAN_TYPE_TEXT: cstr = "Bool"
    BOOLEAN_TYPE_TEXT_LENGTH: usize = 4
    NEGATIVE_VALUE: i64 = -7
    UNSIGNED_VALUE: u64 = 4294967295
    BLOB_BYTE_COUNT: usize = 3
    FIRST_BYTE: usize = 0
    GENERATION_TIMEOUT: u64 = 1
    DEADLINE: u64 = 2
    GENERATION_STEP: u64 = 1
    NEXT_GENERATION: u64 = GENERATION + GENERATION_STEP
    OTHER_FUNCTION: u64 = 1702
    BOOLEAN_FALSE: bool = false
    STACK_PAGE_FRAME_LIMIT: usize = 1

const module DAPNativeVariablesWidth:
    ONE_BYTE: usize = 1
    FOUR_BYTES: usize = 4
    NONAVAILABLE_VALUE_BYTES: u64 = 4

const module DAPNativeVariablesStorage:
    STACK_OFFSET: i64 = -8
    BLOB_OFFSET: i64 = 24
    UNKNOWN_OFFSET: i64 = 0
    REGISTER_OFFSET: i64 = 1

const module DAPNativeVariablesIndex:
    FIRST: usize = 0
    SECOND: usize = 1
    THIRD: usize = 2

const module DAPNativeVariablesFailure:
    SUCCESS: i64 = 0
    STORE_SETUP: i64 = 1
    TYPE_SETUP: i64 = 2
    STACK_SETUP: i64 = 3
    LOCAL_SETUP: i64 = 4
    SNAPSHOT_SETUP: i64 = 5
    STACK_PROJECTION: i64 = 6
    PAGE_PROJECTION: i64 = 7
    COUNTER_VALUE: i64 = 8
    BLOB_VALUE: i64 = 9
    GONE_VALUE: i64 = 10
    NEXT_PAGE_VALUE: i64 = 11
    THIRD_PAGE_VALUE: i64 = 12
    STALE_GENERATION_ACCEPTED: i64 = 13
    WRONG_FRAME_ACCEPTED: i64 = 14
    CORRUPT_RANGE_ACCEPTED: i64 = 15
    CORRUPT_NAME_STORE_ACCEPTED: i64 = 16
    CORRUPT_TYPE_STORE_ACCEPTED: i64 = 17
    CORRUPT_DUPLICATE_TYPE_ACCEPTED: i64 = 18
    CORRUPT_DUPLICATE_BINDING_ACCEPTED: i64 = 19
    CORRUPT_BOOLEAN_ACCEPTED: i64 = 20
    INVALID_STATE_ACCEPTED: i64 = 21
    CORRUPT_DESCRIPTOR_ACCEPTED: i64 = 22
    REFERENCE_RESOLUTION: i64 = 23
    STALE_REFERENCE_ACCEPTED: i64 = 24
    OUT_OF_PAGE_REFERENCE_ACCEPTED: i64 = 25

const module DAPNativeVariablesPage:
    FIRST: usize = 0
    SECOND: usize = 1
    THIRD: usize = 2
    FOURTH: usize = 3
    FIRST_PAGE_LIMIT: usize = 3
    FIRST_PAGE_COUNT: usize = 3
    SECOND_PAGE_START: usize = 3
    SECOND_PAGE_LIMIT: usize = 2
    SECOND_PAGE_COUNT: usize = 2
    THIRD_PAGE_START: usize = 5
    THIRD_PAGE_LIMIT: usize = 3
    THIRD_PAGE_COUNT: usize = 3
    TOTAL_BINDINGS: usize = 8
    TOTAL_STACK_FRAMES: usize = 2
    EMPTY: usize = 0
    NO_EVENT: u64 = 0
    GENERATION_INCREMENT: u64 = 1
    TYPE_COUNT_INCREMENT: usize = 1
    NAME_COUNT_INCREMENT: usize = 1

const module DAPNativeVariablesExpected:
    COUNTER_TEXT: cstr = "-7"
    COUNTER_TEXT_LENGTH: usize = 2
    COUNTER_RAW: u8 = 249
    FALLBACK_BLOB_NAME: cstr = "binding#902"
    FALLBACK_BLOB_NAME_LENGTH: usize = 11
    UNSUPPORTED_TEXT: cstr = "<unsupported>"
    UNSUPPORTED_TEXT_LENGTH: usize = 13
    OPTIMIZED_AWAY_TEXT: cstr = "<optimized away>"
    OPTIMIZED_AWAY_TEXT_LENGTH: usize = 16
    NONAVAILABLE_DECLARED_SIZE: u64 = 8
    REDACTED_TEXT: cstr = "<redacted>"
    REDACTED_TEXT_LENGTH: usize = 10
    MAX_UNSIGNED_TEXT: cstr = "4294967295"
    MAX_UNSIGNED_TEXT_LENGTH: usize = 10
    UNAVAILABLE_TEXT: cstr = "<unavailable>"
    UNAVAILABLE_TEXT_LENGTH: usize = 13
    UNINITIALIZED_TEXT: cstr = "<uninitialized>"
    UNINITIALIZED_TEXT_LENGTH: usize = 15
    FALSE_TEXT: cstr = "false"
    FALSE_TEXT_LENGTH: usize = 5
    BLOB_BYTES_FIRST: u8 = 17
    BLOB_BYTES_SECOND: u8 = 34
    BLOB_BYTES_THIRD: u8 = 51
    INVALID_BOOLEAN_BYTE: u8 = 2

def debug_id(value: u64) -> DebuggerIdentity::DebugId:
    return DebuggerIdentity::debug_id(value)

def text_matches(actual: u8&, actual_length: usize, expected: cstr, expected_length: usize) -> bool:
    return false if actual_length != expected_length
    for index in DAPNativeVariablesPage::FIRST..<expected_length:
        return false if actual[index] != expected[index].u8()
    return true

def metadata_type(identifier: u64, name_identifier: u64, kind: DebuggerTypeMetadata::TypeKind) -> DebuggerTypeMetadata::TypeInfo:
    return DebuggerTypeMetadata::TypeInfo{id: debug_id(identifier), kind: kind, name: debug_id(name_identifier), size: DAPNativeVariablesPage::NO_EVENT, alignment: DAPNativeVariablesPage::NO_EVENT, child_count: DAPNativeVariablesPage::NO_EVENT, pointee: debug_id(DAPNativeVariablesFixture::ZERO_ID), flags: DAPNativeVariablesPage::EMPTY.u32()}

def variables_reference_is_valid(page: DebuggerDAPNativeVariables::VariablesPage&, frame: DebuggerDAPNativeFrames::NativeFrameView&) -> bool:
    expected_reference: u64 = DebuggerDAPFrames::variables_reference_encode(frame.generation, frame.stack_index)
    return page.frame_id == frame.id and page.variables_reference == expected_reference and expected_reference != DAPNativeVariablesFixture::ZERO_ID

def main() -> i64:
    source_store: mutable DebuggerSourceStore::SourceStore = DebuggerSourceStore::source_store_new()
    names: mutable DebuggerMetadataNames::NameStore = zeroed
    DebuggerMetadataNames::name_store_initialize(names)
    added_name: mutable DebuggerErrors::DebuggerError = DebuggerMetadataNames::name_store_add(names, debug_id(DAPNativeVariablesFixture::COUNTER_BINDING), DAPNativeVariablesFixture::COUNTER_NAME.cast[u8&], DAPNativeVariablesFixture::COUNTER_NAME_LENGTH)
    return DAPNativeVariablesFailure::STORE_SETUP if not DebuggerErrors::error_is_ok(added_name)
    added_name <- DebuggerMetadataNames::name_store_add(names, debug_id(DAPNativeVariablesFixture::GONE_BINDING), DAPNativeVariablesFixture::GONE_NAME.cast[u8&], DAPNativeVariablesFixture::GONE_NAME_LENGTH)
    return DAPNativeVariablesFailure::STORE_SETUP if not DebuggerErrors::error_is_ok(added_name)
    added_name <- DebuggerMetadataNames::name_store_add(names, debug_id(DAPNativeVariablesFixture::SECRET_BINDING), DAPNativeVariablesFixture::SECRET_NAME.cast[u8&], DAPNativeVariablesFixture::SECRET_NAME_LENGTH)
    return DAPNativeVariablesFailure::STORE_SETUP if not DebuggerErrors::error_is_ok(added_name)
    added_name <- DebuggerMetadataNames::name_store_add(names, debug_id(DAPNativeVariablesFixture::RETRIES_BINDING), DAPNativeVariablesFixture::RETRIES_NAME.cast[u8&], DAPNativeVariablesFixture::RETRIES_NAME_LENGTH)
    return DAPNativeVariablesFailure::STORE_SETUP if not DebuggerErrors::error_is_ok(added_name)
    added_name <- DebuggerMetadataNames::name_store_add(names, debug_id(DAPNativeVariablesFixture::INTEGER_NAME), DAPNativeVariablesFixture::INTEGER_TYPE_TEXT.cast[u8&], DAPNativeVariablesFixture::INTEGER_TYPE_TEXT_LENGTH)
    return DAPNativeVariablesFailure::STORE_SETUP if not DebuggerErrors::error_is_ok(added_name)
    added_name <- DebuggerMetadataNames::name_store_add(names, debug_id(DAPNativeVariablesFixture::BLOB_NAME), DAPNativeVariablesFixture::BLOB_TYPE_TEXT.cast[u8&], DAPNativeVariablesFixture::BLOB_TYPE_TEXT_LENGTH)
    return DAPNativeVariablesFailure::STORE_SETUP if not DebuggerErrors::error_is_ok(added_name)
    added_name <- DebuggerMetadataNames::name_store_add(names, debug_id(DAPNativeVariablesFixture::BOOLEAN_NAME), DAPNativeVariablesFixture::BOOLEAN_TYPE_TEXT.cast[u8&], DAPNativeVariablesFixture::BOOLEAN_TYPE_TEXT_LENGTH)
    return DAPNativeVariablesFailure::STORE_SETUP if not DebuggerErrors::error_is_ok(added_name)
    added_name <- DebuggerMetadataNames::name_store_add(names, debug_id(DAPNativeVariablesFixture::ENABLED_BINDING), DAPNativeVariablesFixture::ENABLED_NAME.cast[u8&], DAPNativeVariablesFixture::ENABLED_NAME_LENGTH)
    return DAPNativeVariablesFailure::STORE_SETUP if not DebuggerErrors::error_is_ok(added_name)

    type_store: mutable DebuggerTypeMetadata::MetadataStore = zeroed
    DebuggerTypeMetadata::metadata_initialize(type_store)
    return DAPNativeVariablesFailure::TYPE_SETUP if not DebuggerTypeMetadata::metadata_add_type(type_store, metadata_type(DAPNativeVariablesFixture::INTEGER_TYPE, DAPNativeVariablesFixture::INTEGER_NAME, DebuggerTypeMetadata::TypeKind.Scalar))
    return DAPNativeVariablesFailure::TYPE_SETUP if not DebuggerTypeMetadata::metadata_add_type(type_store, metadata_type(DAPNativeVariablesFixture::BLOB_TYPE, DAPNativeVariablesFixture::BLOB_NAME, DebuggerTypeMetadata::TypeKind.Struct))
    return DAPNativeVariablesFailure::TYPE_SETUP if not DebuggerTypeMetadata::metadata_add_type(type_store, metadata_type(DAPNativeVariablesFixture::BOOLEAN_TYPE, DAPNativeVariablesFixture::BOOLEAN_NAME, DebuggerTypeMetadata::TypeKind.Scalar))

    shadow_stack: mutable DebuggerAgentFrames::AgentShadowStack = zeroed
    return DAPNativeVariablesFailure::STACK_SETUP if DebuggerAgentFrames::agent_shadow_stack_initialize(shadow_stack, debug_id(DAPNativeVariablesFixture::THREAD)) != DebuggerAgentFrames::ShadowStatus.Ready
    return DAPNativeVariablesFailure::STACK_SETUP if DebuggerAgentFrames::agent_shadow_frame_push(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::ZERO_ID), debug_id(DAPNativeVariablesFixture::FUNCTION), debug_id(DAPNativeVariablesFixture::TASK), debug_id(DAPNativeVariablesFixture::ZERO_ID), DAPNativeVariablesPage::EMPTY.u32(), DAPNativeVariablesPage::EMPTY.u32()) != DebuggerAgentFrames::ShadowStatus.Ready
    return DAPNativeVariablesFailure::STACK_SETUP if DebuggerAgentFrames::agent_shadow_frame_push(shadow_stack, debug_id(DAPNativeVariablesFixture::CHILD_INVOCATION), debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::CHILD_FUNCTION), debug_id(DAPNativeVariablesFixture::TASK), debug_id(DAPNativeVariablesFixture::ZERO_ID), DAPNativeVariablesPage::EMPTY.u32(), DAPNativeVariablesPage::EMPTY.u32()) != DebuggerAgentFrames::ShadowStatus.Ready

    encoded_counter: DebuggerAgentValueCodec::EncodedScalar = DebuggerAgentValueCodec::agent_scalar_encode_signed(DAPNativeVariablesFixture::NEGATIVE_VALUE, DAPNativeVariablesWidth::ONE_BYTE)
    return DAPNativeVariablesFailure::LOCAL_SETUP if DebuggerAgentValueCodec::agent_shadow_binding_declare_scalar(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::COUNTER_BINDING), debug_id(DAPNativeVariablesFixture::SCOPE), debug_id(DAPNativeVariablesFixture::INTEGER_TYPE), DebuggerAgentFrames::AgentStorageKind.StackSlot, DAPNativeVariablesStorage::STACK_OFFSET, encoded_counter) != DebuggerAgentFrames::ShadowStatus.Ready
    blob_bytes: mutable u8[DebuggerAgentFrames::Capacity::MAX_INLINE_VALUE_BYTES] = zeroed
    blob_bytes[DAPNativeVariablesPage::FIRST] <- DAPNativeVariablesExpected::BLOB_BYTES_FIRST
    blob_bytes[DAPNativeVariablesIndex::SECOND] <- DAPNativeVariablesExpected::BLOB_BYTES_SECOND
    blob_bytes[DAPNativeVariablesIndex::THIRD] <- DAPNativeVariablesExpected::BLOB_BYTES_THIRD
    return DAPNativeVariablesFailure::LOCAL_SETUP if DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::BLOB_BINDING), debug_id(DAPNativeVariablesFixture::SCOPE), debug_id(DAPNativeVariablesFixture::BLOB_TYPE), DebuggerAgentFrames::AgentValueKind.Aggregate, DebuggerAgentFrames::AgentValueState.Available, DebuggerAgentFrames::AgentStorageKind.RuntimeSlot, DAPNativeVariablesStorage::BLOB_OFFSET, DAPNativeVariablesFixture::BLOB_BYTE_COUNT.u64(), blob_bytes[DAPNativeVariablesPage::FIRST], DAPNativeVariablesFixture::BLOB_BYTE_COUNT) != DebuggerAgentFrames::ShadowStatus.Ready
    return DAPNativeVariablesFailure::LOCAL_SETUP if DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::GONE_BINDING), debug_id(DAPNativeVariablesFixture::SCOPE), debug_id(DAPNativeVariablesFixture::INTEGER_TYPE), DebuggerAgentFrames::AgentValueKind.Signed, DebuggerAgentFrames::AgentValueState.OptimizedAway, DebuggerAgentFrames::AgentStorageKind.Unknown, DAPNativeVariablesStorage::UNKNOWN_OFFSET, DAPNativeVariablesExpected::NONAVAILABLE_DECLARED_SIZE, blob_bytes[DAPNativeVariablesPage::FIRST], DAPNativeVariablesPage::EMPTY) != DebuggerAgentFrames::ShadowStatus.Ready
    return DAPNativeVariablesFailure::LOCAL_SETUP if DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::SECRET_BINDING), debug_id(DAPNativeVariablesFixture::SCOPE), debug_id(DAPNativeVariablesFixture::BLOB_TYPE), DebuggerAgentFrames::AgentValueKind.Text, DebuggerAgentFrames::AgentValueState.Redacted, DebuggerAgentFrames::AgentStorageKind.Unknown, DAPNativeVariablesStorage::UNKNOWN_OFFSET, DAPNativeVariablesPage::EMPTY.u64(), blob_bytes[DAPNativeVariablesPage::FIRST], DAPNativeVariablesPage::EMPTY) != DebuggerAgentFrames::ShadowStatus.Ready
    encoded_retries: DebuggerAgentValueCodec::EncodedScalar = DebuggerAgentValueCodec::agent_scalar_encode_unsigned(DAPNativeVariablesFixture::UNSIGNED_VALUE, DAPNativeVariablesWidth::FOUR_BYTES)
    return DAPNativeVariablesFailure::LOCAL_SETUP if DebuggerAgentValueCodec::agent_shadow_binding_declare_scalar(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::RETRIES_BINDING), debug_id(DAPNativeVariablesFixture::SCOPE), debug_id(DAPNativeVariablesFixture::INTEGER_TYPE), DebuggerAgentFrames::AgentStorageKind.Register, DAPNativeVariablesStorage::REGISTER_OFFSET, encoded_retries) != DebuggerAgentFrames::ShadowStatus.Ready
    return DAPNativeVariablesFailure::LOCAL_SETUP if DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::UNAVAILABLE_BINDING), debug_id(DAPNativeVariablesFixture::SCOPE), debug_id(DAPNativeVariablesFixture::INTEGER_TYPE), DebuggerAgentFrames::AgentValueKind.Signed, DebuggerAgentFrames::AgentValueState.Unavailable, DebuggerAgentFrames::AgentStorageKind.Unknown, DAPNativeVariablesStorage::UNKNOWN_OFFSET, DAPNativeVariablesWidth::NONAVAILABLE_VALUE_BYTES, blob_bytes[DAPNativeVariablesPage::FIRST], DAPNativeVariablesPage::EMPTY) != DebuggerAgentFrames::ShadowStatus.Ready
    return DAPNativeVariablesFailure::LOCAL_SETUP if DebuggerAgentFrames::agent_shadow_binding_declare(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::UNINITIALIZED_BINDING), debug_id(DAPNativeVariablesFixture::SCOPE), debug_id(DAPNativeVariablesFixture::INTEGER_TYPE), DebuggerAgentFrames::AgentValueKind.Signed, DebuggerAgentFrames::AgentValueState.Uninitialized, DebuggerAgentFrames::AgentStorageKind.Unknown, DAPNativeVariablesStorage::UNKNOWN_OFFSET, DAPNativeVariablesPage::EMPTY.u64(), blob_bytes[DAPNativeVariablesPage::FIRST], DAPNativeVariablesPage::EMPTY) != DebuggerAgentFrames::ShadowStatus.Ready
    encoded_enabled: DebuggerAgentValueCodec::EncodedScalar = DebuggerAgentValueCodec::agent_scalar_encode_boolean(DAPNativeVariablesFixture::BOOLEAN_FALSE)
    return DAPNativeVariablesFailure::LOCAL_SETUP if DebuggerAgentValueCodec::agent_shadow_binding_declare_scalar(shadow_stack, debug_id(DAPNativeVariablesFixture::INVOCATION), debug_id(DAPNativeVariablesFixture::ENABLED_BINDING), debug_id(DAPNativeVariablesFixture::SCOPE), debug_id(DAPNativeVariablesFixture::BOOLEAN_TYPE), DebuggerAgentFrames::AgentStorageKind.Register, DAPNativeVariablesStorage::REGISTER_OFFSET, encoded_enabled) != DebuggerAgentFrames::ShadowStatus.Ready

    registry: mutable DebuggerAgentThreads::AgentThreadRegistry = zeroed
    DebuggerAgentThreads::agent_threads_initialize(registry)
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if DebuggerAgentThreads::agent_thread_register(registry, DAPNativeVariablesFixture::THREAD, DAPNativeVariablesFixture::GENERATION_TIMEOUT) != DebuggerAgentThreads::ThreadStatus.Applied
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if DebuggerAgentThreads::agent_threads_request_stop(registry, DAPNativeVariablesFixture::GENERATION, DAPNativeVariablesFixture::GENERATION_TIMEOUT, DAPNativeVariablesFixture::DEADLINE) != DebuggerAgentThreads::ThreadStatus.Applied
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if DebuggerAgentFrames::agent_shadow_stack_begin_stop(shadow_stack, DAPNativeVariablesFixture::GENERATION) != DebuggerAgentFrames::ShadowStatus.Ready
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if DebuggerAgentThreads::agent_thread_safe_point(registry, DAPNativeVariablesFixture::THREAD, DAPNativeVariablesFixture::GENERATION_TIMEOUT) != DebuggerAgentThreads::ThreadStatus.Applied

    stack_request: mutable DebuggerAgentSnapshotWire::SnapshotStackPageRequest = zeroed
    stack_request.generation <- DAPNativeVariablesFixture::GENERATION
    stack_request.thread_id <- DAPNativeVariablesFixture::THREAD
    stack_request.frame_limit <- DAPNativeVariablesFixture::STACK_PAGE_FRAME_LIMIT
    stack_encoded: DebuggerAgentSnapshotWire::EncodedSnapshotStackPageRequest = DebuggerAgentSnapshotWire::agent_snapshot_stack_page_request_encode(stack_request)
    wire_buffer: mutable DebuggerAgentSnapshotWire::SnapshotWireBuffer = zeroed
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if stack_encoded.status != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready or DebuggerAgentSnapshotWire::agent_snapshot_stack_page_dispatch(stack_encoded.bytes[DAPNativeVariablesPage::FIRST], stack_encoded.length, shadow_stack, registry, wire_buffer) != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready
    raw_stack: mutable DebuggerAgentSnapshotWire::DecodedSnapshotStackPage = zeroed
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if DebuggerAgentSnapshotWire::agent_snapshot_stack_page_decode(wire_buffer.bytes[DAPNativeVariablesPage::FIRST], wire_buffer.length, raw_stack) != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready
    projected_stack: mutable DebuggerDAPNativeFrames::StackPage = zeroed
    return DAPNativeVariablesFailure::STACK_PROJECTION if not DebuggerDAPNativeFrames::native_stack_page_to_dap(raw_stack, source_store, projected_stack)
    return DAPNativeVariablesFailure::STACK_PROJECTION if projected_stack.total_frames != DAPNativeVariablesPage::TOTAL_STACK_FRAMES or projected_stack.start_frame != DAPNativeVariablesPage::SECOND or projected_stack.count != DAPNativeVariablesFixture::STACK_PAGE_FRAME_LIMIT
    frame: mutable DebuggerDAPNativeFrames::NativeFrameView = zeroed
    return DAPNativeVariablesFailure::STACK_PROJECTION if not DebuggerDAPNativeFrames::native_stack_page_frame(projected_stack, DAPNativeVariablesPage::FIRST, source_store, names, frame)
    return DAPNativeVariablesFailure::STACK_PROJECTION if frame.native_frame_index != DAPNativeVariablesPage::EMPTY or frame.stack_index != DAPNativeVariablesPage::SECOND or frame.generation != DAPNativeVariablesFixture::GENERATION or frame.thread_id != DAPNativeVariablesFixture::THREAD
    frame_reference: u64 = DebuggerDAPFrames::variables_reference_encode(DAPNativeVariablesFixture::GENERATION, frame.stack_index)
    resolved_frame: mutable DebuggerDAPNativeFrames::NativeFrameView = zeroed
    return DAPNativeVariablesFailure::REFERENCE_RESOLUTION if not DebuggerDAPNativeVariables::native_variables_reference_resolve(projected_stack, source_store, names, DAPNativeVariablesFixture::GENERATION, frame_reference, resolved_frame)
    return DAPNativeVariablesFailure::REFERENCE_RESOLUTION if resolved_frame.id != frame.id or resolved_frame.native_frame_index != frame.native_frame_index or resolved_frame.invocation.value != frame.invocation.value
    return DAPNativeVariablesFailure::STALE_REFERENCE_ACCEPTED if DebuggerDAPNativeVariables::native_variables_reference_resolve(projected_stack, source_store, names, DAPNativeVariablesFixture::NEXT_GENERATION, frame_reference, resolved_frame)
    outside_page_reference: u64 = DebuggerDAPFrames::variables_reference_encode(DAPNativeVariablesFixture::GENERATION, DAPNativeVariablesPage::FIRST)
    return DAPNativeVariablesFailure::OUT_OF_PAGE_REFERENCE_ACCEPTED if DebuggerDAPNativeVariables::native_variables_reference_resolve(projected_stack, source_store, names, DAPNativeVariablesFixture::GENERATION, outside_page_reference, resolved_frame)

    page_request: mutable DebuggerAgentSnapshotWire::SnapshotPageRequest = zeroed
    page_request.generation <- DAPNativeVariablesFixture::GENERATION
    page_request.thread_id <- DAPNativeVariablesFixture::THREAD
    page_request.frame_index <- frame.native_frame_index
    page_request.binding_limit <- DAPNativeVariablesPage::FIRST_PAGE_LIMIT
    page_encoded: mutable DebuggerAgentSnapshotWire::EncodedSnapshotPageRequest = DebuggerAgentSnapshotWire::agent_snapshot_page_request_encode(page_request)
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if page_encoded.status != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready or DebuggerAgentSnapshotWire::agent_snapshot_page_dispatch(page_encoded.bytes[DAPNativeVariablesPage::FIRST], page_encoded.length, shadow_stack, registry, wire_buffer) != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready
    raw_page: mutable DebuggerAgentSnapshotWire::DecodedSnapshotPage = zeroed
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if DebuggerAgentSnapshotWire::agent_snapshot_frame_page_decode(wire_buffer.bytes[DAPNativeVariablesPage::FIRST], wire_buffer.length, raw_page) != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready
    variables: mutable DebuggerDAPNativeVariables::VariablesPage = zeroed
    return DAPNativeVariablesFailure::PAGE_PROJECTION if not DebuggerDAPNativeVariables::native_variables_page_project(raw_page, frame, names, type_store, variables)
    return DAPNativeVariablesFailure::PAGE_PROJECTION if not variables.valid or variables.start != DAPNativeVariablesPage::EMPTY or variables.count != DAPNativeVariablesPage::FIRST_PAGE_COUNT or variables.total != DAPNativeVariablesPage::TOTAL_BINDINGS or not variables.has_more
    return DAPNativeVariablesFailure::PAGE_PROJECTION if not variables_reference_is_valid(variables, frame)
    return DAPNativeVariablesFailure::COUNTER_VALUE if not text_matches(variables.entries[DAPNativeVariablesPage::FIRST].name_bytes[DAPNativeVariablesPage::FIRST], variables.entries[DAPNativeVariablesPage::FIRST].name_length, DAPNativeVariablesFixture::COUNTER_NAME, DAPNativeVariablesFixture::COUNTER_NAME_LENGTH) or not variables.entries[DAPNativeVariablesPage::FIRST].name_resolved
    return DAPNativeVariablesFailure::COUNTER_VALUE if variables.entries[DAPNativeVariablesPage::FIRST].display_state != DebuggerDAPNativeVariables::DisplayState.Scalar or not text_matches(variables.entries[DAPNativeVariablesPage::FIRST].display_bytes[DAPNativeVariablesPage::FIRST], variables.entries[DAPNativeVariablesPage::FIRST].display_length, DAPNativeVariablesExpected::COUNTER_TEXT, DAPNativeVariablesExpected::COUNTER_TEXT_LENGTH)
    return DAPNativeVariablesFailure::COUNTER_VALUE if not variables.entries[DAPNativeVariablesPage::FIRST].has_type_name or not text_matches(variables.entries[DAPNativeVariablesPage::FIRST].type_name_bytes[DAPNativeVariablesPage::FIRST], variables.entries[DAPNativeVariablesPage::FIRST].type_name_length, DAPNativeVariablesFixture::INTEGER_TYPE_TEXT, DAPNativeVariablesFixture::INTEGER_TYPE_TEXT_LENGTH) or variables.entries[DAPNativeVariablesPage::FIRST].raw_length != DAPNativeVariablesWidth::ONE_BYTE or variables.entries[DAPNativeVariablesPage::FIRST].raw_bytes[DAPNativeVariablesPage::FIRST] != DAPNativeVariablesExpected::COUNTER_RAW
    return DAPNativeVariablesFailure::BLOB_VALUE if variables.entries[DAPNativeVariablesPage::SECOND].name_resolved or not text_matches(variables.entries[DAPNativeVariablesPage::SECOND].name_bytes[DAPNativeVariablesPage::FIRST], variables.entries[DAPNativeVariablesPage::SECOND].name_length, DAPNativeVariablesExpected::FALLBACK_BLOB_NAME, DAPNativeVariablesExpected::FALLBACK_BLOB_NAME_LENGTH)
    return DAPNativeVariablesFailure::BLOB_VALUE if variables.entries[DAPNativeVariablesPage::SECOND].display_state != DebuggerDAPNativeVariables::DisplayState.Unsupported or not text_matches(variables.entries[DAPNativeVariablesPage::SECOND].display_bytes[DAPNativeVariablesPage::FIRST], variables.entries[DAPNativeVariablesPage::SECOND].display_length, DAPNativeVariablesExpected::UNSUPPORTED_TEXT, DAPNativeVariablesExpected::UNSUPPORTED_TEXT_LENGTH)
    return DAPNativeVariablesFailure::BLOB_VALUE if variables.entries[DAPNativeVariablesPage::SECOND].raw_length != DAPNativeVariablesFixture::BLOB_BYTE_COUNT or variables.entries[DAPNativeVariablesPage::SECOND].raw_bytes[DAPNativeVariablesPage::FIRST] != DAPNativeVariablesExpected::BLOB_BYTES_FIRST or variables.entries[DAPNativeVariablesPage::SECOND].raw_bytes[DAPNativeVariablesIndex::SECOND] != DAPNativeVariablesExpected::BLOB_BYTES_SECOND or variables.entries[DAPNativeVariablesPage::SECOND].raw_bytes[DAPNativeVariablesIndex::THIRD] != DAPNativeVariablesExpected::BLOB_BYTES_THIRD
    return DAPNativeVariablesFailure::BLOB_VALUE if not variables.entries[DAPNativeVariablesPage::SECOND].has_type_name or not text_matches(variables.entries[DAPNativeVariablesPage::SECOND].type_name_bytes[DAPNativeVariablesPage::FIRST], variables.entries[DAPNativeVariablesPage::SECOND].type_name_length, DAPNativeVariablesFixture::BLOB_TYPE_TEXT, DAPNativeVariablesFixture::BLOB_TYPE_TEXT_LENGTH)
    return DAPNativeVariablesFailure::GONE_VALUE if variables.entries[DAPNativeVariablesPage::THIRD].display_state != DebuggerDAPNativeVariables::DisplayState.OptimizedAway or not text_matches(variables.entries[DAPNativeVariablesPage::THIRD].display_bytes[DAPNativeVariablesPage::FIRST], variables.entries[DAPNativeVariablesPage::THIRD].display_length, DAPNativeVariablesExpected::OPTIMIZED_AWAY_TEXT, DAPNativeVariablesExpected::OPTIMIZED_AWAY_TEXT_LENGTH)
    return DAPNativeVariablesFailure::GONE_VALUE if variables.entries[DAPNativeVariablesPage::THIRD].raw_length != DAPNativeVariablesPage::EMPTY or variables.entries[DAPNativeVariablesPage::THIRD].byte_size != DAPNativeVariablesExpected::NONAVAILABLE_DECLARED_SIZE

    page_request.binding_start <- DAPNativeVariablesPage::SECOND_PAGE_START
    page_request.binding_limit <- DAPNativeVariablesPage::SECOND_PAGE_LIMIT
    page_encoded <- DebuggerAgentSnapshotWire::agent_snapshot_page_request_encode(page_request)
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if page_encoded.status != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready or DebuggerAgentSnapshotWire::agent_snapshot_page_dispatch(page_encoded.bytes[DAPNativeVariablesPage::FIRST], page_encoded.length, shadow_stack, registry, wire_buffer) != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready
    raw_page <- zeroed
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if DebuggerAgentSnapshotWire::agent_snapshot_frame_page_decode(wire_buffer.bytes[DAPNativeVariablesPage::FIRST], wire_buffer.length, raw_page) != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready
    next_variables: mutable DebuggerDAPNativeVariables::VariablesPage = zeroed
    return DAPNativeVariablesFailure::NEXT_PAGE_VALUE if not DebuggerDAPNativeVariables::native_variables_page_project(raw_page, frame, names, type_store, next_variables)
    return DAPNativeVariablesFailure::NEXT_PAGE_VALUE if not next_variables.valid or next_variables.start != DAPNativeVariablesPage::SECOND_PAGE_START or next_variables.count != DAPNativeVariablesPage::SECOND_PAGE_COUNT or not next_variables.has_more
    return DAPNativeVariablesFailure::NEXT_PAGE_VALUE if next_variables.entries[DAPNativeVariablesPage::FIRST].display_state != DebuggerDAPNativeVariables::DisplayState.Redacted or not text_matches(next_variables.entries[DAPNativeVariablesPage::FIRST].display_bytes[DAPNativeVariablesPage::FIRST], next_variables.entries[DAPNativeVariablesPage::FIRST].display_length, DAPNativeVariablesExpected::REDACTED_TEXT, DAPNativeVariablesExpected::REDACTED_TEXT_LENGTH)
    return DAPNativeVariablesFailure::NEXT_PAGE_VALUE if next_variables.entries[DAPNativeVariablesPage::SECOND].display_state != DebuggerDAPNativeVariables::DisplayState.Scalar or not text_matches(next_variables.entries[DAPNativeVariablesPage::SECOND].display_bytes[DAPNativeVariablesPage::FIRST], next_variables.entries[DAPNativeVariablesPage::SECOND].display_length, DAPNativeVariablesExpected::MAX_UNSIGNED_TEXT, DAPNativeVariablesExpected::MAX_UNSIGNED_TEXT_LENGTH)

    page_request.binding_start <- DAPNativeVariablesPage::THIRD_PAGE_START
    page_request.binding_limit <- DAPNativeVariablesPage::THIRD_PAGE_LIMIT
    page_encoded <- DebuggerAgentSnapshotWire::agent_snapshot_page_request_encode(page_request)
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if page_encoded.status != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready or DebuggerAgentSnapshotWire::agent_snapshot_page_dispatch(page_encoded.bytes[DAPNativeVariablesPage::FIRST], page_encoded.length, shadow_stack, registry, wire_buffer) != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready
    raw_page <- zeroed
    return DAPNativeVariablesFailure::SNAPSHOT_SETUP if DebuggerAgentSnapshotWire::agent_snapshot_frame_page_decode(wire_buffer.bytes[DAPNativeVariablesPage::FIRST], wire_buffer.length, raw_page) != DebuggerAgentSnapshotWire::SnapshotWireStatus.Ready
    final_variables: mutable DebuggerDAPNativeVariables::VariablesPage = zeroed
    return DAPNativeVariablesFailure::THIRD_PAGE_VALUE if not DebuggerDAPNativeVariables::native_variables_page_project(raw_page, frame, names, type_store, final_variables)
    return DAPNativeVariablesFailure::THIRD_PAGE_VALUE if not final_variables.valid or final_variables.start != DAPNativeVariablesPage::THIRD_PAGE_START or final_variables.count != DAPNativeVariablesPage::THIRD_PAGE_COUNT or final_variables.has_more
    return DAPNativeVariablesFailure::THIRD_PAGE_VALUE if final_variables.entries[DAPNativeVariablesPage::FIRST].display_state != DebuggerDAPNativeVariables::DisplayState.Unavailable or not text_matches(final_variables.entries[DAPNativeVariablesPage::FIRST].display_bytes[DAPNativeVariablesPage::FIRST], final_variables.entries[DAPNativeVariablesPage::FIRST].display_length, DAPNativeVariablesExpected::UNAVAILABLE_TEXT, DAPNativeVariablesExpected::UNAVAILABLE_TEXT_LENGTH)
    return DAPNativeVariablesFailure::THIRD_PAGE_VALUE if final_variables.entries[DAPNativeVariablesPage::FIRST].raw_length != DAPNativeVariablesPage::EMPTY or final_variables.entries[DAPNativeVariablesPage::FIRST].byte_size != DAPNativeVariablesWidth::NONAVAILABLE_VALUE_BYTES
    return DAPNativeVariablesFailure::THIRD_PAGE_VALUE if final_variables.entries[DAPNativeVariablesPage::SECOND].display_state != DebuggerDAPNativeVariables::DisplayState.Uninitialized or not text_matches(final_variables.entries[DAPNativeVariablesPage::SECOND].display_bytes[DAPNativeVariablesPage::FIRST], final_variables.entries[DAPNativeVariablesPage::SECOND].display_length, DAPNativeVariablesExpected::UNINITIALIZED_TEXT, DAPNativeVariablesExpected::UNINITIALIZED_TEXT_LENGTH)
    return DAPNativeVariablesFailure::THIRD_PAGE_VALUE if final_variables.entries[DAPNativeVariablesPage::THIRD].display_state != DebuggerDAPNativeVariables::DisplayState.Scalar or not text_matches(final_variables.entries[DAPNativeVariablesPage::THIRD].display_bytes[DAPNativeVariablesPage::FIRST], final_variables.entries[DAPNativeVariablesPage::THIRD].display_length, DAPNativeVariablesExpected::FALSE_TEXT, DAPNativeVariablesExpected::FALSE_TEXT_LENGTH)
    return DAPNativeVariablesFailure::THIRD_PAGE_VALUE if not variables_reference_is_valid(final_variables, frame)

    invalid_page: mutable DebuggerAgentSnapshotWire::DecodedSnapshotPage = raw_page
    invalid_page.generation <- DAPNativeVariablesFixture::NEXT_GENERATION
    rejected: mutable DebuggerDAPNativeVariables::VariablesPage = zeroed
    return DAPNativeVariablesFailure::STALE_GENERATION_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(invalid_page, frame, names, type_store, rejected)
    invalid_page <- raw_page
    invalid_page.frame.function <- debug_id(DAPNativeVariablesFixture::OTHER_FUNCTION)
    return DAPNativeVariablesFailure::WRONG_FRAME_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(invalid_page, frame, names, type_store, rejected)
    invalid_page <- raw_page
    invalid_page.binding_count <- invalid_page.frame.binding_count
    return DAPNativeVariablesFailure::CORRUPT_RANGE_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(invalid_page, frame, names, type_store, rejected)
    invalid_names: mutable DebuggerMetadataNames::NameStore = names
    invalid_names.count <- DebuggerMetadataNames::Bounds::MAX_NAME_ENTRIES + DAPNativeVariablesPage::NAME_COUNT_INCREMENT
    return DAPNativeVariablesFailure::CORRUPT_NAME_STORE_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(raw_page, frame, invalid_names, type_store, rejected)
    invalid_types: mutable DebuggerTypeMetadata::MetadataStore = type_store
    invalid_types.type_count <- DebuggerTypeMetadata::Bounds::MAX_TYPES + DAPNativeVariablesPage::TYPE_COUNT_INCREMENT
    return DAPNativeVariablesFailure::CORRUPT_TYPE_STORE_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(raw_page, frame, names, invalid_types, rejected)
    invalid_types <- type_store
    invalid_types.types[DAPNativeVariablesIndex::SECOND].id <- invalid_types.types[DAPNativeVariablesPage::FIRST].id
    return DAPNativeVariablesFailure::CORRUPT_DUPLICATE_TYPE_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(raw_page, frame, names, invalid_types, rejected)
    invalid_page <- raw_page
    invalid_page.bindings[DAPNativeVariablesIndex::SECOND].binding <- invalid_page.bindings[DAPNativeVariablesPage::FIRST].binding
    return DAPNativeVariablesFailure::CORRUPT_DUPLICATE_BINDING_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(invalid_page, frame, names, type_store, rejected)
    invalid_page <- raw_page
    invalid_page.bindings[DAPNativeVariablesPage::THIRD].bytes[DAPNativeVariablesPage::FIRST] <- DAPNativeVariablesExpected::INVALID_BOOLEAN_BYTE
    return DAPNativeVariablesFailure::CORRUPT_BOOLEAN_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(invalid_page, frame, names, type_store, rejected)
    invalid_page <- raw_page
    invalid_page.bindings[DAPNativeVariablesPage::FIRST].state <- DebuggerAgentFrames::AgentValueState.Invalid
    return DAPNativeVariablesFailure::INVALID_STATE_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(invalid_page, frame, names, type_store, rejected)
    invalid_page <- raw_page
    invalid_page.bindings[DAPNativeVariablesPage::FIRST].binding <- debug_id(DAPNativeVariablesFixture::ZERO_ID)
    return DAPNativeVariablesFailure::CORRUPT_DESCRIPTOR_ACCEPTED if DebuggerDAPNativeVariables::native_variables_page_project(invalid_page, frame, names, type_store, rejected)
    return DAPNativeVariablesFailure::SUCCESS
