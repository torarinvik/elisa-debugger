include "../src/protocol/dap_native_variables_json.elisa"

const module DAPNativeVariablesJsonFixture:
    GENERATION: u64 = 7
    THREAD: u64 = 41
    INVOCATION: u64 = 42
    BINDING: u64 = 43
    SCOPE: u64 = 44
    TYPE: u64 = 45
    FRAME_INDEX: usize = 0
    STACK_TOTAL: usize = 1
    PAGE_START: usize = 0
    PAGE_COUNT: usize = 1
    NAME: cstr = "say\"\\x"
    NAME_LENGTH: usize = 6
    TYPE_NAME: cstr = "Bool"
    TYPE_NAME_LENGTH: usize = 4
    VALUE_TEXT: cstr = "true"
    VALUE_TEXT_LENGTH: usize = 4
    MISMATCHED_VALUE_TEXT: cstr = "fals"
    MISMATCHED_VALUE_TEXT_LENGTH: usize = 4
    RAW_TRUE: u8 = 1
    INVALID_BOOLEAN_BYTE: u8 = 2
    NUL_BYTE: u8 = 0
    INVALID_CONTROL_BYTE: u8 = 1
    NEXT_PAGE_COUNT: usize = 2
    COUNT_INCREMENT: usize = 1
    BOOLEAN_BYTE_COUNT: usize = 1

const module DAPNativeVariablesJsonIndex:
    FIRST: usize = 0
    SECOND: usize = 1

const module DAPNativeVariablesJsonExpected:
    BODY: cstr = "{\"variables\":[{\"name\":\"say\\\"\\\\x\",\"value\":\"true\",\"type\":\"Bool\",\"variablesReference\":0}]}"
    BODY_WITHOUT_TYPE: cstr = "{\"variables\":[{\"name\":\"say\\\"\\\\x\",\"value\":\"true\",\"variablesReference\":0}]}"
    EMPTY_BODY: cstr = "{\"variables\":[]}"

const module DAPNativeVariablesJsonFailure:
    SUCCESS: i64 = 0
    INVALID_REFERENCE: i64 = 1
    WRONG_JSON: i64 = 2
    CONTROL_TEXT_ACCEPTED: i64 = 3
    DUPLICATE_BINDING_ACCEPTED: i64 = 4
    SCALAR_TEXT_ACCEPTED: i64 = 5
    INVALID_BOOLEAN_ACCEPTED: i64 = 6

def debug_id(value: u64) -> DebuggerIdentity::DebugId:
    return DebuggerIdentity::debug_id(value)

def copy_text(output: mutable u8&, value: cstr, length: usize) -> void:
    for index in DAPNativeVariablesJsonIndex::FIRST..<length:
        output[index] <- value[index].u8()

def cstr_length(value: cstr) -> usize:
    length: mutable usize = DAPNativeVariablesJsonIndex::FIRST
    while value[length] != DAPNativeVariablesJsonFixture::NUL_BYTE:
        length <- length + DAPNativeVariablesJsonFixture::COUNT_INCREMENT
    return length

def make_page() -> DebuggerDAPNativeVariables::VariablesPage:
    page: mutable DebuggerDAPNativeVariables::VariablesPage = zeroed
    page.valid <- true
    page.frame_id <- DebuggerDAPFrames::frame_reference_encode(DAPNativeVariablesJsonFixture::GENERATION, DAPNativeVariablesJsonFixture::FRAME_INDEX)
    page.variables_reference <- DebuggerDAPFrames::variables_reference_encode(DAPNativeVariablesJsonFixture::GENERATION, DAPNativeVariablesJsonFixture::FRAME_INDEX)
    page.generation <- DAPNativeVariablesJsonFixture::GENERATION
    page.thread_id <- DAPNativeVariablesJsonFixture::THREAD
    page.invocation <- debug_id(DAPNativeVariablesJsonFixture::INVOCATION)
    page.frame_index <- DAPNativeVariablesJsonFixture::FRAME_INDEX
    page.start <- DAPNativeVariablesJsonFixture::PAGE_START
    page.count <- DAPNativeVariablesJsonFixture::PAGE_COUNT
    page.total <- DAPNativeVariablesJsonFixture::STACK_TOTAL
    page.has_more <- false
    variable: mutable DebuggerDAPNativeVariables::NativeVariableView = zeroed
    variable.binding_id <- debug_id(DAPNativeVariablesJsonFixture::BINDING)
    variable.scope_id <- debug_id(DAPNativeVariablesJsonFixture::SCOPE)
    variable.type_id <- debug_id(DAPNativeVariablesJsonFixture::TYPE)
    variable.name_length <- DAPNativeVariablesJsonFixture::NAME_LENGTH
    variable.name_resolved <- true
    copy_text(variable.name_bytes[DAPNativeVariablesJsonIndex::FIRST], DAPNativeVariablesJsonFixture::NAME, DAPNativeVariablesJsonFixture::NAME_LENGTH)
    variable.type_name_length <- DAPNativeVariablesJsonFixture::TYPE_NAME_LENGTH
    variable.has_type_name <- true
    copy_text(variable.type_name_bytes[DAPNativeVariablesJsonIndex::FIRST], DAPNativeVariablesJsonFixture::TYPE_NAME, DAPNativeVariablesJsonFixture::TYPE_NAME_LENGTH)
    variable.display_length <- DAPNativeVariablesJsonFixture::VALUE_TEXT_LENGTH
    variable.display_state <- DebuggerDAPNativeVariables::DisplayState.Scalar
    copy_text(variable.display_bytes[DAPNativeVariablesJsonIndex::FIRST], DAPNativeVariablesJsonFixture::VALUE_TEXT, DAPNativeVariablesJsonFixture::VALUE_TEXT_LENGTH)
    variable.value_kind <- DebuggerAgentFrames::AgentValueKind.Boolean
    variable.value_state <- DebuggerAgentFrames::AgentValueState.Available
    variable.storage_kind <- DebuggerAgentFrames::AgentStorageKind.Register
    variable.byte_size <- DAPNativeVariablesJsonFixture::BOOLEAN_BYTE_COUNT.u64()
    variable.raw_length <- DAPNativeVariablesJsonFixture::BOOLEAN_BYTE_COUNT
    variable.raw_bytes[DAPNativeVariablesJsonIndex::FIRST] <- DAPNativeVariablesJsonFixture::RAW_TRUE
    page.entries[DAPNativeVariablesJsonIndex::FIRST] <- variable
    return page

def main() -> i64:
    page: mutable DebuggerDAPNativeVariables::VariablesPage = make_page()
    output: mutable DebuggerDAPNativeVariablesJson::JsonBody = zeroed
    return DAPNativeVariablesJsonFailure::INVALID_REFERENCE if not DebuggerDAPNativeVariablesJson::native_variables_dap_json_encode(page, true, output)
    return DAPNativeVariablesJsonFailure::WRONG_JSON if output.status != DebuggerDAPNativeVariablesJson::EncodeStatus.Ready or output.length != cstr_length(DAPNativeVariablesJsonExpected::BODY)
    for index in DAPNativeVariablesJsonIndex::FIRST..<output.length:
        return DAPNativeVariablesJsonFailure::WRONG_JSON if output.bytes[index] != DAPNativeVariablesJsonExpected::BODY[index].u8()

    return DAPNativeVariablesJsonFailure::WRONG_JSON if not DebuggerDAPNativeVariablesJson::native_variables_dap_json_encode(page, false, output)
    return DAPNativeVariablesJsonFailure::WRONG_JSON if output.length != cstr_length(DAPNativeVariablesJsonExpected::BODY_WITHOUT_TYPE)
    for index in DAPNativeVariablesJsonIndex::FIRST..<output.length:
        return DAPNativeVariablesJsonFailure::WRONG_JSON if output.bytes[index] != DAPNativeVariablesJsonExpected::BODY_WITHOUT_TYPE[index].u8()

    invalid_page: mutable DebuggerDAPNativeVariables::VariablesPage = page
    invalid_page.entries[DAPNativeVariablesJsonIndex::FIRST].name_bytes[DAPNativeVariablesJsonIndex::FIRST] <- DAPNativeVariablesJsonFixture::INVALID_CONTROL_BYTE
    return DAPNativeVariablesJsonFailure::CONTROL_TEXT_ACCEPTED if DebuggerDAPNativeVariablesJson::native_variables_dap_json_encode(invalid_page, true, output) or output.length != DAPNativeVariablesJsonIndex::FIRST

    mismatched_page: mutable DebuggerDAPNativeVariables::VariablesPage = page
    copy_text(mismatched_page.entries[DAPNativeVariablesJsonIndex::FIRST].display_bytes[DAPNativeVariablesJsonIndex::FIRST], DAPNativeVariablesJsonFixture::MISMATCHED_VALUE_TEXT, DAPNativeVariablesJsonFixture::MISMATCHED_VALUE_TEXT_LENGTH)
    return DAPNativeVariablesJsonFailure::SCALAR_TEXT_ACCEPTED if DebuggerDAPNativeVariablesJson::native_variables_dap_json_encode(mismatched_page, true, output)

    invalid_boolean_page: mutable DebuggerDAPNativeVariables::VariablesPage = page
    invalid_boolean_page.entries[DAPNativeVariablesJsonIndex::FIRST].raw_bytes[DAPNativeVariablesJsonIndex::FIRST] <- DAPNativeVariablesJsonFixture::INVALID_BOOLEAN_BYTE
    return DAPNativeVariablesJsonFailure::INVALID_BOOLEAN_ACCEPTED if DebuggerDAPNativeVariablesJson::native_variables_dap_json_encode(invalid_boolean_page, true, output)

    duplicate_page: mutable DebuggerDAPNativeVariables::VariablesPage = page
    duplicate_page.count <- DAPNativeVariablesJsonFixture::NEXT_PAGE_COUNT
    duplicate_page.total <- DAPNativeVariablesJsonFixture::NEXT_PAGE_COUNT
    duplicate_page.has_more <- false
    duplicate_page.entries[DAPNativeVariablesJsonIndex::SECOND] <- page.entries[DAPNativeVariablesJsonIndex::FIRST]
    duplicate_page.entries[DAPNativeVariablesJsonIndex::SECOND].binding_id <- debug_id(DAPNativeVariablesJsonFixture::BINDING)
    return DAPNativeVariablesJsonFailure::DUPLICATE_BINDING_ACCEPTED if DebuggerDAPNativeVariablesJson::native_variables_dap_json_encode(duplicate_page, true, output)

    empty_page: mutable DebuggerDAPNativeVariables::VariablesPage = page
    empty_page.start <- empty_page.total
    empty_page.count <- DAPNativeVariablesJsonIndex::FIRST
    return DAPNativeVariablesJsonFailure::WRONG_JSON if not DebuggerDAPNativeVariablesJson::native_variables_dap_json_encode(empty_page, false, output)
    return DAPNativeVariablesJsonFailure::WRONG_JSON if output.length != cstr_length(DAPNativeVariablesJsonExpected::EMPTY_BODY)
    for index in DAPNativeVariablesJsonIndex::FIRST..<output.length:
        return DAPNativeVariablesJsonFailure::WRONG_JSON if output.bytes[index] != DAPNativeVariablesJsonExpected::EMPTY_BODY[index].u8()
    return DAPNativeVariablesJsonFailure::SUCCESS
