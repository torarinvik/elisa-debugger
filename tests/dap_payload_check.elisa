include "../src/protocol/dap_payload.elisa"

const VALID_LENGTH: usize = 50
const INVALID_COUNT_LENGTH: usize = 51
const OVER_LIMIT_COUNT_LENGTH: usize = 51
const DUPLICATE_COUNT_LENGTH: usize = 60
const EXPECTED_ADDRESS: u64 = 31
const EXPECTED_COUNT: usize = 4

def main() -> i64:
    valid: mutable u8[VALID_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    parsed: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(valid[0], VALID_LENGTH)
    return 10 if not parsed.valid
    return 11 if parsed.address != EXPECTED_ADDRESS
    return 12 if parsed.count != EXPECTED_COUNT
    invalid_count: mutable u8[INVALID_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 48, 52, 125, 125]
    return 2 if DebuggerDAPPayload::memory_request_parse(invalid_count[0], INVALID_COUNT_LENGTH).valid
    over_limit: mutable u8[OVER_LIMIT_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 54, 53, 125, 125]
    return 3 if DebuggerDAPPayload::memory_request_parse(over_limit[0], OVER_LIMIT_COUNT_LENGTH).valid
    duplicate: mutable u8[DUPLICATE_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 44, 34, 99, 111, 117, 110, 116, 34, 58, 53, 125, 125]
    return 4 if DebuggerDAPPayload::memory_request_parse(duplicate[0], DUPLICATE_COUNT_LENGTH).valid
    return 0
