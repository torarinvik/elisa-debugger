const EXPECTED_DECODED_PATH_FIRST_BYTE: u8 = 97
const EXPECTED_DECODED_PATH_DOT_INDEX: usize = 6
const EXPECTED_DECODED_PATH_DOT: u8 = 46
const JSON_WHITESPACE_PREFIX_LENGTH: usize = 2
const JSON_WHITESPACE_SPACE: u8 = 32
const JSON_WHITESPACE_LINE_FEED: u8 = 10
const WHITESPACE_PROGRAM_PAYLOAD_LENGTH: usize = PROGRAM_PATH_PAYLOAD_LENGTH + JSON_WHITESPACE_PREFIX_LENGTH
const CLIENT_COORDINATES_PAYLOAD_LENGTH: usize = 60
const INVALID_CLIENT_COORDINATES_PAYLOAD_LENGTH: usize = 39
const NESTED_CLIENT_COORDINATES_PAYLOAD_LENGTH: usize = 48
const ESCAPED_CLIENT_COORDINATES_PAYLOAD_LENGTH: usize = 66
const POSITIVE_MEMORY_OFFSET_LENGTH: usize = 61
const NEGATIVE_MEMORY_OFFSET_LENGTH: usize = 62
const UNDERFLOW_MEMORY_OFFSET_LENGTH: usize = 63
const MEMORY_OFFSET_OVERFLOW_LENGTH: usize = 75
const EXTRA_NESTED_COUNT_LENGTH: usize = 73
const TOP_LEVEL_MEMORY_REFERENCE_LENGTH: usize = 50
const VARIABLES_REQUEST_LENGTH: usize = 58
const VARIABLES_REQUIRED_FIELDS_LENGTH: usize = 38
const VARIABLES_NESTED_REFERENCE_LENGTH: usize = 49
const VARIABLES_DUPLICATE_REFERENCE_LENGTH: usize = 61
const VARIABLES_ZERO_COUNT_LENGTH: usize = 48
const VARIABLES_REFERENCE_OVERFLOW_LENGTH: usize = 57
const VARIABLES_START_OVERFLOW_LENGTH: usize = 49
const VARIABLES_NESTED_ARGUMENTS_LENGTH: usize = 106
const VARIABLES_FULL_REQUEST_LENGTH: usize = 85
const VARIABLES_EXPECTED_REFERENCE: u64 = 7
const VARIABLES_FULL_EXPECTED_REFERENCE: u64 = 5
const VARIABLES_EXPECTED_START: usize = 2
const VARIABLES_EXPECTED_COUNT: usize = 3

def main() -> i64:
    valid: mutable u8[VALID_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    parsed: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(valid[0], VALID_LENGTH)
    return 10 if not parsed.valid
    return 11 if parsed.address != EXPECTED_ADDRESS
    return 12 if parsed.count != EXPECTED_COUNT
    positive_offset_payload: mutable u8[POSITIVE_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 53, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    positive_offset: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(positive_offset_payload[0], POSITIVE_MEMORY_OFFSET_LENGTH)
    return 24 if not positive_offset.valid or positive_offset.address != EXPECTED_ADDRESS + 5 or positive_offset.count != EXPECTED_COUNT
    negative_offset_payload: mutable u8[NEGATIVE_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 45, 53, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    negative_offset: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(negative_offset_payload[0], NEGATIVE_MEMORY_OFFSET_LENGTH)
    return 25 if not negative_offset.valid or negative_offset.address != EXPECTED_ADDRESS - 5
    offset_underflow_payload: mutable u8[UNDERFLOW_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 45, 57, 57, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    return 26 if DebuggerDAPPayload::memory_request_parse(offset_underflow_payload[0], UNDERFLOW_MEMORY_OFFSET_LENGTH).valid
    memory_offset_overflow_payload: mutable u8[MEMORY_OFFSET_OVERFLOW_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 49, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    return 27 if DebuggerDAPPayload::memory_request_parse(memory_offset_overflow_payload[0], MEMORY_OFFSET_OVERFLOW_LENGTH).valid
    extra_nested_count_payload: mutable u8[EXTRA_NESTED_COUNT_LENGTH] = [123, 34, 109, 101, 116, 97, 100, 97, 116, 97, 34, 58, 123, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    scoped_memory: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(extra_nested_count_payload[0], EXTRA_NESTED_COUNT_LENGTH)
    return 28 if not scoped_memory.valid or scoped_memory.address != EXPECTED_ADDRESS or scoped_memory.count != EXPECTED_COUNT
    top_level_memory_reference_payload: mutable u8[TOP_LEVEL_MEMORY_REFERENCE_LENGTH] = [123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    return 29 if DebuggerDAPPayload::memory_request_parse(top_level_memory_reference_payload[0], TOP_LEVEL_MEMORY_REFERENCE_LENGTH).valid
    invalid_count: mutable u8[INVALID_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 48, 52, 125, 125]
    return 2 if DebuggerDAPPayload::memory_request_parse(invalid_count[0], INVALID_COUNT_LENGTH).valid
    over_limit: mutable u8[OVER_LIMIT_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 54, 53, 125, 125]
    return 3 if DebuggerDAPPayload::memory_request_parse(over_limit[0], OVER_LIMIT_COUNT_LENGTH).valid
    duplicate: mutable u8[DUPLICATE_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 44, 34, 99, 111, 117, 110, 116, 34, 58, 53, 125, 125]
    return 4 if DebuggerDAPPayload::memory_request_parse(duplicate[0], DUPLICATE_COUNT_LENGTH).valid
    malformed_reference: mutable u8[VALID_LENGTH] = valid
    malformed_reference[38] <- 120
    return 5 if DebuggerDAPPayload::memory_request_parse(malformed_reference[0], VALID_LENGTH).valid
    program_payload: mutable u8[PROGRAM_PATH_PAYLOAD_LENGTH] = [123, 34, 116, 121, 112, 101, 34, 58, 34, 114, 101, 113, 117, 101, 115, 116, 34, 44, 34, 99, 111, 109, 109, 97, 110, 100, 34, 58, 34, 108, 97, 117, 110, 99, 104, 34, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 98, 117, 105, 108, 100, 92, 117, 48, 48, 50, 102, 108, 97, 117, 110, 99, 104, 46, 101, 100, 105, 114, 34, 125, 125]
    program_path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(program_payload[0], PROGRAM_PATH_PAYLOAD_LENGTH)
    return 6 if not program_path.valid or program_path.length != EXPECTED_PROGRAM_PATH_LENGTH
    return 7 if program_path.bytes[PROGRAM_PATH_SEPARATOR_INDEX] != PROGRAM_PATH_SEPARATOR
    missing_program: mutable u8[VALID_LENGTH] = valid
    return 8 if DebuggerDAPPayload::program_path_parse(missing_program[0], VALID_LENGTH).valid
    duplicate_program: mutable u8[DUPLICATE_PROGRAM_PAYLOAD_LENGTH] = zeroed
    for index in 0..<PROGRAM_PATH_PAYLOAD_LENGTH:
        duplicate_program[index] <- program_payload[index]
    duplicate_suffix: u8[DUPLICATE_PROGRAM_SUFFIX_LENGTH] = [44, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 120, 34, 125, 125]
    for index in 0..<DUPLICATE_PROGRAM_SUFFIX_LENGTH:
        duplicate_program[PROGRAM_PATH_PAYLOAD_LENGTH - TRAILING_OBJECT_DELIMITERS + index] <- duplicate_suffix[index]
    return 9 if DebuggerDAPPayload::program_path_parse(duplicate_program[0], DUPLICATE_PROGRAM_PAYLOAD_LENGTH).valid
    unicode_payload: mutable u8[UNICODE_PROGRAM_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 98, 117, 105, 108, 100, 92, 117, 68, 56, 51, 68, 92, 117, 68, 69, 48, 48, 46, 101, 100, 105, 114, 34, 125, 125]
    unicode_path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(unicode_payload[0], UNICODE_PROGRAM_PAYLOAD_LENGTH)
    return 10 if not unicode_path.valid or unicode_path.length != UNICODE_PROGRAM_PATH_LENGTH
    return 11 if unicode_path.bytes[UNICODE_FIRST_BYTE_INDEX] != UNICODE_UTF8_FIRST_BYTE or unicode_path.bytes[UNICODE_SECOND_BYTE_INDEX] != UNICODE_UTF8_SECOND_BYTE or unicode_path.bytes[UNICODE_THIRD_BYTE_INDEX] != UNICODE_UTF8_THIRD_BYTE or unicode_path.bytes[UNICODE_FOURTH_BYTE_INDEX] != UNICODE_UTF8_FOURTH_BYTE
    invalid_utf8_payload: mutable u8[PROGRAM_PATH_PAYLOAD_LENGTH] = program_payload
    invalid_utf8_payload[PATH_FIRST_BYTE_INDEX] <- INVALID_UTF8_LEAD_BYTE
    return 12 if DebuggerDAPPayload::program_path_parse(invalid_utf8_payload[0], PROGRAM_PATH_PAYLOAD_LENGTH).valid
    decoy_program_payload: mutable u8[DECOY_PROGRAM_PAYLOAD_LENGTH] = [123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 100, 101, 99, 111, 121, 34, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 97, 99, 116, 117, 97, 108, 46, 101, 100, 105, 114, 34, 44, 34, 110, 101, 115, 116, 101, 100, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 111, 116, 104, 101, 114, 34, 125, 125, 125]
    decoded_decoy_path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(decoy_program_payload[0], DECOY_PROGRAM_PAYLOAD_LENGTH)
    return 13 if not decoded_decoy_path.valid or decoded_decoy_path.length != EXPECTED_DECODED_PATH_LENGTH or decoded_decoy_path.bytes[0] != EXPECTED_DECODED_PATH_FIRST_BYTE or decoded_decoy_path.bytes[EXPECTED_DECODED_PATH_DOT_INDEX] != EXPECTED_DECODED_PATH_DOT
    decoy_only_payload: mutable u8[DECOY_ONLY_PAYLOAD_LENGTH] = [123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 100, 101, 99, 111, 121, 34, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 110, 101, 115, 116, 101, 100, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 111, 116, 104, 101, 114, 34, 125, 125, 125]
    return 14 if DebuggerDAPPayload::program_path_parse(decoy_only_payload[0], DECOY_ONLY_PAYLOAD_LENGTH).valid
    duplicate_arguments_payload: mutable u8[DUPLICATE_ARGUMENTS_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 111, 110, 101, 34, 125, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 116, 119, 111, 34, 125, 125]
    return 15 if DebuggerDAPPayload::program_path_parse(duplicate_arguments_payload[0], DUPLICATE_ARGUMENTS_PAYLOAD_LENGTH).valid
    whitespace_program_payload: mutable u8[WHITESPACE_PROGRAM_PAYLOAD_LENGTH] = zeroed
    whitespace_program_payload[0] <- JSON_WHITESPACE_SPACE
    whitespace_program_payload[1] <- JSON_WHITESPACE_LINE_FEED
    for index in 0..<PROGRAM_PATH_PAYLOAD_LENGTH:
        whitespace_program_payload[index + JSON_WHITESPACE_PREFIX_LENGTH] <- program_payload[index]
    whitespace_path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(whitespace_program_payload[0], WHITESPACE_PROGRAM_PAYLOAD_LENGTH)
    return 16 if not whitespace_path.valid or whitespace_path.length != EXPECTED_PROGRAM_PATH_LENGTH
    default_coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(program_payload[0], PROGRAM_PATH_PAYLOAD_LENGTH)
    return 17 if not default_coordinates.valid or not default_coordinates.lines_start_at_one or not default_coordinates.columns_start_at_one
    client_coordinates_payload: mutable u8[CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 108, 105, 110, 101, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 44, 34, 99, 111, 108, 117, 109, 110, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 116, 114, 117, 101, 125, 125]
    client_coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(client_coordinates_payload[0], CLIENT_COORDINATES_PAYLOAD_LENGTH)
    return 18 if not client_coordinates.valid or client_coordinates.lines_start_at_one or not client_coordinates.columns_start_at_one
    invalid_client_coordinates_payload: mutable u8[INVALID_CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 108, 105, 110, 101, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 34, 102, 97, 108, 115, 101, 34, 125, 125]
    return 19 if DebuggerDAPPayload::client_coordinates_parse(invalid_client_coordinates_payload[0], INVALID_CLIENT_COORDINATES_PAYLOAD_LENGTH).valid
    nested_client_coordinates_payload: mutable u8[NESTED_CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 110, 101, 115, 116, 101, 100, 34, 58, 123, 34, 108, 105, 110, 101, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 125, 125, 125]
    nested_coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(nested_client_coordinates_payload[0], NESTED_CLIENT_COORDINATES_PAYLOAD_LENGTH)
    return 20 if not nested_coordinates.valid or not nested_coordinates.lines_start_at_one
    escaped_client_coordinates_payload: mutable u8[ESCAPED_CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 108, 105, 110, 101, 115, 92, 117, 48, 48, 53, 51, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 44, 34, 99, 111, 108, 117, 109, 110, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 125, 125]
    escaped_coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(escaped_client_coordinates_payload[0], ESCAPED_CLIENT_COORDINATES_PAYLOAD_LENGTH)
    return 21 if not escaped_coordinates.valid
    return 22 if escaped_coordinates.lines_start_at_one
    return 23 if escaped_coordinates.columns_start_at_one
    variables_request_json: cstr = "{\"arguments\":{\"variablesReference\":7,\"start\":2,\"count\":3}}"
    variables_request: DebuggerDAPPayload::VariablesRequest = DebuggerDAPPayload::variables_request_parse(variables_request_json.cast[u8&], VARIABLES_REQUEST_LENGTH)
    return 30 if not variables_request.valid or variables_request.reference != VARIABLES_EXPECTED_REFERENCE or variables_request.start != VARIABLES_EXPECTED_START or variables_request.count != VARIABLES_EXPECTED_COUNT or not variables_request.has_count
    variables_required_json: cstr = "{\"arguments\":{\"variablesReference\":7}}"
    variables_required: DebuggerDAPPayload::VariablesRequest = DebuggerDAPPayload::variables_request_parse(variables_required_json.cast[u8&], VARIABLES_REQUIRED_FIELDS_LENGTH)
    return 31 if not variables_required.valid or variables_required.reference != VARIABLES_EXPECTED_REFERENCE or variables_required.has_count
    variables_nested_json: cstr = "{\"arguments\":{\"nested\":{\"variablesReference\":7}}}"
    return 32 if DebuggerDAPPayload::variables_request_parse(variables_nested_json.cast[u8&], VARIABLES_NESTED_REFERENCE_LENGTH).valid
    variables_duplicate_json: cstr = "{\"arguments\":{\"variablesReference\":7,\"variablesReference\":8}}"
    return 33 if DebuggerDAPPayload::variables_request_parse(variables_duplicate_json.cast[u8&], VARIABLES_DUPLICATE_REFERENCE_LENGTH).valid
    variables_zero_json: cstr = "{\"arguments\":{\"variablesReference\":7,\"count\":0}}"
    variables_zero: DebuggerDAPPayload::VariablesRequest = DebuggerDAPPayload::variables_request_parse(variables_zero_json.cast[u8&], VARIABLES_ZERO_COUNT_LENGTH)
    return 34 if not variables_zero.valid or not variables_zero.has_count or variables_zero.count != 0
    variables_overflow_json: cstr = "{\"arguments\":{\"variablesReference\":18446744073709551616}}"
    return 35 if DebuggerDAPPayload::variables_request_parse(variables_overflow_json.cast[u8&], VARIABLES_REFERENCE_OVERFLOW_LENGTH).valid
    variables_start_overflow_json: cstr = "{\"arguments\":{\"variablesReference\":7,\"start\":65}}"
    return 36 if DebuggerDAPPayload::variables_request_parse(variables_start_overflow_json.cast[u8&], VARIABLES_START_OVERFLOW_LENGTH).valid
    variables_nested_arguments_json: cstr = "{\"arguments\":{\"variablesReference\":7,\"start\":2,\"count\":3},\"nested\":{\"arguments\":{\"variablesReference\":8}}}"
    variables_nested_arguments: DebuggerDAPPayload::VariablesRequest = DebuggerDAPPayload::variables_request_parse(variables_nested_arguments_json.cast[u8&], VARIABLES_NESTED_ARGUMENTS_LENGTH)
    return 37 if not variables_nested_arguments.valid or variables_nested_arguments.reference != VARIABLES_EXPECTED_REFERENCE
    variables_full_request_json: cstr = "{\"seq\":9,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{\"variablesReference\":5}}"
    variables_full_request: DebuggerDAPPayload::VariablesRequest = DebuggerDAPPayload::variables_request_parse(variables_full_request_json.cast[u8&], VARIABLES_FULL_REQUEST_LENGTH)
    return 38 if not variables_full_request.valid or variables_full_request.reference != VARIABLES_FULL_EXPECTED_REFERENCE
    return 0
