    INVALID_FALSE_SUFFIX_FAILURE: i64 = 57

    const module BreakpointConditionTest:
        ESCAPED_WHITESPACE_LENGTH: usize = 97
        EXPRESSION_LENGTH: usize = 6
        FIRST_TAB_INDEX: usize = 1
        SECOND_TAB_INDEX: usize = 4
        TAB_BYTE: u8 = 9
        ESCAPED_WHITESPACE_FAILURE: i64 = 74


def main() -> i64:
    valid: mutable u8[Test::VALID_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    parsed: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(valid[0], Test::VALID_LENGTH)
    return 10 if not parsed.valid
    return 11 if parsed.address != Test::EXPECTED_ADDRESS
    return 12 if parsed.count != Test::EXPECTED_COUNT
    positive_offset_payload: mutable u8[Test::POSITIVE_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 53, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    positive_offset: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(positive_offset_payload[0], Test::POSITIVE_MEMORY_OFFSET_LENGTH)
    return 24 if not positive_offset.valid or positive_offset.address != Test::EXPECTED_ADDRESS + 5 or positive_offset.count != Test::EXPECTED_COUNT
    negative_offset_payload: mutable u8[Test::NEGATIVE_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 45, 53, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    negative_offset: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(negative_offset_payload[0], Test::NEGATIVE_MEMORY_OFFSET_LENGTH)
    return 25 if not negative_offset.valid or negative_offset.address != Test::EXPECTED_ADDRESS - 5
    offset_underflow_payload: mutable u8[Test::UNDERFLOW_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 45, 57, 57, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    return 26 if DebuggerDAPPayload::memory_request_parse(offset_underflow_payload[0], Test::UNDERFLOW_MEMORY_OFFSET_LENGTH).valid
    memory_offset_overflow_payload: mutable u8[Test::MEMORY_OFFSET_OVERFLOW_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 49, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    return 27 if DebuggerDAPPayload::memory_request_parse(memory_offset_overflow_payload[0], Test::MEMORY_OFFSET_OVERFLOW_LENGTH).valid
    extra_nested_count_payload: mutable u8[Test::EXTRA_NESTED_COUNT_LENGTH] = [123, 34, 109, 101, 116, 97, 100, 97, 116, 97, 34, 58, 123, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    scoped_memory: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(extra_nested_count_payload[0], Test::EXTRA_NESTED_COUNT_LENGTH)
    return 28 if not scoped_memory.valid or scoped_memory.address != Test::EXPECTED_ADDRESS or scoped_memory.count != Test::EXPECTED_COUNT
    top_level_memory_reference_payload: mutable u8[Test::TOP_LEVEL_MEMORY_REFERENCE_LENGTH] = [123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    return 29 if DebuggerDAPPayload::memory_request_parse(top_level_memory_reference_payload[0], Test::TOP_LEVEL_MEMORY_REFERENCE_LENGTH).valid
    invalid_count: mutable u8[Test::INVALID_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 48, 52, 125, 125]
    return 2 if DebuggerDAPPayload::memory_request_parse(invalid_count[0], Test::INVALID_COUNT_LENGTH).valid
    over_limit: mutable u8[Test::OVER_LIMIT_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 54, 53, 125, 125]
    return 3 if DebuggerDAPPayload::memory_request_parse(over_limit[0], Test::OVER_LIMIT_COUNT_LENGTH).valid
    duplicate: mutable u8[Test::DUPLICATE_COUNT_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 44, 34, 99, 111, 117, 110, 116, 34, 58, 53, 125, 125]
    return 4 if DebuggerDAPPayload::memory_request_parse(duplicate[0], Test::DUPLICATE_COUNT_LENGTH).valid
    malformed_reference: mutable u8[Test::VALID_LENGTH] = valid
    malformed_reference[38] <- 120
    return 5 if DebuggerDAPPayload::memory_request_parse(malformed_reference[0], Test::VALID_LENGTH).valid
    program_payload: mutable u8[Test::PROGRAM_PATH_PAYLOAD_LENGTH] = [123, 34, 116, 121, 112, 101, 34, 58, 34, 114, 101, 113, 117, 101, 115, 116, 34, 44, 34, 99, 111, 109, 109, 97, 110, 100, 34, 58, 34, 108, 97, 117, 110, 99, 104, 34, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 98, 117, 105, 108, 100, 92, 117, 48, 48, 50, 102, 108, 97, 117, 110, 99, 104, 46, 101, 100, 105, 114, 34, 125, 125]
    program_path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(program_payload[0], Test::PROGRAM_PATH_PAYLOAD_LENGTH)
    return 6 if not program_path.valid or program_path.length != Test::EXPECTED_PROGRAM_PATH_LENGTH
    return 7 if program_path.bytes[Test::PROGRAM_PATH_SEPARATOR_INDEX] != Test::PROGRAM_PATH_SEPARATOR
    missing_program: mutable u8[Test::VALID_LENGTH] = valid
    return 8 if DebuggerDAPPayload::program_path_parse(missing_program[0], Test::VALID_LENGTH).valid
    duplicate_program: mutable u8[Test::DUPLICATE_PROGRAM_PAYLOAD_LENGTH] = zeroed
    for index in 0..<Test::PROGRAM_PATH_PAYLOAD_LENGTH:
        duplicate_program[index] <- program_payload[index]
    duplicate_suffix: u8[Test::DUPLICATE_PROGRAM_SUFFIX_LENGTH] = [44, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 120, 34, 125, 125]
    for index in 0..<Test::DUPLICATE_PROGRAM_SUFFIX_LENGTH:
        duplicate_program[Test::PROGRAM_PATH_PAYLOAD_LENGTH - Test::TRAILING_OBJECT_DELIMITERS + index] <- duplicate_suffix[index]
    return 9 if DebuggerDAPPayload::program_path_parse(duplicate_program[0], Test::DUPLICATE_PROGRAM_PAYLOAD_LENGTH).valid
    unicode_payload: mutable u8[Test::UNICODE_PROGRAM_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 98, 117, 105, 108, 100, 92, 117, 68, 56, 51, 68, 92, 117, 68, 69, 48, 48, 46, 101, 100, 105, 114, 34, 125, 125]
    unicode_path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(unicode_payload[0], Test::UNICODE_PROGRAM_PAYLOAD_LENGTH)
    return 10 if not unicode_path.valid or unicode_path.length != Test::UNICODE_PROGRAM_PATH_LENGTH
    return 11 if unicode_path.bytes[Test::UNICODE_FIRST_BYTE_INDEX] != Test::UNICODE_UTF8_FIRST_BYTE or unicode_path.bytes[Test::UNICODE_SECOND_BYTE_INDEX] != Test::UNICODE_UTF8_SECOND_BYTE or unicode_path.bytes[Test::UNICODE_THIRD_BYTE_INDEX] != Test::UNICODE_UTF8_THIRD_BYTE or unicode_path.bytes[Test::UNICODE_FOURTH_BYTE_INDEX] != Test::UNICODE_UTF8_FOURTH_BYTE
    invalid_utf8_payload: mutable u8[Test::PROGRAM_PATH_PAYLOAD_LENGTH] = program_payload
    invalid_utf8_payload[Test::PATH_FIRST_BYTE_INDEX] <- Test::INVALID_UTF8_LEAD_BYTE
    return 12 if DebuggerDAPPayload::program_path_parse(invalid_utf8_payload[0], Test::PROGRAM_PATH_PAYLOAD_LENGTH).valid
    decoy_program_payload: mutable u8[Test::DECOY_PROGRAM_PAYLOAD_LENGTH] = [123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 100, 101, 99, 111, 121, 34, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 97, 99, 116, 117, 97, 108, 46, 101, 100, 105, 114, 34, 44, 34, 110, 101, 115, 116, 101, 100, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 111, 116, 104, 101, 114, 34, 125, 125, 125]
    decoded_decoy_path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(decoy_program_payload[0], Test::DECOY_PROGRAM_PAYLOAD_LENGTH)
    return 13 if not decoded_decoy_path.valid or decoded_decoy_path.length != Test::EXPECTED_DECODED_PATH_LENGTH or decoded_decoy_path.bytes[0] != Test::EXPECTED_DECODED_PATH_FIRST_BYTE or decoded_decoy_path.bytes[Test::EXPECTED_DECODED_PATH_DOT_INDEX] != Test::EXPECTED_DECODED_PATH_DOT
    decoy_only_payload: mutable u8[Test::DECOY_ONLY_PAYLOAD_LENGTH] = [123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 100, 101, 99, 111, 121, 34, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 110, 101, 115, 116, 101, 100, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 111, 116, 104, 101, 114, 34, 125, 125, 125]
    return 14 if DebuggerDAPPayload::program_path_parse(decoy_only_payload[0], Test::DECOY_ONLY_PAYLOAD_LENGTH).valid
    duplicate_arguments_payload: mutable u8[Test::DUPLICATE_ARGUMENTS_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 111, 110, 101, 34, 125, 44, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 112, 114, 111, 103, 114, 97, 109, 34, 58, 34, 116, 119, 111, 34, 125, 125]
    return 15 if DebuggerDAPPayload::program_path_parse(duplicate_arguments_payload[0], Test::DUPLICATE_ARGUMENTS_PAYLOAD_LENGTH).valid
    whitespace_program_payload: mutable u8[Test::WHITESPACE_PROGRAM_PAYLOAD_LENGTH] = zeroed
    whitespace_program_payload[0] <- Test::JSON_WHITESPACE_SPACE
    whitespace_program_payload[1] <- Test::JSON_WHITESPACE_LINE_FEED
    for index in 0..<Test::PROGRAM_PATH_PAYLOAD_LENGTH:
        whitespace_program_payload[index + Test::JSON_WHITESPACE_PREFIX_LENGTH] <- program_payload[index]
    whitespace_path: DebuggerDAPPayload::ProgramPath = DebuggerDAPPayload::program_path_parse(whitespace_program_payload[0], Test::WHITESPACE_PROGRAM_PAYLOAD_LENGTH)
    return 16 if not whitespace_path.valid or whitespace_path.length != Test::EXPECTED_PROGRAM_PATH_LENGTH
    default_coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(program_payload[0], Test::PROGRAM_PATH_PAYLOAD_LENGTH)
    return 17 if not default_coordinates.valid or not default_coordinates.lines_start_at_one or not default_coordinates.columns_start_at_one
    client_coordinates_payload: mutable u8[Test::CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 108, 105, 110, 101, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 44, 34, 99, 111, 108, 117, 109, 110, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 116, 114, 117, 101, 125, 125]
    client_coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(client_coordinates_payload[0], Test::CLIENT_COORDINATES_PAYLOAD_LENGTH)
    return 18 if not client_coordinates.valid or client_coordinates.lines_start_at_one or not client_coordinates.columns_start_at_one
    invalid_client_coordinates_payload: mutable u8[Test::INVALID_CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 108, 105, 110, 101, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 34, 102, 97, 108, 115, 101, 34, 125, 125]
    return 19 if DebuggerDAPPayload::client_coordinates_parse(invalid_client_coordinates_payload[0], Test::INVALID_CLIENT_COORDINATES_PAYLOAD_LENGTH).valid
    invalid_true_suffix_json: cstr = "{\"arguments\":{\"linesStartAt1\":truefalse}}"
    return Test::INVALID_TRUE_SUFFIX_FAILURE if DebuggerDAPPayload::client_coordinates_parse(invalid_true_suffix_json.cast[u8&], Test::INVALID_TRUE_SUFFIX_LENGTH).valid
    invalid_false_suffix_json: cstr = "{\"arguments\":{\"linesStartAt1\":falsex}}"
    return Test::INVALID_FALSE_SUFFIX_FAILURE if DebuggerDAPPayload::client_coordinates_parse(invalid_false_suffix_json.cast[u8&], Test::INVALID_FALSE_SUFFIX_LENGTH).valid
    nested_client_coordinates_payload: mutable u8[Test::NESTED_CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 110, 101, 115, 116, 101, 100, 34, 58, 123, 34, 108, 105, 110, 101, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 125, 125, 125]
    nested_coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(nested_client_coordinates_payload[0], Test::NESTED_CLIENT_COORDINATES_PAYLOAD_LENGTH)
    return 20 if not nested_coordinates.valid or not nested_coordinates.lines_start_at_one
    escaped_client_coordinates_payload: mutable u8[Test::ESCAPED_CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 108, 105, 110, 101, 115, 92, 117, 48, 48, 53, 51, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 44, 34, 99, 111, 108, 117, 109, 110, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 125, 125]
    escaped_coordinates: DebuggerDAPPayload::ClientCoordinates = DebuggerDAPPayload::client_coordinates_parse(escaped_client_coordinates_payload[0], Test::ESCAPED_CLIENT_COORDINATES_PAYLOAD_LENGTH)
    return 21 if not escaped_coordinates.valid
    return 22 if escaped_coordinates.lines_start_at_one
    return 23 if escaped_coordinates.columns_start_at_one
