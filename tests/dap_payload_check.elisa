const PROGRAM_PATH_SEPARATOR: u8 = 47
const DUPLICATE_PROGRAM_SUFFIX_LENGTH: usize = 16
const TRAILING_OBJECT_DELIMITERS: usize = 2
const DUPLICATE_PROGRAM_PAYLOAD_LENGTH: usize = PROGRAM_PATH_PAYLOAD_LENGTH + DUPLICATE_PROGRAM_SUFFIX_LENGTH - TRAILING_OBJECT_DELIMITERS
const UNICODE_PROGRAM_PAYLOAD_LENGTH: usize = 50
const UNICODE_PROGRAM_PATH_LENGTH: usize = 14
const UNICODE_FIRST_BYTE_INDEX: usize = 5
const UNICODE_SECOND_BYTE_INDEX: usize = 6
const UNICODE_THIRD_BYTE_INDEX: usize = 7
const UNICODE_FOURTH_BYTE_INDEX: usize = 8
const UNICODE_UTF8_FIRST_BYTE: u8 = 240
const UNICODE_UTF8_SECOND_BYTE: u8 = 159
const UNICODE_UTF8_THIRD_BYTE: u8 = 152
const UNICODE_UTF8_FOURTH_BYTE: u8 = 128
const PATH_FIRST_BYTE_INDEX: usize = 62
const INVALID_UTF8_LEAD_BYTE: u8 = 255
const DECOY_PROGRAM_PAYLOAD_LENGTH: usize = 86
const DECOY_ONLY_PAYLOAD_LENGTH: usize = 62
const DUPLICATE_ARGUMENTS_PAYLOAD_LENGTH: usize = 61
