def check_source_breakpoint_payloads() -> i64:
    source_breakpoints_json: cstr = "{\"arguments\":{\"source\":{\"name\":\"main.elisa\",\"sourceReference\":7},\"breakpoints\":[{\"line\":41},{\"line\":42}]}}"
    source_breakpoints: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoints_json.cast[u8&], Test::SOURCE_BREAKPOINT_REQUEST_LENGTH)
    return 40 if not source_breakpoints.valid or source_breakpoints.source_reference != Test::SOURCE_BREAKPOINT_FILE_ID or source_breakpoints.count != 2
    return 41 if source_breakpoints.lines[0] != Test::SOURCE_BREAKPOINT_FIRST_LINE or source_breakpoints.lines[1] != Test::SOURCE_BREAKPOINT_SECOND_LINE
    source_breakpoint_lines_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"lines\":[41,42]}}"
    source_breakpoint_lines: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_lines_json.cast[u8&], Test::SOURCE_BREAKPOINT_LINES_LENGTH)
    return 42 if not source_breakpoint_lines.valid or source_breakpoint_lines.count != 2 or source_breakpoint_lines.lines[1] != Test::SOURCE_BREAKPOINT_SECOND_LINE
    return Test::SOURCE_BREAKPOINT_LINE_ONLY_HAS_COLUMN_FAILURE if source_breakpoint_lines.has_columns[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX]
    source_breakpoint_invalid_reference_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":0},\"breakpoints\":[]}}"
    return 43 if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_invalid_reference_json.cast[u8&], Test::SOURCE_BREAKPOINT_INVALID_REFERENCE_LENGTH).valid
    source_breakpoint_path_only_json: cstr = "{\"arguments\":{\"source\":{\"path\":\"main.elisa\"},\"breakpoints\":[]}}"
    source_breakpoint_path_only: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_path_only_json.cast[u8&], Test::SOURCE_BREAKPOINT_PATH_ONLY_LENGTH)
    return 44 if not source_breakpoint_path_only.valid or source_breakpoint_path_only.has_source_reference or not source_breakpoint_path_only.has_source_path or source_breakpoint_path_only.source_path.length != Test::SOURCE_BREAKPOINT_PATH_LENGTH or source_breakpoint_path_only.source_path.bytes[0] != Test::SOURCE_BREAKPOINT_PATH_FIRST_BYTE
    source_breakpoint_zero_reference_with_path_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":0,\"path\":\"main.elisa\"},\"breakpoints\":[]}}"
    source_breakpoint_zero_reference_with_path: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_zero_reference_with_path_json.cast[u8&], Test::SOURCE_BREAKPOINT_ZERO_REFERENCE_WITH_PATH_LENGTH)
    return Test::SOURCE_BREAKPOINT_ZERO_REFERENCE_WITH_PATH_FAILURE if not source_breakpoint_zero_reference_with_path.valid or not source_breakpoint_zero_reference_with_path.has_source_reference or source_breakpoint_zero_reference_with_path.source_reference != 0 or not source_breakpoint_zero_reference_with_path.has_source_path
    source_breakpoint_duplicate_path_json: cstr = "{\"arguments\":{\"source\":{\"path\":\"main.elisa\",\"path\":\"other.elisa\"},\"breakpoints\":[]}}"
    return Test::SOURCE_BREAKPOINT_DUPLICATE_PATH_FAILURE if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_duplicate_path_json.cast[u8&], Test::SOURCE_BREAKPOINT_DUPLICATE_PATH_LENGTH).valid
    source_breakpoint_nested_line_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"other\":{\"line\":41}}]}}"
    return 45 if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_nested_line_json.cast[u8&], Test::SOURCE_BREAKPOINT_NESTED_LINE_LENGTH).valid
    source_breakpoint_duplicate_line_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"line\":42}]}}"
    return 46 if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_duplicate_line_json.cast[u8&], Test::SOURCE_BREAKPOINT_DUPLICATE_LINE_LENGTH).valid
    source_breakpoint_clear_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[]}}"
    source_breakpoint_clear: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_clear_json.cast[u8&], Test::SOURCE_BREAKPOINT_CLEAR_LENGTH)
    return 47 if not source_breakpoint_clear.valid or source_breakpoint_clear.count != 0 or source_breakpoint_clear.source_reference != Test::SOURCE_BREAKPOINT_FILE_ID
    source_path_root_json: cstr = "{\"arguments\":{\"sourcePathRoot\":\"/workspace/project\"}}"
    source_path_root: DebuggerDAPPayload::SourcePathRootRequest = DebuggerDAPPayload::source_path_root_parse(source_path_root_json.cast[u8&], Test::SOURCE_PATH_ROOT_REQUEST_LENGTH)
    return 54 if not source_path_root.valid or not source_path_root.has_root or source_path_root.root.length != Test::SOURCE_PATH_ROOT_EXPECTED_LENGTH or source_path_root.root.bytes[0] != Test::SOURCE_PATH_ROOT_FIRST_BYTE
    source_path_root_duplicate_json: cstr = "{\"arguments\":{\"sourcePathRoot\":\"/workspace\",\"sourcePathRoot\":\"/other\"}}"
    return 55 if DebuggerDAPPayload::source_path_root_parse(source_path_root_duplicate_json.cast[u8&], Test::SOURCE_PATH_ROOT_DUPLICATE_LENGTH).valid
    source_breakpoint_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"condition\":\"x\"}]}}"
    source_breakpoint_condition: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_condition_json.cast[u8&], Test::SOURCE_BREAKPOINT_CONDITION_LENGTH)
    return 48 if not source_breakpoint_condition.valid or not source_breakpoint_condition.conditions[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].has_condition or source_breakpoint_condition.conditions[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].length != Test::SOURCE_BREAKPOINT_EXPECTED_CONDITION_LENGTH or source_breakpoint_condition.breakpoint_text_bytes[source_breakpoint_condition.conditions[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].offset] != Test::SOURCE_BREAKPOINT_EXPECTED_CONDITION_BYTE
    source_breakpoint_escaped_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"condition\":\"1\\t==\\t1\"}]}}"
    source_breakpoint_escaped_condition: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_escaped_condition_json.cast[u8&], Test::BreakpointConditionTest::ESCAPED_WHITESPACE_LENGTH)
    escaped_condition: DebuggerDAPPayload::BreakpointConditionReference = source_breakpoint_escaped_condition.conditions[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX]
    return Test::BreakpointConditionTest::ESCAPED_WHITESPACE_FAILURE if not source_breakpoint_escaped_condition.valid or not escaped_condition.has_condition or escaped_condition.length != Test::BreakpointConditionTest::EXPRESSION_LENGTH or source_breakpoint_escaped_condition.breakpoint_text_bytes[escaped_condition.offset + Test::BreakpointConditionTest::FIRST_TAB_INDEX] != Test::BreakpointConditionTest::TAB_BYTE or source_breakpoint_escaped_condition.breakpoint_text_bytes[escaped_condition.offset + Test::BreakpointConditionTest::SECOND_TAB_INDEX] != Test::BreakpointConditionTest::TAB_BYTE
    source_breakpoint_duplicate_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"condition\":\"x\",\"condition\":\"y\"}]}}"
    return Test::SOURCE_BREAKPOINT_DUPLICATE_CONDITION_RESULT if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_duplicate_condition_json.cast[u8&], Test::SOURCE_BREAKPOINT_DUPLICATE_CONDITION_LENGTH).valid
    source_breakpoint_column_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"column\":2}]}}"
    source_breakpoint_column: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_column_json.cast[u8&], Test::SOURCE_BREAKPOINT_COLUMN_LENGTH)
    return 49 if not source_breakpoint_column.valid or source_breakpoint_column.count != Test::SOURCE_BREAKPOINT_COLUMN_EXPECTED_COUNT or not source_breakpoint_column.has_columns[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX] or source_breakpoint_column.columns[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX] != Test::SOURCE_BREAKPOINT_EXPECTED_COLUMN
    source_breakpoint_hit_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"hitCondition\":\"2\"}]}}"
    source_breakpoint_hit_condition: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_hit_condition_json.cast[u8&], Test::SOURCE_BREAKPOINT_HIT_CONDITION_LENGTH)
    return 50 if not source_breakpoint_hit_condition.valid or not source_breakpoint_hit_condition.has_hit_targets[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX] or source_breakpoint_hit_condition.hit_targets[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX] != Test::SOURCE_BREAKPOINT_EXPECTED_HIT_TARGET
    source_breakpoint_invalid_hit_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"hitCondition\":\">=2\"}]}}"
    return Test::SOURCE_BREAKPOINT_INVALID_HIT_CONDITION_RESULT if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_invalid_hit_condition_json.cast[u8&], Test::SOURCE_BREAKPOINT_HIT_CONDITION_INVALID_LENGTH).valid
    source_breakpoint_duplicate_hit_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"hitCondition\":\"2\",\"hitCondition\":\"3\"}]}}"
    return Test::SOURCE_BREAKPOINT_DUPLICATE_HIT_CONDITION_RESULT if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_duplicate_hit_condition_json.cast[u8&], Test::SOURCE_BREAKPOINT_HIT_CONDITION_DUPLICATE_LENGTH).valid
    source_breakpoint_zero_hit_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"hitCondition\":\"0\"}]}}"
    return Test::SOURCE_BREAKPOINT_ZERO_HIT_CONDITION_RESULT if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_zero_hit_condition_json.cast[u8&], Test::SOURCE_BREAKPOINT_HIT_CONDITION_LENGTH).valid
    source_breakpoint_max_hit_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"hitCondition\":\"18446744073709551615\"}]}}"
    source_breakpoint_max_hit_condition: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_max_hit_condition_json.cast[u8&], Test::SOURCE_BREAKPOINT_HIT_CONDITION_BOUNDARY_LENGTH)
    return Test::SOURCE_BREAKPOINT_OVERFLOW_HIT_CONDITION_RESULT if not source_breakpoint_max_hit_condition.valid or source_breakpoint_max_hit_condition.hit_targets[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX] != Test::SOURCE_BREAKPOINT_MAX_HIT_TARGET
    source_breakpoint_overflow_hit_condition_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"hitCondition\":\"18446744073709551616\"}]}}"
    return Test::SOURCE_BREAKPOINT_OVERFLOW_HIT_CONDITION_RESULT if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_overflow_hit_condition_json.cast[u8&], Test::SOURCE_BREAKPOINT_HIT_CONDITION_BOUNDARY_LENGTH).valid
    source_breakpoint_log_message_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"logMessage\":\"x\"}]}}"
    source_breakpoint_log_message: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_log_message_json.cast[u8&], Test::SOURCE_BREAKPOINT_LOG_MESSAGE_LENGTH)
    return Test::SOURCE_BREAKPOINT_LOG_INVALID_FAILURE if not source_breakpoint_log_message.valid
    return Test::SOURCE_BREAKPOINT_LOG_MISSING_FAILURE if not source_breakpoint_log_message.log_messages[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].has_message
    return Test::SOURCE_BREAKPOINT_LOG_LENGTH_FAILURE if source_breakpoint_log_message.log_messages[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].length != Test::SOURCE_BREAKPOINT_LOG_MESSAGE_SHORT_LENGTH
    return Test::SOURCE_BREAKPOINT_LOG_BYTE_FAILURE if source_breakpoint_log_message.breakpoint_text_bytes[source_breakpoint_log_message.log_messages[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].offset] != Test::SOURCE_BREAKPOINT_LOG_MESSAGE_SHORT_FIRST_BYTE
    source_breakpoint_log_template_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"logMessage\":\"v={local0}\\n\"}]}}"
    source_breakpoint_log_template: DebuggerDAPPayload::SourceBreakpointsRequest = DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_log_template_json.cast[u8&], Test::SOURCE_BREAKPOINT_LOG_MESSAGE_TEMPLATE_LENGTH)
    return Test::SOURCE_BREAKPOINT_LOG_TEMPLATE_FAILURE if not source_breakpoint_log_template.valid or not source_breakpoint_log_template.log_messages[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].has_message or source_breakpoint_log_template.log_messages[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].length != Test::SOURCE_BREAKPOINT_LOG_MESSAGE_EXPECTED_LENGTH or source_breakpoint_log_template.breakpoint_text_bytes[source_breakpoint_log_template.log_messages[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].offset] != Test::SOURCE_BREAKPOINT_LOG_MESSAGE_FIRST_BYTE or source_breakpoint_log_template.breakpoint_text_bytes[source_breakpoint_log_template.log_messages[Test::SOURCE_BREAKPOINT_FIRST_REQUEST_INDEX].offset + Test::SOURCE_BREAKPOINT_LOG_MESSAGE_NEWLINE_INDEX] != Test::SOURCE_BREAKPOINT_LOG_MESSAGE_NEWLINE
    source_breakpoint_duplicate_log_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"logMessage\":\"x\",\"logMessage\":\"y\"}]}}"
    return Test::SOURCE_BREAKPOINT_DUPLICATE_LOG_MESSAGE_FAILURE if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_duplicate_log_json.cast[u8&], Test::SOURCE_BREAKPOINT_DUPLICATE_LOG_MESSAGE_LENGTH).valid
    source_breakpoint_invalid_log_json: cstr = "{\"arguments\":{\"source\":{\"sourceReference\":7},\"breakpoints\":[{\"line\":41,\"logMessage\":12}]}}"
    return Test::SOURCE_BREAKPOINT_INVALID_LOG_MESSAGE_FAILURE if DebuggerDAPPayload::source_breakpoints_request_parse(source_breakpoint_invalid_log_json.cast[u8&], Test::SOURCE_BREAKPOINT_INVALID_LOG_MESSAGE_LENGTH).valid
    return 0

def check_function_breakpoint_payloads() -> i64:
    parsed: DebuggerDAPPayload::FunctionBreakpointsRequest = DebuggerDAPPayload::function_breakpoints_request_parse(Test::FunctionBreakpointTest::REQUEST_JSON.cast[u8&], Test::FunctionBreakpointTest::REQUEST_LENGTH)
    return Test::FunctionBreakpointTest::PARSE_FAILURE if not parsed.valid or parsed.count != 1 or parsed.breakpoint_text_bytes_length != Test::FunctionBreakpointTest::NAME_LENGTH + Test::FunctionBreakpointTest::CONDITION_LENGTH
    return Test::FunctionBreakpointTest::PARSE_FAILURE if parsed.name_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] != Test::FunctionBreakpointTest::NAME_OFFSET or parsed.name_lengths[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] != Test::FunctionBreakpointTest::NAME_LENGTH or parsed.breakpoint_text_bytes[parsed.name_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX]] != Test::FunctionBreakpointTest::NAME_FIRST_BYTE
    return Test::FunctionBreakpointTest::PARSE_FAILURE if not parsed.has_conditions[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] or parsed.condition_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] != Test::FunctionBreakpointTest::CONDITION_OFFSET or parsed.condition_lengths[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] != Test::FunctionBreakpointTest::CONDITION_LENGTH or parsed.breakpoint_text_bytes[parsed.condition_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX]] != Test::FunctionBreakpointTest::CONDITION_FIRST_BYTE
    return Test::FunctionBreakpointTest::PARSE_FAILURE if not parsed.has_hit_targets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] or parsed.hit_targets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] != Test::FunctionBreakpointTest::HIT_TARGET
    empty: DebuggerDAPPayload::FunctionBreakpointsRequest = DebuggerDAPPayload::function_breakpoints_request_parse(Test::FunctionBreakpointTest::EMPTY_REQUEST_JSON.cast[u8&], Test::FunctionBreakpointTest::EMPTY_REQUEST_LENGTH)
    return Test::FunctionBreakpointTest::EMPTY_FAILURE if not empty.valid or empty.count != 0
    return Test::FunctionBreakpointTest::MISSING_NAME_FAILURE if DebuggerDAPPayload::function_breakpoints_request_parse(Test::FunctionBreakpointTest::MISSING_NAME_JSON.cast[u8&], Test::FunctionBreakpointTest::MISSING_NAME_LENGTH).valid
    return Test::FunctionBreakpointTest::DUPLICATE_NAME_FAILURE if DebuggerDAPPayload::function_breakpoints_request_parse(Test::FunctionBreakpointTest::DUPLICATE_NAME_JSON.cast[u8&], Test::FunctionBreakpointTest::DUPLICATE_NAME_LENGTH).valid
    return Test::FunctionBreakpointTest::INVALID_HIT_CONDITION_FAILURE if DebuggerDAPPayload::function_breakpoints_request_parse(Test::FunctionBreakpointTest::INVALID_HIT_CONDITION_JSON.cast[u8&], Test::FunctionBreakpointTest::INVALID_HIT_CONDITION_LENGTH).valid
    return Test::FunctionBreakpointTest::DUPLICATE_CONDITION_FAILURE if DebuggerDAPPayload::function_breakpoints_request_parse(Test::FunctionBreakpointTest::DUPLICATE_CONDITION_JSON.cast[u8&], Test::FunctionBreakpointTest::DUPLICATE_CONDITION_LENGTH).valid
    return 0

const module ClientOptionsFailure:
    TYPE_SUPPORT_PARSE: i64 = 62
    INVALID_TYPE_SUPPORT_ACCEPTED: i64 = 63
    DUPLICATE_TYPE_SUPPORT_ACCEPTED: i64 = 64

def main() -> i64:
    valid: mutable u8[Test::VALID_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    parsed: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(valid[0], Test::VALID_LENGTH)
    return 10 if not parsed.valid
    return 11 if parsed.address != Test::EXPECTED_ADDRESS
    return 12 if parsed.count != Test::EXPECTED_COUNT
    positive_offset_payload: mutable u8[Test::POSITIVE_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 53, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    positive_offset: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(positive_offset_payload[0], Test::POSITIVE_MEMORY_OFFSET_LENGTH)
    return 24 if not positive_offset.valid or positive_offset.address != Test::EXPECTED_ADDRESS + 5 or positive_offset.count != Test::EXPECTED_COUNT
    negative_offset_payload: mutable u8[Test::NEGATIVE_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 45, 53, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    negative_offset: DebuggerDAPPayload::MemoryRequest = DebuggerDAPPayload::memory_request_parse(negative_offset_payload[0], Test::NEGATIVE_MEMORY_OFFSET_LENGTH)
    return 25 if not negative_offset.valid or negative_offset.address != Test::EXPECTED_ADDRESS - 5
    offset_underflow_payload: mutable u8[Test::UNDERFLOW_MEMORY_OFFSET_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 109, 101, 109, 111, 114, 121, 82, 101, 102, 101, 114, 101, 110, 99, 101, 34, 58, 34, 48, 120, 49, 102, 34, 44, 34, 111, 102, 102, 115, 101, 116, 34, 58, 45, 57, 57, 44, 34, 99, 111, 117, 110, 116, 34, 58, 52, 125, 125]
    return 26 if DebuggerDAPPayload::memory_request_parse(offset_underflow_payload[0], Test::UNDERFLOW_MEMORY_OFFSET_LENGTH).valid
