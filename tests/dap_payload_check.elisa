    return 20 if not nested_coordinates.valid or not nested_coordinates.lines_start_at_one
    escaped_client_coordinates_payload: mutable u8[Test::ESCAPED_CLIENT_COORDINATES_PAYLOAD_LENGTH] = [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 34, 58, 123, 34, 108, 105, 110, 101, 115, 92, 117, 48, 48, 53, 51, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 44, 34, 99, 111, 108, 117, 109, 110, 115, 83, 116, 97, 114, 116, 65, 116, 49, 34, 58, 102, 97, 108, 115, 101, 125, 125]
    escaped_coordinates: DebuggerDAPPayload::ClientOptions = DebuggerDAPPayload::client_options_parse(escaped_client_coordinates_payload[0], Test::ESCAPED_CLIENT_COORDINATES_PAYLOAD_LENGTH)
    return 21 if not escaped_coordinates.valid
    return 22 if escaped_coordinates.lines_start_at_one
    return 23 if escaped_coordinates.columns_start_at_one
    variables_request_json: cstr = "{\"arguments\":{\"variablesReference\":7,\"start\":2,\"count\":3}}"
    variables_request: DebuggerDAPPayload::VariablesRequest = DebuggerDAPPayload::variables_request_parse(variables_request_json.cast[u8&], Test::VARIABLES_REQUEST_LENGTH)
    return 30 if not variables_request.valid or variables_request.reference != Test::VARIABLES_EXPECTED_REFERENCE or variables_request.start != Test::VARIABLES_EXPECTED_START or variables_request.count != Test::VARIABLES_EXPECTED_COUNT or not variables_request.has_count
    variables_required_json: cstr = "{\"arguments\":{\"variablesReference\":7}}"
