include "../src/vm/edir.elisa"
include "../src/core/identity.elisa"

const PROGRAM_VERSION: u32 = 1
const NO_LOCALS: u64 = 0
const LOOP_LOCAL_COUNT: u64 = 1
const LOOP_INSTRUCTION_COUNT: u64 = 10
const LOOP_LIMIT: i64 = 3
const LOOP_DECREMENT: i64 = -1
const LOOP_START: i64 = 2
const LOOP_EXIT: i64 = 8
const RUN_BUDGET: u64 = 64
const FIRST_LOCAL: i64 = 0
const OVERSIZED_ALLOCATION: i64 = 9223372036854775807
const I64_MAX_VALUE: i64 = 9223372036854775807
const I64_MIN_VALUE: i64 = -9223372036854775807 - 1

def main() -> i64:
    span: DebuggerIdentity::SourceSpan = zeroed
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: 5, local_count: NO_LOCALS, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 5, b: 0, source: span}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Call, a: 3, b: 0, source: span}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    image.instructions[3] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 7, b: 0, source: span}
    image.instructions[4] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_run(image, DebuggerEDIR::machine_new(), RUN_BUDGET)
    return 1 if DebuggerEDIR::machine_is_faulted(machine)
    return 2 if not DebuggerEDIR::machine_is_halted(machine)
    return 3 if machine.result != 7
    invalid_target: mutable DebuggerEDIR::ProgramImage = zeroed
    invalid_target.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: 2, local_count: NO_LOCALS, has_return: true}
    invalid_target.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Jump, a: 9, b: 0, source: span}
    invalid_target.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    target_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(invalid_target)
    return 4 if target_verification.valid or target_verification.verification_error != DebuggerEDIR::VerificationError.InvalidTarget
    invalid_source: mutable DebuggerEDIR::ProgramImage = zeroed
    invalid_source.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: 1, local_count: NO_LOCALS, has_return: true}
    invalid_span: mutable DebuggerIdentity::SourceSpan = zeroed
    invalid_span.start_byte <- 4
    invalid_span.end_byte <- 3
    invalid_source.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: invalid_span}
    source_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(invalid_source)
    return 5 if source_verification.valid or source_verification.verification_error != DebuggerEDIR::VerificationError.InvalidSourceRange
    invalid_depth: mutable DebuggerEDIR::ProgramImage = zeroed
    invalid_depth.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: 2, local_count: NO_LOCALS, has_return: true}
    invalid_depth.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Call, a: 1, b: 17, source: span}
    invalid_depth.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    depth_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(invalid_depth)
    return 6 if depth_verification.valid or depth_verification.verification_error != DebuggerEDIR::VerificationError.InvalidCallDepth
    negative_depth: mutable DebuggerEDIR::ProgramImage = invalid_depth
    negative_depth.instructions[0].b <- -1
    negative_depth_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(negative_depth)
    return 10 if negative_depth_verification.valid or negative_depth_verification.verification_error != DebuggerEDIR::VerificationError.InvalidOperand
    invalid_local: mutable DebuggerEDIR::ProgramImage = zeroed
    invalid_local.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: 2, local_count: 1, has_return: true}
    invalid_local.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.LoadLocal, a: FIRST_LOCAL, b: 0, source: span}
    invalid_local.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    local_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(invalid_local)
    return 7 if local_verification.valid or local_verification.verification_error != DebuggerEDIR::VerificationError.UninitializedLocal
    branch_local: mutable DebuggerEDIR::ProgramImage = zeroed
    branch_local.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: 6, local_count: LOOP_LOCAL_COUNT, has_return: true}
    branch_local.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 0, b: 0, source: span}
    branch_local.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.BranchZero, a: 4, b: 0, source: span}
    branch_local.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 1, b: 0, source: span}
    branch_local.instructions[3] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: 0, b: 0, source: span}
    branch_local.instructions[4] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.LoadLocal, a: 0, b: 0, source: span}
    branch_local.instructions[5] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    branch_local_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(branch_local)
    return 11 if branch_local_verification.valid or branch_local_verification.verification_error != DebuggerEDIR::VerificationError.UninitializedLocal
    invalid_local_direct: mutable DebuggerEDIR::ProgramImage = branch_local
    invalid_local_direct.instructions[3].a <- 999
    invalid_local_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_local_initialization(invalid_local_direct)
    return 14 if invalid_local_verification.valid or invalid_local_verification.verification_error != DebuggerEDIR::VerificationError.InvalidRegister
    oversized_image: mutable DebuggerEDIR::ProgramImage = branch_local
    oversized_image.program.instruction_count <- 257
    oversized_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_local_initialization(oversized_image)
    return 15 if oversized_verification.valid or oversized_verification.verification_error != DebuggerEDIR::VerificationError.InvalidTarget
    nonterminating: mutable DebuggerEDIR::ProgramImage = zeroed
    nonterminating.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: 2, local_count: NO_LOCALS, has_return: true}
    nonterminating.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Jump, a: 0, b: 0, source: span}
    nonterminating.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    nonterminating_verification: DebuggerEDIR::Verification = DebuggerEDIR::verify_image(nonterminating)
    return 12 if nonterminating_verification.valid or nonterminating_verification.verification_error != DebuggerEDIR::VerificationError.MissingReturn
    memory_image: mutable DebuggerEDIR::ProgramImage = zeroed
    memory_image.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: 5, local_count: NO_LOCALS, has_return: true}
    memory_image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Allocate, a: 2, b: 0, source: span}
    memory_image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 37, b: 0, source: span}
    memory_image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreMemory, a: 0, b: 0, source: span}
    memory_image.instructions[3] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.LoadMemory, a: 0, b: 0, source: span}
    memory_image.instructions[4] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    memory_machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_run(memory_image, DebuggerEDIR::machine_new(), RUN_BUDGET)
    return 8 if DebuggerEDIR::machine_is_faulted(memory_machine) or memory_machine.result != 37 or memory_machine.heap_next != 2
    overflow_machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    overflow_machine.heap_next <- 64
    overflow_machine <- DebuggerEDIR::machine_step(overflow_machine, DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Allocate, a: 1, b: 0, source: span})
    return 13 if not DebuggerEDIR::machine_is_faulted(overflow_machine) or not DebuggerEDIR::machine_is_halted(overflow_machine)
    oversized_allocation_machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    oversized_allocation_machine <- DebuggerEDIR::machine_step(oversized_allocation_machine, DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Allocate, a: OVERSIZED_ALLOCATION, b: 0, source: span})
    return 16 if not DebuggerEDIR::machine_is_faulted(oversized_allocation_machine) or not DebuggerEDIR::machine_is_halted(oversized_allocation_machine)
    overflow_add_machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    overflow_add_machine.accumulator <- I64_MAX_VALUE
    overflow_add_machine <- DebuggerEDIR::machine_step(overflow_add_machine, DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Add, a: 1, b: 0, source: span})
    return 17 if not DebuggerEDIR::machine_is_faulted(overflow_add_machine) or not DebuggerEDIR::machine_is_halted(overflow_add_machine)
    overflow_multiply_machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    overflow_multiply_machine.accumulator <- I64_MIN_VALUE
    overflow_multiply_machine <- DebuggerEDIR::machine_step(overflow_multiply_machine, DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Multiply, a: -1, b: 0, source: span})
    return 18 if not DebuggerEDIR::machine_is_faulted(overflow_multiply_machine) or not DebuggerEDIR::machine_is_halted(overflow_multiply_machine)
    overflow_negate_machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    overflow_negate_machine.accumulator <- I64_MIN_VALUE
    overflow_negate_machine <- DebuggerEDIR::machine_step(overflow_negate_machine, DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Negate, a: 0, b: 0, source: span})
    return 19 if not DebuggerEDIR::machine_is_faulted(overflow_negate_machine) or not DebuggerEDIR::machine_is_halted(overflow_negate_machine)
    overflow_divide_machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    overflow_divide_machine.accumulator <- I64_MIN_VALUE
    overflow_divide_machine <- DebuggerEDIR::machine_step(overflow_divide_machine, DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Divide, a: -1, b: 0, source: span})
    return 20 if not DebuggerEDIR::machine_is_faulted(overflow_divide_machine) or not DebuggerEDIR::machine_is_halted(overflow_divide_machine)
    loop_image: mutable DebuggerEDIR::ProgramImage = zeroed
    loop_image.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: LOOP_INSTRUCTION_COUNT, local_count: LOOP_LOCAL_COUNT, has_return: true}
    loop_image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: LOOP_LIMIT, b: 0, source: span}
    loop_image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: 0, b: 0, source: span}
    loop_image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.LoadLocal, a: 0, b: 0, source: span}
    loop_image.instructions[3] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.BranchZero, a: LOOP_EXIT, b: 0, source: span}
    loop_image.instructions[4] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Add, a: LOOP_DECREMENT, b: 0, source: span}
    loop_image.instructions[6] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: 0, b: 0, source: span}
    loop_image.instructions[7] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Jump, a: LOOP_START, b: 0, source: span}
    loop_image.instructions[8] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: LOOP_LIMIT, b: 0, source: span}
    loop_image.instructions[9] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: span}
    loop_machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_run(loop_image, DebuggerEDIR::machine_new(), RUN_BUDGET)
    return 9 if DebuggerEDIR::machine_is_faulted(loop_machine) or not DebuggerEDIR::machine_is_halted(loop_machine) or loop_machine.result != LOOP_LIMIT
    return 0
