include "../src/vm/edir_codec.elisa"
include "../src/core/identity.elisa"

const module Test:
    PROGRAM_VERSION: u32 = 1
    INSTRUCTION_COUNT: u64 = 3
    LOCAL_COUNT: u64 = 1
    ENTRY_CONSTANT: i64 = 7
    EDIR_HEADER_BYTES: usize = 29
    EDIR_U16_FIELD_BYTES: usize = 2
    EDIR_U32_FIELD_BYTES: usize = 4
    EDIR_U64_FIELD_BYTES: usize = 8
    SOURCE_FILE_FIXED_BYTES: usize = 36
    SOURCE_SPAN_BYTES: usize = Test::EDIR_U64_FIELD_BYTES * 3 + Test::EDIR_U32_FIELD_BYTES * 5
    INSTRUCTION_BYTES: usize = Test::EDIR_U16_FIELD_BYTES + Test::EDIR_U64_FIELD_BYTES * 2 + Test::SOURCE_SPAN_BYTES
    FUNCTION_FIXED_BYTES: usize = Test::EDIR_U64_FIELD_BYTES * 3 + Test::SOURCE_SPAN_BYTES + Test::EDIR_U32_FIELD_BYTES
    SOURCE_FILE_ROW_MAX_BYTES: usize = Test::SOURCE_FILE_FIXED_BYTES + DebuggerMetadataSourcePath::SOURCE_PATH_CAPACITY
    SOURCE_PATH_LENGTH: usize = 10
    ENTRY_OPCODE_OFFSET: usize = Test::EDIR_HEADER_BYTES + Test::SOURCE_FILE_FIXED_BYTES + Test::SOURCE_PATH_LENGTH
    SOURCE_FILE_COUNT_OFFSET: usize = Test::EDIR_HEADER_BYTES - Test::EDIR_U32_FIELD_BYTES
    SOURCE_FILE_PATH_OFFSET: usize = Test::EDIR_HEADER_BYTES + Test::SOURCE_FILE_FIXED_BYTES
    SOURCE_FILE_LINE_COUNT_OFFSET: usize = Test::EDIR_HEADER_BYTES + Test::EDIR_U64_FIELD_BYTES * 3
    SOURCE_FILE_PATH_LENGTH_OFFSET: usize = Test::EDIR_HEADER_BYTES + Test::EDIR_U64_FIELD_BYTES * 4
    ENTRY_SOURCE_FILE_OFFSET: usize = Test::ENTRY_OPCODE_OFFSET + Test::EDIR_U16_FIELD_BYTES + Test::EDIR_U64_FIELD_BYTES * 2
    SECOND_MAX_SOURCE_ROW_OFFSET: usize = Test::EDIR_HEADER_BYTES + Test::SOURCE_FILE_ROW_MAX_BYTES
    SECOND_MAX_SOURCE_PATH_OFFSET: usize = Test::SECOND_MAX_SOURCE_ROW_OFFSET + Test::SOURCE_FILE_FIXED_BYTES
    SOURCE_FILE_COUNT_ONE: usize = 1
    SOURCE_FILE_COUNT_TWO: usize = 2
    INVALID_OPCODE_BYTE: u8 = 255
    INVALID_DECODE_RESULT: i64 = 29
    INVALID_PATH_BYTE: u8 = 92
    INVALID_UTF8_BYTE: u8 = 255
    DRIVE_PATH_LENGTH: usize = 10
    SOURCE_FILE: u64 = 11
    SOURCE_LOGICAL_PATH: u64 = 12
    SOURCE_CONTENT_DIGEST: u64 = 13
    SOURCE_LINE_COUNT: u64 = 2
    SOURCE_START_BYTE: u64 = 4
    SOURCE_END_BYTE: u64 = 5
    SOURCE_LINE: u32 = 2
    SOURCE_COLUMN: u32 = 3
    SOURCE_DISCRIMINATOR: u32 = 1
    MAX_ARTIFACT_INSTRUCTIONS: usize = 128
    MAX_ARTIFACT_SOURCE_FILES: usize = 16
    MAX_ARTIFACT_FUNCTIONS: usize = 64
    MAX_FUNCTION_NAME_BYTES: usize = 128
    MAX_ARTIFACT_BYTES: usize = 37729
    FIRST_SOURCE_INDEX: usize = 0
    DUPLICATE_SOURCE_INDEX: usize = 1
    SOURCE_ID_BASE: u64 = 100
    SOURCE_PATH_ID_BASE: u64 = 200
    SOURCE_DIGEST_ID: u64 = 300
    PATH_FILL_BYTE: u8 = 97
    LEGACY_SCHEMA_VALUE: u8 = 1
    MAX_SOURCE_FILE_COUNT_PLUS_ONE: u8 = 17
    OVERSIZE_PATH_LENGTH_LOW_BYTE: u8 = 1
    OVERSIZE_PATH_LENGTH_HIGH_BYTE: u8 = 4
    FUNCTION_ID: u64 = 987
    FUNCTION_NAME_LENGTH: usize = 9
    FUNCTION_ENTRY: u64 = 1
    FUNCTION_END_EXCLUSIVE: u64 = 3
    ADJACENT_FIRST_ENTRY: u64 = 0
    ADJACENT_BOUNDARY: u64 = 1
    OVERLAPPING_FUNCTION_ENTRY: u64 = 2
    FUNCTION_COUNT_ONE: usize = 1
    FUNCTION_COUNT_OFFSET: usize = Test::EDIR_HEADER_BYTES + Test::SOURCE_FILE_FIXED_BYTES + Test::SOURCE_PATH_LENGTH + Test::INSTRUCTION_COUNT.usize() * Test::INSTRUCTION_BYTES
    FUNCTION_ID_OFFSET: usize = Test::FUNCTION_COUNT_OFFSET + Test::EDIR_U32_FIELD_BYTES
    FUNCTION_ENTRY_OFFSET: usize = Test::FUNCTION_ID_OFFSET + Test::EDIR_U64_FIELD_BYTES
    FUNCTION_END_OFFSET: usize = Test::FUNCTION_ENTRY_OFFSET + Test::EDIR_U64_FIELD_BYTES
    FUNCTION_SOURCE_OFFSET: usize = Test::FUNCTION_END_OFFSET + Test::EDIR_U64_FIELD_BYTES
    FUNCTION_NAME_LENGTH_OFFSET: usize = Test::FUNCTION_SOURCE_OFFSET + Test::SOURCE_SPAN_BYTES
    FUNCTION_NAME_OFFSET: usize = Test::FUNCTION_NAME_LENGTH_OFFSET + Test::EDIR_U32_FIELD_BYTES
    MAX_FUNCTIONS_PLUS_ONE: usize = Test::MAX_ARTIFACT_FUNCTIONS + 1
    MAX_FUNCTIONS_COUNT_OFFSET: usize = Test::EDIR_HEADER_BYTES + Test::MAX_ARTIFACT_SOURCE_FILES * Test::SOURCE_FILE_ROW_MAX_BYTES + Test::MAX_ARTIFACT_INSTRUCTIONS * Test::INSTRUCTION_BYTES
    MAX_FUNCTION_ROW_BYTES: usize = Test::FUNCTION_FIXED_BYTES + Test::MAX_FUNCTION_NAME_BYTES
    SECOND_MAX_FUNCTION_ID_OFFSET: usize = Test::MAX_FUNCTIONS_COUNT_OFFSET + Test::EDIR_U32_FIELD_BYTES + Test::MAX_FUNCTION_ROW_BYTES
    FUNCTION_ID_BASE: u64 = 5000
    FUNCTION_NAME_FILL_BYTE: u8 = 97
    FUNCTION_RANGE_STRIDE: u64 = 2
    FUNCTION_RANGE_WIDTH: u64 = 1
    MAX_FUNCTION_SOURCE_START_BYTE: u64 = 0
    MAX_FUNCTION_SOURCE_END_BYTE: u64 = 1
    MAX_FUNCTION_SOURCE_LINE: u32 = 1
    MAX_FUNCTION_SOURCE_START_COLUMN: u32 = 0
    MAX_FUNCTION_SOURCE_END_COLUMN: u32 = 1
    INVALID_FUNCTION_END: u8 = 0
    INVALID_FUNCTION_NAME_LENGTH: u8 = 129
    INVALID_FUNCTION_FILE_ID: u8 = 12
    FUNCTION_NAME_C0_CONTROL: u8 = 0
    FUNCTION_NAME_C1_LEAD_BYTE: u8 = 194
    FUNCTION_NAME_C1_CONTINUATION_BYTE: u8 = 128
    LEGACY_V2_SCHEMA_VALUE: u8 = 2


def main() -> i64:
    fixture_drive_path_bytes: mutable u8[Test::DRIVE_PATH_LENGTH] = [67, 58, 47, 97, 46, 101, 108, 105, 115, 97]
    fixture_function_name_bytes: mutable u8[Test::FUNCTION_NAME_LENGTH] = [109, 111, 100, 117, 108, 101, 58, 58, 102]
    fixture_source_path_bytes: mutable u8[Test::SOURCE_PATH_LENGTH] = [109, 97, 105, 110, 46, 101, 108, 105, 115, 97]
    return 6 if DebuggerEDIRCodec::artifact_max_instruction_count() != Test::MAX_ARTIFACT_INSTRUCTIONS or DebuggerEDIRCodec::artifact_max_bytes() != Test::MAX_ARTIFACT_BYTES
    return 9 if DebuggerEDIRCodec::artifact_max_source_file_count() != Test::MAX_ARTIFACT_SOURCE_FILES or DebuggerEDIRCodec::artifact_source_path_capacity() != DebuggerMetadata::source_path_capacity()
    return 30 if DebuggerEDIRCodec::artifact_max_function_count() != Test::MAX_ARTIFACT_FUNCTIONS or DebuggerEDIRCodec::artifact_function_name_capacity() != Test::MAX_FUNCTION_NAME_BYTES
    source: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(Test::SOURCE_FILE),
        start_byte: Test::SOURCE_START_BYTE,
        end_byte: Test::SOURCE_END_BYTE,
        start_line: Test::SOURCE_LINE,
        start_column: Test::SOURCE_COLUMN,
        end_line: Test::SOURCE_LINE,
        end_column: Test::SOURCE_COLUMN + 1,
        discriminator: Test::SOURCE_DISCRIMINATOR
    }
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::INSTRUCTION_COUNT, local_count: Test::LOCAL_COUNT, has_return: true}
    image.source_file_count <- Test::SOURCE_FILE_COUNT_ONE
    source_file: mutable DebuggerMetadata::SourceFile = zeroed
    source_file.id <- DebuggerIdentity::debug_id(Test::SOURCE_FILE)
    source_file.logical_path <- DebuggerIdentity::debug_id(Test::SOURCE_LOGICAL_PATH)
    source_file.content <- DebuggerIdentity::debug_id(Test::SOURCE_CONTENT_DIGEST)
    source_file.line_count <- Test::SOURCE_LINE_COUNT
    source_file.path_length <- Test::SOURCE_PATH_LENGTH
    for path_index in 0..<Test::SOURCE_PATH_LENGTH:
        source_file.path_bytes[path_index] <- fixture_source_path_bytes[path_index]
    image.source_files[Test::FIRST_SOURCE_INDEX] <- source_file
    image.function_count <- Test::FUNCTION_COUNT_ONE
    function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
    function.id <- DebuggerIdentity::debug_id(Test::FUNCTION_ID)
    function.name_length <- Test::FUNCTION_NAME_LENGTH
    for name_index in 0..<Test::FUNCTION_NAME_LENGTH:
        function.name_bytes[name_index] <- fixture_function_name_bytes[name_index]
    function.entry_instruction <- Test::FUNCTION_ENTRY
    function.end_instruction_exclusive <- Test::FUNCTION_END_EXCLUSIVE
    function.source <- source
    image.functions[0] <- function
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::ENTRY_CONSTANT, b: 0, source: source}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: 0, b: 0, source: source}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: source}
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(image)
    return 1 if not DebuggerTraceBinary::writer_is_valid(encoded)
    reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(encoded.bytes[0], encoded.length)
    decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(reader)
    return 2 if not decoded.valid or decoded.image.program.instruction_count != Test::INSTRUCTION_COUNT or decoded.image.instructions[0].opcode != DebuggerEDIR::Opcode.Constant or decoded.image.instructions[0].a != Test::ENTRY_CONSTANT
    return 31 if decoded.image.function_count != Test::FUNCTION_COUNT_ONE or decoded.image.functions[0].id.value != Test::FUNCTION_ID or decoded.image.functions[0].entry_instruction != Test::FUNCTION_ENTRY or decoded.image.functions[0].end_instruction_exclusive != Test::FUNCTION_END_EXCLUSIVE or decoded.image.functions[0].source.file.value != Test::SOURCE_FILE or decoded.image.functions[0].name_length != Test::FUNCTION_NAME_LENGTH
    for name_index in 0..<Test::FUNCTION_NAME_LENGTH:
        return 32 if decoded.image.functions[0].name_bytes[name_index] != fixture_function_name_bytes[name_index]
    return 3 if decoded.image.instructions[0].source.file.value != Test::SOURCE_FILE or decoded.image.instructions[0].source.start_line != Test::SOURCE_LINE or decoded.image.instructions[0].source.discriminator != Test::SOURCE_DISCRIMINATOR
    return 10 if decoded.image.source_file_count != 1 or decoded.image.source_files[Test::FIRST_SOURCE_INDEX].path_length != Test::SOURCE_PATH_LENGTH
    return 11 if decoded.image.source_files[Test::FIRST_SOURCE_INDEX].id.value != Test::SOURCE_FILE or decoded.image.source_files[Test::FIRST_SOURCE_INDEX].logical_path.value != Test::SOURCE_LOGICAL_PATH or decoded.image.source_files[Test::FIRST_SOURCE_INDEX].content.value != Test::SOURCE_CONTENT_DIGEST or decoded.image.source_files[Test::FIRST_SOURCE_INDEX].line_count != Test::SOURCE_LINE_COUNT
    for index in 0..<Test::SOURCE_PATH_LENGTH:
        return 12 if decoded.image.source_files[Test::FIRST_SOURCE_INDEX].path_bytes[index] != fixture_source_path_bytes[index]
    invalid: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid.bytes[Test::ENTRY_OPCODE_OFFSET] <- Test::INVALID_OPCODE_BYTE
    invalid_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid.bytes[0], invalid.length)
    return 4 if DebuggerEDIRCodec::artifact_is_valid(invalid_reader)
    invalid_decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(invalid_reader)
    return Test::INVALID_DECODE_RESULT if invalid_decoded.valid or invalid_decoded.image.program.instruction_count != 0 or invalid_decoded.image.source_file_count != 0
    short_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(encoded.bytes[0], Test::ENTRY_OPCODE_OFFSET)
    short_decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(short_reader)
    return 5 if short_decoded.valid
    legacy: mutable DebuggerTraceBinary::ByteWriter = encoded
    legacy.bytes[0] <- Test::LEGACY_SCHEMA_VALUE
    legacy_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(legacy.bytes[0], legacy.length)
    legacy_decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(legacy_reader)
    legacy_validity_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(legacy.bytes[0], legacy.length)
    return 13 if legacy_decoded.valid or DebuggerEDIRCodec::artifact_is_valid(legacy_validity_reader)
    legacy_v2_image: mutable DebuggerEDIR::ProgramImage = image
    legacy_v2_image.function_count <- 0
    legacy_v2: mutable DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(legacy_v2_image)
    legacy_v2.bytes[0] <- Test::LEGACY_V2_SCHEMA_VALUE
    legacy_v2.length <- legacy_v2.length - Test::EDIR_U32_FIELD_BYTES
    legacy_v2_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(legacy_v2.bytes[0], legacy_v2.length)
    legacy_v2_decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(legacy_v2_reader)
    return 33 if not legacy_v2_decoded.valid or legacy_v2_decoded.image.function_count != 0
    unknown_file: mutable DebuggerEDIR::ProgramImage = image
    unknown_file.instructions[0].source.file <- DebuggerIdentity::debug_id(Test::SOURCE_FILE + 1)
    unknown_file_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(unknown_file)
    return 14 if DebuggerTraceBinary::writer_is_valid(unknown_file_encoded)
    out_of_range_line: mutable DebuggerEDIR::ProgramImage = image
    out_of_range_line.source_files[Test::FIRST_SOURCE_INDEX].line_count <- Test::SOURCE_LINE - 1
    out_of_range_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(out_of_range_line)
    return 15 if DebuggerTraceBinary::writer_is_valid(out_of_range_encoded)
    duplicate_id: mutable DebuggerEDIR::ProgramImage = image
    duplicate_id.source_file_count <- Test::SOURCE_FILE_COUNT_TWO
    duplicate_id.source_files[Test::DUPLICATE_SOURCE_INDEX] <- image.source_files[Test::FIRST_SOURCE_INDEX]
    duplicate_id_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(duplicate_id)
    return 16 if DebuggerTraceBinary::writer_is_valid(duplicate_id_encoded)
    too_many_source_rows: mutable DebuggerEDIR::ProgramImage = image
    too_many_source_rows.source_file_count <- Test::MAX_ARTIFACT_SOURCE_FILES + 1
    too_many_source_rows_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(too_many_source_rows)
    return 28 if DebuggerTraceBinary::writer_is_valid(too_many_source_rows_encoded)
    zero_function_id: mutable DebuggerEDIR::ProgramImage = image
    zero_function_id.functions[0].id <- DebuggerIdentity::debug_id(0)
    zero_function_id_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(zero_function_id)
    return 34 if DebuggerTraceBinary::writer_is_valid(zero_function_id_encoded)
    duplicate_function_id: mutable DebuggerEDIR::ProgramImage = image
    duplicate_function_id.function_count <- Test::FUNCTION_COUNT_ONE + 1
    duplicate_function_id.functions[1] <- image.functions[0]
    duplicate_function_id_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(duplicate_function_id)
    return 35 if DebuggerTraceBinary::writer_is_valid(duplicate_function_id_encoded)
    invalid_function_name_length: mutable DebuggerEDIR::ProgramImage = image
    invalid_function_name_length.functions[0].name_length <- Test::MAX_FUNCTION_NAME_BYTES + 1
    invalid_function_name_length_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_function_name_length)
    return 36 if DebuggerTraceBinary::writer_is_valid(invalid_function_name_length_encoded)
    invalid_function_range: mutable DebuggerEDIR::ProgramImage = image
    invalid_function_range.functions[0].end_instruction_exclusive <- invalid_function_range.functions[0].entry_instruction
    invalid_function_range_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_function_range)
    return 37 if DebuggerTraceBinary::writer_is_valid(invalid_function_range_encoded)
    adjacent_function_ranges: mutable DebuggerEDIR::ProgramImage = image
    adjacent_function_ranges.function_count <- Test::FUNCTION_COUNT_ONE + 1
    adjacent_function_ranges.functions[0].entry_instruction <- Test::ADJACENT_FIRST_ENTRY
    adjacent_function_ranges.functions[0].end_instruction_exclusive <- Test::ADJACENT_BOUNDARY
    adjacent_function_ranges.functions[1] <- image.functions[0]
    adjacent_function_ranges.functions[1].id <- DebuggerIdentity::debug_id(Test::FUNCTION_ID + 1)
    adjacent_function_ranges.functions[1].entry_instruction <- Test::ADJACENT_BOUNDARY
    adjacent_function_ranges.functions[1].end_instruction_exclusive <- Test::FUNCTION_END_EXCLUSIVE
    adjacent_function_ranges_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(adjacent_function_ranges)
    return 46 if not DebuggerTraceBinary::writer_is_valid(adjacent_function_ranges_encoded)
    overlapping_function_ranges: mutable DebuggerEDIR::ProgramImage = image
    overlapping_function_ranges.function_count <- Test::FUNCTION_COUNT_ONE + 1
    overlapping_function_ranges.functions[1] <- image.functions[0]
    overlapping_function_ranges.functions[1].id <- DebuggerIdentity::debug_id(Test::FUNCTION_ID + 1)
    overlapping_function_ranges.functions[1].entry_instruction <- Test::OVERLAPPING_FUNCTION_ENTRY
    overlapping_function_ranges.functions[1].end_instruction_exclusive <- Test::FUNCTION_END_EXCLUSIVE
    overlapping_function_ranges_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(overlapping_function_ranges)
    return 47 if DebuggerTraceBinary::writer_is_valid(overlapping_function_ranges_encoded)
    invalid_function_c0_name: mutable DebuggerEDIR::ProgramImage = image
    invalid_function_c0_name.functions[0].name_bytes[0] <- Test::FUNCTION_NAME_C0_CONTROL
    invalid_function_c0_name_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_function_c0_name)
    return 48 if DebuggerTraceBinary::writer_is_valid(invalid_function_c0_name_encoded)
    invalid_function_c1_name: mutable DebuggerEDIR::ProgramImage = image
    invalid_function_c1_name.functions[0].name_bytes[0] <- Test::FUNCTION_NAME_C1_LEAD_BYTE
    invalid_function_c1_name.functions[0].name_bytes[1] <- Test::FUNCTION_NAME_C1_CONTINUATION_BYTE
    invalid_function_c1_name_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_function_c1_name)
    return 49 if DebuggerTraceBinary::writer_is_valid(invalid_function_c1_name_encoded)
    unknown_function_source: mutable DebuggerEDIR::ProgramImage = image
    unknown_function_source.functions[0].source.file <- DebuggerIdentity::debug_id(Test::SOURCE_FILE + 1)
    unknown_function_source_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(unknown_function_source)
    return 38 if DebuggerTraceBinary::writer_is_valid(unknown_function_source_encoded)
    too_many_functions: mutable DebuggerEDIR::ProgramImage = image
    too_many_functions.function_count <- Test::MAX_FUNCTIONS_PLUS_ONE
    too_many_functions_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(too_many_functions)
    return 39 if DebuggerTraceBinary::writer_is_valid(too_many_functions_encoded)
    invalid_path: mutable DebuggerEDIR::ProgramImage = image
    invalid_path.source_files[Test::FIRST_SOURCE_INDEX].path_length <- DebuggerMetadata::source_path_capacity() + 1
    invalid_path_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_path)
    return 17 if DebuggerTraceBinary::writer_is_valid(invalid_path_encoded)
    invalid_serialized_path: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_path.bytes[Test::SOURCE_FILE_PATH_OFFSET] <- Test::INVALID_PATH_BYTE
    invalid_serialized_path_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_path.bytes[0], invalid_serialized_path.length)
    return 18 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_path_reader)
    invalid_serialized_utf8: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_utf8.bytes[Test::SOURCE_FILE_PATH_OFFSET] <- Test::INVALID_UTF8_BYTE
    invalid_serialized_utf8_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_utf8.bytes[0], invalid_serialized_utf8.length)
    return 19 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_utf8_reader)
    invalid_serialized_drive_path: mutable DebuggerTraceBinary::ByteWriter = encoded
    for path_index in 0..<Test::DRIVE_PATH_LENGTH:
        invalid_serialized_drive_path.bytes[Test::SOURCE_FILE_PATH_OFFSET + path_index] <- fixture_drive_path_bytes[path_index]
    invalid_serialized_drive_path_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_drive_path.bytes[0], invalid_serialized_drive_path.length)
    return 27 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_drive_path_reader)
    invalid_serialized_source: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_source.bytes[Test::ENTRY_SOURCE_FILE_OFFSET] <- (Test::SOURCE_FILE + 1).u8()
    invalid_serialized_source_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_source.bytes[0], invalid_serialized_source.length)
    return 20 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_source_reader)
    invalid_serialized_line_count: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_line_count.bytes[Test::SOURCE_FILE_LINE_COUNT_OFFSET] <- (Test::SOURCE_LINE - 1).u8()
    invalid_serialized_line_count_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_line_count.bytes[0], invalid_serialized_line_count.length)
    return 21 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_line_count_reader)
    invalid_serialized_source_count: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_source_count.bytes[Test::SOURCE_FILE_COUNT_OFFSET] <- Test::MAX_SOURCE_FILE_COUNT_PLUS_ONE
    invalid_serialized_source_count_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_source_count.bytes[0], invalid_serialized_source_count.length)
    return 22 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_source_count_reader)
    invalid_serialized_path_length: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_path_length.bytes[Test::SOURCE_FILE_PATH_LENGTH_OFFSET] <- Test::OVERSIZE_PATH_LENGTH_LOW_BYTE
    invalid_serialized_path_length.bytes[Test::SOURCE_FILE_PATH_LENGTH_OFFSET + 1] <- Test::OVERSIZE_PATH_LENGTH_HIGH_BYTE
    invalid_serialized_path_length_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_path_length.bytes[0], invalid_serialized_path_length.length)
    return 23 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_path_length_reader)
    invalid_function_count_bytes: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_count_bytes.bytes[Test::FUNCTION_COUNT_OFFSET] <- Test::MAX_FUNCTIONS_PLUS_ONE.u8()
    invalid_function_count_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_count_bytes.bytes[0], invalid_function_count_bytes.length)
    return 40 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_count_reader)
    invalid_function_range_bytes: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_range_bytes.bytes[Test::FUNCTION_END_OFFSET] <- Test::INVALID_FUNCTION_END
    invalid_function_range_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_range_bytes.bytes[0], invalid_function_range_bytes.length)
    return 41 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_range_reader)
    invalid_function_name_length_bytes: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_name_length_bytes.bytes[Test::FUNCTION_NAME_LENGTH_OFFSET] <- Test::INVALID_FUNCTION_NAME_LENGTH
    invalid_function_name_length_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_name_length_bytes.bytes[0], invalid_function_name_length_bytes.length)
    return 42 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_name_length_reader)
    invalid_function_source_bytes: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_source_bytes.bytes[Test::FUNCTION_SOURCE_OFFSET] <- Test::INVALID_FUNCTION_FILE_ID
    invalid_function_source_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_source_bytes.bytes[0], invalid_function_source_bytes.length)
    return 43 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_source_reader)
    invalid_function_name_utf8: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_name_utf8.bytes[Test::FUNCTION_NAME_OFFSET] <- Test::INVALID_UTF8_BYTE
    invalid_function_name_utf8_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_name_utf8.bytes[0], invalid_function_name_utf8.length)
    return 44 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_name_utf8_reader)
    max_image: mutable DebuggerEDIR::ProgramImage = zeroed
    max_image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::MAX_ARTIFACT_INSTRUCTIONS.u64(), local_count: 0, has_return: true}
    max_image.source_file_count <- Test::MAX_ARTIFACT_SOURCE_FILES
    for source_index in 0..<Test::MAX_ARTIFACT_SOURCE_FILES:
        max_file: mutable DebuggerMetadata::SourceFile = zeroed
        max_file.id <- DebuggerIdentity::debug_id(Test::SOURCE_ID_BASE + source_index.u64())
        max_file.logical_path <- DebuggerIdentity::debug_id(Test::SOURCE_PATH_ID_BASE + source_index.u64())
        max_file.content <- DebuggerIdentity::debug_id(Test::SOURCE_DIGEST_ID)
        max_file.line_count <- Test::SOURCE_LINE_COUNT
        max_file.path_length <- DebuggerMetadata::source_path_capacity()
        for path_index in 0..<max_file.path_length:
            max_file.path_bytes[path_index] <- Test::PATH_FILL_BYTE
        max_file.path_bytes[max_file.path_length - 1] <- (Test::PATH_FILL_BYTE.u64() + source_index.u64()).u8()
        max_image.source_files[source_index] <- max_file
    for index in 0..<Test::MAX_ARTIFACT_INSTRUCTIONS:
        max_image.instructions[index] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: 0, b: 0, source: zeroed}
    max_image.instructions[Test::MAX_ARTIFACT_INSTRUCTIONS - 1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    max_image.function_count <- Test::MAX_ARTIFACT_FUNCTIONS
    max_function_source: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(Test::SOURCE_ID_BASE),
        start_byte: Test::MAX_FUNCTION_SOURCE_START_BYTE,
        end_byte: Test::MAX_FUNCTION_SOURCE_END_BYTE,
        start_line: Test::MAX_FUNCTION_SOURCE_LINE,
        start_column: Test::MAX_FUNCTION_SOURCE_START_COLUMN,
        end_line: Test::MAX_FUNCTION_SOURCE_LINE,
        end_column: Test::MAX_FUNCTION_SOURCE_END_COLUMN,
        discriminator: Test::SOURCE_DISCRIMINATOR
    }
    for function_index in 0..<Test::MAX_ARTIFACT_FUNCTIONS:
        max_function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
        max_function.id <- DebuggerIdentity::debug_id(Test::FUNCTION_ID_BASE + function_index.u64())
        max_function.name_length <- Test::MAX_FUNCTION_NAME_BYTES
        for name_index in 0..<Test::MAX_FUNCTION_NAME_BYTES:
            max_function.name_bytes[name_index] <- Test::FUNCTION_NAME_FILL_BYTE
        max_function.entry_instruction <- function_index.u64() * Test::FUNCTION_RANGE_STRIDE
        max_function.end_instruction_exclusive <- max_function.entry_instruction + Test::FUNCTION_RANGE_WIDTH
        max_function.source <- max_function_source
        max_image.functions[function_index] <- max_function
    max_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(max_image)
    return 7 if not DebuggerTraceBinary::writer_is_valid(max_encoded) or max_encoded.length != Test::MAX_ARTIFACT_BYTES
    max_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(max_encoded.bytes[0], max_encoded.length)
    return 8 if not DebuggerEDIRCodec::artifact_is_valid(max_reader)
    duplicate_serialized_function_id: mutable DebuggerTraceBinary::ByteWriter = max_encoded
    duplicate_serialized_function_id.bytes[Test::SECOND_MAX_FUNCTION_ID_OFFSET] <- Test::FUNCTION_ID_BASE.u8()
    duplicate_serialized_function_id_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(duplicate_serialized_function_id.bytes[0], duplicate_serialized_function_id.length)
    return 45 if DebuggerEDIRCodec::artifact_is_valid(duplicate_serialized_function_id_reader)
    duplicate_serialized_id: mutable DebuggerTraceBinary::ByteWriter = max_encoded
    duplicate_serialized_id.bytes[Test::SECOND_MAX_SOURCE_ROW_OFFSET] <- Test::SOURCE_ID_BASE.u8()
    duplicate_serialized_id_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(duplicate_serialized_id.bytes[0], duplicate_serialized_id.length)
    return 24 if DebuggerEDIRCodec::artifact_is_valid(duplicate_serialized_id_reader)
    duplicate_serialized_path: mutable DebuggerTraceBinary::ByteWriter = max_encoded
    duplicate_serialized_path.bytes[Test::SECOND_MAX_SOURCE_PATH_OFFSET + DebuggerMetadata::source_path_capacity() - 1] <- Test::PATH_FILL_BYTE
    duplicate_serialized_path_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(duplicate_serialized_path.bytes[0], duplicate_serialized_path.length)
    return 25 if DebuggerEDIRCodec::artifact_is_valid(duplicate_serialized_path_reader)
    duplicate_serialized_logical_id: mutable DebuggerTraceBinary::ByteWriter = max_encoded
    duplicate_serialized_logical_id.bytes[Test::SECOND_MAX_SOURCE_ROW_OFFSET + Test::EDIR_U64_FIELD_BYTES] <- Test::SOURCE_PATH_ID_BASE.u8()
    duplicate_serialized_logical_id_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(duplicate_serialized_logical_id.bytes[0], duplicate_serialized_logical_id.length)
    return 26 if DebuggerEDIRCodec::artifact_is_valid(duplicate_serialized_logical_id_reader)
    return 0
