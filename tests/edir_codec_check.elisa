include "../src/vm/edir_codec.elisa"
include "../src/core/identity.elisa"

const PROGRAM_VERSION: u32 = 1
const INSTRUCTION_COUNT: u64 = 3
const LOCAL_COUNT: u64 = 1
const ENTRY_CONSTANT: i64 = 7
const EDIR_HEADER_BYTES: usize = 29
const EDIR_U16_FIELD_BYTES: usize = 2
const EDIR_U32_FIELD_BYTES: usize = 4
const EDIR_U64_FIELD_BYTES: usize = 8
const SOURCE_FILE_FIXED_BYTES: usize = 36
const SOURCE_SPAN_BYTES: usize = EDIR_U64_FIELD_BYTES * 3 + EDIR_U32_FIELD_BYTES * 5
const INSTRUCTION_BYTES: usize = EDIR_U16_FIELD_BYTES + EDIR_U64_FIELD_BYTES * 2 + SOURCE_SPAN_BYTES
const FUNCTION_FIXED_BYTES: usize = EDIR_U64_FIELD_BYTES * 3 + SOURCE_SPAN_BYTES + EDIR_U32_FIELD_BYTES
const SOURCE_FILE_ROW_MAX_BYTES: usize = SOURCE_FILE_FIXED_BYTES + DebuggerMetadata::SOURCE_PATH_CAPACITY
const SOURCE_PATH_LENGTH: usize = 10
const SOURCE_PATH_BYTES: u8[SOURCE_PATH_LENGTH] = [109, 97, 105, 110, 46, 101, 108, 105, 115, 97]
const ENTRY_OPCODE_OFFSET: usize = EDIR_HEADER_BYTES + SOURCE_FILE_FIXED_BYTES + SOURCE_PATH_LENGTH
const SOURCE_FILE_COUNT_OFFSET: usize = EDIR_HEADER_BYTES - EDIR_U32_FIELD_BYTES
const SOURCE_FILE_PATH_OFFSET: usize = EDIR_HEADER_BYTES + SOURCE_FILE_FIXED_BYTES
const SOURCE_FILE_LINE_COUNT_OFFSET: usize = EDIR_HEADER_BYTES + EDIR_U64_FIELD_BYTES * 3
const SOURCE_FILE_PATH_LENGTH_OFFSET: usize = EDIR_HEADER_BYTES + EDIR_U64_FIELD_BYTES * 4
const ENTRY_SOURCE_FILE_OFFSET: usize = ENTRY_OPCODE_OFFSET + EDIR_U16_FIELD_BYTES + EDIR_U64_FIELD_BYTES * 2
const SECOND_MAX_SOURCE_ROW_OFFSET: usize = EDIR_HEADER_BYTES + SOURCE_FILE_ROW_MAX_BYTES
const SECOND_MAX_SOURCE_PATH_OFFSET: usize = SECOND_MAX_SOURCE_ROW_OFFSET + SOURCE_FILE_FIXED_BYTES
const SOURCE_FILE_COUNT_ONE: usize = 1
const SOURCE_FILE_COUNT_TWO: usize = 2
const INVALID_OPCODE_BYTE: u8 = 255
const INVALID_DECODE_RESULT: i64 = 29
const INVALID_PATH_BYTE: u8 = 92
const INVALID_UTF8_BYTE: u8 = 255
const DRIVE_PATH_LENGTH: usize = 10
const DRIVE_PATH_BYTES: u8[DRIVE_PATH_LENGTH] = [67, 58, 47, 97, 46, 101, 108, 105, 115, 97]
const SOURCE_FILE: u64 = 11
const SOURCE_LOGICAL_PATH: u64 = 12
const SOURCE_CONTENT_DIGEST: u64 = 13
const SOURCE_LINE_COUNT: u64 = 2
const SOURCE_START_BYTE: u64 = 4
const SOURCE_END_BYTE: u64 = 5
const SOURCE_LINE: u32 = 2
const SOURCE_COLUMN: u32 = 3
const SOURCE_DISCRIMINATOR: u32 = 1
const MAX_ARTIFACT_INSTRUCTIONS: usize = 128
const MAX_ARTIFACT_SOURCE_FILES: usize = 16
const MAX_ARTIFACT_FUNCTIONS: usize = 64
const MAX_FUNCTION_NAME_BYTES: usize = 128
const MAX_ARTIFACT_BYTES: usize = 37729
const FIRST_SOURCE_INDEX: usize = 0
const DUPLICATE_SOURCE_INDEX: usize = 1
const SOURCE_ID_BASE: u64 = 100
const SOURCE_PATH_ID_BASE: u64 = 200
const SOURCE_DIGEST_ID: u64 = 300
const PATH_FILL_BYTE: u8 = 97
const LEGACY_SCHEMA_VALUE: u8 = 1
const MAX_SOURCE_FILE_COUNT_PLUS_ONE: u8 = 17
const OVERSIZE_PATH_LENGTH_LOW_BYTE: u8 = 1
const OVERSIZE_PATH_LENGTH_HIGH_BYTE: u8 = 4
const FUNCTION_ID: u64 = 987
const FUNCTION_NAME_LENGTH: usize = 9
const FUNCTION_NAME_BYTES: u8[FUNCTION_NAME_LENGTH] = [109, 111, 100, 117, 108, 101, 58, 58, 102]
const FUNCTION_ENTRY: u64 = 1
const FUNCTION_END_EXCLUSIVE: u64 = 3
const ADJACENT_FIRST_ENTRY: u64 = 0
const ADJACENT_BOUNDARY: u64 = 1
const OVERLAPPING_FUNCTION_ENTRY: u64 = 2
const FUNCTION_COUNT_ONE: usize = 1
const FUNCTION_COUNT_OFFSET: usize = EDIR_HEADER_BYTES + SOURCE_FILE_FIXED_BYTES + SOURCE_PATH_LENGTH + INSTRUCTION_COUNT.usize() * INSTRUCTION_BYTES
const FUNCTION_ID_OFFSET: usize = FUNCTION_COUNT_OFFSET + EDIR_U32_FIELD_BYTES
const FUNCTION_ENTRY_OFFSET: usize = FUNCTION_ID_OFFSET + EDIR_U64_FIELD_BYTES
const FUNCTION_END_OFFSET: usize = FUNCTION_ENTRY_OFFSET + EDIR_U64_FIELD_BYTES
const FUNCTION_SOURCE_OFFSET: usize = FUNCTION_END_OFFSET + EDIR_U64_FIELD_BYTES
const FUNCTION_NAME_LENGTH_OFFSET: usize = FUNCTION_SOURCE_OFFSET + SOURCE_SPAN_BYTES
const FUNCTION_NAME_OFFSET: usize = FUNCTION_NAME_LENGTH_OFFSET + EDIR_U32_FIELD_BYTES
const MAX_FUNCTIONS_PLUS_ONE: usize = MAX_ARTIFACT_FUNCTIONS + 1
const MAX_FUNCTIONS_COUNT_OFFSET: usize = EDIR_HEADER_BYTES + MAX_ARTIFACT_SOURCE_FILES * SOURCE_FILE_ROW_MAX_BYTES + MAX_ARTIFACT_INSTRUCTIONS * INSTRUCTION_BYTES
const MAX_FUNCTION_ROW_BYTES: usize = FUNCTION_FIXED_BYTES + MAX_FUNCTION_NAME_BYTES
const SECOND_MAX_FUNCTION_ID_OFFSET: usize = MAX_FUNCTIONS_COUNT_OFFSET + EDIR_U32_FIELD_BYTES + MAX_FUNCTION_ROW_BYTES
const FUNCTION_ID_BASE: u64 = 5000
const FUNCTION_NAME_FILL_BYTE: u8 = 97
const FUNCTION_RANGE_STRIDE: u64 = 2
const FUNCTION_RANGE_WIDTH: u64 = 1
const MAX_FUNCTION_SOURCE_START_BYTE: u64 = 0
const MAX_FUNCTION_SOURCE_END_BYTE: u64 = 1
const MAX_FUNCTION_SOURCE_LINE: u32 = 1
const MAX_FUNCTION_SOURCE_START_COLUMN: u32 = 0
const MAX_FUNCTION_SOURCE_END_COLUMN: u32 = 1
const INVALID_FUNCTION_END: u8 = 0
const INVALID_FUNCTION_NAME_LENGTH: u8 = 129
const INVALID_FUNCTION_FILE_ID: u8 = 12
const FUNCTION_NAME_C0_CONTROL: u8 = 0
const FUNCTION_NAME_C1_LEAD_BYTE: u8 = 194
const FUNCTION_NAME_C1_CONTINUATION_BYTE: u8 = 128
const LEGACY_V2_SCHEMA_VALUE: u8 = 2

def main() -> i64:
    return 6 if DebuggerEDIRCodec::artifact_max_instruction_count() != MAX_ARTIFACT_INSTRUCTIONS or DebuggerEDIRCodec::artifact_max_bytes() != MAX_ARTIFACT_BYTES
    return 9 if DebuggerEDIRCodec::artifact_max_source_file_count() != MAX_ARTIFACT_SOURCE_FILES or DebuggerEDIRCodec::artifact_source_path_capacity() != DebuggerMetadata::source_path_capacity()
    return 30 if DebuggerEDIRCodec::artifact_max_function_count() != MAX_ARTIFACT_FUNCTIONS or DebuggerEDIRCodec::artifact_function_name_capacity() != MAX_FUNCTION_NAME_BYTES
    source: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(SOURCE_FILE),
        start_byte: SOURCE_START_BYTE,
        end_byte: SOURCE_END_BYTE,
        start_line: SOURCE_LINE,
        start_column: SOURCE_COLUMN,
        end_line: SOURCE_LINE,
        end_column: SOURCE_COLUMN + 1,
        discriminator: SOURCE_DISCRIMINATOR
    }
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: INSTRUCTION_COUNT, local_count: LOCAL_COUNT, has_return: true}
    image.source_file_count <- SOURCE_FILE_COUNT_ONE
    source_file: mutable DebuggerMetadata::SourceFile = zeroed
    source_file.id <- DebuggerIdentity::debug_id(SOURCE_FILE)
    source_file.logical_path <- DebuggerIdentity::debug_id(SOURCE_LOGICAL_PATH)
    source_file.content <- DebuggerIdentity::debug_id(SOURCE_CONTENT_DIGEST)
    source_file.line_count <- SOURCE_LINE_COUNT
    source_file.path_length <- SOURCE_PATH_LENGTH
    for path_index in 0..<SOURCE_PATH_LENGTH:
        source_file.path_bytes[path_index] <- SOURCE_PATH_BYTES[path_index]
    image.source_files[FIRST_SOURCE_INDEX] <- source_file
    image.function_count <- FUNCTION_COUNT_ONE
    function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
    function.id <- DebuggerIdentity::debug_id(FUNCTION_ID)
    function.name_length <- FUNCTION_NAME_LENGTH
    for name_index in 0..<FUNCTION_NAME_LENGTH:
        function.name_bytes[name_index] <- FUNCTION_NAME_BYTES[name_index]
    function.entry_instruction <- FUNCTION_ENTRY
    function.end_instruction_exclusive <- FUNCTION_END_EXCLUSIVE
    function.source <- source
    image.functions[0] <- function
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: ENTRY_CONSTANT, b: 0, source: source}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: 0, b: 0, source: source}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: source}
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(image)
    return 1 if not DebuggerTraceBinary::writer_is_valid(encoded)
    reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(encoded.bytes[0], encoded.length)
    decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(reader)
    return 2 if not decoded.valid or decoded.image.program.instruction_count != INSTRUCTION_COUNT or decoded.image.instructions[0].opcode != DebuggerEDIR::Opcode.Constant or decoded.image.instructions[0].a != ENTRY_CONSTANT
    return 31 if decoded.image.function_count != FUNCTION_COUNT_ONE or decoded.image.functions[0].id.value != FUNCTION_ID or decoded.image.functions[0].entry_instruction != FUNCTION_ENTRY or decoded.image.functions[0].end_instruction_exclusive != FUNCTION_END_EXCLUSIVE or decoded.image.functions[0].source.file.value != SOURCE_FILE or decoded.image.functions[0].name_length != FUNCTION_NAME_LENGTH
    for name_index in 0..<FUNCTION_NAME_LENGTH:
        return 32 if decoded.image.functions[0].name_bytes[name_index] != FUNCTION_NAME_BYTES[name_index]
    return 3 if decoded.image.instructions[0].source.file.value != SOURCE_FILE or decoded.image.instructions[0].source.start_line != SOURCE_LINE or decoded.image.instructions[0].source.discriminator != SOURCE_DISCRIMINATOR
    return 10 if decoded.image.source_file_count != 1 or decoded.image.source_files[FIRST_SOURCE_INDEX].path_length != SOURCE_PATH_LENGTH
    return 11 if decoded.image.source_files[FIRST_SOURCE_INDEX].id.value != SOURCE_FILE or decoded.image.source_files[FIRST_SOURCE_INDEX].logical_path.value != SOURCE_LOGICAL_PATH or decoded.image.source_files[FIRST_SOURCE_INDEX].content.value != SOURCE_CONTENT_DIGEST or decoded.image.source_files[FIRST_SOURCE_INDEX].line_count != SOURCE_LINE_COUNT
    for index in 0..<SOURCE_PATH_LENGTH:
        return 12 if decoded.image.source_files[FIRST_SOURCE_INDEX].path_bytes[index] != SOURCE_PATH_BYTES[index]
    invalid: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid.bytes[ENTRY_OPCODE_OFFSET] <- INVALID_OPCODE_BYTE
    invalid_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid.bytes[0], invalid.length)
    return 4 if DebuggerEDIRCodec::artifact_is_valid(invalid_reader)
    invalid_decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(invalid_reader)
    return INVALID_DECODE_RESULT if invalid_decoded.valid or invalid_decoded.image.program.instruction_count != 0 or invalid_decoded.image.source_file_count != 0
    short_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(encoded.bytes[0], ENTRY_OPCODE_OFFSET)
    short_decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(short_reader)
    return 5 if short_decoded.valid
    legacy: mutable DebuggerTraceBinary::ByteWriter = encoded
    legacy.bytes[0] <- LEGACY_SCHEMA_VALUE
    legacy_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(legacy.bytes[0], legacy.length)
    legacy_decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(legacy_reader)
    legacy_validity_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(legacy.bytes[0], legacy.length)
    return 13 if legacy_decoded.valid or DebuggerEDIRCodec::artifact_is_valid(legacy_validity_reader)
    legacy_v2_image: mutable DebuggerEDIR::ProgramImage = image
    legacy_v2_image.function_count <- 0
    legacy_v2: mutable DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(legacy_v2_image)
    legacy_v2.bytes[0] <- LEGACY_V2_SCHEMA_VALUE
    legacy_v2.length <- legacy_v2.length - EDIR_U32_FIELD_BYTES
    legacy_v2_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(legacy_v2.bytes[0], legacy_v2.length)
    legacy_v2_decoded: DebuggerEDIRCodec::DecodeResult = DebuggerEDIRCodec::artifact_decode(legacy_v2_reader)
    return 33 if not legacy_v2_decoded.valid or legacy_v2_decoded.image.function_count != 0
    unknown_file: mutable DebuggerEDIR::ProgramImage = image
    unknown_file.instructions[0].source.file <- DebuggerIdentity::debug_id(SOURCE_FILE + 1)
    unknown_file_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(unknown_file)
    return 14 if DebuggerTraceBinary::writer_is_valid(unknown_file_encoded)
    out_of_range_line: mutable DebuggerEDIR::ProgramImage = image
    out_of_range_line.source_files[FIRST_SOURCE_INDEX].line_count <- SOURCE_LINE - 1
    out_of_range_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(out_of_range_line)
    return 15 if DebuggerTraceBinary::writer_is_valid(out_of_range_encoded)
    duplicate_id: mutable DebuggerEDIR::ProgramImage = image
    duplicate_id.source_file_count <- SOURCE_FILE_COUNT_TWO
    duplicate_id.source_files[DUPLICATE_SOURCE_INDEX] <- image.source_files[FIRST_SOURCE_INDEX]
    duplicate_id_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(duplicate_id)
    return 16 if DebuggerTraceBinary::writer_is_valid(duplicate_id_encoded)
    too_many_source_rows: mutable DebuggerEDIR::ProgramImage = image
    too_many_source_rows.source_file_count <- MAX_ARTIFACT_SOURCE_FILES + 1
    too_many_source_rows_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(too_many_source_rows)
    return 28 if DebuggerTraceBinary::writer_is_valid(too_many_source_rows_encoded)
    zero_function_id: mutable DebuggerEDIR::ProgramImage = image
    zero_function_id.functions[0].id <- DebuggerIdentity::debug_id(0)
    zero_function_id_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(zero_function_id)
    return 34 if DebuggerTraceBinary::writer_is_valid(zero_function_id_encoded)
    duplicate_function_id: mutable DebuggerEDIR::ProgramImage = image
    duplicate_function_id.function_count <- FUNCTION_COUNT_ONE + 1
    duplicate_function_id.functions[1] <- image.functions[0]
    duplicate_function_id_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(duplicate_function_id)
    return 35 if DebuggerTraceBinary::writer_is_valid(duplicate_function_id_encoded)
    invalid_function_name_length: mutable DebuggerEDIR::ProgramImage = image
    invalid_function_name_length.functions[0].name_length <- MAX_FUNCTION_NAME_BYTES + 1
    invalid_function_name_length_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_function_name_length)
    return 36 if DebuggerTraceBinary::writer_is_valid(invalid_function_name_length_encoded)
    invalid_function_range: mutable DebuggerEDIR::ProgramImage = image
    invalid_function_range.functions[0].end_instruction_exclusive <- invalid_function_range.functions[0].entry_instruction
    invalid_function_range_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_function_range)
    return 37 if DebuggerTraceBinary::writer_is_valid(invalid_function_range_encoded)
    adjacent_function_ranges: mutable DebuggerEDIR::ProgramImage = image
    adjacent_function_ranges.function_count <- FUNCTION_COUNT_ONE + 1
    adjacent_function_ranges.functions[0].entry_instruction <- ADJACENT_FIRST_ENTRY
    adjacent_function_ranges.functions[0].end_instruction_exclusive <- ADJACENT_BOUNDARY
    adjacent_function_ranges.functions[1] <- image.functions[0]
    adjacent_function_ranges.functions[1].id <- DebuggerIdentity::debug_id(FUNCTION_ID + 1)
    adjacent_function_ranges.functions[1].entry_instruction <- ADJACENT_BOUNDARY
    adjacent_function_ranges.functions[1].end_instruction_exclusive <- FUNCTION_END_EXCLUSIVE
    adjacent_function_ranges_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(adjacent_function_ranges)
    return 46 if not DebuggerTraceBinary::writer_is_valid(adjacent_function_ranges_encoded)
    overlapping_function_ranges: mutable DebuggerEDIR::ProgramImage = image
    overlapping_function_ranges.function_count <- FUNCTION_COUNT_ONE + 1
    overlapping_function_ranges.functions[1] <- image.functions[0]
    overlapping_function_ranges.functions[1].id <- DebuggerIdentity::debug_id(FUNCTION_ID + 1)
    overlapping_function_ranges.functions[1].entry_instruction <- OVERLAPPING_FUNCTION_ENTRY
    overlapping_function_ranges.functions[1].end_instruction_exclusive <- FUNCTION_END_EXCLUSIVE
    overlapping_function_ranges_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(overlapping_function_ranges)
    return 47 if DebuggerTraceBinary::writer_is_valid(overlapping_function_ranges_encoded)
    invalid_function_c0_name: mutable DebuggerEDIR::ProgramImage = image
    invalid_function_c0_name.functions[0].name_bytes[0] <- FUNCTION_NAME_C0_CONTROL
    invalid_function_c0_name_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_function_c0_name)
    return 48 if DebuggerTraceBinary::writer_is_valid(invalid_function_c0_name_encoded)
    invalid_function_c1_name: mutable DebuggerEDIR::ProgramImage = image
    invalid_function_c1_name.functions[0].name_bytes[0] <- FUNCTION_NAME_C1_LEAD_BYTE
    invalid_function_c1_name.functions[0].name_bytes[1] <- FUNCTION_NAME_C1_CONTINUATION_BYTE
    invalid_function_c1_name_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_function_c1_name)
    return 49 if DebuggerTraceBinary::writer_is_valid(invalid_function_c1_name_encoded)
    unknown_function_source: mutable DebuggerEDIR::ProgramImage = image
    unknown_function_source.functions[0].source.file <- DebuggerIdentity::debug_id(SOURCE_FILE + 1)
    unknown_function_source_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(unknown_function_source)
    return 38 if DebuggerTraceBinary::writer_is_valid(unknown_function_source_encoded)
    too_many_functions: mutable DebuggerEDIR::ProgramImage = image
    too_many_functions.function_count <- MAX_FUNCTIONS_PLUS_ONE
    too_many_functions_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(too_many_functions)
    return 39 if DebuggerTraceBinary::writer_is_valid(too_many_functions_encoded)
    invalid_path: mutable DebuggerEDIR::ProgramImage = image
    invalid_path.source_files[FIRST_SOURCE_INDEX].path_length <- DebuggerMetadata::source_path_capacity() + 1
    invalid_path_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(invalid_path)
    return 17 if DebuggerTraceBinary::writer_is_valid(invalid_path_encoded)
    invalid_serialized_path: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_path.bytes[SOURCE_FILE_PATH_OFFSET] <- INVALID_PATH_BYTE
    invalid_serialized_path_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_path.bytes[0], invalid_serialized_path.length)
    return 18 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_path_reader)
    invalid_serialized_utf8: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_utf8.bytes[SOURCE_FILE_PATH_OFFSET] <- INVALID_UTF8_BYTE
    invalid_serialized_utf8_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_utf8.bytes[0], invalid_serialized_utf8.length)
    return 19 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_utf8_reader)
    invalid_serialized_drive_path: mutable DebuggerTraceBinary::ByteWriter = encoded
    for path_index in 0..<DRIVE_PATH_LENGTH:
        invalid_serialized_drive_path.bytes[SOURCE_FILE_PATH_OFFSET + path_index] <- DRIVE_PATH_BYTES[path_index]
    invalid_serialized_drive_path_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_drive_path.bytes[0], invalid_serialized_drive_path.length)
    return 27 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_drive_path_reader)
    invalid_serialized_source: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_source.bytes[ENTRY_SOURCE_FILE_OFFSET] <- (SOURCE_FILE + 1).u8()
    invalid_serialized_source_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_source.bytes[0], invalid_serialized_source.length)
    return 20 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_source_reader)
    invalid_serialized_line_count: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_line_count.bytes[SOURCE_FILE_LINE_COUNT_OFFSET] <- (SOURCE_LINE - 1).u8()
    invalid_serialized_line_count_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_line_count.bytes[0], invalid_serialized_line_count.length)
    return 21 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_line_count_reader)
    invalid_serialized_source_count: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_source_count.bytes[SOURCE_FILE_COUNT_OFFSET] <- MAX_SOURCE_FILE_COUNT_PLUS_ONE
    invalid_serialized_source_count_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_source_count.bytes[0], invalid_serialized_source_count.length)
    return 22 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_source_count_reader)
    invalid_serialized_path_length: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_serialized_path_length.bytes[SOURCE_FILE_PATH_LENGTH_OFFSET] <- OVERSIZE_PATH_LENGTH_LOW_BYTE
    invalid_serialized_path_length.bytes[SOURCE_FILE_PATH_LENGTH_OFFSET + 1] <- OVERSIZE_PATH_LENGTH_HIGH_BYTE
    invalid_serialized_path_length_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_serialized_path_length.bytes[0], invalid_serialized_path_length.length)
    return 23 if DebuggerEDIRCodec::artifact_is_valid(invalid_serialized_path_length_reader)
    invalid_function_count_bytes: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_count_bytes.bytes[FUNCTION_COUNT_OFFSET] <- MAX_FUNCTIONS_PLUS_ONE.u8()
    invalid_function_count_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_count_bytes.bytes[0], invalid_function_count_bytes.length)
    return 40 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_count_reader)
    invalid_function_range_bytes: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_range_bytes.bytes[FUNCTION_END_OFFSET] <- INVALID_FUNCTION_END
    invalid_function_range_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_range_bytes.bytes[0], invalid_function_range_bytes.length)
    return 41 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_range_reader)
    invalid_function_name_length_bytes: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_name_length_bytes.bytes[FUNCTION_NAME_LENGTH_OFFSET] <- INVALID_FUNCTION_NAME_LENGTH
    invalid_function_name_length_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_name_length_bytes.bytes[0], invalid_function_name_length_bytes.length)
    return 42 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_name_length_reader)
    invalid_function_source_bytes: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_source_bytes.bytes[FUNCTION_SOURCE_OFFSET] <- INVALID_FUNCTION_FILE_ID
    invalid_function_source_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_source_bytes.bytes[0], invalid_function_source_bytes.length)
    return 43 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_source_reader)
    invalid_function_name_utf8: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_function_name_utf8.bytes[FUNCTION_NAME_OFFSET] <- INVALID_UTF8_BYTE
    invalid_function_name_utf8_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_function_name_utf8.bytes[0], invalid_function_name_utf8.length)
    return 44 if DebuggerEDIRCodec::artifact_is_valid(invalid_function_name_utf8_reader)
    max_image: mutable DebuggerEDIR::ProgramImage = zeroed
    max_image.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: MAX_ARTIFACT_INSTRUCTIONS.u64(), local_count: 0, has_return: true}
    max_image.source_file_count <- MAX_ARTIFACT_SOURCE_FILES
    for source_index in 0..<MAX_ARTIFACT_SOURCE_FILES:
        max_file: mutable DebuggerMetadata::SourceFile = zeroed
        max_file.id <- DebuggerIdentity::debug_id(SOURCE_ID_BASE + source_index.u64())
        max_file.logical_path <- DebuggerIdentity::debug_id(SOURCE_PATH_ID_BASE + source_index.u64())
        max_file.content <- DebuggerIdentity::debug_id(SOURCE_DIGEST_ID)
        max_file.line_count <- SOURCE_LINE_COUNT
        max_file.path_length <- DebuggerMetadata::source_path_capacity()
        for path_index in 0..<max_file.path_length:
            max_file.path_bytes[path_index] <- PATH_FILL_BYTE
        max_file.path_bytes[max_file.path_length - 1] <- (PATH_FILL_BYTE.u64() + source_index.u64()).u8()
        max_image.source_files[source_index] <- max_file
    for index in 0..<MAX_ARTIFACT_INSTRUCTIONS:
        max_image.instructions[index] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: 0, b: 0, source: zeroed}
    max_image.instructions[MAX_ARTIFACT_INSTRUCTIONS - 1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    max_image.function_count <- MAX_ARTIFACT_FUNCTIONS
    max_function_source: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(SOURCE_ID_BASE),
        start_byte: MAX_FUNCTION_SOURCE_START_BYTE,
        end_byte: MAX_FUNCTION_SOURCE_END_BYTE,
        start_line: MAX_FUNCTION_SOURCE_LINE,
        start_column: MAX_FUNCTION_SOURCE_START_COLUMN,
        end_line: MAX_FUNCTION_SOURCE_LINE,
        end_column: MAX_FUNCTION_SOURCE_END_COLUMN,
        discriminator: SOURCE_DISCRIMINATOR
    }
    for function_index in 0..<MAX_ARTIFACT_FUNCTIONS:
        max_function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
        max_function.id <- DebuggerIdentity::debug_id(FUNCTION_ID_BASE + function_index.u64())
        max_function.name_length <- MAX_FUNCTION_NAME_BYTES
        for name_index in 0..<MAX_FUNCTION_NAME_BYTES:
            max_function.name_bytes[name_index] <- FUNCTION_NAME_FILL_BYTE
        max_function.entry_instruction <- function_index.u64() * FUNCTION_RANGE_STRIDE
        max_function.end_instruction_exclusive <- max_function.entry_instruction + FUNCTION_RANGE_WIDTH
        max_function.source <- max_function_source
        max_image.functions[function_index] <- max_function
    max_encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(max_image)
    return 7 if not DebuggerTraceBinary::writer_is_valid(max_encoded) or max_encoded.length != MAX_ARTIFACT_BYTES
    max_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(max_encoded.bytes[0], max_encoded.length)
    return 8 if not DebuggerEDIRCodec::artifact_is_valid(max_reader)
    duplicate_serialized_function_id: mutable DebuggerTraceBinary::ByteWriter = max_encoded
    duplicate_serialized_function_id.bytes[SECOND_MAX_FUNCTION_ID_OFFSET] <- FUNCTION_ID_BASE.u8()
    duplicate_serialized_function_id_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(duplicate_serialized_function_id.bytes[0], duplicate_serialized_function_id.length)
    return 45 if DebuggerEDIRCodec::artifact_is_valid(duplicate_serialized_function_id_reader)
    duplicate_serialized_id: mutable DebuggerTraceBinary::ByteWriter = max_encoded
    duplicate_serialized_id.bytes[SECOND_MAX_SOURCE_ROW_OFFSET] <- SOURCE_ID_BASE.u8()
    duplicate_serialized_id_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(duplicate_serialized_id.bytes[0], duplicate_serialized_id.length)
    return 24 if DebuggerEDIRCodec::artifact_is_valid(duplicate_serialized_id_reader)
    duplicate_serialized_path: mutable DebuggerTraceBinary::ByteWriter = max_encoded
    duplicate_serialized_path.bytes[SECOND_MAX_SOURCE_PATH_OFFSET + DebuggerMetadata::source_path_capacity() - 1] <- PATH_FILL_BYTE
    duplicate_serialized_path_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(duplicate_serialized_path.bytes[0], duplicate_serialized_path.length)
    return 25 if DebuggerEDIRCodec::artifact_is_valid(duplicate_serialized_path_reader)
    duplicate_serialized_logical_id: mutable DebuggerTraceBinary::ByteWriter = max_encoded
    duplicate_serialized_logical_id.bytes[SECOND_MAX_SOURCE_ROW_OFFSET + EDIR_U64_FIELD_BYTES] <- SOURCE_PATH_ID_BASE.u8()
    duplicate_serialized_logical_id_reader: DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(duplicate_serialized_logical_id.bytes[0], duplicate_serialized_logical_id.length)
    return 26 if DebuggerEDIRCodec::artifact_is_valid(duplicate_serialized_logical_id_reader)
    return 0
