include "../src/vm/edir_file.elisa"

const module Test:
    FIXTURE_PATH_LENGTH: usize = 23
    MISSING_PATH_LENGTH: usize = 26
    EMPTY_PATH_LENGTH: usize = 21
    TRUNCATED_PATH_LENGTH: usize = 25
    CORRUPT_PATH_LENGTH: usize = 23
    OVERSIZED_PATH_LENGTH: usize = 25
    EXPECTED_RESULT: i64 = 29
    EXPECTED_FIRST_LOCAL: i64 = 17
    EXPECTED_SOURCE_LINE: u32 = 41
    EXPECTED_SOURCE_FILE_ID: u64 = 7
    EXPECTED_SOURCE_LOGICAL_PATH: u64 = 70
    EXPECTED_SOURCE_CONTENT_DIGEST: u64 = 71
    EXPECTED_SOURCE_LINE_COUNT: u64 = 100
    EXPECTED_SOURCE_PATH_LENGTH: usize = 10
    EXPECTED_ARTIFACT_MAX_FILE_BYTES: usize = 37729
    EXPECTED_SOURCE_FILE_INDEX: usize = 0
    EXECUTION_STEP_BUDGET: u64 = 16
    FIXTURE_INSTRUCTION_COUNT: u64 = 7
    FIRST_LOCAL_INDEX: usize = 0


def main() -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    fixture_corrupt_path: mutable u8[Test::CORRUPT_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 99, 111, 114, 114, 117, 112, 116, 46, 101, 100, 105, 114]
    fixture_empty_path: mutable u8[Test::EMPTY_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 101, 109, 112, 116, 121, 46, 101, 100, 105, 114]
    fixture_expected_source_path_bytes: mutable u8[Test::EXPECTED_SOURCE_PATH_LENGTH] = [109, 97, 105, 110, 46, 101, 108, 105, 115, 97]
    fixture_fixture_path: mutable u8[Test::FIXTURE_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 102, 105, 120, 116, 117, 114, 101, 46, 101, 100, 105, 114]
    fixture_missing_path: mutable u8[Test::MISSING_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 110, 111, 45, 115, 117, 99, 104, 45, 101, 100, 105, 114, 45, 102, 105, 120, 116, 117, 114, 101]
    fixture_oversized_path: mutable u8[Test::OVERSIZED_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 111, 118, 101, 114, 115, 105, 122, 101, 100, 46, 101, 100, 105, 114]
    fixture_truncated_path: mutable u8[Test::TRUNCATED_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 116, 114, 117, 110, 99, 97, 116, 101, 100, 46, 101, 100, 105, 114]
    return 12 if DebuggerEDIRFile::artifact_max_file_bytes() != Test::EXPECTED_ARTIFACT_MAX_FILE_BYTES
    loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(fixture_fixture_path[0], Test::FIXTURE_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 1 if not loaded.valid or loaded.status != DebuggerEDIRFile::LoadStatus.Ready
    return 2 if loaded.image.program.instruction_count != Test::FIXTURE_INSTRUCTION_COUNT or loaded.image.instructions[0].source.start_line != Test::EXPECTED_SOURCE_LINE
    return 10 if loaded.image.source_file_count != 1 or loaded.image.source_files[Test::EXPECTED_SOURCE_FILE_INDEX].id.value != Test::EXPECTED_SOURCE_FILE_ID or loaded.image.source_files[Test::EXPECTED_SOURCE_FILE_INDEX].logical_path.value != Test::EXPECTED_SOURCE_LOGICAL_PATH or loaded.image.source_files[Test::EXPECTED_SOURCE_FILE_INDEX].content.value != Test::EXPECTED_SOURCE_CONTENT_DIGEST or loaded.image.source_files[Test::EXPECTED_SOURCE_FILE_INDEX].line_count != Test::EXPECTED_SOURCE_LINE_COUNT or loaded.image.source_files[Test::EXPECTED_SOURCE_FILE_INDEX].path_length != Test::EXPECTED_SOURCE_PATH_LENGTH
    for index in 0..<Test::EXPECTED_SOURCE_PATH_LENGTH:
        return 11 if loaded.image.source_files[Test::EXPECTED_SOURCE_FILE_INDEX].path_bytes[index] != fixture_expected_source_path_bytes[index]
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_run(loaded.image, DebuggerEDIR::machine_new(), Test::EXECUTION_STEP_BUDGET)
    return 3 if machine.faulted or not machine.halted or machine.result != Test::EXPECTED_RESULT
    return 4 if not machine.locals_initialized[Test::FIRST_LOCAL_INDEX] or machine.locals[Test::FIRST_LOCAL_INDEX] != Test::EXPECTED_FIRST_LOCAL
    missing: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(fixture_missing_path[0], Test::MISSING_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 5 if missing.valid or missing.status != DebuggerEDIRFile::LoadStatus.OpenFailure
    empty: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(fixture_empty_path[0], Test::EMPTY_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 6 if empty.valid or empty.status != DebuggerEDIRFile::LoadStatus.InvalidArtifact
    truncated: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(fixture_truncated_path[0], Test::TRUNCATED_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 7 if truncated.valid or truncated.status != DebuggerEDIRFile::LoadStatus.InvalidArtifact
    corrupt: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(fixture_corrupt_path[0], Test::CORRUPT_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 8 if corrupt.valid or corrupt.status != DebuggerEDIRFile::LoadStatus.InvalidArtifact
    oversized: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(fixture_oversized_path[0], Test::OVERSIZED_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 9 if oversized.valid or oversized.status != DebuggerEDIRFile::LoadStatus.TooLarge
    return 0
