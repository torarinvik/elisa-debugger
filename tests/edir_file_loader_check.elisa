include "../src/vm/edir_file.elisa"

const FIXTURE_PATH_LENGTH: usize = 23
const FIXTURE_PATH: u8[FIXTURE_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 102, 105, 120, 116, 117, 114, 101, 46, 101, 100, 105, 114]
const MISSING_PATH_LENGTH: usize = 26
const MISSING_PATH: u8[MISSING_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 110, 111, 45, 115, 117, 99, 104, 45, 101, 100, 105, 114, 45, 102, 105, 120, 116, 117, 114, 101]
const EMPTY_PATH_LENGTH: usize = 21
const EMPTY_PATH: u8[EMPTY_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 101, 109, 112, 116, 121, 46, 101, 100, 105, 114]
const TRUNCATED_PATH_LENGTH: usize = 25
const TRUNCATED_PATH: u8[TRUNCATED_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 116, 114, 117, 110, 99, 97, 116, 101, 100, 46, 101, 100, 105, 114]
const CORRUPT_PATH_LENGTH: usize = 23
const CORRUPT_PATH: u8[CORRUPT_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 99, 111, 114, 114, 117, 112, 116, 46, 101, 100, 105, 114]
const OVERSIZED_PATH_LENGTH: usize = 25
const OVERSIZED_PATH: u8[OVERSIZED_PATH_LENGTH] = [98, 117, 105, 108, 100, 47, 101, 100, 105, 114, 45, 111, 118, 101, 114, 115, 105, 122, 101, 100, 46, 101, 100, 105, 114]
const EXPECTED_RESULT: i64 = 29
const EXPECTED_FIRST_LOCAL: i64 = 17
const EXPECTED_SOURCE_LINE: u32 = 41
const EXPECTED_SOURCE_FILE_ID: u64 = 7
const EXPECTED_SOURCE_LOGICAL_PATH: u64 = 70
const EXPECTED_SOURCE_CONTENT_DIGEST: u64 = 71
const EXPECTED_SOURCE_LINE_COUNT: u64 = 100
const EXPECTED_SOURCE_PATH_LENGTH: usize = 10
const EXPECTED_SOURCE_PATH_BYTES: u8[EXPECTED_SOURCE_PATH_LENGTH] = [109, 97, 105, 110, 46, 101, 108, 105, 115, 97]
const EXPECTED_ARTIFACT_MAX_FILE_BYTES: usize = 24925
const EXPECTED_SOURCE_FILE_INDEX: usize = 0
const EXECUTION_STEP_BUDGET: u64 = 16
const FIXTURE_INSTRUCTION_COUNT: u64 = 7
const FIRST_LOCAL_INDEX: usize = 0

def main() -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    return 12 if DebuggerEDIRFile::artifact_max_file_bytes() != EXPECTED_ARTIFACT_MAX_FILE_BYTES
    loaded: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(FIXTURE_PATH[0], FIXTURE_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 1 if not loaded.valid or loaded.status != DebuggerEDIRFile::LoadStatus.Ready
    return 2 if loaded.image.program.instruction_count != FIXTURE_INSTRUCTION_COUNT or loaded.image.instructions[0].source.start_line != EXPECTED_SOURCE_LINE
    return 10 if loaded.image.source_file_count != 1 or loaded.image.source_files[EXPECTED_SOURCE_FILE_INDEX].id.value != EXPECTED_SOURCE_FILE_ID or loaded.image.source_files[EXPECTED_SOURCE_FILE_INDEX].logical_path.value != EXPECTED_SOURCE_LOGICAL_PATH or loaded.image.source_files[EXPECTED_SOURCE_FILE_INDEX].content.value != EXPECTED_SOURCE_CONTENT_DIGEST or loaded.image.source_files[EXPECTED_SOURCE_FILE_INDEX].line_count != EXPECTED_SOURCE_LINE_COUNT or loaded.image.source_files[EXPECTED_SOURCE_FILE_INDEX].path_length != EXPECTED_SOURCE_PATH_LENGTH
    for index in 0..<EXPECTED_SOURCE_PATH_LENGTH:
        return 11 if loaded.image.source_files[EXPECTED_SOURCE_FILE_INDEX].path_bytes[index] != EXPECTED_SOURCE_PATH_BYTES[index]
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_run(loaded.image, DebuggerEDIR::machine_new(), EXECUTION_STEP_BUDGET)
    return 3 if machine.faulted or not machine.halted or machine.result != EXPECTED_RESULT
    return 4 if not machine.locals_initialized[FIRST_LOCAL_INDEX] or machine.locals[FIRST_LOCAL_INDEX] != EXPECTED_FIRST_LOCAL
    missing: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(MISSING_PATH[0], MISSING_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 5 if missing.valid or missing.status != DebuggerEDIRFile::LoadStatus.OpenFailure
    empty: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(EMPTY_PATH[0], EMPTY_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 6 if empty.valid or empty.status != DebuggerEDIRFile::LoadStatus.InvalidArtifact
    truncated: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(TRUNCATED_PATH[0], TRUNCATED_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 7 if truncated.valid or truncated.status != DebuggerEDIRFile::LoadStatus.InvalidArtifact
    corrupt: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(CORRUPT_PATH[0], CORRUPT_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 8 if corrupt.valid or corrupt.status != DebuggerEDIRFile::LoadStatus.InvalidArtifact
    oversized: DebuggerEDIRFile::LoadResult = DebuggerEDIRFile::artifact_load(OVERSIZED_PATH[0], OVERSIZED_PATH_LENGTH) can Blocking.IO, Unsafe.PointerCast
    return 9 if oversized.valid or oversized.status != DebuggerEDIRFile::LoadStatus.TooLarge
    return 0
