# Writes one verified EDIR fixture to stdout so the host build recipe can
# redirect it into a disposable file for loader and DAP integration checks.

extern write(fd: i32, buf: void&, count: usize) -> isize can[Blocking.IO]

include "../src/vm/edir_codec.elisa"

const module Test:
    STDOUT_FD: i32 = 1
    PROGRAM_VERSION: u32 = 1
    INSTRUCTION_COUNT: u64 = 7
    LOCAL_COUNT: u64 = 2
    SOURCE_FILE_ID: u64 = 7
    SOURCE_LOGICAL_PATH_ID: u64 = 70
    SOURCE_CONTENT_DIGEST: u64 = 71
    SOURCE_LINE_COUNT: u64 = 100
    SOURCE_PATH_LENGTH: usize = 10
    SOURCE_FILE_COUNT: usize = 1
    SOURCE_FILE_INDEX: usize = 0
    SOURCE_FIRST_BYTE: u64 = 0
    SOURCE_BYTE_WIDTH: u64 = 1
    SOURCE_FIRST_LINE: u32 = 41
    SOURCE_FIRST_COLUMN: u32 = 3
    SOURCE_END_COLUMN: u32 = 4
    SOURCE_LINE_STEP: u32 = 1
    SOURCE_BYTE_STEP: u64 = 1
    SOURCE_DISCRIMINATOR: u32 = 0
    NO_SECOND_OPERAND: i64 = 0
    FIRST_CONSTANT: i64 = 17
    SECOND_CONSTANT: i64 = 29
    FIRST_LOCAL_INDEX: i64 = 0
    SECOND_LOCAL_INDEX: i64 = 1
    FIRST_INSTRUCTION: usize = 0
    SECOND_INSTRUCTION: usize = 1
    THIRD_INSTRUCTION: usize = 2
    FOURTH_INSTRUCTION: usize = 3
    CALL_INSTRUCTION: usize = 4
    ROOT_RETURN_INSTRUCTION: usize = 5
    CALLEE_ENTRY_INSTRUCTION: usize = 6
    WRITE_NO_PROGRESS: isize = 0

    const module Function:
        COUNT: usize = 2
        ROOT_INDEX: usize = 0
        CALLEE_INDEX: usize = 1
        ROOT_ID: u64 = 72
        CALLEE_ID: u64 = 73
        ROOT_NAME: cstr = "main"
        ROOT_NAME_LENGTH: usize = 4
        CALLEE_NAME: cstr = "callee"
        CALLEE_NAME_LENGTH: usize = 6
        ROOT_ENTRY: u64 = Test::FIRST_INSTRUCTION.u64()
        END_EXCLUSIVE_INCREMENT: u64 = 1
        ROOT_END: u64 = Test::ROOT_RETURN_INSTRUCTION.u64() + Test::Function::END_EXCLUSIVE_INCREMENT
        CALLEE_ENTRY: u64 = Test::CALLEE_ENTRY_INSTRUCTION.u64()
        CALLEE_END: u64 = Test::INSTRUCTION_COUNT


def source_span(line: u32, byte_offset: u64) -> DebuggerIdentity::SourceSpan:
    return DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(Test::SOURCE_FILE_ID),
        start_byte: byte_offset,
        end_byte: byte_offset + Test::SOURCE_BYTE_WIDTH,
        start_line: line,
        start_column: Test::SOURCE_FIRST_COLUMN,
        end_line: line,
        end_column: Test::SOURCE_END_COLUMN,
        discriminator: Test::SOURCE_DISCRIMINATOR
    }

def write_all(bytes: u8&, length: usize) -> bool can[Blocking.IO, Unsafe.PointerCast]:
    offset: mutable usize = 0
    while offset < length:
        written: isize = write(Test::STDOUT_FD, (&bytes[offset]).cast[void&], length - offset) can Blocking.IO, Unsafe.PointerCast
        return false if written <= Test::WRITE_NO_PROGRESS
        return false if written.usize() > length - offset
        offset <- offset + written.usize()
    return true

def main() -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    fixture_source_path_bytes: mutable u8[Test::SOURCE_PATH_LENGTH] = [109, 97, 105, 110, 46, 101, 108, 105, 115, 97]
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::INSTRUCTION_COUNT, local_count: Test::LOCAL_COUNT, has_return: true}
    image.source_file_count <- Test::SOURCE_FILE_COUNT
    source_file: mutable DebuggerMetadata::SourceFile = zeroed
    source_file.id <- DebuggerIdentity::debug_id(Test::SOURCE_FILE_ID)
    source_file.logical_path <- DebuggerIdentity::debug_id(Test::SOURCE_LOGICAL_PATH_ID)
    source_file.content <- DebuggerIdentity::debug_id(Test::SOURCE_CONTENT_DIGEST)
    source_file.line_count <- Test::SOURCE_LINE_COUNT
    source_file.path_length <- Test::SOURCE_PATH_LENGTH
    for path_index in 0..<Test::SOURCE_PATH_LENGTH:
        source_file.path_bytes[path_index] <- fixture_source_path_bytes[path_index]
    image.source_files[Test::SOURCE_FILE_INDEX] <- source_file
    image.function_count <- Test::Function::COUNT
    root_function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
    root_function.id <- DebuggerIdentity::debug_id(Test::Function::ROOT_ID)
    root_function.name_length <- Test::Function::ROOT_NAME_LENGTH
    root_function.entry_instruction <- Test::Function::ROOT_ENTRY
    root_function.end_instruction_exclusive <- Test::Function::ROOT_END
    root_function.source <- source_span(Test::SOURCE_FIRST_LINE, Test::SOURCE_FIRST_BYTE)
    for name_index in 0..<Test::Function::ROOT_NAME_LENGTH:
        root_function.name_bytes[name_index] <- Test::Function::ROOT_NAME.cast[u8&][name_index]
    callee_function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
    callee_function.id <- DebuggerIdentity::debug_id(Test::Function::CALLEE_ID)
    callee_function.name_length <- Test::Function::CALLEE_NAME_LENGTH
    callee_function.entry_instruction <- Test::Function::CALLEE_ENTRY
    callee_function.end_instruction_exclusive <- Test::Function::CALLEE_END
    callee_function.source <- source_span(Test::SOURCE_FIRST_LINE + Test::SOURCE_LINE_STEP * Test::CALLEE_ENTRY_INSTRUCTION.u32(), Test::SOURCE_FIRST_BYTE + Test::SOURCE_BYTE_STEP * Test::CALLEE_ENTRY_INSTRUCTION.u64())
    for name_index in 0..<Test::Function::CALLEE_NAME_LENGTH:
        callee_function.name_bytes[name_index] <- Test::Function::CALLEE_NAME.cast[u8&][name_index]
    image.functions[Test::Function::ROOT_INDEX] <- root_function
    image.functions[Test::Function::CALLEE_INDEX] <- callee_function
    image.instructions[Test::FIRST_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::FIRST_CONSTANT, b: Test::NO_SECOND_OPERAND, source: source_span(Test::SOURCE_FIRST_LINE, Test::SOURCE_FIRST_BYTE)}
    image.instructions[Test::SECOND_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: Test::FIRST_LOCAL_INDEX, b: Test::NO_SECOND_OPERAND, source: source_span(Test::SOURCE_FIRST_LINE + Test::SOURCE_LINE_STEP, Test::SOURCE_FIRST_BYTE + Test::SOURCE_BYTE_STEP)}
    image.instructions[Test::THIRD_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::SECOND_CONSTANT, b: Test::NO_SECOND_OPERAND, source: zeroed}
    image.instructions[Test::FOURTH_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: Test::SECOND_LOCAL_INDEX, b: Test::NO_SECOND_OPERAND, source: source_span(Test::SOURCE_FIRST_LINE + Test::SOURCE_LINE_STEP * 3, Test::SOURCE_FIRST_BYTE + Test::SOURCE_BYTE_STEP * 3)}
    image.instructions[Test::CALL_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Call, a: Test::CALLEE_ENTRY_INSTRUCTION.i64(), b: Test::NO_SECOND_OPERAND, source: source_span(Test::SOURCE_FIRST_LINE + Test::SOURCE_LINE_STEP * 4, Test::SOURCE_FIRST_BYTE + Test::SOURCE_BYTE_STEP * 4)}
    image.instructions[Test::ROOT_RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::NO_SECOND_OPERAND, b: Test::NO_SECOND_OPERAND, source: source_span(Test::SOURCE_FIRST_LINE + Test::SOURCE_LINE_STEP * 5, Test::SOURCE_FIRST_BYTE + Test::SOURCE_BYTE_STEP * 5)}
    image.instructions[Test::CALLEE_ENTRY_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::NO_SECOND_OPERAND, b: Test::NO_SECOND_OPERAND, source: source_span(Test::SOURCE_FIRST_LINE + Test::SOURCE_LINE_STEP * 6, Test::SOURCE_FIRST_BYTE + Test::SOURCE_BYTE_STEP * 6)}
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(image)
    return 1 if not DebuggerTraceBinary::writer_is_valid(encoded)
    return 2 if not write_all(encoded.bytes[0], encoded.length) can Blocking.IO, Unsafe.PointerCast
    return 0
