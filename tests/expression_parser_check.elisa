include "../src/inspect/expression_parser.elisa"

const module Test:
    EXPRESSION: cstr = "1 + 2 * (3 - 1)"
    WHITESPACE_EXPRESSION: cstr = " \t-4 + 10 / 2 \n"
    ASSOCIATIVE_EXPRESSION: cstr = "20 / 2 / 2"
    PARENTHESIS_EXPRESSION: cstr = "(2 + 3) * 4 - 1"
    EMPTY_EXPRESSION: cstr = " \t\n"
    MISSING_OPERAND_EXPRESSION: cstr = "1 +"
    MISSING_CLOSE_EXPRESSION: cstr = "(1 + 2"
    TRAILING_EXPRESSION: cstr = "1 2"
    DIVISION_BY_ZERO_EXPRESSION: cstr = "8 / (3 - 3)"
    LITERAL_OVERFLOW_EXPRESSION: cstr = "9223372036854775808"
    I64_MIN_EXPRESSION: cstr = "-9223372036854775808"
    NEGATIVE_LITERAL_OVERFLOW_EXPRESSION: cstr = "-9223372036854775809"
    BOUND_EXPRESSION: cstr = "local0 + local1 * 2"
    UNKNOWN_BINDING_EXPRESSION: cstr = "missing + 1"
    UNAVAILABLE_BINDING_EXPRESSION: cstr = "hidden + 1"
    LOCAL_ZERO_NAME: cstr = "local0"
    LOCAL_ONE_NAME: cstr = "local1"
    HIDDEN_NAME: cstr = "hidden"
    INVALID_NAME: cstr = "0bad"
    ARITHMETIC_OVERFLOW_EXPRESSION: cstr = "9223372036854775807 * 2"
    UNARY_PLUS_EXPRESSION: cstr = "+1"
    ASCII_ONE: u8 = 49
    ASCII_PLUS: u8 = 43
    ASCII_OPEN_PARENTHESIS: u8 = 40
    ASCII_CLOSE_PARENTHESIS: u8 = 41
    ZERO_INDEX: usize = 0
    SINGLE_BYTE_LENGTH: usize = 1
    OPERAND_SLOT_WIDTH: usize = 2
    MAX_SOURCE_BYTES: usize = 256
    MAX_NESTING_TEST: usize = 33
    NESTING_SOURCE_BYTES: usize = Test::MAX_NESTING_TEST * 2 + 1
    MAX_OPERAND_TEST: usize = 33
    OPERAND_SOURCE_BYTES: usize = Test::MAX_OPERAND_TEST * Test::OPERAND_SLOT_WIDTH - Test::SOURCE_LENGTH_INCREMENT
    SOURCE_LENGTH_INCREMENT: usize = 1
    EXPECTED_PRECEDENCE: i64 = 5
    EXPECTED_WHITESPACE: i64 = 1
    EXPECTED_ASSOCIATIVE: i64 = 5
    EXPECTED_PARENTHESIS: i64 = 19
    I64_MIN_VALUE: i64 = -9223372036854775807 - 1
    EXPECTED_BOUND_VALUE: i64 = 75
    LOCAL_ZERO_VALUE: i64 = 17
    LOCAL_ONE_VALUE: i64 = 29
    HIDDEN_VALUE: i64 = 0
    DUPLICATE_BINDING_VALUE: i64 = 99
    RESULT_SUCCESS: i64 = 0
    RESULT_PRECEDENCE: i64 = 1
    RESULT_WHITESPACE: i64 = 2
    RESULT_ASSOCIATIVE: i64 = 3
    RESULT_PARENTHESIS: i64 = 4
    RESULT_EMPTY: i64 = 5
    RESULT_MISSING_OPERAND: i64 = 6
    RESULT_MISSING_CLOSE: i64 = 7
    RESULT_TRAILING: i64 = 8
    RESULT_DIVISION_BY_ZERO: i64 = 9
    RESULT_LITERAL_OVERFLOW: i64 = 10
    RESULT_ARITHMETIC_OVERFLOW: i64 = 11
    RESULT_UNARY_PLUS: i64 = 12
    RESULT_SOURCE_LIMIT: i64 = 13
    RESULT_NESTING_LIMIT: i64 = 14
    RESULT_OPERAND_LIMIT: i64 = 15
    RESULT_I64_MIN: i64 = 16
    RESULT_NEGATIVE_LITERAL_OVERFLOW: i64 = 17
    RESULT_BINDING: i64 = 18
    RESULT_UNKNOWN_BINDING: i64 = 19
    RESULT_UNAVAILABLE_BINDING: i64 = 20
    RESULT_INVALID_BINDING: i64 = 21


const module ExpressionParserTestDetail:
    EMPTY_INPUT: u32 = 1
    EXPECTED_CLOSE_PARENTHESIS: u32 = 3
    TRAILING_INPUT: u32 = 4
    LITERAL_OVERFLOW: u32 = 5

def cstr_length(value: cstr) -> usize:
    length: mutable usize = 0
    while value[length] != 0:
        length <- length + Test::SOURCE_LENGTH_INCREMENT
    return length

def parse_text(value: cstr) -> DebuggerExpressionParser::ExpressionParseResult:
    return DebuggerExpressionParser::expression_parse(value.cast[u8&], cstr_length(value))

def main() -> i64:
    precedence: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::EXPRESSION)
    return Test::RESULT_PRECEDENCE if not precedence.valid or precedence.value != Test::EXPECTED_PRECEDENCE

    whitespace: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::WHITESPACE_EXPRESSION)
    return Test::RESULT_WHITESPACE if not whitespace.valid or whitespace.value != Test::EXPECTED_WHITESPACE

    associative: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::ASSOCIATIVE_EXPRESSION)
    return Test::RESULT_ASSOCIATIVE if not associative.valid or associative.value != Test::EXPECTED_ASSOCIATIVE

    parenthesis: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::PARENTHESIS_EXPRESSION)
    return Test::RESULT_PARENTHESIS if not parenthesis.valid or parenthesis.value != Test::EXPECTED_PARENTHESIS

    empty: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::EMPTY_EXPRESSION)
    return Test::RESULT_EMPTY if empty.valid or empty.failure.detail != ExpressionParserTestDetail::EMPTY_INPUT

    missing_operand: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::MISSING_OPERAND_EXPRESSION)
    return Test::RESULT_MISSING_OPERAND if missing_operand.valid or missing_operand.failure.code != DebuggerErrors::ErrorCode.InvalidArgument

    missing_close: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::MISSING_CLOSE_EXPRESSION)
    return Test::RESULT_MISSING_CLOSE if missing_close.valid or missing_close.failure.detail != ExpressionParserTestDetail::EXPECTED_CLOSE_PARENTHESIS

    trailing: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::TRAILING_EXPRESSION)
    return Test::RESULT_TRAILING if trailing.valid or trailing.failure.detail != ExpressionParserTestDetail::TRAILING_INPUT

    division_by_zero: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::DIVISION_BY_ZERO_EXPRESSION)
    return Test::RESULT_DIVISION_BY_ZERO if division_by_zero.valid or division_by_zero.failure.code != DebuggerErrors::ErrorCode.InvalidArgument

    literal_overflow: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::LITERAL_OVERFLOW_EXPRESSION)
    return Test::RESULT_LITERAL_OVERFLOW if literal_overflow.valid or literal_overflow.failure.detail != ExpressionParserTestDetail::LITERAL_OVERFLOW

    i64_minimum: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::I64_MIN_EXPRESSION)
    return Test::RESULT_I64_MIN if not i64_minimum.valid or i64_minimum.value != Test::I64_MIN_VALUE

    negative_literal_overflow: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::NEGATIVE_LITERAL_OVERFLOW_EXPRESSION)
    return Test::RESULT_NEGATIVE_LITERAL_OVERFLOW if negative_literal_overflow.valid or negative_literal_overflow.failure.detail != ExpressionParserTestDetail::LITERAL_OVERFLOW

    environment: mutable DebuggerExpressionParser::ExpressionEnvironment = DebuggerExpressionParser::expression_environment_new()
    return Test::RESULT_INVALID_BINDING if not DebuggerExpressionParser::expression_environment_add(environment, Test::LOCAL_ZERO_NAME.cast[u8&], cstr_length(Test::LOCAL_ZERO_NAME), Test::LOCAL_ZERO_VALUE, true)
    return Test::RESULT_INVALID_BINDING if not DebuggerExpressionParser::expression_environment_add(environment, Test::LOCAL_ONE_NAME.cast[u8&], cstr_length(Test::LOCAL_ONE_NAME), Test::LOCAL_ONE_VALUE, true)
    return Test::RESULT_INVALID_BINDING if not DebuggerExpressionParser::expression_environment_add(environment, Test::HIDDEN_NAME.cast[u8&], cstr_length(Test::HIDDEN_NAME), Test::HIDDEN_VALUE, false)
    return Test::RESULT_INVALID_BINDING if DebuggerExpressionParser::expression_environment_add(environment, Test::LOCAL_ZERO_NAME.cast[u8&], cstr_length(Test::LOCAL_ZERO_NAME), Test::DUPLICATE_BINDING_VALUE, true)
    return Test::RESULT_INVALID_BINDING if DebuggerExpressionParser::expression_environment_add(environment, Test::INVALID_NAME.cast[u8&], cstr_length(Test::INVALID_NAME), Test::HIDDEN_VALUE, true)
    bound: DebuggerExpressionParser::ExpressionParseResult = DebuggerExpressionParser::expression_parse_with_environment(Test::BOUND_EXPRESSION.cast[u8&], cstr_length(Test::BOUND_EXPRESSION), environment)
    return Test::RESULT_BINDING if not bound.valid or bound.value != Test::EXPECTED_BOUND_VALUE

    unknown_binding: DebuggerExpressionParser::ExpressionParseResult = DebuggerExpressionParser::expression_parse_with_environment(Test::UNKNOWN_BINDING_EXPRESSION.cast[u8&], cstr_length(Test::UNKNOWN_BINDING_EXPRESSION), environment)
    return Test::RESULT_UNKNOWN_BINDING if unknown_binding.valid or unknown_binding.failure.code != DebuggerErrors::ErrorCode.InvalidArgument

    unavailable_binding: DebuggerExpressionParser::ExpressionParseResult = DebuggerExpressionParser::expression_parse_with_environment(Test::UNAVAILABLE_BINDING_EXPRESSION.cast[u8&], cstr_length(Test::UNAVAILABLE_BINDING_EXPRESSION), environment)
    return Test::RESULT_UNAVAILABLE_BINDING if unavailable_binding.valid or unavailable_binding.failure.code != DebuggerErrors::ErrorCode.Unavailable

    arithmetic_overflow: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::ARITHMETIC_OVERFLOW_EXPRESSION)
    return Test::RESULT_ARITHMETIC_OVERFLOW if arithmetic_overflow.valid or arithmetic_overflow.failure.code != DebuggerErrors::ErrorCode.InvalidArgument

    unary_plus: DebuggerExpressionParser::ExpressionParseResult = parse_text(Test::UNARY_PLUS_EXPRESSION)
    return Test::RESULT_UNARY_PLUS if unary_plus.valid or unary_plus.failure.code != DebuggerErrors::ErrorCode.InvalidArgument

    short_source: mutable u8[Test::SINGLE_BYTE_LENGTH] = [Test::ASCII_ONE]
    source_limit: DebuggerExpressionParser::ExpressionParseResult = DebuggerExpressionParser::expression_parse(short_source[0], Test::MAX_SOURCE_BYTES + Test::SOURCE_LENGTH_INCREMENT)
    return Test::RESULT_SOURCE_LIMIT if source_limit.valid or source_limit.failure.code != DebuggerErrors::ErrorCode.ResourceLimit

    nested: mutable u8[Test::NESTING_SOURCE_BYTES] = zeroed
    for index in Test::ZERO_INDEX..<Test::MAX_NESTING_TEST:
        nested[index] <- Test::ASCII_OPEN_PARENTHESIS
        nested[Test::MAX_NESTING_TEST + Test::SOURCE_LENGTH_INCREMENT + index] <- Test::ASCII_CLOSE_PARENTHESIS
    nested[Test::MAX_NESTING_TEST] <- Test::ASCII_ONE
    nesting_limit: DebuggerExpressionParser::ExpressionParseResult = DebuggerExpressionParser::expression_parse(nested[0], Test::NESTING_SOURCE_BYTES)
    return Test::RESULT_NESTING_LIMIT if nesting_limit.valid or nesting_limit.failure.code != DebuggerErrors::ErrorCode.ResourceLimit

    operands: mutable u8[Test::OPERAND_SOURCE_BYTES] = zeroed
    for index in Test::ZERO_INDEX..<Test::MAX_OPERAND_TEST:
        operands[index * Test::OPERAND_SLOT_WIDTH] <- Test::ASCII_ONE
        operands[index * Test::OPERAND_SLOT_WIDTH + Test::SOURCE_LENGTH_INCREMENT] <- Test::ASCII_PLUS if index + Test::SOURCE_LENGTH_INCREMENT < Test::MAX_OPERAND_TEST
    operand_limit: DebuggerExpressionParser::ExpressionParseResult = DebuggerExpressionParser::expression_parse(operands[Test::ZERO_INDEX], Test::OPERAND_SOURCE_BYTES)
    return Test::RESULT_OPERAND_LIMIT if operand_limit.valid or operand_limit.failure.code != DebuggerErrors::ErrorCode.ResourceLimit

    return Test::RESULT_SUCCESS
