# Host boundary probe: byte-oriented pipe I/O through Elisa declarations.
# The debugger owns the policy; libc supplies only the documented primitive.

extern read(fd: int, buf: void&, count: usize) -> isize can[Blocking.IO]
extern write(fd: int, buf: void&, count: usize) -> isize can[Blocking.IO]

const module Test:
    STDIN_FD: int = 0
    STDOUT_FD: int = 1
    PROBE_LENGTH: usize = 3
    PROBE_VALUE_0: u8 = 69
    PROBE_VALUE_1: u8 = 76
    PROBE_VALUE_2: u8 = 73
    PROBE_SUCCESS: i64 = 0
    PROBE_FAILURE: i64 = 1
    PROBE_CONTENT_FAILURE: i64 = 40


def main() -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    input: mutable u8[Test::PROBE_LENGTH] = zeroed
    received: isize = read(Test::STDIN_FD, (&input[0]).cast[void&], Test::PROBE_LENGTH) can Blocking.IO
    return Test::PROBE_FAILURE if received != Test::PROBE_LENGTH.isize()
    return Test::PROBE_CONTENT_FAILURE if input[0] != Test::PROBE_VALUE_0 or input[1] != Test::PROBE_VALUE_1 or input[2] != Test::PROBE_VALUE_2
    written: isize = write(Test::STDOUT_FD, (&input[0]).cast[void&], Test::PROBE_LENGTH) can Blocking.IO
    return Test::PROBE_FAILURE if written != Test::PROBE_LENGTH.isize()
    return Test::PROBE_SUCCESS
