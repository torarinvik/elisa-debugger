# Host boundary probe: byte-oriented pipe I/O through Elisa declarations.
# The debugger owns the policy; libc supplies only the documented primitive.

extern read(fd: int, buf: void&, count: usize) -> isize can[Blocking.IO]
extern write(fd: int, buf: void&, count: usize) -> isize can[Blocking.IO]

const STDIN_FD: int = 0
const STDOUT_FD: int = 1
const PROBE_LENGTH: usize = 3
const PROBE_VALUE_0: u8 = 69
const PROBE_VALUE_1: u8 = 76
const PROBE_VALUE_2: u8 = 73
const PROBE_SUCCESS: i64 = 0
const PROBE_FAILURE: i64 = 1
const PROBE_CONTENT_FAILURE: i64 = 40

def main() -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    input: mutable u8[PROBE_LENGTH] = zeroed
    received: isize = read(STDIN_FD, (&input[0]).cast[void&], PROBE_LENGTH) can Blocking.IO
    return PROBE_FAILURE if received != PROBE_LENGTH.isize()
    return PROBE_CONTENT_FAILURE if input[0] != PROBE_VALUE_0 or input[1] != PROBE_VALUE_1 or input[2] != PROBE_VALUE_2
    written: isize = write(STDOUT_FD, (&input[0]).cast[void&], PROBE_LENGTH) can Blocking.IO
    return PROBE_FAILURE if written != PROBE_LENGTH.isize()
    return PROBE_SUCCESS
