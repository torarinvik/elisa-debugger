def test_checksum_with_basis(bytes: u8&, length: usize, basis: u64) -> u64:
    checksum: mutable u64 = basis
    for index in 0..<length:
        checksum <- (checksum ^ bytes[index].u64()) * Test::HASH_PRIME
    return checksum

def test_legacy_checksum(bytes: u8&, length: usize) -> u64:
    return test_checksum_with_basis(bytes, length, Test::FNV64_LEGACY_OFFSET_BASIS)

def test_put_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
    for index in 0..<8:
        bytes[offset + index] <- (value >> (index.u64() * Test::HASH_BYTE_BITS)).u8()

def test_get_u64(bytes: u8&, offset: usize) -> u64:
    value: mutable u64 = 0
    for index in 0..<8:
        value <- value | (bytes[offset + index].u64() << (index.u64() * Test::HASH_BYTE_BITS))
    return value

def test_rewrite_frame_checksum_legacy(bytes: mutable u8&, frame_offset: usize, payload_length: usize) -> void:
    checksum: u64 = test_legacy_checksum(bytes[frame_offset + Test::TRACE_HEADER_BYTES], payload_length)
    test_put_u64(bytes, frame_offset + Test::TRACE_CHECKSUM_OFFSET, checksum)

def test_build_identity() -> DebuggerIdentity::BuildIdentity:
    return DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(Test::RUNTIME_ID),
        source: DebuggerIdentity::debug_id(Test::SOURCE_ID),
        target: DebuggerIdentity::debug_id(Test::TARGET_ID),
        metadata_version: Test::METADATA_VERSION
    }

def make_checkpoint() -> DebuggerFullCheckpoint::ManagedCheckpoint:
    machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    machine.program_counter <- Test::MACHINE_PC
    machine.accumulator <- Test::MACHINE_ACCUMULATOR
    machine.result <- Test::MACHINE_RESULT
    machine.locals[Test::LOCAL_INDEX] <- Test::MACHINE_LOCAL_VALUE
    machine.locals_initialized[Test::LOCAL_INDEX] <- true
    machine.return_stack_pointer <- Test::MACHINE_STACK_POINTER
    machine.return_stack[Test::LOCAL_INDEX] <- Test::MACHINE_RETURN_PC
    machine.frame_locals[Test::FRAME_LOCAL_INDEX] <- Test::MACHINE_FRAME_VALUE
    machine.frame_locals_initialized[Test::FRAME_LOCAL_INDEX] <- true
    machine.heap_next <- Test::MACHINE_HEAP_NEXT
    machine.memory[Test::MEMORY_INDEX] <- Test::MACHINE_MEMORY_VALUE
    machine.memory_initialized[Test::MEMORY_INDEX] <- true
    machine.steps <- Test::CHECKPOINT_EVENT

    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    DebuggerConcurrencyRuntime::runtime_initialize(runtime, false)
    first_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(Test::NO_PARENT_TASK))
    second_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(Test::NO_PARENT_TASK))
    _ = DebuggerConcurrencyRuntime::runtime_wait(runtime, first_task, second_task, DebuggerIdentity::debug_id(Test::WAIT_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex)
    _ = DebuggerConcurrencyRuntime::runtime_schedule(runtime, second_task, DebuggerScheduler::ScheduleKind.Run, DebuggerIdentity::debug_id(Test::NO_SYNC_RESOURCE))
    tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)

    effects: mutable DebuggerEffects::EffectOracle = zeroed
    DebuggerEffects::effect_oracle_initialize(effects, DebuggerEffects::EffectMode.Recording)
    DebuggerEffects::effect_oracle_record_in_invocation(effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::EFFECT_CLOCK_CALL_SITE_ID), DebuggerIdentity::debug_id(Test::EFFECT_CLOCK_INVOCATION_ID), Test::EFFECT_REQUEST_HASH, Test::EFFECT_RESULT_HASH, Test::EFFECT_RESULT_VALUE)
    DebuggerEffects::effect_oracle_record_random_in_invocation(effects, DebuggerIdentity::debug_id(Test::EFFECT_RANDOM_CALL_SITE_ID), DebuggerIdentity::debug_id(Test::EFFECT_RANDOM_INVOCATION_ID), Test::EFFECT_REQUEST_HASH + Test::SECOND_EFFECT_OFFSET, Test::EFFECT_RESULT_HASH + Test::SECOND_EFFECT_OFFSET, Test::ADAPTER_RANDOM_SECOND)

    resources: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(resources, DebuggerVirtualResources::ResourceMode.Recording)
    data: mutable u8[Test::RESOURCE_BYTES] = zeroed
    data[Test::RESOURCE_FIRST_INDEX] <- Test::RESOURCE_BYTE_0
    data[Test::RESOURCE_SECOND_INDEX] <- Test::RESOURCE_BYTE_1
    data[Test::RESOURCE_THIRD_INDEX] <- Test::RESOURCE_BYTE_2
    data[Test::RESOURCE_FOURTH_INDEX] <- Test::RESOURCE_BYTE_3
    data[Test::RESOURCE_FIFTH_INDEX] <- Test::RESOURCE_BYTE_4
    mounted_resource: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_mount(resources, DebuggerIdentity::debug_id(Test::RESOURCE_PATH_ID), true, Test::RESOURCE_GENERATION, data[Test::RESOURCE_FIRST_INDEX], Test::RESOURCE_BYTES)
    handle: DebuggerIdentity::DebugId = mounted_resource.handle
    resource_read: mutable u8[Test::RESOURCE_READ_LENGTH] = zeroed
    _ = DebuggerVirtualResources::resources_read(resources, handle, resource_read[Test::RESOURCE_FIRST_INDEX], Test::RESOURCE_READ_LENGTH)
    resource_write: mutable u8[Test::RESOURCE_WRITE_LENGTH] = [Test::RESOURCE_MUTATED_BYTE]
    _ = DebuggerVirtualResources::resources_write(resources, handle, resource_write[Test::RESOURCE_FIRST_INDEX], Test::RESOURCE_WRITE_LENGTH)
    _ = DebuggerVirtualResources::resources_seek(resources, handle, Test::RESOURCE_CURSOR)

    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ADAPTER_SOURCE_ID)
    invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ADAPTER_INVOCATION_ID)
    clock: mutable DebuggerReplayAdapters::Clock = zeroed
    DebuggerReplayAdapters::clock_initialize(clock, DebuggerReplayAdapters::AdapterMode.Recording)
    _ = DebuggerReplayAdapters::clock_record_in_invocation(clock, source, invocation, Test::ADAPTER_CLOCK_FIRST)
    _ = DebuggerReplayAdapters::clock_record_in_invocation(clock, source, invocation, Test::ADAPTER_CLOCK_SECOND)
    clock.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    first_clock_read: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read_in_invocation(clock, source, invocation)
    if not first_clock_read.accepted:
        clock.exact <- false

    random: mutable DebuggerReplayAdapters::Random = zeroed
    DebuggerReplayAdapters::random_initialize(random, DebuggerReplayAdapters::AdapterMode.Recording)
    _ = DebuggerReplayAdapters::random_record_in_invocation(random, source, invocation, Test::ADAPTER_RANDOM_FIRST)
    _ = DebuggerReplayAdapters::random_record_in_invocation(random, source, invocation, Test::ADAPTER_RANDOM_SECOND)
    random.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    first_random_read: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read_in_invocation(random, source, invocation)
    if not first_random_read.accepted:
        random.exact <- false

    input: mutable u8[Test::ADAPTER_INPUT_LENGTH] = [Test::ADAPTER_INPUT_BYTE]
    output: mutable u8[Test::ADAPTER_OUTPUT_LENGTH] = [Test::ADAPTER_OUTPUT_BYTE]
    console: mutable DebuggerReplayAdapters::Console = zeroed
    DebuggerReplayAdapters::console_initialize(console, DebuggerReplayAdapters::AdapterMode.Recording)
    _ = DebuggerReplayAdapters::console_record_input(console, DebuggerReplayAdapters::ConsoleChannel.Stdin, input[0], Test::ADAPTER_INPUT_LENGTH)
    recorded_output: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(console, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[0], Test::ADAPTER_OUTPUT_LENGTH)
    if not recorded_output.accepted:
        console.exact <- false
    console.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    console.output_suppressed <- true
    replay_input: mutable u8[Test::ADAPTER_INPUT_LENGTH] = zeroed
    first_input_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(console, DebuggerReplayAdapters::ConsoleChannel.Stdin, replay_input[0], Test::ADAPTER_INPUT_LENGTH)
    if not first_input_read.accepted:
        console.exact <- false
    adapters: DebuggerReplayAdapters::AdapterSnapshot = DebuggerReplayAdapters::AdapterSnapshot{clock: clock, random: random, console: console}

    machine_probe: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(machine, DebuggerIdentity::debug_id(Test::CHECKPOINT_EVENT + 1), Test::CHECKPOINT_EVENT, 0)
    state_hash: u64 = DebuggerCheckpoint::snapshot_state_hash(machine_probe)
    return DebuggerFullCheckpoint::full_checkpoint_capture_with_adapters(machine, tasks, effects, resources, adapters, DebuggerIdentity::debug_id(Test::RECORDING_ID), DebuggerIdentity::debug_id(Test::BRANCH_ID), Test::CHECKPOINT_EVENT, state_hash, test_build_identity(), Test::IMAGE_FINGERPRINT, true)

# Schema 10 adds only typed scalar kinds; schema 9 retains its hash domain
# and field layout, and cannot smuggle in a kind introduced by schema 10.
def check_scalar_file_codec_versions() -> i64:
    checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()
    encoded: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    return 71 if encoded.failed
    return 71 if encoded.bytes[Test::CODEC_SCHEMA_OFFSET] != 9
    encoded.bytes[Test::CODEC_SCHEMA_OFFSET] <- 10
    checksum: mutable u64 = DebuggerTraceBinary::bytes_checksum(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES)
    test_put_u64(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES, checksum)
    legacy: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
    return 72 if legacy.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not checkpoints_are_equal(checkpoint, legacy.checkpoint)
    encoded.bytes[Test::CODEC_SCHEMA_OFFSET] <- 9
    checksum <- DebuggerTraceBinary::bytes_checksum(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES)
    test_put_u64(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES, checksum)
    old_wire: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
    return 72 if old_wire.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not checkpoints_are_equal(checkpoint, old_wire.checkpoint)
    for scenario in 0..<3:
        kind: mutable DebuggerEffects::EffectKind = DebuggerEffects::EffectKind.VirtualFileTryReadByte
        kind <- DebuggerEffects::EffectKind.VirtualFileTryWriteByte if scenario == 1
        kind <- DebuggerEffects::EffectKind.VirtualFileTrySeek if scenario == 2
        checkpoint.effects.records[0].kind <- kind
        checkpoint.effects.records[0].suppress_external_write <- DebuggerEffects::effect_is_external_write(kind)
        checkpoint.effects.records[0].result_value <- -2 - scenario.i64()
        checkpoint.effects.records[0].result_hash <- DebuggerManagedState::state_effect_result_hash(checkpoint.effects.records[0].result_value.u64())
        DebuggerFullCheckpoint::full_checkpoint_seal_side_state(checkpoint)
        encoded <- DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
        return 73 if encoded.failed or encoded.bytes[Test::CODEC_SCHEMA_OFFSET] != 10
        decoded: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
        return 74 if decoded.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not checkpoints_are_equal(checkpoint, decoded.checkpoint)
        encoded.bytes[Test::CODEC_SCHEMA_OFFSET] <- 9
        checksum <- DebuggerTraceBinary::bytes_checksum(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES)
        test_put_u64(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES, checksum)
        rejected: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
        return 75 if rejected.status != DebuggerFullCheckpointCodec::DecodeStatus.Invalid
    return 0

# Schema 11 carries logical close/reopen in both journals. Older schema
# headers cannot admit them, even with a corrected wire checksum.
def check_lifecycle_codec_versions() -> i64:
    checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()
    resources: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(resources, DebuggerVirtualResources::ResourceMode.Recording)
    bytes: mutable u8[1] = [65]
    mounted: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_mount(resources, DebuggerIdentity::debug_id(81), true, 1, bytes[0], 1)
    return 76 if not mounted.accepted or not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_close(resources, mounted.handle))
    return 76 if not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_replay_restart(resources)) or not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_close(resources, mounted.handle))
    checkpoint.resources <- resources
    for scenario in 0..<3:
        if scenario != 0:
            checkpoint.effects.records[0].kind <- DebuggerEffects::EffectKind.VirtualFileTryClose if scenario == 1 else DebuggerEffects::EffectKind.VirtualFileTryReopen
            checkpoint.effects.records[0].suppress_external_write <- false
            checkpoint.effects.records[0].result_value <- 0 if scenario == 1 else 1
            checkpoint.effects.records[0].result_hash <- DebuggerManagedState::state_effect_result_hash(checkpoint.effects.records[0].result_value.u64())
        DebuggerFullCheckpoint::full_checkpoint_seal_side_state(checkpoint)
        encoded: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
        return 77 if encoded.failed or encoded.bytes[Test::CODEC_SCHEMA_OFFSET] != 11
        decoded: mutable DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
        return 78 if decoded.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not checkpoints_are_equal(checkpoint, decoded.checkpoint) or DebuggerVirtualResources::resources_handle_is_open(decoded.checkpoint.resources, mounted.handle)
        for schema in 9..<11:
            encoded.bytes[Test::CODEC_SCHEMA_OFFSET] <- schema.u8()
            checksum: u64 = DebuggerTraceBinary::bytes_checksum(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES)
            test_put_u64(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES, checksum)
            decoded <- DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
            return 79 if decoded.status != DebuggerFullCheckpointCodec::DecodeStatus.Invalid
    # Scalar lifecycle kinds also require schema 11 when no resource closes exist.
    original: DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()
    checkpoint.resources <- original.resources
    DebuggerFullCheckpoint::full_checkpoint_seal_side_state(checkpoint)
    scalar: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    return 80 if scalar.failed or scalar.bytes[Test::CODEC_SCHEMA_OFFSET] != 11
    scalar.bytes[Test::CODEC_SCHEMA_OFFSET] <- 10
    checksum: u64 = DebuggerTraceBinary::bytes_checksum(scalar.bytes[0], scalar.length - Test::CODEC_CHECKSUM_BYTES)
    test_put_u64(scalar.bytes[0], scalar.length - Test::CODEC_CHECKSUM_BYTES, checksum)
    rejected: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(scalar.bytes[0], scalar.length)
    return 81 if rejected.status != DebuggerFullCheckpointCodec::DecodeStatus.Invalid
    return 0

def check_resource_snapshot_isolation() -> i64:
    resources: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(resources, DebuggerVirtualResources::ResourceMode.Recording)
    handle: DebuggerIdentity::DebugId = DebuggerVirtualResources::resources_open(resources, DebuggerIdentity::debug_id(Test::RESOURCE_PATH_ID), true, Test::RESOURCE_GENERATION)
    data: mutable u8[Test::RESOURCE_BYTES] = zeroed
    data[Test::RESOURCE_FIRST_INDEX] <- Test::RESOURCE_BYTE_0
    seeded: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seed(resources, handle, data[Test::RESOURCE_FIRST_INDEX], Test::RESOURCE_BYTES)
    return Test::RESOURCE_SNAPSHOT_ISOLATION_FAILURE if not DebuggerErrors::error_is_ok(seeded)
    snapshot: mutable DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_clone_snapshot(resources)
    snapshot.files[Test::RESOURCE_FIRST_INDEX].bytes[Test::RESOURCE_FIRST_INDEX] <- Test::RESOURCE_MUTATED_BYTE
    return Test::RESOURCE_SNAPSHOT_ISOLATION_FAILURE if resources.files[Test::RESOURCE_FIRST_INDEX].bytes[Test::RESOURCE_FIRST_INDEX] != Test::RESOURCE_BYTE_0 or snapshot.files[Test::RESOURCE_FIRST_INDEX].bytes[Test::RESOURCE_FIRST_INDEX] != Test::RESOURCE_MUTATED_BYTE
    return Test::TEST_SUCCESS

def check_empty_recording_adapter_checkpoint() -> i64:
    managed_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(managed_state)
    return Test::EMPTY_RECORDING_ADAPTER_CHECKPOINT_FAILURE if not DebuggerReplayAdapters::adapter_snapshot_is_valid(managed_state.adapters)
    return Test::EMPTY_RECORDING_ADAPTER_CHECKPOINT_FAILURE if managed_state.adapters.clock.mode != DebuggerReplayAdapters::AdapterMode.Recording or managed_state.adapters.random.mode != DebuggerReplayAdapters::AdapterMode.Recording or managed_state.adapters.console.mode != DebuggerReplayAdapters::AdapterMode.Recording
    checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()
    DebuggerReplayAdapters::adapter_snapshot_initialize_recording(checkpoint.adapters)
    DebuggerFullCheckpoint::full_checkpoint_seal_side_state(checkpoint)
    return Test::EMPTY_RECORDING_ADAPTER_CHECKPOINT_FAILURE if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
    encoded: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    return Test::EMPTY_RECORDING_ADAPTER_CHECKPOINT_FAILURE if encoded.failed or encoded.length == Test::EMPTY_ADAPTER_SAMPLE_COUNT
    decoded: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
    return Test::EMPTY_RECORDING_ADAPTER_CHECKPOINT_FAILURE if decoded.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not DebuggerFullCheckpoint::full_checkpoint_is_valid(decoded.checkpoint)
    adapters: DebuggerReplayAdapters::AdapterSnapshot = decoded.checkpoint.adapters
    return Test::EMPTY_RECORDING_ADAPTER_CHECKPOINT_FAILURE if adapters.clock.mode != DebuggerReplayAdapters::AdapterMode.Recording or adapters.random.mode != DebuggerReplayAdapters::AdapterMode.Recording or adapters.console.mode != DebuggerReplayAdapters::AdapterMode.Recording
    return Test::EMPTY_RECORDING_ADAPTER_CHECKPOINT_FAILURE if adapters.clock.count != Test::EMPTY_ADAPTER_SAMPLE_COUNT or adapters.random.count != Test::EMPTY_ADAPTER_SAMPLE_COUNT or adapters.console.count != Test::EMPTY_ADAPTER_SAMPLE_COUNT
    return Test::EMPTY_RECORDING_ADAPTER_CHECKPOINT_FAILURE if not DebuggerReplayAdapters::adapter_snapshot_is_valid(adapters)
    return Test::TEST_SUCCESS

def checkpoint_manifest_chunk(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> DebuggerTraceStorage::StoredChunk:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(Test::RUNTIME_ID),
        source: DebuggerIdentity::debug_id(Test::SOURCE_ID),
        target: DebuggerIdentity::debug_id(Test::TARGET_ID),
        metadata_version: Test::METADATA_VERSION
    }
    manifest: mutable DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
    manifest.first_event <- checkpoint.event
    manifest.last_event <- checkpoint.event
    manifest.checkpoint_count <- Test::TRACE_CHECKPOINT_COUNT
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    checksum: u64 = DebuggerTraceBinary::writer_checksum(payload)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: manifest.schema.u32(), kind: DebuggerTrace::ChunkKind.Manifest, sequence: Test::TRACE_MANIFEST_SEQUENCE, first_event: checkpoint.event, last_event: checkpoint.event, payload_length: payload.length.u64(), checksum: checksum}
    chunk.payload_length <- payload.length
    chunk.checksum <- checksum
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def check_artifact_fingerprint() -> i64:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::EDIR_PROGRAM_VERSION, instruction_count: Test::EDIR_INSTRUCTION_COUNT, local_count: Test::EDIR_NO_LOCALS, has_return: true}
    image.instructions[Test::EDIR_FIRST_INSTRUCTION_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: Test::EDIR_ZERO_OPERAND, b: Test::EDIR_ZERO_OPERAND, source: zeroed}
    image.instructions[Test::EDIR_RETURN_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::EDIR_ZERO_OPERAND, b: Test::EDIR_ZERO_OPERAND, source: zeroed}
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerEDIRCodec::artifact_encode(image)
    fingerprint: DebuggerEDIRCodec::ArtifactFingerprint = DebuggerEDIRCodec::artifact_fingerprint(image)
    return Test::ARTIFACT_FINGERPRINT_RESULT_FAILURE if not DebuggerTraceBinary::writer_is_valid(encoded) or not fingerprint.valid or fingerprint.value != DebuggerTraceBinary::writer_checksum(encoded)
    invalid_image: mutable DebuggerEDIR::ProgramImage = image
    invalid_image.program.has_return <- false
    invalid_fingerprint: DebuggerEDIRCodec::ArtifactFingerprint = DebuggerEDIRCodec::artifact_fingerprint(invalid_image)
    return Test::INVALID_ARTIFACT_FINGERPRINT_ACCEPTED if invalid_fingerprint.valid
    return Test::TEST_SUCCESS

def checkpoint_trace_event_chunk(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> DebuggerTraceStorage::StoredChunk:
    position: mutable DebuggerIdentity::Position = DebuggerIdentity::initial_position(checkpoint.recording)
    position.branch <- checkpoint.branch
    position.event <- checkpoint.event
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::TRACE_SCHEMA, checkpoint.event, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::TRACE_EVENT_HASH)
    payload: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(payload)
    DebuggerTraceBinary::writer_put_u32(payload, event.schema)
    DebuggerTraceBinary::writer_put_u64(payload, event.ordinal)
    DebuggerTraceBinary::writer_put_u64(payload, event.task.value)
    DebuggerTraceBinary::writer_put_u64(payload, event.position.recording.value)
    DebuggerTraceBinary::writer_put_u64(payload, event.position.branch.value)
    DebuggerTraceBinary::writer_put_u64(payload, event.position.event)
    DebuggerTraceBinary::writer_put_u64(payload, event.position.task.value)
    DebuggerTraceBinary::writer_put_u64(payload, event.position.invocation.value)
    DebuggerTraceBinary::writer_put_u64(payload, event.position.statement.value)
    DebuggerTraceBinary::writer_put_u32(payload, event.position.microstep)
    DebuggerTraceBinary::writer_put_u16(payload, event.kind.u16())
    DebuggerTraceBinary::writer_put_u16(payload, event.quality.u16())
    DebuggerTraceBinary::writer_put_u64(payload, event.state_hash)
    DebuggerTraceBinary::writer_put_u16(payload, event.payload_kind.u16())
    DebuggerTraceBinary::writer_put_u16(payload, event.payload_length)
    DebuggerTraceBinary::writer_put_u64(payload, event.payload_hash)
    for index in 0..<Test::LEGACY_TRACE_EVENT_PAYLOAD_BYTES:
        DebuggerTraceBinary::writer_put_byte(payload, event.payload[index])
    checksum: u64 = DebuggerTraceBinary::writer_checksum(payload)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::TRACE_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: Test::TRACE_EVENT_SEQUENCE, first_event: checkpoint.event, last_event: checkpoint.event, payload_length: payload.length.u64(), checksum: checksum}
    chunk.payload_length <- payload.length
    chunk.checksum <- checksum
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def make_large_checkpoint() -> DebuggerFullCheckpoint::ManagedCheckpoint:
    checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()

    task: mutable DebuggerConcurrency::TaskInfo = DebuggerConcurrency::TaskInfo{id: DebuggerIdentity::debug_id(Test::LARGE_CHECKPOINT_TASK_ID), parent: DebuggerIdentity::debug_id(Test::NO_PARENT_TASK), state: DebuggerConcurrency::TaskState.Running, logical_time: Test::LARGE_CHECKPOINT_TASK_LOGICAL_TIME, os_thread: Test::LARGE_CHECKPOINT_OS_THREAD}
    checkpoint.tasks.task_count <- Test::LARGE_CHECKPOINT_TASK_COUNT
    checkpoint.tasks.next_id <- Test::LARGE_CHECKPOINT_NEXT_TASK_ID
    checkpoint.tasks.tasks[0] <- task
    checkpoint.tasks.status <- DebuggerConcurrencyRuntime::RuntimeStatus.Running
    checkpoint.tasks.current <- task.id
    checkpoint.tasks.wait_count <- Test::LARGE_CHECKPOINT_WAIT_COUNT
    checkpoint.tasks.scheduler_cursor <- Test::LARGE_CHECKPOINT_SCHEDULER_CURSOR
    checkpoint.tasks.scheduler_count <- Test::SCHEDULE_CAPACITY
    checkpoint.tasks.scheduler_replaying <- false
    checkpoint.tasks.scheduler_diverged <- false
    checkpoint.tasks.scheduler_overflowed <- false
    for index in 0..<Test::SCHEDULE_CAPACITY:
        checkpoint.tasks.scheduler_decisions[index] <- DebuggerScheduler::ScheduleDecision{ordinal: index.u64(), task: task, kind: DebuggerScheduler::ScheduleKind.Run, synchronization: Test::NO_SYNC_RESOURCE}

    checkpoint.effects.count <- Test::EFFECT_CAPACITY
    checkpoint.effects.cursor <- Test::LARGE_CHECKPOINT_EFFECT_CURSOR
    for index in 0..<Test::EFFECT_CAPACITY:
        checkpoint.effects.records[index] <- DebuggerEffects::EffectRecord{sequence: index.u64(), kind: DebuggerEffects::EffectKind.Clock, call_site: DebuggerIdentity::debug_id(Test::EFFECT_CALL_SITE_BASE + index.u64()), invocation: DebuggerIdentity::debug_id(Test::EFFECT_INVOCATION_BASE + index.u64()), request_hash: Test::EFFECT_REQUEST_HASH, result_hash: Test::EFFECT_RESULT_HASH, result_value: Test::EFFECT_RESULT_VALUE, suppress_external_write: false}

    checkpoint.resources.count <- Test::RESOURCE_CAPACITY
    checkpoint.resources.next_handle <- Test::LARGE_CHECKPOINT_NEXT_HANDLE
    for index in 0..<Test::RESOURCE_CAPACITY:
        checkpoint.resources.files[index].handle <- DebuggerIdentity::debug_id(Test::LARGE_CHECKPOINT_FIRST_HANDLE + index.u64())
        checkpoint.resources.files[index].path <- DebuggerIdentity::debug_id(Test::RESOURCE_PATH_ID + index.u64())
        checkpoint.resources.files[index].length <- Test::LARGE_CHECKPOINT_FILE_LENGTH
        checkpoint.resources.files[index].initial_length <- Test::LARGE_CHECKPOINT_FILE_LENGTH
        checkpoint.resources.files[index].cursor <- Test::LARGE_CHECKPOINT_FILE_CURSOR if index == Test::RESOURCE_FIRST_INDEX
        checkpoint.resources.files[index].writable <- true
        checkpoint.resources.files[index].generation <- Test::RESOURCE_GENERATION
    for index in Test::LARGE_CHECKPOINT_FIRST_ADDITIONAL_RESOURCE..<Test::RESOURCE_CAPACITY:
        operation_index: usize = checkpoint.resources.operation_count
        operation: DebuggerVirtualResources::ResourceOperation = zeroed
        operation.sequence <- operation_index.u64()
        operation.kind <- DebuggerVirtualResources::ResourceOperationKind.Open
        operation.handle <- checkpoint.resources.files[index].handle
        operation.path <- checkpoint.resources.files[index].path
        operation.generation <- checkpoint.resources.files[index].generation
        operation.writable <- checkpoint.resources.files[index].writable
        checkpoint.resources.operations[operation_index] <- operation
        checkpoint.resources.operation_count <- operation_index + Test::ONE
        checkpoint.resources.operation_cursor <- checkpoint.resources.operation_count

    checkpoint.adapters.clock.count <- Test::LARGE_ADAPTER_SAMPLE_CAPACITY
    for index in 0..<Test::LARGE_ADAPTER_SAMPLE_CAPACITY:
        checkpoint.adapters.clock.samples[index] <- DebuggerReplayAdapters::AdapterSample{sequence: index.u64(), source: DebuggerIdentity::debug_id(Test::ADAPTER_SOURCE_ID), invocation: DebuggerIdentity::debug_id(Test::ADAPTER_INVOCATION_ID), value: Test::ADAPTER_CLOCK_FIRST}
    checkpoint.adapters.random.count <- Test::LARGE_ADAPTER_SAMPLE_CAPACITY
    for index in 0..<Test::LARGE_ADAPTER_SAMPLE_CAPACITY:
        checkpoint.adapters.random.samples[index] <- DebuggerReplayAdapters::AdapterSample{sequence: index.u64(), source: DebuggerIdentity::debug_id(Test::ADAPTER_SOURCE_ID), invocation: DebuggerIdentity::debug_id(Test::ADAPTER_INVOCATION_ID), value: Test::ADAPTER_RANDOM_FIRST}
    checkpoint.adapters.console.count <- Test::LARGE_CONSOLE_RECORD_CAPACITY
    for index in 0..<Test::LARGE_CONSOLE_RECORD_CAPACITY:
        checkpoint.adapters.console.records[index].sequence <- index.u64()
        checkpoint.adapters.console.records[index].channel <- DebuggerReplayAdapters::ConsoleChannel.Stdout
        checkpoint.adapters.console.records[index].kind <- DebuggerReplayAdapters::ConsoleRecordKind.Output
        checkpoint.adapters.console.records[index].requested <- Test::LARGE_CONSOLE_DATA_CAPACITY
        checkpoint.adapters.console.records[index].length <- Test::LARGE_CONSOLE_DATA_CAPACITY
        checkpoint.adapters.console.records[index].eof <- false

    DebuggerFullCheckpoint::full_checkpoint_seal_side_state(checkpoint)
    return checkpoint

def check_large_trace_capacity() -> i64:
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_large_checkpoint()
    return Test::LARGE_TASK_STATE_INVALID if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(checkpoint.tasks)
    return Test::LARGE_EFFECT_STATE_INVALID if not DebuggerEffects::effect_oracle_is_exact(checkpoint.effects)
    return Test::LARGE_RESOURCE_STATE_INVALID if not DebuggerVirtualResources::resources_is_valid(checkpoint.resources)
    return Test::LARGE_ADAPTER_STATE_INVALID if not DebuggerReplayAdapters::adapter_snapshot_is_valid(checkpoint.adapters)
    return Test::LARGE_CHECKPOINT_STATE_INVALID if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
    encoded: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    return Test::LARGE_TRACE_CAPACITY_FAILURE if encoded.failed or encoded.length <= Test::ORIGINAL_TRACE_BINARY_CAPACITY
    chunk: mutable DebuggerTraceStorage::CheckpointChunkEncoding = zeroed
    DebuggerTraceStorage::storage_checkpoint_chunk_new(chunk, checkpoint, Test::TRACE_SEQUENCE)
    return Test::LARGE_TRACE_CAPACITY_FAILURE if chunk.status != DebuggerTraceStorage::StorageStatus.Ready or not DebuggerTraceStorage::storage_checkpoint_chunk_is_valid(chunk.chunk)
    frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(chunk.chunk)
    return Test::LARGE_TRACE_CAPACITY_FAILURE if not DebuggerTraceBinary::writer_is_valid(frame)
    decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(frame.bytes[0], frame.length)
    return Test::LARGE_TRACE_CAPACITY_FAILURE if decoded.status != DebuggerTraceStorage::StorageStatus.Ready
    manifest_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(checkpoint_manifest_chunk(checkpoint))
    event_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(checkpoint_trace_event_chunk(checkpoint))
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(Test::TRACE_FOOTER_SEQUENCE, checkpoint.event)
    trace_bytes: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(trace_bytes)
    append_trace_bytes(trace_bytes, manifest_frame)
    append_trace_bytes(trace_bytes, frame)
    append_trace_bytes(trace_bytes, event_frame)
    append_trace_bytes(trace_bytes, footer)
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(trace_bytes.bytes[0], trace_bytes.length)
    return Test::LARGE_TRACE_CAPACITY_FAILURE if not DebuggerTraceBinary::writer_is_valid(trace_bytes) or scan.status != DebuggerTraceStorage::StorageStatus.Ready or not scan.footer_verified
    return 0

def append_trace_bytes(output: mutable DebuggerTraceBinary::ByteWriter&, source: DebuggerTraceBinary::ByteWriter&) -> void:
    DebuggerTraceBinary::writer_append_bytes(output, source)

def machine_snapshot_is_equal(left: DebuggerCheckpoint::MachineSnapshot, right: DebuggerCheckpoint::MachineSnapshot) -> bool:
    return false if left.id.value != right.id.value or left.event != right.event or left.state_hash != right.state_hash
    restored: DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(right)
    return DebuggerCheckpoint::snapshot_matches_machine(left, restored)

def task_info_is_equal(left: DebuggerConcurrency::TaskInfo, right: DebuggerConcurrency::TaskInfo) -> bool:
    return left.id.value == right.id.value and left.parent.value == right.parent.value and left.state == right.state and left.logical_time == right.logical_time and left.os_thread == right.os_thread

def adapter_error_is_equal(left: DebuggerErrors::DebuggerError, right: DebuggerErrors::DebuggerError) -> bool:
    return left.code == right.code and left.severity == right.severity and left.retryable == right.retryable and left.detail == right.detail

def adapter_sample_is_equal(left: DebuggerReplayAdapters::AdapterSample, right: DebuggerReplayAdapters::AdapterSample) -> bool:
    return left.sequence == right.sequence and left.source.value == right.source.value and left.invocation.value == right.invocation.value and left.value == right.value

def adapter_snapshot_is_equal(left: DebuggerReplayAdapters::AdapterSnapshot, right: DebuggerReplayAdapters::AdapterSnapshot) -> bool:
    return false if left.clock.count != right.clock.count or left.clock.cursor != right.clock.cursor or left.clock.mode != right.clock.mode or left.clock.exact != right.clock.exact or not adapter_error_is_equal(left.clock.last_error, right.clock.last_error)
    return false if left.random.count != right.random.count or left.random.cursor != right.random.cursor or left.random.mode != right.random.mode or left.random.exact != right.random.exact or not adapter_error_is_equal(left.random.last_error, right.random.last_error)
    return false if left.console.count != right.console.count or left.console.cursor != right.console.cursor or left.console.mode != right.console.mode or left.console.exact != right.console.exact or left.console.output_suppressed != right.console.output_suppressed or not adapter_error_is_equal(left.console.last_error, right.console.last_error)
    for index in 0..<left.clock.count:
        return false if not adapter_sample_is_equal(left.clock.samples[index], right.clock.samples[index])
    for index in 0..<left.random.count:
        return false if not adapter_sample_is_equal(left.random.samples[index], right.random.samples[index])
    for index in 0..<left.console.count:
        lrecord: DebuggerReplayAdapters::ConsoleRecord = left.console.records[index]
        rrecord: DebuggerReplayAdapters::ConsoleRecord = right.console.records[index]
        return false if lrecord.sequence != rrecord.sequence or lrecord.channel != rrecord.channel or lrecord.kind != rrecord.kind or lrecord.requested != rrecord.requested or lrecord.length != rrecord.length or lrecord.eof != rrecord.eof
        for byte_index in 0..<lrecord.length:
            return false if lrecord.bytes[byte_index] != rrecord.bytes[byte_index]
    return true

def checkpoints_are_equal(left: DebuggerFullCheckpoint::ManagedCheckpoint, right: DebuggerFullCheckpoint::ManagedCheckpoint) -> bool:
    return false if left.schema != right.schema or left.recording.value != right.recording.value or left.branch.value != right.branch.value or left.event != right.event or left.state_hash != right.state_hash or left.side_state_hash != right.side_state_hash or left.build.compiler.value != right.build.compiler.value or left.build.runtime.value != right.build.runtime.value or left.build.source.value != right.build.source.value or left.build.target.value != right.build.target.value or left.build.metadata_version != right.build.metadata_version or left.image_fingerprint != right.image_fingerprint or left.image_fingerprint_valid != right.image_fingerprint_valid
    return false if not machine_snapshot_is_equal(left.machine, right.machine)
    return false if left.tasks.task_count != right.tasks.task_count or left.tasks.next_id != right.tasks.next_id or left.tasks.status != right.tasks.status or left.tasks.current.value != right.tasks.current.value or left.tasks.wait_count != right.tasks.wait_count or left.tasks.scheduler_cursor != right.tasks.scheduler_cursor or left.tasks.scheduler_count != right.tasks.scheduler_count or left.tasks.scheduler_replaying != right.tasks.scheduler_replaying or left.tasks.scheduler_diverged != right.tasks.scheduler_diverged or left.tasks.scheduler_overflowed != right.tasks.scheduler_overflowed
    return false if left.tasks.task_count > Test::TASK_CAPACITY or left.tasks.wait_count > Test::WAIT_CAPACITY or left.tasks.scheduler_count > Test::SCHEDULE_CAPACITY
    for index in 0..<left.tasks.task_count:
        return false if not task_info_is_equal(left.tasks.tasks[index], right.tasks.tasks[index])
    for index in 0..<left.tasks.wait_count:
        return false if left.tasks.waits[index].waiter.value != right.tasks.waits[index].waiter.value or left.tasks.waits[index].owner.value != right.tasks.waits[index].owner.value or left.tasks.waits[index].resource.value != right.tasks.waits[index].resource.value or left.tasks.waits[index].kind != right.tasks.waits[index].kind
    for index in 0..<left.tasks.scheduler_count:
        ldecision: DebuggerScheduler::ScheduleDecision = left.tasks.scheduler_decisions[index]
        rdecision: DebuggerScheduler::ScheduleDecision = right.tasks.scheduler_decisions[index]
        return false if ldecision.ordinal != rdecision.ordinal or not task_info_is_equal(ldecision.task, rdecision.task) or ldecision.kind != rdecision.kind or ldecision.synchronization != rdecision.synchronization
    return false if left.effects.count != right.effects.count or left.effects.cursor != right.effects.cursor or left.effects.mode != right.effects.mode or left.effects.exactness != right.effects.exactness or left.effects.overflowed != right.effects.overflowed
    return false if left.effects.count > Test::EFFECT_CAPACITY
    return false if left.effects.last_error.code != right.effects.last_error.code or left.effects.last_error.severity != right.effects.last_error.severity or left.effects.last_error.retryable != right.effects.last_error.retryable or left.effects.last_error.detail != right.effects.last_error.detail
    for index in 0..<left.effects.count:
        lrecord: DebuggerEffects::EffectRecord = left.effects.records[index]
        rrecord: DebuggerEffects::EffectRecord = right.effects.records[index]
        return false if lrecord.sequence != rrecord.sequence or lrecord.kind != rrecord.kind or lrecord.call_site.value != rrecord.call_site.value or lrecord.invocation.value != rrecord.invocation.value or lrecord.request_hash != rrecord.request_hash or lrecord.result_hash != rrecord.result_hash or lrecord.result_value != rrecord.result_value or lrecord.suppress_external_write != rrecord.suppress_external_write
    return false if left.resources.count != right.resources.count or left.resources.next_handle != right.resources.next_handle or left.resources.mode != right.resources.mode or left.resources.count > Test::RESOURCE_CAPACITY
    return false if left.resources.operation_count != right.resources.operation_count or left.resources.operation_cursor != right.resources.operation_cursor or left.resources.operation_overflowed != right.resources.operation_overflowed or left.resources.operation_count > Test::RESOURCE_OPERATION_CAPACITY
    for index in 0..<left.resources.count:
        lfile: DebuggerVirtualResources::VirtualFile = left.resources.files[index]
        rfile: DebuggerVirtualResources::VirtualFile = right.resources.files[index]
        return false if lfile.handle.value != rfile.handle.value or lfile.path.value != rfile.path.value or lfile.length != rfile.length or lfile.cursor != rfile.cursor or lfile.initial_length != rfile.initial_length or lfile.writable != rfile.writable or lfile.generation != rfile.generation or lfile.mounted != rfile.mounted
        for byte_index in 0..<lfile.length:
            return false if lfile.bytes[byte_index] != rfile.bytes[byte_index]
        for byte_index in 0..<lfile.initial_length:
            return false if lfile.initial_bytes[byte_index] != rfile.initial_bytes[byte_index]
    for index in 0..<left.resources.operation_count:
        loperation: DebuggerVirtualResources::ResourceOperation = left.resources.operations[index]
        roperation: DebuggerVirtualResources::ResourceOperation = right.resources.operations[index]
        return false if loperation.sequence != roperation.sequence or loperation.kind != roperation.kind or loperation.handle.value != roperation.handle.value or loperation.path.value != roperation.path.value or loperation.generation != roperation.generation or loperation.writable != roperation.writable or loperation.offset != roperation.offset or loperation.requested != roperation.requested or loperation.transferred != roperation.transferred or loperation.eof != roperation.eof
        for byte_index in 0..<loperation.transferred:
            return false if loperation.bytes[byte_index] != roperation.bytes[byte_index]
    return adapter_snapshot_is_equal(left.adapters, right.adapters)

def resource_operations_replay_after_checkpoint(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> bool:
    resources: mutable DebuggerVirtualResources::ResourceStore = checkpoint.resources
    return false if resources.operation_count != Test::RESOURCE_OPERATION_COUNT
    return false if not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_replay_restart(resources))
    handle: DebuggerIdentity::DebugId = resources.files[Test::RESOURCE_FIRST_INDEX].handle
    output: mutable u8[Test::RESOURCE_READ_LENGTH] = zeroed
    read_result: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(resources, handle, output[Test::RESOURCE_FIRST_INDEX], Test::RESOURCE_READ_LENGTH)
    return false if not DebuggerErrors::error_is_ok(read_result.failure) or read_result.transferred != Test::RESOURCE_READ_LENGTH or output[Test::RESOURCE_FIRST_INDEX] != Test::RESOURCE_BYTE_0 or output[Test::RESOURCE_SECOND_INDEX] != Test::RESOURCE_BYTE_1
    input: mutable u8[Test::RESOURCE_WRITE_LENGTH] = [Test::RESOURCE_MUTATED_BYTE]
    write_result: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(resources, handle, input[Test::RESOURCE_FIRST_INDEX], Test::RESOURCE_WRITE_LENGTH)
    return false if not DebuggerErrors::error_is_ok(write_result.failure) or write_result.transferred != Test::RESOURCE_WRITE_LENGTH
    seek_result: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seek(resources, handle, Test::RESOURCE_CURSOR)
    return false if not DebuggerErrors::error_is_ok(seek_result)
    return DebuggerVirtualResources::resources_replay_complete(resources) and resources.files[Test::RESOURCE_FIRST_INDEX].bytes[Test::RESOURCE_THIRD_INDEX] == Test::RESOURCE_MUTATED_BYTE

def check_round_trip() -> i64:
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()
    return Test::TASK_ROUND_TRIP_FAILURE if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(checkpoint.tasks)
    portable_checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    portable_checkpoint.tasks.tasks[0].os_thread <- Test::REMAPPED_OS_THREAD
    portable_checkpoint.tasks.scheduler_decisions[0].task.os_thread <- Test::REMAPPED_OS_THREAD
    DebuggerFullCheckpoint::full_checkpoint_seal_side_state(portable_checkpoint)
    return Test::PORTABLE_TASK_CHECKPOINT_FAILURE if not DebuggerFullCheckpoint::full_checkpoint_is_valid(portable_checkpoint)
    return Test::EFFECT_ROUND_TRIP_FAILURE if not DebuggerEffects::effect_oracle_is_exact(checkpoint.effects) or checkpoint.effects.count != 2 or checkpoint.effects.records[0].kind.u16() != Test::EFFECT_KIND_CLOCK_CODE or checkpoint.effects.records[1].kind.u16() != Test::EFFECT_KIND_RANDOM_CODE or checkpoint.effects.records[1].result_value.u64() != Test::ADAPTER_RANDOM_SECOND
    return Test::RESOURCE_ROUND_TRIP_FAILURE if not DebuggerVirtualResources::resources_is_valid(checkpoint.resources)
    return Test::ADAPTER_RESTORE_FAILURE if not DebuggerReplayAdapters::adapter_snapshot_is_valid(checkpoint.adapters) or checkpoint.adapters.clock.cursor != Test::ADAPTER_CURSOR or checkpoint.adapters.random.cursor != Test::ADAPTER_CURSOR or checkpoint.adapters.console.cursor != Test::ADAPTER_CURSOR
    encoded: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    return Test::DECODE_ROUND_TRIP_FAILURE if encoded.failed or encoded.length <= 0 or encoded.length > DebuggerFullCheckpointCodecCapacity::FULL_CHECKPOINT_CODEC_CAPACITY
    encoded_standard_checksum: u64 = test_get_u64(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES)
    expected_standard_checksum: u64 = test_checksum_with_basis(encoded.bytes[0], encoded.length - Test::CODEC_CHECKSUM_BYTES, Test::FNV64_STANDARD_OFFSET_BASIS)
    return Test::STANDARD_CHECKSUM_FAILURE if encoded_standard_checksum != expected_standard_checksum
    decoded: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
    return Test::DECODE_ROUND_TRIP_FAILURE if decoded.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not DebuggerFullCheckpoint::full_checkpoint_is_valid(decoded.checkpoint)
    return Test::DECODE_ROUND_TRIP_FAILURE if not checkpoints_are_equal(checkpoint, decoded.checkpoint)
    return Test::RESOURCE_ROUND_TRIP_FAILURE if not resource_operations_replay_after_checkpoint(decoded.checkpoint)
    restored_effects: mutable DebuggerEffects::EffectOracle = decoded.checkpoint.effects
    restored_effects.mode <- DebuggerEffects::EffectMode.Replaying
    restored_clock: DebuggerEffects::EffectReplay = DebuggerEffects::effect_oracle_replay_result_in_invocation(restored_effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::EFFECT_CLOCK_CALL_SITE_ID), DebuggerIdentity::debug_id(Test::EFFECT_CLOCK_INVOCATION_ID), Test::EFFECT_REQUEST_HASH)
    restored_random: DebuggerEffects::RandomEffectReplay = DebuggerEffects::effect_oracle_replay_random_result_in_invocation(restored_effects, DebuggerIdentity::debug_id(Test::EFFECT_RANDOM_CALL_SITE_ID), DebuggerIdentity::debug_id(Test::EFFECT_RANDOM_INVOCATION_ID), Test::EFFECT_REQUEST_HASH + Test::SECOND_EFFECT_OFFSET)
    return Test::EFFECT_ROUND_TRIP_FAILURE if not restored_clock.accepted or restored_clock.result_value != Test::EFFECT_RESULT_VALUE or not restored_random.accepted or restored_random.value != Test::ADAPTER_RANDOM_SECOND or not DebuggerEffects::effect_oracle_replay_complete(restored_effects)
    restored_adapters: mutable DebuggerReplayAdapters::AdapterSnapshot = zeroed
    return Test::ADAPTER_RESTORE_FAILURE if not DebuggerErrors::error_is_ok(DebuggerFullCheckpoint::full_checkpoint_restore_adapters(restored_adapters, decoded.checkpoint)) or not adapter_snapshot_is_equal(checkpoint.adapters, restored_adapters)
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ADAPTER_SOURCE_ID)
    invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ADAPTER_INVOCATION_ID)
    next_clock: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read_in_invocation(restored_adapters.clock, source, invocation)
    next_random: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read_in_invocation(restored_adapters.random, source, invocation)
    output: mutable u8[Test::ADAPTER_OUTPUT_LENGTH] = [Test::ADAPTER_OUTPUT_BYTE]
    next_console_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(restored_adapters.console, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[0], Test::ADAPTER_OUTPUT_LENGTH)
    return Test::ADAPTER_RESTORE_FAILURE if not next_clock.accepted or next_clock.value != Test::ADAPTER_CLOCK_SECOND or not next_random.accepted or next_random.value != Test::ADAPTER_RANDOM_SECOND or not next_console_write.accepted or not next_console_write.suppressed or not DebuggerReplayAdapters::console_replay_complete(restored_adapters.console)
    branch_console: mutable DebuggerReplayAdapters::Console = zeroed
    DebuggerReplayAdapters::console_initialize(branch_console, DebuggerReplayAdapters::AdapterMode.Branch)
    branch_console.output_suppressed <- false
    branch_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(branch_console, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[0], Test::ADAPTER_OUTPUT_LENGTH)
    return Test::BRANCH_WRITE_NOT_SUPPRESSED if not branch_write.accepted or not branch_write.suppressed
    managed_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(managed_state)
    return Test::ADAPTER_RESTORE_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedState::state_restore(managed_state, decoded.checkpoint)) or not adapter_snapshot_is_equal(managed_state.adapters, checkpoint.adapters)
    restored_machine: DebuggerEDIR::Machine = DebuggerFullCheckpoint::full_checkpoint_restore_machine(decoded.checkpoint)
    recaptured: DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerManagedState::state_capture(managed_state, restored_machine, decoded.checkpoint.build, DebuggerEDIRCodec::ArtifactFingerprint{value: decoded.checkpoint.image_fingerprint, valid: decoded.checkpoint.image_fingerprint_valid}, decoded.checkpoint.recording, decoded.checkpoint.branch, decoded.checkpoint.event, decoded.checkpoint.state_hash)
    return Test::ADAPTER_RESTORE_FAILURE if not checkpoints_are_equal(checkpoint, recaptured)
    legacy_checkpoint: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = encoded
    legacy_inner_checksum: u64 = test_legacy_checksum(legacy_checkpoint.bytes[0], legacy_checkpoint.length - Test::CODEC_CHECKSUM_BYTES)
    test_put_u64(legacy_checkpoint.bytes[0], legacy_checkpoint.length - Test::CODEC_CHECKSUM_BYTES, legacy_inner_checksum)
    legacy_checkpoint_decoded: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(legacy_checkpoint.bytes[0], legacy_checkpoint.length)
    return Test::LEGACY_CHECKPOINT_FAILURE if legacy_checkpoint_decoded.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not checkpoints_are_equal(checkpoint, legacy_checkpoint_decoded.checkpoint)
    trace_chunk: mutable DebuggerTraceStorage::CheckpointChunkEncoding = zeroed
    DebuggerTraceStorage::storage_checkpoint_chunk_new(trace_chunk, checkpoint, Test::TRACE_SEQUENCE)
    return Test::TRACE_CHUNK_CREATE_FAILURE if trace_chunk.status != DebuggerTraceStorage::StorageStatus.Ready
    return 15 if not DebuggerTraceStorage::storage_checkpoint_chunk_is_valid(trace_chunk.chunk)
    trace_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(trace_chunk.chunk)
    return Test::TRACE_FRAME_ENCODE_FAILURE if not DebuggerTraceBinary::writer_is_valid(trace_frame)
    decoded_frame: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(trace_frame.bytes[0], trace_frame.length)
    return Test::TRACE_FRAME_DECODE_FAILURE if decoded_frame.status != DebuggerTraceStorage::StorageStatus.Ready or decoded_frame.chunk.header.sequence != Test::TRACE_SEQUENCE
    restored_checkpoint: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerTraceStorage::storage_checkpoint_chunk_decode(decoded_frame.chunk)
    return Test::TRACE_CHECKPOINT_RESTORE_FAILURE if restored_checkpoint.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not checkpoints_are_equal(checkpoint, restored_checkpoint.checkpoint)
    reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceReader::reader_new() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    return Test::TRACE_READER_INGEST_FAILURE if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, checkpoint_manifest_chunk(checkpoint)))
    return Test::TRACE_READER_INGEST_FAILURE if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest_encoded(reader, trace_frame.bytes[0], trace_frame.length))
    lookup: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_full_checkpoint_at(reader, 0)
    return Test::TRACE_READER_RESTORE_FAILURE if not lookup.found or DebuggerTraceReader::reader_full_checkpoint_count(reader) != 1 or not checkpoints_are_equal(checkpoint, lookup.checkpoint)
    manifest_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(checkpoint_manifest_chunk(checkpoint))
    event_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(checkpoint_trace_event_chunk(checkpoint))
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(Test::TRACE_FOOTER_SEQUENCE, checkpoint.event)
    trace_bytes: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(trace_bytes)
    append_trace_bytes(trace_bytes, manifest_frame)
    append_trace_bytes(trace_bytes, trace_frame)
    append_trace_bytes(trace_bytes, event_frame)
    append_trace_bytes(trace_bytes, footer)
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(trace_bytes.bytes[0], trace_bytes.length)
    return Test::TRACE_SCAN_FAILURE if not DebuggerTraceBinary::writer_is_valid(trace_bytes) or scan.status != DebuggerTraceStorage::StorageStatus.Ready or not scan.footer_verified or scan.verified_chunks != Test::TRACE_CHUNK_COUNT
    legacy_trace: mutable DebuggerTraceBinary::ByteWriter = trace_bytes
    checkpoint_frame_offset: usize = manifest_frame.length
    event_frame_offset: usize = manifest_frame.length + trace_frame.length
    legacy_inner_trace_checksum: u64 = test_legacy_checksum(legacy_trace.bytes[checkpoint_frame_offset + Test::TRACE_HEADER_BYTES], encoded.length - Test::CODEC_CHECKSUM_BYTES)
    test_put_u64(legacy_trace.bytes[0], checkpoint_frame_offset + Test::TRACE_HEADER_BYTES + encoded.length - Test::CODEC_CHECKSUM_BYTES, legacy_inner_trace_checksum)
    test_rewrite_frame_checksum_legacy(legacy_trace.bytes[0], 0, manifest_frame.length - Test::TRACE_HEADER_BYTES)
    test_rewrite_frame_checksum_legacy(legacy_trace.bytes[0], checkpoint_frame_offset, trace_frame.length - Test::TRACE_HEADER_BYTES)
    test_rewrite_frame_checksum_legacy(legacy_trace.bytes[0], event_frame_offset, event_frame.length - Test::TRACE_HEADER_BYTES)
    legacy_scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(legacy_trace.bytes[0], legacy_trace.length)
    return Test::LEGACY_TRACE_SCAN_FAILURE if legacy_scan.status != DebuggerTraceStorage::StorageStatus.Ready or not legacy_scan.footer_verified or legacy_scan.verified_chunks != Test::TRACE_CHUNK_COUNT
    return 0

def check_rejects_malformed_inputs() -> i64:
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()
    encoded: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    truncated: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length - Test::TRUNCATION)
    return Test::TRUNCATED_INPUT_ACCEPTED if truncated.status != DebuggerFullCheckpointCodec::DecodeStatus.Truncated
    bad_header: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = encoded
    bad_header.bytes[0] <- 0
    invalid_header: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(bad_header.bytes[0], bad_header.length)
    return Test::INVALID_HEADER_ACCEPTED if invalid_header.status != DebuggerFullCheckpointCodec::DecodeStatus.Invalid
    legacy_schema: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = encoded
    legacy_schema.bytes[Test::CODEC_SCHEMA_OFFSET] <- Test::LEGACY_FULL_CHECKPOINT_CODEC_SCHEMA.u8()
    rejected_legacy_schema: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(legacy_schema.bytes[0], legacy_schema.length)
    return Test::LEGACY_CHECKPOINT_SCHEMA_ACCEPTED if rejected_legacy_schema.status != DebuggerFullCheckpointCodec::DecodeStatus.Invalid
    bad_checksum: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = encoded
    bad_checksum.bytes[bad_checksum.length - 1] <- bad_checksum.bytes[bad_checksum.length - 1] + 1
    invalid_checksum: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(bad_checksum.bytes[0], bad_checksum.length)
    return Test::INVALID_CHECKSUM_ACCEPTED if invalid_checksum.status != DebuggerFullCheckpointCodec::DecodeStatus.Invalid
    oversized: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], DebuggerFullCheckpointCodecCapacity::FULL_CHECKPOINT_CODEC_CAPACITY + Test::CODEC_CAPACITY_OFFSET)
    return Test::OVERSIZED_INPUT_ACCEPTED if oversized.status != DebuggerFullCheckpointCodec::DecodeStatus.Oversized
    malformed: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    malformed.branch <- DebuggerIdentity::debug_id(18446744073709551615)
    rejected: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(malformed)
    return Test::INVALID_ENCODE_ACCEPTED if not rejected.failed or rejected.length != 0
    tampered_adapters: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    tampered_adapters.adapters.clock.cursor <- tampered_adapters.adapters.clock.cursor + 1
    return Test::ADAPTER_TAMPER_ACCEPTED if DebuggerFullCheckpoint::full_checkpoint_is_valid(tampered_adapters)
    tampered_replay_suppression: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    tampered_replay_suppression.adapters.console.output_suppressed <- false
    return Test::REPLAY_WRITE_UNSUPPRESSED_ACCEPTED if DebuggerFullCheckpoint::full_checkpoint_is_valid(tampered_replay_suppression)
    tampered_build: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    tampered_build.build.compiler <- DebuggerIdentity::debug_id(Test::COMPILER_ID + Test::BUILD_ID_TAMPER_DELTA)
    return Test::CHECKPOINT_BUILD_TAMPER_ACCEPTED if DebuggerFullCheckpoint::full_checkpoint_is_valid(tampered_build)
    tampered_image: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    tampered_image.image_fingerprint <- Test::IMAGE_FINGERPRINT + Test::BUILD_ID_TAMPER_DELTA
    return Test::CHECKPOINT_IMAGE_TAMPER_ACCEPTED if DebuggerFullCheckpoint::full_checkpoint_is_valid(tampered_image)
    invalid_fingerprint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    invalid_fingerprint.image_fingerprint_valid <- false
    DebuggerFullCheckpoint::full_checkpoint_seal_side_state(invalid_fingerprint)
    return Test::CHECKPOINT_INVALID_FINGERPRINT_ACCEPTED if DebuggerFullCheckpoint::full_checkpoint_is_valid(invalid_fingerprint)
    invalid_build: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    invalid_build.build.compiler <- DebuggerIdentity::debug_id(Test::NO_BUILD_COMPONENT_ID)
    DebuggerFullCheckpoint::full_checkpoint_seal_side_state(invalid_build)
    return Test::CHECKPOINT_INVALID_BUILD_ACCEPTED if DebuggerFullCheckpoint::full_checkpoint_is_valid(invalid_build)
    rejected_trace_chunk: mutable DebuggerTraceStorage::CheckpointChunkEncoding = zeroed
    DebuggerTraceStorage::storage_checkpoint_chunk_new(rejected_trace_chunk, malformed, Test::TRACE_SEQUENCE)
    return Test::TRACE_INVALID_CHECKPOINT_ACCEPTED if rejected_trace_chunk.status != DebuggerTraceStorage::StorageStatus.Invalid
    return 0

def main() -> i64:
    lifecycle_codec_status: i64 = check_lifecycle_codec_versions()
    return lifecycle_codec_status if lifecycle_codec_status != 0
    scalar_codec_status: i64 = check_scalar_file_codec_versions()
    return scalar_codec_status if scalar_codec_status != 0
    resource_snapshot_status: i64 = check_resource_snapshot_isolation()
    return resource_snapshot_status if resource_snapshot_status != Test::TEST_SUCCESS
    empty_recording_adapter_status: i64 = check_empty_recording_adapter_checkpoint()
    return empty_recording_adapter_status if empty_recording_adapter_status != Test::TEST_SUCCESS
    fingerprint: i64 = check_artifact_fingerprint()
    return fingerprint if fingerprint != 0
    round_trip: i64 = check_round_trip()
    return round_trip if round_trip != 0
    large_capacity: i64 = check_large_trace_capacity()
    return large_capacity if large_capacity != 0
    return check_rejects_malformed_inputs()
