const TEST_LARGE_CONSOLE_RECORD_CAPACITY: usize = 64
const TEST_LARGE_CONSOLE_DATA_CAPACITY: usize = 256

def test_checksum_with_basis(bytes: u8&, length: usize, basis: u64) -> u64:
    checksum: mutable u64 = basis
    for index in 0..<length:
        checksum <- (checksum ^ bytes[index].u64()) * TEST_HASH_PRIME
    return checksum

def test_legacy_checksum(bytes: u8&, length: usize) -> u64:
    return test_checksum_with_basis(bytes, length, TEST_FNV64_LEGACY_OFFSET_BASIS)

def test_put_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
    for index in 0..<8:
        bytes[offset + index] <- (value >> (index.u64() * TEST_HASH_BYTE_BITS)).u8()

def test_get_u64(bytes: u8&, offset: usize) -> u64:
    value: mutable u64 = 0
    for index in 0..<8:
        value <- value | (bytes[offset + index].u64() << (index.u64() * TEST_HASH_BYTE_BITS))
    return value

def test_rewrite_frame_checksum_legacy(bytes: mutable u8&, frame_offset: usize, payload_length: usize) -> void:
    checksum: u64 = test_legacy_checksum(bytes[frame_offset + TEST_TRACE_HEADER_BYTES], payload_length)
    test_put_u64(bytes, frame_offset + TEST_TRACE_CHECKSUM_OFFSET, checksum)

def make_checkpoint() -> DebuggerFullCheckpoint::ManagedCheckpoint:
    machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    machine.program_counter <- TEST_MACHINE_PC
    machine.accumulator <- TEST_MACHINE_ACCUMULATOR
    machine.result <- TEST_MACHINE_RESULT
    machine.locals[TEST_LOCAL_INDEX] <- TEST_MACHINE_LOCAL_VALUE
    machine.locals_initialized[TEST_LOCAL_INDEX] <- true
    machine.return_stack_pointer <- TEST_MACHINE_STACK_POINTER
    machine.return_stack[TEST_LOCAL_INDEX] <- TEST_MACHINE_RETURN_PC
    machine.frame_locals[TEST_FRAME_LOCAL_INDEX] <- TEST_MACHINE_FRAME_VALUE
    machine.frame_locals_initialized[TEST_FRAME_LOCAL_INDEX] <- true
    machine.heap_next <- TEST_MACHINE_HEAP_NEXT
    machine.memory[TEST_MEMORY_INDEX] <- TEST_MACHINE_MEMORY_VALUE
    machine.memory_initialized[TEST_MEMORY_INDEX] <- true
    machine.steps <- TEST_CHECKPOINT_EVENT

    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    first_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(NO_PARENT_TASK))
    second_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(NO_PARENT_TASK))
    _ = DebuggerConcurrencyRuntime::runtime_wait(runtime, first_task, second_task, DebuggerIdentity::debug_id(TEST_WAIT_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex)
    _ = DebuggerConcurrencyRuntime::runtime_schedule(runtime, second_task, DebuggerScheduler::ScheduleKind.Run, DebuggerIdentity::debug_id(NO_SYNC_RESOURCE))
    tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)

    effects: mutable DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Recording)
    effects <- DebuggerEffects::effect_oracle_record(effects, DebuggerEffects::EffectKind.Clock, TEST_EFFECT_REQUEST_HASH, TEST_EFFECT_RESULT_HASH, TEST_EFFECT_RESULT_VALUE)
    effects <- DebuggerEffects::effect_oracle_record(effects, DebuggerEffects::EffectKind.Clock, TEST_EFFECT_REQUEST_HASH + 1, TEST_EFFECT_RESULT_HASH + 1, TEST_EFFECT_RESULT_VALUE + 1)

    resources: mutable DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_new(DebuggerVirtualResources::ResourceMode.Recording)
    handle: DebuggerIdentity::DebugId = DebuggerVirtualResources::resources_open(resources, DebuggerIdentity::debug_id(TEST_RESOURCE_PATH_ID), true, TEST_RESOURCE_GENERATION)
    data: mutable u8[TEST_RESOURCE_BYTES] = zeroed
    data[0] <- TEST_RESOURCE_BYTE_0
    data[1] <- TEST_RESOURCE_BYTE_1
    data[2] <- TEST_RESOURCE_BYTE_2
    data[3] <- TEST_RESOURCE_BYTE_3
    data[4] <- TEST_RESOURCE_BYTE_4
    _ = DebuggerVirtualResources::resources_seed(resources, handle, data[0], TEST_RESOURCE_BYTES)
    _ = DebuggerVirtualResources::resources_seek(resources, handle, TEST_RESOURCE_CURSOR)

    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(TEST_ADAPTER_SOURCE_ID)
    clock: mutable DebuggerReplayAdapters::Clock = DebuggerReplayAdapters::clock_new(DebuggerReplayAdapters::AdapterMode.Recording)
    _ = DebuggerReplayAdapters::clock_record(clock, source, TEST_ADAPTER_CLOCK_FIRST)
    _ = DebuggerReplayAdapters::clock_record(clock, source, TEST_ADAPTER_CLOCK_SECOND)
    clock.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    first_clock_read: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(clock, source)
    if not first_clock_read.accepted:
        clock.exact <- false

    random: mutable DebuggerReplayAdapters::Random = DebuggerReplayAdapters::random_new(DebuggerReplayAdapters::AdapterMode.Recording)
    _ = DebuggerReplayAdapters::random_record(random, source, TEST_ADAPTER_RANDOM_FIRST)
    _ = DebuggerReplayAdapters::random_record(random, source, TEST_ADAPTER_RANDOM_SECOND)
    random.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    first_random_read: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read(random, source)
    if not first_random_read.accepted:
        random.exact <- false

    input: mutable u8[TEST_ADAPTER_INPUT_LENGTH] = [TEST_ADAPTER_INPUT_BYTE]
    output: mutable u8[TEST_ADAPTER_OUTPUT_LENGTH] = [TEST_ADAPTER_OUTPUT_BYTE]
    console: mutable DebuggerReplayAdapters::Console = DebuggerReplayAdapters::console_new(DebuggerReplayAdapters::AdapterMode.Recording)
    _ = DebuggerReplayAdapters::console_record_input(console, DebuggerReplayAdapters::ConsoleChannel.Stdout, input[0], TEST_ADAPTER_INPUT_LENGTH)
    recorded_output: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(console, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[0], TEST_ADAPTER_OUTPUT_LENGTH)
    if not recorded_output.accepted:
        console.exact <- false
    console.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    console.output_suppressed <- true
    replay_input: mutable u8[TEST_ADAPTER_INPUT_LENGTH] = zeroed
    first_input_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(console, DebuggerReplayAdapters::ConsoleChannel.Stdout, replay_input[0], TEST_ADAPTER_INPUT_LENGTH)
    if not first_input_read.accepted:
        console.exact <- false
    adapters: DebuggerReplayAdapters::AdapterSnapshot = DebuggerReplayAdapters::AdapterSnapshot{clock: clock, random: random, console: console}

    machine_probe: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(machine, DebuggerIdentity::debug_id(TEST_CHECKPOINT_EVENT + 1), TEST_CHECKPOINT_EVENT, 0)
    state_hash: u64 = DebuggerCheckpoint::snapshot_state_hash(machine_probe)
    return DebuggerFullCheckpoint::full_checkpoint_capture_with_adapters(machine, tasks, effects, resources, adapters, DebuggerIdentity::debug_id(TEST_RECORDING_ID), DebuggerIdentity::debug_id(TEST_BRANCH_ID), TEST_CHECKPOINT_EVENT, state_hash)

def checkpoint_manifest_chunk(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> DebuggerTraceStorage::StoredChunk:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(TEST_COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(TEST_RUNTIME_ID),
        source: DebuggerIdentity::debug_id(TEST_SOURCE_ID),
        target: DebuggerIdentity::debug_id(TEST_TARGET_ID),
        metadata_version: TEST_METADATA_VERSION
    }
    manifest: mutable DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
    manifest.first_event <- checkpoint.event
    manifest.last_event <- checkpoint.event
    manifest.checkpoint_count <- TEST_TRACE_CHECKPOINT_COUNT
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    checksum: u64 = DebuggerTraceBinary::writer_checksum(payload)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: manifest.schema.u32(), kind: DebuggerTrace::ChunkKind.Manifest, sequence: TEST_TRACE_MANIFEST_SEQUENCE, first_event: checkpoint.event, last_event: checkpoint.event, payload_length: payload.length.u64(), checksum: checksum}
    chunk.payload_length <- payload.length
    chunk.checksum <- checksum
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def checkpoint_trace_event_chunk(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> DebuggerTraceStorage::StoredChunk:
    position: mutable DebuggerIdentity::Position = DebuggerIdentity::initial_position(checkpoint.recording)
    position.branch <- checkpoint.branch
    position.event <- checkpoint.event
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(TEST_TRACE_SCHEMA, checkpoint.event, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, TEST_TRACE_EVENT_HASH)
    payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    payload <- DebuggerTraceBinary::writer_put_u32(payload, event.schema)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.ordinal)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.task.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.recording.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.branch.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.event)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.task.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.invocation.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.statement.value)
    payload <- DebuggerTraceBinary::writer_put_u32(payload, event.position.microstep)
    payload <- DebuggerTraceBinary::writer_put_u16(payload, event.kind.u16())
    payload <- DebuggerTraceBinary::writer_put_u16(payload, event.quality.u16())
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.payload_hash)
    checksum: u64 = DebuggerTraceBinary::writer_checksum(payload)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: TEST_TRACE_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: TEST_TRACE_EVENT_SEQUENCE, first_event: checkpoint.event, last_event: checkpoint.event, payload_length: payload.length.u64(), checksum: checksum}
    chunk.payload_length <- payload.length
    chunk.checksum <- checksum
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def make_large_checkpoint() -> DebuggerFullCheckpoint::ManagedCheckpoint:
    checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()

    task: mutable DebuggerConcurrency::TaskInfo = DebuggerConcurrency::TaskInfo{id: DebuggerIdentity::debug_id(TEST_LARGE_CHECKPOINT_TASK_ID), parent: DebuggerIdentity::debug_id(NO_PARENT_TASK), state: DebuggerConcurrency::TaskState.Running, logical_time: TEST_LARGE_CHECKPOINT_TASK_LOGICAL_TIME, os_thread: TEST_LARGE_CHECKPOINT_OS_THREAD}
    checkpoint.tasks.task_count <- TEST_LARGE_CHECKPOINT_TASK_COUNT
    checkpoint.tasks.next_id <- TEST_LARGE_CHECKPOINT_NEXT_TASK_ID
    checkpoint.tasks.tasks[0] <- task
    checkpoint.tasks.status <- DebuggerConcurrencyRuntime::RuntimeStatus.Running
    checkpoint.tasks.current <- task.id
    checkpoint.tasks.wait_count <- TEST_LARGE_CHECKPOINT_WAIT_COUNT
    checkpoint.tasks.scheduler_cursor <- TEST_LARGE_CHECKPOINT_SCHEDULER_CURSOR
    checkpoint.tasks.scheduler_count <- TEST_SCHEDULE_CAPACITY
    checkpoint.tasks.scheduler_replaying <- false
    checkpoint.tasks.scheduler_diverged <- false
    checkpoint.tasks.scheduler_overflowed <- false
    for index in 0..<TEST_SCHEDULE_CAPACITY:
        checkpoint.tasks.scheduler_decisions[index] <- DebuggerScheduler::ScheduleDecision{ordinal: index.u64(), task: task, kind: DebuggerScheduler::ScheduleKind.Run, synchronization: NO_SYNC_RESOURCE}

    checkpoint.effects.count <- TEST_EFFECT_CAPACITY
    checkpoint.effects.cursor <- TEST_LARGE_CHECKPOINT_EFFECT_CURSOR
    for index in 0..<TEST_EFFECT_CAPACITY:
        checkpoint.effects.records[index] <- DebuggerEffects::EffectRecord{sequence: index.u64(), kind: DebuggerEffects::EffectKind.Clock, request_hash: TEST_EFFECT_REQUEST_HASH, result_hash: TEST_EFFECT_RESULT_HASH, result_value: TEST_EFFECT_RESULT_VALUE, suppress_external_write: false}

    checkpoint.resources.count <- TEST_RESOURCE_CAPACITY
    checkpoint.resources.next_handle <- TEST_LARGE_CHECKPOINT_NEXT_HANDLE
    for index in 0..<TEST_RESOURCE_CAPACITY:
        checkpoint.resources.files[index].handle <- DebuggerIdentity::debug_id(TEST_LARGE_CHECKPOINT_FIRST_HANDLE + index.u64())
        checkpoint.resources.files[index].path <- DebuggerIdentity::debug_id(TEST_RESOURCE_PATH_ID + index.u64())
        checkpoint.resources.files[index].length <- TEST_LARGE_CHECKPOINT_FILE_LENGTH
        checkpoint.resources.files[index].cursor <- TEST_LARGE_CHECKPOINT_FILE_CURSOR
        checkpoint.resources.files[index].writable <- true
        checkpoint.resources.files[index].generation <- TEST_RESOURCE_GENERATION

    checkpoint.adapters.clock.count <- TEST_LARGE_ADAPTER_SAMPLE_CAPACITY
    for index in 0..<TEST_LARGE_ADAPTER_SAMPLE_CAPACITY:
        checkpoint.adapters.clock.samples[index] <- DebuggerReplayAdapters::AdapterSample{sequence: index.u64(), source: DebuggerIdentity::debug_id(TEST_ADAPTER_SOURCE_ID), value: TEST_ADAPTER_CLOCK_FIRST}
    checkpoint.adapters.random.count <- TEST_LARGE_ADAPTER_SAMPLE_CAPACITY
    for index in 0..<TEST_LARGE_ADAPTER_SAMPLE_CAPACITY:
        checkpoint.adapters.random.samples[index] <- DebuggerReplayAdapters::AdapterSample{sequence: index.u64(), source: DebuggerIdentity::debug_id(TEST_ADAPTER_SOURCE_ID), value: TEST_ADAPTER_RANDOM_FIRST}
    checkpoint.adapters.console.count <- TEST_LARGE_CONSOLE_RECORD_CAPACITY
    for index in 0..<TEST_LARGE_CONSOLE_RECORD_CAPACITY:
        checkpoint.adapters.console.records[index].sequence <- index.u64()
        checkpoint.adapters.console.records[index].channel <- DebuggerReplayAdapters::ConsoleChannel.Stdout
        checkpoint.adapters.console.records[index].kind <- DebuggerReplayAdapters::ConsoleRecordKind.Output
        checkpoint.adapters.console.records[index].requested <- TEST_LARGE_CONSOLE_DATA_CAPACITY
        checkpoint.adapters.console.records[index].length <- TEST_LARGE_CONSOLE_DATA_CAPACITY
        checkpoint.adapters.console.records[index].eof <- false

    DebuggerFullCheckpoint::full_checkpoint_seal_side_state(checkpoint)
    return checkpoint

def check_large_trace_capacity() -> i64:
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_large_checkpoint()
    return TEST_LARGE_TRACE_CAPACITY_FAILURE if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
    encoded: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    return TEST_LARGE_TRACE_CAPACITY_FAILURE if encoded.failed or encoded.length <= TEST_ORIGINAL_TRACE_BINARY_CAPACITY
    chunk: DebuggerTraceStorage::CheckpointChunkEncoding = DebuggerTraceStorage::storage_checkpoint_chunk_new(checkpoint, TEST_TRACE_SEQUENCE)
    return TEST_LARGE_TRACE_CAPACITY_FAILURE if chunk.status != DebuggerTraceStorage::StorageStatus.Ready or not DebuggerTraceStorage::storage_checkpoint_chunk_is_valid(chunk.chunk)
    frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(chunk.chunk)
    return TEST_LARGE_TRACE_CAPACITY_FAILURE if not DebuggerTraceBinary::writer_is_valid(frame)
    decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(frame.bytes[0], frame.length)
    return TEST_LARGE_TRACE_CAPACITY_FAILURE if decoded.status != DebuggerTraceStorage::StorageStatus.Ready
    manifest_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(checkpoint_manifest_chunk(checkpoint))
    event_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(checkpoint_trace_event_chunk(checkpoint))
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(TEST_TRACE_FOOTER_SEQUENCE, checkpoint.event)
    trace_bytes: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    append_trace_bytes(trace_bytes, manifest_frame)
    append_trace_bytes(trace_bytes, frame)
    append_trace_bytes(trace_bytes, event_frame)
    append_trace_bytes(trace_bytes, footer)
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(trace_bytes.bytes[0], trace_bytes.length)
    return TEST_LARGE_TRACE_CAPACITY_FAILURE if not DebuggerTraceBinary::writer_is_valid(trace_bytes) or scan.status != DebuggerTraceStorage::StorageStatus.Ready or not scan.footer_verified
    return 0

def append_trace_bytes(output: mutable DebuggerTraceBinary::ByteWriter&, source: DebuggerTraceBinary::ByteWriter) -> void:
    if not DebuggerTraceBinary::writer_is_valid(source):
        output.failed <- true
        return
    for index in 0..<source.length:
        output <- DebuggerTraceBinary::writer_put_byte(output, source.bytes[index])

def machine_snapshot_is_equal(left: DebuggerCheckpoint::MachineSnapshot, right: DebuggerCheckpoint::MachineSnapshot) -> bool:
    return false if left.id.value != right.id.value or left.event != right.event or left.state_hash != right.state_hash
    restored: DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(right)
    return DebuggerCheckpoint::snapshot_matches_machine(left, restored)

def task_info_is_equal(left: DebuggerConcurrency::TaskInfo, right: DebuggerConcurrency::TaskInfo) -> bool:
    return left.id.value == right.id.value and left.parent.value == right.parent.value and left.state == right.state and left.logical_time == right.logical_time and left.os_thread == right.os_thread

def adapter_error_is_equal(left: DebuggerErrors::DebuggerError, right: DebuggerErrors::DebuggerError) -> bool:
    return left.code == right.code and left.severity == right.severity and left.retryable == right.retryable and left.detail == right.detail

def adapter_sample_is_equal(left: DebuggerReplayAdapters::AdapterSample, right: DebuggerReplayAdapters::AdapterSample) -> bool:
    return left.sequence == right.sequence and left.source.value == right.source.value and left.value == right.value

def adapter_snapshot_is_equal(left: DebuggerReplayAdapters::AdapterSnapshot, right: DebuggerReplayAdapters::AdapterSnapshot) -> bool:
    return false if left.clock.count != right.clock.count or left.clock.cursor != right.clock.cursor or left.clock.mode != right.clock.mode or left.clock.exact != right.clock.exact or not adapter_error_is_equal(left.clock.last_error, right.clock.last_error)
    return false if left.random.count != right.random.count or left.random.cursor != right.random.cursor or left.random.mode != right.random.mode or left.random.exact != right.random.exact or not adapter_error_is_equal(left.random.last_error, right.random.last_error)
    return false if left.console.count != right.console.count or left.console.cursor != right.console.cursor or left.console.mode != right.console.mode or left.console.exact != right.console.exact or left.console.output_suppressed != right.console.output_suppressed or not adapter_error_is_equal(left.console.last_error, right.console.last_error)
    for index in 0..<left.clock.count:
        return false if not adapter_sample_is_equal(left.clock.samples[index], right.clock.samples[index])
    for index in 0..<left.random.count:
        return false if not adapter_sample_is_equal(left.random.samples[index], right.random.samples[index])
    for index in 0..<left.console.count:
        lrecord: DebuggerReplayAdapters::ConsoleRecord = left.console.records[index]
        rrecord: DebuggerReplayAdapters::ConsoleRecord = right.console.records[index]
        return false if lrecord.sequence != rrecord.sequence or lrecord.channel != rrecord.channel or lrecord.kind != rrecord.kind or lrecord.requested != rrecord.requested or lrecord.length != rrecord.length or lrecord.eof != rrecord.eof
        for byte_index in 0..<lrecord.length:
            return false if lrecord.bytes[byte_index] != rrecord.bytes[byte_index]
    return true

def checkpoints_are_equal(left: DebuggerFullCheckpoint::ManagedCheckpoint, right: DebuggerFullCheckpoint::ManagedCheckpoint) -> bool:
    return false if left.schema != right.schema or left.recording.value != right.recording.value or left.branch.value != right.branch.value or left.event != right.event or left.state_hash != right.state_hash or left.side_state_hash != right.side_state_hash
    return false if not machine_snapshot_is_equal(left.machine, right.machine)
    return false if left.tasks.task_count != right.tasks.task_count or left.tasks.next_id != right.tasks.next_id or left.tasks.status != right.tasks.status or left.tasks.current.value != right.tasks.current.value or left.tasks.wait_count != right.tasks.wait_count or left.tasks.scheduler_cursor != right.tasks.scheduler_cursor or left.tasks.scheduler_count != right.tasks.scheduler_count or left.tasks.scheduler_replaying != right.tasks.scheduler_replaying or left.tasks.scheduler_diverged != right.tasks.scheduler_diverged or left.tasks.scheduler_overflowed != right.tasks.scheduler_overflowed
    return false if left.tasks.task_count > TEST_TASK_CAPACITY or left.tasks.wait_count > TEST_WAIT_CAPACITY or left.tasks.scheduler_count > TEST_SCHEDULE_CAPACITY
    for index in 0..<left.tasks.task_count:
        return false if not task_info_is_equal(left.tasks.tasks[index], right.tasks.tasks[index])
    for index in 0..<left.tasks.wait_count:
        return false if left.tasks.waits[index].waiter.value != right.tasks.waits[index].waiter.value or left.tasks.waits[index].owner.value != right.tasks.waits[index].owner.value or left.tasks.waits[index].resource.value != right.tasks.waits[index].resource.value or left.tasks.waits[index].kind != right.tasks.waits[index].kind
    for index in 0..<left.tasks.scheduler_count:
        ldecision: DebuggerScheduler::ScheduleDecision = left.tasks.scheduler_decisions[index]
        rdecision: DebuggerScheduler::ScheduleDecision = right.tasks.scheduler_decisions[index]
        return false if ldecision.ordinal != rdecision.ordinal or not task_info_is_equal(ldecision.task, rdecision.task) or ldecision.kind != rdecision.kind or ldecision.synchronization != rdecision.synchronization
    return false if left.effects.count != right.effects.count or left.effects.cursor != right.effects.cursor or left.effects.mode != right.effects.mode or left.effects.exactness != right.effects.exactness or left.effects.overflowed != right.effects.overflowed
    return false if left.effects.count > TEST_EFFECT_CAPACITY
    return false if left.effects.last_error.code != right.effects.last_error.code or left.effects.last_error.severity != right.effects.last_error.severity or left.effects.last_error.retryable != right.effects.last_error.retryable or left.effects.last_error.detail != right.effects.last_error.detail
    for index in 0..<left.effects.count:
        lrecord: DebuggerEffects::EffectRecord = left.effects.records[index]
        rrecord: DebuggerEffects::EffectRecord = right.effects.records[index]
        return false if lrecord.sequence != rrecord.sequence or lrecord.kind != rrecord.kind or lrecord.request_hash != rrecord.request_hash or lrecord.result_hash != rrecord.result_hash or lrecord.result_value != rrecord.result_value or lrecord.suppress_external_write != rrecord.suppress_external_write
    return false if left.resources.count != right.resources.count or left.resources.next_handle != right.resources.next_handle or left.resources.mode != right.resources.mode or left.resources.count > TEST_RESOURCE_CAPACITY
    for index in 0..<left.resources.count:
        lfile: DebuggerVirtualResources::VirtualFile = left.resources.files[index]
        rfile: DebuggerVirtualResources::VirtualFile = right.resources.files[index]
        return false if lfile.handle.value != rfile.handle.value or lfile.path.value != rfile.path.value or lfile.length != rfile.length or lfile.cursor != rfile.cursor or lfile.writable != rfile.writable or lfile.generation != rfile.generation
        for byte_index in 0..<lfile.length:
            return false if lfile.bytes[byte_index] != rfile.bytes[byte_index]
    return adapter_snapshot_is_equal(left.adapters, right.adapters)

def check_round_trip() -> i64:
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()
    return TEST_TASK_ROUND_TRIP_FAILURE if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(checkpoint.tasks)
    return TEST_EFFECT_ROUND_TRIP_FAILURE if not DebuggerEffects::effect_oracle_is_exact(checkpoint.effects) or checkpoint.effects.count != 2 or checkpoint.effects.records[0].kind.u16() != TEST_EFFECT_KIND_CLOCK_CODE or checkpoint.effects.records[1].kind.u16() != TEST_EFFECT_KIND_CLOCK_CODE
    return TEST_RESOURCE_ROUND_TRIP_FAILURE if not DebuggerVirtualResources::resources_is_valid(checkpoint.resources)
    return TEST_ADAPTER_RESTORE_FAILURE if not DebuggerReplayAdapters::adapter_snapshot_is_valid(checkpoint.adapters) or checkpoint.adapters.clock.cursor != TEST_ADAPTER_CURSOR or checkpoint.adapters.random.cursor != TEST_ADAPTER_CURSOR or checkpoint.adapters.console.cursor != TEST_ADAPTER_CURSOR
    encoded: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    return TEST_DECODE_ROUND_TRIP_FAILURE if encoded.failed or encoded.length <= 0 or encoded.length > DebuggerFullCheckpointCodec::FULL_CHECKPOINT_CODEC_CAPACITY
    encoded_standard_checksum: u64 = test_get_u64(encoded.bytes[0], encoded.length - TEST_CODEC_CHECKSUM_BYTES)
    expected_standard_checksum: u64 = test_checksum_with_basis(encoded.bytes[0], encoded.length - TEST_CODEC_CHECKSUM_BYTES, TEST_FNV64_STANDARD_OFFSET_BASIS)
    return TEST_STANDARD_CHECKSUM_FAILURE if encoded_standard_checksum != expected_standard_checksum
    decoded: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length)
    return TEST_DECODE_ROUND_TRIP_FAILURE if decoded.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not DebuggerFullCheckpoint::full_checkpoint_is_valid(decoded.checkpoint)
    return TEST_DECODE_ROUND_TRIP_FAILURE if not checkpoints_are_equal(checkpoint, decoded.checkpoint)
    restored_adapters: mutable DebuggerReplayAdapters::AdapterSnapshot = zeroed
    return TEST_ADAPTER_RESTORE_FAILURE if not DebuggerErrors::error_is_ok(DebuggerFullCheckpoint::full_checkpoint_restore_adapters(restored_adapters, decoded.checkpoint)) or not adapter_snapshot_is_equal(checkpoint.adapters, restored_adapters)
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(TEST_ADAPTER_SOURCE_ID)
    next_clock: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(restored_adapters.clock, source)
    next_random: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read(restored_adapters.random, source)
    output: mutable u8[TEST_ADAPTER_OUTPUT_LENGTH] = [TEST_ADAPTER_OUTPUT_BYTE]
    next_console_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(restored_adapters.console, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[0], TEST_ADAPTER_OUTPUT_LENGTH)
    return TEST_ADAPTER_RESTORE_FAILURE if not next_clock.accepted or next_clock.value != TEST_ADAPTER_CLOCK_SECOND or not next_random.accepted or next_random.value != TEST_ADAPTER_RANDOM_SECOND or not next_console_write.accepted or not next_console_write.suppressed or not DebuggerReplayAdapters::console_replay_complete(restored_adapters.console)
    branch_console: mutable DebuggerReplayAdapters::Console = DebuggerReplayAdapters::console_new(DebuggerReplayAdapters::AdapterMode.Branch)
    branch_console.output_suppressed <- false
    branch_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(branch_console, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[0], TEST_ADAPTER_OUTPUT_LENGTH)
    return TEST_BRANCH_WRITE_NOT_SUPPRESSED if not branch_write.accepted or not branch_write.suppressed
    managed_state: mutable DebuggerManagedState::State = DebuggerManagedState::state_new()
    return TEST_ADAPTER_RESTORE_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedState::state_restore(managed_state, decoded.checkpoint)) or not adapter_snapshot_is_equal(managed_state.adapters, checkpoint.adapters)
    restored_machine: DebuggerEDIR::Machine = DebuggerFullCheckpoint::full_checkpoint_restore_machine(decoded.checkpoint)
    recaptured: DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerManagedState::state_capture(managed_state, restored_machine, decoded.checkpoint.recording, decoded.checkpoint.branch, decoded.checkpoint.event, decoded.checkpoint.state_hash)
    return TEST_ADAPTER_RESTORE_FAILURE if not checkpoints_are_equal(checkpoint, recaptured)
    legacy_checkpoint: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = encoded
    legacy_inner_checksum: u64 = test_legacy_checksum(legacy_checkpoint.bytes[0], legacy_checkpoint.length - TEST_CODEC_CHECKSUM_BYTES)
    test_put_u64(legacy_checkpoint.bytes[0], legacy_checkpoint.length - TEST_CODEC_CHECKSUM_BYTES, legacy_inner_checksum)
    legacy_checkpoint_decoded: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(legacy_checkpoint.bytes[0], legacy_checkpoint.length)
    return TEST_LEGACY_CHECKPOINT_FAILURE if legacy_checkpoint_decoded.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not checkpoints_are_equal(checkpoint, legacy_checkpoint_decoded.checkpoint)
    trace_chunk: DebuggerTraceStorage::CheckpointChunkEncoding = DebuggerTraceStorage::storage_checkpoint_chunk_new(checkpoint, TEST_TRACE_SEQUENCE)
    return TEST_TRACE_CHUNK_CREATE_FAILURE if trace_chunk.status != DebuggerTraceStorage::StorageStatus.Ready
    return 15 if not DebuggerTraceStorage::storage_checkpoint_chunk_is_valid(trace_chunk.chunk)
    trace_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(trace_chunk.chunk)
    return TEST_TRACE_FRAME_ENCODE_FAILURE if not DebuggerTraceBinary::writer_is_valid(trace_frame)
    decoded_frame: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(trace_frame.bytes[0], trace_frame.length)
    return TEST_TRACE_FRAME_DECODE_FAILURE if decoded_frame.status != DebuggerTraceStorage::StorageStatus.Ready or decoded_frame.chunk.header.sequence != TEST_TRACE_SEQUENCE
    restored_checkpoint: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerTraceStorage::storage_checkpoint_chunk_decode(decoded_frame.chunk)
    return TEST_TRACE_CHECKPOINT_RESTORE_FAILURE if restored_checkpoint.status != DebuggerFullCheckpointCodec::DecodeStatus.Ready or not checkpoints_are_equal(checkpoint, restored_checkpoint.checkpoint)
    reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return TEST_TRACE_READER_INGEST_FAILURE if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, checkpoint_manifest_chunk(checkpoint)))
    return TEST_TRACE_READER_INGEST_FAILURE if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest_encoded(reader, trace_frame.bytes[0], trace_frame.length))
    lookup: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_full_checkpoint_at(reader, 0)
    return TEST_TRACE_READER_RESTORE_FAILURE if not lookup.found or DebuggerTraceReader::reader_full_checkpoint_count(reader) != 1 or not checkpoints_are_equal(checkpoint, lookup.checkpoint)
    manifest_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(checkpoint_manifest_chunk(checkpoint))
    event_frame: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(checkpoint_trace_event_chunk(checkpoint))
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(TEST_TRACE_FOOTER_SEQUENCE, checkpoint.event)
    trace_bytes: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    append_trace_bytes(trace_bytes, manifest_frame)
    append_trace_bytes(trace_bytes, trace_frame)
    append_trace_bytes(trace_bytes, event_frame)
    append_trace_bytes(trace_bytes, footer)
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(trace_bytes.bytes[0], trace_bytes.length)
    return TEST_TRACE_SCAN_FAILURE if not DebuggerTraceBinary::writer_is_valid(trace_bytes) or scan.status != DebuggerTraceStorage::StorageStatus.Ready or not scan.footer_verified or scan.verified_chunks != TEST_TRACE_CHUNK_COUNT
    legacy_trace: mutable DebuggerTraceBinary::ByteWriter = trace_bytes
    checkpoint_frame_offset: usize = manifest_frame.length
    event_frame_offset: usize = manifest_frame.length + trace_frame.length
    legacy_inner_trace_checksum: u64 = test_legacy_checksum(legacy_trace.bytes[checkpoint_frame_offset + TEST_TRACE_HEADER_BYTES], encoded.length - TEST_CODEC_CHECKSUM_BYTES)
    test_put_u64(legacy_trace.bytes[0], checkpoint_frame_offset + TEST_TRACE_HEADER_BYTES + encoded.length - TEST_CODEC_CHECKSUM_BYTES, legacy_inner_trace_checksum)
    test_rewrite_frame_checksum_legacy(legacy_trace.bytes[0], 0, manifest_frame.length - TEST_TRACE_HEADER_BYTES)
    test_rewrite_frame_checksum_legacy(legacy_trace.bytes[0], checkpoint_frame_offset, trace_frame.length - TEST_TRACE_HEADER_BYTES)
    test_rewrite_frame_checksum_legacy(legacy_trace.bytes[0], event_frame_offset, event_frame.length - TEST_TRACE_HEADER_BYTES)
    legacy_scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(legacy_trace.bytes[0], legacy_trace.length)
    return TEST_LEGACY_TRACE_SCAN_FAILURE if legacy_scan.status != DebuggerTraceStorage::StorageStatus.Ready or not legacy_scan.footer_verified or legacy_scan.verified_chunks != TEST_TRACE_CHUNK_COUNT
    return 0

def check_rejects_malformed_inputs() -> i64:
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint()
    encoded: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(checkpoint)
    truncated: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], encoded.length - TEST_TRUNCATION)
    return TEST_TRUNCATED_INPUT_ACCEPTED if truncated.status != DebuggerFullCheckpointCodec::DecodeStatus.Truncated
    bad_header: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = encoded
    bad_header.bytes[0] <- 0
    invalid_header: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(bad_header.bytes[0], bad_header.length)
    return TEST_INVALID_HEADER_ACCEPTED if invalid_header.status != DebuggerFullCheckpointCodec::DecodeStatus.Invalid
    bad_checksum: mutable DebuggerFullCheckpointCodec::EncodedCheckpoint = encoded
    bad_checksum.bytes[bad_checksum.length - 1] <- bad_checksum.bytes[bad_checksum.length - 1] + 1
    invalid_checksum: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(bad_checksum.bytes[0], bad_checksum.length)
    return TEST_INVALID_CHECKSUM_ACCEPTED if invalid_checksum.status != DebuggerFullCheckpointCodec::DecodeStatus.Invalid
    oversized: DebuggerFullCheckpointCodec::DecodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_decode(encoded.bytes[0], DebuggerFullCheckpointCodec::FULL_CHECKPOINT_CODEC_CAPACITY + TEST_CODEC_CAPACITY_OFFSET)
    return TEST_OVERSIZED_INPUT_ACCEPTED if oversized.status != DebuggerFullCheckpointCodec::DecodeStatus.Oversized
    malformed: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    malformed.branch <- DebuggerIdentity::debug_id(18446744073709551615)
    rejected: DebuggerFullCheckpointCodec::EncodedCheckpoint = DebuggerFullCheckpointCodec::full_checkpoint_encode(malformed)
    return TEST_INVALID_ENCODE_ACCEPTED if not rejected.failed or rejected.length != 0
    tampered_adapters: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    tampered_adapters.adapters.clock.cursor <- tampered_adapters.adapters.clock.cursor + 1
    return TEST_ADAPTER_TAMPER_ACCEPTED if DebuggerFullCheckpoint::full_checkpoint_is_valid(tampered_adapters)
    tampered_replay_suppression: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    tampered_replay_suppression.adapters.console.output_suppressed <- false
    return TEST_REPLAY_WRITE_UNSUPPRESSED_ACCEPTED if DebuggerFullCheckpoint::full_checkpoint_is_valid(tampered_replay_suppression)
    rejected_trace_chunk: DebuggerTraceStorage::CheckpointChunkEncoding = DebuggerTraceStorage::storage_checkpoint_chunk_new(malformed, TEST_TRACE_SEQUENCE)
    return TEST_TRACE_INVALID_CHECKPOINT_ACCEPTED if rejected_trace_chunk.status != DebuggerTraceStorage::StorageStatus.Invalid
    return 0

def main() -> i64:
    round_trip: i64 = check_round_trip()
    return round_trip if round_trip != 0
    large_capacity: i64 = check_large_trace_capacity()
    return large_capacity if large_capacity != 0
    return check_rejects_malformed_inputs()
