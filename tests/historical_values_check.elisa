include "../src/inspect/history.elisa"
include "../src/inspect/values.elisa"
include "../src/core/identity.elisa"

const TEST_GENERATION: u64 = 7
const TEST_TYPE: u64 = 9
const TEST_EVENT: u64 = 3
const INVALID_STATE_RESULT: i64 = 1
const MISSING_RESULT: i64 = 2

def main() -> i64:
    timeline: mutable DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_new(TEST_GENERATION)
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(1))
    position.event <- TEST_EVENT
    value: DebuggerHistoricalValues::HistoricalValue = DebuggerHistoricalValues::HistoricalValue{
        handle: DebuggerValues::ValueHandle{stop_generation: TEST_GENERATION, id: DebuggerIdentity::debug_id(1)},
        position: position,
        type_id: DebuggerIdentity::debug_id(TEST_TYPE),
        state: DebuggerValues::ValueState.Available,
        signed_value: 42,
        value_hash: 42
    }
    timeline <- DebuggerHistoricalValues::timeline_append(timeline, value)
    found: DebuggerHistoricalValues::HistoricalValue = DebuggerHistoricalValues::timeline_value_at(timeline, TEST_EVENT)
    return 3 if not DebuggerHistoricalValues::historical_value_is_available(found)
    return 4 if DebuggerHistoricalValues::historical_value_failure(found, TEST_GENERATION).code != DebuggerErrors::ErrorCode.None
    absent: DebuggerHistoricalValues::HistoricalValue = DebuggerHistoricalValues::timeline_value_at(timeline, TEST_EVENT + 1)
    return MISSING_RESULT if absent.state != DebuggerValues::ValueState.Absent or DebuggerHistoricalValues::historical_value_failure(absent, TEST_GENERATION).code != DebuggerErrors::ErrorCode.Unavailable
    stale: DebuggerErrors::DebuggerError = DebuggerHistoricalValues::historical_value_failure(found, TEST_GENERATION + 1)
    return INVALID_STATE_RESULT if stale.code != DebuggerErrors::ErrorCode.StaleGeneration
    malformed: DebuggerHistoricalValues::HistoricalValue = found
    malformed.handle.id <- DebuggerIdentity::debug_id(0)
    return 6 if DebuggerHistoricalValues::historical_value_is_available(malformed) or DebuggerHistoricalValues::historical_value_failure(malformed, TEST_GENERATION).code != DebuggerErrors::ErrorCode.InvalidArgument
    invalid_value: mutable DebuggerHistoricalValues::HistoricalValue = found
    invalid_value.state <- DebuggerValues::ValueState.Invalid
    rejected_timeline: DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_append(timeline, invalid_value)
    return 7 if rejected_timeline.complete or rejected_timeline.count != timeline.count
    invalid_timeline: DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_new(0)
    invalid_page: DebuggerHistoricalValues::HistoricalPage = DebuggerHistoricalValues::timeline_page(invalid_timeline, 0)
    return 5 if invalid_page.failure.code != DebuggerErrors::ErrorCode.InvalidArgument or invalid_page.complete
    return 0
