include "../src/inspect/history.elisa"
include "../src/inspect/values.elisa"
include "../src/core/identity.elisa"

const module Test:
    GENERATION: u64 = 7
    TYPE: u64 = 9
    EVENT: u64 = 3
    INVALID_STATE_RESULT: i64 = 1
    MISSING_RESULT: i64 = 2
    INVALID_TIMELINE_COUNT: usize = 129


def main() -> i64:
    timeline: mutable DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_new(Test::GENERATION)
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(1))
    position.event <- Test::EVENT
    value: DebuggerHistoricalValues::HistoricalValue = DebuggerHistoricalValues::HistoricalValue{
        handle: DebuggerValues::ValueHandle{stop_generation: Test::GENERATION, id: DebuggerIdentity::debug_id(1)},
        position: position,
        type_id: DebuggerIdentity::debug_id(Test::TYPE),
        state: DebuggerValues::ValueState.Available,
        signed_value: 42,
        value_hash: 42
    }
    timeline <- DebuggerHistoricalValues::timeline_append(timeline, value)
    duplicate_event: DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_append(timeline, value)
    return 13 if duplicate_event.complete or duplicate_event.count != timeline.count
    found: DebuggerHistoricalValues::HistoricalValue = DebuggerHistoricalValues::timeline_value_at(timeline, Test::EVENT)
    return 3 if not DebuggerHistoricalValues::historical_value_is_available(found)
    return 4 if DebuggerHistoricalValues::historical_value_failure(found, Test::GENERATION).code != DebuggerErrors::ErrorCode.None
    absent: DebuggerHistoricalValues::HistoricalValue = DebuggerHistoricalValues::timeline_value_at(timeline, Test::EVENT + 1)
    return Test::MISSING_RESULT if absent.state != DebuggerValues::ValueState.Absent or DebuggerHistoricalValues::historical_value_failure(absent, Test::GENERATION).code != DebuggerErrors::ErrorCode.Unavailable
    stale: DebuggerErrors::DebuggerError = DebuggerHistoricalValues::historical_value_failure(found, Test::GENERATION + 1)
    return Test::INVALID_STATE_RESULT if stale.code != DebuggerErrors::ErrorCode.StaleGeneration
    malformed: DebuggerHistoricalValues::HistoricalValue = found
    malformed.handle.id <- DebuggerIdentity::debug_id(0)
    return 6 if DebuggerHistoricalValues::historical_value_is_available(malformed) or DebuggerHistoricalValues::historical_value_failure(malformed, Test::GENERATION).code != DebuggerErrors::ErrorCode.InvalidArgument
    rejected_handle: DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_append(timeline, malformed)
    return 12 if rejected_handle.complete or rejected_handle.count != timeline.count
    invalid_value: mutable DebuggerHistoricalValues::HistoricalValue = found
    invalid_value.state <- DebuggerValues::ValueState.Invalid
    rejected_timeline: DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_append(timeline, invalid_value)
    return 7 if rejected_timeline.complete or rejected_timeline.count != timeline.count
    stale_payload: mutable DebuggerHistoricalValues::HistoricalValue = found
    stale_payload.state <- DebuggerValues::ValueState.Unavailable
    rejected_payload: DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_append(timeline, stale_payload)
    return 11 if rejected_payload.complete or rejected_payload.count != timeline.count
    invalid_timeline: DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_new(0)
    rejected_invalid_timeline: DebuggerHistoricalValues::ValueTimeline = DebuggerHistoricalValues::timeline_append(invalid_timeline, value)
    return 8 if rejected_invalid_timeline.complete or rejected_invalid_timeline.count != 0
    invalid_page: DebuggerHistoricalValues::HistoricalPage = DebuggerHistoricalValues::timeline_page(invalid_timeline, 0)
    return 5 if invalid_page.failure.code != DebuggerErrors::ErrorCode.InvalidArgument or invalid_page.complete
    invalid_value_lookup: DebuggerHistoricalValues::HistoricalValue = DebuggerHistoricalValues::timeline_value_at(invalid_timeline, Test::EVENT)
    return 10 if invalid_value_lookup.state != DebuggerValues::ValueState.Absent
    corrupt_timeline: mutable DebuggerHistoricalValues::ValueTimeline = timeline
    corrupt_timeline.count <- Test::INVALID_TIMELINE_COUNT
    corrupt_page: DebuggerHistoricalValues::HistoricalPage = DebuggerHistoricalValues::timeline_page(corrupt_timeline, 0)
    return 9 if corrupt_page.failure.code != DebuggerErrors::ErrorCode.Corrupt or corrupt_page.complete
    return 0
