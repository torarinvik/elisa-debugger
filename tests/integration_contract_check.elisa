include "../src/native/attach.elisa"
include "../src/build/invocation.elisa"
include "../src/protocol/config.elisa"
include "../src/platform/process.elisa"
include "../src/build/discovery.elisa"

const PID: u64 = 10
const START: u64 = 11
const PROGRAM: u64 = 12
const WORKING_DIRECTORY: u64 = 13
const COMPILER: u64 = 14
const OUTPUT: u64 = 15
const PATH_ARGUMENT: u64 = 16
const EXPECTED_FAILURE: i64 = 1

def main() -> i64:
    process: DebuggerProcess::ProcessHandle = DebuggerProcess::process_attach(PID, START)
    session: mutable DebuggerNativeAttach::AttachSession = DebuggerNativeAttach::attach_new(process)
    session <- DebuggerNativeAttach::attach_add_register(session, DebuggerNativeAttach::Register{id: DebuggerIdentity::debug_id(1), value: 2, valid: true})
    duplicate_register: DebuggerNativeAttach::AttachSession = DebuggerNativeAttach::attach_add_register(session, DebuggerNativeAttach::Register{id: DebuggerIdentity::debug_id(1), value: 3, valid: true})
    return 6 if duplicate_register.register_count != session.register_count or not DebuggerNativeAttach::attach_validate(duplicate_register)
    session <- DebuggerNativeAttach::attach_add_frame(session, DebuggerNativeAttach::UnwindFrame{depth: 0, instruction_pointer: 100, stack_pointer: 200, function: DebuggerIdentity::debug_id(3), source: zeroed, complete: true})
    duplicate_frame: DebuggerNativeAttach::AttachSession = DebuggerNativeAttach::attach_add_frame(session, DebuggerNativeAttach::UnwindFrame{depth: 0, instruction_pointer: 101, stack_pointer: 201, function: DebuggerIdentity::debug_id(4), source: zeroed, complete: true})
    return 7 if duplicate_frame.frame_count != session.frame_count or not DebuggerNativeAttach::attach_validate(duplicate_frame)
    session <- DebuggerNativeAttach::attach_add_breakpoint(session, 100, 144)
    session <- DebuggerNativeAttach::attach_add_breakpoint(session, 101, 195)
    return EXPECTED_FAILURE if not DebuggerNativeAttach::attach_validate(session)
    duplicate_breakpoint: mutable DebuggerNativeAttach::AttachSession = session
    duplicate_breakpoint.breakpoints[1].id <- duplicate_breakpoint.breakpoints[0].id
    return 8 if DebuggerNativeAttach::attach_validate(duplicate_breakpoint)
    duplicate_frame_state: mutable DebuggerNativeAttach::AttachSession = session
    duplicate_frame_state.frames[1] <- duplicate_frame_state.frames[0]
    duplicate_frame_state.frame_count <- 2
    return 9 if DebuggerNativeAttach::attach_validate(duplicate_frame_state)
    invalid_breakpoint_allocator: mutable DebuggerNativeAttach::AttachSession = session
    invalid_breakpoint_allocator.next_breakpoint <- 0
    return 10 if DebuggerNativeAttach::attach_validate(invalid_breakpoint_allocator)
    invalid_breakpoint_order: mutable DebuggerNativeAttach::AttachSession = session
    invalid_breakpoint_order.next_breakpoint <- 2
    return 11 if DebuggerNativeAttach::attach_validate(invalid_breakpoint_order)
    toolchain: mutable DebuggerCompilerDiscovery::Toolchain = DebuggerCompilerDiscovery::toolchain_new()
    toolchain.compiler.present <- true
    toolchain.runtime.present <- true
    toolchain.compiler.path_id <- COMPILER
    toolchain.runtime.path_id <- COMPILER
    toolchain.compiler.revision <- 1
    toolchain.runtime.revision <- 1
    toolchain.compiler.major <- 1
    toolchain.runtime.major <- 1
    invocation: mutable DebuggerBuildInvocation::Invocation = DebuggerBuildInvocation::invocation_new(toolchain)
    invocation.source <- PROGRAM
    invocation.output <- OUTPUT
    invocation.debug_metadata <- true
    invocation.managed_edir <- true
    invocation.recording <- true
    invocation <- DebuggerBuildInvocation::invocation_add_argument(invocation, PATH_ARGUMENT)
    return 2 if not DebuggerBuildInvocation::invocation_is_recordable(invocation)
    configuration: mutable DebuggerProtocolConfig::LaunchConfiguration = DebuggerProtocolConfig::configuration_new()
    configuration.program <- PROGRAM
    configuration.working_directory <- WORKING_DIRECTORY
    configuration <- DebuggerProtocolConfig::configuration_add_argument(configuration, PATH_ARGUMENT)
    configuration <- DebuggerProtocolConfig::configuration_add_environment(configuration, PATH_ARGUMENT)
    configuration <- DebuggerProtocolConfig::configuration_add_mapping(configuration, DebuggerProtocolConfig::PathMapping{client_root: WORKING_DIRECTORY, server_root: WORKING_DIRECTORY})
    return 3 if not DebuggerErrors::error_is_ok(DebuggerProtocolConfig::configuration_validate(configuration))
    invalid_invocation: DebuggerBuildInvocation::Invocation = DebuggerBuildInvocation::invocation_add_argument(invocation, 0)
    return 4 if DebuggerErrors::error_is_ok(DebuggerBuildInvocation::invocation_validate(invalid_invocation))
    invalid_configuration: mutable DebuggerProtocolConfig::LaunchConfiguration = DebuggerProtocolConfig::configuration_new()
    invalid_configuration.program <- PROGRAM
    invalid_configuration.working_directory <- WORKING_DIRECTORY
    invalid_configuration <- DebuggerProtocolConfig::configuration_add_argument(invalid_configuration, 0)
    return 5 if DebuggerErrors::error_is_ok(DebuggerProtocolConfig::configuration_validate(invalid_configuration))
    return 0
