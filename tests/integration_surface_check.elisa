include "../src/protocol/integration.elisa"

const SESSION_ID: u64 = 41
const PRODUCT_ID: u64 = 42
const CLIENT_ID: u64 = 43
const VERSION_ID: u64 = 44
const INSTANCE_ID: u64 = 45
const OWNER_TOKEN: u64 = 46
const FOREIGN_OWNER_TOKEN: u64 = 47
const FOREIGN_DOCUMENT_RESULT: i64 = 9
const FOREIGN_CANCEL_DOCUMENT_RESULT: i64 = 11
const UNSUPPORTED_NATIVE_REVERSE_RESULT: i64 = 12
const UNSUPPORTED_POSTMORTEM_PAUSE_RESULT: i64 = 13
const MISMATCHED_CAPABILITIES_RESULT: i64 = 14
const UNSUPPORTED_POSTMORTEM_DETACH_RESULT: i64 = 15
const UNSUPPORTED_ATTACHED_TERMINATE_RESULT: i64 = 16
const UNSUPPORTED_MANAGED_ATTACH_RESULT: i64 = 19
const UNSUPPORTED_POSTMORTEM_LAUNCH_RESULT: i64 = 20

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    document: DebuggerProtocolIntegration::DiscoveryDocument = DebuggerProtocolIntegration::discovery_new(session, DebuggerIdentity::debug_id(PRODUCT_ID), DebuggerProtocolIntegration::InstallationStatus{healthy: true, compiler_compatible: true, runtime_compatible: true, diagnostic: DebuggerIdentity::debug_id(1)})
    return 1 if not DebuggerProtocolIntegration::discovery_document_is_valid(document)
    client: DebuggerProtocolIntegration::ClientIdentity = DebuggerProtocolIntegration::ClientIdentity{name: DebuggerIdentity::debug_id(CLIENT_ID), version: DebuggerIdentity::debug_id(VERSION_ID), instance: DebuggerIdentity::debug_id(INSTANCE_ID)}
    request: mutable DebuggerProtocolIntegration::SessionRequest = DebuggerProtocolIntegration::SessionRequest{client: client, request_id: 1, session_id: SESSION_ID, owner_token: OWNER_TOKEN, expected_generation: 0, method: DebuggerProtocol::Method.Seek, page_size: 0, target_event: 4}
    return 2 if not DebuggerErrors::error_is_ok(DebuggerProtocolIntegration::session_request_validate(request, session, document, OWNER_TOKEN))
    request.client.instance <- DebuggerIdentity::debug_id(0)
    return 10 if DebuggerProtocolIntegration::session_request_validate(request, session, document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    request.client.instance <- DebuggerIdentity::debug_id(INSTANCE_ID)
    mismatched_document: DebuggerProtocolIntegration::DiscoveryDocument = document
    mismatched_document.capabilities.reverse_execution <- false
    return MISMATCHED_CAPABILITIES_RESULT if DebuggerProtocolIntegration::session_request_validate(request, session, mismatched_document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    foreign_document: DebuggerProtocolIntegration::DiscoveryDocument = document
    foreign_document.session <- DebuggerIdentity::debug_id(99)
    return FOREIGN_DOCUMENT_RESULT if DebuggerProtocolIntegration::session_request_validate(request, session, foreign_document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    request.owner_token <- 0
    return 3 if DebuggerProtocolIntegration::session_request_validate(request, session, document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    request.owner_token <- OWNER_TOKEN
    request.owner_token <- FOREIGN_OWNER_TOKEN
    return 21 if DebuggerProtocolIntegration::session_request_validate(request, session, document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    request.owner_token <- OWNER_TOKEN
    return 22 if DebuggerProtocolIntegration::session_request_validate(request, session, document, FOREIGN_OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    create_request: DebuggerProtocolIntegration::SessionRequest = request
    create_request.method <- DebuggerProtocol::Method.CreateSession
    create_request.owner_token <- 0
    return 18 if DebuggerProtocolIntegration::session_request_validate(create_request, session, document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    request.expected_generation <- 1
    return 4 if DebuggerProtocolIntegration::session_request_validate(request, session, document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.StaleGeneration
    return 5 if not DebuggerProtocolIntegration::retry_is_forbidden(DebuggerProtocol::Method.Launch) or not DebuggerProtocolIntegration::retry_is_safe(DebuggerProtocol::Method.Threads)
    return 7 if not DebuggerProtocolIntegration::retry_is_safe(DebuggerProtocol::Method.TraceExport) or not DebuggerProtocolIntegration::retry_is_safe(DebuggerProtocol::Method.Compare) or not DebuggerProtocolIntegration::retry_is_safe(DebuggerProtocol::Method.Evaluate)
    return 8 if not DebuggerProtocolIntegration::retry_is_same_request_only(DebuggerProtocol::Method.Checkpoint) or DebuggerProtocolIntegration::retry_is_same_request_only(DebuggerProtocol::Method.Branch) or DebuggerProtocolIntegration::retry_is_same_request_only(DebuggerProtocol::Method.Threads)
    cancel: DebuggerProtocolIntegration::CancelRequest = DebuggerProtocolIntegration::CancelRequest{client: client, request_id: 2, target_request_id: 1, session_id: SESSION_ID, owner_token: OWNER_TOKEN, expected_generation: 0}
    return 6 if not DebuggerErrors::error_is_ok(DebuggerProtocolIntegration::cancel_request_validate(cancel, session, document, OWNER_TOKEN))
    self_cancel: DebuggerProtocolIntegration::CancelRequest = cancel
    self_cancel.request_id <- 2
    self_cancel.target_request_id <- 2
    return 17 if self_cancel.request_id == 0 or DebuggerProtocolIntegration::cancel_request_validate(self_cancel, session, document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    return FOREIGN_CANCEL_DOCUMENT_RESULT if DebuggerProtocolIntegration::cancel_request_validate(cancel, session, foreign_document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    foreign_cancel: DebuggerProtocolIntegration::CancelRequest = cancel
    foreign_cancel.owner_token <- FOREIGN_OWNER_TOKEN
    return 23 if DebuggerProtocolIntegration::cancel_request_validate(foreign_cancel, session, document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    return 24 if DebuggerProtocolIntegration::cancel_request_validate(cancel, session, document, FOREIGN_OWNER_TOKEN).code != DebuggerErrors::ErrorCode.InvalidArgument
    native_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(50), build, DebuggerCapabilities::native_attach_capabilities())
    native_document: DebuggerProtocolIntegration::DiscoveryDocument = DebuggerProtocolIntegration::discovery_new(native_session, DebuggerIdentity::debug_id(PRODUCT_ID), DebuggerProtocolIntegration::InstallationStatus{healthy: true, compiler_compatible: true, runtime_compatible: true, diagnostic: DebuggerIdentity::debug_id(1)})
    native_request: mutable DebuggerProtocolIntegration::SessionRequest = request
    native_request.session_id <- 50
    native_request.method <- DebuggerProtocol::Method.ReverseStep
    return UNSUPPORTED_NATIVE_REVERSE_RESULT if DebuggerProtocolIntegration::session_request_validate(native_request, native_session, native_document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.Unsupported
    postmortem_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(51), build, DebuggerCapabilities::postmortem_capabilities())
    postmortem_document: DebuggerProtocolIntegration::DiscoveryDocument = DebuggerProtocolIntegration::discovery_new(postmortem_session, DebuggerIdentity::debug_id(PRODUCT_ID), DebuggerProtocolIntegration::InstallationStatus{healthy: true, compiler_compatible: true, runtime_compatible: true, diagnostic: DebuggerIdentity::debug_id(1)})
    postmortem_request: mutable DebuggerProtocolIntegration::SessionRequest = native_request
    postmortem_request.session_id <- 51
    postmortem_request.method <- DebuggerProtocol::Method.Pause
    return UNSUPPORTED_POSTMORTEM_PAUSE_RESULT if DebuggerProtocolIntegration::session_request_validate(postmortem_request, postmortem_session, postmortem_document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.Unsupported
    postmortem_request.method <- DebuggerProtocol::Method.Detach
    return UNSUPPORTED_POSTMORTEM_DETACH_RESULT if DebuggerProtocolIntegration::session_request_validate(postmortem_request, postmortem_session, postmortem_document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.Unsupported
    native_request.method <- DebuggerProtocol::Method.Terminate
    return UNSUPPORTED_ATTACHED_TERMINATE_RESULT if DebuggerProtocolIntegration::session_request_validate(native_request, native_session, native_document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.Unsupported
    managed_attach_request: mutable DebuggerProtocolIntegration::SessionRequest = request
    managed_attach_request.method <- DebuggerProtocol::Method.Attach
    return UNSUPPORTED_MANAGED_ATTACH_RESULT if DebuggerProtocolIntegration::session_request_validate(managed_attach_request, session, document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.Unsupported
    postmortem_launch_request: mutable DebuggerProtocolIntegration::SessionRequest = postmortem_request
    postmortem_launch_request.method <- DebuggerProtocol::Method.Launch
    return UNSUPPORTED_POSTMORTEM_LAUNCH_RESULT if DebuggerProtocolIntegration::session_request_validate(postmortem_launch_request, postmortem_session, postmortem_document, OWNER_TOKEN).code != DebuggerErrors::ErrorCode.Unsupported
    return 0
