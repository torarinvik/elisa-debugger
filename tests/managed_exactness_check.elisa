        HOST_CONSOLE_INPUT_FAILED: i64 = 33
        VIRTUAL_FILE_READ_FAILED: i64 = 34

def managed_clock_effect_bridge_is_atomic() -> bool:
    state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(state)
    call_site: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ClockBridge::CALL_SITE_ID)
    adapter_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ClockBridge::ADAPTER_SOURCE_ID)
    invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ClockBridge::INVOCATION_ID)
    recorded: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_clock_effect(state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replayed: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH)
    return false if not replayed.accepted or replayed.result_hash != Test::ClockBridge::RESULT_HASH or replayed.result_value != Test::ClockBridge::RESULT_VALUE
    return false if state.effects.cursor != Test::Bounds::ONE_COUNT or state.adapters.clock.cursor != Test::Bounds::ONE_COUNT

    mismatch_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(mismatch_state)
    recorded <- DebuggerManagedState::state_record_clock_effect(mismatch_state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started <- DebuggerManagedState::state_begin_side_effect_replay(mismatch_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    mismatch: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(mismatch_state, call_site, adapter_source, invocation, Test::ClockBridge::MISMATCH_REQUEST_HASH)
    return false if mismatch.accepted or mismatch.failure.code != DebuggerErrors::ErrorCode.Diverged
    return false if mismatch_state.effects.cursor != Test::Bounds::FIRST_INDEX or mismatch_state.adapters.clock.cursor != Test::Bounds::FIRST_INDEX
    return false if mismatch_state.effects.exactness != DebuggerEffects::Exactness.Diverged or mismatch_state.adapters.clock.exact

    adapter_mismatch_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(adapter_mismatch_state)
    recorded <- DebuggerManagedState::state_record_clock_effect(adapter_mismatch_state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started <- DebuggerManagedState::state_begin_side_effect_replay(adapter_mismatch_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    adapter_mismatch: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(adapter_mismatch_state, call_site, DebuggerIdentity::debug_id(Test::ClockBridge::MISMATCH_ADAPTER_SOURCE_ID), invocation, Test::ClockBridge::REQUEST_HASH)
    return false if adapter_mismatch.accepted or adapter_mismatch.failure.code != DebuggerErrors::ErrorCode.Diverged
    return false if adapter_mismatch_state.effects.cursor != Test::Bounds::FIRST_INDEX or adapter_mismatch_state.adapters.clock.cursor != Test::Bounds::FIRST_INDEX
    return false if adapter_mismatch_state.effects.exactness != DebuggerEffects::Exactness.Diverged or adapter_mismatch_state.adapters.clock.exact

    value_mismatch_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(value_mismatch_state)
    recorded <- DebuggerManagedState::state_record_clock_effect(value_mismatch_state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    value_mismatch_state.adapters.clock.samples[Test::Bounds::FIRST_INDEX].value <- Test::ClockBridge::MISMATCH_CLOCK_VALUE
    replay_started <- DebuggerManagedState::state_begin_side_effect_replay(value_mismatch_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    value_mismatch: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(value_mismatch_state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH)
    return false if value_mismatch.accepted or value_mismatch.failure.code != DebuggerErrors::ErrorCode.Diverged
    return false if value_mismatch_state.effects.cursor != Test::Bounds::FIRST_INDEX or value_mismatch_state.adapters.clock.cursor != Test::Bounds::FIRST_INDEX
    return false if value_mismatch_state.effects.exactness != DebuggerEffects::Exactness.Diverged or value_mismatch_state.adapters.clock.exact
    return true

def managed_random_effect_bridge_is_atomic() -> bool:
    state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(state)
    call_site: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::RandomBridge::CALL_SITE_ID)
    adapter_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::RandomBridge::ADAPTER_SOURCE_ID)
    invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::RandomBridge::INVOCATION_ID)
    recorded: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_random_effect(state, call_site, adapter_source, invocation, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replayed: DebuggerEffects::RandomEffectReplay = DebuggerManagedState::state_replay_random_effect(state, call_site, adapter_source, invocation, Test::RandomBridge::REQUEST_HASH)
    return false if not replayed.accepted or replayed.result_hash != Test::RandomBridge::RESULT_HASH or replayed.value != Test::RandomBridge::RANDOM_VALUE
    return false if state.effects.cursor != Test::Bounds::ONE_COUNT or state.adapters.random.cursor != Test::Bounds::ONE_COUNT

    mismatch_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(mismatch_state)
    recorded <- DebuggerManagedState::state_record_random_effect(mismatch_state, call_site, adapter_source, invocation, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started <- DebuggerManagedState::state_begin_side_effect_replay(mismatch_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    adapter_mismatch: DebuggerEffects::RandomEffectReplay = DebuggerManagedState::state_replay_random_effect(mismatch_state, call_site, DebuggerIdentity::debug_id(Test::RandomBridge::MISMATCH_ADAPTER_SOURCE_ID), invocation, Test::RandomBridge::REQUEST_HASH)
    return false if adapter_mismatch.accepted or adapter_mismatch.failure.code != DebuggerErrors::ErrorCode.Diverged
    return false if mismatch_state.effects.cursor != Test::Bounds::FIRST_INDEX or mismatch_state.adapters.random.cursor != Test::Bounds::FIRST_INDEX
    return false if mismatch_state.effects.exactness != DebuggerEffects::Exactness.Diverged or mismatch_state.adapters.random.exact

    value_mismatch_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(value_mismatch_state)
    recorded <- DebuggerManagedState::state_record_random_effect(value_mismatch_state, call_site, adapter_source, invocation, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    value_mismatch_state.adapters.random.samples[Test::Bounds::FIRST_INDEX].value <- Test::RandomBridge::MISMATCH_RANDOM_VALUE
    replay_started <- DebuggerManagedState::state_begin_side_effect_replay(value_mismatch_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    value_mismatch: DebuggerEffects::RandomEffectReplay = DebuggerManagedState::state_replay_random_effect(value_mismatch_state, call_site, adapter_source, invocation, Test::RandomBridge::REQUEST_HASH)
    return false if value_mismatch.accepted or value_mismatch.failure.code != DebuggerErrors::ErrorCode.Diverged
    return false if value_mismatch_state.effects.cursor != Test::Bounds::FIRST_INDEX or value_mismatch_state.adapters.random.cursor != Test::Bounds::FIRST_INDEX
    return false if value_mismatch_state.effects.exactness != DebuggerEffects::Exactness.Diverged or value_mismatch_state.adapters.random.exact
    return true

def managed_effect_bridges_use_active_identity(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    recorded_clock: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_clock_effect(controller, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded_clock)
    recorded_random: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_random_effect(controller, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded_random)
    return false if controller.state.effects.count != Test::Bounds::TWO_COUNT or controller.state.adapters.clock.count != Test::Bounds::ONE_COUNT or controller.state.adapters.random.count != Test::Bounds::ONE_COUNT
    effect_site: u64 = controller.state.effects.records[Test::Bounds::FIRST_INDEX].call_site.value
    effect_invocation: u64 = controller.state.effects.records[Test::Bounds::FIRST_INDEX].invocation.value
    return false if effect_site == 0 or effect_invocation == 0
    return false if controller.state.effects.records[Test::Bounds::ONE_COUNT].call_site.value != effect_site or controller.state.effects.records[Test::Bounds::ONE_COUNT].invocation.value != effect_invocation
    return false if controller.state.adapters.clock.samples[Test::Bounds::FIRST_INDEX].source.value != effect_site or controller.state.adapters.clock.samples[Test::Bounds::FIRST_INDEX].invocation.value != effect_invocation
    return false if controller.state.adapters.random.samples[Test::Bounds::FIRST_INDEX].source.value != effect_site or controller.state.adapters.random.samples[Test::Bounds::FIRST_INDEX].invocation.value != effect_invocation

    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(controller.state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replayed_clock: DebuggerEffects::EffectReplay = DebuggerManagedEngine::managed_replay_clock_effect(controller, Test::ClockBridge::REQUEST_HASH)
    return false if not replayed_clock.accepted or replayed_clock.result_value != Test::ClockBridge::RESULT_VALUE
    replayed_random: DebuggerEffects::RandomEffectReplay = DebuggerManagedEngine::managed_replay_random_effect(controller, Test::RandomBridge::REQUEST_HASH)
    return false if not replayed_random.accepted or replayed_random.value != Test::RandomBridge::RANDOM_VALUE
    return controller.state.effects.cursor == Test::Bounds::TWO_COUNT and controller.state.adapters.clock.cursor == Test::Bounds::ONE_COUNT and controller.state.adapters.random.cursor == Test::Bounds::ONE_COUNT

def managed_effect_time_travel_restores_state(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    recorded_clock: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_clock_effect(controller, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded_clock)
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller))
    recorded_random: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_random_effect(controller, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded_random)
    return false if controller.engine.event_count != Test::HistoryBarrier::FIRST_EVENT or controller.state.effects.count != Test::Bounds::TWO_COUNT or controller.state.adapters.clock.count != Test::Bounds::ONE_COUNT or controller.state.adapters.random.count != Test::Bounds::ONE_COUNT

    reverse_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step(controller)
    return false if not DebuggerErrors::error_is_ok(reverse_failure) or controller.engine.event_count != Test::Bounds::FIRST_INDEX
    return false if controller.state.effects.count != Test::Bounds::ONE_COUNT or controller.state.adapters.clock.count != Test::Bounds::ONE_COUNT or controller.state.adapters.random.count != Test::Bounds::FIRST_INDEX
    navigation: DebuggerTimeline::HistoryEligibility = DebuggerManagedEngine::managed_history_eligibility(controller)
    return false if not navigation.can_seek or navigation.reason != DebuggerTimeline::HistoryEligibilityReason.Ready

    seek_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::HistoryBarrier::FIRST_EVENT)
    return false if not DebuggerErrors::error_is_ok(seek_failure) or controller.engine.event_count != Test::HistoryBarrier::FIRST_EVENT
    return controller.state.effects.count == Test::Bounds::TWO_COUNT and controller.state.adapters.clock.count == Test::Bounds::ONE_COUNT and controller.state.adapters.random.count == Test::Bounds::ONE_COUNT

def managed_console_output_time_travel_restores_state(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    output: mutable u8[Test::ConsoleHistory::OUTPUT_LENGTH] = [Test::ConsoleHistory::OUTPUT_BYTE]
    written: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(controller.state.adapters.console, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[Test::ConsoleHistory::FIRST_BYTE], Test::ConsoleHistory::OUTPUT_LENGTH)
    return false if not written.accepted or written.transferred != Test::ConsoleHistory::OUTPUT_LENGTH or controller.state.adapters.console.count != Test::Bounds::ONE_COUNT
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.event_count != Test::ConsoleHistory::RECORDED_EVENT

    reverse_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step(controller)
    return false if not DebuggerErrors::error_is_ok(reverse_failure) or controller.engine.event_count != Test::ConsoleHistory::INITIAL_EVENT
    return false if controller.state.adapters.console.count != Test::Bounds::FIRST_INDEX or controller.state.adapters.console.cursor != Test::Bounds::FIRST_INDEX

    seek_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::ConsoleHistory::RECORDED_EVENT)
    return false if not DebuggerErrors::error_is_ok(seek_failure) or controller.engine.event_count != Test::ConsoleHistory::RECORDED_EVENT
    restored: DebuggerReplayAdapters::ConsoleRecord = controller.state.adapters.console.records[Test::ConsoleHistory::FIRST_RECORD]
    return controller.state.adapters.console.count == Test::Bounds::ONE_COUNT and restored.kind == DebuggerReplayAdapters::ConsoleRecordKind.Output and restored.channel == DebuggerReplayAdapters::ConsoleChannel.Stdout and restored.length == Test::ConsoleHistory::OUTPUT_LENGTH and restored.bytes[Test::ConsoleHistory::FIRST_BYTE] == Test::ConsoleHistory::OUTPUT_BYTE

def managed_effect_bridges_reject_mixed_modes() -> bool:
    recording_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(recording_state)
    recording_state.adapters.random.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    record_failure: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_clock_effect(recording_state, DebuggerIdentity::debug_id(Test::ClockBridge::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::ClockBridge::ADAPTER_SOURCE_ID), DebuggerIdentity::debug_id(Test::ClockBridge::INVOCATION_ID), Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if record_failure.code != DebuggerErrors::ErrorCode.InvalidState or recording_state.effects.count != Test::Bounds::FIRST_INDEX or recording_state.adapters.clock.count != Test::Bounds::FIRST_INDEX

    replay_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(replay_state)
    recorded: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_clock_effect(replay_state, DebuggerIdentity::debug_id(Test::ClockBridge::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::ClockBridge::ADAPTER_SOURCE_ID), DebuggerIdentity::debug_id(Test::ClockBridge::INVOCATION_ID), Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(replay_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replay_state.adapters.random.mode <- DebuggerReplayAdapters::AdapterMode.Recording
    replay_failure: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(replay_state, DebuggerIdentity::debug_id(Test::ClockBridge::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::ClockBridge::ADAPTER_SOURCE_ID), DebuggerIdentity::debug_id(Test::ClockBridge::INVOCATION_ID), Test::ClockBridge::REQUEST_HASH)
    return false if replay_failure.accepted or replay_failure.failure.code != DebuggerErrors::ErrorCode.InvalidState
    return replay_state.effects.cursor == Test::Bounds::FIRST_INDEX and replay_state.adapters.clock.cursor == Test::Bounds::FIRST_INDEX

def managed_effect_record_capacity_is_atomic() -> bool:
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ClockBridge::ADAPTER_SOURCE_ID)
    invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ClockBridge::INVOCATION_ID)
    clock_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(clock_state)
    adapter_recorded: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
    while clock_state.adapters.clock.count < DebuggerReplayAdapters::Limits::SAMPLE_CAPACITY:
        adapter_recorded <- DebuggerReplayAdapters::clock_record_in_invocation(clock_state.adapters.clock, source, invocation, Test::ClockBridge::RESULT_VALUE.u64())
        return false if not DebuggerErrors::error_is_ok(adapter_recorded)
    clock_failure: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_clock_effect(clock_state, DebuggerIdentity::debug_id(Test::ClockBridge::CALL_SITE_ID), source, invocation, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if clock_failure.code != DebuggerErrors::ErrorCode.ResourceLimit or clock_state.effects.count != Test::Bounds::FIRST_INDEX or clock_state.adapters.clock.count != DebuggerReplayAdapters::Limits::SAMPLE_CAPACITY
    return false if clock_state.effects.exactness != DebuggerEffects::Exactness.Incomplete or clock_state.adapters.clock.exact

    random_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::RandomBridge::ADAPTER_SOURCE_ID)
    random_invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::RandomBridge::INVOCATION_ID)
    random_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(random_state)
    while random_state.adapters.random.count < DebuggerReplayAdapters::Limits::SAMPLE_CAPACITY:
        adapter_recorded <- DebuggerReplayAdapters::random_record_in_invocation(random_state.adapters.random, random_source, random_invocation, Test::RandomBridge::RANDOM_VALUE)
        return false if not DebuggerErrors::error_is_ok(adapter_recorded)
    random_failure: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_random_effect(random_state, DebuggerIdentity::debug_id(Test::RandomBridge::CALL_SITE_ID), random_source, random_invocation, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if random_failure.code != DebuggerErrors::ErrorCode.ResourceLimit or random_state.effects.count != Test::Bounds::FIRST_INDEX or random_state.adapters.random.count != DebuggerReplayAdapters::Limits::SAMPLE_CAPACITY
    return random_state.effects.exactness == DebuggerEffects::Exactness.Incomplete and not random_state.adapters.random.exact

def managed_history_side_state_barriers_work(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.event_count != Test::HistoryBarrier::FIRST_EVENT
    return false if controller.side_history_count != Test::Bounds::TWO_COUNT
    available: DebuggerTimeline::HistoryEligibility = DebuggerManagedEngine::managed_history_eligibility(controller)
    return false if not available.can_reverse or not available.can_seek or available.reason != DebuggerTimeline::HistoryEligibilityReason.Ready

    for state_kind in Test::Bounds::FIRST_INDEX.u16()..<Test::HistoryBarrier::SIDE_STATE_KIND_COUNT:
        DebuggerManagedState::state_initialize(controller.state)
        if state_kind == Test::HistoryBarrier::EFFECTS_KIND:
            DebuggerEffects::effect_oracle_record_in_invocation(controller.state.effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::HistoryBarrier::EFFECT_CALL_SITE_ID), DebuggerIdentity::debug_id(Test::HistoryBarrier::EFFECT_INVOCATION_ID), Test::HistoryBarrier::EFFECT_REQUEST_HASH, Test::HistoryBarrier::EFFECT_RESULT_HASH, Test::HistoryBarrier::EFFECT_RESULT_VALUE)
        if state_kind == Test::HistoryBarrier::RESOURCES_KIND:
            opened: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(controller.state.resources, DebuggerIdentity::debug_id(Test::HistoryBarrier::RESOURCE_PATH_ID), false, Test::HistoryBarrier::RESOURCE_GENERATION)
            return false if not opened.accepted
        if state_kind == Test::HistoryBarrier::ADAPTERS_KIND:
            failure: DebuggerErrors::DebuggerError = DebuggerReplayAdapters::clock_record_in_invocation(controller.state.adapters.clock, DebuggerIdentity::debug_id(Test::HistoryBarrier::ADAPTER_SOURCE_ID), DebuggerIdentity::debug_id(Test::HistoryBarrier::ADAPTER_INVOCATION_ID), Test::HistoryBarrier::ADAPTER_VALUE)
            return false if not DebuggerErrors::error_is_ok(failure)
        if state_kind == Test::HistoryBarrier::RANDOM_KIND:
            failure: DebuggerErrors::DebuggerError = DebuggerReplayAdapters::random_record_in_invocation(controller.state.adapters.random, DebuggerIdentity::debug_id(Test::HistoryBarrier::RANDOM_SOURCE_ID), DebuggerIdentity::debug_id(Test::HistoryBarrier::RANDOM_INVOCATION_ID), Test::HistoryBarrier::RANDOM_VALUE)
            return false if not DebuggerErrors::error_is_ok(failure)
        if state_kind == Test::HistoryBarrier::CONSOLE_KIND:
            console_bytes: mutable u8[Test::HistoryBarrier::CONSOLE_LENGTH] = [Test::HistoryBarrier::CONSOLE_BYTE]
            failure: DebuggerErrors::DebuggerError = DebuggerReplayAdapters::console_record(controller.state.adapters.console, DebuggerReplayAdapters::ConsoleRecordKind.Output, DebuggerReplayAdapters::ConsoleChannel.Stdout, console_bytes[Test::Bounds::FIRST_INDEX], Test::HistoryBarrier::CONSOLE_LENGTH)
            return false if not DebuggerErrors::error_is_ok(failure)
        if state_kind == Test::HistoryBarrier::TASKS_KIND:
            task_id: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(controller.state.tasks, DebuggerIdentity::debug_id(Test::HistoryBarrier::ROOT_TASK_ID))
            return false if task_id.value == Test::HistoryBarrier::ROOT_TASK_ID

        blocked: DebuggerTimeline::HistoryEligibility = DebuggerManagedEngine::managed_history_eligibility(controller)
        return false if blocked.can_reverse or blocked.can_seek or blocked.reason != DebuggerTimeline::HistoryEligibilityReason.SideStateUnaligned

        event_before: usize = controller.engine.event_count
        machine_hash_before: u64 = DebuggerReplayEngine::replay_engine_state_hash(controller.engine)
        reverse_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step(controller)
        return false if reverse_failure.code != DebuggerErrors::ErrorCode.Unavailable or controller.engine.event_count != event_before or DebuggerReplayEngine::replay_engine_state_hash(controller.engine) != machine_hash_before
        seek_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::HistoryBarrier::INITIAL_EVENT)
        return false if seek_failure.code != DebuggerErrors::ErrorCode.Unavailable or controller.engine.event_count != event_before or DebuggerReplayEngine::replay_engine_state_hash(controller.engine) != machine_hash_before
    return true

def managed_seek_without_side_checkpoint_is_atomic(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    machine_hash: u64 = DebuggerReplayEngine::replay_engine_state_hash(controller.engine)
    engine_error: DebuggerReplayEngine::EngineError = controller.engine.engine_error
    retained_snapshot_id: u64 = controller.engine.history[Test::Bounds::FIRST_INDEX].id.value
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::HistoryBarrier::FIRST_EVENT)
    return false if failure.code != DebuggerErrors::ErrorCode.Unavailable
    return false if controller.engine.event_count != Test::HistoryBarrier::INITIAL_EVENT or controller.session.position.event != Test::HistoryBarrier::INITIAL_EVENT.u64()
    return false if DebuggerReplayEngine::replay_engine_state_hash(controller.engine) != machine_hash or controller.engine.engine_error != engine_error
    return controller.engine.history[Test::Bounds::FIRST_INDEX].id.value == retained_snapshot_id and controller.side_history_count == Test::Bounds::ONE_COUNT

def managed_host_effect_time_travel_is_exact(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    host_image: mutable DebuggerEDIR::ProgramImage = image
    host_image.program.version <- Test::HostProgram::VERSION
    host_image.program.instruction_count <- Test::HostProgram::INSTRUCTION_COUNT
    host_image.instructions[Test::HostProgram::CLOCK_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.ClockNow, a: Test::HostProgram::UNUSED_OPERAND, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::FIRST_INSTRUCTION].source}
    host_image.instructions[Test::HostProgram::RANDOM_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.RandomU64, a: Test::HostProgram::UNUSED_OPERAND, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::FIRST_INSTRUCTION].source}
    host_image.instructions[Test::HostProgram::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::HostProgram::UNUSED_OPERAND, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::RETURN_INSTRUCTION].source}
    return false if not DebuggerEDIR::verify_image_with_source_table(host_image).valid

    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, host_image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    clock_request: DebuggerManagedEngine::HostEffectRequest = DebuggerManagedEngine::managed_host_effect_request(controller)
    return false if not clock_request.valid or clock_request.kind != DebuggerManagedEngine::HostEffectKind.ClockNow or clock_request.request_hash == 0 or clock_request.call_site.value == 0 or clock_request.invocation.value == 0
    pending_step: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_step_with_outcome(controller)
    return false if pending_step.kind != DebuggerManagedEngine::ExecutionOutcomeKind.AwaitingHostEffect or pending_step.failure.code != DebuggerErrors::ErrorCode.Unavailable or not pending_step.host_effect.valid or pending_step.position.event != Test::HistoryBarrier::INITIAL_EVENT.u64()
    return false if controller.engine.event_count != Test::HistoryBarrier::INITIAL_EVENT or controller.engine.machine.program_counter != Test::HistoryBarrier::INITIAL_EVENT.u64() or controller.engine.machine.faulted
    pending_continue: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(controller, DebuggerReplayEngine::Limits::HISTORY_CAPACITY.u64())
    return false if pending_continue.kind != DebuggerManagedEngine::ExecutionOutcomeKind.AwaitingHostEffect or pending_continue.failure.code != DebuggerErrors::ErrorCode.Unavailable or pending_continue.host_effect.request_hash != clock_request.request_hash
    return false if controller.engine.event_count != Test::HistoryBarrier::INITIAL_EVENT or controller.engine.machine.faulted

    clock_recorded: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_clock_effect(controller, clock_request.request_hash, Test::HostResult::CLOCK_RESULT_HASH, Test::HostResult::CLOCK_VALUE)
    return false if not DebuggerErrors::error_is_ok(clock_recorded) or controller.engine.event_count != Test::Bounds::ONE_COUNT or controller.engine.machine.program_counter != Test::HostProgram::RANDOM_INSTRUCTION.u64() or controller.engine.machine.accumulator != Test::HostResult::CLOCK_VALUE
    random_request: DebuggerManagedEngine::HostEffectRequest = DebuggerManagedEngine::managed_host_effect_request(controller)
    return false if not random_request.valid or random_request.kind != DebuggerManagedEngine::HostEffectKind.RandomU64 or random_request.request_hash == 0
    random_recorded: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_random_effect(controller, random_request.request_hash, Test::HostResult::RANDOM_RESULT_HASH, Test::HostResult::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(random_recorded) or controller.engine.event_count != Test::Bounds::TWO_COUNT or controller.engine.machine.program_counter != Test::HostProgram::RETURN_INSTRUCTION.u64() or controller.engine.machine.accumulator.u64() != Test::HostResult::RANDOM_VALUE
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or not controller.engine.machine.halted or controller.engine.event_count != Test::Bounds::TWO_COUNT + Test::Bounds::ONE_COUNT
    return false if not DebuggerManagedEngine::managed_is_exact(controller)

    reverse_return: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step(controller)
    return false if not DebuggerErrors::error_is_ok(reverse_return) or controller.engine.event_count != Test::Bounds::TWO_COUNT or controller.engine.machine.program_counter != Test::HostProgram::RETURN_INSTRUCTION.u64()
    reverse_random: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step(controller)
    return false if not DebuggerErrors::error_is_ok(reverse_random) or controller.engine.event_count != Test::Bounds::ONE_COUNT or controller.engine.machine.program_counter != Test::HostProgram::RANDOM_INSTRUCTION.u64()
    return false if controller.state.effects.count != Test::Bounds::ONE_COUNT or controller.state.adapters.clock.count != Test::Bounds::ONE_COUNT or controller.state.adapters.random.count != Test::Bounds::FIRST_INDEX
    return false if not controller.engine.effect_result_recorded[Test::Bounds::ONE_COUNT] or controller.engine.effect_result_bits[Test::Bounds::ONE_COUNT] != Test::HostResult::RANDOM_VALUE

    forward_seek: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::Bounds::TWO_COUNT + Test::Bounds::ONE_COUNT)
    return false if not DebuggerErrors::error_is_ok(forward_seek) or not controller.engine.machine.halted or controller.engine.event_count != Test::Bounds::TWO_COUNT + Test::Bounds::ONE_COUNT
    return controller.state.effects.count == Test::Bounds::TWO_COUNT and controller.state.adapters.clock.count == Test::Bounds::ONE_COUNT and controller.state.adapters.random.count == Test::Bounds::ONE_COUNT and DebuggerManagedEngine::managed_is_exact(controller)

def managed_host_effect_replay_commits_vm_results(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    host_image: mutable DebuggerEDIR::ProgramImage = image
    host_image.program.version <- Test::HostProgram::VERSION
    host_image.program.instruction_count <- Test::HostProgram::INSTRUCTION_COUNT
    host_image.instructions[Test::HostProgram::CLOCK_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.ClockNow, a: Test::HostProgram::UNUSED_OPERAND, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::FIRST_INSTRUCTION].source}
    host_image.instructions[Test::HostProgram::RANDOM_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.RandomU64, a: Test::HostProgram::UNUSED_OPERAND, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::FIRST_INSTRUCTION].source}
    host_image.instructions[Test::HostProgram::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::HostProgram::UNUSED_OPERAND, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::RETURN_INSTRUCTION].source}

    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, host_image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    clock_request: DebuggerManagedEngine::HostEffectRequest = DebuggerManagedEngine::managed_host_effect_request(controller)
    random_identity: DebuggerEDIRIdentity::StableIdentity = DebuggerEDIRIdentity::effect_call_site_identity(host_image, Test::HostProgram::RANDOM_INSTRUCTION)
    random_invocation: DebuggerEDIRIdentity::StableIdentity = DebuggerEDIRIdentity::effect_invocation_identity(host_image, controller.engine.machine)
    return false if not clock_request.valid or not random_identity.valid or not random_invocation.valid

    recorded_state: mutable DebuggerManagedState::State = controller.state
    clock_seeded: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_clock_effect(recorded_state, clock_request.call_site, clock_request.call_site, clock_request.invocation, clock_request.request_hash, Test::HostResult::CLOCK_RESULT_HASH, Test::HostResult::CLOCK_VALUE)
    return false if not DebuggerErrors::error_is_ok(clock_seeded)
    random_seeded: DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_random_effect(recorded_state, random_identity.value, random_identity.value, random_invocation.value, Test::HostResult::RANDOM_REQUEST_HASH, Test::HostResult::RANDOM_RESULT_HASH, Test::HostResult::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(random_seeded)
    controller.state <- recorded_state
    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_begin_side_effect_replay(controller)
    return false if not DebuggerErrors::error_is_ok(replay_started)

    clock_replay: DebuggerEffects::EffectReplay = DebuggerManagedEngine::managed_replay_clock_effect(controller, clock_request.request_hash)
    return false if not clock_replay.accepted or clock_replay.result_value != Test::HostResult::CLOCK_VALUE or controller.engine.event_count != Test::Bounds::ONE_COUNT or controller.engine.machine.accumulator != Test::HostResult::CLOCK_VALUE
    random_request: DebuggerManagedEngine::HostEffectRequest = DebuggerManagedEngine::managed_host_effect_request(controller)
    random_replay: DebuggerEffects::RandomEffectReplay = DebuggerManagedEngine::managed_replay_random_effect(controller, random_request.request_hash)
    return false if not random_request.valid or not random_replay.accepted or random_replay.value != Test::HostResult::RANDOM_VALUE or controller.engine.event_count != Test::Bounds::TWO_COUNT or controller.engine.machine.accumulator.u64() != Test::HostResult::RANDOM_VALUE
    return controller.state.effects.cursor == Test::Bounds::TWO_COUNT and controller.state.adapters.clock.cursor == Test::Bounds::ONE_COUNT and controller.state.adapters.random.cursor == Test::Bounds::ONE_COUNT and DebuggerManagedEngine::managed_is_exact(controller)

def managed_console_output_records_and_replays(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    console_image: mutable DebuggerEDIR::ProgramImage = image
    console_image.program.version <- Test::ConsoleProgram::VERSION
    console_image.program.instruction_count <- Test::ConsoleProgram::INSTRUCTION_COUNT
    console_image.program.local_count <- Test::Image::LOCAL_COUNT
    console_image.instructions[Test::ConsoleProgram::OUTPUT_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.ConsoleWriteByte, a: Test::ConsoleProgram::OUTPUT_BYTE, b: Test::ConsoleProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::FIRST_INSTRUCTION].source}
    console_image.instructions[Test::ConsoleProgram::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::ConsoleProgram::UNUSED_OPERAND, b: Test::ConsoleProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::RETURN_INSTRUCTION].source}

    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, console_image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    pending: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(controller, Test::ConsoleProgram::MAX_CONTINUE_STEPS)
    return false if pending.kind != DebuggerManagedEngine::ExecutionOutcomeKind.AwaitingHostEffect or not pending.host_effect.valid or pending.host_effect.kind != DebuggerManagedEngine::HostEffectKind.ConsoleOutput or pending.host_effect.payload != Test::ConsoleProgram::OUTPUT_BYTE.u64()
    expected_request_hash: u64 = DebuggerManagedState::console_output_request_hash(Test::ConsoleProgram::OUTPUT_BYTE.u8())
    return false if pending.host_effect.request_hash != expected_request_hash
    recorded: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_console_output(controller, pending.host_effect.request_hash)
    return false if not DebuggerErrors::error_is_ok(recorded) or controller.engine.event_count != Test::ConsoleProgram::OUTPUT_EVENT
    return false if controller.state.effects.count != Test::Bounds::ONE_COUNT or controller.state.adapters.console.count != Test::Bounds::ONE_COUNT or controller.engine.machine.accumulator != Test::ConsoleProgram::OUTPUT_RESULT_BITS.i64()
    output_record: DebuggerReplayAdapters::ConsoleRecord = controller.state.adapters.console.records[Test::Bounds::FIRST_INDEX]
    return false if output_record.kind != DebuggerReplayAdapters::ConsoleRecordKind.Output or output_record.channel != DebuggerReplayAdapters::ConsoleChannel.Stdout or output_record.length != Test::Resource::BYTE_LENGTH or output_record.bytes[Test::Bounds::FIRST_INDEX] != Test::ConsoleProgram::OUTPUT_BYTE.u8()
    completed: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(controller, Test::ConsoleProgram::MAX_CONTINUE_STEPS)
    return false if completed.kind != DebuggerManagedEngine::ExecutionOutcomeKind.Completed or not controller.engine.machine.halted or controller.engine.event_count != Test::ConsoleProgram::FINAL_EVENT or not DebuggerManagedEngine::managed_is_exact(controller)
    recorded_state: mutable DebuggerManagedState::State = controller.state

    before_output: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::Bounds::FIRST_INDEX)
    return false if not DebuggerErrors::error_is_ok(before_output) or controller.state.effects.count != Test::Bounds::FIRST_INDEX or controller.state.adapters.console.count != Test::Bounds::FIRST_INDEX
    after_output: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::ConsoleProgram::OUTPUT_EVENT)
    return false if not DebuggerErrors::error_is_ok(after_output) or controller.state.effects.count != Test::Bounds::ONE_COUNT or controller.state.adapters.console.count != Test::Bounds::ONE_COUNT
    restored_output: DebuggerReplayAdapters::ConsoleRecord = controller.state.adapters.console.records[Test::Bounds::FIRST_INDEX]
    return false if restored_output.bytes[Test::Bounds::FIRST_INDEX] != Test::ConsoleProgram::OUTPUT_BYTE.u8() or not DebuggerManagedEngine::managed_is_exact(controller)
    final_position: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::ConsoleProgram::FINAL_EVENT)
    return false if not DebuggerErrors::error_is_ok(final_position) or not controller.engine.machine.halted

    replay_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(replay_controller, session, console_image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(replay_controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(replay_controller))
    replay_controller.state <- recorded_state
    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_begin_side_effect_replay(replay_controller)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replay_pending: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(replay_controller, Test::ConsoleProgram::MAX_CONTINUE_STEPS)
    return false if replay_pending.kind != DebuggerManagedEngine::ExecutionOutcomeKind.AwaitingHostEffect or replay_pending.host_effect.kind != DebuggerManagedEngine::HostEffectKind.ConsoleOutput
    replay: DebuggerEffects::EffectReplay = DebuggerManagedEngine::managed_replay_console_output(replay_controller, replay_pending.host_effect.request_hash)
    return false if not replay.accepted or not replay.suppress_external_write or replay.result_value != Test::ConsoleProgram::OUTPUT_RESULT_BITS.i64() or replay_controller.engine.event_count != Test::ConsoleProgram::OUTPUT_EVENT
    replay_completed: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(replay_controller, Test::ConsoleProgram::MAX_CONTINUE_STEPS)
    return false if replay_completed.kind != DebuggerManagedEngine::ExecutionOutcomeKind.Completed or not replay_controller.engine.machine.halted
    return DebuggerReplayAdapters::console_replay_complete(replay_controller.state.adapters.console) and DebuggerEffects::effect_oracle_replay_complete(replay_controller.state.effects) and DebuggerManagedEngine::managed_is_exact(replay_controller)

def managed_console_input_case(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&, value: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    console_image: mutable DebuggerEDIR::ProgramImage = image
    console_image.program.version <- Test::ConsoleInputProgram::VERSION
    console_image.program.instruction_count <- Test::ConsoleInputProgram::INSTRUCTION_COUNT
    console_image.program.local_count <- Test::Image::LOCAL_COUNT
    console_image.instructions[Test::ConsoleInputProgram::INPUT_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.ConsoleReadByte, a: Test::ConsoleProgram::UNUSED_OPERAND, b: Test::ConsoleProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::FIRST_INSTRUCTION].source}
    console_image.instructions[Test::ConsoleInputProgram::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::ConsoleProgram::UNUSED_OPERAND, b: Test::ConsoleProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::RETURN_INSTRUCTION].source}

    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, console_image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    pending: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(controller, Test::ConsoleInputProgram::MAX_CONTINUE_STEPS)
    return false if pending.kind != DebuggerManagedEngine::ExecutionOutcomeKind.AwaitingHostEffect or not pending.host_effect.valid or pending.host_effect.kind != DebuggerManagedEngine::HostEffectKind.ConsoleInput or pending.host_effect.payload != Test::ConsoleInputProgram::REQUESTED_BYTES.u64()
    expected_request_hash: u64 = DebuggerManagedState::console_input_request_hash(Test::ConsoleInputProgram::REQUESTED_BYTES)
    return false if pending.host_effect.request_hash != expected_request_hash
    result_hash: u64 = DebuggerManagedState::state_effect_result_hash(value.u64())
    recorded: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_console_input(controller, pending.host_effect.request_hash, result_hash, value)
    return false if not DebuggerErrors::error_is_ok(recorded) or controller.engine.event_count != Test::ConsoleInputProgram::INPUT_EVENT or controller.engine.machine.accumulator != value
    is_eof: bool = value == Test::ConsoleInputProgram::EOF_VALUE
    expected_length: usize = Test::ConsoleInputProgram::EOF_LENGTH if is_eof else Test::ConsoleInputProgram::BYTE_LENGTH
    input_record: DebuggerReplayAdapters::ConsoleRecord = controller.state.adapters.console.records[Test::ConsoleInputProgram::FIRST_RECORD]
    return false if input_record.kind != DebuggerReplayAdapters::ConsoleRecordKind.Input or input_record.channel != DebuggerReplayAdapters::ConsoleChannel.Stdin or input_record.requested != Test::ConsoleInputProgram::REQUESTED_BYTES or input_record.length != expected_length or input_record.eof != is_eof
    return false if not is_eof and input_record.bytes[Test::ConsoleInputProgram::FIRST_RECORD] != value.u8()
    return false if controller.state.effects.count != Test::Bounds::ONE_COUNT or controller.state.effects.records[Test::ConsoleInputProgram::FIRST_RECORD].kind != DebuggerEffects::EffectKind.ConsoleInput

    completed: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(controller, Test::ConsoleInputProgram::MAX_CONTINUE_STEPS)
    return false if completed.kind != DebuggerManagedEngine::ExecutionOutcomeKind.Completed or not controller.engine.machine.halted or controller.engine.event_count != Test::ConsoleInputProgram::FINAL_EVENT or not DebuggerManagedEngine::managed_is_exact(controller)
    recorded_state: mutable DebuggerManagedState::State = controller.state
    rewound: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::Bounds::FIRST_INDEX.u64())
    return false if not DebuggerErrors::error_is_ok(rewound) or controller.state.effects.count != Test::Bounds::FIRST_INDEX or controller.state.adapters.console.count != Test::Bounds::FIRST_INDEX
    restored: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::ConsoleInputProgram::INPUT_EVENT.u64())
    return false if not DebuggerErrors::error_is_ok(restored) or controller.state.effects.count != Test::Bounds::ONE_COUNT or controller.state.adapters.console.records[Test::ConsoleInputProgram::FIRST_RECORD].eof != is_eof

    replay_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(replay_controller, session, console_image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(replay_controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(replay_controller))
    replay_controller.state <- recorded_state
    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_begin_side_effect_replay(replay_controller)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replay_pending: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(replay_controller, Test::ConsoleInputProgram::MAX_CONTINUE_STEPS)
    return false if replay_pending.kind != DebuggerManagedEngine::ExecutionOutcomeKind.AwaitingHostEffect or replay_pending.host_effect.kind != DebuggerManagedEngine::HostEffectKind.ConsoleInput
    replay: DebuggerEffects::EffectReplay = DebuggerManagedEngine::managed_replay_console_input(replay_controller, replay_pending.host_effect.request_hash)
    return false if not replay.accepted or replay.suppress_external_write or replay.result_value != value or replay_controller.engine.event_count != Test::ConsoleInputProgram::INPUT_EVENT or replay_controller.engine.machine.accumulator != value
    replay_completed: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(replay_controller, Test::ConsoleInputProgram::MAX_CONTINUE_STEPS)
    return false if replay_completed.kind != DebuggerManagedEngine::ExecutionOutcomeKind.Completed or not replay_controller.engine.machine.halted or replay_controller.engine.machine.result != value
    return DebuggerReplayAdapters::console_replay_complete(replay_controller.state.adapters.console) and DebuggerEffects::effect_oracle_replay_complete(replay_controller.state.effects) and DebuggerManagedEngine::managed_is_exact(replay_controller)


def managed_virtual_file_read_time_travel(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    file_image: mutable DebuggerEDIR::ProgramImage = image
    file_image.program.version <- Test::VirtualFileProgram::VERSION
    file_image.program.instruction_count <- Test::VirtualFileProgram::INSTRUCTION_COUNT
    file_image.instructions[Test::VirtualFileProgram::FIRST_READ_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.VirtualFileReadByte, a: Test::VirtualFileProgram::RESOURCE_HANDLE, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::FIRST_INSTRUCTION].source}
    file_image.instructions[Test::VirtualFileProgram::EOF_READ_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.VirtualFileReadByte, a: Test::VirtualFileProgram::RESOURCE_HANDLE, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::FIRST_INSTRUCTION].source}
    file_image.instructions[Test::VirtualFileProgram::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::HostProgram::UNUSED_OPERAND, b: Test::HostProgram::UNUSED_OPERAND, source: image.instructions[Test::Image::RETURN_INSTRUCTION].source}
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, file_image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    initial_bytes: mutable u8[Test::Resource::BYTE_LENGTH] = [Test::Resource::INITIAL_BYTE]
    mounted: DebuggerVirtualResources::ResourceOpenResult = DebuggerManagedEngine::managed_resource_mount(controller, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), false, Test::Resource::GENERATION, initial_bytes[Test::Bounds::FIRST_INDEX], Test::Resource::BYTE_LENGTH)
    return false if not mounted.accepted or mounted.handle.value != Test::VirtualFileProgram::RESOURCE_HANDLE.u64() or not DebuggerManagedEngine::managed_is_exact(controller)
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    request: DebuggerManagedEngine::HostEffectRequest = DebuggerManagedEngine::managed_host_effect_request(controller)
    return false if not request.valid or request.kind != DebuggerManagedEngine::HostEffectKind.VirtualFileReadByte or DebuggerManagedEngine::managed_host_effect_is_pending(controller)
    late_mount: DebuggerVirtualResources::ResourceOpenResult = DebuggerManagedEngine::managed_resource_mount(controller, DebuggerIdentity::debug_id(Test::Resource::PATH_ID + Test::Bounds::ONE_COUNT.u64()), false, Test::Resource::GENERATION, initial_bytes[Test::Bounds::FIRST_INDEX], Test::Resource::BYTE_LENGTH)
    return false if late_mount.accepted or late_mount.failure.code != DebuggerErrors::ErrorCode.InvalidState or controller.state.resources.count != Test::Bounds::ONE_COUNT
    recorded: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(controller, Test::VirtualFileProgram::MAX_CONTINUE_STEPS)
    return false if recorded.kind != DebuggerManagedEngine::ExecutionOutcomeKind.Completed or not controller.engine.machine.halted or controller.engine.machine.result != Test::VirtualFileProgram::EOF_VALUE or controller.engine.event_count != Test::VirtualFileProgram::FINAL_EVENT
    return false if not controller.engine.effect_result_recorded[Test::VirtualFileProgram::FIRST_READ_INSTRUCTION] or controller.engine.effect_result_bits[Test::VirtualFileProgram::FIRST_READ_INSTRUCTION] != Test::Resource::INITIAL_BYTE.u64()
    return false if not controller.engine.effect_result_recorded[Test::VirtualFileProgram::EOF_READ_INSTRUCTION] or controller.engine.effect_result_bits[Test::VirtualFileProgram::EOF_READ_INSTRUCTION] != Test::VirtualFileProgram::EOF_BITS
    return false if controller.state.resources.operation_count != Test::Bounds::TWO_COUNT or controller.state.resources.operations[Test::VirtualFileProgram::FIRST_RESOURCE_OPERATION].transferred != Test::VirtualFileProgram::RESOURCE_REQUESTED_BYTES or controller.state.resources.operations[Test::VirtualFileProgram::FIRST_RESOURCE_OPERATION].eof or controller.state.resources.operations[Test::VirtualFileProgram::EOF_RESOURCE_OPERATION].transferred != Test::Bounds::FIRST_INDEX or not controller.state.resources.operations[Test::VirtualFileProgram::EOF_RESOURCE_OPERATION].eof or not DebuggerManagedEngine::managed_is_exact(controller)
    recorded_state: mutable DebuggerManagedState::State = controller.state
    rewound: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::Bounds::FIRST_INDEX.u64())
    return false if not DebuggerErrors::error_is_ok(rewound) or controller.state.resources.operation_cursor != Test::Bounds::FIRST_INDEX or controller.state.resources.files[Test::Bounds::FIRST_INDEX].cursor != Test::Bounds::FIRST_INDEX
    replay_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(replay_controller, session, file_image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(replay_controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(replay_controller))
    replay_controller.state <- recorded_state
    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_begin_side_effect_replay(replay_controller)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replayed: DebuggerManagedEngine::ExecutionOutcome = DebuggerManagedEngine::managed_continue_with_outcome(replay_controller, Test::VirtualFileProgram::MAX_CONTINUE_STEPS)
    return false if replayed.kind != DebuggerManagedEngine::ExecutionOutcomeKind.Completed or not replay_controller.engine.machine.halted or replay_controller.engine.machine.result != Test::VirtualFileProgram::EOF_VALUE or replay_controller.engine.event_count != Test::VirtualFileProgram::FINAL_EVENT or not DebuggerVirtualResources::resources_replay_complete(replay_controller.state.resources) or not DebuggerManagedEngine::managed_is_exact(replay_controller)
    return true


def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::Identity::BUILD_COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(Test::Identity::BUILD_RUNTIME_ID),
        source: DebuggerIdentity::debug_id(Test::Identity::BUILD_SOURCE_ID),
        target: DebuggerIdentity::debug_id(Test::Identity::BUILD_TARGET_ID),
        metadata_version: Test::Identity::METADATA_VERSION
    }
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::Identity::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::Image::VERSION, instruction_count: Test::Image::INSTRUCTION_COUNT, local_count: Test::Image::LOCAL_COUNT, has_return: Test::Image::HAS_RETURN}
    image.instructions[Test::Image::FIRST_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::Image::CONSTANT_VALUE, b: Test::Image::UNUSED_OPERAND, source: zeroed}
    image.instructions[Test::Image::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::Image::UNUSED_OPERAND, b: Test::Image::UNUSED_OPERAND, source: zeroed}
    image.source_file_count <- Test::Bounds::ONE_COUNT
    source_file: mutable DebuggerMetadata::SourceFile = zeroed
    source_file.id <- DebuggerIdentity::debug_id(Test::EffectSource::FILE_ID)
    source_file.logical_path <- DebuggerIdentity::debug_id(Test::EffectSource::LOGICAL_PATH_ID)
    source_file.content <- DebuggerIdentity::debug_id(Test::EffectSource::CONTENT_ID)
    source_file.line_count <- Test::EffectSource::LINE_COUNT
    source_file.path_bytes[Test::Bounds::FIRST_INDEX] <- Test::EffectSource::PATH_BYTE
    source_file.path_length <- Test::EffectSource::PATH_LENGTH
    image.source_files[Test::Bounds::FIRST_INDEX] <- source_file
    source_span: mutable DebuggerIdentity::SourceSpan = zeroed
    source_span.file <- DebuggerIdentity::debug_id(Test::EffectSource::FILE_ID)
    source_span.start_byte <- Test::EffectSource::START_BYTE
    source_span.end_byte <- Test::EffectSource::END_BYTE
    source_span.start_line <- Test::EffectSource::LINE
    source_span.start_column <- Test::EffectSource::START_COLUMN
    source_span.end_line <- Test::EffectSource::LINE
    source_span.end_column <- Test::EffectSource::END_COLUMN
    source_span.discriminator <- Test::EffectSource::DISCRIMINATOR
    image.instructions[Test::Image::FIRST_INSTRUCTION].source <- source_span
    image.instructions[Test::Image::RETURN_INSTRUCTION].source <- source_span
    return Test::Failure::ACTIVE_IDENTITY_BRIDGE_FAILED if not managed_effect_bridges_use_active_identity(session, image)
    return Test::Failure::EFFECT_HISTORY_RESTORE_FAILED if not managed_effect_time_travel_restores_state(session, image)
    return Test::Failure::CONSOLE_HISTORY_RESTORE_FAILED if not managed_console_output_time_travel_restores_state(session, image)
    return Test::Failure::MIXED_BRIDGE_MODE_ACCEPTED if not managed_effect_bridges_reject_mixed_modes()
    return Test::Failure::CAPACITY_BRIDGE_PARTIALLY_RECORDED if not managed_effect_record_capacity_is_atomic()
    return Test::Failure::CLOCK_BRIDGE_NOT_ATOMIC if not managed_clock_effect_bridge_is_atomic()
    return Test::Failure::RANDOM_BRIDGE_NOT_ATOMIC if not managed_random_effect_bridge_is_atomic()
    return Test::Failure::TIME_TRAVEL_BARRIER_NOT_DETECTED if not managed_history_side_state_barriers_work(session, image)
    return Test::Failure::MISSING_TARGET_SEEK_NOT_ATOMIC if not managed_seek_without_side_checkpoint_is_atomic(session, image)
    return Test::Failure::HOST_EFFECT_TIME_TRAVEL_FAILED if not managed_host_effect_time_travel_is_exact(session, image)
    return Test::Failure::HOST_EFFECT_REPLAY_FAILED if not managed_host_effect_replay_commits_vm_results(session, image)
    return Test::Failure::HOST_CONSOLE_OUTPUT_FAILED if not managed_console_output_records_and_replays(session, image)
    return Test::Failure::HOST_CONSOLE_INPUT_FAILED if not managed_console_input_case(session, image, Test::ConsoleInputProgram::BYTE_VALUE)
    return Test::Failure::HOST_CONSOLE_INPUT_FAILED if not managed_console_input_case(session, image, Test::ConsoleInputProgram::EOF_VALUE)
    return Test::Failure::VIRTUAL_FILE_READ_FAILED if not managed_virtual_file_read_time_travel(session, image)
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return Test::Failure::INITIAL_STATE_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_record_in_invocation(controller.state.effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::Effect::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::Effect::INVOCATION_ID), Test::Effect::REQUEST_HASH, Test::Effect::RESULT_HASH, Test::Effect::RESULT_VALUE)
    controller.state.effects.cursor <- Test::Bounds::ONE_COUNT
    return Test::Failure::RECORDING_EFFECT_CURSOR_ACCEPTED if DebuggerManagedEngine::managed_is_exact(controller)
    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Recording)
    return Test::Failure::RECORDING_MODE_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Replaying)
    return Test::Failure::MIXED_REPLAY_MODE_ACCEPTED if DebuggerManagedEngine::managed_is_exact(controller)
    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Recording)
    return Test::Failure::RECORDING_MODE_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Replaying)
    replay_resources_failure: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_replay_restart(controller.state.resources)
    return Test::Failure::REPLAY_MODE_NOT_EXACT if not DebuggerErrors::error_is_ok(replay_resources_failure)
    DebuggerReplayAdapters::adapter_snapshot_initialize(controller.state.adapters, DebuggerReplayAdapters::AdapterMode.Replaying)
    return Test::Failure::REPLAY_MODE_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Virtualized)
    DebuggerVirtualResources::resources_initialize(controller.state.resources, DebuggerVirtualResources::ResourceMode.Branch)
    DebuggerReplayAdapters::adapter_snapshot_initialize(controller.state.adapters, DebuggerReplayAdapters::AdapterMode.Branch)
    return Test::Failure::BRANCH_MODE_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerManagedState::state_initialize(controller.state)
    return Test::Failure::RECORDING_MODE_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_record_in_invocation(controller.state.effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::Effect::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::Effect::INVOCATION_ID), Test::Effect::REQUEST_HASH, Test::Effect::RESULT_HASH, Test::Effect::RESULT_VALUE)
    adapter_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::Adapter::SOURCE_ID)
    return Test::Failure::REPLAY_RECORDING_SETUP if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record_in_invocation(controller.state.adapters.clock, adapter_source, DebuggerIdentity::debug_id(Test::Adapter::INVOCATION_ID), Test::Adapter::CLOCK_VALUE))
    initial_bytes: mutable u8[Test::Resource::BYTE_LENGTH] = [Test::Resource::INITIAL_BYTE]
    recorded_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(controller.state.resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
    return Test::Failure::REPLAY_RECORDING_SETUP if not recorded_open.accepted
    seeded: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seed(controller.state.resources, recorded_open.handle, initial_bytes[Test::Bounds::FIRST_INDEX], Test::Resource::BYTE_LENGTH)
    return Test::Failure::REPLAY_RECORDING_SETUP if not DebuggerErrors::error_is_ok(seeded)
    updated_bytes: mutable u8[Test::Resource::BYTE_LENGTH] = [Test::Resource::UPDATED_BYTE]
    recorded_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(controller.state.resources, recorded_open.handle, updated_bytes[Test::Bounds::FIRST_INDEX], Test::Resource::BYTE_LENGTH)
    return Test::Failure::REPLAY_RECORDING_SETUP if not DebuggerErrors::error_is_ok(recorded_write.failure) or recorded_write.transferred != Test::Resource::BYTE_LENGTH

    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(controller.state)
    return Test::Failure::REPLAY_MODES_NOT_ALIGNED if not DebuggerErrors::error_is_ok(replay_started)
    return Test::Failure::REPLAY_MODES_NOT_ALIGNED if controller.state.effects.mode != DebuggerEffects::EffectMode.Replaying or controller.state.resources.mode != DebuggerVirtualResources::ResourceMode.Replaying or controller.state.adapters.clock.mode != DebuggerReplayAdapters::AdapterMode.Replaying or controller.state.adapters.random.mode != DebuggerReplayAdapters::AdapterMode.Replaying or controller.state.adapters.console.mode != DebuggerReplayAdapters::AdapterMode.Replaying or not controller.state.adapters.console.output_suppressed
    return Test::Failure::RESOURCE_NOT_RESET_TO_INITIAL_IMAGE if controller.state.resources.files[Test::Bounds::FIRST_INDEX].bytes[Test::Bounds::FIRST_INDEX] != Test::Resource::INITIAL_BYTE or controller.state.resources.files[Test::Bounds::FIRST_INDEX].cursor != Test::Bounds::FIRST_INDEX
    effect_reply: DebuggerEffects::EffectReplay = DebuggerEffects::effect_oracle_replay_result_in_invocation(controller.state.effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::Effect::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::Effect::INVOCATION_ID), Test::Effect::REQUEST_HASH)
    return Test::Failure::EFFECT_REPLY_MISMATCH if not effect_reply.accepted or effect_reply.result_hash != Test::Effect::RESULT_HASH or effect_reply.result_value != Test::Effect::RESULT_VALUE
    clock_reply: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read_in_invocation(controller.state.adapters.clock, adapter_source, DebuggerIdentity::debug_id(Test::Adapter::INVOCATION_ID))
    return Test::Failure::ADAPTER_REPLY_MISMATCH if not clock_reply.accepted or clock_reply.value != Test::Adapter::CLOCK_VALUE
    replay_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(controller.state.resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
    replay_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(controller.state.resources, replay_open.handle, updated_bytes[Test::Bounds::FIRST_INDEX], Test::Resource::BYTE_LENGTH)
    return Test::Failure::RESOURCE_REPLAY_MISMATCH if not replay_open.accepted or not DebuggerErrors::error_is_ok(replay_write.failure) or replay_write.transferred != Test::Resource::BYTE_LENGTH or controller.state.resources.files[Test::Bounds::FIRST_INDEX].bytes[Test::Bounds::FIRST_INDEX] != Test::Resource::UPDATED_BYTE
    return Test::Failure::REPLAY_NOT_COMPLETE if not DebuggerEffects::effect_oracle_replay_complete(controller.state.effects) or not DebuggerVirtualResources::resources_replay_complete(controller.state.resources) or not DebuggerReplayAdapters::clock_is_exact(controller.state.adapters.clock) or not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerManagedState::state_initialize(controller.state)
    return Test::Failure::REPLAY_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_record(controller.state.effects, DebuggerEffects::EffectKind.FileRead, Test::Effect::REQUEST_HASH, Test::Effect::RESULT_HASH, Test::Effect::RESULT_VALUE)
    return Test::Failure::BARRIER_NOT_DETECTED if DebuggerManagedEngine::managed_is_exact(controller)
    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Recording)
    return Test::Failure::EFFECT_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    overflow_resources: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(overflow_resources, DebuggerVirtualResources::ResourceMode.Recording)
    first_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
    return Test::Failure::RESOURCE_OVERFLOW_SETUP if not first_open.accepted
    while overflow_resources.operation_count < DebuggerVirtualResources::Limits::MAX_OPERATIONS:
        fill_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
        return Test::Failure::RESOURCE_OVERFLOW_SETUP if not fill_open.accepted
    overflow_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
    return Test::Failure::RESOURCE_OVERFLOW_SETUP if overflow_open.accepted or not DebuggerVirtualResources::resources_is_valid(overflow_resources)
    controller.state.resources <- overflow_resources
    refused_replay: DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(controller.state)
    return Test::Failure::OVERFLOWED_REPLAY_NOT_ATOMIC if refused_replay.code != DebuggerErrors::ErrorCode.ResourceLimit or controller.state.effects.mode != DebuggerEffects::EffectMode.Recording or controller.state.resources.mode != DebuggerVirtualResources::ResourceMode.Recording or controller.state.adapters.clock.mode != DebuggerReplayAdapters::AdapterMode.Recording
    return Test::Failure::RESOURCE_OVERFLOW_NOT_DETECTED if DebuggerManagedEngine::managed_is_exact(controller)
    DebuggerVirtualResources::resources_initialize(controller.state.resources, DebuggerVirtualResources::ResourceMode.Recording)
    return Test::Failure::RESOURCE_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)
    return Test::Failure::SUCCESS
