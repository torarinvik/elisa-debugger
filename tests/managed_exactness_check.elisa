# Managed exactness must include every replayable side-effect boundary.

include "../src/engine/managed.elisa"

const module Test:
    const module Bounds:
        FIRST_INDEX: usize = 0
        ONE_COUNT: usize = 1
        TWO_COUNT: usize = 2

    const module Image:
        VERSION: u32 = 1
        INSTRUCTION_COUNT: u64 = 2
        LOCAL_COUNT: u64 = 0
        HAS_RETURN: bool = true
        FIRST_INSTRUCTION: usize = 0
        RETURN_INSTRUCTION: usize = 1
        CONSTANT_VALUE: i64 = 7
        UNUSED_OPERAND: i64 = 0

    const module Identity:
        SESSION_ID: u64 = 100
        RECORDING_ID: u64 = 101
        BUILD_COMPILER_ID: u64 = 102
        BUILD_RUNTIME_ID: u64 = 103
        BUILD_SOURCE_ID: u64 = 104
        BUILD_TARGET_ID: u64 = 105
        METADATA_VERSION: u32 = 1

    const module Effect:
        REQUEST_HASH: u64 = 2001
        RESULT_HASH: u64 = 2002
        RESULT_VALUE: i64 = 2003
        CALL_SITE_ID: u64 = 2004
        INVOCATION_ID: u64 = 2005

    const module Resource:
        PATH_ID: u64 = 3001
        GENERATION: u64 = 1
        INITIAL_BYTE: u8 = 31
        UPDATED_BYTE: u8 = 32
        BYTE_LENGTH: usize = 1

    const module Adapter:
        SOURCE_ID: u64 = 4001
        INVOCATION_ID: u64 = 4003
        CLOCK_VALUE: u64 = 4002

    const module ClockBridge:
        CALL_SITE_ID: u64 = 6101
        ADAPTER_SOURCE_ID: u64 = 6102
        INVOCATION_ID: u64 = 6103
        REQUEST_HASH: u64 = 6104
        MISMATCH_REQUEST_HASH: u64 = 6105
        RESULT_HASH: u64 = 6106
        RESULT_VALUE: i64 = 6107
        MISMATCH_ADAPTER_SOURCE_ID: u64 = 6108

    const module RandomBridge:
        CALL_SITE_ID: u64 = 7101
        ADAPTER_SOURCE_ID: u64 = 7102
        INVOCATION_ID: u64 = 7103
        REQUEST_HASH: u64 = 7104
        RESULT_HASH: u64 = 7105
        RANDOM_VALUE: u64 = 9223372036854775809
        MISMATCH_ADAPTER_SOURCE_ID: u64 = 7106

    const module EffectSource:
        FILE_ID: u64 = 8101
        LOGICAL_PATH_ID: u64 = 8102
        CONTENT_ID: u64 = 8103
        PATH_LENGTH: usize = 1
        PATH_BYTE: u8 = 120
        LINE_COUNT: u64 = 1
        START_BYTE: u64 = 1
        END_BYTE: u64 = 2
        LINE: u32 = 1
        START_COLUMN: u32 = 1
        END_COLUMN: u32 = 2
        DISCRIMINATOR: u32 = 0

    const module HistoryBarrier:
        FIRST_EVENT: usize = 1
        INITIAL_EVENT: usize = 0
        PREVIOUS_EVENT_OFFSET: usize = 1
        ROOT_TASK_ID: u64 = 0
        RESOURCE_PATH_ID: u64 = 5001
        RESOURCE_GENERATION: u64 = 1
        EFFECT_CALL_SITE_ID: u64 = 5002
        EFFECT_INVOCATION_ID: u64 = 5003
        EFFECT_REQUEST_HASH: u64 = 5004
        EFFECT_RESULT_HASH: u64 = 5005
        EFFECT_RESULT_VALUE: i64 = 5006
        ADAPTER_SOURCE_ID: u64 = 5007
        ADAPTER_INVOCATION_ID: u64 = 5009
        ADAPTER_VALUE: u64 = 5008
        RANDOM_SOURCE_ID: u64 = 5010
        RANDOM_INVOCATION_ID: u64 = 5011
        RANDOM_VALUE: u64 = 5012
        EFFECTS_KIND: u16 = 0
        RESOURCES_KIND: u16 = 1
        ADAPTERS_KIND: u16 = 2
        TASKS_KIND: u16 = 3
        RANDOM_KIND: u16 = 4
        SIDE_STATE_KIND_COUNT: u16 = 5

    const module Failure:
        SUCCESS: i64 = 0
        INITIAL_STATE_NOT_EXACT: i64 = 1
        BARRIER_NOT_DETECTED: i64 = 2
        EFFECT_RESET_NOT_EXACT: i64 = 3
        RESOURCE_OVERFLOW_SETUP: i64 = 4
        RESOURCE_OVERFLOW_NOT_DETECTED: i64 = 5
        RESOURCE_RESET_NOT_EXACT: i64 = 6
        MIXED_REPLAY_MODE_ACCEPTED: i64 = 7
        REPLAY_MODE_NOT_EXACT: i64 = 8
        BRANCH_MODE_NOT_EXACT: i64 = 9
        RECORDING_MODE_RESET_NOT_EXACT: i64 = 10
        REPLAY_RECORDING_SETUP: i64 = 11
        REPLAY_MODES_NOT_ALIGNED: i64 = 12
        RESOURCE_NOT_RESET_TO_INITIAL_IMAGE: i64 = 13
        EFFECT_REPLY_MISMATCH: i64 = 14
        ADAPTER_REPLY_MISMATCH: i64 = 15
        RESOURCE_REPLAY_MISMATCH: i64 = 16
        REPLAY_NOT_COMPLETE: i64 = 17
        REPLAY_RESET_NOT_EXACT: i64 = 18
        RECORDING_EFFECT_CURSOR_ACCEPTED: i64 = 19
        OVERFLOWED_REPLAY_NOT_ATOMIC: i64 = 20
        TIME_TRAVEL_BARRIER_NOT_DETECTED: i64 = 21
        CLOCK_BRIDGE_NOT_ATOMIC: i64 = 22
        RANDOM_BRIDGE_NOT_ATOMIC: i64 = 23
        ACTIVE_IDENTITY_BRIDGE_FAILED: i64 = 24

def managed_clock_effect_bridge_is_atomic() -> bool:
    state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(state)
    call_site: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ClockBridge::CALL_SITE_ID)
    adapter_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ClockBridge::ADAPTER_SOURCE_ID)
    invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ClockBridge::INVOCATION_ID)
    recorded: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_clock_effect(state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replayed: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH)
    return false if not replayed.accepted or replayed.result_hash != Test::ClockBridge::RESULT_HASH or replayed.result_value != Test::ClockBridge::RESULT_VALUE
    return false if state.effects.cursor != Test::Bounds::ONE_COUNT or state.adapters.clock.cursor != Test::Bounds::ONE_COUNT

    mismatch_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(mismatch_state)
    recorded <- DebuggerManagedState::state_record_clock_effect(mismatch_state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started <- DebuggerManagedState::state_begin_side_effect_replay(mismatch_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    mismatch: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(mismatch_state, call_site, adapter_source, invocation, Test::ClockBridge::MISMATCH_REQUEST_HASH)
    return false if mismatch.accepted or mismatch.failure.code != DebuggerErrors::ErrorCode.Diverged
    return false if mismatch_state.effects.cursor != Test::Bounds::FIRST_INDEX or mismatch_state.adapters.clock.cursor != Test::Bounds::FIRST_INDEX
    return false if mismatch_state.effects.exactness != DebuggerEffects::Exactness.Diverged or mismatch_state.adapters.clock.exact

    adapter_mismatch_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(adapter_mismatch_state)
    recorded <- DebuggerManagedState::state_record_clock_effect(adapter_mismatch_state, call_site, adapter_source, invocation, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started <- DebuggerManagedState::state_begin_side_effect_replay(adapter_mismatch_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    adapter_mismatch: DebuggerEffects::EffectReplay = DebuggerManagedState::state_replay_clock_effect(adapter_mismatch_state, call_site, DebuggerIdentity::debug_id(Test::ClockBridge::MISMATCH_ADAPTER_SOURCE_ID), invocation, Test::ClockBridge::REQUEST_HASH)
    return false if adapter_mismatch.accepted or adapter_mismatch.failure.code != DebuggerErrors::ErrorCode.Diverged
    return false if adapter_mismatch_state.effects.cursor != Test::Bounds::FIRST_INDEX or adapter_mismatch_state.adapters.clock.cursor != Test::Bounds::FIRST_INDEX
    return false if adapter_mismatch_state.effects.exactness != DebuggerEffects::Exactness.Diverged or adapter_mismatch_state.adapters.clock.exact
    return true

def managed_random_effect_bridge_is_atomic() -> bool:
    state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(state)
    call_site: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::RandomBridge::CALL_SITE_ID)
    adapter_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::RandomBridge::ADAPTER_SOURCE_ID)
    invocation: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::RandomBridge::INVOCATION_ID)
    recorded: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_record_random_effect(state, call_site, adapter_source, invocation, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started: mutable DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replayed: DebuggerEffects::RandomEffectReplay = DebuggerManagedState::state_replay_random_effect(state, call_site, adapter_source, invocation, Test::RandomBridge::REQUEST_HASH)
    return false if not replayed.accepted or replayed.result_hash != Test::RandomBridge::RESULT_HASH or replayed.value != Test::RandomBridge::RANDOM_VALUE
    return false if state.effects.cursor != Test::Bounds::ONE_COUNT or state.adapters.random.cursor != Test::Bounds::ONE_COUNT

    mismatch_state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(mismatch_state)
    recorded <- DebuggerManagedState::state_record_random_effect(mismatch_state, call_site, adapter_source, invocation, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded)
    replay_started <- DebuggerManagedState::state_begin_side_effect_replay(mismatch_state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    adapter_mismatch: DebuggerEffects::RandomEffectReplay = DebuggerManagedState::state_replay_random_effect(mismatch_state, call_site, DebuggerIdentity::debug_id(Test::RandomBridge::MISMATCH_ADAPTER_SOURCE_ID), invocation, Test::RandomBridge::REQUEST_HASH)
    return false if adapter_mismatch.accepted or adapter_mismatch.failure.code != DebuggerErrors::ErrorCode.Diverged
    return false if mismatch_state.effects.cursor != Test::Bounds::FIRST_INDEX or mismatch_state.adapters.random.cursor != Test::Bounds::FIRST_INDEX
    return false if mismatch_state.effects.exactness != DebuggerEffects::Exactness.Diverged or mismatch_state.adapters.random.exact
    return true

def managed_effect_bridges_use_active_identity(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    recorded_clock: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_clock_effect(controller, Test::ClockBridge::REQUEST_HASH, Test::ClockBridge::RESULT_HASH, Test::ClockBridge::RESULT_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded_clock)
    recorded_random: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_record_random_effect(controller, Test::RandomBridge::REQUEST_HASH, Test::RandomBridge::RESULT_HASH, Test::RandomBridge::RANDOM_VALUE)
    return false if not DebuggerErrors::error_is_ok(recorded_random)
    return false if controller.state.effects.count != Test::Bounds::TWO_COUNT or controller.state.adapters.clock.count != Test::Bounds::ONE_COUNT or controller.state.adapters.random.count != Test::Bounds::ONE_COUNT
    effect_site: u64 = controller.state.effects.records[Test::Bounds::FIRST_INDEX].call_site.value
    effect_invocation: u64 = controller.state.effects.records[Test::Bounds::FIRST_INDEX].invocation.value
    return false if effect_site == 0 or effect_invocation == 0
    return false if controller.state.effects.records[Test::Bounds::ONE_COUNT].call_site.value != effect_site or controller.state.effects.records[Test::Bounds::ONE_COUNT].invocation.value != effect_invocation
    return false if controller.state.adapters.clock.samples[Test::Bounds::FIRST_INDEX].source.value != effect_site or controller.state.adapters.clock.samples[Test::Bounds::FIRST_INDEX].invocation.value != effect_invocation
    return false if controller.state.adapters.random.samples[Test::Bounds::FIRST_INDEX].source.value != effect_site or controller.state.adapters.random.samples[Test::Bounds::FIRST_INDEX].invocation.value != effect_invocation

    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(controller.state)
    return false if not DebuggerErrors::error_is_ok(replay_started)
    replayed_clock: DebuggerEffects::EffectReplay = DebuggerManagedEngine::managed_replay_clock_effect(controller, Test::ClockBridge::REQUEST_HASH)
    return false if not replayed_clock.accepted or replayed_clock.result_value != Test::ClockBridge::RESULT_VALUE
    replayed_random: DebuggerEffects::RandomEffectReplay = DebuggerManagedEngine::managed_replay_random_effect(controller, Test::RandomBridge::REQUEST_HASH)
    return false if not replayed_random.accepted or replayed_random.value != Test::RandomBridge::RANDOM_VALUE
    return controller.state.effects.cursor == Test::Bounds::TWO_COUNT and controller.state.adapters.clock.cursor == Test::Bounds::ONE_COUNT and controller.state.adapters.random.cursor == Test::Bounds::ONE_COUNT

def managed_history_side_state_barriers_work(session: DebuggerSession::Session, image: DebuggerEDIR::ProgramImage&) -> bool:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    return false if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.event_count != Test::HistoryBarrier::FIRST_EVENT
    available: DebuggerTimeline::HistoryEligibility = DebuggerManagedEngine::managed_history_eligibility(controller)
    return false if not available.can_reverse or not available.can_seek or available.reason != DebuggerTimeline::HistoryEligibilityReason.Ready

    for state_kind in Test::Bounds::FIRST_INDEX.u16()..<Test::HistoryBarrier::SIDE_STATE_KIND_COUNT:
        DebuggerManagedState::state_initialize(controller.state)
        if state_kind == Test::HistoryBarrier::EFFECTS_KIND:
            DebuggerEffects::effect_oracle_record_in_invocation(controller.state.effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::HistoryBarrier::EFFECT_CALL_SITE_ID), DebuggerIdentity::debug_id(Test::HistoryBarrier::EFFECT_INVOCATION_ID), Test::HistoryBarrier::EFFECT_REQUEST_HASH, Test::HistoryBarrier::EFFECT_RESULT_HASH, Test::HistoryBarrier::EFFECT_RESULT_VALUE)
        if state_kind == Test::HistoryBarrier::RESOURCES_KIND:
            opened: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(controller.state.resources, DebuggerIdentity::debug_id(Test::HistoryBarrier::RESOURCE_PATH_ID), false, Test::HistoryBarrier::RESOURCE_GENERATION)
            return false if not opened.accepted
        if state_kind == Test::HistoryBarrier::ADAPTERS_KIND:
            failure: DebuggerErrors::DebuggerError = DebuggerReplayAdapters::clock_record_in_invocation(controller.state.adapters.clock, DebuggerIdentity::debug_id(Test::HistoryBarrier::ADAPTER_SOURCE_ID), DebuggerIdentity::debug_id(Test::HistoryBarrier::ADAPTER_INVOCATION_ID), Test::HistoryBarrier::ADAPTER_VALUE)
            return false if not DebuggerErrors::error_is_ok(failure)
        if state_kind == Test::HistoryBarrier::RANDOM_KIND:
            failure: DebuggerErrors::DebuggerError = DebuggerReplayAdapters::random_record_in_invocation(controller.state.adapters.random, DebuggerIdentity::debug_id(Test::HistoryBarrier::RANDOM_SOURCE_ID), DebuggerIdentity::debug_id(Test::HistoryBarrier::RANDOM_INVOCATION_ID), Test::HistoryBarrier::RANDOM_VALUE)
            return false if not DebuggerErrors::error_is_ok(failure)
        if state_kind == Test::HistoryBarrier::TASKS_KIND:
            task_id: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(controller.state.tasks, DebuggerIdentity::debug_id(Test::HistoryBarrier::ROOT_TASK_ID))
            return false if task_id.value == Test::HistoryBarrier::ROOT_TASK_ID

        blocked: DebuggerTimeline::HistoryEligibility = DebuggerManagedEngine::managed_history_eligibility(controller)
        return false if blocked.can_reverse or blocked.can_seek or blocked.reason != DebuggerTimeline::HistoryEligibilityReason.SideStateUnaligned

        event_before: usize = controller.engine.event_count
        machine_hash_before: u64 = DebuggerReplayEngine::replay_engine_state_hash(controller.engine)
        reverse_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step(controller)
        return false if reverse_failure.code != DebuggerErrors::ErrorCode.Unavailable or controller.engine.event_count != event_before or DebuggerReplayEngine::replay_engine_state_hash(controller.engine) != machine_hash_before
        seek_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(controller, Test::HistoryBarrier::INITIAL_EVENT)
        return false if seek_failure.code != DebuggerErrors::ErrorCode.Unavailable or controller.engine.event_count != event_before or DebuggerReplayEngine::replay_engine_state_hash(controller.engine) != machine_hash_before
    return true

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::Identity::BUILD_COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(Test::Identity::BUILD_RUNTIME_ID),
        source: DebuggerIdentity::debug_id(Test::Identity::BUILD_SOURCE_ID),
        target: DebuggerIdentity::debug_id(Test::Identity::BUILD_TARGET_ID),
        metadata_version: Test::Identity::METADATA_VERSION
    }
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::Identity::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::Image::VERSION, instruction_count: Test::Image::INSTRUCTION_COUNT, local_count: Test::Image::LOCAL_COUNT, has_return: Test::Image::HAS_RETURN}
    image.instructions[Test::Image::FIRST_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::Image::CONSTANT_VALUE, b: Test::Image::UNUSED_OPERAND, source: zeroed}
    image.instructions[Test::Image::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::Image::UNUSED_OPERAND, b: Test::Image::UNUSED_OPERAND, source: zeroed}
    image.source_file_count <- Test::Bounds::ONE_COUNT
    source_file: mutable DebuggerMetadata::SourceFile = zeroed
    source_file.id <- DebuggerIdentity::debug_id(Test::EffectSource::FILE_ID)
    source_file.logical_path <- DebuggerIdentity::debug_id(Test::EffectSource::LOGICAL_PATH_ID)
    source_file.content <- DebuggerIdentity::debug_id(Test::EffectSource::CONTENT_ID)
    source_file.line_count <- Test::EffectSource::LINE_COUNT
    source_file.path_bytes[Test::Bounds::FIRST_INDEX] <- Test::EffectSource::PATH_BYTE
    source_file.path_length <- Test::EffectSource::PATH_LENGTH
    image.source_files[Test::Bounds::FIRST_INDEX] <- source_file
    source_span: mutable DebuggerIdentity::SourceSpan = zeroed
    source_span.file <- DebuggerIdentity::debug_id(Test::EffectSource::FILE_ID)
    source_span.start_byte <- Test::EffectSource::START_BYTE
    source_span.end_byte <- Test::EffectSource::END_BYTE
    source_span.start_line <- Test::EffectSource::LINE
    source_span.start_column <- Test::EffectSource::START_COLUMN
    source_span.end_line <- Test::EffectSource::LINE
    source_span.end_column <- Test::EffectSource::END_COLUMN
    source_span.discriminator <- Test::EffectSource::DISCRIMINATOR
    image.instructions[Test::Image::FIRST_INSTRUCTION].source <- source_span
    image.instructions[Test::Image::RETURN_INSTRUCTION].source <- source_span
    return Test::Failure::ACTIVE_IDENTITY_BRIDGE_FAILED if not managed_effect_bridges_use_active_identity(session, image)
    return Test::Failure::CLOCK_BRIDGE_NOT_ATOMIC if not managed_clock_effect_bridge_is_atomic()
    return Test::Failure::RANDOM_BRIDGE_NOT_ATOMIC if not managed_random_effect_bridge_is_atomic()
    return Test::Failure::TIME_TRAVEL_BARRIER_NOT_DETECTED if not managed_history_side_state_barriers_work(session, image)
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::Identity::RECORDING_ID))
    return Test::Failure::INITIAL_STATE_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_record_in_invocation(controller.state.effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::Effect::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::Effect::INVOCATION_ID), Test::Effect::REQUEST_HASH, Test::Effect::RESULT_HASH, Test::Effect::RESULT_VALUE)
    controller.state.effects.cursor <- Test::Bounds::ONE_COUNT
    return Test::Failure::RECORDING_EFFECT_CURSOR_ACCEPTED if DebuggerManagedEngine::managed_is_exact(controller)
    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Recording)
    return Test::Failure::RECORDING_MODE_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Replaying)
    return Test::Failure::MIXED_REPLAY_MODE_ACCEPTED if DebuggerManagedEngine::managed_is_exact(controller)
    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Recording)
    return Test::Failure::RECORDING_MODE_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Replaying)
    replay_resources_failure: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_replay_restart(controller.state.resources)
    return Test::Failure::REPLAY_MODE_NOT_EXACT if not DebuggerErrors::error_is_ok(replay_resources_failure)
    DebuggerReplayAdapters::adapter_snapshot_initialize(controller.state.adapters, DebuggerReplayAdapters::AdapterMode.Replaying)
    return Test::Failure::REPLAY_MODE_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Virtualized)
    DebuggerVirtualResources::resources_initialize(controller.state.resources, DebuggerVirtualResources::ResourceMode.Branch)
    DebuggerReplayAdapters::adapter_snapshot_initialize(controller.state.adapters, DebuggerReplayAdapters::AdapterMode.Branch)
    return Test::Failure::BRANCH_MODE_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerManagedState::state_initialize(controller.state)
    return Test::Failure::RECORDING_MODE_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_record_in_invocation(controller.state.effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::Effect::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::Effect::INVOCATION_ID), Test::Effect::REQUEST_HASH, Test::Effect::RESULT_HASH, Test::Effect::RESULT_VALUE)
    adapter_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::Adapter::SOURCE_ID)
    return Test::Failure::REPLAY_RECORDING_SETUP if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record_in_invocation(controller.state.adapters.clock, adapter_source, DebuggerIdentity::debug_id(Test::Adapter::INVOCATION_ID), Test::Adapter::CLOCK_VALUE))
    initial_bytes: mutable u8[Test::Resource::BYTE_LENGTH] = [Test::Resource::INITIAL_BYTE]
    recorded_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(controller.state.resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
    return Test::Failure::REPLAY_RECORDING_SETUP if not recorded_open.accepted
    seeded: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seed(controller.state.resources, recorded_open.handle, initial_bytes[Test::Bounds::FIRST_INDEX], Test::Resource::BYTE_LENGTH)
    return Test::Failure::REPLAY_RECORDING_SETUP if not DebuggerErrors::error_is_ok(seeded)
    updated_bytes: mutable u8[Test::Resource::BYTE_LENGTH] = [Test::Resource::UPDATED_BYTE]
    recorded_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(controller.state.resources, recorded_open.handle, updated_bytes[Test::Bounds::FIRST_INDEX], Test::Resource::BYTE_LENGTH)
    return Test::Failure::REPLAY_RECORDING_SETUP if not DebuggerErrors::error_is_ok(recorded_write.failure) or recorded_write.transferred != Test::Resource::BYTE_LENGTH

    replay_started: DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(controller.state)
    return Test::Failure::REPLAY_MODES_NOT_ALIGNED if not DebuggerErrors::error_is_ok(replay_started)
    return Test::Failure::REPLAY_MODES_NOT_ALIGNED if controller.state.effects.mode != DebuggerEffects::EffectMode.Replaying or controller.state.resources.mode != DebuggerVirtualResources::ResourceMode.Replaying or controller.state.adapters.clock.mode != DebuggerReplayAdapters::AdapterMode.Replaying or controller.state.adapters.random.mode != DebuggerReplayAdapters::AdapterMode.Replaying or controller.state.adapters.console.mode != DebuggerReplayAdapters::AdapterMode.Replaying or not controller.state.adapters.console.output_suppressed
    return Test::Failure::RESOURCE_NOT_RESET_TO_INITIAL_IMAGE if controller.state.resources.files[Test::Bounds::FIRST_INDEX].bytes[Test::Bounds::FIRST_INDEX] != Test::Resource::INITIAL_BYTE or controller.state.resources.files[Test::Bounds::FIRST_INDEX].cursor != Test::Bounds::FIRST_INDEX
    effect_reply: DebuggerEffects::EffectReplay = DebuggerEffects::effect_oracle_replay_result_in_invocation(controller.state.effects, DebuggerEffects::EffectKind.Clock, DebuggerIdentity::debug_id(Test::Effect::CALL_SITE_ID), DebuggerIdentity::debug_id(Test::Effect::INVOCATION_ID), Test::Effect::REQUEST_HASH)
    return Test::Failure::EFFECT_REPLY_MISMATCH if not effect_reply.accepted or effect_reply.result_hash != Test::Effect::RESULT_HASH or effect_reply.result_value != Test::Effect::RESULT_VALUE
    clock_reply: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read_in_invocation(controller.state.adapters.clock, adapter_source, DebuggerIdentity::debug_id(Test::Adapter::INVOCATION_ID))
    return Test::Failure::ADAPTER_REPLY_MISMATCH if not clock_reply.accepted or clock_reply.value != Test::Adapter::CLOCK_VALUE
    replay_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(controller.state.resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
    replay_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(controller.state.resources, replay_open.handle, updated_bytes[Test::Bounds::FIRST_INDEX], Test::Resource::BYTE_LENGTH)
    return Test::Failure::RESOURCE_REPLAY_MISMATCH if not replay_open.accepted or not DebuggerErrors::error_is_ok(replay_write.failure) or replay_write.transferred != Test::Resource::BYTE_LENGTH or controller.state.resources.files[Test::Bounds::FIRST_INDEX].bytes[Test::Bounds::FIRST_INDEX] != Test::Resource::UPDATED_BYTE
    return Test::Failure::REPLAY_NOT_COMPLETE if not DebuggerEffects::effect_oracle_replay_complete(controller.state.effects) or not DebuggerVirtualResources::resources_replay_complete(controller.state.resources) or not DebuggerReplayAdapters::clock_is_exact(controller.state.adapters.clock) or not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerManagedState::state_initialize(controller.state)
    return Test::Failure::REPLAY_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    DebuggerEffects::effect_oracle_record(controller.state.effects, DebuggerEffects::EffectKind.FileRead, Test::Effect::REQUEST_HASH, Test::Effect::RESULT_HASH, Test::Effect::RESULT_VALUE)
    return Test::Failure::BARRIER_NOT_DETECTED if DebuggerManagedEngine::managed_is_exact(controller)
    DebuggerEffects::effect_oracle_initialize(controller.state.effects, DebuggerEffects::EffectMode.Recording)
    return Test::Failure::EFFECT_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)

    overflow_resources: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(overflow_resources, DebuggerVirtualResources::ResourceMode.Recording)
    first_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
    return Test::Failure::RESOURCE_OVERFLOW_SETUP if not first_open.accepted
    while overflow_resources.operation_count < DebuggerVirtualResources::Limits::MAX_OPERATIONS:
        fill_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
        return Test::Failure::RESOURCE_OVERFLOW_SETUP if not fill_open.accepted
    overflow_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_resources, DebuggerIdentity::debug_id(Test::Resource::PATH_ID), true, Test::Resource::GENERATION)
    return Test::Failure::RESOURCE_OVERFLOW_SETUP if overflow_open.accepted or not DebuggerVirtualResources::resources_is_valid(overflow_resources)
    controller.state.resources <- overflow_resources
    refused_replay: DebuggerErrors::DebuggerError = DebuggerManagedState::state_begin_side_effect_replay(controller.state)
    return Test::Failure::OVERFLOWED_REPLAY_NOT_ATOMIC if refused_replay.code != DebuggerErrors::ErrorCode.ResourceLimit or controller.state.effects.mode != DebuggerEffects::EffectMode.Recording or controller.state.resources.mode != DebuggerVirtualResources::ResourceMode.Recording or controller.state.adapters.clock.mode != DebuggerReplayAdapters::AdapterMode.Recording
    return Test::Failure::RESOURCE_OVERFLOW_NOT_DETECTED if DebuggerManagedEngine::managed_is_exact(controller)
    DebuggerVirtualResources::resources_initialize(controller.state.resources, DebuggerVirtualResources::ResourceMode.Recording)
    return Test::Failure::RESOURCE_RESET_NOT_EXACT if not DebuggerManagedEngine::managed_is_exact(controller)
    return Test::Failure::SUCCESS
