include "../src/inspect/managed.elisa"
include "../src/vm/edir.elisa"
include "../src/core/identity.elisa"

const module Test:
    PROGRAM_VERSION: u32 = 1
    LOCAL_COUNT: u64 = 2
    INSTRUCTION_COUNT: u64 = 4
    RUN_BUDGET: u64 = 8
    LOCAL_PAGE_SIZE: usize = 1
    EXPECTED_ACCUMULATOR: i64 = 7
    EXPECTED_GLOBAL: i64 = 9
    MAX_PROGRAM_COUNTER: u64 = 18446744073709551615


def main() -> i64:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::INSTRUCTION_COUNT, local_count: Test::LOCAL_COUNT, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::EXPECTED_ACCUMULATOR, b: 0, source: zeroed}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: 0, b: 0, source: zeroed}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.LoadLocal, a: 0, b: 0, source: zeroed}
    image.instructions[3] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    engine: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(1))
    DebuggerReplayEngine::replay_engine_run(engine, Test::RUN_BUDGET)
    engine.machine.globals[0] <- Test::EXPECTED_GLOBAL
    engine.machine.globals_initialized[0] <- true
    frame: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedInspection::current_frame(engine)
    return 1 if frame.id.value == 0 or frame.accumulator != Test::EXPECTED_ACCUMULATOR or not DebuggerManagedInspection::frame_is_current(frame, engine)
    overflow_frame_engine: mutable DebuggerReplayEngine::ReplayEngine = engine
    overflow_frame_engine.machine.program_counter <- Test::MAX_PROGRAM_COUNTER
    overflow_frame: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedInspection::current_frame(overflow_frame_engine)
    return 8 if overflow_frame.id.value == 0
    changed_engine: mutable DebuggerReplayEngine::ReplayEngine = engine
    changed_engine.machine.accumulator <- changed_engine.machine.accumulator + 1
    return 4 if DebuggerManagedInspection::frame_is_current(frame, changed_engine)
    forged_frame: DebuggerManagedInspection::FrameSnapshot = frame
    forged_frame.id <- DebuggerIdentity::debug_id(frame.id.value + 1)
    return 9 if DebuggerManagedInspection::frame_is_current(forged_frame, engine)
    page: DebuggerManagedInspection::LocalPage = DebuggerManagedInspection::locals_page(engine, 0, Test::LOCAL_PAGE_SIZE)
    first_entry: DebuggerManagedInspection::LocalSnapshot = page.entries[0]
    return 2 if page.count != Test::LOCAL_PAGE_SIZE or first_entry.value != Test::EXPECTED_ACCUMULATOR or page.next != 1 or page.complete
    second_page: DebuggerManagedInspection::LocalPage = DebuggerManagedInspection::locals_page(engine, 1, Test::LOCAL_PAGE_SIZE)
    second_entry: DebuggerManagedInspection::LocalSnapshot = second_page.entries[0]
    return 3 if second_entry.value != 0 or second_entry.available or not second_page.complete
    terminal_page: DebuggerManagedInspection::LocalPage = DebuggerManagedInspection::locals_page(engine, Test::LOCAL_COUNT.usize(), Test::LOCAL_PAGE_SIZE)
    return 5 if terminal_page.count != 0 or terminal_page.next != 0 or not terminal_page.complete
    globals: DebuggerManagedInspection::LocalPage = DebuggerManagedInspection::globals_page(engine, 0, Test::LOCAL_PAGE_SIZE)
    return 6 if globals.count != Test::LOCAL_PAGE_SIZE or globals.entries[0].value != Test::EXPECTED_GLOBAL or not globals.entries[0].available or globals.next != 1 or globals.complete
    globals_tail: DebuggerManagedInspection::LocalPage = DebuggerManagedInspection::globals_page(engine, 15, Test::LOCAL_PAGE_SIZE)
    return 7 if globals_tail.count != Test::LOCAL_PAGE_SIZE or globals_tail.next != 0 or not globals_tail.complete
    return 0
