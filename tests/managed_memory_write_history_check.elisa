include "../src/protocol/managed_service.elisa"
include "../src/core/identity.elisa"
include "../src/core/capabilities.elisa"
include "../src/core/cancellation.elisa"
include "../src/query/history.elisa"

const TEST_SUCCESS: i64 = 0
const RESULT_LAUNCH_FAILED: i64 = 1
const RESULT_CONTINUE_FAILED: i64 = 2
const RESULT_HISTORY_MISMATCH: i64 = 3
const RESULT_REVERSE_FAILED: i64 = 4
const RESULT_REWOUND_HISTORY_MISMATCH: i64 = 5
const RESULT_SEEK_FAILED: i64 = 6
const RESULT_SEEK_HISTORY_MISMATCH: i64 = 7
const RESULT_INVALID_SLOT_ACCEPTED: i64 = 8
const RESULT_OUT_OF_RANGE_ACCEPTED: i64 = 9
const RESULT_PROTOCOL_CAPABILITIES_ENABLED: i64 = 10

const TEST_SESSION_ID: u64 = 101
const TEST_RECORDING_ID: u64 = 102
const TEST_REQUEST_ID: u64 = 103
const TEST_COMPILER_ID: u64 = 201
const TEST_RUNTIME_ID: u64 = 202
const TEST_SOURCE_ID: u64 = 203
const TEST_TARGET_ID: u64 = 204
const TEST_SOURCE_FILE_ID: u64 = 205
const NO_EXPECTED_GENERATION: u64 = 0
const NO_DEADLINE: u64 = 0
const NO_INITIAL_EVENT: u64 = 0
const MEMORY_SLOT_ZERO: u64 = 0
const INVALID_MEMORY_SLOT: u64 = 64
const QUERY_MAX_RESULTS: u64 = 64
const QUERY_MAX_STEPS: u64 = 64
const QUERY_SOURCE_BYTE_WIDTH: u64 = 1
const SOURCE_START_COLUMN: u32 = 0
const SOURCE_END_COLUMN: u32 = 1
const BUILD_METADATA_VERSION: u32 = 1
const PROGRAM_VERSION: u32 = 1
const PROGRAM_INSTRUCTION_COUNT: u64 = 9
const PROGRAM_LOCAL_COUNT: u64 = 0
const ALLOCATION_SIZE_ONE: i64 = 1
const UNUSED_OPERAND: i64 = 0
const FIRST_STORED_VALUE: i64 = 11
const SECOND_STORED_VALUE: i64 = 22
const LAST_STORED_VALUE: i64 = 33
const FIRST_ALLOCATION_INDEX: usize = 0
const FIRST_CONSTANT_INDEX: usize = 1
const FIRST_STORE_INDEX: usize = 2
const SECOND_ALLOCATION_INDEX: usize = 3
const SECOND_CONSTANT_INDEX: usize = 4
const SECOND_STORE_INDEX: usize = 5
const LAST_CONSTANT_INDEX: usize = 6
const LAST_STORE_INDEX: usize = 7
const RETURN_INDEX: usize = 8
const FIRST_STORE_EVENT: u64 = 2
const SECOND_STORE_EVENT: u64 = 5
const LAST_STORE_EVENT: u64 = 7
const COMPLETE_EVENT_COUNT: u64 = 9
const EVENT_COUNT_AFTER_REWIND: u64 = 7
const EVENT_COUNT_BEFORE_RETURN: u64 = 3
const QUERY_BEFORE_LAST_STORE: u64 = 6
const QUERY_BEFORE_SECOND_ALLOCATION: u64 = 2
const FIRST_ALLOCATION_LINE: u32 = 10
const FIRST_CONSTANT_LINE: u32 = 11
const FIRST_STORE_LINE: u32 = 12
const SECOND_ALLOCATION_LINE: u32 = 20
const SECOND_CONSTANT_LINE: u32 = 21
const SECOND_STORE_LINE: u32 = 22
const LAST_CONSTANT_LINE: u32 = 30
const LAST_STORE_LINE: u32 = 31
const RETURN_LINE: u32 = 40
const EXPECTED_FULL_HISTORY_COUNT: usize = 2
const EXPECTED_REWOUND_HISTORY_COUNT: usize = 1
const FIRST_QUERY_MATCH: usize = 0
const SECOND_QUERY_MATCH: usize = 1

def test_source(line: u32) -> DebuggerIdentity::SourceSpan:
    return DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(TEST_SOURCE_FILE_ID),
        start_byte: line.u64(),
        end_byte: line.u64() + QUERY_SOURCE_BYTE_WIDTH,
        start_line: line,
        start_column: SOURCE_START_COLUMN,
        end_line: line,
        end_column: SOURCE_END_COLUMN,
        discriminator: SOURCE_START_COLUMN
    }

def test_instruction(opcode: DebuggerEDIR::Opcode, operand: i64, line: u32) -> DebuggerEDIR::Instruction:
    return DebuggerEDIR::Instruction{opcode: opcode, a: operand, b: UNUSED_OPERAND, source: test_source(line)}

def test_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: PROGRAM_INSTRUCTION_COUNT, local_count: PROGRAM_LOCAL_COUNT, has_return: true}
    image.instructions[FIRST_ALLOCATION_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Allocate, ALLOCATION_SIZE_ONE, FIRST_ALLOCATION_LINE)
    image.instructions[FIRST_CONSTANT_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Constant, FIRST_STORED_VALUE, FIRST_CONSTANT_LINE)
    image.instructions[FIRST_STORE_INDEX] <- test_instruction(DebuggerEDIR::Opcode.StoreMemory, MEMORY_SLOT_ZERO.i64(), FIRST_STORE_LINE)
    image.instructions[SECOND_ALLOCATION_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Allocate, ALLOCATION_SIZE_ONE, SECOND_ALLOCATION_LINE)
    image.instructions[SECOND_CONSTANT_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Constant, SECOND_STORED_VALUE, SECOND_CONSTANT_LINE)
    image.instructions[SECOND_STORE_INDEX] <- test_instruction(DebuggerEDIR::Opcode.StoreMemory, MEMORY_SLOT_ZERO + ALLOCATION_SIZE_ONE.u64(), SECOND_STORE_LINE)
    image.instructions[LAST_CONSTANT_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Constant, LAST_STORED_VALUE, LAST_CONSTANT_LINE)
    image.instructions[LAST_STORE_INDEX] <- test_instruction(DebuggerEDIR::Opcode.StoreMemory, MEMORY_SLOT_ZERO.i64(), LAST_STORE_LINE)
    image.instructions[RETURN_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Return, UNUSED_OPERAND, RETURN_LINE)
    return image

def test_request(method: DebuggerProtocolRequest::RequestMethod, target_event: u64) -> DebuggerProtocolRequest::Request:
    return DebuggerProtocolRequest::Request{method: method, id: TEST_REQUEST_ID, has_id: true, expected_generation: NO_EXPECTED_GENERATION, target_event: target_event, valid: true}

def test_query_window(last_event: u64) -> DebuggerHistory::QueryWindow:
    return DebuggerHistory::QueryWindow{first_event: NO_INITIAL_EVENT, last_event: last_event, max_results: QUERY_MAX_RESULTS, max_steps: QUERY_MAX_STEPS}

def test_history(service: mutable DebuggerManagedService::Service&, last_event: u64) -> DebuggerQueryEngine::QueryExecution:
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(NO_DEADLINE)
    return DebuggerManagedService::service_memory_write_history(service, MEMORY_SLOT_ZERO, test_query_window(last_event), token)

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(TEST_COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(TEST_RUNTIME_ID),
        source: DebuggerIdentity::debug_id(TEST_SOURCE_ID),
        target: DebuggerIdentity::debug_id(TEST_TARGET_ID),
        metadata_version: BUILD_METADATA_VERSION
    }
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(TEST_SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, test_image(), DebuggerIdentity::debug_id(TEST_RECORDING_ID))
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.Launch, NO_INITIAL_EVENT))
    return RESULT_LAUNCH_FAILED if not launched.accepted
    continued: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.Continue, NO_INITIAL_EVENT))
    return RESULT_CONTINUE_FAILED if not continued.accepted or service.controller.engine.event_count.u64() != COMPLETE_EVENT_COUNT

    full_history: DebuggerQueryEngine::QueryExecution = test_history(service, LAST_STORE_EVENT + ALLOCATION_SIZE_ONE.u64())
    return RESULT_HISTORY_MISMATCH if not full_history.complete or full_history.count != EXPECTED_FULL_HISTORY_COUNT
    return RESULT_HISTORY_MISMATCH if full_history.matches[FIRST_QUERY_MATCH].event != FIRST_STORE_EVENT or full_history.matches[FIRST_QUERY_MATCH].mutation.value_hash != FIRST_STORED_VALUE.u64() or full_history.matches[FIRST_QUERY_MATCH].mutation.source.start_line != FIRST_STORE_LINE
    return RESULT_HISTORY_MISMATCH if full_history.matches[SECOND_QUERY_MATCH].event != LAST_STORE_EVENT or full_history.matches[SECOND_QUERY_MATCH].mutation.value_hash != LAST_STORED_VALUE.u64() or full_history.matches[SECOND_QUERY_MATCH].mutation.source.start_line != LAST_STORE_LINE
    return RESULT_PROTOCOL_CAPABILITIES_ENABLED if service.controller.session.capabilities.provenance or service.controller.session.capabilities.historical_queries

    reversed_once: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.ReverseStep, NO_INITIAL_EVENT))
    reversed_twice: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.ReverseStep, NO_INITIAL_EVENT))
    return RESULT_REVERSE_FAILED if not reversed_once.accepted or not reversed_twice.accepted or service.controller.engine.event_count.u64() != EVENT_COUNT_AFTER_REWIND
    rewound_history: DebuggerQueryEngine::QueryExecution = test_history(service, QUERY_BEFORE_LAST_STORE)
    return RESULT_REWOUND_HISTORY_MISMATCH if not rewound_history.complete or rewound_history.count != EXPECTED_REWOUND_HISTORY_COUNT or rewound_history.matches[FIRST_QUERY_MATCH].event != FIRST_STORE_EVENT

    sought_full: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.Seek, COMPLETE_EVENT_COUNT))
    return RESULT_SEEK_FAILED if not sought_full.accepted or service.controller.engine.event_count.u64() != COMPLETE_EVENT_COUNT
    sought_history: DebuggerQueryEngine::QueryExecution = test_history(service, LAST_STORE_EVENT + ALLOCATION_SIZE_ONE.u64())
    return RESULT_SEEK_HISTORY_MISMATCH if not sought_history.complete or sought_history.count != EXPECTED_FULL_HISTORY_COUNT or sought_history.matches[SECOND_QUERY_MATCH].event != LAST_STORE_EVENT

    sought_prefix: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.Seek, EVENT_COUNT_BEFORE_RETURN))
    return RESULT_SEEK_FAILED if not sought_prefix.accepted or service.controller.engine.event_count.u64() != EVENT_COUNT_BEFORE_RETURN
    prefix_history: DebuggerQueryEngine::QueryExecution = test_history(service, QUERY_BEFORE_SECOND_ALLOCATION)
    return RESULT_SEEK_HISTORY_MISMATCH if not prefix_history.complete or prefix_history.count != EXPECTED_REWOUND_HISTORY_COUNT or prefix_history.matches[FIRST_QUERY_MATCH].event != FIRST_STORE_EVENT
    out_of_range: DebuggerQueryEngine::QueryExecution = test_history(service, EVENT_COUNT_BEFORE_RETURN)
    return RESULT_OUT_OF_RANGE_ACCEPTED if out_of_range.failure.code != DebuggerErrors::ErrorCode.InvalidArgument

    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(NO_DEADLINE)
    invalid_slot: DebuggerQueryEngine::QueryExecution = DebuggerManagedService::service_memory_write_history(service, INVALID_MEMORY_SLOT, test_query_window(QUERY_BEFORE_SECOND_ALLOCATION), token)
    return RESULT_INVALID_SLOT_ACCEPTED if invalid_slot.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    return TEST_SUCCESS
