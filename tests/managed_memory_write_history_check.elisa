include "../src/protocol/managed_service.elisa"
include "../src/core/identity.elisa"
include "../src/core/capabilities.elisa"
include "../src/core/cancellation.elisa"
include "../src/query/history.elisa"

const module Test:
    SUCCESS: i64 = 0
    RESULT_LAUNCH_FAILED: i64 = 1
    RESULT_CONTINUE_FAILED: i64 = 2
    RESULT_HISTORY_MISMATCH: i64 = 3
    RESULT_REVERSE_FAILED: i64 = 4
    RESULT_REWOUND_HISTORY_MISMATCH: i64 = 5
    RESULT_SEEK_FAILED: i64 = 6
    RESULT_SEEK_HISTORY_MISMATCH: i64 = 7
    RESULT_INVALID_SLOT_ACCEPTED: i64 = 8
    RESULT_OUT_OF_RANGE_ACCEPTED: i64 = 9
    RESULT_PROTOCOL_CAPABILITIES_ENABLED: i64 = 10
    SESSION_ID: u64 = 101
    RECORDING_ID: u64 = 102
    REQUEST_ID: u64 = 103
    COMPILER_ID: u64 = 201
    RUNTIME_ID: u64 = 202
    SOURCE_ID: u64 = 203
    TARGET_ID: u64 = 204
    SOURCE_FILE_ID: u64 = 205
    NO_EXPECTED_GENERATION: u64 = 0
    NO_DEADLINE: u64 = 0
    NO_INITIAL_EVENT: u64 = 0
    MEMORY_SLOT_ZERO: u64 = 0
    INVALID_MEMORY_SLOT: u64 = 64
    QUERY_MAX_RESULTS: u64 = 64
    QUERY_MAX_STEPS: u64 = 64
    QUERY_SOURCE_BYTE_WIDTH: u64 = 1
    SOURCE_START_COLUMN: u32 = 0
    SOURCE_END_COLUMN: u32 = 1
    BUILD_METADATA_VERSION: u32 = 1
    PROGRAM_VERSION: u32 = 1
    PROGRAM_INSTRUCTION_COUNT: u64 = 9
    PROGRAM_LOCAL_COUNT: u64 = 0
    ALLOCATION_SIZE_ONE: i64 = 1
    UNUSED_OPERAND: i64 = 0
    FIRST_STORED_VALUE: i64 = 11
    SECOND_STORED_VALUE: i64 = 22
    LAST_STORED_VALUE: i64 = 33
    FIRST_ALLOCATION_INDEX: usize = 0
    FIRST_CONSTANT_INDEX: usize = 1
    FIRST_STORE_INDEX: usize = 2
    SECOND_ALLOCATION_INDEX: usize = 3
    SECOND_CONSTANT_INDEX: usize = 4
    SECOND_STORE_INDEX: usize = 5
    LAST_CONSTANT_INDEX: usize = 6
    LAST_STORE_INDEX: usize = 7
    RETURN_INDEX: usize = 8
    FIRST_STORE_EVENT: u64 = 2
    SECOND_STORE_EVENT: u64 = 5
    LAST_STORE_EVENT: u64 = 7
    COMPLETE_EVENT_COUNT: u64 = 9
    EVENT_COUNT_AFTER_REWIND: u64 = 7
    EVENT_COUNT_BEFORE_RETURN: u64 = 3
    QUERY_BEFORE_LAST_STORE: u64 = 6
    QUERY_BEFORE_SECOND_ALLOCATION: u64 = 2
    FIRST_ALLOCATION_LINE: u32 = 10
    FIRST_CONSTANT_LINE: u32 = 11
    FIRST_STORE_LINE: u32 = 12
    SECOND_ALLOCATION_LINE: u32 = 20
    SECOND_CONSTANT_LINE: u32 = 21
    SECOND_STORE_LINE: u32 = 22
    LAST_CONSTANT_LINE: u32 = 30
    LAST_STORE_LINE: u32 = 31
    RETURN_LINE: u32 = 40
    EXPECTED_FULL_HISTORY_COUNT: usize = 2
    EXPECTED_REWOUND_HISTORY_COUNT: usize = 1
    FIRST_QUERY_MATCH: usize = 0
    SECOND_QUERY_MATCH: usize = 1



def test_source(line: u32) -> DebuggerIdentity::SourceSpan:
    return DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(Test::SOURCE_FILE_ID),
        start_byte: line.u64(),
        end_byte: line.u64() + Test::QUERY_SOURCE_BYTE_WIDTH,
        start_line: line,
        start_column: Test::SOURCE_START_COLUMN,
        end_line: line,
        end_column: Test::SOURCE_END_COLUMN,
        discriminator: Test::SOURCE_START_COLUMN
    }

def test_instruction(opcode: DebuggerEDIR::Opcode, operand: i64, line: u32) -> DebuggerEDIR::Instruction:
    return DebuggerEDIR::Instruction{opcode: opcode, a: operand, b: Test::UNUSED_OPERAND, source: test_source(line)}

def test_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::PROGRAM_INSTRUCTION_COUNT, local_count: Test::PROGRAM_LOCAL_COUNT, has_return: true}
    image.instructions[Test::FIRST_ALLOCATION_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Allocate, Test::ALLOCATION_SIZE_ONE, Test::FIRST_ALLOCATION_LINE)
    image.instructions[Test::FIRST_CONSTANT_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Constant, Test::FIRST_STORED_VALUE, Test::FIRST_CONSTANT_LINE)
    image.instructions[Test::FIRST_STORE_INDEX] <- test_instruction(DebuggerEDIR::Opcode.StoreMemory, Test::MEMORY_SLOT_ZERO.i64(), Test::FIRST_STORE_LINE)
    image.instructions[Test::SECOND_ALLOCATION_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Allocate, Test::ALLOCATION_SIZE_ONE, Test::SECOND_ALLOCATION_LINE)
    image.instructions[Test::SECOND_CONSTANT_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Constant, Test::SECOND_STORED_VALUE, Test::SECOND_CONSTANT_LINE)
    image.instructions[Test::SECOND_STORE_INDEX] <- test_instruction(DebuggerEDIR::Opcode.StoreMemory, Test::MEMORY_SLOT_ZERO + Test::ALLOCATION_SIZE_ONE.u64(), Test::SECOND_STORE_LINE)
    image.instructions[Test::LAST_CONSTANT_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Constant, Test::LAST_STORED_VALUE, Test::LAST_CONSTANT_LINE)
    image.instructions[Test::LAST_STORE_INDEX] <- test_instruction(DebuggerEDIR::Opcode.StoreMemory, Test::MEMORY_SLOT_ZERO.i64(), Test::LAST_STORE_LINE)
    image.instructions[Test::RETURN_INDEX] <- test_instruction(DebuggerEDIR::Opcode.Return, Test::UNUSED_OPERAND, Test::RETURN_LINE)
    return image

def test_request(method: DebuggerProtocolRequest::RequestMethod, target_event: u64) -> DebuggerProtocolRequest::Request:
    return DebuggerProtocolRequest::Request{method: method, id: Test::REQUEST_ID, has_id: true, expected_generation: Test::NO_EXPECTED_GENERATION, target_event: target_event, valid: true}

def test_query_window(last_event: u64) -> DebuggerHistory::QueryWindow:
    return DebuggerHistory::QueryWindow{first_event: Test::NO_INITIAL_EVENT, last_event: last_event, max_results: Test::QUERY_MAX_RESULTS, max_steps: Test::QUERY_MAX_STEPS}

def test_history(service: mutable DebuggerManagedService::Service&, last_event: u64) -> DebuggerQueryEngine::QueryExecution:
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(Test::NO_DEADLINE)
    return DebuggerManagedService::service_memory_write_history(service, Test::MEMORY_SLOT_ZERO, test_query_window(last_event), token)

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(Test::RUNTIME_ID),
        source: DebuggerIdentity::debug_id(Test::SOURCE_ID),
        target: DebuggerIdentity::debug_id(Test::TARGET_ID),
        metadata_version: Test::BUILD_METADATA_VERSION
    }
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, test_image(), DebuggerIdentity::debug_id(Test::RECORDING_ID))
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.Launch, Test::NO_INITIAL_EVENT))
    return Test::RESULT_LAUNCH_FAILED if not launched.accepted
    continued: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.Continue, Test::NO_INITIAL_EVENT))
    return Test::RESULT_CONTINUE_FAILED if not continued.accepted or service.controller.engine.event_count.u64() != Test::COMPLETE_EVENT_COUNT

    full_history: DebuggerQueryEngine::QueryExecution = test_history(service, Test::LAST_STORE_EVENT + Test::ALLOCATION_SIZE_ONE.u64())
    return Test::RESULT_HISTORY_MISMATCH if not full_history.complete or full_history.count != Test::EXPECTED_FULL_HISTORY_COUNT
    return Test::RESULT_HISTORY_MISMATCH if full_history.matches[Test::FIRST_QUERY_MATCH].event != Test::FIRST_STORE_EVENT or full_history.matches[Test::FIRST_QUERY_MATCH].mutation.value_hash != Test::FIRST_STORED_VALUE.u64() or full_history.matches[Test::FIRST_QUERY_MATCH].mutation.source.start_line != Test::FIRST_STORE_LINE
    return Test::RESULT_HISTORY_MISMATCH if full_history.matches[Test::SECOND_QUERY_MATCH].event != Test::LAST_STORE_EVENT or full_history.matches[Test::SECOND_QUERY_MATCH].mutation.value_hash != Test::LAST_STORED_VALUE.u64() or full_history.matches[Test::SECOND_QUERY_MATCH].mutation.source.start_line != Test::LAST_STORE_LINE
    return Test::RESULT_PROTOCOL_CAPABILITIES_ENABLED if service.controller.session.capabilities.provenance or service.controller.session.capabilities.historical_queries

    reversed_once: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.ReverseStep, Test::NO_INITIAL_EVENT))
    reversed_twice: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.ReverseStep, Test::NO_INITIAL_EVENT))
    return Test::RESULT_REVERSE_FAILED if not reversed_once.accepted or not reversed_twice.accepted or service.controller.engine.event_count.u64() != Test::EVENT_COUNT_AFTER_REWIND
    rewound_history: DebuggerQueryEngine::QueryExecution = test_history(service, Test::QUERY_BEFORE_LAST_STORE)
    return Test::RESULT_REWOUND_HISTORY_MISMATCH if not rewound_history.complete or rewound_history.count != Test::EXPECTED_REWOUND_HISTORY_COUNT or rewound_history.matches[Test::FIRST_QUERY_MATCH].event != Test::FIRST_STORE_EVENT

    sought_full: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.Seek, Test::COMPLETE_EVENT_COUNT))
    return Test::RESULT_SEEK_FAILED if not sought_full.accepted or service.controller.engine.event_count.u64() != Test::COMPLETE_EVENT_COUNT
    sought_history: DebuggerQueryEngine::QueryExecution = test_history(service, Test::LAST_STORE_EVENT + Test::ALLOCATION_SIZE_ONE.u64())
    return Test::RESULT_SEEK_HISTORY_MISMATCH if not sought_history.complete or sought_history.count != Test::EXPECTED_FULL_HISTORY_COUNT or sought_history.matches[Test::SECOND_QUERY_MATCH].event != Test::LAST_STORE_EVENT

    sought_prefix: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, test_request(DebuggerProtocolRequest::RequestMethod.Seek, Test::EVENT_COUNT_BEFORE_RETURN))
    return Test::RESULT_SEEK_FAILED if not sought_prefix.accepted or service.controller.engine.event_count.u64() != Test::EVENT_COUNT_BEFORE_RETURN
    prefix_history: DebuggerQueryEngine::QueryExecution = test_history(service, Test::QUERY_BEFORE_SECOND_ALLOCATION)
    return Test::RESULT_SEEK_HISTORY_MISMATCH if not prefix_history.complete or prefix_history.count != Test::EXPECTED_REWOUND_HISTORY_COUNT or prefix_history.matches[Test::FIRST_QUERY_MATCH].event != Test::FIRST_STORE_EVENT
    out_of_range: DebuggerQueryEngine::QueryExecution = test_history(service, Test::EVENT_COUNT_BEFORE_RETURN)
    return Test::RESULT_OUT_OF_RANGE_ACCEPTED if out_of_range.failure.code != DebuggerErrors::ErrorCode.InvalidArgument

    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(Test::NO_DEADLINE)
    invalid_slot: DebuggerQueryEngine::QueryExecution = DebuggerManagedService::service_memory_write_history(service, Test::INVALID_MEMORY_SLOT, test_query_window(Test::QUERY_BEFORE_SECOND_ALLOCATION), token)
    return Test::RESULT_INVALID_SLOT_ACCEPTED if invalid_slot.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    return Test::SUCCESS
