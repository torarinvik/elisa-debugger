include "../src/protocol/managed_service.elisa"
include "../src/core/identity.elisa"
include "../src/core/capabilities.elisa"

const PROGRAM_VERSION: u32 = 1
const INSTRUCTION_COUNT: u64 = 2
const STEP_REQUEST_ID: u64 = 1
const NO_EXPECTED_GENERATION: u64 = 0
const NO_TARGET_EVENT: u64 = 0
const TARGET_EVENT: u64 = 1
const EXPECTED_RESULT: i64 = 7
const MEMORY_REQUEST_ID: u64 = 2
const MAX_U64_VALUE: u64 = 18446744073709551615
const INVALID_SEEK_RESULT: i64 = 17
const FULL_CHECKPOINT_RESULT_FAILURE: i64 = 19
const FULL_CHECKPOINT_TAMPER_RESULT: i64 = 21
const FULL_CHECKPOINT_ROLLBACK_RESULT: i64 = 25
const BRANCH_RESULT_FAILURE: i64 = 20
const NON_INSPECT_TRACE_RESULT: i64 = 23
const INSPECTION_CAPABILITY_RESULT: i64 = 24
const FORGED_CHECKPOINT_RESULT: i64 = 37
const FORGED_CHECKPOINT_DELTA: i64 = 10
const BREAKPOINT_FILE_ID: u64 = 44
const BREAKPOINT_LINE: u32 = 2
const SOURCE_BREAKPOINT_SET_COUNT: usize = 2
const UNRESOLVED_BREAKPOINT_LINE: u32 = BREAKPOINT_LINE + 1
const BOOKMARK_LABEL_ID: u64 = 700
const BOOKMARK_NOTE_ID: u64 = 701
const MANAGED_REGRESSION_BUILD_COMPILER_ID: u64 = 801
const MANAGED_REGRESSION_BUILD_RUNTIME_ID: u64 = 802
const MANAGED_REGRESSION_BUILD_SOURCE_ID: u64 = 803
const MANAGED_REGRESSION_BUILD_TARGET_ID: u64 = 804
const MANAGED_REGRESSION_SESSION_ID: u64 = 805
const MANAGED_REGRESSION_RECORDING_ID: u64 = 806
const MANAGED_REGRESSION_PROGRAM_VERSION: u32 = 1
const MANAGED_REGRESSION_NO_LOCALS: u64 = 0
const MANAGED_REGRESSION_NO_OPERAND: i64 = 0
const MANAGED_REGRESSION_SOURCE_FILE_ID: u64 = 807
const MANAGED_REGRESSION_SOURCE_SPAN_WIDTH: u64 = 1
const MANAGED_REGRESSION_SOURCE_COLUMN: u32 = 1
const MANAGED_REGRESSION_SOURCE_END_COLUMN: u32 = 2
const MANAGED_REGRESSION_NEXT_SOURCE_LINE: u32 = 10
const MANAGED_REGRESSION_LATER_SOURCE_LINE: u32 = 11
const MANAGED_REGRESSION_CALLER_SOURCE_LINE: u32 = 12
const MANAGED_REGRESSION_CALLEE_SOURCE_LINE: u32 = 13
const MANAGED_REGRESSION_CALLEE_RETURN_LINE: u32 = 14
const MANAGED_REGRESSION_PARENT_BREAKPOINT_LINE: u32 = 15
const MANAGED_REGRESSION_PARENT_RETURN_LINE: u32 = 16
const MANAGED_REGRESSION_SOURCE_STEP_INSTRUCTION_COUNT: u64 = 4
const MANAGED_REGRESSION_CALL_INSTRUCTION_COUNT: u64 = 5
const MANAGED_REGRESSION_CALL_TARGET: i64 = 3
const MANAGED_REGRESSION_NEXT_INSTRUCTION: usize = 2
const MANAGED_REGRESSION_INITIAL_INSTRUCTION: usize = NO_TARGET_EVENT.usize()
const MANAGED_REGRESSION_CALLER_RESUME_INSTRUCTION: usize = 1
const MANAGED_REGRESSION_CALLEE_INSTRUCTION: usize = 3
const MANAGED_REGRESSION_RETURN_INSTRUCTION: usize = 4
const MANAGED_STEP_OUT_DESTINATION_EXPECTED_EVENTS: usize = 3
const MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS: u64 = 8
const MANAGED_SOURCE_STEP_CHECK_RESULT: i64 = 50
const MANAGED_COMPOUND_BREAKPOINT_CHECK_RESULT: i64 = 51
const MANAGED_PARENT_BREAKPOINT_CHECK_RESULT: i64 = 52
const MANAGED_CHECKPOINT_SIDE_STATE_CHECK_RESULT: i64 = 53
const MANAGED_CHECKPOINT_RESOURCE_PATH_ID: u64 = 808
const MANAGED_CHECKPOINT_RESOURCE_GENERATION: u64 = 1
const MANAGED_CHECKPOINT_RESOURCE_LENGTH: usize = 1
const MANAGED_CHECKPOINT_RESOURCE_BYTE: u8 = 41
const MANAGED_CHECKPOINT_MUTATED_RESOURCE_BYTE: u8 = 42
const MANAGED_HISTORY_LIMIT_CHECK_RESULT: i64 = 54
const MANAGED_HISTORY_LIMIT_NO_OPERAND: i64 = 0
const MANAGED_HISTORY_LIMIT_EXTRA_INSTRUCTIONS: usize = 1
const TRACE_LIFECYCLE_UNSUPPORTED_RESULT: i64 = 38
const MANAGED_TOP_LEVEL_STEP_OUT_CHECK_RESULT: i64 = 55
const MANAGED_THREAD_BEFORE_LAUNCH_RESULT: i64 = 56
const MANAGED_THREAD_RUNNING_RESULT: i64 = 57
const MANAGED_STEP_OVER_DESTINATION_BREAKPOINT_RESULT: i64 = 58
const MANAGED_STEP_OUT_DESTINATION_BREAKPOINT_RESULT: i64 = 59
const MANAGED_SOURCE_BREAKPOINT_RESUME_RESULT: i64 = 60
const MANAGED_SOURCE_BREAKPOINT_EXPECTED_HITS: u64 = 1
const MANAGED_SOURCE_BREAKPOINT_NO_ID: i64 = 1
const MANAGED_SOURCE_BREAKPOINT_FIRST_CONTINUE: i64 = 2
const MANAGED_SOURCE_BREAKPOINT_SECOND_CONTINUE: i64 = 3
const MANAGED_SOURCE_BREAKPOINT_REVERSE_CONTINUE: i64 = 4
const MANAGED_SOURCE_BREAKPOINT_EXPECTED_EVENT: usize = NO_TARGET_EVENT.usize()

def managed_regression_source_span(line: u32, start_byte: u64) -> DebuggerIdentity::SourceSpan:
    return DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(MANAGED_REGRESSION_SOURCE_FILE_ID), start_byte: start_byte, end_byte: start_byte + MANAGED_REGRESSION_SOURCE_SPAN_WIDTH, start_line: line, start_column: MANAGED_REGRESSION_SOURCE_COLUMN, end_line: line, end_column: MANAGED_REGRESSION_SOURCE_END_COLUMN, discriminator: 0}

def managed_regression_controller(image: DebuggerEDIR::ProgramImage) -> DebuggerManagedEngine::ManagedController:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(MANAGED_REGRESSION_BUILD_COMPILER_ID), runtime: DebuggerIdentity::debug_id(MANAGED_REGRESSION_BUILD_RUNTIME_ID), source: DebuggerIdentity::debug_id(MANAGED_REGRESSION_BUILD_SOURCE_ID), target: DebuggerIdentity::debug_id(MANAGED_REGRESSION_BUILD_TARGET_ID), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(MANAGED_REGRESSION_SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    return DebuggerManagedEngine::managed_new(session, image, DebuggerIdentity::debug_id(MANAGED_REGRESSION_RECORDING_ID))

def managed_source_step_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: MANAGED_REGRESSION_SOURCE_STEP_INSTRUCTION_COUNT, local_count: MANAGED_REGRESSION_NO_LOCALS, has_return: true}
    first_source: DebuggerIdentity::SourceSpan = managed_regression_source_span(MANAGED_REGRESSION_NEXT_SOURCE_LINE, 1)
    later_source: DebuggerIdentity::SourceSpan = managed_regression_source_span(MANAGED_REGRESSION_LATER_SOURCE_LINE, 2)
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: EXPECTED_RESULT, b: MANAGED_REGRESSION_NO_OPERAND, source: first_source}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: MANAGED_REGRESSION_NO_OPERAND, b: MANAGED_REGRESSION_NO_OPERAND, source: first_source}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: MANAGED_REGRESSION_NO_OPERAND, b: MANAGED_REGRESSION_NO_OPERAND, source: later_source}
    image.instructions[3] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: MANAGED_REGRESSION_NO_OPERAND, b: MANAGED_REGRESSION_NO_OPERAND, source: later_source}
    return image

def managed_call_breakpoint_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: MANAGED_REGRESSION_CALL_INSTRUCTION_COUNT, local_count: MANAGED_REGRESSION_NO_LOCALS, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Call, a: MANAGED_REGRESSION_CALL_TARGET, b: MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(MANAGED_REGRESSION_CALLER_SOURCE_LINE, 1)}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: MANAGED_REGRESSION_NO_OPERAND, b: MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(MANAGED_REGRESSION_LATER_SOURCE_LINE, 2)}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: MANAGED_REGRESSION_NO_OPERAND, b: MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(MANAGED_REGRESSION_LATER_SOURCE_LINE, 3)}
    image.instructions[MANAGED_REGRESSION_CALLEE_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: MANAGED_REGRESSION_NO_OPERAND, b: MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(MANAGED_REGRESSION_CALLEE_SOURCE_LINE, 4)}
    image.instructions[MANAGED_REGRESSION_RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: MANAGED_REGRESSION_NO_OPERAND, b: MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(MANAGED_REGRESSION_CALLEE_RETURN_LINE, 5)}
    return image

def check_managed_source_step_over() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(managed_source_step_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_over(controller)
    return 3 if not DebuggerErrors::error_is_ok(failure) or controller.engine.event_count != MANAGED_REGRESSION_NEXT_INSTRUCTION or controller.engine.machine.program_counter != MANAGED_REGRESSION_NEXT_INSTRUCTION.u64()
    return 0

def check_managed_step_over_destination_breakpoint() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(managed_source_step_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(MANAGED_REGRESSION_SOURCE_FILE_ID), line: MANAGED_REGRESSION_LATER_SOURCE_LINE, column: MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return 2 if breakpoint.value == 0 or controller.state.breakpoints.points[0].status != DebuggerBreakpoints::BreakpointStatus.Verified
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_over(controller)
    return 3 if not DebuggerErrors::error_is_ok(failure) or controller.engine.event_count != MANAGED_REGRESSION_NEXT_INSTRUCTION.u64() or controller.engine.machine.program_counter != MANAGED_REGRESSION_NEXT_INSTRUCTION.u64()
    return 4 if controller.state.breakpoints.points[0].hit_count != 1
    return 0

def check_managed_step_out_destination_breakpoint() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(managed_call_breakpoint_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.machine.return_stack_pointer == 0
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(MANAGED_REGRESSION_SOURCE_FILE_ID), line: MANAGED_REGRESSION_LATER_SOURCE_LINE, column: MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return 3 if breakpoint.value == 0 or controller.state.breakpoints.points[0].status != DebuggerBreakpoints::BreakpointStatus.Verified
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_out(controller)
    return 4 if not DebuggerErrors::error_is_ok(failure) or controller.engine.event_count != MANAGED_STEP_OUT_DESTINATION_EXPECTED_EVENTS or controller.engine.machine.program_counter != MANAGED_REGRESSION_CALLER_RESUME_INSTRUCTION.u64()
    return 5 if controller.state.breakpoints.points[0].hit_count != 1
    return 0

def check_managed_source_breakpoint_resume() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(managed_source_step_image())
    return MANAGED_SOURCE_BREAKPOINT_NO_ID if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(MANAGED_REGRESSION_SOURCE_FILE_ID), line: MANAGED_REGRESSION_NEXT_SOURCE_LINE, column: MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return MANAGED_SOURCE_BREAKPOINT_NO_ID if breakpoint.value == 0 or controller.state.breakpoints.resolved_instructions[0] != MANAGED_REGRESSION_INITIAL_INSTRUCTION.u64()
    first_continue: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return MANAGED_SOURCE_BREAKPOINT_FIRST_CONTINUE if not DebuggerErrors::error_is_ok(first_continue) or controller.engine.event_count != MANAGED_SOURCE_BREAKPOINT_EXPECTED_EVENT or controller.engine.machine.program_counter != MANAGED_SOURCE_BREAKPOINT_EXPECTED_EVENT.u64() or controller.state.breakpoints.points[0].hit_count != MANAGED_SOURCE_BREAKPOINT_EXPECTED_HITS
    second_continue: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return MANAGED_SOURCE_BREAKPOINT_SECOND_CONTINUE if not DebuggerErrors::error_is_ok(second_continue) or controller.engine.event_count != MANAGED_REGRESSION_SOURCE_STEP_INSTRUCTION_COUNT.usize() or not controller.engine.machine.halted or controller.state.breakpoints.points[0].hit_count != MANAGED_SOURCE_BREAKPOINT_EXPECTED_HITS
    reverse_continue: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_continue(controller)
    return MANAGED_SOURCE_BREAKPOINT_REVERSE_CONTINUE if not DebuggerErrors::error_is_ok(reverse_continue) or controller.engine.event_count != MANAGED_SOURCE_BREAKPOINT_EXPECTED_EVENT or controller.state.breakpoints.points[0].hit_count != MANAGED_SOURCE_BREAKPOINT_EXPECTED_HITS
    return 0

def check_managed_top_level_step_out() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(managed_source_step_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_out(controller)
    return 2 if not DebuggerErrors::error_is_ok(failure)
    return 3 if controller.engine.event_count != MANAGED_REGRESSION_SOURCE_STEP_INSTRUCTION_COUNT.usize() or not controller.engine.machine.halted or controller.engine.machine.result != EXPECTED_RESULT
    return 0

def check_managed_compound_step_breakpoints() -> i64:
    image: DebuggerEDIR::ProgramImage = managed_call_breakpoint_image()
    over_controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(image)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(over_controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(over_controller))
    over_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(MANAGED_REGRESSION_SOURCE_FILE_ID), line: MANAGED_REGRESSION_CALLEE_SOURCE_LINE, column: MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    over_breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(over_controller, over_location)
    return 2 if over_breakpoint.value == 0
    over_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_over(over_controller)
    return 3 if not DebuggerErrors::error_is_ok(over_failure) or over_controller.engine.event_count != 1 or over_controller.engine.machine.program_counter != MANAGED_REGRESSION_CALLEE_INSTRUCTION.u64() or over_controller.state.breakpoints.points[0].hit_count != 1

    out_controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(image)
    return 4 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(out_controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(out_controller))
    return 5 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(out_controller)) or out_controller.engine.machine.return_stack_pointer == 0
    out_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(MANAGED_REGRESSION_SOURCE_FILE_ID), line: MANAGED_REGRESSION_CALLEE_RETURN_LINE, column: MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    out_breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(out_controller, out_location)
    return 6 if out_breakpoint.value == 0
    out_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_out(out_controller)
    return 70 if not DebuggerErrors::error_is_ok(out_failure)
    return 71 if out_controller.engine.event_count != 2
    return 72 if out_controller.engine.machine.program_counter != MANAGED_REGRESSION_RETURN_INSTRUCTION.u64()
    return 73 if out_controller.engine.machine.return_stack_pointer == 0
    return 74 if out_controller.state.breakpoints.points[0].hit_count != 1
    return 0

def check_managed_parent_breakpoint_after_rewind() -> i64:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: INSTRUCTION_COUNT, local_count: MANAGED_REGRESSION_NO_LOCALS, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: EXPECTED_RESULT, b: MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(MANAGED_REGRESSION_PARENT_BREAKPOINT_LINE, 1)}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: MANAGED_REGRESSION_NO_OPERAND, b: MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(MANAGED_REGRESSION_PARENT_RETURN_LINE, 2)}
    controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(image)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.event_count != 1
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(MANAGED_REGRESSION_SOURCE_FILE_ID), line: MANAGED_REGRESSION_PARENT_BREAKPOINT_LINE, column: MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return 3 if breakpoint.value == 0
    child_branch: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_create_branch(controller)
    return 4 if child_branch.value == 0 or controller.engine.branch.value != child_branch.value
    return 5 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_reverse_step(controller)) or controller.engine.event_count != 0 or controller.engine.branch.value != child_branch.value or DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64()).value == child_branch.value
    continue_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return 6 if not DebuggerErrors::error_is_ok(continue_failure) or controller.engine.event_count != 0 or controller.state.breakpoints.points[0].hit_count != 1
    return 0

def check_full_checkpoint_side_state_integrity() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(managed_source_step_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.event_count != TARGET_EVENT.usize()
    resource: DebuggerIdentity::DebugId = DebuggerVirtualResources::resources_open(controller.state.resources, DebuggerIdentity::debug_id(MANAGED_CHECKPOINT_RESOURCE_PATH_ID), true, MANAGED_CHECKPOINT_RESOURCE_GENERATION)
    return 3 if resource.value == 0
    resource_byte: mutable u8[MANAGED_CHECKPOINT_RESOURCE_LENGTH] = zeroed
    resource_byte[0] <- MANAGED_CHECKPOINT_RESOURCE_BYTE
    seeded: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seed(controller.state.resources, resource, resource_byte[0], MANAGED_CHECKPOINT_RESOURCE_LENGTH)
    return 4 if not DebuggerErrors::error_is_ok(seeded)
    checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerManagedEngine::managed_full_checkpoint(controller)
    return 5 if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
    checkpoint.resources.files[0].bytes[0] <- MANAGED_CHECKPOINT_MUTATED_RESOURCE_BYTE
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_restore_full_checkpoint(controller, checkpoint)
    return 6 if DebuggerErrors::error_is_ok(failure) or failure.code != DebuggerErrors::ErrorCode.Corrupt
    return 7 if controller.engine.event_count != TARGET_EVENT.usize() or controller.engine.machine.accumulator != EXPECTED_RESULT
    return 8 if controller.state.resources.count != 1 or controller.state.resources.files[0].bytes[0] != MANAGED_CHECKPOINT_RESOURCE_BYTE
    return 0

def check_continue_history_limit_error() -> i64:
    history_capacity: usize = DebuggerReplayEngine::replay_engine_history_capacity()
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: (history_capacity + MANAGED_HISTORY_LIMIT_EXTRA_INSTRUCTIONS).u64(), local_count: MANAGED_REGRESSION_NO_LOCALS, has_return: true}
    for index in 0..<history_capacity:
        image.instructions[index] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: MANAGED_HISTORY_LIMIT_NO_OPERAND, b: MANAGED_HISTORY_LIMIT_NO_OPERAND, source: zeroed}
    image.instructions[history_capacity] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: MANAGED_HISTORY_LIMIT_NO_OPERAND, b: MANAGED_HISTORY_LIMIT_NO_OPERAND, source: zeroed}
    controller: mutable DebuggerManagedEngine::ManagedController = managed_regression_controller(image)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, history_capacity.u64())
    return 2 if failure.code != DebuggerErrors::ErrorCode.ResourceLimit or failure.retryable or controller.engine.event_count != history_capacity or controller.session.state != DebuggerSession::SessionState.Stopped or controller.engine.machine.halted or controller.engine.machine.faulted
    return 0

def main() -> i64:
    source_step_over_status: i64 = check_managed_source_step_over()
    return MANAGED_SOURCE_STEP_CHECK_RESULT if source_step_over_status != 0
    destination_breakpoint_status: i64 = check_managed_step_over_destination_breakpoint()
    return MANAGED_STEP_OVER_DESTINATION_BREAKPOINT_RESULT if destination_breakpoint_status != 0
    step_out_destination_breakpoint_status: i64 = check_managed_step_out_destination_breakpoint()
    return MANAGED_STEP_OUT_DESTINATION_BREAKPOINT_RESULT if step_out_destination_breakpoint_status != 0
    source_breakpoint_resume_status: i64 = check_managed_source_breakpoint_resume()
    return MANAGED_SOURCE_BREAKPOINT_RESUME_RESULT if source_breakpoint_resume_status != 0
    top_level_step_out_status: i64 = check_managed_top_level_step_out()
    return MANAGED_TOP_LEVEL_STEP_OUT_CHECK_RESULT if top_level_step_out_status != 0
    compound_step_breakpoint_status: i64 = check_managed_compound_step_breakpoints()
    return MANAGED_COMPOUND_BREAKPOINT_CHECK_RESULT if compound_step_breakpoint_status != 0
    parent_breakpoint_status: i64 = check_managed_parent_breakpoint_after_rewind()
