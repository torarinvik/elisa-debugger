    return 22 if unsupported_trace.accepted or unsupported_trace.failure.code != DebuggerErrors::ErrorCode.Unsupported
    noninspect_limited_session: DebuggerSession::Session = limited_session
    noninspect_limited_session.state <- DebuggerSession::SessionState.Created
    noninspect_limited_service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(noninspect_limited_session, image, DebuggerIdentity::debug_id(11))
    noninspect_trace: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(noninspect_limited_service, unsupported_trace_request)
