include "../src/protocol/managed_service.elisa"
include "../src/core/identity.elisa"
include "../src/core/capabilities.elisa"

const PROGRAM_VERSION: u32 = 1
const INSTRUCTION_COUNT: u64 = 2
const STEP_REQUEST_ID: u64 = 1
const TARGET_EVENT: u64 = 1
const EXPECTED_RESULT: i64 = 7
const MEMORY_REQUEST_ID: u64 = 2
const MAX_U64_VALUE: u64 = 18446744073709551615
const INVALID_SEEK_RESULT: i64 = 17
const FULL_CHECKPOINT_RESULT_FAILURE: i64 = 19
const FULL_CHECKPOINT_TAMPER_RESULT: i64 = 21
const FULL_CHECKPOINT_ROLLBACK_RESULT: i64 = 25
const BRANCH_RESULT_FAILURE: i64 = 20
const NON_INSPECT_TRACE_RESULT: i64 = 23
const INSPECTION_CAPABILITY_RESULT: i64 = 24
const FORGED_CHECKPOINT_RESULT: i64 = 37
const FORGED_CHECKPOINT_DELTA: i64 = 10
const BREAKPOINT_FILE_ID: u64 = 44
const BREAKPOINT_LINE: u32 = 2
const SOURCE_BREAKPOINT_SET_COUNT: usize = 2
const UNRESOLVED_BREAKPOINT_LINE: u32 = BREAKPOINT_LINE + 1
const BOOKMARK_LABEL_ID: u64 = 700
const BOOKMARK_NOTE_ID: u64 = 701

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: PROGRAM_VERSION, instruction_count: INSTRUCTION_COUNT, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: EXPECTED_RESULT, b: 0, source: zeroed}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(BREAKPOINT_FILE_ID), start_byte: 1, end_byte: 2, start_line: BREAKPOINT_LINE, start_column: 1, end_line: BREAKPOINT_LINE, end_column: 2, discriminator: 0}}
    service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, image, DebuggerIdentity::debug_id(9))
    discover_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Discover, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    discovered: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, discover_request)
    return 13 if not discovered.accepted
    launch_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, launch_request)
    return 1 if not launched.accepted
    pause_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Pause, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    paused: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, pause_request)
    return 2 if not paused.accepted
    step_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    stepped: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, step_request)
    return 3 if not stepped.accepted
    frame: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedService::service_frame(service)
    return 4 if frame.accumulator != EXPECTED_RESULT or frame.event != TARGET_EVENT or frame.instruction.value != TARGET_EVENT
    continue_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Continue, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    continued: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, continue_request)
    return 5 if not continued.accepted or not DebuggerManagedService::service_is_exact(service)
    continued_frame: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedService::service_frame(service)
    return 6 if continued_frame.result != EXPECTED_RESULT
    timeline: DebuggerTimeline::Timeline = DebuggerManagedService::service_timeline(service)
    return 27 if not DebuggerTimeline::history_bounds_is_valid(timeline.bounds) or timeline.bounds.current != continued_frame.event or timeline.bounds.exact_last < continued_frame.event
    bookmark_result: DebuggerTimeline::TimelineResult = DebuggerManagedService::service_add_bookmark(service, DebuggerIdentity::debug_id(BOOKMARK_LABEL_ID), DebuggerIdentity::debug_id(BOOKMARK_NOTE_ID), true)
    return 28 if not bookmark_result.accepted or bookmark_result.timeline.bookmark_count != 1
    service.controller.session.position.event <- 0
    seek_bookmark: DebuggerTimeline::TimelineResult = DebuggerManagedService::service_seek_bookmark(service, bookmark_result.timeline.bookmarks[0].id)
    return 32 if not seek_bookmark.accepted or seek_bookmark.timeline.bounds.current != continued_frame.event
    removed_bookmark: DebuggerTimeline::TimelineResult = DebuggerManagedService::service_remove_bookmark(service, bookmark_result.timeline.bookmarks[0].id)
    return 29 if not removed_bookmark.accepted or removed_bookmark.timeline.bookmark_count != 0
    halted_step: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, step_request)
    return 12 if halted_step.accepted or halted_step.failure.code != DebuggerErrors::ErrorCode.Unavailable
    seek_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Seek, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: TARGET_EVENT, valid: true}
    seek_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, seek_request)
    seek_frame: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedService::service_frame(service)
    return 8 if not seek_result.accepted or seek_frame.event != TARGET_EVENT
    unsupported_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Threads, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    inspected: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, unsupported_request)
    return 7 if not inspected.accepted
    memory_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Memory, id: MEMORY_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    memory_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, memory_request)
    return 16 if not memory_result.accepted
    evaluate_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Evaluate, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    evaluate_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, evaluate_request)
    return 34 if evaluate_result.accepted or evaluate_result.failure.code != DebuggerErrors::ErrorCode.Unsupported
    source_breakpoints_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.SetBreakpoints, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    source_breakpoints_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, source_breakpoints_request)
    return 35 if source_breakpoints_result.accepted or source_breakpoints_result.failure.code != DebuggerErrors::ErrorCode.Unsupported
    data_breakpoints_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    data_breakpoints_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, data_breakpoints_request)
    return 36 if data_breakpoints_result.accepted or data_breakpoints_result.failure.code != DebuggerErrors::ErrorCode.Unsupported
    missing_id_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: 0, has_id: false, expected_generation: 0, target_event: 0, valid: true}
    missing_id: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, missing_id_request)
    return 14 if missing_id.accepted or missing_id.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    unknown_method_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Unknown, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    unknown_method: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, unknown_method_request)
    return 15 if unknown_method.accepted or unknown_method.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    cancel_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Cancel, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    cancel_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, cancel_request)
    return 26 if cancel_result.accepted or cancel_result.failure.code != DebuggerErrors::ErrorCode.Unsupported
    stale_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: STEP_REQUEST_ID, has_id: true, expected_generation: 99, target_event: 0, valid: true}
    stale: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, stale_request)
    return 9 if stale.accepted or stale.failure.code != DebuggerErrors::ErrorCode.StaleGeneration
    unreachable_request: mutable DebuggerProtocolRequest::Request = seek_request
    unreachable_request.target_event <- INSTRUCTION_COUNT + TARGET_EVENT
    unreachable: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, unreachable_request)
    unchanged: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedService::service_frame(service)
    return 10 if unreachable.accepted or unchanged.event != TARGET_EVENT or unchanged.instruction.value != TARGET_EVENT
    oversized_seek: mutable DebuggerProtocolRequest::Request = seek_request
    oversized_seek.target_event <- MAX_U64_VALUE
    oversized_seek_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, oversized_seek)
    return INVALID_SEEK_RESULT if oversized_seek_result.accepted or oversized_seek_result.failure.code != DebuggerErrors::ErrorCode.Unavailable
    checkpoint_bytes: DebuggerTraceBinary::ByteWriter = DebuggerManagedService::service_checkpoint(service)
    checkpoint_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(checkpoint_bytes.bytes[0], checkpoint_bytes.length)
    return 18 if not DebuggerCheckpointCodec::checkpoint_bytes_are_valid(checkpoint_reader)
    full_checkpoint_result: DebuggerManagedService::CheckpointResult = DebuggerManagedService::service_full_checkpoint(service)
    return FULL_CHECKPOINT_RESULT_FAILURE if not full_checkpoint_result.accepted or not DebuggerFullCheckpoint::full_checkpoint_is_valid(full_checkpoint_result.checkpoint)
    advanced_after_checkpoint: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, continue_request)
    return FULL_CHECKPOINT_ROLLBACK_RESULT if not advanced_after_checkpoint.accepted or service.controller.engine.event_count != INSTRUCTION_COUNT.usize()
    forged_checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = full_checkpoint_result.checkpoint
    forged_checkpoint.machine.accumulator <- EXPECTED_RESULT + FORGED_CHECKPOINT_DELTA
    forged_checkpoint.state_hash <- DebuggerCheckpoint::snapshot_state_hash(forged_checkpoint.machine)
    forged_checkpoint.machine.state_hash <- forged_checkpoint.state_hash
    forged_restore: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, forged_checkpoint)
    return FORGED_CHECKPOINT_RESULT if forged_restore.accepted or forged_restore.failure.code != DebuggerErrors::ErrorCode.Diverged or service.controller.engine.event_count != INSTRUCTION_COUNT.usize() or not service.controller.engine.machine.halted or service.controller.engine.machine.result != EXPECTED_RESULT
    restored_earlier: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, full_checkpoint_result.checkpoint)
    return FULL_CHECKPOINT_ROLLBACK_RESULT if not restored_earlier.accepted or service.controller.engine.event_count != TARGET_EVENT.usize() or DebuggerManagedService::service_frame(service).accumulator != EXPECTED_RESULT or DebuggerManagedService::service_timeline(service).bounds.current != TARGET_EVENT
    forged_current_restore: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, forged_checkpoint)
    return FORGED_CHECKPOINT_RESULT if forged_current_restore.accepted or forged_current_restore.failure.code != DebuggerErrors::ErrorCode.Diverged or service.controller.engine.event_count != TARGET_EVENT.usize() or service.controller.engine.machine.accumulator != EXPECTED_RESULT
    restored_full: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, full_checkpoint_result.checkpoint)
    return FULL_CHECKPOINT_RESULT_FAILURE if not restored_full.accepted or service.controller.engine.machine.accumulator != EXPECTED_RESULT
    tampered_checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = full_checkpoint_result.checkpoint
    tampered_checkpoint.machine.accumulator <- EXPECTED_RESULT + 10
    tampered_restore: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, tampered_checkpoint)
    return FULL_CHECKPOINT_TAMPER_RESULT if tampered_restore.accepted or tampered_restore.failure.code != DebuggerErrors::ErrorCode.Corrupt
    invalid_pc_checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = full_checkpoint_result.checkpoint
    invalid_pc_checkpoint.machine.program_counter <- INSTRUCTION_COUNT
    invalid_pc_checkpoint.state_hash <- DebuggerCheckpoint::snapshot_state_hash(invalid_pc_checkpoint.machine)
    invalid_pc_checkpoint.machine.state_hash <- invalid_pc_checkpoint.state_hash
    invalid_pc_restore: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, invalid_pc_checkpoint)
    return FULL_CHECKPOINT_TAMPER_RESULT if invalid_pc_restore.accepted or invalid_pc_restore.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    branch_id: DebuggerIdentity::DebugId = DebuggerManagedService::service_create_branch(service)
    return BRANCH_RESULT_FAILURE if branch_id.value == 0 or service.controller.engine.branch.value != branch_id.value
    intervention: DebuggerBranches::Intervention = DebuggerBranches::Intervention{event: TARGET_EVENT, kind: DebuggerBranches::InterventionKind.Value, target: DebuggerIdentity::debug_id(1), value_hash: 99}
    intervention_result: DebuggerManagedService::Result = DebuggerManagedService::service_add_intervention(service, branch_id, intervention)
    return BRANCH_RESULT_FAILURE if not intervention_result.accepted
    invalid_intervention_result: DebuggerManagedService::Result = DebuggerManagedService::service_add_intervention(service, DebuggerIdentity::debug_id(0), intervention)
    return BRANCH_RESULT_FAILURE if invalid_intervention_result.accepted or invalid_intervention_result.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    breakpoint_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(BREAKPOINT_FILE_ID), line: BREAKPOINT_LINE, column: 1, discriminator: 0}
    breakpoint_id: DebuggerIdentity::DebugId = DebuggerManagedService::service_set_source_breakpoint(service, breakpoint_location)
    return BRANCH_RESULT_FAILURE if breakpoint_id.value == 0
    source_breakpoint_lines: mutable u32[SOURCE_BREAKPOINT_SET_COUNT] = [BREAKPOINT_LINE, UNRESOLVED_BREAKPOINT_LINE]
    source_breakpoint_set: DebuggerManagedService::SourceBreakpointResult = DebuggerManagedService::service_replace_source_breakpoints(service, DebuggerIdentity::debug_id(BREAKPOINT_FILE_ID), source_breakpoint_lines[0], SOURCE_BREAKPOINT_SET_COUNT)
    return BRANCH_RESULT_FAILURE if not source_breakpoint_set.accepted or source_breakpoint_set.count != SOURCE_BREAKPOINT_SET_COUNT
    return BRANCH_RESULT_FAILURE if not source_breakpoint_set.points[0].verified or source_breakpoint_set.points[1].verified or source_breakpoint_set.points[0].line != BREAKPOINT_LINE or source_breakpoint_set.points[1].line != UNRESOLVED_BREAKPOINT_LINE
    forward_to_return: DebuggerManagedService::Result = DebuggerManagedService::service_step_over(service)
    return BRANCH_RESULT_FAILURE if not forward_to_return.accepted
    reverse_to_breakpoint: DebuggerManagedService::Result = DebuggerManagedService::service_reverse_continue(service)
    return BRANCH_RESULT_FAILURE if not reverse_to_breakpoint.accepted or service.controller.engine.event_count != TARGET_EVENT.usize() or DebuggerManagedService::service_timeline(service).bounds.current != TARGET_EVENT
    breakpoint_continue: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, continue_request)
    return BRANCH_RESULT_FAILURE if not breakpoint_continue.accepted or service.controller.engine.event_count != INSTRUCTION_COUNT.usize()
    no_source_breakpoint_lines: mutable u32[SOURCE_BREAKPOINT_SET_COUNT] = zeroed
    cleared_source_breakpoints: DebuggerManagedService::SourceBreakpointResult = DebuggerManagedService::service_replace_source_breakpoints(service, DebuggerIdentity::debug_id(BREAKPOINT_FILE_ID), no_source_breakpoint_lines[0], 0)
    return BRANCH_RESULT_FAILURE if not cleared_source_breakpoints.accepted or cleared_source_breakpoints.count != 0 or service.controller.state.breakpoints.count != 0
    invalid_source_breakpoints: DebuggerManagedService::SourceBreakpointResult = DebuggerManagedService::service_replace_source_breakpoints(service, DebuggerIdentity::debug_id(0), no_source_breakpoint_lines[0], 0)
    return BRANCH_RESULT_FAILURE if invalid_source_breakpoints.accepted or invalid_source_breakpoints.failure.code != DebuggerErrors::ErrorCode.InvalidArgument or service.controller.state.breakpoints.count != 0
    service.controller.session <- DebuggerSession::session_resume(service.controller.session)
    running_seek: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, seek_request)
    reverse_request: mutable DebuggerProtocolRequest::Request = step_request
    reverse_request.method <- DebuggerProtocolRequest::RequestMethod.ReverseStep
    running_reverse: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, reverse_request)
    running_frame: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedService::service_frame(service)
    return 11 if running_seek.accepted or running_reverse.accepted or running_frame.event != INSTRUCTION_COUNT
    limited_session: DebuggerSession::Session = session
    limited_session.state <- DebuggerSession::SessionState.Stopped
    limited_session.capabilities <- DebuggerCapabilities::native_attach_capabilities()
    limited_service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(limited_session, image, DebuggerIdentity::debug_id(10))
    return 30 if DebuggerManagedService::service_timeline(limited_service).bounds.has_exact
    unsupported_trace_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.TraceVerify, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    unsupported_trace: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(limited_service, unsupported_trace_request)
    return 22 if unsupported_trace.accepted or unsupported_trace.failure.code != DebuggerErrors::ErrorCode.Unsupported
    noninspect_limited_session: DebuggerSession::Session = limited_session
    noninspect_limited_session.state <- DebuggerSession::SessionState.Created
    noninspect_limited_service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(noninspect_limited_session, image, DebuggerIdentity::debug_id(11))
    noninspect_trace: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(noninspect_limited_service, unsupported_trace_request)
    return NON_INSPECT_TRACE_RESULT if noninspect_trace.accepted or noninspect_trace.failure.code != DebuggerErrors::ErrorCode.Unsupported
    partial_session: DebuggerSession::Session = session
    partial_session.state <- DebuggerSession::SessionState.Stopped
    partial_session.capabilities.history <- DebuggerCapabilities::HistoryKind.Replayable
    partial_service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(partial_session, image, DebuggerIdentity::debug_id(9))
    return 31 if DebuggerManagedService::service_timeline(partial_service).bounds.has_exact
    service.controller.session.capabilities.history <- DebuggerCapabilities::HistoryKind.Replayable
    _ = DebuggerManagedService::service_dispatch(service, discover_request)
    return 33 if DebuggerManagedService::service_timeline(service).bounds.has_exact
    partial_continue: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(partial_service, continue_request)
    return FULL_CHECKPOINT_ROLLBACK_RESULT if not partial_continue.accepted
    partial_restore: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(partial_service, full_checkpoint_result.checkpoint)
    return FULL_CHECKPOINT_ROLLBACK_RESULT if partial_restore.accepted or partial_restore.failure.code != DebuggerErrors::ErrorCode.Unsupported or partial_service.controller.engine.event_count != INSTRUCTION_COUNT.usize()
    limited_service.controller.session.capabilities.expression_evaluation <- false
    unsupported_evaluate_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Evaluate, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    unsupported_evaluate: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(limited_service, unsupported_evaluate_request)
    return INSPECTION_CAPABILITY_RESULT if unsupported_evaluate.accepted or unsupported_evaluate.failure.code != DebuggerErrors::ErrorCode.Unsupported
    return 0
