    missing_id_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: 0, has_id: false, expected_generation: 0, target_event: 0, valid: true}
    missing_id: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, missing_id_request)
    return 14 if missing_id.accepted or missing_id.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    unknown_method_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Unknown, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    unknown_method: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, unknown_method_request)
    return 15 if unknown_method.accepted or unknown_method.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    cancel_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Cancel, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    cancel_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, cancel_request)
    return 26 if cancel_result.accepted or cancel_result.failure.code != DebuggerErrors::ErrorCode.Unsupported
    stale_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: STEP_REQUEST_ID, has_id: true, expected_generation: 99, target_event: 0, valid: true}
    stale: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, stale_request)
    return 9 if stale.accepted or stale.failure.code != DebuggerErrors::ErrorCode.StaleGeneration
    unreachable_request: mutable DebuggerProtocolRequest::Request = seek_request
