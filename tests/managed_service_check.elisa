    source_breakpoint_set: DebuggerManagedService::SourceBreakpointResult = DebuggerManagedService::service_replace_source_breakpoints(service, DebuggerIdentity::debug_id(BREAKPOINT_FILE_ID), source_breakpoint_lines[0], SOURCE_BREAKPOINT_SET_COUNT)
    return BRANCH_RESULT_FAILURE if not source_breakpoint_set.accepted or source_breakpoint_set.count != SOURCE_BREAKPOINT_SET_COUNT
    return BRANCH_RESULT_FAILURE if not source_breakpoint_set.points[0].verified or source_breakpoint_set.points[1].verified or source_breakpoint_set.points[0].line != BREAKPOINT_LINE or source_breakpoint_set.points[1].line != UNRESOLVED_BREAKPOINT_LINE
    forward_to_return: DebuggerManagedService::Result = DebuggerManagedService::service_step_over(service)
