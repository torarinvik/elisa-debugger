    return 31 if DebuggerManagedService::service_timeline(partial_service).bounds.has_exact
    service.controller.session.capabilities.history <- DebuggerCapabilities::HistoryKind.Replayable
    _ = DebuggerManagedService::service_dispatch(service, discover_request)
    return 33 if DebuggerManagedService::service_timeline(service).bounds.has_exact
    partial_continue: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(partial_service, continue_request)
