    bookmark_result: DebuggerTimeline::TimelineResult = DebuggerManagedService::service_add_bookmark(service, DebuggerIdentity::debug_id(BOOKMARK_LABEL_ID), DebuggerIdentity::debug_id(BOOKMARK_NOTE_ID), true)
    return 28 if not bookmark_result.accepted or bookmark_result.timeline.bookmark_count != 1
    service.controller.session.position.event <- 0
    seek_bookmark: DebuggerTimeline::TimelineResult = DebuggerManagedService::service_seek_bookmark(service, bookmark_result.timeline.bookmarks[0].id)
