    return 35 if source_breakpoints_result.accepted or source_breakpoints_result.failure.code != DebuggerErrors::ErrorCode.Unsupported
    data_breakpoints_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.SetDataBreakpoints, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    data_breakpoints_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, data_breakpoints_request)
