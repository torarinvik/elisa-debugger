    checkpoint_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(checkpoint_bytes.bytes[0], checkpoint_bytes.length)
    return 18 if not DebuggerCheckpointCodec::checkpoint_bytes_are_valid(checkpoint_reader)
    full_checkpoint_result: DebuggerManagedService::CheckpointResult = DebuggerManagedService::service_full_checkpoint(service)
    return FULL_CHECKPOINT_RESULT_FAILURE if not full_checkpoint_result.accepted or not DebuggerFullCheckpoint::full_checkpoint_is_valid(full_checkpoint_result.checkpoint)
    advanced_after_checkpoint: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, continue_request)
    return FULL_CHECKPOINT_ROLLBACK_RESULT if not advanced_after_checkpoint.accepted or service.controller.engine.event_count != INSTRUCTION_COUNT.usize()
    forged_checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = full_checkpoint_result.checkpoint
    forged_checkpoint.machine.accumulator <- EXPECTED_RESULT + FORGED_CHECKPOINT_DELTA
    forged_checkpoint.state_hash <- DebuggerCheckpoint::snapshot_state_hash(forged_checkpoint.machine)
    forged_checkpoint.machine.state_hash <- forged_checkpoint.state_hash
    forged_restore: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, forged_checkpoint)
    return FORGED_CHECKPOINT_RESULT if forged_restore.accepted or forged_restore.failure.code != DebuggerErrors::ErrorCode.Diverged or service.controller.engine.event_count != INSTRUCTION_COUNT.usize() or not service.controller.engine.machine.halted or service.controller.engine.machine.result != EXPECTED_RESULT
    restored_earlier: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, full_checkpoint_result.checkpoint)
    return FULL_CHECKPOINT_ROLLBACK_RESULT if not restored_earlier.accepted or service.controller.engine.event_count != TARGET_EVENT.usize() or DebuggerManagedService::service_frame(service).accumulator != EXPECTED_RESULT or DebuggerManagedService::service_timeline(service).bounds.current != TARGET_EVENT
    forged_current_restore: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, forged_checkpoint)
    return FORGED_CHECKPOINT_RESULT if forged_current_restore.accepted or forged_current_restore.failure.code != DebuggerErrors::ErrorCode.Diverged or service.controller.engine.event_count != TARGET_EVENT.usize() or service.controller.engine.machine.accumulator != EXPECTED_RESULT
    restored_full: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(service, full_checkpoint_result.checkpoint)
    return FULL_CHECKPOINT_RESULT_FAILURE if not restored_full.accepted or service.controller.engine.machine.accumulator != EXPECTED_RESULT
