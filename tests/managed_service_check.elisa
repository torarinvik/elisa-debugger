    partial_restore: DebuggerManagedService::Result = DebuggerManagedService::service_restore_full_checkpoint(partial_service, full_checkpoint_result.checkpoint)
    return FULL_CHECKPOINT_ROLLBACK_RESULT if partial_restore.accepted or partial_restore.failure.code != DebuggerErrors::ErrorCode.Unsupported or partial_service.controller.engine.event_count != INSTRUCTION_COUNT.usize()
    limited_service.controller.session.capabilities.expression_evaluation <- false
    unsupported_evaluate_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Evaluate, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    unsupported_evaluate: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(limited_service, unsupported_evaluate_request)
    return INSPECTION_CAPABILITY_RESULT if unsupported_evaluate.accepted or unsupported_evaluate.failure.code != DebuggerErrors::ErrorCode.Unsupported
    return 0
