    return BRANCH_RESULT_FAILURE if not cleared_source_breakpoints.accepted or cleared_source_breakpoints.count != 0 or service.controller.state.breakpoints.count != 0
    invalid_source_breakpoints: DebuggerManagedService::SourceBreakpointResult = DebuggerManagedService::service_replace_source_breakpoints(service, DebuggerIdentity::debug_id(0), no_source_breakpoint_lines[0], 0)
    return BRANCH_RESULT_FAILURE if invalid_source_breakpoints.accepted or invalid_source_breakpoints.failure.code != DebuggerErrors::ErrorCode.InvalidArgument or service.controller.state.breakpoints.count != 0
