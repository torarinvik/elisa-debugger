def managed_allocation_service_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: ManagedAllocationService::PROGRAM_VERSION, instruction_count: ManagedAllocationService::INSTRUCTION_COUNT, local_count: ManagedAllocationService::LOCAL_COUNT, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Allocate, a: ManagedAllocationService::ALLOCATION_SIZE, b: 0, source: zeroed}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: ManagedAllocationService::VALUE, b: 0, source: zeroed}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreMemory, a: ManagedAllocationService::MEMORY_SLOT, b: 0, source: zeroed}
    image.instructions[3] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    return image

def managed_allocation_service_request(method: DebuggerProtocolRequest::RequestMethod) -> DebuggerProtocolRequest::Request:
    return DebuggerProtocolRequest::Request{method: method, id: ManagedAllocationService::REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}

def check_managed_allocations_service() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(ManagedAllocationService::COMPILER_ID), runtime: DebuggerIdentity::debug_id(ManagedAllocationService::RUNTIME_ID), source: DebuggerIdentity::debug_id(ManagedAllocationService::SOURCE_ID), target: DebuggerIdentity::debug_id(ManagedAllocationService::TARGET_ID), metadata_version: ManagedAllocationService::METADATA_VERSION}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(ManagedAllocationService::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    service: mutable DebuggerManagedService::Service
    DebuggerManagedService::service_initialize(service, session, managed_allocation_service_image(), DebuggerIdentity::debug_id(ManagedAllocationService::RECORDING_ID))
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, managed_allocation_service_request(DebuggerProtocolRequest::RequestMethod.Launch))
    return ManagedAllocationService::FAILURE if not launched.accepted
    continued: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, managed_allocation_service_request(DebuggerProtocolRequest::RequestMethod.Continue))
    return ManagedAllocationService::FAILURE if not continued.accepted
    page: DebuggerManagedAllocations::AllocationPage = DebuggerManagedService::service_allocations(service, 0, 0)
    return ManagedAllocationService::FAILURE if not DebuggerErrors::error_is_ok(page.failure) or page.count != ManagedAllocationService::EXPECTED_COUNT or page.next != 0 or not page.complete
    allocation: DebuggerManagedAllocations::AllocationSnapshot = page.entries[0]
    return ManagedAllocationService::FAILURE if allocation.start_slot != ManagedAllocationService::EXPECTED_START or allocation.length != ManagedAllocationService::EXPECTED_LENGTH or allocation.initialized_slots != ManagedAllocationService::EXPECTED_INITIALIZED or not DebuggerManagedAllocations::allocation_snapshot_is_fully_initialized(allocation)
    return 0


def managed_reverse_recursive_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: ManagedReverseProgram::INSTRUCTION_COUNT, local_count: ManagedReverseProgram::LOCAL_COUNT, has_return: true}
    image.instructions[ManagedReverseInstruction::MAIN_CONSTANT_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: ManagedReverseProgram::INITIAL_ARGUMENT, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::MAIN_LINE, ManagedReverseSource::MAIN_START_BYTE)}
    image.instructions[ManagedReverseInstruction::ROOT_CALL_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Call, a: ManagedReverseInstruction::RECURSIVE_CALL_TARGET, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::MAIN_LINE, ManagedReverseSource::MAIN_START_BYTE)}
    image.instructions[ManagedReverseInstruction::MAIN_RETURN_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: ManagedReverseInstruction::NO_OPERAND, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::BASE_LINE, ManagedReverseSource::BASE_START_BYTE)}
    image.instructions[ManagedReverseInstruction::FUNCTION_ENTRY_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.LoadLocal, a: ManagedReverseInstruction::NO_LOCAL_INDEX, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::CONDITION_LINE, ManagedReverseSource::CONDITION_START_BYTE)}
    image.instructions[ManagedReverseInstruction::COMPARE_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.CompareEqual, a: ManagedReverseInstruction::NO_OPERAND, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::CONDITION_LINE, ManagedReverseSource::CONDITION_START_BYTE)}
    image.instructions[ManagedReverseInstruction::BRANCH_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.BranchZero, a: ManagedReverseInstruction::RECURSIVE_BRANCH_TARGET, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::CONDITION_LINE, ManagedReverseSource::CONDITION_START_BYTE)}
    image.instructions[ManagedReverseInstruction::BASE_CONSTANT_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: ManagedReverseProgram::BASE_RESULT, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::BASE_LINE, ManagedReverseSource::BASE_START_BYTE)}
    image.instructions[ManagedReverseInstruction::BASE_RETURN_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: ManagedReverseInstruction::NO_OPERAND, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::BASE_LINE, ManagedReverseSource::BASE_START_BYTE)}
    image.instructions[ManagedReverseInstruction::RECURSIVE_LOAD_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.LoadLocal, a: ManagedReverseInstruction::NO_LOCAL_INDEX, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::RECURSION_LINE, ManagedReverseSource::RECURSION_START_BYTE)}
    image.instructions[ManagedReverseInstruction::RECURSIVE_DECREMENT_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Subtract, a: ManagedReverseProgram::RECURSIVE_DECREMENT, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::RECURSION_LINE, ManagedReverseSource::RECURSION_START_BYTE)}
    image.instructions[ManagedReverseInstruction::RECURSIVE_CALL_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Call, a: ManagedReverseInstruction::RECURSIVE_CALL_TARGET, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::RECURSION_LINE, ManagedReverseSource::RECURSION_START_BYTE)}
    image.instructions[ManagedReverseInstruction::RECURSIVE_RETURN_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: ManagedReverseInstruction::NO_OPERAND, b: ManagedReverseInstruction::NO_OPERAND, source: managed_regression_source_span(ManagedReverseSource::RECURSION_LINE, ManagedReverseSource::RECURSION_START_BYTE)}
    return image

def check_managed_reverse_compound_steps() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, managed_reverse_recursive_image())
    return ManagedReverseResult::LAUNCH_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    return ManagedReverseResult::PAUSE_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    no_history_over: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_over(controller)
    return ManagedReverseResult::NO_HISTORY_OVER_FAILURE if no_history_over.code != DebuggerErrors::ErrorCode.Unavailable or controller.engine.event_count != Test::NO_TARGET_EVENT.usize()
    no_history_out: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_out(controller)
    return ManagedReverseResult::NO_HISTORY_OUT_FAILURE if no_history_out.code != DebuggerErrors::ErrorCode.Unavailable or controller.engine.event_count != Test::NO_TARGET_EVENT.usize()
    for step_index in 0..<ManagedReverseProgram::STEP_COUNT_TO_DEEPEST_CALL:
        step_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step(controller)
        return ManagedReverseResult::FORWARD_STEP_FAILURE if not DebuggerErrors::error_is_ok(step_failure)
    return ManagedReverseResult::DEEPEST_FRAME_FAILURE if controller.engine.event_count != ManagedReverseProgram::STEP_COUNT_TO_DEEPEST_CALL or controller.engine.machine.program_counter != ManagedReverseInstruction::FUNCTION_ENTRY_INDEX.u64() or controller.engine.machine.return_stack_pointer != ManagedReverseFrame::DEEPEST_DEPTH
    deepest_reverse_out: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_out(controller)
    return ManagedReverseResult::DEEPEST_REVERSE_OUT_FAILURE if not DebuggerErrors::error_is_ok(deepest_reverse_out) or controller.engine.event_count != ManagedReverseEvent::DEEPEST_RECURSIVE_CALL or controller.engine.machine.program_counter != ManagedReverseInstruction::RECURSIVE_CALL_INDEX.u64() or controller.engine.machine.return_stack_pointer != ManagedReverseFrame::NEXT_OUT_DEPTH
    recursive_reverse_over: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_over(controller)
    return ManagedReverseResult::RECURSIVE_REVERSE_OVER_FAILURE if not DebuggerErrors::error_is_ok(recursive_reverse_over) or controller.engine.event_count != ManagedReverseEvent::REVERSE_OVER_TARGET or controller.engine.machine.program_counter != ManagedReverseInstruction::BRANCH_INDEX.u64() or controller.engine.machine.return_stack_pointer != ManagedReverseFrame::NEXT_OUT_DEPTH
    second_reverse_out: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_out(controller)
    return ManagedReverseResult::SECOND_REVERSE_OUT_FAILURE if not DebuggerErrors::error_is_ok(second_reverse_out) or controller.engine.event_count != ManagedReverseEvent::SECOND_RECURSIVE_CALL or controller.engine.machine.program_counter != ManagedReverseInstruction::RECURSIVE_CALL_INDEX.u64() or controller.engine.machine.return_stack_pointer != ManagedReverseFrame::SECOND_OUT_DEPTH
    first_reverse_out: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_out(controller)
    return ManagedReverseResult::FIRST_REVERSE_OUT_FAILURE if not DebuggerErrors::error_is_ok(first_reverse_out) or controller.engine.event_count != ManagedReverseEvent::FIRST_RECURSIVE_CALL or controller.engine.machine.program_counter != ManagedReverseInstruction::RECURSIVE_CALL_INDEX.u64() or controller.engine.machine.return_stack_pointer != ManagedReverseFrame::ROOT_CALLEE_DEPTH
    root_reverse_out: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_out(controller)
    return ManagedReverseResult::ROOT_REVERSE_OUT_FAILURE if not DebuggerErrors::error_is_ok(root_reverse_out) or controller.engine.event_count != ManagedReverseEvent::ROOT_CALL or controller.engine.machine.program_counter != ManagedReverseInstruction::ROOT_CALL_INDEX.u64() or controller.engine.machine.return_stack_pointer != ManagedReverseFrame::TOP_LEVEL_DEPTH
    top_level_boundary: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step_out(controller)
    return ManagedReverseResult::TOP_LEVEL_BOUNDARY_FAILURE if top_level_boundary.code != DebuggerErrors::ErrorCode.Unavailable or controller.engine.event_count != ManagedReverseEvent::ROOT_CALL or controller.engine.machine.program_counter != ManagedReverseInstruction::ROOT_CALL_INDEX.u64() or controller.engine.machine.return_stack_pointer != ManagedReverseFrame::TOP_LEVEL_DEPTH
    return ManagedReverseResult::SUCCESS

def check_managed_reverse_protocol_route() -> i64:
    parsed_reverse_over: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(ManagedReverseWire::REVERSE_STEP_OVER_JSON.cast[u8&], DebuggerProtocolRequest::request_cstr_length(ManagedReverseWire::REVERSE_STEP_OVER_JSON))
    parsed_reverse_out: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(ManagedReverseWire::REVERSE_STEP_OUT_JSON.cast[u8&], DebuggerProtocolRequest::request_cstr_length(ManagedReverseWire::REVERSE_STEP_OUT_JSON))
    return ManagedReverseRoute::REQUEST_PARSE_FAILURE if not parsed_reverse_over.valid or parsed_reverse_over.method != DebuggerProtocolRequest::RequestMethod.ReverseStepOver or not parsed_reverse_out.valid or parsed_reverse_out.method != DebuggerProtocolRequest::RequestMethod.ReverseStepOut
    return ManagedReverseRoute::REQUEST_PARSE_FAILURE if DebuggerProtocolDispatcher::operation_for_method(parsed_reverse_over.method) != DebuggerCoordinator::Operation.ReverseStepOver or DebuggerProtocolDispatcher::operation_for_method(parsed_reverse_out.method) != DebuggerCoordinator::Operation.ReverseStepOut
    image: DebuggerEDIR::ProgramImage = managed_reverse_recursive_image()
    seed_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(seed_controller, image)
    service: mutable DebuggerManagedService::Service
    DebuggerManagedService::service_initialize(service, seed_controller.session, image, DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_RECORDING_ID))
    launch_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: ManagedReverseRoute::REQUEST_ID, has_id: true, expected_generation: ManagedReverseRoute::NO_EXPECTED_GENERATION, target_event: ManagedReverseRoute::NO_TARGET_EVENT, valid: true}
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, launch_request)
    return ManagedReverseRoute::LAUNCH_FAILURE if not launched.accepted
    pause_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Pause, id: ManagedReverseRoute::REQUEST_ID, has_id: true, expected_generation: ManagedReverseRoute::NO_EXPECTED_GENERATION, target_event: ManagedReverseRoute::NO_TARGET_EVENT, valid: true}
    paused: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, pause_request)
    return ManagedReverseRoute::PAUSE_FAILURE if not paused.accepted
    empty_history_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.ReverseStepOver, request_id: ManagedReverseRoute::REQUEST_ID, session_id: ManagedReverseRoute::NO_SESSION_ID, expected_stop_generation: ManagedReverseRoute::NO_EXPECTED_GENERATION, page_size: ManagedReverseRoute::NO_PAGE_SIZE, target_event: ManagedReverseRoute::NO_TARGET_EVENT}
    empty_history_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle_managed(service, empty_history_request)
    return ManagedReverseRoute::EMPTY_HISTORY_ROUTE_FAILURE if empty_history_response.ok or empty_history_response.failure.code != DebuggerErrors::ErrorCode.Unavailable or service.controller.engine.event_count != Test::NO_TARGET_EVENT.usize()
    for step_index in 0..<ManagedReverseProgram::STEP_COUNT_TO_DEEPEST_CALL:
        step_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: ManagedReverseRoute::REQUEST_ID, has_id: true, expected_generation: ManagedReverseRoute::NO_EXPECTED_GENERATION, target_event: ManagedReverseRoute::NO_TARGET_EVENT, valid: true}
        stepped: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, step_request)
        return ManagedReverseRoute::FORWARD_STEP_FAILURE if not stepped.accepted
    reverse_out_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.ReverseStepOut, request_id: ManagedReverseRoute::REQUEST_ID, session_id: ManagedReverseRoute::NO_SESSION_ID, expected_stop_generation: ManagedReverseRoute::NO_EXPECTED_GENERATION, page_size: ManagedReverseRoute::NO_PAGE_SIZE, target_event: ManagedReverseRoute::NO_TARGET_EVENT}
    reverse_out_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle_managed(service, reverse_out_request)
    return ManagedReverseRoute::REVERSE_OUT_ROUTE_FAILURE if not reverse_out_response.ok or service.controller.engine.event_count != ManagedReverseRoute::EXPECTED_REVERSE_OUT_EVENT or service.controller.engine.machine.return_stack_pointer != ManagedReverseFrame::NEXT_OUT_DEPTH or service.controller.engine.machine.program_counter != ManagedReverseInstruction::RECURSIVE_CALL_INDEX.u64()
    reverse_over_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.ReverseStepOver, request_id: ManagedReverseRoute::REQUEST_ID, session_id: ManagedReverseRoute::NO_SESSION_ID, expected_stop_generation: ManagedReverseRoute::NO_EXPECTED_GENERATION, page_size: ManagedReverseRoute::NO_PAGE_SIZE, target_event: ManagedReverseRoute::NO_TARGET_EVENT}
    reverse_over_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle_managed(service, reverse_over_request)
    return ManagedReverseRoute::REVERSE_OVER_ROUTE_FAILURE if not reverse_over_response.ok or service.controller.engine.event_count != ManagedReverseRoute::EXPECTED_REVERSE_OVER_EVENT or service.controller.engine.machine.return_stack_pointer != ManagedReverseFrame::NEXT_OUT_DEPTH or service.controller.engine.machine.program_counter != ManagedReverseInstruction::BRANCH_INDEX.u64()
    return ManagedReverseRoute::SUCCESS


def managed_regression_source_span(line: u32, start_byte: u64) -> DebuggerIdentity::SourceSpan:
    return DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), start_byte: start_byte, end_byte: start_byte + Test::MANAGED_REGRESSION_SOURCE_SPAN_WIDTH, start_line: line, start_column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, end_line: line, end_column: Test::MANAGED_REGRESSION_SOURCE_END_COLUMN, discriminator: 0}

def managed_regression_controller(controller: mutable DebuggerManagedEngine::ManagedController&, image: DebuggerEDIR::ProgramImage) -> void:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_BUILD_COMPILER_ID), runtime: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_BUILD_RUNTIME_ID), source: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_BUILD_SOURCE_ID), target: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_BUILD_TARGET_ID), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_RECORDING_ID))

def managed_source_step_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: Test::MANAGED_REGRESSION_SOURCE_STEP_INSTRUCTION_COUNT, local_count: Test::MANAGED_REGRESSION_NO_LOCALS, has_return: true}
    first_source: DebuggerIdentity::SourceSpan = managed_regression_source_span(Test::MANAGED_REGRESSION_NEXT_SOURCE_LINE, 1)
    later_source: DebuggerIdentity::SourceSpan = managed_regression_source_span(Test::MANAGED_REGRESSION_LATER_SOURCE_LINE, 2)
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::EXPECTED_RESULT, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: first_source}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: first_source}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: later_source}
    image.instructions[3] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: later_source}
    return image

def managed_conditional_breakpoint_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: Test::BreakpointCondition::INSTRUCTION_COUNT, local_count: Test::BreakpointCondition::LOCAL_COUNT, has_return: true}
    setup_source: DebuggerIdentity::SourceSpan = managed_regression_source_span(Test::BreakpointCondition::SETUP_LINE, Test::BreakpointCondition::SETUP_BYTE_OFFSET)
    target_source: DebuggerIdentity::SourceSpan = managed_regression_source_span(Test::BreakpointCondition::TARGET_LINE, Test::BreakpointCondition::TARGET_BYTE_OFFSET)
    image.instructions[Test::BreakpointCondition::FIRST_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::BreakpointCondition::SETUP_VALUE, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: setup_source}
    image.instructions[Test::BreakpointCondition::STORE_LOCAL_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.StoreLocal, a: Test::BreakpointCondition::LOCAL_INDEX, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: setup_source}
    image.instructions[Test::BreakpointCondition::TARGET_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.LoadLocal, a: Test::BreakpointCondition::LOCAL_INDEX, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: target_source}
    image.instructions[Test::BreakpointCondition::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: target_source}
    return image

def managed_call_breakpoint_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: Test::MANAGED_REGRESSION_CALL_INSTRUCTION_COUNT, local_count: Test::MANAGED_REGRESSION_NO_LOCALS, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Call, a: Test::MANAGED_REGRESSION_CALL_TARGET, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(Test::MANAGED_REGRESSION_CALLER_SOURCE_LINE, 1)}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(Test::MANAGED_REGRESSION_LATER_SOURCE_LINE, 2)}
    image.instructions[2] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(Test::MANAGED_REGRESSION_LATER_SOURCE_LINE, 3)}
    image.instructions[Test::MANAGED_REGRESSION_CALLEE_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(Test::MANAGED_REGRESSION_CALLEE_SOURCE_LINE, 4)}
    image.instructions[Test::MANAGED_REGRESSION_RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(Test::MANAGED_REGRESSION_CALLEE_RETURN_LINE, 5)}
    return image

def check_managed_function_breakpoints() -> i64:
    image: mutable DebuggerEDIR::ProgramImage = managed_call_breakpoint_image()
    image.program.local_count <- Test::FunctionBreakpointTest::LOCAL_COUNT
    image.function_count <- Test::FunctionBreakpointTest::FUNCTION_COUNT
    first_function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
    first_function.id <- DebuggerIdentity::debug_id(Test::FunctionBreakpointTest::FIRST_FUNCTION_ID)
    first_function.name_length <- Test::FunctionBreakpointTest::FUNCTION_NAME_LENGTH
    first_function.entry_instruction <- Test::FunctionBreakpointTest::FIRST_FUNCTION_ENTRY
    first_function.end_instruction_exclusive <- Test::FunctionBreakpointTest::FIRST_FUNCTION_END
    second_function: mutable DebuggerEDIR::FunctionDescriptor = zeroed
    second_function.id <- DebuggerIdentity::debug_id(Test::FunctionBreakpointTest::SECOND_FUNCTION_ID)
    second_function.name_length <- Test::FunctionBreakpointTest::FUNCTION_NAME_LENGTH
    second_function.entry_instruction <- Test::FunctionBreakpointTest::SECOND_FUNCTION_ENTRY
    second_function.end_instruction_exclusive <- Test::FunctionBreakpointTest::SECOND_FUNCTION_END
    for name_index in 0..<Test::FunctionBreakpointTest::FUNCTION_NAME_LENGTH:
        first_function.name_bytes[name_index] <- Test::FunctionBreakpointTest::FUNCTION_NAME.cast[u8&][name_index]
        second_function.name_bytes[name_index] <- Test::FunctionBreakpointTest::FUNCTION_NAME.cast[u8&][name_index]
    image.functions[Test::FunctionBreakpointTest::FIRST_FUNCTION_INDEX] <- first_function
    image.functions[Test::FunctionBreakpointTest::SECOND_FUNCTION_INDEX] <- second_function
    seed_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(seed_controller, image)
    service: mutable DebuggerManagedService::Service
    DebuggerManagedService::service_initialize(service, seed_controller.session, image, DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_RECORDING_ID))
    launch_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: Test::FunctionBreakpointTest::REQUEST_ID, has_id: true, expected_generation: Test::FunctionBreakpointTest::NO_EXPECTED_GENERATION, target_event: Test::FunctionBreakpointTest::NO_TARGET_EVENT, valid: true}
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, launch_request)
    return Test::FunctionBreakpointTest::LAUNCH_FAILURE if not launched.accepted
    retained_source_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::MANAGED_REGRESSION_CALLEE_SOURCE_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: Test::FunctionBreakpointTest::NO_DISCRIMINATOR}
    retained_source_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(service.controller, retained_source_location)
    return Test::FunctionBreakpointTest::MISSING_FAILURE if retained_source_id.value == Test::FunctionBreakpointTest::NO_DEBUG_ID or service.controller.state.breakpoints.points[Test::FunctionBreakpointTest::SOURCE_BREAKPOINT_INDEX].status != DebuggerBreakpoints::BreakpointStatus.Verified
    missing_names: mutable u8[Test::FunctionBreakpointTest::MISSING_NAME_LENGTH] = zeroed
    for name_index in 0..<Test::FunctionBreakpointTest::MISSING_NAME_LENGTH:
        missing_names[name_index] <- Test::FunctionBreakpointTest::MISSING_NAME.cast[u8&][name_index]
    request_offsets: mutable usize[Test::FunctionBreakpointTest::REQUESTED_COUNT] = zeroed
    missing_lengths: mutable usize[Test::FunctionBreakpointTest::REQUESTED_COUNT] = zeroed
    request_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] <- Test::FunctionBreakpointTest::FUNCTION_NAME_OFFSET
    missing_lengths[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] <- Test::FunctionBreakpointTest::MISSING_NAME_LENGTH
    pending: DebuggerManagedService::FunctionBreakpointResult = DebuggerManagedService::service_replace_function_breakpoints(service, missing_names[request_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX]], Test::FunctionBreakpointTest::MISSING_NAME_LENGTH, request_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX], missing_lengths[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX], Test::FunctionBreakpointTest::REQUESTED_COUNT)
    return Test::FunctionBreakpointTest::MISSING_FAILURE if not pending.accepted
    return Test::FunctionBreakpointTest::PENDING_FAILURE if pending.count != Test::FunctionBreakpointTest::REQUESTED_COUNT or pending.points[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX].verified
    function_names: mutable u8[Test::FunctionBreakpointTest::FUNCTION_NAME_LENGTH] = zeroed
    for name_index in 0..<Test::FunctionBreakpointTest::FUNCTION_NAME_LENGTH:
        function_names[name_index] <- Test::FunctionBreakpointTest::FUNCTION_NAME.cast[u8&][name_index]
    name_lengths: mutable usize[Test::FunctionBreakpointTest::REQUESTED_COUNT] = zeroed
    name_lengths[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX] <- Test::FunctionBreakpointTest::FUNCTION_NAME_LENGTH
    replacement: DebuggerManagedService::FunctionBreakpointResult = DebuggerManagedService::service_replace_function_breakpoints(service, function_names[request_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX]], Test::FunctionBreakpointTest::FUNCTION_NAME_LENGTH, request_offsets[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX], name_lengths[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX], Test::FunctionBreakpointTest::REQUESTED_COUNT)
    return Test::FunctionBreakpointTest::REPLACEMENT_FAILURE if not replacement.accepted or replacement.count != Test::FunctionBreakpointTest::REQUESTED_COUNT or not replacement.points[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX].verified or service.controller.state.breakpoints.count != Test::FunctionBreakpointTest::TOTAL_BREAKPOINT_COUNT or service.controller.state.breakpoints.points[Test::FunctionBreakpointTest::SOURCE_BREAKPOINT_INDEX].id.value != retained_source_id.value or service.controller.state.breakpoints.points[Test::FunctionBreakpointTest::SOURCE_BREAKPOINT_INDEX].status != DebuggerBreakpoints::BreakpointStatus.Verified
    hit_target: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_hit_target(service, replacement.points[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX].id, Test::FunctionBreakpointTest::CONDITION_HIT_TARGET)
    return Test::FunctionBreakpointTest::HIT_TARGET_FAILURE if not hit_target.accepted
    condition_applied: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_condition(service, replacement.points[Test::FunctionBreakpointTest::FIRST_REQUEST_INDEX].id, Test::FunctionBreakpointTest::CONDITION.cast[u8&], Test::FunctionBreakpointTest::CONDITION_LENGTH)
    return Test::FunctionBreakpointTest::CONDITION_FAILURE if not condition_applied.accepted
    continue_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Continue, id: Test::FunctionBreakpointTest::REQUEST_ID, has_id: true, expected_generation: Test::FunctionBreakpointTest::NO_EXPECTED_GENERATION, target_event: Test::FunctionBreakpointTest::NO_TARGET_EVENT, valid: true}
    continued: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, continue_request)
    return Test::FunctionBreakpointTest::CONTINUE_FAILURE if not continued.accepted
    return Test::FunctionBreakpointTest::STOP_POSITION_FAILURE if service.controller.engine.event_count != Test::FunctionBreakpointTest::FIRST_EVENT or service.controller.engine.machine.program_counter != Test::FunctionBreakpointTest::FIRST_FUNCTION_ENTRY or service.controller.engine.machine.return_stack_pointer != Test::FunctionBreakpointTest::CALLEE_FRAME_DEPTH or service.controller.session.state != DebuggerSession::SessionState.Stopped
    return Test::FunctionBreakpointTest::HIT_COUNT_FAILURE if service.controller.state.breakpoints.points[Test::FunctionBreakpointTest::FUNCTION_BREAKPOINT_INDEX].hit_count != Test::FunctionBreakpointTest::CONDITION_HIT_TARGET
    return Test::FunctionBreakpointTest::HIT_COUNT_FAILURE if service.controller.state.breakpoints.points[Test::FunctionBreakpointTest::SOURCE_BREAKPOINT_INDEX].hit_count != Test::FunctionBreakpointTest::CONDITION_HIT_TARGET
    continued_overload: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, continue_request)
    return Test::FunctionBreakpointTest::OVERLOAD_ENTRY_FAILURE if not continued_overload.accepted or service.controller.engine.event_count != Test::FunctionBreakpointTest::SECOND_EVENT or service.controller.engine.machine.program_counter != Test::FunctionBreakpointTest::SECOND_FUNCTION_ENTRY or service.controller.session.state != DebuggerSession::SessionState.Stopped
    return Test::FunctionBreakpointTest::OVERLOAD_HIT_COUNT_FAILURE if service.controller.state.breakpoints.points[Test::FunctionBreakpointTest::FUNCTION_BREAKPOINT_INDEX].hit_count != Test::FunctionBreakpointTest::CONDITION_HIT_TARGET + Test::FunctionBreakpointTest::HIT_COUNT_INCREMENT
    return 0

def check_managed_source_step_over() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, managed_source_step_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_over(controller)
    return 3 if not DebuggerErrors::error_is_ok(failure) or controller.engine.event_count != Test::MANAGED_REGRESSION_NEXT_INSTRUCTION or controller.engine.machine.program_counter != Test::MANAGED_REGRESSION_NEXT_INSTRUCTION.u64()
    return 0

def check_managed_step_over_destination_breakpoint() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, managed_source_step_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::MANAGED_REGRESSION_LATER_SOURCE_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return 2 if breakpoint.value == 0 or controller.state.breakpoints.points[0].status != DebuggerBreakpoints::BreakpointStatus.Verified
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_over(controller)
    return 3 if not DebuggerErrors::error_is_ok(failure) or controller.engine.event_count != Test::MANAGED_REGRESSION_NEXT_INSTRUCTION.u64() or controller.engine.machine.program_counter != Test::MANAGED_REGRESSION_NEXT_INSTRUCTION.u64()
    return 4 if controller.state.breakpoints.points[0].hit_count != 1
    return 0

def check_managed_step_out_destination_breakpoint() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, managed_call_breakpoint_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.machine.return_stack_pointer == 0
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::MANAGED_REGRESSION_LATER_SOURCE_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return 3 if breakpoint.value == 0 or controller.state.breakpoints.points[0].status != DebuggerBreakpoints::BreakpointStatus.Verified
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_out(controller)
    return 4 if not DebuggerErrors::error_is_ok(failure) or controller.engine.event_count != Test::MANAGED_STEP_OUT_DESTINATION_EXPECTED_EVENTS or controller.engine.machine.program_counter != Test::MANAGED_REGRESSION_CALLER_RESUME_INSTRUCTION.u64()
    return 5 if controller.state.breakpoints.points[0].hit_count != 1
    return 0

def check_managed_step_into_enters_callee() -> i64:
    image: DebuggerEDIR::ProgramImage = managed_call_breakpoint_image()
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, image)
    return Test::StepInto::ENGINE_LIFECYCLE_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::MANAGED_REGRESSION_CALLEE_SOURCE_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return Test::StepInto::BREAKPOINT_RESOLUTION_FAILURE if breakpoint.value == Test::BreakpointCondition::NO_BREAKPOINT_ID or controller.state.breakpoints.points[Test::StepInto::BREAKPOINT_SLOT].status != DebuggerBreakpoints::BreakpointStatus.Verified
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_into(controller)
    return Test::StepInto::ENGINE_STEP_FAILURE if not DebuggerErrors::error_is_ok(failure)
    return Test::StepInto::ENGINE_POSITION_FAILURE if controller.engine.event_count != Test::StepInto::EXPECTED_EVENT_COUNT or controller.engine.machine.program_counter != Test::MANAGED_REGRESSION_CALLEE_INSTRUCTION.u64() or controller.engine.machine.return_stack_pointer != Test::StepInto::EXPECTED_FRAME_DEPTH or controller.state.breakpoints.points[Test::StepInto::BREAKPOINT_SLOT].hit_count != Test::BreakpointCondition::HIT_COUNT

    source_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(source_controller, managed_source_step_image())
    return Test::StepInto::ENGINE_LIFECYCLE_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(source_controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(source_controller))
    source_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_into(source_controller)
    return Test::StepInto::ENGINE_STEP_FAILURE if not DebuggerErrors::error_is_ok(source_failure)
    return Test::StepInto::SOURCE_POSITION_FAILURE if source_controller.engine.event_count != Test::StepInto::SOURCE_STEP_EVENT_COUNT or source_controller.engine.machine.program_counter != Test::MANAGED_REGRESSION_NEXT_INSTRUCTION.u64()

    seed_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(seed_controller, image)
    service: mutable DebuggerManagedService::Service
    DebuggerManagedService::service_initialize(service, seed_controller.session, image, DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_RECORDING_ID))
    launch_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: Test::NO_EXPECTED_GENERATION, target_event: Test::NO_TARGET_EVENT, valid: true}
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, launch_request)
    return Test::StepInto::SERVICE_LIFECYCLE_FAILURE if not launched.accepted
    pause_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Pause, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: Test::NO_EXPECTED_GENERATION, target_event: Test::NO_TARGET_EVENT, valid: true}
    paused: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, pause_request)
    return Test::StepInto::SERVICE_LIFECYCLE_FAILURE if not paused.accepted
    stepped: DebuggerManagedService::Result = DebuggerManagedService::service_step_into(service)
    return Test::StepInto::SERVICE_STEP_FAILURE if not stepped.accepted
    timeline: DebuggerTimeline::Timeline = DebuggerManagedService::service_timeline(service)
    return Test::StepInto::SERVICE_SYNC_FAILURE if timeline.bounds.current != Test::StepInto::EXPECTED_EVENT_COUNT.u64() or service.controller.engine.machine.program_counter != Test::MANAGED_REGRESSION_CALLEE_INSTRUCTION.u64() or service.controller.engine.machine.return_stack_pointer != Test::StepInto::EXPECTED_FRAME_DEPTH
    return 0

def check_managed_source_breakpoint_resume() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, managed_source_step_image())
    return Test::MANAGED_SOURCE_BREAKPOINT_NO_ID if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::MANAGED_REGRESSION_NEXT_SOURCE_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return Test::MANAGED_SOURCE_BREAKPOINT_NO_ID if breakpoint.value == 0 or controller.state.breakpoints.resolved_instructions[0] != Test::MANAGED_REGRESSION_INITIAL_INSTRUCTION.u64()
    first_continue: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::MANAGED_SOURCE_BREAKPOINT_FIRST_CONTINUE if not DebuggerErrors::error_is_ok(first_continue) or controller.engine.event_count != Test::MANAGED_SOURCE_BREAKPOINT_EXPECTED_EVENT or controller.engine.machine.program_counter != Test::MANAGED_SOURCE_BREAKPOINT_EXPECTED_EVENT.u64() or controller.state.breakpoints.points[0].hit_count != Test::MANAGED_SOURCE_BREAKPOINT_EXPECTED_HITS
    second_continue: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::MANAGED_SOURCE_BREAKPOINT_SECOND_CONTINUE if not DebuggerErrors::error_is_ok(second_continue) or controller.engine.event_count != Test::MANAGED_REGRESSION_SOURCE_STEP_INSTRUCTION_COUNT.usize() or not controller.engine.machine.halted or controller.state.breakpoints.points[0].hit_count != Test::MANAGED_SOURCE_BREAKPOINT_EXPECTED_HITS
    reverse_continue: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_continue(controller)
    return Test::MANAGED_SOURCE_BREAKPOINT_REVERSE_CONTINUE if not DebuggerErrors::error_is_ok(reverse_continue) or controller.engine.event_count != Test::MANAGED_SOURCE_BREAKPOINT_EXPECTED_EVENT or controller.state.breakpoints.points[0].hit_count != Test::MANAGED_SOURCE_BREAKPOINT_EXPECTED_HITS
    return 0

def check_managed_conditional_breakpoint() -> i64:
    image: DebuggerEDIR::ProgramImage = managed_conditional_breakpoint_image()
    true_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(true_controller, image)
    return Test::BreakpointCondition::TRUE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(true_controller))
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::BreakpointCondition::TARGET_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    true_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(true_controller, location)
    return Test::BreakpointCondition::TRUE_CHECK_FAILURE if true_id.value == Test::BreakpointCondition::NO_BREAKPOINT_ID
    for index in 0..<Test::BreakpointCondition::TRUE_EXPRESSION_LENGTH:
        true_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].condition_expression[index] <- Test::BreakpointCondition::TRUE_EXPRESSION.cast[u8&][index]
    true_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].condition_length <- Test::BreakpointCondition::TRUE_EXPRESSION_LENGTH
    true_hit: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(true_controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::BreakpointCondition::TRUE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(true_hit) or true_controller.engine.event_count != Test::BreakpointCondition::TARGET_EVENT or true_controller.engine.machine.locals[Test::BreakpointCondition::LOCAL_INDEX.usize()] != Test::BreakpointCondition::SETUP_VALUE or true_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].hit_count != Test::BreakpointCondition::HIT_COUNT
    true_completion: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(true_controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::BreakpointCondition::TRUE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(true_completion) or not true_controller.engine.machine.halted
    true_reverse: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_continue(true_controller)
    return Test::BreakpointCondition::TRUE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(true_reverse) or true_controller.engine.event_count != Test::BreakpointCondition::TARGET_EVENT

    false_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(false_controller, image)
    return Test::BreakpointCondition::FALSE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(false_controller))
    false_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(false_controller, location)
    return Test::BreakpointCondition::FALSE_CHECK_FAILURE if false_id.value == Test::BreakpointCondition::NO_BREAKPOINT_ID
    for index in 0..<Test::BreakpointCondition::FALSE_EXPRESSION_LENGTH:
        false_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].condition_expression[index] <- Test::BreakpointCondition::FALSE_EXPRESSION.cast[u8&][index]
    false_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].condition_length <- Test::BreakpointCondition::FALSE_EXPRESSION_LENGTH
    false_continue: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(false_controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::BreakpointCondition::FALSE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(false_continue) or not false_controller.engine.machine.halted or false_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].hit_count != Test::BreakpointCondition::HIT_COUNT
    false_reverse: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_continue(false_controller)
    return Test::BreakpointCondition::FALSE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(false_reverse) or false_controller.engine.event_count != 0

    unavailable_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(unavailable_controller, image)
    return Test::BreakpointCondition::UNAVAILABLE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(unavailable_controller))
    setup_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::BreakpointCondition::SETUP_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    unavailable_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(unavailable_controller, setup_location)
    return Test::BreakpointCondition::UNAVAILABLE_CHECK_FAILURE if unavailable_id.value == Test::BreakpointCondition::NO_BREAKPOINT_ID
    for index in 0..<Test::BreakpointCondition::TRUE_EXPRESSION_LENGTH:
        unavailable_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].condition_expression[index] <- Test::BreakpointCondition::TRUE_EXPRESSION.cast[u8&][index]
    unavailable_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].condition_length <- Test::BreakpointCondition::TRUE_EXPRESSION_LENGTH
    unavailable_hit: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(unavailable_controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::BreakpointCondition::UNAVAILABLE_CHECK_FAILURE if unavailable_hit.code != DebuggerErrors::ErrorCode.Unavailable or unavailable_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].status != DebuggerBreakpoints::BreakpointStatus.Verified or unavailable_controller.engine.event_count != Test::NO_TARGET_EVENT.usize() or not unavailable_controller.has_last_breakpoint_stop
    unavailable_resume: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(unavailable_controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::BreakpointCondition::UNAVAILABLE_CHECK_FAILURE if not DebuggerErrors::error_is_ok(unavailable_resume) or not unavailable_controller.engine.machine.halted

    invalid_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(invalid_controller, image)
    return Test::BreakpointCondition::INVALID_CHECK_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(invalid_controller))
    invalid_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(invalid_controller, location)
    return Test::BreakpointCondition::INVALID_CHECK_FAILURE if invalid_id.value == Test::BreakpointCondition::NO_BREAKPOINT_ID
    for index in 0..<Test::BreakpointCondition::INVALID_EXPRESSION_LENGTH:
        invalid_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].condition_expression[index] <- Test::BreakpointCondition::INVALID_EXPRESSION.cast[u8&][index]
    invalid_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].condition_length <- Test::BreakpointCondition::INVALID_EXPRESSION_LENGTH
    invalid_hit: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(invalid_controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::BreakpointCondition::INVALID_CHECK_FAILURE if invalid_hit.code != DebuggerErrors::ErrorCode.InvalidArgument or invalid_controller.state.breakpoints.points[Test::BreakpointCondition::BREAKPOINT_SLOT].status != DebuggerBreakpoints::BreakpointStatus.Disabled or invalid_controller.engine.event_count != Test::BreakpointCondition::TARGET_EVENT
    return Test::BreakpointCondition::SUCCESS_RESULT

def check_managed_logpoint() -> i64:
    image: DebuggerEDIR::ProgramImage = managed_conditional_breakpoint_image()
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::BreakpointCondition::TARGET_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, image)
    return Test::Logpoint::RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    breakpoint_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return Test::Logpoint::RESULT_FAILURE if breakpoint_id.value == Test::BreakpointCondition::NO_BREAKPOINT_ID
    point: usize = Test::Logpoint::BREAKPOINT_SLOT
    for index in 0..<Test::Logpoint::MESSAGE_LENGTH:
        controller.state.breakpoints.points[point].log_message[index] <- Test::Logpoint::MESSAGE.cast[u8&][index]
    controller.state.breakpoints.points[point].log_message_length <- Test::Logpoint::MESSAGE_LENGTH
    controller.state.breakpoints.points[point].logpoint <- true
    for index in 0..<Test::BreakpointCondition::TRUE_EXPRESSION_LENGTH:
        controller.state.breakpoints.points[point].condition_expression[index] <- Test::BreakpointCondition::TRUE_EXPRESSION.cast[u8&][index]
    controller.state.breakpoints.points[point].condition_length <- Test::BreakpointCondition::TRUE_EXPRESSION_LENGTH
    continue_result: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::Logpoint::RESULT_FAILURE if not DebuggerErrors::error_is_ok(continue_result) or not controller.engine.machine.halted or controller.has_last_breakpoint_stop or controller.state.breakpoints.points[point].hit_count != Test::Logpoint::HIT_COUNT
    return Test::Logpoint::RESULT_FAILURE if controller.log_output_length != Test::Logpoint::EXPECTED_OUTPUT_LENGTH or controller.log_output[Test::Logpoint::MESSAGE_LOCAL_VALUE_INDEX] != Test::Logpoint::EXPECTED_LOCAL_VALUE_BYTE or controller.log_output[Test::Logpoint::MESSAGE_NEWLINE_INDEX] != Test::Logpoint::EXPECTED_NEWLINE_BYTE

    false_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(false_controller, image)
    return Test::Logpoint::RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(false_controller))
    false_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(false_controller, location)
    return Test::Logpoint::RESULT_FAILURE if false_id.value == Test::BreakpointCondition::NO_BREAKPOINT_ID
    for index in 0..<Test::Logpoint::MESSAGE_LENGTH:
        false_controller.state.breakpoints.points[point].log_message[index] <- Test::Logpoint::MESSAGE.cast[u8&][index]
    false_controller.state.breakpoints.points[point].log_message_length <- Test::Logpoint::MESSAGE_LENGTH
    false_controller.state.breakpoints.points[point].logpoint <- true
    for index in 0..<Test::Logpoint::FALSE_EXPRESSION_LENGTH:
        false_controller.state.breakpoints.points[point].condition_expression[index] <- Test::Logpoint::FALSE_EXPRESSION.cast[u8&][index]
    false_controller.state.breakpoints.points[point].condition_length <- Test::Logpoint::FALSE_EXPRESSION_LENGTH
    false_result: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(false_controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::Logpoint::RESULT_FAILURE if not DebuggerErrors::error_is_ok(false_result) or not false_controller.engine.machine.halted or false_controller.log_output_length != Test::Logpoint::EMPTY_OUTPUT_LENGTH

    invalid_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(invalid_controller, image)
    return Test::Logpoint::RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(invalid_controller))
    invalid_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(invalid_controller, location)
    return Test::Logpoint::RESULT_FAILURE if invalid_id.value == Test::BreakpointCondition::NO_BREAKPOINT_ID
    for index in 0..<Test::Logpoint::INVALID_MESSAGE_LENGTH:
        invalid_controller.state.breakpoints.points[point].log_message[index] <- Test::Logpoint::INVALID_MESSAGE.cast[u8&][index]
    invalid_controller.state.breakpoints.points[point].log_message_length <- Test::Logpoint::INVALID_MESSAGE_LENGTH
    invalid_controller.state.breakpoints.points[point].logpoint <- true
    invalid_result: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(invalid_controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return Test::Logpoint::RESULT_FAILURE if invalid_result.code != DebuggerErrors::ErrorCode.InvalidArgument or invalid_controller.engine.event_count != Test::BreakpointCondition::TARGET_EVENT or invalid_controller.log_output_length != Test::Logpoint::PARTIAL_OUTPUT_LENGTH
    return 0

def check_managed_top_level_step_out() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, managed_source_step_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_out(controller)
    return 2 if not DebuggerErrors::error_is_ok(failure)
    return 3 if controller.engine.event_count != Test::MANAGED_REGRESSION_SOURCE_STEP_INSTRUCTION_COUNT.usize() or not controller.engine.machine.halted or controller.engine.machine.result != Test::EXPECTED_RESULT
    return 0

def check_managed_compound_step_breakpoints() -> i64:
    image: DebuggerEDIR::ProgramImage = managed_call_breakpoint_image()
    over_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(over_controller, image)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(over_controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(over_controller))
    over_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::MANAGED_REGRESSION_CALLEE_SOURCE_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    over_breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(over_controller, over_location)
    return 2 if over_breakpoint.value == 0
    over_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_over(over_controller)
    return 3 if not DebuggerErrors::error_is_ok(over_failure) or over_controller.engine.event_count != 1 or over_controller.engine.machine.program_counter != Test::MANAGED_REGRESSION_CALLEE_INSTRUCTION.u64() or over_controller.state.breakpoints.points[0].hit_count != 1

    out_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(out_controller, image)
    return 4 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(out_controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(out_controller))
    return 5 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(out_controller)) or out_controller.engine.machine.return_stack_pointer == 0
    out_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::MANAGED_REGRESSION_CALLEE_RETURN_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    out_breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(out_controller, out_location)
    return 6 if out_breakpoint.value == 0
    out_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step_out(out_controller)
    return 70 if not DebuggerErrors::error_is_ok(out_failure)
    return 71 if out_controller.engine.event_count != 2
    return 72 if out_controller.engine.machine.program_counter != Test::MANAGED_REGRESSION_RETURN_INSTRUCTION.u64()
    return 73 if out_controller.engine.machine.return_stack_pointer == 0
    return 74 if out_controller.state.breakpoints.points[0].hit_count != 1
    return 0

def check_managed_parent_breakpoint_after_rewind() -> i64:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: Test::INSTRUCTION_COUNT, local_count: Test::MANAGED_REGRESSION_NO_LOCALS, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::EXPECTED_RESULT, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(Test::MANAGED_REGRESSION_PARENT_BREAKPOINT_LINE, 1)}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::MANAGED_REGRESSION_NO_OPERAND, b: Test::MANAGED_REGRESSION_NO_OPERAND, source: managed_regression_source_span(Test::MANAGED_REGRESSION_PARENT_RETURN_LINE, 2)}
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, image)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.event_count != 1
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::MANAGED_REGRESSION_SOURCE_FILE_ID), line: Test::MANAGED_REGRESSION_PARENT_BREAKPOINT_LINE, column: Test::MANAGED_REGRESSION_SOURCE_COLUMN, discriminator: 0}
    breakpoint: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_set_source_breakpoint(controller, location)
    return 3 if breakpoint.value == 0
    child_branch: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_create_branch(controller)
    return 4 if child_branch.value == 0 or controller.engine.branch.value != child_branch.value
    return 5 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_reverse_step(controller)) or controller.engine.event_count != 0 or controller.engine.branch.value != child_branch.value or DebuggerReplayEngine::replay_engine_branch_at(controller.engine, controller.engine.event_count.u64()).value == child_branch.value
    continue_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, Test::MANAGED_REGRESSION_EXPECTED_BRANCH_BREAKPOINT_STEPS)
    return 6 if not DebuggerErrors::error_is_ok(continue_failure) or controller.engine.event_count != 0 or controller.state.breakpoints.points[0].hit_count != 1
    return 0

def check_full_checkpoint_side_state_integrity() -> i64:
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, managed_source_step_image())
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller)) or not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(controller))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(controller)) or controller.engine.event_count != Test::TARGET_EVENT.usize()
    resource: DebuggerIdentity::DebugId = DebuggerVirtualResources::resources_open(controller.state.resources, DebuggerIdentity::debug_id(Test::MANAGED_CHECKPOINT_RESOURCE_PATH_ID), true, Test::MANAGED_CHECKPOINT_RESOURCE_GENERATION)
    return 3 if resource.value == 0
    resource_byte: mutable u8[Test::MANAGED_CHECKPOINT_RESOURCE_LENGTH] = zeroed
    resource_byte[0] <- Test::MANAGED_CHECKPOINT_RESOURCE_BYTE
    seeded: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seed(controller.state.resources, resource, resource_byte[0], Test::MANAGED_CHECKPOINT_RESOURCE_LENGTH)
    return 4 if not DebuggerErrors::error_is_ok(seeded)
    checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerManagedEngine::managed_full_checkpoint(controller)
    return 5 if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
    checkpoint.resources.files[0].bytes[0] <- Test::MANAGED_CHECKPOINT_MUTATED_RESOURCE_BYTE
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_restore_full_checkpoint(controller, checkpoint)
    return 6 if DebuggerErrors::error_is_ok(failure) or failure.code != DebuggerErrors::ErrorCode.Corrupt
    return 7 if controller.engine.event_count != Test::TARGET_EVENT.usize() or controller.engine.machine.accumulator != Test::EXPECTED_RESULT
    return 8 if controller.state.resources.count != 1 or controller.state.resources.files[0].bytes[0] != Test::MANAGED_CHECKPOINT_RESOURCE_BYTE
    return 0

def check_continue_history_limit_error() -> i64:
    history_capacity: usize = DebuggerReplayEngine::replay_engine_history_capacity()
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::MANAGED_REGRESSION_PROGRAM_VERSION, instruction_count: (history_capacity + Test::MANAGED_HISTORY_LIMIT_EXTRA_INSTRUCTIONS).u64(), local_count: Test::MANAGED_REGRESSION_NO_LOCALS, has_return: true}
    for index in 0..<history_capacity:
        image.instructions[index] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: Test::MANAGED_HISTORY_LIMIT_NO_OPERAND, b: Test::MANAGED_HISTORY_LIMIT_NO_OPERAND, source: zeroed}
    image.instructions[history_capacity] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::MANAGED_HISTORY_LIMIT_NO_OPERAND, b: Test::MANAGED_HISTORY_LIMIT_NO_OPERAND, source: zeroed}
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    managed_regression_controller(controller, image)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(controller))
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(controller, history_capacity.u64())
    return 2 if failure.code != DebuggerErrors::ErrorCode.ResourceLimit or failure.retryable or controller.engine.event_count != history_capacity or controller.session.state != DebuggerSession::SessionState.Stopped or controller.engine.machine.halted or controller.engine.machine.faulted
    return 0

def check_service_resource_mount() -> bool:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::ResourceMount::BUILD_COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(Test::ResourceMount::BUILD_RUNTIME_ID),
        source: DebuggerIdentity::debug_id(Test::ResourceMount::BUILD_SOURCE_ID),
        target: DebuggerIdentity::debug_id(Test::ResourceMount::BUILD_TARGET_ID),
        metadata_version: Test::ResourceMount::METADATA_VERSION
    }
    session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::ResourceMount::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::ResourceMount::PROGRAM_VERSION, instruction_count: Test::ResourceMount::INSTRUCTION_COUNT, local_count: Test::ResourceMount::LOCAL_COUNT, has_return: true}
    image.instructions[Test::ResourceMount::FIRST_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::ResourceMount::PROGRAM_RESULT, b: Test::ResourceMount::UNUSED_OPERAND, source: zeroed}
    image.instructions[Test::ResourceMount::RETURN_INSTRUCTION] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::ResourceMount::UNUSED_OPERAND, b: Test::ResourceMount::UNUSED_OPERAND, source: zeroed}
    service: mutable DebuggerManagedService::Service = zeroed
    DebuggerManagedService::service_initialize(service, session, image, DebuggerIdentity::debug_id(Test::ResourceMount::RECORDING_ID))
    bytes: mutable u8[Test::ResourceMount::RESOURCE_LENGTH] = [Test::ResourceMount::RESOURCE_BYTE]
    mounted: DebuggerManagedService::ResourceMountResult = DebuggerManagedService::service_mount_resource(service, DebuggerIdentity::debug_id(Test::ResourceMount::RESOURCE_PATH_ID), false, Test::ResourceMount::RESOURCE_GENERATION, bytes[Test::ResourceMount::FIRST_INDEX], Test::ResourceMount::RESOURCE_LENGTH)
    return false if not mounted.accepted or mounted.handle.value != Test::ResourceMount::FIRST_HANDLE or not DebuggerManagedService::service_is_exact(service)
    return false if not service.controller.state.resources.files[Test::ResourceMount::FIRST_INDEX].mounted or service.controller.state.resources.files[Test::ResourceMount::FIRST_INDEX].bytes[Test::ResourceMount::FIRST_INDEX] != Test::ResourceMount::RESOURCE_BYTE
    return false if service.timeline.position.event != Test::ResourceMount::INITIAL_EVENT or service.timeline.bounds.current != Test::ResourceMount::INITIAL_EVENT
    launched: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_launch(service.controller)
    return false if not DebuggerErrors::error_is_ok(launched)
    late_mount: DebuggerManagedService::ResourceMountResult = DebuggerManagedService::service_mount_resource(service, DebuggerIdentity::debug_id(Test::ResourceMount::RESOURCE_PATH_ID + Test::ResourceMount::ONE_COUNT.u64()), false, Test::ResourceMount::RESOURCE_GENERATION, bytes[Test::ResourceMount::FIRST_INDEX], Test::ResourceMount::RESOURCE_LENGTH)
    return false if late_mount.accepted or late_mount.failure.code != DebuggerErrors::ErrorCode.InvalidState or service.controller.state.resources.count != Test::ResourceMount::ONE_COUNT

    native_session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::ResourceMount::SESSION_ID + Test::ResourceMount::ONE_COUNT.u64()), build, DebuggerCapabilities::native_attach_capabilities())
    native_service: mutable DebuggerManagedService::Service = zeroed
    DebuggerManagedService::service_initialize(native_service, native_session, image, DebuggerIdentity::debug_id(Test::ResourceMount::RECORDING_ID + Test::ResourceMount::ONE_COUNT.u64()))
    unsupported: DebuggerManagedService::ResourceMountResult = DebuggerManagedService::service_mount_resource(native_service, DebuggerIdentity::debug_id(Test::ResourceMount::RESOURCE_PATH_ID), false, Test::ResourceMount::RESOURCE_GENERATION, bytes[Test::ResourceMount::FIRST_INDEX], Test::ResourceMount::RESOURCE_LENGTH)
    return not unsupported.accepted and unsupported.failure.code == DebuggerErrors::ErrorCode.Unsupported

def main() -> i64:
    return Test::ResourceMount::FAILURE if not check_service_resource_mount()
    source_step_over_status: i64 = check_managed_source_step_over()
    return Test::MANAGED_SOURCE_STEP_CHECK_RESULT if source_step_over_status != 0
    destination_breakpoint_status: i64 = check_managed_step_over_destination_breakpoint()
    return Test::MANAGED_STEP_OVER_DESTINATION_BREAKPOINT_RESULT if destination_breakpoint_status != 0
    step_out_destination_breakpoint_status: i64 = check_managed_step_out_destination_breakpoint()
    return Test::MANAGED_STEP_OUT_DESTINATION_BREAKPOINT_RESULT if step_out_destination_breakpoint_status != 0
    step_into_status: i64 = check_managed_step_into_enters_callee()
    return Test::StepInto::CHECK_RESULT + step_into_status if step_into_status != 0
    function_breakpoint_status: i64 = check_managed_function_breakpoints()
    return Test::FunctionBreakpointTest::CHECK_RESULT + function_breakpoint_status if function_breakpoint_status != 0
    source_breakpoint_resume_status: i64 = check_managed_source_breakpoint_resume()
    return Test::MANAGED_SOURCE_BREAKPOINT_RESUME_RESULT if source_breakpoint_resume_status != 0
    conditional_breakpoint_status: i64 = check_managed_conditional_breakpoint()
    return conditional_breakpoint_status if conditional_breakpoint_status != 0
    logpoint_status: i64 = check_managed_logpoint()
    return logpoint_status if logpoint_status != 0
    reverse_compound_status: i64 = check_managed_reverse_compound_steps()
    return ManagedReverseResult::CHECK_FAILURE_BASE + reverse_compound_status if reverse_compound_status != ManagedReverseResult::SUCCESS
    reverse_route_status: i64 = check_managed_reverse_protocol_route()
    return ManagedReverseRoute::CHECK_FAILURE_BASE + reverse_route_status if reverse_route_status != ManagedReverseRoute::SUCCESS
    top_level_step_out_status: i64 = check_managed_top_level_step_out()
    return Test::MANAGED_TOP_LEVEL_STEP_OUT_CHECK_RESULT if top_level_step_out_status != 0
    compound_step_breakpoint_status: i64 = check_managed_compound_step_breakpoints()
    return Test::MANAGED_COMPOUND_BREAKPOINT_CHECK_RESULT if compound_step_breakpoint_status != 0
    parent_breakpoint_status: i64 = check_managed_parent_breakpoint_after_rewind()
    return Test::MANAGED_PARENT_BREAKPOINT_CHECK_RESULT if parent_breakpoint_status != 0
    checkpoint_side_state_status: i64 = check_full_checkpoint_side_state_integrity()
    return Test::MANAGED_CHECKPOINT_SIDE_STATE_CHECK_RESULT if checkpoint_side_state_status != 0
    history_limit_status: i64 = check_continue_history_limit_error()
    return Test::MANAGED_HISTORY_LIMIT_CHECK_RESULT if history_limit_status != 0
    allocation_service_status: i64 = check_managed_allocations_service()
    return allocation_service_status if allocation_service_status != 0
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::INSTRUCTION_COUNT, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::EXPECTED_RESULT, b: 0, source: zeroed}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(Test::BREAKPOINT_FILE_ID), start_byte: 1, end_byte: 2, start_line: Test::BREAKPOINT_LINE, start_column: 1, end_line: Test::BREAKPOINT_LINE, end_column: 2, discriminator: 0}}
    service: mutable DebuggerManagedService::Service
    DebuggerManagedService::service_initialize(service, session, image, DebuggerIdentity::debug_id(9))
    open_trace_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.OpenTrace, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    open_trace: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, open_trace_request)
    return Test::TRACE_LIFECYCLE_UNSUPPORTED_RESULT if open_trace.accepted or open_trace.failure.code != DebuggerErrors::ErrorCode.Unsupported or service.controller.session.state != DebuggerSession::SessionState.Created or service.controller.engine.event_count != 0
    replay_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Replay, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    replay: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, replay_request)
    return Test::TRACE_LIFECYCLE_UNSUPPORTED_RESULT if replay.accepted or replay.failure.code != DebuggerErrors::ErrorCode.Unsupported or service.controller.session.state != DebuggerSession::SessionState.Created or service.controller.engine.event_count != 0
    discover_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Discover, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    discovered: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, discover_request)
    return 13 if not discovered.accepted
    threads_before_launch_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Threads, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: Test::NO_EXPECTED_GENERATION, target_event: Test::NO_TARGET_EVENT, valid: true}
    threads_before_launch: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, threads_before_launch_request)
    return Test::MANAGED_THREAD_BEFORE_LAUNCH_RESULT if threads_before_launch.accepted or threads_before_launch.failure.code != DebuggerErrors::ErrorCode.Unavailable
    launch_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, launch_request)
    return 1 if not launched.accepted
    threads_while_running: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, threads_before_launch_request)
    return Test::MANAGED_THREAD_RUNNING_RESULT if not threads_while_running.accepted
    pause_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Pause, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    paused: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, pause_request)
    return 2 if not paused.accepted
    step_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    stepped: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, step_request)
    return 3 if not stepped.accepted
    ready_timeline: DebuggerTimeline::Timeline = DebuggerManagedService::service_timeline(service)
    return Test::HistoryEligibility::SERVICE_STATUS_FAILURE if not ready_timeline.eligibility.can_reverse or not ready_timeline.eligibility.can_seek or ready_timeline.eligibility.reason != DebuggerTimeline::HistoryEligibilityReason.Ready
    frame: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedService::service_frame(service)
    return 4 if frame.accumulator != Test::EXPECTED_RESULT or frame.event != Test::TARGET_EVENT or frame.instruction.value != Test::TARGET_EVENT
    evaluation_session: DebuggerSession::Session = session
    evaluation_session.state <- DebuggerSession::SessionState.Stopped
    evaluation_image: mutable DebuggerEDIR::ProgramImage = image
    evaluation_image.program.local_count <- Test::EVALUATION_LOCAL_COUNT
    evaluation_service: mutable DebuggerManagedService::Service
    DebuggerManagedService::service_initialize(evaluation_service, evaluation_session, evaluation_image, DebuggerIdentity::debug_id(Test::EVALUATION_SERVICE_ID))
    evaluation_service.controller.engine.machine.locals[Test::EVALUATION_ZERO_LOCAL_INDEX] <- Test::EVALUATION_LOCAL_VALUE
    evaluation_service.controller.engine.machine.locals_initialized[Test::EVALUATION_ZERO_LOCAL_INDEX] <- true
    evaluation_service.controller.engine.machine.globals[Test::EVALUATION_ZERO_GLOBAL_INDEX] <- Test::EVALUATION_GLOBAL_VALUE
    evaluation_service.controller.engine.machine.globals_initialized[Test::EVALUATION_ZERO_GLOBAL_INDEX] <- true
    evaluated: DebuggerManagedService::EvaluateResult = DebuggerManagedService::service_evaluate_expression(evaluation_service, Test::EVALUATION_EXPRESSION.cast[u8&], Test::EVALUATION_EXPRESSION_LENGTH, Test::EVALUATION_MAIN_FRAME_INDEX)
    return Test::RESULT_EVALUATION_VALUE if not evaluated.accepted or evaluated.value != Test::EVALUATION_EXPECTED_VALUE or evaluated.consumed != Test::EVALUATION_EXPRESSION_LENGTH
    unavailable_evaluation: DebuggerManagedService::EvaluateResult = DebuggerManagedService::service_evaluate_expression(evaluation_service, Test::EVALUATION_UNAVAILABLE_EXPRESSION.cast[u8&], Test::EVALUATION_UNAVAILABLE_EXPRESSION_LENGTH, Test::EVALUATION_MAIN_FRAME_INDEX)
    return Test::RESULT_EVALUATION_UNAVAILABLE if unavailable_evaluation.accepted or unavailable_evaluation.failure.code != DebuggerErrors::ErrorCode.Unavailable
    unknown_evaluation: DebuggerManagedService::EvaluateResult = DebuggerManagedService::service_evaluate_expression(evaluation_service, Test::EVALUATION_UNKNOWN_EXPRESSION.cast[u8&], Test::EVALUATION_UNKNOWN_EXPRESSION_LENGTH, Test::EVALUATION_MAIN_FRAME_INDEX)
    return Test::RESULT_EVALUATION_UNKNOWN if unknown_evaluation.accepted or unknown_evaluation.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    invalid_frame_evaluation: DebuggerManagedService::EvaluateResult = DebuggerManagedService::service_evaluate_expression(evaluation_service, Test::EVALUATION_EXPRESSION.cast[u8&], Test::EVALUATION_EXPRESSION_LENGTH, Test::EVALUATION_INVALID_FRAME)
    return Test::RESULT_EVALUATION_FRAME if invalid_frame_evaluation.accepted or invalid_frame_evaluation.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    evaluation_service.controller.engine.machine.return_stack_pointer <- 1
    current_frame_slot: usize = DebuggerEDIR::frame_local_slot(Test::EVALUATION_CURRENT_FRAME_DEPTH, Test::EVALUATION_ZERO_LOCAL_INDEX)
    caller_frame_slot: usize = DebuggerEDIR::frame_local_slot(Test::EVALUATION_ROOT_FRAME_DEPTH, Test::EVALUATION_ZERO_LOCAL_INDEX)
    evaluation_service.controller.engine.machine.frame_locals[current_frame_slot] <- Test::EVALUATION_LOCAL_VALUE
    evaluation_service.controller.engine.machine.frame_locals_initialized[current_frame_slot] <- true
    evaluation_service.controller.engine.machine.frame_locals[caller_frame_slot] <- Test::EVALUATION_CALLER_VALUE
    evaluation_service.controller.engine.machine.frame_locals_initialized[caller_frame_slot] <- true
    caller_evaluation: DebuggerManagedService::EvaluateResult = DebuggerManagedService::service_evaluate_expression(evaluation_service, Test::EVALUATION_EXPRESSION.cast[u8&], Test::EVALUATION_EXPRESSION_LENGTH, Test::EVALUATION_CALLER_FRAME_INDEX)
    return Test::RESULT_EVALUATION_CALLER_FRAME if not caller_evaluation.accepted or caller_evaluation.value != Test::EVALUATION_EXPECTED_CALLER_VALUE
    evaluation_breakpoint_location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(Test::BREAKPOINT_FILE_ID), line: Test::BREAKPOINT_LINE, column: Test::EVALUATION_BREAKPOINT_COLUMN, discriminator: 0}
    evaluation_breakpoint_id: DebuggerIdentity::DebugId = DebuggerManagedService::service_set_source_breakpoint(evaluation_service, evaluation_breakpoint_location)
    evaluation_hit_target: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_hit_target(evaluation_service, evaluation_breakpoint_id, Test::EVALUATION_BREAKPOINT_HIT_TARGET)
    return Test::RESULT_EVALUATION_HIT_TARGET if not evaluation_hit_target.accepted or evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].hit_target != Test::EVALUATION_BREAKPOINT_HIT_TARGET
    evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].hit_count <- Test::EVALUATION_BREAKPOINT_HIT_TARGET
    evaluation_hit_reset: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_hit_target(evaluation_service, evaluation_breakpoint_id, Test::EVALUATION_BREAKPOINT_HIT_TARGET)
    return Test::RESULT_EVALUATION_HIT_RESET if not evaluation_hit_reset.accepted or evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].hit_count != Test::EVALUATION_ZERO_HIT_COUNT
    evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].hit_count <- Test::EVALUATION_BREAKPOINT_HIT_TARGET
    condition_set: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_condition(evaluation_service, evaluation_breakpoint_id, Test::ConditionService::EXPRESSION.cast[u8&], Test::ConditionService::EXPRESSION_LENGTH)
    return Test::ConditionService::RESULT_SET_CONDITION if not condition_set.accepted or evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].condition_length != Test::ConditionService::EXPRESSION_LENGTH or evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].condition_expression[Test::ConditionService::FIRST_BYTE_INDEX] != Test::ConditionService::FIRST_EXPRESSION_BYTE or evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].hit_count != Test::EVALUATION_ZERO_HIT_COUNT
    evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].hit_count <- Test::EVALUATION_BREAKPOINT_HIT_TARGET
    condition_clear: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_condition(evaluation_service, evaluation_breakpoint_id, Test::ConditionService::EXPRESSION.cast[u8&], Test::ConditionService::EMPTY_EXPRESSION_LENGTH)
    return Test::ConditionService::RESULT_CLEAR_CONDITION if not condition_clear.accepted or evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].condition_length != Test::ConditionService::EMPTY_EXPRESSION_LENGTH or evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].hit_count != Test::EVALUATION_ZERO_HIT_COUNT
    log_message_set: DebuggerManagedService::Result = DebuggerManagedService::service_set_breakpoint_log_message(evaluation_service, evaluation_breakpoint_id, Test::ConditionService::LOG_MESSAGE.cast[u8&], Test::ConditionService::LOG_MESSAGE_LENGTH)
    return Test::ConditionService::RESULT_SET_LOG_MESSAGE if not log_message_set.accepted or not evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].logpoint or evaluation_service.controller.state.breakpoints.points[Test::EVALUATION_BREAKPOINT_SLOT].log_message_length != Test::ConditionService::LOG_MESSAGE_LENGTH
    continue_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Continue, id: Test::STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    continued_evaluation: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(evaluation_service, continue_request)
    return Test::ConditionService::RESULT_SET_LOG_MESSAGE if not continued_evaluation.accepted or not evaluation_service.controller.engine.machine.halted or evaluation_service.controller.log_output_length != Test::ConditionService::LOG_OUTPUT_LENGTH or evaluation_service.controller.log_output[Test::ConditionService::LOG_MESSAGE_LENGTH] != Test::ConditionService::LOG_OUTPUT_NEWLINE
