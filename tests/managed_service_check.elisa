    branch_id: DebuggerIdentity::DebugId = DebuggerManagedService::service_create_branch(service)
    return BRANCH_RESULT_FAILURE if branch_id.value == 0 or service.controller.engine.branch.value != branch_id.value
    intervention: DebuggerBranches::Intervention = DebuggerBranches::Intervention{event: TARGET_EVENT, kind: DebuggerBranches::InterventionKind.Value, target: DebuggerIdentity::debug_id(1), value_hash: 99}
