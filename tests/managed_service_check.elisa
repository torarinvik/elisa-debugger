    discover_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Discover, id: STEP_REQUEST_ID, has_id: true, expected_generation: 0, target_event: 0, valid: true}
