include "../src/protocol/managed_service.elisa"
include "../src/engine/default_image.elisa"
include "../src/core/capabilities.elisa"

const module Test:
    SOURCE_PATH_FILE_ID: u64 = 71
    SOURCE_PATH_LOGICAL_ID: u64 = 72
    SOURCE_PATH_CONTENT_ID: u64 = 73
    SOURCE_PATH_RECORDING_ID: u64 = 74
    SOURCE_PATH_SESSION_ID: u64 = 75
    SOURCE_PATH_BUILD_COMPILER_ID: u64 = 76
    SOURCE_PATH_BUILD_RUNTIME_ID: u64 = 77
    SOURCE_PATH_BUILD_DIGEST_ID: u64 = 78
    SOURCE_PATH_BUILD_TARGET_ID: u64 = 79
    SOURCE_PATH_METADATA_VERSION: u32 = 1
    SOURCE_PATH_FILE_PATH: cstr = "main.elisa"
    SOURCE_PATH_FILE_PATH_LENGTH: usize = 10
    SOURCE_PATH_UNC_ROOT: cstr = "//server/share"
    SOURCE_PATH_UNC_ROOT_LENGTH: usize = 14
    SOURCE_PATH_UNC_CLIENT_PATH: cstr = "//SERVER/SHARE/main.elisa"
    SOURCE_PATH_UNC_CLIENT_PATH_LENGTH: usize = 25
    SOURCE_PATH_WINDOWS_ROOT: cstr = "C:/Workspace"
    SOURCE_PATH_WINDOWS_ROOT_LENGTH: usize = 12
    SOURCE_PATH_WINDOWS_CLIENT_PATH: cstr = "c:/workspace/main.elisa"
    SOURCE_PATH_WINDOWS_CLIENT_PATH_LENGTH: usize = 23
    SOURCE_PATH_WINDOWS_MIXED_CLIENT_PATH: cstr = "c:/workspace/MAIN.elisa"
    SOURCE_PATH_WINDOWS_MIXED_CLIENT_PATH_LENGTH: usize = 23
    SOURCE_PATH_POSIX_ROOT: cstr = "/workspace"
    SOURCE_PATH_POSIX_ROOT_LENGTH: usize = 10
    SOURCE_PATH_POSIX_CASE_MISMATCH_PATH: cstr = "/workspace/MAIN.elisa"
    SOURCE_PATH_POSIX_CASE_MISMATCH_PATH_LENGTH: usize = 21
    SOURCE_PATH_INVALID_UTF8_ROOT_LENGTH: usize = 2
    SOURCE_PATH_INVALID_UTF8_ROOT_FIRST_BYTE: u8 = 47
    SOURCE_PATH_INVALID_UTF8_ROOT_INVALID_BYTE: u8 = 255
    SOURCE_PATH_NO_FILE_ID: u64 = 0
    SOURCE_PATH_WINDOWS_CASE_RESULT: i64 = 7
    SOURCE_PATH_POSIX_CASE_RESULT: i64 = 8

const module RootValidation:
    POSIX_ROOT_WITH_TRAILING_SEPARATOR: cstr = "/workspace/"
    POSIX_ROOT_WITH_TRAILING_SEPARATOR_LENGTH: usize = 11
    RELATIVE_ROOT: cstr = "workspace"
    RELATIVE_ROOT_LENGTH: usize = 9
    PATH_TRAVERSAL_ROOT: cstr = "/workspace/../outside"
    PATH_TRAVERSAL_ROOT_LENGTH: usize = 21
    TRAILING_SEPARATOR_ACCEPTANCE_FAILURE: i64 = 9
    RELATIVE_ROOT_REJECTION_RESULT: i64 = 10
    PATH_TRAVERSAL_REJECTION_RESULT: i64 = 11


def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::SOURCE_PATH_BUILD_COMPILER_ID), runtime: DebuggerIdentity::debug_id(Test::SOURCE_PATH_BUILD_RUNTIME_ID), source: DebuggerIdentity::debug_id(Test::SOURCE_PATH_BUILD_DIGEST_ID), target: DebuggerIdentity::debug_id(Test::SOURCE_PATH_BUILD_TARGET_ID), metadata_version: Test::SOURCE_PATH_METADATA_VERSION}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::SOURCE_PATH_SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    image: mutable DebuggerEDIR::ProgramImage = DebuggerDefaultImage::image_new()
    file: mutable DebuggerMetadata::SourceFile = zeroed
    file.id <- DebuggerIdentity::debug_id(Test::SOURCE_PATH_FILE_ID)
    file.logical_path <- DebuggerIdentity::debug_id(Test::SOURCE_PATH_LOGICAL_ID)
    file.content <- DebuggerIdentity::debug_id(Test::SOURCE_PATH_CONTENT_ID)
    file.line_count <- 1
    file.path_length <- Test::SOURCE_PATH_FILE_PATH_LENGTH
    for index in 0..<Test::SOURCE_PATH_FILE_PATH_LENGTH:
        file.path_bytes[index] <- Test::SOURCE_PATH_FILE_PATH.cast[u8&][index]
    image.source_file_count <- 1
    image.source_files[0] <- file
    service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, image, DebuggerIdentity::debug_id(Test::SOURCE_PATH_RECORDING_ID))

    return RootValidation::TRAILING_SEPARATOR_ACCEPTANCE_FAILURE if not DebuggerManagedEngine::managed_source_path_root_is_valid(RootValidation::POSIX_ROOT_WITH_TRAILING_SEPARATOR.cast[u8&], RootValidation::POSIX_ROOT_WITH_TRAILING_SEPARATOR_LENGTH)
    return RootValidation::RELATIVE_ROOT_REJECTION_RESULT if DebuggerManagedEngine::managed_source_path_root_is_valid(RootValidation::RELATIVE_ROOT.cast[u8&], RootValidation::RELATIVE_ROOT_LENGTH)
    return RootValidation::PATH_TRAVERSAL_REJECTION_RESULT if DebuggerManagedEngine::managed_source_path_root_is_valid(RootValidation::PATH_TRAVERSAL_ROOT.cast[u8&], RootValidation::PATH_TRAVERSAL_ROOT_LENGTH)

    return 1 if not DebuggerManagedEngine::managed_set_source_path_root(service.controller, Test::SOURCE_PATH_UNC_ROOT.cast[u8&], Test::SOURCE_PATH_UNC_ROOT_LENGTH)
    unc_file_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, Test::SOURCE_PATH_UNC_CLIENT_PATH.cast[u8&], Test::SOURCE_PATH_UNC_CLIENT_PATH_LENGTH)
    return 2 if unc_file_id.value != Test::SOURCE_PATH_FILE_ID

    return 3 if not DebuggerManagedEngine::managed_set_source_path_root(service.controller, Test::SOURCE_PATH_WINDOWS_ROOT.cast[u8&], Test::SOURCE_PATH_WINDOWS_ROOT_LENGTH)
    windows_file_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, Test::SOURCE_PATH_WINDOWS_CLIENT_PATH.cast[u8&], Test::SOURCE_PATH_WINDOWS_CLIENT_PATH_LENGTH)
    return 4 if windows_file_id.value != Test::SOURCE_PATH_FILE_ID
    windows_mixed_file_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, Test::SOURCE_PATH_WINDOWS_MIXED_CLIENT_PATH.cast[u8&], Test::SOURCE_PATH_WINDOWS_MIXED_CLIENT_PATH_LENGTH)
    return Test::SOURCE_PATH_WINDOWS_CASE_RESULT if windows_mixed_file_id.value != Test::SOURCE_PATH_FILE_ID

    invalid_utf8_root: mutable u8[Test::SOURCE_PATH_INVALID_UTF8_ROOT_LENGTH] = [Test::SOURCE_PATH_INVALID_UTF8_ROOT_FIRST_BYTE, Test::SOURCE_PATH_INVALID_UTF8_ROOT_INVALID_BYTE]
    return 5 if DebuggerManagedEngine::managed_set_source_path_root(service.controller, invalid_utf8_root[0], Test::SOURCE_PATH_INVALID_UTF8_ROOT_LENGTH)
    return 6 if DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, Test::SOURCE_PATH_WINDOWS_CLIENT_PATH.cast[u8&], Test::SOURCE_PATH_WINDOWS_CLIENT_PATH_LENGTH).value != Test::SOURCE_PATH_FILE_ID

    return Test::SOURCE_PATH_POSIX_CASE_RESULT if not DebuggerManagedEngine::managed_set_source_path_root(service.controller, Test::SOURCE_PATH_POSIX_ROOT.cast[u8&], Test::SOURCE_PATH_POSIX_ROOT_LENGTH)
    posix_mixed_file_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, Test::SOURCE_PATH_POSIX_CASE_MISMATCH_PATH.cast[u8&], Test::SOURCE_PATH_POSIX_CASE_MISMATCH_PATH_LENGTH)
    return Test::SOURCE_PATH_POSIX_CASE_RESULT if posix_mixed_file_id.value != Test::SOURCE_PATH_NO_FILE_ID
    return 0
