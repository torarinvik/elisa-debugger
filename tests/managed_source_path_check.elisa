include "../src/protocol/managed_service.elisa"
include "../src/engine/default_image.elisa"
include "../src/core/capabilities.elisa"

const SOURCE_PATH_FILE_ID: u64 = 71
const SOURCE_PATH_LOGICAL_ID: u64 = 72
const SOURCE_PATH_CONTENT_ID: u64 = 73
const SOURCE_PATH_RECORDING_ID: u64 = 74
const SOURCE_PATH_SESSION_ID: u64 = 75
const SOURCE_PATH_BUILD_COMPILER_ID: u64 = 76
const SOURCE_PATH_BUILD_RUNTIME_ID: u64 = 77
const SOURCE_PATH_BUILD_DIGEST_ID: u64 = 78
const SOURCE_PATH_BUILD_TARGET_ID: u64 = 79
const SOURCE_PATH_METADATA_VERSION: u32 = 1
const SOURCE_PATH_FILE_PATH: cstr = "main.elisa"
const SOURCE_PATH_FILE_PATH_LENGTH: usize = 10
const SOURCE_PATH_UNC_ROOT: cstr = "//server/share"
const SOURCE_PATH_UNC_ROOT_LENGTH: usize = 14
const SOURCE_PATH_UNC_CLIENT_PATH: cstr = "//SERVER/SHARE/main.elisa"
const SOURCE_PATH_UNC_CLIENT_PATH_LENGTH: usize = 25
const SOURCE_PATH_WINDOWS_ROOT: cstr = "C:/Workspace"
const SOURCE_PATH_WINDOWS_ROOT_LENGTH: usize = 12
const SOURCE_PATH_WINDOWS_CLIENT_PATH: cstr = "c:/workspace/main.elisa"
const SOURCE_PATH_WINDOWS_CLIENT_PATH_LENGTH: usize = 23
const SOURCE_PATH_WINDOWS_MIXED_CLIENT_PATH: cstr = "c:/workspace/MAIN.elisa"
const SOURCE_PATH_WINDOWS_MIXED_CLIENT_PATH_LENGTH: usize = 23
const SOURCE_PATH_POSIX_ROOT: cstr = "/workspace"
const SOURCE_PATH_POSIX_ROOT_LENGTH: usize = 10
const SOURCE_PATH_POSIX_CASE_MISMATCH_PATH: cstr = "/workspace/MAIN.elisa"
const SOURCE_PATH_POSIX_CASE_MISMATCH_PATH_LENGTH: usize = 21
const SOURCE_PATH_INVALID_UTF8_ROOT_LENGTH: usize = 2
const SOURCE_PATH_INVALID_UTF8_ROOT_BYTES: u8[SOURCE_PATH_INVALID_UTF8_ROOT_LENGTH] = [47, 255]
const SOURCE_PATH_NO_FILE_ID: u64 = 0
const SOURCE_PATH_WINDOWS_CASE_RESULT: i64 = 7
const SOURCE_PATH_POSIX_CASE_RESULT: i64 = 8

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(SOURCE_PATH_BUILD_COMPILER_ID), runtime: DebuggerIdentity::debug_id(SOURCE_PATH_BUILD_RUNTIME_ID), source: DebuggerIdentity::debug_id(SOURCE_PATH_BUILD_DIGEST_ID), target: DebuggerIdentity::debug_id(SOURCE_PATH_BUILD_TARGET_ID), metadata_version: SOURCE_PATH_METADATA_VERSION}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(SOURCE_PATH_SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    image: mutable DebuggerEDIR::ProgramImage = DebuggerDefaultImage::image_new()
    file: mutable DebuggerMetadata::SourceFile = zeroed
    file.id <- DebuggerIdentity::debug_id(SOURCE_PATH_FILE_ID)
    file.logical_path <- DebuggerIdentity::debug_id(SOURCE_PATH_LOGICAL_ID)
    file.content <- DebuggerIdentity::debug_id(SOURCE_PATH_CONTENT_ID)
    file.line_count <- 1
    file.path_length <- SOURCE_PATH_FILE_PATH_LENGTH
    for index in 0..<SOURCE_PATH_FILE_PATH_LENGTH:
        file.path_bytes[index] <- SOURCE_PATH_FILE_PATH.cast[u8&][index]
    image.source_file_count <- 1
    image.source_files[0] <- file
    service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, image, DebuggerIdentity::debug_id(SOURCE_PATH_RECORDING_ID))

    return 1 if not DebuggerManagedEngine::managed_set_source_path_root(service.controller, SOURCE_PATH_UNC_ROOT.cast[u8&], SOURCE_PATH_UNC_ROOT_LENGTH)
    unc_file_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, SOURCE_PATH_UNC_CLIENT_PATH.cast[u8&], SOURCE_PATH_UNC_CLIENT_PATH_LENGTH)
    return 2 if unc_file_id.value != SOURCE_PATH_FILE_ID

    return 3 if not DebuggerManagedEngine::managed_set_source_path_root(service.controller, SOURCE_PATH_WINDOWS_ROOT.cast[u8&], SOURCE_PATH_WINDOWS_ROOT_LENGTH)
    windows_file_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, SOURCE_PATH_WINDOWS_CLIENT_PATH.cast[u8&], SOURCE_PATH_WINDOWS_CLIENT_PATH_LENGTH)
    return 4 if windows_file_id.value != SOURCE_PATH_FILE_ID
    windows_mixed_file_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, SOURCE_PATH_WINDOWS_MIXED_CLIENT_PATH.cast[u8&], SOURCE_PATH_WINDOWS_MIXED_CLIENT_PATH_LENGTH)
    return SOURCE_PATH_WINDOWS_CASE_RESULT if windows_mixed_file_id.value != SOURCE_PATH_FILE_ID

    return 5 if DebuggerManagedEngine::managed_set_source_path_root(service.controller, SOURCE_PATH_INVALID_UTF8_ROOT_BYTES[0], SOURCE_PATH_INVALID_UTF8_ROOT_LENGTH)
    return 6 if DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, SOURCE_PATH_WINDOWS_CLIENT_PATH.cast[u8&], SOURCE_PATH_WINDOWS_CLIENT_PATH_LENGTH).value != SOURCE_PATH_FILE_ID

    return SOURCE_PATH_POSIX_CASE_RESULT if not DebuggerManagedEngine::managed_set_source_path_root(service.controller, SOURCE_PATH_POSIX_ROOT.cast[u8&], SOURCE_PATH_POSIX_ROOT_LENGTH)
    posix_mixed_file_id: DebuggerIdentity::DebugId = DebuggerManagedEngine::managed_source_file_id_for_path(service.controller, SOURCE_PATH_POSIX_CASE_MISMATCH_PATH.cast[u8&], SOURCE_PATH_POSIX_CASE_MISMATCH_PATH_LENGTH)
    return SOURCE_PATH_POSIX_CASE_RESULT if posix_mixed_file_id.value != SOURCE_PATH_NO_FILE_ID
    return 0
