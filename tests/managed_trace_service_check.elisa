    CLOCK_SAMPLE: u64 = 123456
    RANDOM_SAMPLE: u64 = 48879
    INPUT_STORAGE_CAPACITY: usize = 2
    INPUT_BUFFER_CAPACITY: usize = 3
    INPUT_REQUESTED_LENGTH: usize = 3
    INPUT_TRANSFERRED_LENGTH: usize = 2
    OUTPUT_STORAGE_CAPACITY: usize = 2
    OUTPUT_LENGTH: usize = 2
    INPUT_BYTE_0: u8 = 65
    INPUT_BYTE_1: u8 = 10
    OUTPUT_BYTE_0: u8 = 79
    OUTPUT_BYTE_1: u8 = 75
    FIRST_BYTE_INDEX: usize = 0
    SECOND_BYTE_INDEX: usize = 1

const module TraceServiceTestAdapterCheck:
    OK: i64 = 0
    INVALID_SNAPSHOT: i64 = 1
    CLOCK: i64 = 2
    RANDOM: i64 = 3
    INPUT: i64 = 4
    OUTPUT: i64 = 5


def seed_recorded_adapter_state(service: mutable DebuggerManagedService::Service&) -> bool:
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(TraceServiceTestIdentity::ADAPTER_SOURCE_ID)
    service.controller.state.adapters.clock <- DebuggerReplayAdapters::clock_new(DebuggerReplayAdapters::AdapterMode.Recording)
    failure: mutable DebuggerErrors::DebuggerError = DebuggerReplayAdapters::clock_record(service.controller.state.adapters.clock, source, TraceServiceTestAdapter::CLOCK_SAMPLE)
    return false if not DebuggerErrors::error_is_ok(failure)
    service.controller.state.adapters.random <- DebuggerReplayAdapters::random_new(DebuggerReplayAdapters::AdapterMode.Recording)
    failure <- DebuggerReplayAdapters::random_record(service.controller.state.adapters.random, source, TraceServiceTestAdapter::RANDOM_SAMPLE)
    return false if not DebuggerErrors::error_is_ok(failure)
    service.controller.state.adapters.console <- DebuggerReplayAdapters::console_new(DebuggerReplayAdapters::AdapterMode.Recording)
    input: mutable u8[TraceServiceTestAdapter::INPUT_STORAGE_CAPACITY] = zeroed
    input[TraceServiceTestAdapter::FIRST_BYTE_INDEX] <- TraceServiceTestAdapter::INPUT_BYTE_0
    input[TraceServiceTestAdapter::SECOND_BYTE_INDEX] <- TraceServiceTestAdapter::INPUT_BYTE_1
    failure <- DebuggerReplayAdapters::console_record_input_outcome(service.controller.state.adapters.console, DebuggerReplayAdapters::ConsoleChannel.Stdout, input[TraceServiceTestAdapter::FIRST_BYTE_INDEX], TraceServiceTestAdapter::INPUT_REQUESTED_LENGTH, TraceServiceTestAdapter::INPUT_TRANSFERRED_LENGTH, false)
    return false if not DebuggerErrors::error_is_ok(failure)
    output: mutable u8[TraceServiceTestAdapter::OUTPUT_STORAGE_CAPACITY] = zeroed
    output[TraceServiceTestAdapter::FIRST_BYTE_INDEX] <- TraceServiceTestAdapter::OUTPUT_BYTE_0
    output[TraceServiceTestAdapter::SECOND_BYTE_INDEX] <- TraceServiceTestAdapter::OUTPUT_BYTE_1
    failure <- DebuggerReplayAdapters::console_record(service.controller.state.adapters.console, DebuggerReplayAdapters::ConsoleRecordKind.Output, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[TraceServiceTestAdapter::FIRST_BYTE_INDEX], TraceServiceTestAdapter::OUTPUT_LENGTH)
    return DebuggerReplayAdapters::adapter_snapshot_is_valid(service.controller.state.adapters)

def manifest_chunk_for_bundle(bundle: DebuggerTraceBundle::TraceBundle&) -> DebuggerTraceStorage::StoredChunk:
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(bundle.manifest)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: bundle.manifest.schema.u32(), kind: DebuggerTrace::ChunkKind.Manifest, sequence: TraceServiceTestTrace::MANIFEST_SEQUENCE, first_event: bundle.manifest.first_event, last_event: bundle.manifest.last_event, payload_length: payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(payload)}
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in TraceServiceTestAdapter::FIRST_BYTE_INDEX..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def reopen_bundle(reader: mutable DebuggerTraceReader::TraceReader&, bundle: DebuggerTraceBundle::TraceBundle&) -> bool:
    failure: mutable DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(reader, manifest_chunk_for_bundle(bundle))
    return false if not DebuggerErrors::error_is_ok(failure)
    for index in TraceServiceTestTrace::NO_CHUNKS..<bundle.chunk_count:
        chunk: mutable DebuggerTraceStorage::StoredChunk = bundle.chunks[index]
        chunk.header.sequence <- index.u64() + TraceServiceTestTrace::CHUNK_SEQUENCE_OFFSET
        failure <- DebuggerTraceReader::reader_ingest(reader, chunk)
        return false if not DebuggerErrors::error_is_ok(failure)
    return DebuggerTraceReader::reader_is_exact(reader)

def checkpoint_adapters_replay(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> i64:
    adapters: mutable DebuggerReplayAdapters::AdapterSnapshot = checkpoint.adapters
    adapters.clock.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    adapters.random.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    adapters.console.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    adapters.console.output_suppressed <- true
    return TraceServiceTestAdapterCheck::INVALID_SNAPSHOT if not DebuggerReplayAdapters::adapter_snapshot_is_valid(adapters)
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(TraceServiceTestIdentity::ADAPTER_SOURCE_ID)
    clock: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(adapters.clock, source)
    random: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read(adapters.random, source)
    return TraceServiceTestAdapterCheck::CLOCK if not clock.accepted or clock.value != TraceServiceTestAdapter::CLOCK_SAMPLE
    return TraceServiceTestAdapterCheck::RANDOM if not random.accepted or random.value != TraceServiceTestAdapter::RANDOM_SAMPLE
    input: mutable u8[TraceServiceTestAdapter::INPUT_BUFFER_CAPACITY] = zeroed
    read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(adapters.console, DebuggerReplayAdapters::ConsoleChannel.Stdout, input[TraceServiceTestAdapter::FIRST_BYTE_INDEX], TraceServiceTestAdapter::INPUT_REQUESTED_LENGTH)
    return TraceServiceTestAdapterCheck::INPUT if not read.accepted or read.transferred != TraceServiceTestAdapter::INPUT_TRANSFERRED_LENGTH or input[TraceServiceTestAdapter::FIRST_BYTE_INDEX] != TraceServiceTestAdapter::INPUT_BYTE_0 or input[TraceServiceTestAdapter::SECOND_BYTE_INDEX] != TraceServiceTestAdapter::INPUT_BYTE_1 or read.eof
    output: mutable u8[TraceServiceTestAdapter::OUTPUT_STORAGE_CAPACITY] = zeroed
    output[TraceServiceTestAdapter::FIRST_BYTE_INDEX] <- TraceServiceTestAdapter::OUTPUT_BYTE_0
    output[TraceServiceTestAdapter::SECOND_BYTE_INDEX] <- TraceServiceTestAdapter::OUTPUT_BYTE_1
    write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(adapters.console, DebuggerReplayAdapters::ConsoleChannel.Stdout, output[TraceServiceTestAdapter::FIRST_BYTE_INDEX], TraceServiceTestAdapter::OUTPUT_LENGTH)
    return TraceServiceTestAdapterCheck::OUTPUT if not write.accepted or not write.suppressed or not DebuggerReplayAdapters::console_replay_complete(adapters.console)
    return TraceServiceTestAdapterCheck::OK

def new_trace_service(session_id: u64, build: DebuggerIdentity::BuildIdentity, image: DebuggerEDIR::ProgramImage, recording: u64) -> DebuggerManagedService::Service:
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(session_id), build, DebuggerCapabilities::managed_capabilities())
    return DebuggerManagedService::service_new(session, image, DebuggerIdentity::debug_id(recording))

def service_remains_fresh(service: DebuggerManagedService::Service, expected_recording: u64, expected_hash: u64) -> bool:
    return service.controller.session.state == DebuggerSession::SessionState.Created and service.controller.engine.event_count == TraceServiceTestRestore::NO_EVENTS and service.controller.engine.recording.value == expected_recording and DebuggerReplayEngine::replay_engine_state_hash(service.controller.engine) == expected_hash and service.recorded_event_count == TraceServiceTestRestore::NO_EVENTS and not service.trace_partial

def fresh_checkpoint_capability_is_enforced(build: DebuggerIdentity::BuildIdentity, image: DebuggerEDIR::ProgramImage, checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint) -> bool:
    service: mutable DebuggerManagedService::Service = new_trace_service(TraceServiceTestIdentity::FRESH_RESTORE_NO_CHECKPOINTS_SESSION_ID, build, image, TraceServiceTestIdentity::RECORDING_ID)
    service.controller.session.capabilities.checkpoints <- false
    original_hash: u64 = DebuggerReplayEngine::replay_engine_state_hash(service.controller.engine)
    restored: DebuggerManagedService::Result = DebuggerManagedTraceService::service_restore_fresh_checkpoint(service, checkpoint)
    return false if restored.accepted or restored.failure.code != DebuggerErrors::ErrorCode.Unsupported
    return service_remains_fresh(service, TraceServiceTestIdentity::RECORDING_ID, original_hash)

def run_service_to_event(service: mutable DebuggerManagedService::Service&, target_event: u64) -> bool:
    launch_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: TraceServiceTestRequest::ID, has_id: true, expected_generation: TraceServiceTestDispatch::NO_EXPECTED_GENERATION, target_event: TraceServiceTestDispatch::INITIAL_EVENT, valid: true}
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, launch_request)
    return false if not launched.accepted
    pause_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Pause, id: TraceServiceTestDispatch::PAUSE_REQUEST_ID, has_id: true, expected_generation: TraceServiceTestDispatch::NO_EXPECTED_GENERATION, target_event: TraceServiceTestDispatch::INITIAL_EVENT, valid: true}
    paused: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, pause_request)
    return false if not paused.accepted
    while service.controller.engine.event_count.u64() < target_event:
        step_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: TraceServiceTestDispatch::STEP_REQUEST_ID, has_id: true, expected_generation: TraceServiceTestDispatch::NO_EXPECTED_GENERATION, target_event: TraceServiceTestDispatch::INITIAL_EVENT, valid: true}
        stepped: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, step_request)
        return false if not stepped.accepted
    return service.controller.engine.event_count.u64() == target_event

def seed_restore_configuration(service: mutable DebuggerManagedService::Service&) -> bool:
    source_root: mutable u8[TraceServiceTestConfiguration::SOURCE_ROOT_LENGTH] = [TraceServiceTestConfiguration::SOURCE_ROOT_SLASH, TraceServiceTestConfiguration::SOURCE_ROOT_T, TraceServiceTestConfiguration::SOURCE_ROOT_M, TraceServiceTestConfiguration::SOURCE_ROOT_P]
    return false if not DebuggerManagedEngine::managed_set_source_path_root(service.controller, source_root[TraceServiceTestCheckpointIndex::SOURCE_ROOT_FIRST_BYTE], TraceServiceTestConfiguration::SOURCE_ROOT_LENGTH)
    source: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(TraceServiceTestConfiguration::SOURCE_FILE_ID), line: TraceServiceTestConfiguration::SOURCE_LINE, column: TraceServiceTestConfiguration::SOURCE_COLUMN, discriminator: TraceServiceTestConfiguration::SOURCE_DISCRIMINATOR}
    breakpoint: DebuggerBreakpoints::Breakpoint = DebuggerBreakpoints::Breakpoint{id: DebuggerIdentity::debug_id(TraceServiceTestConfiguration::NO_BRANCH), branch: DebuggerIdentity::debug_id(TraceServiceTestConfiguration::NO_BRANCH), kind: DebuggerBreakpoints::BreakpointKind.Source, status: DebuggerBreakpoints::BreakpointStatus.Pending, source: source, condition: DebuggerIdentity::debug_id(TraceServiceTestConfiguration::NO_BRANCH), hit_target: TraceServiceTestConfiguration::NO_HIT_TARGET, hit_count: TraceServiceTestConfiguration::NO_HIT_COUNT, hit_stride: TraceServiceTestConfiguration::NO_HIT_STRIDE, task: DebuggerIdentity::debug_id(TraceServiceTestConfiguration::NO_TASK), logpoint: false, temporary: false}
    breakpoints: mutable DebuggerBreakpointManager::BreakpointTable = DebuggerBreakpointManager::breakpoint_table_new()
    breakpoints <- DebuggerBreakpointManager::breakpoint_table_add(breakpoints, breakpoint)
    return false if not DebuggerBreakpointManager::breakpoint_table_is_valid(breakpoints) or breakpoints.count != TraceServiceTestConfiguration::ONE_ENTRY
    service.controller.state.breakpoints <- breakpoints
    allocation: DebuggerIdentity::AllocationIdentity = DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(TraceServiceTestConfiguration::WATCHPOINT_ALLOCATION_ID), generation: TraceServiceTestConfiguration::WATCHPOINT_GENERATION, offset: TraceServiceTestConfiguration::WATCHPOINT_OFFSET}
    watchpoint_id: DebuggerIdentity::DebugId = DebuggerWatchpoints::watchpoints_add(service.controller.state.watchpoints, allocation, DebuggerWatchpoints::AccessKind.Write, TraceServiceTestConfiguration::WATCHPOINT_GENERATION)
    return false if watchpoint_id.value == TraceServiceTestConfiguration::NO_WATCHPOINT_ID or not DebuggerWatchpoints::watchpoints_is_valid(service.controller.state.watchpoints)
    bookmark: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_add_bookmark(service.timeline, DebuggerIdentity::debug_id(TraceServiceTestConfiguration::BOOKMARK_LABEL_ID), DebuggerIdentity::debug_id(TraceServiceTestConfiguration::BOOKMARK_NOTE_ID), false)
    return false if not bookmark.accepted
    service.timeline <- bookmark.timeline
    return true

def prepare_existing_service_for_restore(service: mutable DebuggerManagedService::Service&) -> bool:
    return false if not run_service_to_event(service, TraceServiceTestConfiguration::EXISTING_EVENT)
    return seed_restore_configuration(service)

def fresh_checkpoint_machine_matches(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&, service: DebuggerManagedService::Service&) -> bool:
    return false if service.controller.session.state != DebuggerSession::SessionState.Stopped
    return false if service.controller.engine.event_count.u64() != checkpoint.event
    return false if DebuggerReplayEngine::replay_engine_state_hash(service.controller.engine) != checkpoint.state_hash
    return false if service.controller.engine.machine.program_counter != checkpoint.machine.program_counter
    return false if service.controller.engine.machine.accumulator != checkpoint.machine.accumulator or service.controller.engine.machine.steps != checkpoint.machine.steps
    return false if service.controller.engine.machine.halted != checkpoint.machine.halted or service.controller.engine.machine.faulted != checkpoint.machine.faulted
    return false if service.controller.engine.machine.result != checkpoint.machine.result
    return DebuggerValueStore::value_store_is_valid(service.controller.state.values)

def fresh_checkpoint_side_state_matches(checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint&, service: mutable DebuggerManagedService::Service&) -> bool:
    return false if service.controller.state.tasks.task_count != checkpoint.tasks.task_count or service.controller.state.tasks.next_id != checkpoint.tasks.next_id
    return false if service.controller.state.tasks.status != checkpoint.tasks.status or service.controller.state.tasks.current.value != checkpoint.tasks.current.value
    return false if service.controller.state.tasks.wait_count != checkpoint.tasks.wait_count or service.controller.state.tasks.scheduler.count != checkpoint.tasks.scheduler_count
    return false if service.controller.state.tasks.scheduler.cursor != checkpoint.tasks.scheduler_cursor
    return false if service.controller.state.tasks.scheduler.replaying != checkpoint.tasks.scheduler_replaying or service.controller.state.tasks.scheduler.diverged != checkpoint.tasks.scheduler_diverged or service.controller.state.tasks.scheduler.overflowed != checkpoint.tasks.scheduler_overflowed
    return false if service.controller.state.effects.count != checkpoint.effects.count or service.controller.state.effects.mode != checkpoint.effects.mode
    return false if service.controller.state.resources.count != checkpoint.resources.count or service.controller.state.resources.mode != checkpoint.resources.mode
    return false if service.controller.state.resources.next_handle != checkpoint.resources.next_handle
    return false if service.controller.state.adapters.clock.count != checkpoint.adapters.clock.count or service.controller.state.adapters.random.count != checkpoint.adapters.random.count
    return false if service.controller.state.adapters.console.count != checkpoint.adapters.console.count
    return false if service.controller.state.adapters.clock.count < TraceServiceTestConfiguration::ONE_ENTRY or service.controller.state.adapters.random.count < TraceServiceTestConfiguration::ONE_ENTRY
    return false if service.controller.state.adapters.clock.samples[TraceServiceTestCheckpointIndex::FIRST_CLOCK_SAMPLE].value != checkpoint.adapters.clock.samples[TraceServiceTestCheckpointIndex::FIRST_CLOCK_SAMPLE].value
    return false if service.controller.state.adapters.random.samples[TraceServiceTestCheckpointIndex::FIRST_RANDOM_SAMPLE].value != checkpoint.adapters.random.samples[TraceServiceTestCheckpointIndex::FIRST_RANDOM_SAMPLE].value
    return false if service.controller.state.adapters.console.count < TraceServiceTestRestore::CONSOLE_RECORD_COUNT
    return false if service.controller.state.adapters.console.records[TraceServiceTestCheckpointIndex::FIRST_CONSOLE_RECORD].length != checkpoint.adapters.console.records[TraceServiceTestCheckpointIndex::FIRST_CONSOLE_RECORD].length
    return false if checkpoint.adapters.console.records[TraceServiceTestCheckpointIndex::FIRST_CONSOLE_RECORD].length < TraceServiceTestAdapter::INPUT_TRANSFERRED_LENGTH
    return false if service.controller.state.adapters.console.records[TraceServiceTestCheckpointIndex::FIRST_CONSOLE_RECORD].bytes[TraceServiceTestAdapter::FIRST_BYTE_INDEX] != checkpoint.adapters.console.records[TraceServiceTestCheckpointIndex::FIRST_CONSOLE_RECORD].bytes[TraceServiceTestAdapter::FIRST_BYTE_INDEX]
    return false if service.controller.state.adapters.console.records[TraceServiceTestCheckpointIndex::FIRST_CONSOLE_RECORD].bytes[TraceServiceTestAdapter::SECOND_BYTE_INDEX] != checkpoint.adapters.console.records[TraceServiceTestCheckpointIndex::FIRST_CONSOLE_RECORD].bytes[TraceServiceTestAdapter::SECOND_BYTE_INDEX]
    return true

def fresh_checkpoint_configuration_is_preserved(service: DebuggerManagedService::Service&, checkpoint_event: u64, expected_bookmark_event: u64) -> bool:
    return false if service.controller.state.breakpoints.count != TraceServiceTestConfiguration::ONE_ENTRY
    return false if not DebuggerBreakpointManager::breakpoint_table_is_valid(service.controller.state.breakpoints)
    breakpoint: DebuggerBreakpoints::Breakpoint = service.controller.state.breakpoints.points[TraceServiceTestCheckpointIndex::FIRST_CONFIGURATION]
    return false if breakpoint.source.file.value != TraceServiceTestConfiguration::SOURCE_FILE_ID or breakpoint.source.line != TraceServiceTestConfiguration::SOURCE_LINE
    return false if service.controller.state.watchpoints.count != TraceServiceTestConfiguration::ONE_ENTRY or not DebuggerWatchpoints::watchpoints_is_valid(service.controller.state.watchpoints)
    watchpoint: DebuggerWatchpoints::DataBreakpoint = service.controller.state.watchpoints.points[TraceServiceTestCheckpointIndex::FIRST_CONFIGURATION]
    return false if watchpoint.allocation.allocation.value != TraceServiceTestConfiguration::WATCHPOINT_ALLOCATION_ID
    return false if watchpoint.allocation.generation != TraceServiceTestConfiguration::WATCHPOINT_GENERATION or watchpoint.allocation.offset != TraceServiceTestConfiguration::WATCHPOINT_OFFSET
    return false if service.controller.source_path_root_length != TraceServiceTestConfiguration::SOURCE_ROOT_LENGTH
    return false if service.controller.source_path_root[TraceServiceTestCheckpointIndex::SOURCE_ROOT_FIRST_BYTE] != TraceServiceTestConfiguration::SOURCE_ROOT_SLASH
    return false if service.controller.source_path_root[TraceServiceTestCheckpointIndex::SOURCE_ROOT_SECOND_BYTE] != TraceServiceTestConfiguration::SOURCE_ROOT_T
    return false if service.controller.source_path_root[TraceServiceTestCheckpointIndex::SOURCE_ROOT_THIRD_BYTE] != TraceServiceTestConfiguration::SOURCE_ROOT_M
    return false if service.controller.source_path_root[TraceServiceTestCheckpointIndex::SOURCE_ROOT_FOURTH_BYTE] != TraceServiceTestConfiguration::SOURCE_ROOT_P
    return false if service.timeline.bookmark_count != TraceServiceTestConfiguration::ONE_ENTRY
    bookmark: DebuggerTimeline::Bookmark = service.timeline.bookmarks[TraceServiceTestCheckpointIndex::FIRST_CONFIGURATION]
    return false if bookmark.label.value != TraceServiceTestConfiguration::BOOKMARK_LABEL_ID or bookmark.note.value != TraceServiceTestConfiguration::BOOKMARK_NOTE_ID
    return false if bookmark.position.recording.value != service.controller.engine.recording.value or bookmark.position.branch.value != TraceServiceTestConfiguration::NO_BRANCH
    return false if bookmark.position.event != expected_bookmark_event or bookmark.pinned
    return false if not DebuggerTimeline::history_bounds_is_valid(service.timeline.bounds)
    return service.recorded_event_count == checkpoint_event.usize()

def fresh_checkpoint_reverse_step_has_prefix(service: mutable DebuggerManagedService::Service&, checkpoint_event: u64) -> bool:
    request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.ReverseStep, id: TraceServiceTestDispatch::FRESH_CHECKPOINT_REVERSE_REQUEST_ID, has_id: true, expected_generation: TraceServiceTestDispatch::NO_EXPECTED_GENERATION, target_event: TraceServiceTestDispatch::INITIAL_EVENT, valid: true}
    reversed: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, request)
    return false if not reversed.accepted
    expected_event: u64 = checkpoint_event - TraceServiceTestTrace::PREVIOUS_EVENT_OFFSET.u64()
    return false if service.controller.engine.event_count.u64() != expected_event
    historical: DebuggerCheckpoint::MachineSnapshot = service.controller.engine.history[service.controller.engine.event_count]
    return DebuggerCheckpoint::snapshot_matches_machine(historical, service.controller.engine.machine)

def build_interior_checkpoint_bundle(build: DebuggerIdentity::BuildIdentity, image: DebuggerEDIR::ProgramImage, bundle: mutable DebuggerTraceBundle::TraceBundle&) -> bool:
    interior_service: mutable DebuggerManagedService::Service = new_trace_service(TraceServiceTestIdentity::INTERIOR_SESSION_ID, build, image, TraceServiceTestIdentity::RECORDING_ID)
    return false if not seed_recorded_adapter_state(interior_service) or not run_service_to_event(interior_service, TraceServiceTestTrace::INTERIOR_CHECKPOINT_EVENT)
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerManagedEngine::managed_full_checkpoint(interior_service.controller)
    step_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Step, id: TraceServiceTestDispatch::STEP_REQUEST_ID, has_id: true, expected_generation: TraceServiceTestDispatch::NO_EXPECTED_GENERATION, target_event: TraceServiceTestDispatch::INITIAL_EVENT, valid: true}
    stepped: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(interior_service, step_request)
    return false if not stepped.accepted or interior_service.controller.engine.event_count != TraceServiceTestTrace::EVENT_COUNT
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build, DebuggerIdentity::debug_id(TraceServiceTestIdentity::RECORDING_ID))
    failure: mutable DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(recorder, interior_service.controller.engine.events[TraceServiceTestRestore::NO_EVENTS])
    return false if not DebuggerErrors::error_is_ok(failure)
    failure <- DebuggerTraceRecorder::recorder_append(recorder, interior_service.controller.engine.events[TraceServiceTestTrace::SECOND_EVENT_INDEX])
    return false if not DebuggerErrors::error_is_ok(failure)
    failure <- DebuggerTraceRecorder::recorder_append_checkpoint(recorder, checkpoint)
    return false if not DebuggerErrors::error_is_ok(failure)
    failure <- DebuggerTraceRecorder::recorder_append(recorder, interior_service.controller.engine.events[TraceServiceTestTrace::LAST_EVENT.usize()])
    return false if not DebuggerErrors::error_is_ok(failure)
    built: DebuggerTracePipeline::BundleBuildResult = DebuggerTracePipeline::bundle_from_recorder(recorder)
    return false if not built.accepted
    bundle <- built.bundle
    return true

def build_mismatch_is_atomic(build: DebuggerIdentity::BuildIdentity, image: DebuggerEDIR::ProgramImage, reader: DebuggerTraceReader::TraceReader&) -> bool:
    mismatched_build: mutable DebuggerIdentity::BuildIdentity = build
    mismatched_build.source <- DebuggerIdentity::debug_id(build.source.value + TraceServiceTestRestore::BUILD_SOURCE_OFFSET)
    service: mutable DebuggerManagedService::Service = new_trace_service(TraceServiceTestIdentity::BUILD_MISMATCH_SESSION_ID, mismatched_build, image, TraceServiceTestIdentity::RECORDING_ID)
    initial_hash: u64 = DebuggerReplayEngine::replay_engine_state_hash(service.controller.engine)
    restored: DebuggerManagedService::Result = DebuggerManagedTraceService::service_trace_restore_checkpoint(service, reader, TraceServiceTestTrace::EVENT_COUNT.u64())
    return not restored.accepted and service_remains_fresh(service, TraceServiceTestIdentity::RECORDING_ID, initial_hash)

def recording_mismatch_is_atomic(build: DebuggerIdentity::BuildIdentity, image: DebuggerEDIR::ProgramImage, reader: DebuggerTraceReader::TraceReader&) -> bool:
    mismatched_recording: u64 = TraceServiceTestIdentity::RECORDING_ID + TraceServiceTestRestore::RECORDING_ID_OFFSET
    service: mutable DebuggerManagedService::Service = new_trace_service(TraceServiceTestIdentity::RECORDING_MISMATCH_SESSION_ID, build, image, mismatched_recording)
    initial_hash: u64 = DebuggerReplayEngine::replay_engine_state_hash(service.controller.engine)
    restored: DebuggerManagedService::Result = DebuggerManagedTraceService::service_trace_restore_checkpoint(service, reader, TraceServiceTestTrace::EVENT_COUNT.u64())
    return not restored.accepted and service_remains_fresh(service, mismatched_recording, initial_hash)

def image_mismatch_is_atomic(build: DebuggerIdentity::BuildIdentity, image: DebuggerEDIR::ProgramImage, reader: DebuggerTraceReader::TraceReader&) -> bool:
    mismatched_image: mutable DebuggerEDIR::ProgramImage = image
    instruction: mutable DebuggerEDIR::Instruction = mismatched_image.instructions[TraceServiceTestProgram::FIRST_INSTRUCTION_INDEX]
    instruction.a <- TraceServiceTestProgram::RESULT - TraceServiceTestRestore::IMAGE_RESULT_OFFSET
    mismatched_image.instructions[TraceServiceTestProgram::FIRST_INSTRUCTION_INDEX] <- instruction
    service: mutable DebuggerManagedService::Service = new_trace_service(TraceServiceTestIdentity::IMAGE_MISMATCH_SESSION_ID, build, mismatched_image, TraceServiceTestIdentity::RECORDING_ID)
    initial_hash: u64 = DebuggerReplayEngine::replay_engine_state_hash(service.controller.engine)
    restored: DebuggerManagedService::Result = DebuggerManagedTraceService::service_trace_restore_checkpoint(service, reader, TraceServiceTestTrace::EVENT_COUNT.u64())
    return not restored.accepted and service_remains_fresh(service, TraceServiceTestIdentity::RECORDING_ID, initial_hash)

def interior_checkpoint_restore_is_exact(build: DebuggerIdentity::BuildIdentity, image: DebuggerEDIR::ProgramImage) -> i64:
    bundle: mutable DebuggerTraceBundle::TraceBundle = zeroed
    return TraceServiceTestFailure::CHECKPOINT_REOPEN if not build_interior_checkpoint_bundle(build, image, bundle)
    reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return TraceServiceTestFailure::CHECKPOINT_REOPEN if not reopen_bundle(reader, bundle) or DebuggerTraceReader::reader_full_checkpoint_count(reader) != TraceServiceTestTrace::END_BOUNDARY_OFFSET.usize()
    checkpoint: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(reader, TraceServiceTestTrace::EVENT_COUNT.u64())
    return TraceServiceTestFailure::CHECKPOINT_REOPEN if not checkpoint.found or checkpoint.checkpoint.event != TraceServiceTestTrace::INTERIOR_CHECKPOINT_EVENT

    service: mutable DebuggerManagedService::Service = new_trace_service(TraceServiceTestIdentity::RESTORE_SESSION_ID, build, image, TraceServiceTestIdentity::RECORDING_ID)
    return TraceServiceTestFailure::SOURCE_BREAKPOINT if not prepare_existing_service_for_restore(service)
    previous_generation: u64 = service.controller.session.stop_generation
    restored: mutable DebuggerManagedService::Result = DebuggerManagedTraceService::service_trace_restore_checkpoint(service, reader, TraceServiceTestTrace::EVENT_COUNT.u64())
    return TraceServiceTestFailure::COLD_RESTORE if not restored.accepted
    return TraceServiceTestFailure::COLD_RESTORE_STATE if service.controller.session.state != DebuggerSession::SessionState.Stopped or service.controller.engine.event_count != TraceServiceTestTrace::EVENT_COUNT or service.controller.engine.machine.result != TraceServiceTestProgram::RESULT or service.recorded_event_count != TraceServiceTestTrace::EVENT_COUNT or service.controller.state.adapters.clock.count != TraceServiceTestRestore::CLOCK_SAMPLE_COUNT or service.controller.state.adapters.random.count != TraceServiceTestRestore::RANDOM_SAMPLE_COUNT or service.controller.state.adapters.console.count != TraceServiceTestRestore::CONSOLE_RECORD_COUNT
    return TraceServiceTestFailure::CONFIGURATION_LOST if not fresh_checkpoint_configuration_is_preserved(service, TraceServiceTestTrace::EVENT_COUNT.u64(), TraceServiceTestConfiguration::EXISTING_EVENT)
    return TraceServiceTestFailure::GENERATION_NOT_ADVANCED if service.controller.session.stop_generation <= previous_generation
    exported: DebuggerTraceExport::ExportResult = DebuggerManagedTraceService::service_trace_export(service)
    storage_report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(exported.bytes.bytes[TraceServiceTestTrace::FIRST_STORAGE_BYTE_INDEX], exported.bytes.length)
    return TraceServiceTestFailure::COLD_RESTORE_EXPORT if not DebuggerErrors::error_is_ok(exported.failure) or storage_report.state != DebuggerTraceVerify::VerificationState.Exact or not storage_report.replayable

    return TraceServiceTestFailure::FRESH_CHECKPOINT_CAPABILITY_IGNORED if not fresh_checkpoint_capability_is_enforced(build, image, checkpoint.checkpoint)
    service <- new_trace_service(TraceServiceTestIdentity::FRESH_RESTORE_SESSION_ID, build, image, TraceServiceTestIdentity::RECORDING_ID)
    return TraceServiceTestFailure::FRESH_CHECKPOINT_CONFIGURATION_LOST if not seed_restore_configuration(service)
    restored <- DebuggerManagedTraceService::service_restore_fresh_checkpoint(service, checkpoint.checkpoint)
    return TraceServiceTestFailure::FRESH_CHECKPOINT_RESTORE_FAILED if not restored.accepted
    return TraceServiceTestFailure::FRESH_CHECKPOINT_STATE_MISMATCH if not fresh_checkpoint_machine_matches(checkpoint.checkpoint, service) or not fresh_checkpoint_side_state_matches(checkpoint.checkpoint, service)
    return TraceServiceTestFailure::FRESH_CHECKPOINT_CONFIGURATION_LOST if not fresh_checkpoint_configuration_is_preserved(service, checkpoint.checkpoint.event, TraceServiceTestRestore::INITIAL_EVENT)
    return TraceServiceTestFailure::FRESH_CHECKPOINT_REVERSE_FAILED if not fresh_checkpoint_reverse_step_has_prefix(service, checkpoint.checkpoint.event)
    return TraceServiceTestRestore::SUCCESS


def trace_service_recording_checks(build: DebuggerIdentity::BuildIdentity, image: DebuggerEDIR::ProgramImage) -> i64:
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(TraceServiceTestIdentity::SESSION_ID), build, DebuggerCapabilities::managed_capabilities())
    service: mutable DebuggerManagedService::Service = DebuggerManagedService::service_new(session, image, DebuggerIdentity::debug_id(TraceServiceTestIdentity::RECORDING_ID))
    launch_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: TraceServiceTestRequest::ID, has_id: true, expected_generation: TraceServiceTestRequest::INITIAL_GENERATION, target_event: TraceServiceTestRequest::INITIAL_EVENT, valid: true}
    launched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, launch_request)
    return TraceServiceTestFailure::LAUNCH if not launched.accepted
    continue_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Continue, id: TraceServiceTestRequest::ID, has_id: true, expected_generation: TraceServiceTestRequest::INITIAL_GENERATION, target_event: TraceServiceTestRequest::INITIAL_EVENT, valid: true}
    continued: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, continue_request)
    return TraceServiceTestFailure::CONTINUE if not continued.accepted or service.recorded_event_count != TraceServiceTestTrace::EVENT_COUNT
    return TraceServiceTestFailure::ADAPTER_SEED if not seed_recorded_adapter_state(service)
    trace_bundle: DebuggerTracePipeline::BundleBuildResult = DebuggerManagedTraceService::service_trace_bundle(service)
    return TraceServiceTestFailure::CHECKPOINT_COUNT if not trace_bundle.accepted or trace_bundle.bundle.manifest.checkpoint_count != TraceServiceTestTrace::END_BOUNDARY_OFFSET or trace_bundle.bundle.chunk_count < TraceServiceTestTrace::END_BOUNDARY_OFFSET.usize()
    reopened: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return TraceServiceTestFailure::CHECKPOINT_REOPEN if not reopen_bundle(reopened, trace_bundle.bundle) or DebuggerTraceReader::reader_full_checkpoint_count(reopened) != TraceServiceTestTrace::END_BOUNDARY_OFFSET.usize()
    checkpoint: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(reopened, TraceServiceTestTrace::EVENT_COUNT.u64())
    return TraceServiceTestFailure::CHECKPOINT_REOPEN if not checkpoint.found or checkpoint.checkpoint.event != TraceServiceTestTrace::EVENT_COUNT.u64() or checkpoint.checkpoint.machine.result != TraceServiceTestProgram::RESULT
    adapter_replay_result: i64 = checkpoint_adapters_replay(checkpoint.checkpoint)
    return TraceServiceTestFailure::CHECKPOINT_REPLAY + adapter_replay_result if adapter_replay_result != TraceServiceTestAdapterCheck::OK

    return TraceServiceTestFailure::BUILD_MISMATCH_ATOMIC if not build_mismatch_is_atomic(build, image, reopened)
    return TraceServiceTestFailure::RECORDING_MISMATCH_ATOMIC if not recording_mismatch_is_atomic(build, image, reopened)
    return TraceServiceTestFailure::IMAGE_MISMATCH_ATOMIC if not image_mismatch_is_atomic(build, image, reopened)

    trace_report: DebuggerTraceVerify::VerificationReport = DebuggerManagedTraceService::service_trace_verify(service)
    return TraceServiceTestFailure::VERIFY if trace_report.state != DebuggerTraceVerify::VerificationState.Exact or not trace_report.replayable or trace_report.verified_event != TraceServiceTestTrace::LAST_EVENT
    exported: DebuggerTraceExport::ExportResult = DebuggerManagedTraceService::service_trace_export(service)
    return TraceServiceTestFailure::EXPORT if not DebuggerErrors::error_is_ok(exported.failure) or exported.chunk_count == TraceServiceTestTrace::NO_CHUNKS or not DebuggerTraceBinary::writer_is_valid(exported.bytes)
    storage_report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(exported.bytes.bytes[TraceServiceTestTrace::FIRST_STORAGE_BYTE_INDEX], exported.bytes.length)
    return TraceServiceTestFailure::STORAGE_VERIFY if storage_report.state != DebuggerTraceVerify::VerificationState.Exact or not storage_report.replayable or storage_report.verified_event != TraceServiceTestTrace::LAST_EVENT
    return TraceServiceTestFailure::RECORDING if service.trace_partial or service.recorded_event_count != TraceServiceTestTrace::EVENT_COUNT
    for index in TraceServiceTestTrace::FIRST_EVENT_INDEX..<TraceServiceTestTrace::EVENT_COUNT:
        return TraceServiceTestFailure::RECORDING if service.recorded_events[index].ordinal != index.u64() or service.recorded_events[index].position.recording.value != TraceServiceTestIdentity::RECORDING_ID
    reverse_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.ReverseStep, id: TraceServiceTestRequest::ID, has_id: true, expected_generation: TraceServiceTestRequest::INITIAL_GENERATION, target_event: TraceServiceTestRequest::INITIAL_EVENT, valid: true}
    reversed: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, reverse_request)
    return TraceServiceTestFailure::REVERSE if not reversed.accepted or service.controller.engine.event_count != TraceServiceTestTrace::EVENT_COUNT - TraceServiceTestTrace::PREVIOUS_EVENT_OFFSET
    rewound_report: DebuggerTraceVerify::VerificationReport = DebuggerManagedTraceService::service_trace_verify(service)
    return TraceServiceTestFailure::REWIND_INVALIDATED if rewound_report.state != DebuggerTraceVerify::VerificationState.Exact or not rewound_report.replayable or service.trace_partial
    step_request: DebuggerProtocolRequest::Request = reverse_request
    step_request.method <- DebuggerProtocolRequest::RequestMethod.Step
    repeated: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, step_request)
    return TraceServiceTestFailure::REEXECUTION_MISMATCH if not repeated.accepted or service.trace_partial or service.recorded_event_count != TraceServiceTestTrace::EVENT_COUNT
    repeated_report: DebuggerTraceVerify::VerificationReport = DebuggerManagedTraceService::service_trace_verify(service)
    return TraceServiceTestFailure::REEXECUTION_MISMATCH if repeated_report.state != DebuggerTraceVerify::VerificationState.Exact or not repeated_report.replayable
    reversed_again: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, reverse_request)
    return TraceServiceTestFailure::REVERSE if not reversed_again.accepted
    branch_request: DebuggerProtocolRequest::Request = reverse_request
    branch_request.method <- DebuggerProtocolRequest::RequestMethod.Branch
    branched: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, branch_request)
    return TraceServiceTestFailure::BRANCH_NOT_PARTIAL if not branched.accepted
    branch_continue: DebuggerProtocolRequest::Request = reverse_request
    branch_continue.method <- DebuggerProtocolRequest::RequestMethod.Continue
    branch_advanced: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(service, branch_continue)
    return TraceServiceTestFailure::BRANCH_NOT_PARTIAL if not branch_advanced.accepted or not service.trace_partial
    partial_report: DebuggerTraceVerify::VerificationReport = DebuggerManagedTraceService::service_trace_verify(service)
    return TraceServiceTestFailure::PARTIAL if partial_report.state != DebuggerTraceVerify::VerificationState.Partial or partial_report.replayable or DebuggerErrors::error_is_ok(partial_report.failure)
    service.controller.session.capabilities.trace_export <- false
    unavailable_report: DebuggerTraceVerify::VerificationReport = DebuggerManagedTraceService::service_trace_verify(service)
    return TraceServiceTestFailure::UNAVAILABLE if unavailable_report.state != DebuggerTraceVerify::VerificationState.Unavailable or unavailable_report.replayable or unavailable_report.failure.code != DebuggerErrors::ErrorCode.Unsupported
    return TraceServiceTestFailure::OK

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(TraceServiceTestIdentity::COMPILER_ID), runtime: DebuggerIdentity::debug_id(TraceServiceTestIdentity::RUNTIME_ID), source: DebuggerIdentity::debug_id(TraceServiceTestIdentity::SOURCE_ID), target: DebuggerIdentity::debug_id(TraceServiceTestIdentity::TARGET_ID), metadata_version: TraceServiceTestProgram::VERSION}
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: TraceServiceTestProgram::VERSION, instruction_count: TraceServiceTestProgram::INSTRUCTION_COUNT, local_count: TraceServiceTestProgram::LOCAL_COUNT, has_return: true}
    image.instructions[TraceServiceTestProgram::FIRST_INSTRUCTION_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: TraceServiceTestProgram::RESULT, b: TraceServiceTestProgram::UNUSED_OPERAND, source: zeroed}
    image.instructions[TraceServiceTestProgram::SECOND_INSTRUCTION_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: TraceServiceTestProgram::UNUSED_OPERAND, b: TraceServiceTestProgram::UNUSED_OPERAND, source: zeroed}
    image.instructions[TraceServiceTestProgram::RETURN_INSTRUCTION_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: TraceServiceTestProgram::UNUSED_OPERAND, b: TraceServiceTestProgram::UNUSED_OPERAND, source: zeroed}
    recording_result: i64 = trace_service_recording_checks(build, image)
    return recording_result if recording_result != TraceServiceTestFailure::OK
    return interior_checkpoint_restore_is_exact(build, image)
