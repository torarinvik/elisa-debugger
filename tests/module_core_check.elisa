include "../src/cli/runner.elisa"
include "../src/protocol/dap.elisa"
include "../src/engine/managed.elisa"
include "../src/vm/edir.elisa"
include "../src/replay/engine.elisa"

const module Test:
    INVALID_REPLAY_EVENT_COUNT: usize = 65
    INVALID_RING_COUNT: usize = 257
    INVALID_POSTMORTEM_KIND_RESULT: i64 = 78
    INVALID_POSTMORTEM_BUILD_RESULT: i64 = 79
    INVALID_ENGINE_STEP_RESULT: i64 = 81
    ZERO_RECORDING_EXACT_RESULT: i64 = 111
    RESUMABLE_POSTMORTEM_RESULT: i64 = 114
    FAULTING_SEEK_RESULT: i64 = 82
    INVALID_REPLAY_SNAPSHOT_RESULT: i64 = 120
    INVALID_REPLAY_EVENT_POSITION_RESULT: i64 = 121
    INVALID_REPLAY_STATE_HASH_RESULT: i64 = 122
    INVALID_CHECKPOINT_DECODE_RESULT: i64 = 131
    INVALID_REPLAY_PAYLOAD_RESULT: i64 = 132
    CHECKPOINT_SCHEMA_BYTES: usize = 4
    CHECKPOINT_INTEGER_BYTES: usize = 8
    CHECKPOINT_SCALARS_BEFORE_MEMORY: usize = 5
    CHECKPOINT_LOCAL_CAPACITY: usize = 32
    CHECKPOINT_GLOBAL_CAPACITY: usize = 16
    CHECKPOINT_MEMORY_CAPACITY: usize = 64
    CHECKPOINT_MEMORY_FLAG_BYTES: usize = 1
    CHECKPOINT_HEAP_BYTE_OFFSET: usize = Test::CHECKPOINT_SCHEMA_BYTES + Test::CHECKPOINT_INTEGER_BYTES * (Test::CHECKPOINT_SCALARS_BEFORE_MEMORY + Test::CHECKPOINT_LOCAL_CAPACITY + Test::CHECKPOINT_GLOBAL_CAPACITY + Test::CHECKPOINT_MEMORY_CAPACITY) + Test::CHECKPOINT_MEMORY_CAPACITY * Test::CHECKPOINT_MEMORY_FLAG_BYTES + Test::CHECKPOINT_GLOBAL_CAPACITY
    CHECKPOINT_EMPTY_HEAP_NEXT: usize = 0
    INVALID_MEMORY_SHAPE_RESULT: i64 = 123
    INVALID_IMAGE_RETURN_ADDRESS_RESULT: i64 = 156
    FIRST_RETURN_STACK_SLOT: usize = 0
    ACTIVE_RETURN_STACK_POINTER: usize = 1
    RETURN_INSTRUCTION_EVENT_INDEX: usize = 1
    HOST_POINTER_BITS: u32 = 64
    HOST_PAGE_SIZE: u64 = 4096
    PARTIAL_SEEK_EVENT: usize = 1
    TOOL_PATH_ID: u64 = 10
    TOOL_REVISION: u64 = 11
    EXECUTABLE_ARTIFACT_ID: u64 = 20
    SOURCE_ARTIFACT_ID: u64 = 21
    RUNTIME_ARTIFACT_ID: u64 = 22
    EXECUTABLE_ARTIFACT_KIND: u32 = 1
    SOURCE_ARTIFACT_KIND: u32 = 2
    RUNTIME_ARTIFACT_KIND: u32 = 3
    ARTIFACT_SIZE: u64 = 1
    MISSING_ARTIFACT_ID_RESULT: i64 = 113
    MAX_BRANCH_ID: u64 = 18446744073709551615
    DISCOVERY_WITHOUT_ID_RESULT: i64 = 142
    ROOT_INTERVENTION_RESULT: i64 = 134
    BRANCH_EXACTNESS_RESULT: i64 = 135
    INVALID_REPLAY_BRANCH_RESULT: i64 = 136
    INVALID_REPLAY_STATEMENT_RESULT: i64 = 137
    INVALID_REPLAY_SNAPSHOT_ID_RESULT: i64 = 138
    INVALID_REPLAY_SNAPSHOT_EVENT_RESULT: i64 = 139
    INVALID_REPLAY_LINEAGE_RESULT: i64 = 140
    COORDINATOR_MEMORY_CAPABILITY_RESULT: i64 = 143
    FAULTING_STEP_INVALIDATION_RESULT: i64 = 157
    FAULT_STEP_GENERATION_INCREMENT: u64 = 1
    BRANCH_SINGLE_EVENT_OFFSET: usize = 1


def check_reverse_error_preserves_session() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: 1, instruction_count: 1, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
    valid_position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(1))
    return 124 if not DebuggerIdentity::position_recording_is_valid(valid_position)
    invalid_position: DebuggerIdentity::Position = valid_position
    invalid_position.recording <- DebuggerIdentity::debug_id(0)
    return 125 if DebuggerIdentity::position_recording_is_valid(invalid_position)
    session.state <- DebuggerSession::SessionState.Stopped
    session.position.event <- Test::INVALID_REPLAY_EVENT_COUNT.u64()
    controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(controller, session, image, DebuggerIdentity::debug_id(5))
    controller.engine.event_count <- Test::INVALID_REPLAY_EVENT_COUNT
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step(controller)
    return 1 if failure.code != DebuggerErrors::ErrorCode.Unavailable or controller.session.position.event != Test::INVALID_REPLAY_EVENT_COUNT.u64()
    return 0

def main() -> i64:
    return 71 if check_reverse_error_preserves_session() != 0
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
    dap_capabilities: DebuggerDAP::AdapterCapabilities = DebuggerDAP::capabilities_for(session)
    return 30 if dap_capabilities.supports_restart_request or dap_capabilities.supports_set_variable or not dap_capabilities.supports_read_memory or not dap_capabilities.supports_evaluate_for_hovers
    manifest: mutable DebuggerBuild::BuildManifest = DebuggerBuild::build_manifest_new(build)
    manifest.executable.present <- true
    manifest.executable.id <- DebuggerIdentity::debug_id(Test::EXECUTABLE_ARTIFACT_ID)
    manifest.executable.kind <- Test::EXECUTABLE_ARTIFACT_KIND
    manifest.executable.size <- Test::ARTIFACT_SIZE
    manifest.source.present <- true
    manifest.source.id <- DebuggerIdentity::debug_id(Test::SOURCE_ARTIFACT_ID)
    manifest.source.kind <- Test::SOURCE_ARTIFACT_KIND
    manifest.source.size <- Test::ARTIFACT_SIZE
    return 27 if DebuggerBuild::build_manifest_require_artifacts(manifest).detail != 3
    manifest.runtime.present <- true
    manifest.runtime.id <- DebuggerIdentity::debug_id(Test::RUNTIME_ARTIFACT_ID)
    manifest.runtime.kind <- Test::RUNTIME_ARTIFACT_KIND
    manifest.runtime.size <- Test::ARTIFACT_SIZE
    return 28 if not DebuggerErrors::error_is_ok(DebuggerBuild::build_manifest_require_artifacts(manifest))
    missing_artifact: mutable DebuggerBuild::BuildManifest = manifest
    missing_artifact.source.id <- DebuggerIdentity::debug_id(0)
    return Test::MISSING_ARTIFACT_ID_RESULT if DebuggerErrors::error_is_ok(DebuggerBuild::build_manifest_require_artifacts(missing_artifact))
    toolchain: mutable DebuggerCompilerDiscovery::Toolchain = DebuggerCompilerDiscovery::toolchain_new()
    toolchain.compiler.present <- true
    toolchain.runtime.present <- true
    toolchain.compiler.major <- 1
    toolchain.runtime.major <- 1
    return 106 if DebuggerCompilerDiscovery::toolchain_is_compatible(toolchain)
    toolchain.compiler.path_id <- Test::TOOL_PATH_ID
    toolchain.runtime.path_id <- Test::TOOL_PATH_ID
    toolchain.compiler.revision <- Test::TOOL_REVISION
    toolchain.runtime.revision <- Test::TOOL_REVISION
    toolchain.compatible <- true
    return 107 if not DebuggerCompilerDiscovery::toolchain_is_compatible(toolchain)
    toolchain.compatible <- false
    return 108 if DebuggerCompilerDiscovery::toolchain_is_compatible(toolchain)
    zero_build: DebuggerIdentity::BuildIdentity = zeroed
    zero_manifest: DebuggerBuild::BuildManifest = DebuggerBuild::build_manifest_new(zero_build)
    return 76 if DebuggerBuild::build_manifest_is_compatible(zero_manifest, zero_build)
    malformed_error: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
    malformed_error.severity <- DebuggerErrors::ErrorSeverity.Failure
    return 78 if DebuggerErrors::error_is_ok(malformed_error)
    return 79 if DebuggerErrors::error_is_well_formed(malformed_error) or not DebuggerErrors::error_is_well_formed(DebuggerErrors::no_error())
    coordinator: mutable DebuggerCoordinator::Coordinator = DebuggerCoordinator::coordinator_new(session)
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
    created: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(coordinator, 1, DebuggerCoordinator::Operation.CreateSession, 0, token)
    return 1 if not created.accepted or created.coordinator.session.state != DebuggerSession::SessionState.Configuring
    launched: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(created.coordinator, 2, DebuggerCoordinator::Operation.Launch, 0, token)
    return 2 if not launched.accepted or launched.coordinator.session.state != DebuggerSession::SessionState.Running
    stopped: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(launched.coordinator, 3, DebuggerCoordinator::Operation.Pause, 0, token)
    return 3 if not stopped.accepted or stopped.coordinator.session.stop_generation != 1
    stale: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 4, DebuggerCoordinator::Operation.Continue, 99, token)
    return 4 if stale.accepted or stale.failure.code != DebuggerErrors::ErrorCode.StaleGeneration
    limited_capabilities: mutable DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    limited_capabilities.memory_read <- false
    limited_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(7), build, limited_capabilities)
    limited_session.state <- DebuggerSession::SessionState.Stopped
    limited_coordinator: DebuggerCoordinator::Coordinator = DebuggerCoordinator::coordinator_new(limited_session)
    denied_memory: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(limited_coordinator, 6, DebuggerCoordinator::Operation.Memory, 0, token)
    return Test::COORDINATOR_MEMORY_CAPABILITY_RESULT if denied_memory.accepted or denied_memory.failure.code != DebuggerErrors::ErrorCode.Unavailable
    cancelled_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_cancel(token)
    cancelled: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 5, DebuggerCoordinator::Operation.Continue, 0, cancelled_token)
    return 5 if cancelled.accepted or cancelled.failure.code != DebuggerErrors::ErrorCode.Cancelled
    invalid_request_id: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 0, DebuggerCoordinator::Operation.Continue, 0, token)
    return 111 if invalid_request_id.accepted or invalid_request_id.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    return 112 if invalid_request_id.coordinator.last_error.code != DebuggerErrors::ErrorCode.InvalidArgument
    discovery_without_id: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 0, DebuggerCoordinator::Operation.Discover, 0, token)
    return Test::DISCOVERY_WITHOUT_ID_RESULT if not discovery_without_id.accepted or discovery_without_id.request_id != 0
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: 1, instruction_count: 2, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 7, b: 0, source: zeroed}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    managed: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(managed, session, image, DebuggerIdentity::debug_id(55))
    return 6 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(managed))
    return 7 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(managed))
    return 8 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(managed)) or managed.engine.event_count != 1 or managed.engine.machine.accumulator != 7
    return 9 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_continue(managed, 4)) or managed.engine.event_count != 2
    return 10 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_reverse_step(managed)) or managed.engine.event_count != 1
    branch_id: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(managed.engine)
    second_branch_id: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(managed.engine)
    return 108 if branch_id.value == 0 or second_branch_id.value == branch_id.value
    exhausted_branch_engine: mutable DebuggerReplayEngine::ReplayEngine = managed.engine
    exhausted_branch_engine.next_branch_id <- Test::MAX_BRANCH_ID
    exhausted_branch_id: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(exhausted_branch_engine)
    return 133 if exhausted_branch_id.value != 0 or exhausted_branch_engine.next_branch_id != Test::MAX_BRANCH_ID
    branch: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(managed.engine, branch_id)
    return 25 if branch.parent_branch.value != managed.engine.branch.value or branch.fork_event != managed.engine.event_count
    parent_accumulator: i64 = managed.engine.machine.accumulator
    return 11 if not DebuggerReplayEngine::replay_engine_set_accumulator(branch, parent_accumulator + 10)
    return 12 if managed.engine.machine.accumulator != parent_accumulator or branch.machine.accumulator != parent_accumulator + 10
    return Test::BRANCH_EXACTNESS_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(branch)
    DebuggerReplayEngine::replay_engine_step(branch)
    return Test::BRANCH_EXACTNESS_RESULT if branch.engine_error != DebuggerReplayEngine::EngineError.None or branch.event_count != managed.engine.event_count + Test::BRANCH_SINGLE_EVENT_OFFSET or branch.machine.accumulator != parent_accumulator + 10 or not DebuggerReplayEngine::replay_engine_is_exact(branch)
    branch_result: i64 = branch.machine.result
    branch_end_event: usize = branch.event_count
    DebuggerReplayEngine::replay_engine_seek(branch, branch.fork_event)
    return Test::BRANCH_EXACTNESS_RESULT if branch.engine_error != DebuggerReplayEngine::EngineError.None or branch.event_count != branch.fork_event or branch.machine.accumulator != parent_accumulator + 10 or branch.machine.halted or not DebuggerReplayEngine::replay_engine_is_exact(branch)
    DebuggerReplayEngine::replay_engine_seek(branch, branch_end_event)
    return Test::BRANCH_EXACTNESS_RESULT if branch.engine_error != DebuggerReplayEngine::EngineError.None or branch.event_count != branch_end_event or branch.machine.result != branch_result or not DebuggerReplayEngine::replay_engine_is_exact(branch)
    DebuggerReplayEngine::replay_engine_seek(branch, branch.fork_event - Test::BRANCH_SINGLE_EVENT_OFFSET)
    return Test::BRANCH_EXACTNESS_RESULT if branch.engine_error != DebuggerReplayEngine::EngineError.None or branch.event_count != branch.fork_event - Test::BRANCH_SINGLE_EVENT_OFFSET
    DebuggerReplayEngine::replay_engine_seek(branch, branch.fork_event)
    return Test::BRANCH_EXACTNESS_RESULT if branch.engine_error != DebuggerReplayEngine::EngineError.None or branch.event_count != branch.fork_event or branch.machine.accumulator != parent_accumulator + 10 or not DebuggerReplayEngine::replay_engine_is_exact(branch)
    DebuggerReplayEngine::replay_engine_seek(branch, branch_end_event)
    return Test::BRANCH_EXACTNESS_RESULT if branch.engine_error != DebuggerReplayEngine::EngineError.None or branch.event_count != branch_end_event or branch.machine.accumulator != parent_accumulator + 10 or branch.machine.result != branch_result or not DebuggerReplayEngine::replay_engine_is_exact(branch)
    return Test::BRANCH_EXACTNESS_RESULT if managed.engine.machine.accumulator != parent_accumulator
    root_intervention: mutable DebuggerReplayEngine::ReplayEngine = managed.engine
    return Test::ROOT_INTERVENTION_RESULT if DebuggerReplayEngine::replay_engine_set_accumulator(root_intervention, parent_accumulator + 1)
    invalid_branch: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(managed.engine, DebuggerIdentity::debug_id(0))
    return 26 if invalid_branch.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable
    invalid_max_branch: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(managed.engine, DebuggerIdentity::debug_id(Test::MAX_BRANCH_ID))
    return 134 if invalid_max_branch.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable
    invalid_parent_branch: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(branch, managed.engine.branch)
    return 135 if invalid_parent_branch.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable
    managed_branch: mutable DebuggerReplayEngine::ReplayEngine = DebuggerManagedEngine::managed_fork(managed, DebuggerIdentity::debug_id(44))
    return 18 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_intervene_accumulator(managed_branch, 99)) or managed_branch.machine.accumulator != 99
    invalid_return_address_engine: mutable DebuggerReplayEngine::ReplayEngine = managed.engine
    invalid_return_snapshot: mutable DebuggerCheckpoint::MachineSnapshot = invalid_return_address_engine.history[Test::RETURN_INSTRUCTION_EVENT_INDEX]
    invalid_return_snapshot.return_stack_pointer <- Test::ACTIVE_RETURN_STACK_POINTER
    invalid_return_snapshot.return_stack[Test::FIRST_RETURN_STACK_SLOT] <- invalid_return_address_engine.image.program.instruction_count
    invalid_return_snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(invalid_return_snapshot)
    return Test::INVALID_IMAGE_RETURN_ADDRESS_RESULT if not DebuggerCheckpoint::snapshot_shape_is_valid(invalid_return_snapshot)
    invalid_return_address_engine.history[Test::RETURN_INSTRUCTION_EVENT_INDEX] <- invalid_return_snapshot
    return Test::INVALID_IMAGE_RETURN_ADDRESS_RESULT if DebuggerReplayEngine::replay_engine_snapshot_is_valid(invalid_return_address_engine, Test::RETURN_INSTRUCTION_EVENT_INDEX, invalid_return_snapshot)
    hash_before: u64 = DebuggerReplayEngine::replay_engine_state_hash(managed.engine)
    machine_for_hash: mutable DebuggerEDIR::Machine = managed.engine.machine
    machine_for_hash.locals[0] <- machine_for_hash.locals[0] + 1
    machine_for_hash.locals_initialized[0] <- true
    managed.engine.machine <- machine_for_hash
    hash_after: u64 = DebuggerReplayEngine::replay_engine_state_hash(managed.engine)
    return 19 if hash_before == hash_after
    checkpoint_bytes: DebuggerTraceBinary::ByteWriter = DebuggerManagedEngine::managed_checkpoint(managed)
    return 13 if not DebuggerTraceBinary::writer_is_valid(checkpoint_bytes)
    malformed_checkpoint_reader: mutable DebuggerTraceBinary::ByteReader = zeroed
    DebuggerTraceBinary::reader_initialize(malformed_checkpoint_reader, checkpoint_bytes.bytes[0], checkpoint_bytes.length)
    malformed_checkpoint_reader.bytes[Test::CHECKPOINT_HEAP_BYTE_OFFSET] <- 255
    malformed_checkpoint_reader.bytes[Test::CHECKPOINT_HEAP_BYTE_OFFSET + 1] <- 255
    malformed_checkpoint_reader.bytes[Test::CHECKPOINT_HEAP_BYTE_OFFSET + 2] <- 255
    malformed_checkpoint_reader.bytes[Test::CHECKPOINT_HEAP_BYTE_OFFSET + 3] <- 255
    malformed_checkpoint_reader.bytes[Test::CHECKPOINT_HEAP_BYTE_OFFSET + 4] <- 255
    malformed_checkpoint_reader.bytes[Test::CHECKPOINT_HEAP_BYTE_OFFSET + 5] <- 255
    malformed_checkpoint_reader.bytes[Test::CHECKPOINT_HEAP_BYTE_OFFSET + 6] <- 255
    malformed_checkpoint_reader.bytes[Test::CHECKPOINT_HEAP_BYTE_OFFSET + 7] <- 255
    malformed_checkpoint: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpointCodec::checkpoint_decode(malformed_checkpoint_reader)
    return Test::INVALID_CHECKPOINT_DECODE_RESULT if malformed_checkpoint.id.value != 0
    invalid_snapshot: mutable DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(managed.engine.machine, DebuggerIdentity::debug_id(59), managed.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(managed.engine))
    invalid_snapshot.program_counter <- 256
    restored_invalid: DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(invalid_snapshot)
    return 73 if not restored_invalid.halted or not restored_invalid.faulted
    invalid_memory_snapshot: mutable DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(managed.engine.machine, DebuggerIdentity::debug_id(60), managed.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(managed.engine))
    invalid_memory_snapshot.memory_initialized[Test::CHECKPOINT_MEMORY_CAPACITY - 1] <- true
    invalid_memory_snapshot.heap_next <- Test::CHECKPOINT_EMPTY_HEAP_NEXT
    return Test::INVALID_MEMORY_SHAPE_RESULT if DebuggerCheckpoint::snapshot_shape_is_valid(invalid_memory_snapshot)
    invalid_memory_snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(invalid_memory_snapshot)
    invalid_memory_bytes: DebuggerTraceBinary::ByteWriter = DebuggerCheckpointCodec::checkpoint_encode(invalid_memory_snapshot)
    return Test::INVALID_MEMORY_SHAPE_RESULT if DebuggerTraceBinary::writer_is_valid(invalid_memory_bytes)
    symbols: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(symbols)
    first_symbol_added: bool = DebuggerNativeSymbols::symbols_add(symbols, DebuggerNativeSymbols::Symbol{id: DebuggerIdentity::debug_id(100), address: 100, size: 4, name: DebuggerIdentity::debug_id(101), source: zeroed})
    return 102 if not first_symbol_added
    malformed_symbols: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(malformed_symbols)
    _ = DebuggerNativeSymbols::symbols_add(malformed_symbols, DebuggerNativeSymbols::Symbol{id: DebuggerIdentity::debug_id(100), address: 100, size: 4, name: DebuggerIdentity::debug_id(101), source: zeroed})
    malformed_symbols.symbols[0].source.file <- DebuggerIdentity::debug_id(1)
    return 155 if DebuggerNativeSymbols::symbols_is_valid(malformed_symbols)
    DebuggerNativeSymbols::symbols_set_load_bias(symbols, 1000)
    return 14 if DebuggerNativeSymbols::symbols_find(symbols, 1101).id.value != 100
    overlapping_symbol_added: bool = DebuggerNativeSymbols::symbols_add(symbols, DebuggerNativeSymbols::Symbol{id: DebuggerIdentity::debug_id(102), address: 101, size: 1, name: DebuggerIdentity::debug_id(103), source: zeroed})
    return 117 if not overlapping_symbol_added or DebuggerNativeSymbols::symbols_find(symbols, 1101).id.value != 102
    overflow_symbol_added: bool = DebuggerNativeSymbols::symbols_add(symbols, DebuggerNativeSymbols::Symbol{id: DebuggerIdentity::debug_id(104), address: 18446744073709551615, size: 2, name: DebuggerIdentity::debug_id(105), source: zeroed})
    return 118 if overflow_symbol_added or symbols.count != 2 or not DebuggerNativeSymbols::symbols_is_valid(symbols)
    return 103 if not DebuggerNativeSymbols::symbols_is_valid(symbols)
    return 104 if DebuggerPlatform::host_is_supported(DebuggerPlatform::unknown_host())
    host: DebuggerPlatform::HostTarget = DebuggerPlatform::HostTarget{operating_system: DebuggerPlatform::OperatingSystem.Linux, architecture: DebuggerPlatform::Architecture.X86_64, pointer_bits: Test::HOST_POINTER_BITS, page_size: Test::HOST_PAGE_SIZE}
    return 105 if not DebuggerPlatform::host_is_supported(host)
    artifact: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_new(DebuggerPostmortem::ArtifactKind.Core, DebuggerIdentity::debug_id(200))
    ready_artifact: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_crashed(artifact, 64, 1)
    return 15 if not DebuggerPostmortem::postmortem_can_inspect(ready_artifact) or ready_artifact.resumable
    repeated_ready: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_ready(ready_artifact, 32, 2)
    return 116 if repeated_ready.pointer_bits != ready_artifact.pointer_bits or repeated_ready.thread_count != ready_artifact.thread_count
    repeated_crash: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_crashed(ready_artifact, 32, 2)
    return 117 if repeated_crash.pointer_bits != ready_artifact.pointer_bits or repeated_crash.thread_count != ready_artifact.thread_count
    resumable_artifact: mutable DebuggerPostmortem::PostmortemArtifact = ready_artifact
    resumable_artifact.resumable <- true
    return Test::RESUMABLE_POSTMORTEM_RESULT if DebuggerPostmortem::postmortem_can_inspect(resumable_artifact)
    malformed_ready: mutable DebuggerPostmortem::PostmortemArtifact = ready_artifact
    malformed_ready.pointer_bits <- 0
    return 77 if DebuggerPostmortem::postmortem_can_inspect(malformed_ready)
    malformed_kind: mutable DebuggerPostmortem::PostmortemArtifact = ready_artifact
    malformed_kind.kind <- DebuggerPostmortem::ArtifactKind.Unknown
    return Test::INVALID_POSTMORTEM_KIND_RESULT if DebuggerPostmortem::postmortem_can_inspect(malformed_kind)
    malformed_build: mutable DebuggerPostmortem::PostmortemArtifact = ready_artifact
    malformed_build.build <- DebuggerIdentity::debug_id(0)
    return Test::INVALID_POSTMORTEM_BUILD_RESULT if DebuggerPostmortem::postmortem_can_inspect(malformed_build)
    invalid_ready: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_ready(artifact, 0, 0)
    return 29 if DebuggerPostmortem::postmortem_can_inspect(invalid_ready) or invalid_ready.state != DebuggerPostmortem::ArtifactState.Corrupt
    revived_artifact: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_crashed(invalid_ready, 64, 1)
    return 70 if revived_artifact.state != DebuggerPostmortem::ArtifactState.Corrupt
    return 25 if not DebuggerCLI::command_is_mutating(DebuggerCLI::Command.Checkpoint)
    return 26 if DebuggerCLI::command_is_mutating(DebuggerCLI::Command.TraceVerify)
    cli_request: DebuggerProtocolRequest::Request = DebuggerCLIRunner::request_for_command(DebuggerCLI::Command.Evaluate, 7, 3)
    return 17 if cli_request.method != DebuggerProtocolRequest::RequestMethod.Evaluate or cli_request.expected_generation != 3 or not cli_request.has_id
    budget_engine: mutable DebuggerReplayEngine::ReplayEngine
    DebuggerReplayEngine::replay_engine_initialize(budget_engine, image, DebuggerIdentity::debug_id(56))
    DebuggerReplayEngine::replay_engine_run(budget_engine, 1)
    return 20 if budget_engine.engine_error != DebuggerReplayEngine::EngineError.StepLimit
    DebuggerReplayEngine::replay_engine_seek(budget_engine, budget_engine.event_count)
    return 80 if budget_engine.engine_error != DebuggerReplayEngine::EngineError.None
    DebuggerReplayEngine::replay_engine_run(budget_engine, 1)
    return 21 if not DebuggerReplayEngine::replay_engine_is_exact(budget_engine) or not budget_engine.machine.halted
    corrupt_replay: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_replay.event_count <- Test::INVALID_REPLAY_EVENT_COUNT
    return 74 if DebuggerReplayEngine::replay_engine_is_exact(corrupt_replay)
    corrupt_snapshot: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_snapshot.history[0].faulted <- true
    corrupt_snapshot.history[0].halted <- false
    return Test::INVALID_REPLAY_SNAPSHOT_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_snapshot)
    corrupt_event_position: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_event_position.events[0].position.event <- 99
    return Test::INVALID_REPLAY_EVENT_POSITION_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_event_position)
    corrupt_event_branch: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_event_branch.events[0].position.branch <- DebuggerIdentity::debug_id(99)
    return Test::INVALID_REPLAY_BRANCH_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_event_branch)
    corrupt_event_statement: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_event_statement.events[0].position.statement <- DebuggerIdentity::debug_id(99)
    return Test::INVALID_REPLAY_STATEMENT_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_event_statement)
    corrupt_snapshot_id: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_snapshot_id.history[1].id <- DebuggerIdentity::debug_id(99)
    DebuggerReplayEngine::replay_engine_reverse_one(corrupt_snapshot_id)
    return Test::INVALID_REPLAY_SNAPSHOT_ID_RESULT if corrupt_snapshot_id.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable or corrupt_snapshot_id.event_count != budget_engine.event_count
    corrupt_snapshot_event: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_snapshot_event.history[1].event <- 99
    DebuggerReplayEngine::replay_engine_seek(corrupt_snapshot_event, Test::PARTIAL_SEEK_EVENT)
    return Test::INVALID_REPLAY_SNAPSHOT_EVENT_RESULT if corrupt_snapshot_event.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable or corrupt_snapshot_event.event_count != budget_engine.event_count
    corrupt_lineage: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_lineage.branch <- DebuggerIdentity::debug_id(1)
    corrupt_lineage.fork_event <- corrupt_lineage.event_count + 1
    return Test::INVALID_REPLAY_LINEAGE_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_lineage)
    corrupt_state_hash: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_state_hash.history[0].state_hash <- corrupt_state_hash.history[0].state_hash + 1
    return Test::INVALID_REPLAY_STATE_HASH_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_state_hash)
    corrupt_payload_hash: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_payload_hash.events[0].payload_hash <- corrupt_payload_hash.events[0].payload_hash + 1
    return Test::INVALID_REPLAY_PAYLOAD_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_payload_hash)
    corrupt_ring: mutable DebuggerSupport::U64Ring = DebuggerSupport::ring_new()
    corrupt_ring.values[0] <- 99
    corrupt_ring.count <- Test::INVALID_RING_COUNT
    return 75 if DebuggerSupport::ring_get(corrupt_ring, 0) != 0
    invalid_replay_image: mutable DebuggerEDIR::ProgramImage = image
    invalid_replay_image.program.instruction_count <- 257
    invalid_replay: mutable DebuggerReplayEngine::ReplayEngine
    DebuggerReplayEngine::replay_engine_initialize(invalid_replay, invalid_replay_image, DebuggerIdentity::debug_id(58))
    return 72 if not invalid_replay.machine.faulted or invalid_replay.engine_error != DebuggerReplayEngine::EngineError.ExecutionFault
    zero_recording_engine: mutable DebuggerReplayEngine::ReplayEngine
    DebuggerReplayEngine::replay_engine_initialize(zero_recording_engine, image, DebuggerIdentity::debug_id(0))
    return Test::ZERO_RECORDING_EXACT_RESULT if DebuggerReplayEngine::replay_engine_is_exact(zero_recording_engine)
    invalid_launch_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(59), build, DebuggerCapabilities::managed_capabilities())
    invalid_launch_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(invalid_launch_controller, invalid_launch_session, invalid_replay_image, DebuggerIdentity::debug_id(60))
    invalid_launch_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_launch(invalid_launch_controller)
    return 109 if invalid_launch_failure.code != DebuggerErrors::ErrorCode.Diverged or invalid_launch_controller.session.state != DebuggerSession::SessionState.Created
    invalid_step_session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(60), build, DebuggerCapabilities::managed_capabilities())
    invalid_step_session.state <- DebuggerSession::SessionState.Stopped
    invalid_step_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(invalid_step_controller, invalid_step_session, invalid_replay_image, DebuggerIdentity::debug_id(61))
    invalid_step_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step(invalid_step_controller)
    return Test::INVALID_ENGINE_STEP_RESULT if invalid_step_failure.code != DebuggerErrors::ErrorCode.Diverged
    fault_image: mutable DebuggerEDIR::ProgramImage = image
    fault_image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Divide, a: 0, b: 0, source: zeroed}
    fault_session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(62), build, DebuggerCapabilities::managed_capabilities())
    fault_session.state <- DebuggerSession::SessionState.Stopped
    fault_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(fault_controller, fault_session, fault_image, DebuggerIdentity::debug_id(63))
    fault_event_before: usize = fault_controller.engine.event_count
    fault_state_hash_before: u64 = DebuggerReplayEngine::replay_engine_state_hash(fault_controller.engine)
    fault_seek_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(fault_controller, 1)
    return Test::FAULTING_SEEK_RESULT if fault_seek_failure.code != DebuggerErrors::ErrorCode.Diverged or fault_controller.session.position.event != 0 or fault_controller.engine.event_count != fault_event_before
    return Test::FAULTING_SEEK_RESULT if fault_controller.engine.machine.faulted or fault_controller.engine.machine.halted or fault_controller.engine.machine.program_counter != 0 or fault_controller.engine.engine_error != DebuggerReplayEngine::EngineError.None
    return Test::FAULTING_SEEK_RESULT if DebuggerReplayEngine::replay_engine_state_hash(fault_controller.engine) != fault_state_hash_before
    fault_step_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(66), build, DebuggerCapabilities::managed_capabilities())
    fault_step_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(fault_step_controller, fault_step_session, fault_image, DebuggerIdentity::debug_id(67))
    return Test::FAULTING_STEP_INVALIDATION_RESULT if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(fault_step_controller))
    return Test::FAULTING_STEP_INVALIDATION_RESULT if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(fault_step_controller))
    fault_step_generation_before: u64 = fault_step_controller.session.stop_generation
    fault_step_stale_handle: DebuggerValues::ValueHandle = fault_step_controller.state.values.nodes[0].handle
    fault_step_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step(fault_step_controller)
    return 110 if fault_step_failure.code != DebuggerErrors::ErrorCode.Diverged or fault_step_controller.session.position.event != fault_step_controller.engine.event_count.u64()
    return Test::FAULTING_STEP_INVALIDATION_RESULT if fault_step_controller.session.stop_generation != fault_step_generation_before + Test::FAULT_STEP_GENERATION_INCREMENT or DebuggerValueStore::value_handle_is_valid(fault_step_controller.state.values, fault_step_stale_handle)
    partial_capabilities: mutable DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    partial_capabilities.history <- DebuggerCapabilities::HistoryKind.Replayable
    partial_session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(64), build, partial_capabilities)
    partial_session.state <- DebuggerSession::SessionState.Stopped
    partial_controller: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(partial_controller, partial_session, image, DebuggerIdentity::debug_id(65))
    partial_seek_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(partial_controller, Test::PARTIAL_SEEK_EVENT)
    return 83 if partial_seek_failure.code != DebuggerErrors::ErrorCode.Unsupported or partial_controller.engine.event_count != 0 or partial_controller.session.position.event != 0
    limited: mutable DebuggerManagedEngine::ManagedController = zeroed
    DebuggerManagedEngine::managed_initialize(limited, session, image, DebuggerIdentity::debug_id(57))
    return 22 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(limited))
    return 23 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(limited))
    limited_error: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(limited, 0)
    return 24 if limited_error.code != DebuggerErrors::ErrorCode.Unavailable or limited.session.state != DebuggerSession::SessionState.Stopped
    return 0
