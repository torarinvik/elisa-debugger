# Compile-time coverage for the public core/provider/security modules.

include "../src/core/errors.elisa"
include "../src/core/cancellation.elisa"
include "../src/engine/provider.elisa"
include "../src/engine/coordinator.elisa"
include "../src/build/manifest.elisa"
include "../src/build/discovery.elisa"
include "../src/security/policy.elisa"
include "../src/platform/host.elisa"
include "../src/platform/process.elisa"
include "../src/native/symbols.elisa"
include "../src/native/postmortem.elisa"
include "../src/support/collections.elisa"
include "../src/cli/commands.elisa"
include "../src/cli/runner.elisa"
include "../src/engine/managed.elisa"
include "../src/vm/edir.elisa"
include "../src/replay/engine.elisa"

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
    manifest: mutable DebuggerBuild::BuildManifest = DebuggerBuild::build_manifest_new(build)
    manifest.executable.present <- true
    manifest.source.present <- true
    return 27 if DebuggerBuild::build_manifest_require_artifacts(manifest).detail != 3
    manifest.runtime.present <- true
    return 28 if not DebuggerErrors::error_is_ok(DebuggerBuild::build_manifest_require_artifacts(manifest))
    coordinator: mutable DebuggerCoordinator::Coordinator = DebuggerCoordinator::coordinator_new(session)
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
    created: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(coordinator, 1, DebuggerCoordinator::Operation.CreateSession, 0, token)
    return 1 if not created.accepted or created.coordinator.session.state != DebuggerSession::SessionState.Configuring
    launched: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(created.coordinator, 2, DebuggerCoordinator::Operation.Launch, 0, token)
    return 2 if not launched.accepted or launched.coordinator.session.state != DebuggerSession::SessionState.Running
    stopped: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(launched.coordinator, 3, DebuggerCoordinator::Operation.Pause, 0, token)
    return 3 if not stopped.accepted or stopped.coordinator.session.stop_generation != 1
    stale: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 4, DebuggerCoordinator::Operation.Continue, 99, token)
    return 4 if stale.accepted or stale.failure.code != DebuggerErrors::ErrorCode.StaleGeneration
    cancelled_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_cancel(token)
    cancelled: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 5, DebuggerCoordinator::Operation.Continue, 0, cancelled_token)
    return 5 if cancelled.accepted or cancelled.failure.code != DebuggerErrors::ErrorCode.Cancelled
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: 1, instruction_count: 2, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 7, b: 0, source: zeroed}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    managed: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(session, image, DebuggerIdentity::debug_id(55))
    return 6 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(managed))
    return 7 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(managed))
    return 8 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(managed)) or managed.engine.event_count != 1 or managed.engine.machine.accumulator != 7
    return 9 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_continue(managed, 4)) or managed.engine.event_count != 2
    return 10 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_reverse_step(managed)) or managed.engine.event_count != 1
    branch_id: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(managed.engine)
    branch: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(managed.engine, branch_id)
    return 25 if branch.parent_branch.value != managed.engine.branch.value or branch.fork_event != managed.engine.event_count
    parent_accumulator: i64 = managed.engine.machine.accumulator
    return 11 if not DebuggerReplayEngine::replay_engine_set_accumulator(branch, parent_accumulator + 10)
    return 12 if managed.engine.machine.accumulator != parent_accumulator or branch.machine.accumulator != parent_accumulator + 10
    invalid_branch: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(managed.engine, DebuggerIdentity::debug_id(0))
    return 26 if invalid_branch.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable
    managed_branch: mutable DebuggerReplayEngine::ReplayEngine = DebuggerManagedEngine::managed_fork(managed, DebuggerIdentity::debug_id(44))
    return 18 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_intervene_accumulator(managed_branch, 99)) or managed_branch.machine.accumulator != 99
    hash_before: u64 = DebuggerReplayEngine::replay_engine_state_hash(managed.engine)
    machine_for_hash: mutable DebuggerEDIR::Machine = managed.engine.machine
    machine_for_hash.locals[0] <- machine_for_hash.locals[0] + 1
    managed.engine.machine <- machine_for_hash
    hash_after: u64 = DebuggerReplayEngine::replay_engine_state_hash(managed.engine)
    return 19 if hash_before == hash_after
    checkpoint_bytes: DebuggerTraceBinary::ByteWriter = DebuggerManagedEngine::managed_checkpoint(managed)
    return 13 if not DebuggerTraceBinary::writer_is_valid(checkpoint_bytes)
    symbols: mutable DebuggerNativeSymbols::SymbolTable = DebuggerNativeSymbols::symbols_add(DebuggerNativeSymbols::symbols_new(), DebuggerNativeSymbols::Symbol{id: DebuggerIdentity::debug_id(100), address: 100, size: 4, name: DebuggerIdentity::debug_id(101), source: zeroed})
    DebuggerNativeSymbols::symbols_set_load_bias(symbols, 1000)
    return 14 if DebuggerNativeSymbols::symbols_find(symbols, 1101).id.value != 100
    artifact: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_new(DebuggerPostmortem::ArtifactKind.Core, DebuggerIdentity::debug_id(200))
    ready_artifact: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_crashed(artifact, 64, 1)
    return 15 if not DebuggerPostmortem::postmortem_can_inspect(ready_artifact) or ready_artifact.resumable
    return 16 if DebuggerCLIRunner::command_from_hash(3197505128) != DebuggerCLI::Command.Locals
    cli_request: DebuggerProtocolRequest::Request = DebuggerCLIRunner::request_for_command(DebuggerCLI::Command.Evaluate, 7, 3)
    return 17 if cli_request.method != DebuggerProtocolRequest::RequestMethod.Evaluate or cli_request.expected_generation != 3 or not cli_request.has_id
    budget_engine: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(56))
    DebuggerReplayEngine::replay_engine_run(budget_engine, 1)
    return 20 if budget_engine.engine_error != DebuggerReplayEngine::EngineError.StepLimit
    DebuggerReplayEngine::replay_engine_run(budget_engine, 1)
    return 21 if not DebuggerReplayEngine::replay_engine_is_exact(budget_engine) or not budget_engine.machine.halted
    limited: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(session, image, DebuggerIdentity::debug_id(57))
    return 22 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(limited))
    return 23 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(limited))
    limited_error: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(limited, 0)
    return 24 if limited_error.code != DebuggerErrors::ErrorCode.Unavailable or limited.session.state != DebuggerSession::SessionState.Stopped
    return 0
