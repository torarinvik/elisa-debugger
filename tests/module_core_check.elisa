# Compile-time coverage for the public core/provider/security modules.

include "../src/core/errors.elisa"
include "../src/core/cancellation.elisa"
include "../src/engine/provider.elisa"
include "../src/engine/coordinator.elisa"
include "../src/build/manifest.elisa"
include "../src/build/discovery.elisa"
include "../src/security/policy.elisa"
include "../src/platform/host.elisa"
include "../src/platform/process.elisa"
include "../src/native/symbols.elisa"
include "../src/native/postmortem.elisa"
include "../src/support/collections.elisa"
include "../src/cli/commands.elisa"
include "../src/cli/runner.elisa"
include "../src/protocol/dap.elisa"
include "../src/engine/managed.elisa"
include "../src/vm/edir.elisa"
include "../src/replay/engine.elisa"

const INVALID_REPLAY_EVENT_COUNT: usize = 65
const INVALID_RING_COUNT: usize = 257
const INVALID_POSTMORTEM_KIND_RESULT: i64 = 78
const INVALID_POSTMORTEM_BUILD_RESULT: i64 = 79
const INVALID_ENGINE_STEP_RESULT: i64 = 81
const ZERO_RECORDING_EXACT_RESULT: i64 = 111
const RESUMABLE_POSTMORTEM_RESULT: i64 = 114
const FAULTING_SEEK_RESULT: i64 = 82
const INVALID_REPLAY_SNAPSHOT_RESULT: i64 = 120
const INVALID_REPLAY_EVENT_POSITION_RESULT: i64 = 121
const INVALID_REPLAY_STATE_HASH_RESULT: i64 = 122
const INVALID_CHECKPOINT_DECODE_RESULT: i64 = 131
const INVALID_REPLAY_PAYLOAD_RESULT: i64 = 132
const CHECKPOINT_SCHEMA_BYTES: usize = 4
const CHECKPOINT_INTEGER_BYTES: usize = 8
const CHECKPOINT_SCALARS_BEFORE_MEMORY: usize = 5
const CHECKPOINT_LOCAL_CAPACITY: usize = 32
const CHECKPOINT_GLOBAL_CAPACITY: usize = 16
const CHECKPOINT_MEMORY_CAPACITY: usize = 64
const CHECKPOINT_MEMORY_FLAG_BYTES: usize = 1
const CHECKPOINT_HEAP_BYTE_OFFSET: usize = CHECKPOINT_SCHEMA_BYTES + CHECKPOINT_INTEGER_BYTES * (CHECKPOINT_SCALARS_BEFORE_MEMORY + CHECKPOINT_LOCAL_CAPACITY + CHECKPOINT_GLOBAL_CAPACITY + CHECKPOINT_MEMORY_CAPACITY) + CHECKPOINT_MEMORY_CAPACITY * CHECKPOINT_MEMORY_FLAG_BYTES + CHECKPOINT_GLOBAL_CAPACITY
const CHECKPOINT_EMPTY_HEAP_NEXT: usize = 0
const INVALID_MEMORY_SHAPE_RESULT: i64 = 123
const HOST_POINTER_BITS: u32 = 64
const HOST_PAGE_SIZE: u64 = 4096
const PARTIAL_SEEK_EVENT: usize = 1
const TOOL_PATH_ID: u64 = 10
const TOOL_REVISION: u64 = 11
const EXECUTABLE_ARTIFACT_ID: u64 = 20
const SOURCE_ARTIFACT_ID: u64 = 21
const RUNTIME_ARTIFACT_ID: u64 = 22
const MISSING_ARTIFACT_ID_RESULT: i64 = 113
const MAX_BRANCH_ID: u64 = 18446744073709551615
const DISCOVERY_WITHOUT_ID_RESULT: i64 = 142
const ROOT_INTERVENTION_RESULT: i64 = 134
const BRANCH_EXACTNESS_RESULT: i64 = 135
const INVALID_REPLAY_BRANCH_RESULT: i64 = 136
const INVALID_REPLAY_STATEMENT_RESULT: i64 = 137
const INVALID_REPLAY_SNAPSHOT_ID_RESULT: i64 = 138
const INVALID_REPLAY_SNAPSHOT_EVENT_RESULT: i64 = 139
const INVALID_REPLAY_LINEAGE_RESULT: i64 = 140
const COORDINATOR_MEMORY_CAPABILITY_RESULT: i64 = 143

def check_reverse_error_preserves_session() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: 1, instruction_count: 1, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
    session.state <- DebuggerSession::SessionState.Stopped
    session.position.event <- INVALID_REPLAY_EVENT_COUNT.u64()
    controller: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(session, image, DebuggerIdentity::debug_id(5))
    controller.engine.event_count <- INVALID_REPLAY_EVENT_COUNT
    failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_reverse_step(controller)
    return 1 if failure.code != DebuggerErrors::ErrorCode.Unavailable or controller.session.position.event != INVALID_REPLAY_EVENT_COUNT.u64()
    return 0

def main() -> i64:
    return 71 if check_reverse_error_preserves_session() != 0
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
    dap_capabilities: DebuggerDAP::AdapterCapabilities = DebuggerDAP::capabilities_for(session)
    return 30 if dap_capabilities.supports_restart_request or dap_capabilities.supports_set_variable or not dap_capabilities.supports_read_memory
    manifest: mutable DebuggerBuild::BuildManifest = DebuggerBuild::build_manifest_new(build)
    manifest.executable.present <- true
    manifest.executable.id <- DebuggerIdentity::debug_id(EXECUTABLE_ARTIFACT_ID)
    manifest.source.present <- true
    manifest.source.id <- DebuggerIdentity::debug_id(SOURCE_ARTIFACT_ID)
    return 27 if DebuggerBuild::build_manifest_require_artifacts(manifest).detail != 3
    manifest.runtime.present <- true
    manifest.runtime.id <- DebuggerIdentity::debug_id(RUNTIME_ARTIFACT_ID)
    return 28 if not DebuggerErrors::error_is_ok(DebuggerBuild::build_manifest_require_artifacts(manifest))
    missing_artifact: mutable DebuggerBuild::BuildManifest = manifest
    missing_artifact.source.id <- DebuggerIdentity::debug_id(0)
    return MISSING_ARTIFACT_ID_RESULT if DebuggerErrors::error_is_ok(DebuggerBuild::build_manifest_require_artifacts(missing_artifact))
    toolchain: mutable DebuggerCompilerDiscovery::Toolchain = DebuggerCompilerDiscovery::toolchain_new()
    toolchain.compiler.present <- true
    toolchain.runtime.present <- true
    toolchain.compiler.major <- 1
    toolchain.runtime.major <- 1
    return 106 if DebuggerCompilerDiscovery::toolchain_is_compatible(toolchain)
    toolchain.compiler.path_id <- TOOL_PATH_ID
    toolchain.runtime.path_id <- TOOL_PATH_ID
    toolchain.compiler.revision <- TOOL_REVISION
    toolchain.runtime.revision <- TOOL_REVISION
    return 107 if not DebuggerCompilerDiscovery::toolchain_is_compatible(toolchain)
    zero_build: DebuggerIdentity::BuildIdentity = zeroed
    zero_manifest: DebuggerBuild::BuildManifest = DebuggerBuild::build_manifest_new(zero_build)
    return 76 if DebuggerBuild::build_manifest_is_compatible(zero_manifest, zero_build)
    malformed_error: mutable DebuggerErrors::DebuggerError = DebuggerErrors::no_error()
    malformed_error.severity <- DebuggerErrors::ErrorSeverity.Failure
    return 78 if DebuggerErrors::error_is_ok(malformed_error)
    return 79 if DebuggerErrors::error_is_well_formed(malformed_error) or not DebuggerErrors::error_is_well_formed(DebuggerErrors::no_error())
    coordinator: mutable DebuggerCoordinator::Coordinator = DebuggerCoordinator::coordinator_new(session)
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
    created: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(coordinator, 1, DebuggerCoordinator::Operation.CreateSession, 0, token)
    return 1 if not created.accepted or created.coordinator.session.state != DebuggerSession::SessionState.Configuring
    launched: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(created.coordinator, 2, DebuggerCoordinator::Operation.Launch, 0, token)
    return 2 if not launched.accepted or launched.coordinator.session.state != DebuggerSession::SessionState.Running
    stopped: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(launched.coordinator, 3, DebuggerCoordinator::Operation.Pause, 0, token)
    return 3 if not stopped.accepted or stopped.coordinator.session.stop_generation != 1
    stale: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 4, DebuggerCoordinator::Operation.Continue, 99, token)
    return 4 if stale.accepted or stale.failure.code != DebuggerErrors::ErrorCode.StaleGeneration
    limited_capabilities: mutable DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    limited_capabilities.memory_read <- false
    limited_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(7), build, limited_capabilities)
    limited_session.state <- DebuggerSession::SessionState.Stopped
    limited_coordinator: DebuggerCoordinator::Coordinator = DebuggerCoordinator::coordinator_new(limited_session)
    denied_memory: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(limited_coordinator, 6, DebuggerCoordinator::Operation.Memory, 0, token)
    return COORDINATOR_MEMORY_CAPABILITY_RESULT if denied_memory.accepted or denied_memory.failure.code != DebuggerErrors::ErrorCode.Unavailable
    cancelled_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_cancel(token)
    cancelled: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 5, DebuggerCoordinator::Operation.Continue, 0, cancelled_token)
    return 5 if cancelled.accepted or cancelled.failure.code != DebuggerErrors::ErrorCode.Cancelled
    invalid_request_id: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 0, DebuggerCoordinator::Operation.Continue, 0, token)
    return 111 if invalid_request_id.accepted or invalid_request_id.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    return 112 if invalid_request_id.coordinator.last_error.code != DebuggerErrors::ErrorCode.InvalidArgument
    discovery_without_id: DebuggerCoordinator::Result = DebuggerCoordinator::coordinator_execute(stopped.coordinator, 0, DebuggerCoordinator::Operation.Discover, 0, token)
    return DISCOVERY_WITHOUT_ID_RESULT if not discovery_without_id.accepted or discovery_without_id.request_id != 0
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: 1, instruction_count: 2, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: 7, b: 0, source: zeroed}
    image.instructions[1] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    managed: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(session, image, DebuggerIdentity::debug_id(55))
    return 6 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(managed))
    return 7 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(managed))
    return 8 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_step(managed)) or managed.engine.event_count != 1 or managed.engine.machine.accumulator != 7
    return 9 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_continue(managed, 4)) or managed.engine.event_count != 2
    return 10 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_reverse_step(managed)) or managed.engine.event_count != 1
    branch_id: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(managed.engine)
    second_branch_id: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(managed.engine)
    return 108 if branch_id.value == 0 or second_branch_id.value == branch_id.value
    exhausted_branch_engine: mutable DebuggerReplayEngine::ReplayEngine = managed.engine
    exhausted_branch_engine.next_branch_id <- MAX_BRANCH_ID
    exhausted_branch_id: DebuggerIdentity::DebugId = DebuggerReplayEngine::replay_engine_next_branch(exhausted_branch_engine)
    return 133 if exhausted_branch_id.value != 0 or exhausted_branch_engine.next_branch_id != MAX_BRANCH_ID
    branch: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(managed.engine, branch_id)
    return 25 if branch.parent_branch.value != managed.engine.branch.value or branch.fork_event != managed.engine.event_count
    parent_accumulator: i64 = managed.engine.machine.accumulator
    return 11 if not DebuggerReplayEngine::replay_engine_set_accumulator(branch, parent_accumulator + 10)
    return 12 if managed.engine.machine.accumulator != parent_accumulator or branch.machine.accumulator != parent_accumulator + 10
    return BRANCH_EXACTNESS_RESULT if DebuggerReplayEngine::replay_engine_is_exact(branch)
    root_intervention: mutable DebuggerReplayEngine::ReplayEngine = managed.engine
    return ROOT_INTERVENTION_RESULT if DebuggerReplayEngine::replay_engine_set_accumulator(root_intervention, parent_accumulator + 1)
    invalid_branch: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(managed.engine, DebuggerIdentity::debug_id(0))
    return 26 if invalid_branch.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable
    managed_branch: mutable DebuggerReplayEngine::ReplayEngine = DebuggerManagedEngine::managed_fork(managed, DebuggerIdentity::debug_id(44))
    return 18 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_intervene_accumulator(managed_branch, 99)) or managed_branch.machine.accumulator != 99
    hash_before: u64 = DebuggerReplayEngine::replay_engine_state_hash(managed.engine)
    machine_for_hash: mutable DebuggerEDIR::Machine = managed.engine.machine
    machine_for_hash.locals[0] <- machine_for_hash.locals[0] + 1
    managed.engine.machine <- machine_for_hash
    hash_after: u64 = DebuggerReplayEngine::replay_engine_state_hash(managed.engine)
    return 19 if hash_before == hash_after
    checkpoint_bytes: DebuggerTraceBinary::ByteWriter = DebuggerManagedEngine::managed_checkpoint(managed)
    return 13 if not DebuggerTraceBinary::writer_is_valid(checkpoint_bytes)
    malformed_checkpoint_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(checkpoint_bytes.bytes[0], checkpoint_bytes.length)
    malformed_checkpoint_reader.bytes[CHECKPOINT_HEAP_BYTE_OFFSET] <- 255
    malformed_checkpoint_reader.bytes[CHECKPOINT_HEAP_BYTE_OFFSET + 1] <- 255
    malformed_checkpoint_reader.bytes[CHECKPOINT_HEAP_BYTE_OFFSET + 2] <- 255
    malformed_checkpoint_reader.bytes[CHECKPOINT_HEAP_BYTE_OFFSET + 3] <- 255
    malformed_checkpoint_reader.bytes[CHECKPOINT_HEAP_BYTE_OFFSET + 4] <- 255
    malformed_checkpoint_reader.bytes[CHECKPOINT_HEAP_BYTE_OFFSET + 5] <- 255
    malformed_checkpoint_reader.bytes[CHECKPOINT_HEAP_BYTE_OFFSET + 6] <- 255
    malformed_checkpoint_reader.bytes[CHECKPOINT_HEAP_BYTE_OFFSET + 7] <- 255
    malformed_checkpoint: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpointCodec::checkpoint_decode(malformed_checkpoint_reader)
    return INVALID_CHECKPOINT_DECODE_RESULT if malformed_checkpoint.id.value != 0
    invalid_snapshot: mutable DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(managed.engine.machine, DebuggerIdentity::debug_id(59), managed.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(managed.engine))
    invalid_snapshot.program_counter <- 256
    restored_invalid: DebuggerEDIR::Machine = DebuggerCheckpoint::snapshot_restore(invalid_snapshot)
    return 73 if not restored_invalid.halted or not restored_invalid.faulted
    invalid_memory_snapshot: mutable DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(managed.engine.machine, DebuggerIdentity::debug_id(60), managed.engine.event_count.u64(), DebuggerReplayEngine::replay_engine_state_hash(managed.engine))
    invalid_memory_snapshot.memory_initialized[CHECKPOINT_MEMORY_CAPACITY - 1] <- true
    invalid_memory_snapshot.heap_next <- CHECKPOINT_EMPTY_HEAP_NEXT
    return INVALID_MEMORY_SHAPE_RESULT if DebuggerCheckpoint::snapshot_shape_is_valid(invalid_memory_snapshot)
    invalid_memory_snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(invalid_memory_snapshot)
    invalid_memory_bytes: DebuggerTraceBinary::ByteWriter = DebuggerCheckpointCodec::checkpoint_encode(invalid_memory_snapshot)
    return INVALID_MEMORY_SHAPE_RESULT if DebuggerTraceBinary::writer_is_valid(invalid_memory_bytes)
    symbols: mutable DebuggerNativeSymbols::SymbolTable = DebuggerNativeSymbols::symbols_add(DebuggerNativeSymbols::symbols_new(), DebuggerNativeSymbols::Symbol{id: DebuggerIdentity::debug_id(100), address: 100, size: 4, name: DebuggerIdentity::debug_id(101), source: zeroed})
    DebuggerNativeSymbols::symbols_set_load_bias(symbols, 1000)
    return 14 if DebuggerNativeSymbols::symbols_find(symbols, 1101).id.value != 100
    return 103 if not DebuggerNativeSymbols::symbols_is_valid(symbols)
    return 104 if DebuggerPlatform::host_is_supported(DebuggerPlatform::unknown_host())
    host: DebuggerPlatform::HostTarget = DebuggerPlatform::HostTarget{operating_system: DebuggerPlatform::OperatingSystem.Linux, architecture: DebuggerPlatform::Architecture.X86_64, pointer_bits: HOST_POINTER_BITS, page_size: HOST_PAGE_SIZE}
    return 105 if not DebuggerPlatform::host_is_supported(host)
    artifact: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_new(DebuggerPostmortem::ArtifactKind.Core, DebuggerIdentity::debug_id(200))
    ready_artifact: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_crashed(artifact, 64, 1)
    return 15 if not DebuggerPostmortem::postmortem_can_inspect(ready_artifact) or ready_artifact.resumable
    resumable_artifact: mutable DebuggerPostmortem::PostmortemArtifact = ready_artifact
    resumable_artifact.resumable <- true
    return RESUMABLE_POSTMORTEM_RESULT if DebuggerPostmortem::postmortem_can_inspect(resumable_artifact)
    malformed_ready: mutable DebuggerPostmortem::PostmortemArtifact = ready_artifact
    malformed_ready.pointer_bits <- 0
    return 77 if DebuggerPostmortem::postmortem_can_inspect(malformed_ready)
    malformed_kind: mutable DebuggerPostmortem::PostmortemArtifact = ready_artifact
    malformed_kind.kind <- DebuggerPostmortem::ArtifactKind.Unknown
    return INVALID_POSTMORTEM_KIND_RESULT if DebuggerPostmortem::postmortem_can_inspect(malformed_kind)
    malformed_build: mutable DebuggerPostmortem::PostmortemArtifact = ready_artifact
    malformed_build.build <- DebuggerIdentity::debug_id(0)
    return INVALID_POSTMORTEM_BUILD_RESULT if DebuggerPostmortem::postmortem_can_inspect(malformed_build)
    invalid_ready: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_ready(artifact, 0, 0)
    return 29 if DebuggerPostmortem::postmortem_can_inspect(invalid_ready) or invalid_ready.state != DebuggerPostmortem::ArtifactState.Corrupt
    revived_artifact: DebuggerPostmortem::PostmortemArtifact = DebuggerPostmortem::postmortem_mark_crashed(invalid_ready, 64, 1)
    return 70 if revived_artifact.state != DebuggerPostmortem::ArtifactState.Corrupt
    return 16 if DebuggerCLIRunner::command_from_hash(3197505128) != DebuggerCLI::Command.Locals
    return 18 if DebuggerCLIRunner::command_from_hash(96446734868) != DebuggerCLI::Command.Inspect
    return 19 if DebuggerCLIRunner::command_from_hash(98176544592272926) != DebuggerCLI::Command.TraceVerify
    return 22 if DebuggerCLIRunner::command_from_hash(91144797413) != DebuggerCLI::Command.Compare
    return 23 if DebuggerCLIRunner::command_from_hash(2709093068854664) != DebuggerCLI::Command.Checkpoint
    return 24 if DebuggerCLIRunner::command_from_hash(110132110) != DebuggerCLI::Command.Tasks
    return 25 if not DebuggerCLI::command_is_mutating(DebuggerCLI::Command.Checkpoint)
    return 26 if DebuggerCLI::command_is_mutating(DebuggerCLI::Command.TraceVerify)
    return 68 if DebuggerCLIRunner::command_from_hash(0) != DebuggerCLI::Command.Unknown
    cli_request: DebuggerProtocolRequest::Request = DebuggerCLIRunner::request_for_command(DebuggerCLI::Command.Evaluate, 7, 3)
    return 17 if cli_request.method != DebuggerProtocolRequest::RequestMethod.Evaluate or cli_request.expected_generation != 3 or not cli_request.has_id
    budget_engine: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(56))
    DebuggerReplayEngine::replay_engine_run(budget_engine, 1)
    return 20 if budget_engine.engine_error != DebuggerReplayEngine::EngineError.StepLimit
    DebuggerReplayEngine::replay_engine_seek(budget_engine, budget_engine.event_count)
    return 80 if budget_engine.engine_error != DebuggerReplayEngine::EngineError.None
    DebuggerReplayEngine::replay_engine_run(budget_engine, 1)
    return 21 if not DebuggerReplayEngine::replay_engine_is_exact(budget_engine) or not budget_engine.machine.halted
    corrupt_replay: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_replay.event_count <- INVALID_REPLAY_EVENT_COUNT
    return 74 if DebuggerReplayEngine::replay_engine_is_exact(corrupt_replay)
    corrupt_snapshot: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_snapshot.history[0].faulted <- true
    corrupt_snapshot.history[0].halted <- false
    return INVALID_REPLAY_SNAPSHOT_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_snapshot)
    corrupt_event_position: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_event_position.events[0].position.event <- 99
    return INVALID_REPLAY_EVENT_POSITION_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_event_position)
    corrupt_event_branch: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_event_branch.events[0].position.branch <- DebuggerIdentity::debug_id(99)
    return INVALID_REPLAY_BRANCH_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_event_branch)
    corrupt_event_statement: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_event_statement.events[0].position.statement <- DebuggerIdentity::debug_id(99)
    return INVALID_REPLAY_STATEMENT_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_event_statement)
    corrupt_snapshot_id: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_snapshot_id.history[1].id <- DebuggerIdentity::debug_id(99)
    DebuggerReplayEngine::replay_engine_reverse_one(corrupt_snapshot_id)
    return INVALID_REPLAY_SNAPSHOT_ID_RESULT if corrupt_snapshot_id.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable or corrupt_snapshot_id.event_count != budget_engine.event_count
    corrupt_snapshot_event: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_snapshot_event.history[1].event <- 99
    DebuggerReplayEngine::replay_engine_seek(corrupt_snapshot_event, PARTIAL_SEEK_EVENT)
    return INVALID_REPLAY_SNAPSHOT_EVENT_RESULT if corrupt_snapshot_event.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable or corrupt_snapshot_event.event_count != budget_engine.event_count
    corrupt_lineage: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_lineage.branch <- DebuggerIdentity::debug_id(1)
    corrupt_lineage.fork_event <- corrupt_lineage.event_count + 1
    return INVALID_REPLAY_LINEAGE_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_lineage)
    corrupt_state_hash: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_state_hash.history[0].state_hash <- corrupt_state_hash.history[0].state_hash + 1
    return INVALID_REPLAY_STATE_HASH_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_state_hash)
    corrupt_payload_hash: mutable DebuggerReplayEngine::ReplayEngine = budget_engine
    corrupt_payload_hash.events[0].payload_hash <- corrupt_payload_hash.events[0].payload_hash + 1
    return INVALID_REPLAY_PAYLOAD_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_payload_hash)
    corrupt_ring: mutable DebuggerSupport::U64Ring = DebuggerSupport::ring_new()
    corrupt_ring.values[0] <- 99
    corrupt_ring.count <- INVALID_RING_COUNT
    return 75 if DebuggerSupport::ring_get(corrupt_ring, 0) != 0
    invalid_replay_image: mutable DebuggerEDIR::ProgramImage = image
    invalid_replay_image.program.instruction_count <- 257
    invalid_replay: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(invalid_replay_image, DebuggerIdentity::debug_id(58))
    return 72 if not invalid_replay.machine.faulted or invalid_replay.engine_error != DebuggerReplayEngine::EngineError.ExecutionFault
    zero_recording_engine: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(0))
    return ZERO_RECORDING_EXACT_RESULT if DebuggerReplayEngine::replay_engine_is_exact(zero_recording_engine)
    invalid_launch_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(59), build, DebuggerCapabilities::managed_capabilities())
    invalid_launch_controller: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(invalid_launch_session, invalid_replay_image, DebuggerIdentity::debug_id(60))
    invalid_launch_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_launch(invalid_launch_controller)
    return 109 if invalid_launch_failure.code != DebuggerErrors::ErrorCode.Diverged or invalid_launch_controller.session.state != DebuggerSession::SessionState.Created
    invalid_step_session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(60), build, DebuggerCapabilities::managed_capabilities())
    invalid_step_session.state <- DebuggerSession::SessionState.Stopped
    invalid_step_controller: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(invalid_step_session, invalid_replay_image, DebuggerIdentity::debug_id(61))
    invalid_step_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step(invalid_step_controller)
    return INVALID_ENGINE_STEP_RESULT if invalid_step_failure.code != DebuggerErrors::ErrorCode.Diverged
    fault_image: mutable DebuggerEDIR::ProgramImage = image
    fault_image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Divide, a: 0, b: 0, source: zeroed}
    fault_session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(62), build, DebuggerCapabilities::managed_capabilities())
    fault_session.state <- DebuggerSession::SessionState.Stopped
    fault_controller: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(fault_session, fault_image, DebuggerIdentity::debug_id(63))
    fault_seek_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(fault_controller, 1)
    return FAULTING_SEEK_RESULT if fault_seek_failure.code != DebuggerErrors::ErrorCode.Diverged or fault_controller.session.position.event != 0
    fault_step_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(66), build, DebuggerCapabilities::managed_capabilities())
    fault_step_session.state <- DebuggerSession::SessionState.Stopped
    fault_step_controller: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(fault_step_session, fault_image, DebuggerIdentity::debug_id(67))
    fault_step_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_step(fault_step_controller)
    return 110 if fault_step_failure.code != DebuggerErrors::ErrorCode.Diverged or fault_step_controller.session.position.event != fault_step_controller.engine.event_count.u64()
    partial_capabilities: mutable DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    partial_capabilities.history <- DebuggerCapabilities::HistoryKind.Replayable
    partial_session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(64), build, partial_capabilities)
    partial_session.state <- DebuggerSession::SessionState.Stopped
    partial_controller: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(partial_session, image, DebuggerIdentity::debug_id(65))
    partial_seek_failure: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_seek(partial_controller, PARTIAL_SEEK_EVENT)
    return 83 if partial_seek_failure.code != DebuggerErrors::ErrorCode.Unsupported or partial_controller.engine.event_count != 0 or partial_controller.session.position.event != 0
    limited: mutable DebuggerManagedEngine::ManagedController = DebuggerManagedEngine::managed_new(session, image, DebuggerIdentity::debug_id(57))
    return 22 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_launch(limited))
    return 23 if not DebuggerErrors::error_is_ok(DebuggerManagedEngine::managed_pause(limited))
    limited_error: DebuggerErrors::DebuggerError = DebuggerManagedEngine::managed_continue(limited, 0)
    return 24 if limited_error.code != DebuggerErrors::ErrorCode.Unavailable or limited.session.state != DebuggerSession::SessionState.Stopped
    return 0
