def check_corrupt_metadata() -> i64:
    types: mutable DebuggerTypeMetadata::MetadataStore = DebuggerTypeMetadata::metadata_new()
    types.type_count <- Test::INVALID_TYPE_COUNT
    return 1 if DebuggerTypeMetadata::metadata_find_type(types, DebuggerIdentity::debug_id(1)).id.value != 0
    types.scope_count <- Test::INVALID_SCOPE_COUNT
    return 2 if DebuggerTypeMetadata::metadata_find_scope(types, DebuggerIdentity::debug_id(1)).id.value != 0
    types.binding_count <- Test::INVALID_BINDING_COUNT
    binding: DebuggerIdentity::BindingIdentity = zeroed
    return 3 if DebuggerTypeMetadata::metadata_find_binding(types, binding).id.declaration.value != 0
    return 0

def check_corrupt_tables() -> i64:
    symbols: mutable DebuggerNativeSymbols::SymbolTable = DebuggerNativeSymbols::symbols_new()
    symbols.count <- Test::INVALID_SYMBOL_COUNT
    return 1 if DebuggerNativeSymbols::symbols_find(symbols, 0).id.value != 0
    resources: mutable DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_new(DebuggerVirtualResources::ResourceMode.Recording)
    resources.count <- Test::INVALID_RESOURCE_COUNT
    return 2 if DebuggerVirtualResources::resources_find(resources, DebuggerIdentity::debug_id(1)) != Test::RESOURCE_INVALID_INDEX
    effects: mutable DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Replaying)
    effects.count <- Test::INVALID_EFFECT_COUNT
    effects.cursor <- 0
    replayed: DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_replay(effects, DebuggerEffects::EffectKind.Clock, 1)
    return 3 if replayed.last_error.code != DebuggerErrors::ErrorCode.Corrupt
    return 4 if DebuggerEffects::effect_oracle_replay_complete(effects)
    return 0

def check_corrupt_runtime() -> i64:
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    runtime.task_count <- Test::INVALID_TASK_COUNT
    return 1 if DebuggerConcurrencyRuntime::runtime_has_deadlock(runtime)
    return 0

def check_managed_adapters() -> i64:
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ADAPTER_SOURCE_ID)
    wrong_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(Test::ADAPTER_WRONG_SOURCE_ID)
    clock_recording: mutable DebuggerReplayAdapters::Clock = DebuggerReplayAdapters::clock_new(DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record(clock_recording, source, Test::ADAPTER_CLOCK_VALUE))
    clock_replay: mutable DebuggerReplayAdapters::Clock = clock_recording
    clock_replay.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    clock_read: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(clock_replay, source)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not clock_read.accepted or clock_read.value != Test::ADAPTER_CLOCK_VALUE or not DebuggerReplayAdapters::clock_is_exact(clock_replay)
    malformed_clock: DebuggerReplayAdapters::Clock = clock_replay
    malformed_clock.samples[0].sequence <- 7
    return 141 if DebuggerReplayAdapters::clock_is_exact(malformed_clock)
    invalid_clock_mode: mutable DebuggerReplayAdapters::Clock = clock_recording
    invalid_clock_mode.mode <- Test::INVALID_ADAPTER_MODE
    invalid_clock_mode_result: DebuggerErrors::DebuggerError = DebuggerReplayAdapters::clock_record(invalid_clock_mode, source, Test::ADAPTER_CLOCK_VALUE)
    return 142 if invalid_clock_mode_result.code != DebuggerErrors::ErrorCode.InvalidArgument or invalid_clock_mode.exact
    clock_mismatch: mutable DebuggerReplayAdapters::Clock = clock_recording
    clock_mismatch.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    clock_mismatch_read: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(clock_mismatch, wrong_source)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if clock_mismatch_read.accepted or clock_mismatch_read.failure.code != DebuggerErrors::ErrorCode.Diverged or DebuggerReplayAdapters::clock_is_exact(clock_mismatch)
    random_recording: mutable DebuggerReplayAdapters::Random = DebuggerReplayAdapters::random_new(DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::random_record(random_recording, source, Test::ADAPTER_RANDOM_VALUE))
    random_replay: mutable DebuggerReplayAdapters::Random = random_recording
    random_replay.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    random_read: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read(random_replay, source)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not random_read.accepted or random_read.value != Test::ADAPTER_RANDOM_VALUE or not DebuggerReplayAdapters::random_is_exact(random_replay)
    malformed_random: DebuggerReplayAdapters::Random = random_replay
    malformed_random.samples[0].source <- DebuggerIdentity::debug_id(0)
    return 142 if DebuggerReplayAdapters::random_is_exact(malformed_random)
    branch_clock: mutable DebuggerReplayAdapters::Clock = clock_recording
    branch_clock.mode <- DebuggerReplayAdapters::AdapterMode.Branch
    branch_clock_read: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(branch_clock, source)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not branch_clock_read.accepted or branch_clock_read.value != Test::ADAPTER_CLOCK_VALUE or not DebuggerReplayAdapters::clock_is_exact(branch_clock)
    branch_random: mutable DebuggerReplayAdapters::Random = random_recording
    branch_random.mode <- DebuggerReplayAdapters::AdapterMode.Branch
    branch_random_read: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read(branch_random, source)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not branch_random_read.accepted or branch_random_read.value != Test::ADAPTER_RANDOM_VALUE or not DebuggerReplayAdapters::random_is_exact(branch_random)
    input_bytes: mutable u8[Test::ADAPTER_INPUT_LENGTH] = [Test::ADAPTER_INPUT_FIRST, Test::ADAPTER_INPUT_SECOND]
    output_bytes: mutable u8[Test::ADAPTER_OUTPUT_LENGTH] = [Test::ADAPTER_OUTPUT_FIRST, Test::ADAPTER_OUTPUT_SECOND, Test::ADAPTER_OUTPUT_THIRD]
    console_recording: mutable DebuggerReplayAdapters::Console = DebuggerReplayAdapters::console_new(DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(console_recording, DebuggerReplayAdapters::ConsoleChannel.Stdout, input_bytes[0], Test::ADAPTER_INPUT_LENGTH))
    recorded_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(console_recording, DebuggerReplayAdapters::ConsoleChannel.Stdout, output_bytes[0], Test::ADAPTER_OUTPUT_LENGTH)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not recorded_write.accepted or recorded_write.transferred != Test::ADAPTER_OUTPUT_LENGTH or recorded_write.suppressed
    console_replay: mutable DebuggerReplayAdapters::Console = console_recording
    console_replay.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    console_replay.output_suppressed <- true
    replay_input: mutable u8[Test::ADAPTER_INPUT_LENGTH] = zeroed
    replay_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(console_replay, DebuggerReplayAdapters::ConsoleChannel.Stdout, replay_input[0], Test::ADAPTER_INPUT_LENGTH)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not replay_read.accepted or replay_read.transferred != Test::ADAPTER_INPUT_LENGTH or replay_input[0] != Test::ADAPTER_INPUT_FIRST or replay_input[1] != Test::ADAPTER_INPUT_SECOND
    replay_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(console_replay, DebuggerReplayAdapters::ConsoleChannel.Stdout, output_bytes[0], Test::ADAPTER_OUTPUT_LENGTH)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not replay_write.accepted or replay_write.transferred != Test::ADAPTER_OUTPUT_LENGTH or not replay_write.suppressed or not DebuggerReplayAdapters::console_replay_complete(console_replay)
    malformed_console: DebuggerReplayAdapters::Console = console_replay
    malformed_console.records[0].length <- 257
    return 143 if DebuggerReplayAdapters::console_is_exact(malformed_console)
    console_mismatch: mutable DebuggerReplayAdapters::Console = console_recording
    console_mismatch.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    console_mismatch.output_suppressed <- true
    mismatch_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(console_mismatch, DebuggerReplayAdapters::ConsoleChannel.Stdout, output_bytes[0], Test::ADAPTER_OUTPUT_LENGTH)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if mismatch_write.accepted or mismatch_write.failure.code != DebuggerErrors::ErrorCode.Diverged or DebuggerReplayAdapters::console_is_exact(console_mismatch)
    branch_console: mutable DebuggerReplayAdapters::Console = console_recording
    branch_console.mode <- DebuggerReplayAdapters::AdapterMode.Branch
    branch_console.output_suppressed <- true
    branch_input: mutable u8[Test::ADAPTER_INPUT_LENGTH] = zeroed
    branch_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(branch_console, DebuggerReplayAdapters::ConsoleChannel.Stdout, branch_input[0], Test::ADAPTER_INPUT_LENGTH)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not branch_read.accepted or branch_input[0] != Test::ADAPTER_INPUT_FIRST or branch_input[1] != Test::ADAPTER_INPUT_SECOND or not DebuggerReplayAdapters::console_is_exact(branch_console)

    short_recording: mutable DebuggerReplayAdapters::Console = DebuggerReplayAdapters::console_new(DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input_outcome(short_recording, DebuggerReplayAdapters::ConsoleChannel.Stdout, input_bytes[0], Test::ADAPTER_OUTPUT_LENGTH, Test::ADAPTER_SHORT_READ_TRANSFERRED, false))
    short_replay: mutable DebuggerReplayAdapters::Console = short_recording
    short_replay.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    short_replay.output_suppressed <- true
    short_output: mutable u8[Test::ADAPTER_OUTPUT_LENGTH] = zeroed
    short_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(short_replay, DebuggerReplayAdapters::ConsoleChannel.Stdout, short_output[0], Test::ADAPTER_OUTPUT_LENGTH)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not short_read.accepted or short_read.transferred != Test::ADAPTER_SHORT_READ_TRANSFERRED or short_read.eof or short_output[0] != Test::ADAPTER_INPUT_FIRST or short_output[1] != Test::ADAPTER_INPUT_SECOND

    eof_recording: mutable DebuggerReplayAdapters::Console = DebuggerReplayAdapters::console_new(DebuggerReplayAdapters::AdapterMode.Recording)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input_outcome(eof_recording, DebuggerReplayAdapters::ConsoleChannel.Stdout, output_bytes[0], Test::ADAPTER_OUTPUT_LENGTH, 0, Test::ADAPTER_READ_EOF))
    eof_replay: mutable DebuggerReplayAdapters::Console = eof_recording
    eof_replay.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    eof_replay.output_suppressed <- true
    eof_output: mutable u8[Test::ADAPTER_OUTPUT_LENGTH] = zeroed
    eof_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(eof_replay, DebuggerReplayAdapters::ConsoleChannel.Stdout, eof_output[0], Test::ADAPTER_OUTPUT_LENGTH)
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if not eof_read.accepted or eof_read.transferred != 0 or not eof_read.eof or not DebuggerReplayAdapters::console_replay_complete(eof_replay)
    return 0

def check_full_checkpoint() -> i64:
    machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)
    effects: DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Recording)
    resources: DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_new(DebuggerVirtualResources::ResourceMode.Recording)
    adapters: DebuggerReplayAdapters::AdapterSnapshot = DebuggerReplayAdapters::adapter_snapshot_empty_replay()
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::FULL_CHECKPOINT_BUILD_COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(Test::FULL_CHECKPOINT_BUILD_RUNTIME_ID),
        source: DebuggerIdentity::debug_id(Test::FULL_CHECKPOINT_BUILD_SOURCE_ID),
        target: DebuggerIdentity::debug_id(Test::FULL_CHECKPOINT_BUILD_TARGET_ID),
        metadata_version: Test::FULL_CHECKPOINT_METADATA_VERSION
    }
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerFullCheckpoint::full_checkpoint_capture_with_adapters(machine, tasks, effects, resources, adapters, DebuggerIdentity::debug_id(Test::FULL_CHECKPOINT_RECORDING_ID), DebuggerIdentity::debug_id(Test::FULL_CHECKPOINT_BRANCH_ID), Test::FULL_CHECKPOINT_EVENT, Test::FULL_CHECKPOINT_HASH, build, Test::FULL_CHECKPOINT_IMAGE_FINGERPRINT, true)
    checkpoint.state_hash <- DebuggerCheckpoint::snapshot_state_hash(checkpoint.machine)
    checkpoint.machine.state_hash <- checkpoint.state_hash
    return Test::FULL_CHECKPOINT_RESULT_FAILURE if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
    restored: DebuggerEDIR::Machine = DebuggerFullCheckpoint::full_checkpoint_restore_machine(checkpoint)
    return Test::FULL_CHECKPOINT_RESULT_FAILURE if not DebuggerCheckpoint::snapshot_matches_machine(checkpoint.machine, restored)
    restored_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    return Test::FULL_CHECKPOINT_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerFullCheckpoint::full_checkpoint_restore_tasks(restored_runtime, checkpoint))
    corrupt: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    corrupt.schema <- Test::INVALID_FULL_CHECKPOINT_SCHEMA
    return Test::FULL_CHECKPOINT_RESULT_FAILURE if DebuggerFullCheckpoint::full_checkpoint_is_valid(corrupt)
    invalid_restored: DebuggerEDIR::Machine = DebuggerFullCheckpoint::full_checkpoint_restore_machine(corrupt)
    return Test::INVALID_FULL_RESTORE_RESULT if not invalid_restored.halted or not invalid_restored.faulted
    corrupt <- checkpoint
    corrupt.machine.state_hash <- checkpoint.state_hash + Test::FULL_CHECKPOINT_TAMPER_HASH_DELTA
    return Test::FULL_CHECKPOINT_RESULT_FAILURE if DebuggerFullCheckpoint::full_checkpoint_is_valid(corrupt)
    corrupt <- checkpoint
    corrupt.machine.id <- DebuggerIdentity::debug_id(Test::INVALID_FULL_CHECKPOINT_ID)
    return Test::FULL_CHECKPOINT_RESULT_FAILURE if DebuggerFullCheckpoint::full_checkpoint_is_valid(corrupt)
    corrupt <- checkpoint
    corrupt.branch <- DebuggerIdentity::debug_id(Test::INVALID_FULL_CHECKPOINT_BRANCH)
    return Test::FULL_CHECKPOINT_RESULT_FAILURE if DebuggerFullCheckpoint::full_checkpoint_is_valid(corrupt)
    return 0

def main() -> i64:
    return 74 if check_corrupt_metadata() != 0
    return 75 if check_corrupt_tables() != 0
    return 76 if check_corrupt_runtime() != 0
    return Test::ADAPTER_REPLAY_RESULT_FAILURE if check_managed_adapters() != 0
    return Test::FULL_CHECKPOINT_RESULT_FAILURE if check_full_checkpoint() != 0
    expression: DebuggerEvaluate::Expression = DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Add, left: 4, right: 5, binding: zeroed}
    evaluated: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(expression, 8)
    return 1 if evaluated.value != 9 or not DebuggerErrors::error_is_ok(evaluated.failure)
    multiplied: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Multiply, left: 6, right: 7, binding: zeroed}, 8)
    return 16 if multiplied.value != 42
    overflow_add: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Add, left: Test::EVALUATION_I64_MAX, right: 1, binding: zeroed}, 8)
    return 99 if overflow_add.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    overflow_multiply: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Multiply, left: Test::EVALUATION_I64_MIN, right: -1, binding: zeroed}, 8)
    return 100 if overflow_multiply.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    divided: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Divide, left: 42, right: 7, binding: zeroed}, 8)
    return 17 if divided.value != 6
    divide_by_zero: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Divide, left: 1, right: 0, binding: zeroed}, 8)
    return 18 if divide_by_zero.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    binding_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(Test::VALUE_STORE_GENERATION)
    binding_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(binding_store, DebuggerIdentity::debug_id(Test::VALUE_NAME_ID), DebuggerIdentity::debug_id(Test::VALUE_TYPE_ID), 12)
    binding_expression: DebuggerEvaluate::Evaluation = DebuggerBindingEvaluate::evaluate_binding(binding_store, binding_handle, 4)
    return 27 if binding_expression.value != 12 or not DebuggerErrors::error_is_ok(binding_expression.failure)
    binding_ast: DebuggerEvaluate::Expression = DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Binding, left: 0, right: 0, binding: binding_handle}
    binding_ast_result: DebuggerEvaluate::Evaluation = DebuggerBindingEvaluate::evaluate_expression_with_store(binding_ast, binding_store, 4)
    return Test::BINDING_EXPRESSION_RESULT_FAILURE if binding_ast_result.value != 12 or binding_ast_result.consumed != 1 or not DebuggerErrors::error_is_ok(binding_ast_result.failure)
    stale_binding: DebuggerValues::ValueHandle = binding_handle
    stale_binding.stop_generation <- Test::VALUE_STORE_GENERATION + 1
