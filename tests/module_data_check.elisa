    return 28 if not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_seek(branch_resources, resource_handle, 0))
    branch_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(branch_resources, resource_handle, write_byte[0], 1)
    return 29 if branch_write.transferred != 1
    return 30 if not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_seek(resources, resource_handle, 0))
    parent_bytes: mutable u8[1] = zeroed
    parent_read: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(resources, resource_handle, parent_bytes[0], 1)
    return 31 if parent_read.transferred != 1 or parent_bytes[0] != 7
    corrupted_resources: mutable DebuggerVirtualResources::ResourceStore = resources
    corrupted_resources.files[0].cursor <- corrupted_resources.files[0].length + 1
    corrupted_read: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(corrupted_resources, resource_handle, parent_bytes[0], 1)
    return 58 if corrupted_read.failure.code != DebuggerErrors::ErrorCode.Corrupt
    corrupted_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(corrupted_resources, resource_handle, write_byte[0], 1)
    return 59 if corrupted_write.failure.code != DebuggerErrors::ErrorCode.Corrupt
    corrupted_length_resources: mutable DebuggerVirtualResources::ResourceStore = resources
    corrupted_length_resources.files[0].length <- INVALID_RESOURCE_LENGTH
    corrupted_length_read: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(corrupted_length_resources, resource_handle, parent_bytes[0], 1)
    return 94 if corrupted_length_read.failure.code != DebuggerErrors::ErrorCode.Corrupt
    return 95 if DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_seek(corrupted_length_resources, resource_handle, 0))
    task_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)
    changed_decision: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = task_snapshot
    changed_decision.scheduler_decisions[0].kind <- DebuggerScheduler::ScheduleKind.Yield
    return 51 if DebuggerConcurrencyCheckpoint::task_snapshot_matches(runtime, changed_decision)
    changed_wait: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = task_snapshot
    changed_wait.waits[0].kind <- DebuggerConcurrency::SynchronizationKind.Condition
    return 52 if DebuggerConcurrencyCheckpoint::task_snapshot_matches(runtime, changed_wait)
    changed_parent: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = task_snapshot
    changed_parent.tasks[1].parent <- DebuggerIdentity::debug_id(TASK_PARENT_ID)
    return 58 if DebuggerConcurrencyCheckpoint::task_snapshot_matches(runtime, changed_parent)
    changed_thread: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = task_snapshot
    changed_thread.tasks[0].os_thread <- 99
    return 59 if DebuggerConcurrencyCheckpoint::task_snapshot_matches(runtime, changed_thread)
    invalid_scheduler_task: DebuggerConcurrencyCheckpoint::TaskSnapshot = task_snapshot
    invalid_scheduler_task.scheduler_decisions[0].task.logical_time <- invalid_scheduler_task.scheduler_decisions[0].task.logical_time + INVALID_SCHEDULER_LOGICAL_TIME_DELTA
    return INVALID_SCHEDULER_TASK_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_scheduler_task)
    DebuggerConcurrencyRuntime::runtime_transition(runtime, task_one, DebuggerConcurrency::TaskState.Completed)
    DebuggerConcurrencyCheckpoint::task_snapshot_restore(runtime, task_snapshot)
    return 24 if not DebuggerConcurrencyCheckpoint::task_snapshot_matches(runtime, task_snapshot) or runtime.tasks[0].state != DebuggerConcurrency::TaskState.Blocked
    invalid_task_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = task_snapshot
    invalid_task_snapshot.task_count <- 65
    return 71 if DebuggerConcurrencyCheckpoint::task_snapshot_matches(runtime, invalid_task_snapshot)
    invalid_scheduler_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = task_snapshot
    invalid_scheduler_snapshot.scheduler_cursor <- 1
    return INVALID_SCHEDULER_CURSOR_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_scheduler_snapshot)
    next_header: mutable DebuggerTrace::ChunkHeader = header
    next_header.sequence <- 1
    torn_stream: DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(stream, next_header)
    return 90 if DebuggerTraceStream::trace_stream_verify(torn_stream) != DebuggerTraceStream::TraceReadStatus.Truncated
    bad_header: mutable DebuggerTrace::ChunkHeader = header
    bad_header.sequence <- 1
    bad_header.last_event <- header.last_event + 1
    bad_header.checksum <- header.checksum + 1
    bad_stream: mutable DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(stream, bad_header)
    bad_stream <- DebuggerTraceStream::trace_stream_append(bad_stream, 42)
    return 91 if DebuggerTraceStream::trace_stream_verify(bad_stream) != DebuggerTraceStream::TraceReadStatus.Corrupt or bad_stream.verified_event != stream.verified_event
    tampered_stream: mutable DebuggerTraceStream::TraceStream = stream
    tampered_stream.chunks[0].payload[0] <- 43
    return 92 if DebuggerTraceStream::trace_stream_verify(tampered_stream) != DebuggerTraceStream::TraceReadStatus.Corrupt
    oversized_stream: mutable DebuggerTraceStream::TraceStream = stream
    oversized_stream.chunks[0].header.payload_length <- INVALID_STREAM_PAYLOAD
    return 93 if DebuggerTraceStream::trace_stream_verify(oversized_stream) != DebuggerTraceStream::TraceReadStatus.ResourceLimit
    return 0
