    allocation: DebuggerIdentity::AllocationIdentity = DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(Test::WATCH_ALLOCATION_ID), generation: Test::WATCH_ALLOCATION_GENERATION, offset: 0}
