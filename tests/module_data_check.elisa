def check_corrupt_metadata() -> i64:
    types: mutable DebuggerTypeMetadata::MetadataStore = DebuggerTypeMetadata::metadata_new()
    types.type_count <- INVALID_TYPE_COUNT
    return 1 if DebuggerTypeMetadata::metadata_find_type(types, DebuggerIdentity::debug_id(1)).id.value != 0
    types.scope_count <- INVALID_SCOPE_COUNT
    return 2 if DebuggerTypeMetadata::metadata_find_scope(types, DebuggerIdentity::debug_id(1)).id.value != 0
    types.binding_count <- INVALID_BINDING_COUNT
    binding: DebuggerIdentity::BindingIdentity = zeroed
    return 3 if DebuggerTypeMetadata::metadata_find_binding(types, binding).id.declaration.value != 0
    return 0

def check_corrupt_tables() -> i64:
    symbols: mutable DebuggerNativeSymbols::SymbolTable = DebuggerNativeSymbols::symbols_new()
    symbols.count <- INVALID_SYMBOL_COUNT
    return 1 if DebuggerNativeSymbols::symbols_find(symbols, 0).id.value != 0
    resources: mutable DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_new(DebuggerVirtualResources::ResourceMode.Recording)
    resources.count <- INVALID_RESOURCE_COUNT
    return 2 if DebuggerVirtualResources::resources_find(resources, DebuggerIdentity::debug_id(1)) != RESOURCE_INVALID_INDEX
    effects: mutable DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Replaying)
    effects.count <- INVALID_EFFECT_COUNT
    effects.cursor <- 0
    replayed: DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_replay(effects, DebuggerEffects::EffectKind.Clock, 1)
    return 3 if replayed.last_error.code != DebuggerErrors::ErrorCode.Corrupt
    return 4 if DebuggerEffects::effect_oracle_replay_complete(effects)
    return 0

def check_corrupt_runtime() -> i64:
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    runtime.task_count <- INVALID_TASK_COUNT
    return 1 if DebuggerConcurrencyRuntime::runtime_has_deadlock(runtime)
    return 0

def check_managed_adapters() -> i64:
    source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(ADAPTER_SOURCE_ID)
    wrong_source: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(ADAPTER_WRONG_SOURCE_ID)
    clock_recording: mutable DebuggerReplayAdapters::Clock = DebuggerReplayAdapters::clock_new(DebuggerReplayAdapters::AdapterMode.Recording)
    return ADAPTER_REPLAY_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::clock_record(clock_recording, source, ADAPTER_CLOCK_VALUE))
    clock_replay: mutable DebuggerReplayAdapters::Clock = clock_recording
    clock_replay.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    clock_read: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(clock_replay, source)
    return ADAPTER_REPLAY_RESULT_FAILURE if not clock_read.accepted or clock_read.value != ADAPTER_CLOCK_VALUE or not DebuggerReplayAdapters::clock_is_exact(clock_replay)
    malformed_clock: DebuggerReplayAdapters::Clock = clock_replay
    malformed_clock.samples[0].sequence <- 7
    return 141 if DebuggerReplayAdapters::clock_is_exact(malformed_clock)
    invalid_clock_mode: mutable DebuggerReplayAdapters::Clock = clock_recording
    invalid_clock_mode.mode <- INVALID_ADAPTER_MODE
    invalid_clock_mode_result: DebuggerErrors::DebuggerError = DebuggerReplayAdapters::clock_record(invalid_clock_mode, source, ADAPTER_CLOCK_VALUE)
    return 142 if invalid_clock_mode_result.code != DebuggerErrors::ErrorCode.InvalidArgument or invalid_clock_mode.exact
    clock_mismatch: mutable DebuggerReplayAdapters::Clock = clock_recording
    clock_mismatch.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    clock_mismatch_read: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(clock_mismatch, wrong_source)
    return ADAPTER_REPLAY_RESULT_FAILURE if clock_mismatch_read.accepted or clock_mismatch_read.failure.code != DebuggerErrors::ErrorCode.Diverged or DebuggerReplayAdapters::clock_is_exact(clock_mismatch)
    random_recording: mutable DebuggerReplayAdapters::Random = DebuggerReplayAdapters::random_new(DebuggerReplayAdapters::AdapterMode.Recording)
    return ADAPTER_REPLAY_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::random_record(random_recording, source, ADAPTER_RANDOM_VALUE))
    random_replay: mutable DebuggerReplayAdapters::Random = random_recording
    random_replay.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    random_read: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read(random_replay, source)
    return ADAPTER_REPLAY_RESULT_FAILURE if not random_read.accepted or random_read.value != ADAPTER_RANDOM_VALUE or not DebuggerReplayAdapters::random_is_exact(random_replay)
    malformed_random: DebuggerReplayAdapters::Random = random_replay
    malformed_random.samples[0].source <- DebuggerIdentity::debug_id(0)
    return 142 if DebuggerReplayAdapters::random_is_exact(malformed_random)
    branch_clock: mutable DebuggerReplayAdapters::Clock = clock_recording
    branch_clock.mode <- DebuggerReplayAdapters::AdapterMode.Branch
    branch_clock_read: DebuggerReplayAdapters::ClockRead = DebuggerReplayAdapters::clock_read(branch_clock, source)
    return ADAPTER_REPLAY_RESULT_FAILURE if not branch_clock_read.accepted or branch_clock_read.value != ADAPTER_CLOCK_VALUE or not DebuggerReplayAdapters::clock_is_exact(branch_clock)
    branch_random: mutable DebuggerReplayAdapters::Random = random_recording
    branch_random.mode <- DebuggerReplayAdapters::AdapterMode.Branch
    branch_random_read: DebuggerReplayAdapters::RandomRead = DebuggerReplayAdapters::random_read(branch_random, source)
    return ADAPTER_REPLAY_RESULT_FAILURE if not branch_random_read.accepted or branch_random_read.value != ADAPTER_RANDOM_VALUE or not DebuggerReplayAdapters::random_is_exact(branch_random)
    input_bytes: mutable u8[ADAPTER_INPUT_LENGTH] = [ADAPTER_INPUT_FIRST, ADAPTER_INPUT_SECOND]
    output_bytes: mutable u8[ADAPTER_OUTPUT_LENGTH] = [ADAPTER_OUTPUT_FIRST, ADAPTER_OUTPUT_SECOND, ADAPTER_OUTPUT_THIRD]
    console_recording: mutable DebuggerReplayAdapters::Console = DebuggerReplayAdapters::console_new(DebuggerReplayAdapters::AdapterMode.Recording)
    return ADAPTER_REPLAY_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerReplayAdapters::console_record_input(console_recording, DebuggerReplayAdapters::ConsoleChannel.Stdout, input_bytes[0], ADAPTER_INPUT_LENGTH))
    recorded_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(console_recording, DebuggerReplayAdapters::ConsoleChannel.Stdout, output_bytes[0], ADAPTER_OUTPUT_LENGTH)
    return ADAPTER_REPLAY_RESULT_FAILURE if not recorded_write.accepted or recorded_write.transferred != ADAPTER_OUTPUT_LENGTH or recorded_write.suppressed
    console_replay: mutable DebuggerReplayAdapters::Console = console_recording
    console_replay.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    replay_input: mutable u8[ADAPTER_INPUT_LENGTH] = zeroed
    replay_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(console_replay, DebuggerReplayAdapters::ConsoleChannel.Stdout, replay_input[0], ADAPTER_INPUT_LENGTH)
    return ADAPTER_REPLAY_RESULT_FAILURE if not replay_read.accepted or replay_read.transferred != ADAPTER_INPUT_LENGTH or replay_input[0] != ADAPTER_INPUT_FIRST or replay_input[1] != ADAPTER_INPUT_SECOND
    replay_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(console_replay, DebuggerReplayAdapters::ConsoleChannel.Stdout, output_bytes[0], ADAPTER_OUTPUT_LENGTH)
    return ADAPTER_REPLAY_RESULT_FAILURE if not replay_write.accepted or replay_write.transferred != ADAPTER_OUTPUT_LENGTH or not replay_write.suppressed or not DebuggerReplayAdapters::console_replay_complete(console_replay)
    malformed_console: DebuggerReplayAdapters::Console = console_replay
    malformed_console.records[0].length <- 257
    return 143 if DebuggerReplayAdapters::console_is_exact(malformed_console)
    console_mismatch: mutable DebuggerReplayAdapters::Console = console_recording
    console_mismatch.mode <- DebuggerReplayAdapters::AdapterMode.Replaying
    mismatch_write: DebuggerReplayAdapters::ConsoleWrite = DebuggerReplayAdapters::console_write(console_mismatch, DebuggerReplayAdapters::ConsoleChannel.Stdout, output_bytes[0], ADAPTER_OUTPUT_LENGTH)
    return ADAPTER_REPLAY_RESULT_FAILURE if mismatch_write.accepted or mismatch_write.failure.code != DebuggerErrors::ErrorCode.Diverged or DebuggerReplayAdapters::console_is_exact(console_mismatch)
    branch_console: mutable DebuggerReplayAdapters::Console = console_recording
    branch_console.mode <- DebuggerReplayAdapters::AdapterMode.Branch
    branch_input: mutable u8[ADAPTER_INPUT_LENGTH] = zeroed
    branch_read: DebuggerReplayAdapters::ConsoleRead = DebuggerReplayAdapters::console_read_input(branch_console, DebuggerReplayAdapters::ConsoleChannel.Stdout, branch_input[0], ADAPTER_INPUT_LENGTH)
    return ADAPTER_REPLAY_RESULT_FAILURE if not branch_read.accepted or branch_input[0] != ADAPTER_INPUT_FIRST or branch_input[1] != ADAPTER_INPUT_SECOND or not DebuggerReplayAdapters::console_is_exact(branch_console)
    return 0

def check_full_checkpoint() -> i64:
    machine: mutable DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)
    effects: DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Recording)
    resources: DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_new(DebuggerVirtualResources::ResourceMode.Recording)
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = DebuggerFullCheckpoint::full_checkpoint_capture(machine, tasks, effects, resources, DebuggerIdentity::debug_id(FULL_CHECKPOINT_RECORDING_ID), DebuggerIdentity::debug_id(FULL_CHECKPOINT_BRANCH_ID), FULL_CHECKPOINT_EVENT, FULL_CHECKPOINT_HASH)
    checkpoint.state_hash <- DebuggerCheckpoint::snapshot_state_hash(checkpoint.machine)
    checkpoint.machine.state_hash <- checkpoint.state_hash
    return FULL_CHECKPOINT_RESULT_FAILURE if not DebuggerFullCheckpoint::full_checkpoint_is_valid(checkpoint)
    restored: DebuggerEDIR::Machine = DebuggerFullCheckpoint::full_checkpoint_restore_machine(checkpoint)
    return FULL_CHECKPOINT_RESULT_FAILURE if not DebuggerCheckpoint::snapshot_matches_machine(checkpoint.machine, restored)
    restored_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    return FULL_CHECKPOINT_RESULT_FAILURE if not DebuggerErrors::error_is_ok(DebuggerFullCheckpoint::full_checkpoint_restore_tasks(restored_runtime, checkpoint))
    corrupt: mutable DebuggerFullCheckpoint::ManagedCheckpoint = checkpoint
    corrupt.schema <- INVALID_FULL_CHECKPOINT_SCHEMA
    return FULL_CHECKPOINT_RESULT_FAILURE if DebuggerFullCheckpoint::full_checkpoint_is_valid(corrupt)
    corrupt <- checkpoint
    corrupt.machine.state_hash <- checkpoint.state_hash + FULL_CHECKPOINT_TAMPER_HASH_DELTA
    return FULL_CHECKPOINT_RESULT_FAILURE if DebuggerFullCheckpoint::full_checkpoint_is_valid(corrupt)
    corrupt <- checkpoint
    corrupt.machine.id <- DebuggerIdentity::debug_id(INVALID_FULL_CHECKPOINT_ID)
    return FULL_CHECKPOINT_RESULT_FAILURE if DebuggerFullCheckpoint::full_checkpoint_is_valid(corrupt)
    return 0

def main() -> i64:
    return 74 if check_corrupt_metadata() != 0
    return 75 if check_corrupt_tables() != 0
    return 76 if check_corrupt_runtime() != 0
    return ADAPTER_REPLAY_RESULT_FAILURE if check_managed_adapters() != 0
    return FULL_CHECKPOINT_RESULT_FAILURE if check_full_checkpoint() != 0
    expression: DebuggerEvaluate::Expression = DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Add, left: 4, right: 5, binding: zeroed}
    evaluated: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(expression, 8)
    return 1 if evaluated.value != 9 or not DebuggerErrors::error_is_ok(evaluated.failure)
    multiplied: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Multiply, left: 6, right: 7, binding: zeroed}, 8)
    return 16 if multiplied.value != 42
    overflow_add: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Add, left: EVALUATION_I64_MAX, right: 1, binding: zeroed}, 8)
    return 99 if overflow_add.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    overflow_multiply: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Multiply, left: EVALUATION_I64_MIN, right: -1, binding: zeroed}, 8)
    return 100 if overflow_multiply.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    divided: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Divide, left: 42, right: 7, binding: zeroed}, 8)
    return 17 if divided.value != 6
    divide_by_zero: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Divide, left: 1, right: 0, binding: zeroed}, 8)
    return 18 if divide_by_zero.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    binding_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(VALUE_STORE_GENERATION)
    binding_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(binding_store, DebuggerIdentity::debug_id(VALUE_NAME_ID), DebuggerIdentity::debug_id(VALUE_TYPE_ID), 12)
    binding_expression: DebuggerEvaluate::Evaluation = DebuggerBindingEvaluate::evaluate_binding(binding_store, binding_handle, 4)
    return 27 if binding_expression.value != 12 or not DebuggerErrors::error_is_ok(binding_expression.failure)
    oracle: mutable DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Recording)
    oracle <- DebuggerEffects::effect_oracle_record(oracle, DebuggerEffects::EffectKind.NetworkWrite, 11, 22, 3)
    return 2 if oracle.count != 1 or not oracle.records[0].suppress_external_write
    oracle.mode <- DebuggerEffects::EffectMode.Replaying
    oracle <- DebuggerEffects::effect_oracle_replay(oracle, DebuggerEffects::EffectKind.NetworkWrite, 11)
    return 3 if not DebuggerEffects::effect_oracle_is_exact(oracle) or oracle.cursor != 1 or DebuggerEffects::effect_oracle_last_value(oracle) != 3
    replay_record: DebuggerEffects::EffectRecord = DebuggerEffects::effect_oracle_last_record(oracle)
    return 56 if not DebuggerEffects::effect_record_suppresses_write(replay_record) or not DebuggerEffects::effect_oracle_replay_complete(oracle)
    result_source: mutable DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Recording)
    result_source <- DebuggerEffects::effect_oracle_record(result_source, DebuggerEffects::EffectKind.Clock, 31, 32, 33)
    result_source.mode <- DebuggerEffects::EffectMode.Replaying
    replay_result: DebuggerEffects::EffectReplay = DebuggerEffects::effect_oracle_replay_result(result_source, DebuggerEffects::EffectKind.Clock, 31)
    return EFFECT_REPLAY_RESULT_FAILURE if not replay_result.accepted or replay_result.result_hash != 32 or replay_result.result_value != 33 or replay_result.oracle.cursor != 1 or not DebuggerErrors::error_is_ok(replay_result.failure)
    mismatch_result: DebuggerEffects::EffectReplay = DebuggerEffects::effect_oracle_replay_result(result_source, DebuggerEffects::EffectKind.Random, 31)
    return EFFECT_REPLAY_RESULT_FAILURE if mismatch_result.accepted or mismatch_result.oracle.exactness != DebuggerEffects::Exactness.Diverged or mismatch_result.failure.code != DebuggerErrors::ErrorCode.Diverged
    invalid_effect: mutable DebuggerEffects::EffectOracle = oracle
    invalid_effect.records[0].suppress_external_write <- false
    return 96 if DebuggerEffects::effect_oracle_is_exact(invalid_effect)
    replay_write: DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_record(oracle, DebuggerEffects::EffectKind.FileWrite, 12, 23, 4)
    return 80 if replay_write.exactness != DebuggerEffects::Exactness.Diverged or replay_write.last_error.code != DebuggerErrors::ErrorCode.Diverged
    live_oracle: mutable DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Live)
    live_oracle <- DebuggerEffects::effect_oracle_record(live_oracle, DebuggerEffects::EffectKind.Clock, 1, 2, 3)
    return 65 if DebuggerEffects::effect_oracle_is_exact(live_oracle)
    tampered_live_oracle: mutable DebuggerEffects::EffectOracle = live_oracle
    tampered_live_oracle.exactness <- DebuggerEffects::Exactness.Exact
    return TAMPERED_LIVE_EXACT_RESULT if DebuggerEffects::effect_oracle_is_exact(tampered_live_oracle)
    barrier_oracle: mutable DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Barrier)
    barrier_oracle <- DebuggerEffects::effect_oracle_record(barrier_oracle, DebuggerEffects::EffectKind.Foreign, 1, 2, 3)
    return 66 if DebuggerEffects::effect_oracle_is_exact(barrier_oracle)
    tampered_oracle: mutable DebuggerEffects::EffectOracle = oracle
    tampered_oracle.cursor <- 0
    tampered_oracle.records[0].sequence <- 9
    tampered_oracle <- DebuggerEffects::effect_oracle_replay(tampered_oracle, DebuggerEffects::EffectKind.NetworkWrite, 11)
    return 57 if tampered_oracle.exactness != DebuggerEffects::Exactness.Diverged
    incomplete_effect_replay: mutable DebuggerEffects::EffectOracle = oracle
    incomplete_effect_replay.mode <- DebuggerEffects::EffectMode.Replaying
    incomplete_effect_replay.exactness <- DebuggerEffects::Exactness.Incomplete
    incomplete_effect_replay.overflowed <- true
    incomplete_effect_replay.cursor <- incomplete_effect_replay.count
    return INCOMPLETE_EFFECT_REPLAY_RESULT if DebuggerEffects::effect_oracle_replay_complete(incomplete_effect_replay)
    header: DebuggerTrace::ChunkHeader = DebuggerTrace::ChunkHeader{schema: 1, kind: DebuggerTrace::ChunkKind.Events, sequence: 0, first_event: 0, last_event: 0, payload_length: 1, checksum: 4953205138095159339}
    stream: mutable DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(DebuggerTraceStream::trace_stream_new(), header)
    stream <- DebuggerTraceStream::trace_stream_append(stream, 42)
    return 4 if DebuggerTraceStream::trace_stream_verify(stream) != DebuggerTraceStream::TraceReadStatus.Complete
    empty_header: DebuggerTrace::ChunkHeader = DebuggerTrace::ChunkHeader{schema: 1, kind: DebuggerTrace::ChunkKind.Metadata, sequence: 0, first_event: 0, last_event: 0, payload_length: 0, checksum: 1469598103934665603}
    empty_stream: DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(DebuggerTraceStream::trace_stream_new(), empty_header)
    return 55 if DebuggerTraceStream::trace_stream_verify(empty_stream) != DebuggerTraceStream::TraceReadStatus.Complete
    empty_event_header: DebuggerTrace::ChunkHeader = DebuggerTrace::ChunkHeader{schema: 1, kind: DebuggerTrace::ChunkKind.Events, sequence: 0, first_event: 0, last_event: 0, payload_length: 0, checksum: 1469598103934665603}
    empty_event_stream: DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(DebuggerTraceStream::trace_stream_new(), empty_event_header)
    return EMPTY_EVENT_STREAM_RESULT if DebuggerTraceStream::trace_stream_verify(empty_event_stream) != DebuggerTraceStream::TraceReadStatus.Corrupt
    metadata_header: DebuggerTrace::ChunkHeader = DebuggerTrace::ChunkHeader{schema: METADATA_STREAM_SCHEMA, kind: DebuggerTrace::ChunkKind.Metadata, sequence: METADATA_STREAM_SEQUENCE, first_event: METADATA_STREAM_FIRST_EVENT, last_event: METADATA_STREAM_LAST_EVENT, payload_length: METADATA_STREAM_PAYLOAD_LENGTH, checksum: METADATA_STREAM_CHECKSUM}
    metadata_stream: mutable DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(DebuggerTraceStream::trace_stream_new(), metadata_header)
    metadata_stream <- DebuggerTraceStream::trace_stream_append(metadata_stream, METADATA_STREAM_PAYLOAD_BYTE)
    return METADATA_STREAM_RESULT if DebuggerTraceStream::trace_stream_verify(metadata_stream) != DebuggerTraceStream::TraceReadStatus.Complete or metadata_stream.verified_event != METADATA_STREAM_SEQUENCE
    index: mutable DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_new()
    index <- DebuggerQueryIndex::event_index_append(index, DebuggerQueryIndex::EventIndexEntry{event: 4, task: DebuggerIdentity::debug_id(1), statement: DebuggerIdentity::debug_id(2), state_hash: 99})
    duplicate_event_index: DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_append(index, DebuggerQueryIndex::EventIndexEntry{event: 4, task: DebuggerIdentity::debug_id(1), statement: DebuggerIdentity::debug_id(2), state_hash: 100})
    return 153 if not duplicate_event_index.overflowed or duplicate_event_index.count != index.count
