# Compile-time coverage for trace, replay, and inspection modules.

include "../src/trace/stream.elisa"
include "../src/replay/effects.elisa"
include "../src/inspect/locations.elisa"
include "../src/inspect/binding_evaluate.elisa"
include "../src/query/evaluator.elisa"
include "../src/concurrency/analysis.elisa"
include "../src/replay/branches.elisa"
include "../src/metadata/types.elisa"
include "../src/breakpoint/watchpoint.elisa"
include "../src/concurrency/runtime.elisa"
include "../src/replay/resources.elisa"
include "../src/concurrency/checkpoint.elisa"

const VALUE_STORE_GENERATION: u64 = 7
const VALUE_NAME_ID: u64 = 100
const VALUE_TYPE_ID: u64 = 101
const VALUE_ROOT_VALUE: i64 = 42
const VALUE_CHILD_VALUE: i64 = 9
const WATCH_ALLOCATION_ID: u64 = 200
const WATCH_ALLOCATION_GENERATION: u64 = 1
const WATCH_VALUE_FIRST: u64 = 10
const WATCH_VALUE_SECOND: u64 = 11
const TASK_PARENT_ID: u64 = 0
const TASK_RESOURCE_ONE: u64 = 300
const TASK_RESOURCE_TWO: u64 = 301
const RESOURCE_PATH_ID: u64 = 400
const RESOURCE_GENERATION: u64 = 1

def main() -> i64:
    expression: DebuggerEvaluate::Expression = DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Add, left: 4, right: 5, binding: zeroed}
    evaluated: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(expression, 8)
    return 1 if evaluated.value != 9 or not DebuggerErrors::error_is_ok(evaluated.failure)
    multiplied: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Multiply, left: 6, right: 7, binding: zeroed}, 8)
    return 16 if multiplied.value != 42
    divided: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Divide, left: 42, right: 7, binding: zeroed}, 8)
    return 17 if divided.value != 6
    divide_by_zero: DebuggerEvaluate::Evaluation = DebuggerEvaluate::evaluate_expression(DebuggerEvaluate::Expression{kind: DebuggerEvaluate::EvaluationKind.Divide, left: 1, right: 0, binding: zeroed}, 8)
    return 18 if divide_by_zero.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    binding_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(VALUE_STORE_GENERATION)
    binding_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(binding_store, DebuggerIdentity::debug_id(VALUE_NAME_ID), DebuggerIdentity::debug_id(VALUE_TYPE_ID), 12)
    binding_expression: DebuggerEvaluate::Evaluation = DebuggerBindingEvaluate::evaluate_binding(binding_store, binding_handle, 4)
    return 27 if binding_expression.value != 12 or not DebuggerErrors::error_is_ok(binding_expression.failure)
    oracle: mutable DebuggerEffects::EffectOracle = DebuggerEffects::effect_oracle_new(DebuggerEffects::EffectMode.Recording)
    oracle <- DebuggerEffects::effect_oracle_record(oracle, DebuggerEffects::EffectKind.NetworkWrite, 11, 22, 3)
    return 2 if oracle.count != 1 or not oracle.records[0].suppress_external_write
    oracle.mode <- DebuggerEffects::EffectMode.Replaying
    oracle <- DebuggerEffects::effect_oracle_replay(oracle, DebuggerEffects::EffectKind.NetworkWrite, 11)
    return 3 if not DebuggerEffects::effect_oracle_is_exact(oracle) or oracle.cursor != 1 or DebuggerEffects::effect_oracle_last_value(oracle) != 3
    header: DebuggerTrace::ChunkHeader = DebuggerTrace::ChunkHeader{schema: 1, kind: DebuggerTrace::ChunkKind.Events, sequence: 0, first_event: 0, last_event: 0, payload_length: 1, checksum: 4953205138095159339}
    stream: mutable DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(DebuggerTraceStream::trace_stream_new(), header)
    stream <- DebuggerTraceStream::trace_stream_append(stream, 42)
    return 4 if DebuggerTraceStream::trace_stream_verify(stream) != DebuggerTraceStream::TraceReadStatus.Complete
    index: mutable DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_new()
    index <- DebuggerQueryIndex::event_index_append(index, DebuggerQueryIndex::EventIndexEntry{event: 4, task: DebuggerIdentity::debug_id(1), statement: DebuggerIdentity::debug_id(2), state_hash: 99})
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(100)
    query: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_first(index, DebuggerQueryEvaluator::Predicate{kind: DebuggerQueryEvaluator::PredicateKind.StateHashEquals, value: 99, second: 0}, 0, 8, token, 8)
    return 5 if query.status != DebuggerQueryEvaluator::QueryStatus.Match or query.event != 4
    task: DebuggerConcurrency::TaskInfo = DebuggerConcurrency::TaskInfo{id: DebuggerIdentity::debug_id(1), parent: DebuggerIdentity::debug_id(0), state: DebuggerConcurrency::TaskState.Blocked, logical_time: 1, os_thread: 1}
    edge: DebuggerConcurrency::WaitEdge = DebuggerConcurrency::WaitEdge{waiter: task.id, owner: task.id, resource: DebuggerIdentity::debug_id(2), kind: DebuggerConcurrency::SynchronizationKind.Mutex}
    graph: mutable DebuggerConcurrencyAnalysis::WaitGraph = DebuggerConcurrencyAnalysis::wait_graph_add(DebuggerConcurrencyAnalysis::wait_graph_new(), edge)
    return 6 if not DebuggerConcurrencyAnalysis::wait_graph_has_cycle(graph, task)
    clock: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_tick(DebuggerConcurrencyAnalysis::vector_clock_new(), 0)
    later: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_tick(clock, 0)
    return 7 if not DebuggerConcurrencyAnalysis::vector_clock_happens_before(clock, later)
    other_clock: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_tick(DebuggerConcurrencyAnalysis::vector_clock_new(), 1)
    merged_clock: DebuggerConcurrencyAnalysis::VectorClock = DebuggerConcurrencyAnalysis::vector_clock_merge(clock, other_clock)
    return 26 if not DebuggerConcurrencyAnalysis::vector_clock_concurrent(clock, other_clock) or merged_clock.values[1] != 1
    branches: mutable DebuggerBranches::BranchStore = DebuggerBranches::branches_fork(DebuggerBranches::branches_new(), DebuggerIdentity::debug_id(0), 3, 7)
    branch_id: DebuggerIdentity::DebugId = branches.branches[0].id
    branches <- DebuggerBranches::branches_add_intervention(branches, branch_id, DebuggerBranches::Intervention{event: 4, kind: DebuggerBranches::InterventionKind.Value, target: DebuggerIdentity::debug_id(8), value_hash: 99})
    return 8 if branches.branches[0].intervention_count != 1
    return 32 if not DebuggerBranches::branches_intervention_is_valid(branches.branches[0], DebuggerBranches::Intervention{event: 4, kind: DebuggerBranches::InterventionKind.Value, target: DebuggerIdentity::debug_id(8), value_hash: 99})
    branches_before_invalid: DebuggerBranches::BranchStore = branches
    branches <- DebuggerBranches::branches_add_intervention(branches, branch_id, DebuggerBranches::Intervention{event: 2, kind: DebuggerBranches::InterventionKind.Value, target: DebuggerIdentity::debug_id(8), value_hash: 100})
    return 33 if branches.branches[0].intervention_count != branches_before_invalid.branches[0].intervention_count
    parent_branch: DebuggerBranches::BranchRecord = branches.branches[0]
    child_branch: mutable DebuggerBranches::BranchRecord = parent_branch
    child_branch.interventions[0].value_hash <- 100
    return 25 if DebuggerBranches::branches_first_divergence(parent_branch, child_branch) != 4 or parent_branch.interventions[0].value_hash != 99
    metadata: mutable DebuggerTypeMetadata::MetadataStore = DebuggerTypeMetadata::metadata_add_type(DebuggerTypeMetadata::metadata_new(), DebuggerTypeMetadata::TypeInfo{id: DebuggerIdentity::debug_id(10), kind: DebuggerTypeMetadata::TypeKind.Struct, name: DebuggerIdentity::debug_id(11), size: 16, alignment: 8, child_count: 2, pointee: DebuggerIdentity::debug_id(0), flags: 0})
    found_type: DebuggerTypeMetadata::TypeInfo = DebuggerTypeMetadata::metadata_find_type(metadata, DebuggerIdentity::debug_id(10))
    return 9 if found_type.child_count != 2
    scope_id: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(12)
    metadata <- DebuggerTypeMetadata::metadata_add_scope(metadata, DebuggerTypeMetadata::ScopeInfo{id: scope_id, parent: DebuggerIdentity::debug_id(0), function: DebuggerIdentity::debug_id(13), start_event: 2, end_event: 8})
    binding_identity: DebuggerIdentity::BindingIdentity = DebuggerIdentity::BindingIdentity{declaration: DebuggerIdentity::debug_id(14), incarnation: 1}
    metadata <- DebuggerTypeMetadata::metadata_add_binding(metadata, DebuggerTypeMetadata::BindingInfo{id: binding_identity, name: DebuggerIdentity::debug_id(15), type_id: DebuggerIdentity::debug_id(10), scope: scope_id, lifetime_start: 2, lifetime_end: 8})
    return 22 if DebuggerTypeMetadata::metadata_find_scope(metadata, scope_id).function.value != 13 or not DebuggerTypeMetadata::metadata_scope_is_active(DebuggerTypeMetadata::metadata_find_scope(metadata, scope_id), 4)
    found_binding: DebuggerTypeMetadata::BindingInfo = DebuggerTypeMetadata::metadata_find_binding(metadata, binding_identity)
    return 23 if found_binding.name.value != 15
    values: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(VALUE_STORE_GENERATION)
    root: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(values, DebuggerIdentity::debug_id(VALUE_NAME_ID), DebuggerIdentity::debug_id(VALUE_TYPE_ID))
    child: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(values, DebuggerIdentity::debug_id(VALUE_NAME_ID + 1), DebuggerIdentity::debug_id(VALUE_TYPE_ID), VALUE_CHILD_VALUE)
    return 10 if not DebuggerValueStore::value_store_add_child(values, root, child)
    page: DebuggerValueStore::ValuePage = DebuggerValueStore::value_store_page(values, root, 0)
    return 11 if page.invalid_handle or page.count != 1
    read: DebuggerValueStore::ValueNode = DebuggerValueStore::value_store_read(values, child)
    return 12 if read.signed_value != VALUE_CHILD_VALUE
    stale: DebuggerValues::ValueHandle = DebuggerValues::ValueHandle{stop_generation: VALUE_STORE_GENERATION + 1, id: child.id}
    return 13 if DebuggerValueStore::value_store_add_child(values, root, stale)
    allocation: DebuggerIdentity::AllocationIdentity = DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(WATCH_ALLOCATION_ID), generation: WATCH_ALLOCATION_GENERATION, offset: 0}
    watchpoints: mutable DebuggerWatchpoints::WatchpointTable = DebuggerWatchpoints::watchpoints_new()
    watch_id: DebuggerIdentity::DebugId = DebuggerWatchpoints::watchpoints_add(watchpoints, allocation, DebuggerWatchpoints::AccessKind.Write, VALUE_STORE_GENERATION)
    first_observation: DebuggerWatchpoints::Observation = DebuggerWatchpoints::watchpoint_observe(watchpoints, watch_id, allocation, WATCH_VALUE_FIRST, VALUE_STORE_GENERATION)
    return 14 if first_observation.stop
    second_observation: DebuggerWatchpoints::Observation = DebuggerWatchpoints::watchpoint_observe(watchpoints, watch_id, allocation, WATCH_VALUE_SECOND, VALUE_STORE_GENERATION)
    return 15 if not second_observation.stop or second_observation.point.hit_count != 2
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    task_one: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(TASK_PARENT_ID))
    task_two: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, task_one)
    return 16 if not DebuggerConcurrencyRuntime::runtime_wait(runtime, task_one, task_two, DebuggerIdentity::debug_id(TASK_RESOURCE_ONE), DebuggerConcurrency::SynchronizationKind.Mutex)
    return 17 if not DebuggerConcurrencyRuntime::runtime_wait(runtime, task_two, task_one, DebuggerIdentity::debug_id(TASK_RESOURCE_TWO), DebuggerConcurrency::SynchronizationKind.Mutex)
    return 18 if not DebuggerConcurrencyRuntime::runtime_has_deadlock(runtime)
    resource_bytes: mutable u8[3] = [7, 8, 9]
    resources: mutable DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_new(DebuggerVirtualResources::ResourceMode.Replaying)
    resource_handle: DebuggerIdentity::DebugId = DebuggerVirtualResources::resources_open(resources, DebuggerIdentity::debug_id(RESOURCE_PATH_ID), true, RESOURCE_GENERATION)
    return 19 if not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_seed(resources, resource_handle, resource_bytes[0], 3))
    read_bytes: mutable u8[3] = zeroed
    read_result: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(resources, resource_handle, read_bytes[0], 3)
    return 20 if read_result.transferred != 3 or read_bytes[2] != 9
    write_byte: mutable u8[1] = [10]
    write_result: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(resources, resource_handle, write_byte[0], 1)
    return 21 if write_result.transferred != 1
    branch_resources: mutable DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_clone_branch(resources)
    return 28 if not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_seek(branch_resources, resource_handle, 0))
    branch_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(branch_resources, resource_handle, write_byte[0], 1)
    return 29 if branch_write.transferred != 1
    return 30 if not DebuggerErrors::error_is_ok(DebuggerVirtualResources::resources_seek(resources, resource_handle, 0))
    parent_bytes: mutable u8[1] = zeroed
    parent_read: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(resources, resource_handle, parent_bytes[0], 1)
    return 31 if parent_read.transferred != 1 or parent_bytes[0] != 7
    task_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)
    DebuggerConcurrencyRuntime::runtime_transition(runtime, task_one, DebuggerConcurrency::TaskState.Completed)
    DebuggerConcurrencyCheckpoint::task_snapshot_restore(runtime, task_snapshot)
    return 24 if not DebuggerConcurrencyCheckpoint::task_snapshot_matches(runtime, task_snapshot) or runtime.tasks[0].state != DebuggerConcurrency::TaskState.Blocked
    torn_stream: DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(stream, header)
    return 90 if DebuggerTraceStream::trace_stream_verify(torn_stream) != DebuggerTraceStream::TraceReadStatus.Truncated
    bad_header: mutable DebuggerTrace::ChunkHeader = header
    bad_header.last_event <- header.last_event + 1
    bad_header.checksum <- header.checksum + 1
    bad_stream: mutable DebuggerTraceStream::TraceStream = DebuggerTraceStream::trace_stream_begin(stream, bad_header)
    bad_stream <- DebuggerTraceStream::trace_stream_append(bad_stream, 42)
    return 91 if DebuggerTraceStream::trace_stream_verify(bad_stream) != DebuggerTraceStream::TraceReadStatus.Corrupt or bad_stream.verified_event != stream.verified_event
    return 0
