    malformed_error_response: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::response_error(malformed_envelope_request.request_id, malformed_failure, service.session.stop_generation)
    return Test::MALFORMED_ERROR_ENVELOPE_RESULT if DebuggerProtocolClient::client_accept(malformed_envelope_client, malformed_error_response).code != DebuggerErrors::ErrorCode.Corrupt or malformed_envelope_client.state != DebuggerProtocolClient::ClientState.Failed
    monotonic_client: mutable DebuggerProtocolClient::ReferenceClient = DebuggerProtocolClient::client_new(DebuggerProtocol::protocol_version())
    _ = DebuggerProtocolClient::client_start(monotonic_client, service.session.id.value)
    monotonic_client.stop_generation <- 1
    monotonic_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocolClient::client_make_request(monotonic_client, DebuggerProtocol::Method.Threads, 0)
    monotonic_failure: DebuggerErrors::DebuggerError = DebuggerProtocolClient::client_accept(monotonic_client, DebuggerProtocol::response_ok(monotonic_request.request_id, 0))
    return 88 if monotonic_failure.code != DebuggerErrors::ErrorCode.Corrupt or monotonic_client.state != DebuggerProtocolClient::ClientState.Failed
    unknown_response: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::response_ok(999, service.session.stop_generation)
    unknown_response_failure: DebuggerErrors::DebuggerError = DebuggerProtocolClient::client_accept(envelope_client, unknown_response)
    return 84 if unknown_response_failure.code != DebuggerErrors::ErrorCode.InvalidArgument or envelope_client.state != DebuggerProtocolClient::ClientState.Failed
    return 89 if DebuggerProtocol::response_is_valid(DebuggerProtocol::ResponseEnvelope{request_id: 0, ok: true, failure: DebuggerErrors::no_error(), stop_generation: 0, next_page: 0})
    quota_remaining: u64 = DebuggerRemote::remote_quota_remaining(channel)
    return 23 if quota_remaining == 0
    return 24 if DebuggerRemote::remote_can_control(channel)
    channel <- DebuggerRemote::remote_disconnect(channel)
    return 50 if channel.bytes_received != 0 or channel.quota_exceeded
    channel <- DebuggerRemote::remote_reconnect(channel)
    channel <- DebuggerRemote::remote_authenticate(channel, 1, 1)
    channel <- DebuggerRemote::remote_accept_handshake(channel, handshake)
    return 22 if not DebuggerRemote::remote_is_connected(channel)
    trace_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(20), build, DebuggerCapabilities::managed_capabilities())
    opened_trace: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(trace_session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.OpenTrace, id: 11, has_id: true, expected_generation: 0, target_event: 0, valid: true}, 0)
    return 25 if not opened_trace.accepted or opened_trace.session.state != DebuggerSession::SessionState.Stopped
    verified_trace: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(opened_trace.session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.TraceVerify, id: 12, has_id: true, expected_generation: opened_trace.session.stop_generation, target_event: 0, valid: true}, 0)
    return 26 if verified_trace.accepted or verified_trace.failure.code != DebuggerErrors::ErrorCode.Unsupported
    generic_trace_service: mutable DebuggerSessionService::Service = DebuggerSessionService::service_new(opened_trace.session)
    generic_trace_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.TraceVerify, request_id: 12, session_id: opened_trace.session.id.value, expected_stop_generation: opened_trace.session.stop_generation, page_size: 0, target_event: 0}
    generic_trace_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(generic_trace_service, generic_trace_request)
    return Test::GENERIC_TRACE_RESULT_UNAVAILABLE if generic_trace_response.ok or generic_trace_response.failure.code != DebuggerErrors::ErrorCode.Unsupported
    unavailable_native_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(21), build, DebuggerCapabilities::native_attach_capabilities())
    unavailable_attach: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(unavailable_native_session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Attach, id: 13, has_id: true, expected_generation: 0, target_event: 0, valid: true}, 0)
    return 27 if unavailable_attach.accepted or unavailable_attach.session.state != DebuggerSession::SessionState.Created or unavailable_attach.failure.code != DebuggerErrors::ErrorCode.Unsupported
    available_native_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::ATTACHABLE_OPERATION_SESSION_ID), build, attachable_capabilities)
    available_attach: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(available_native_session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Attach, id: 13, has_id: true, expected_generation: 0, target_event: 0, valid: true}, 0)
    return 27 if not available_attach.accepted or available_attach.session.state != DebuggerSession::SessionState.Stopped
    native_seek: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_seek(available_attach.session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Seek, id: 16, has_id: true, expected_generation: available_attach.session.stop_generation, target_event: 0, valid: true}, available_attach.session.stop_generation)
    return 69 if native_seek.accepted or native_seek.failure.code != DebuggerErrors::ErrorCode.Unavailable
    overflow_payload: mutable u8[65] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 108, 97, 117, 110, 99, 104, 34, 44, 34, 101, 120, 112, 101, 99, 116, 101, 100, 83, 116, 111, 112, 71, 101, 110, 101, 114, 97, 116, 105, 111, 110, 34, 58, 49, 56, 52, 52, 54, 55, 52, 52, 48, 55, 51, 55, 48, 57, 53, 53, 49, 54, 49, 54, 125]
    overflow_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(overflow_payload[0], 65)
    return 32 if overflow_request.valid
    wrong_session: mutable DebuggerProtocol::RequestEnvelope = seek_request
    wrong_session.session_id <- service.session.id.value + 1
    rejected_session: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, wrong_session)
    return 33 if rejected_session.ok
    stale_envelope: mutable DebuggerProtocol::RequestEnvelope = seek_request
    stale_envelope.expected_stop_generation <- service.session.stop_generation + 1
    stale_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, stale_envelope)
    return 137 if stale_response.ok or stale_response.failure.code != DebuggerErrors::ErrorCode.StaleGeneration or stale_response.failure.detail != Test::STALE_GENERATION_DETAIL
    cancelled: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(service.session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Cancel, id: 15, has_id: true, expected_generation: 0, target_event: 0, valid: true}, 0)
    return 60 if cancelled.accepted or cancelled.failure.code != DebuggerErrors::ErrorCode.Unavailable
    return 0
