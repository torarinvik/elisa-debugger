# Compile-time coverage for breakpoint, scheduling, query, agent, and public
# protocol/provider modules.

include "../src/breakpoint/manager.elisa"
include "../src/concurrency/scheduler.elisa"
include "../src/query/index.elisa"
include "../src/query/provenance.elisa"
include "../src/agent/hooks.elisa"
include "../src/protocol/messages.elisa"
include "../src/protocol/session_service.elisa"
include "../src/protocol/dispatcher.elisa"
include "../src/protocol/remote.elisa"
include "../src/native/controller.elisa"
include "../src/protocol/remote_artifact.elisa"
include "../src/breakpoint/resolver.elisa"
include "../src/platform/process.elisa"
include "../src/protocol/client.elisa"
include "../src/concurrency/runtime.elisa"
include "../src/concurrency/checkpoint.elisa"
include "../src/protocol/discovery.elisa"
include "../src/protocol/events.elisa"

const module Test:
    ARTIFACT_SIZE: usize = 3
    ARTIFACT_CHECKSUM: u64 = 11570874782335668893
    INVALID_AGENT_COUNT: usize = 257
    ONE_AGENT_EVENT: usize = 1
    ONE_BREAKPOINT_COUNT: usize = 1
    INVALID_AGENT_ORDINAL: u64 = 4
    INVALID_SCHEDULE_COUNT: usize = 513
    INVALID_TRANSFER_RECEIVED: usize = 2
    ZERO_LENGTH_TRANSFER_RESULT: i64 = 152
    VALID_PROCESS_ID: u64 = 1
    ERROR_DETAIL: u32 = 1
    ONE_SCHEDULE_DECISION: usize = 1
    INVALID_SCHEDULE_ORDINAL: u64 = 2
    INVALID_REVERSE_DISCOVERY_RESULT: i64 = 107
    INVALID_JSON_SHAPE_RESULT: i64 = 113
    DUPLICATE_BREAKPOINT_ID_RESULT: i64 = 117
    INVALID_REQUEST_PRECEDENCE_RESULT: i64 = 118
    UNREPRESENTABLE_CANCEL_RESULT: i64 = 149
    MANAGED_INVALID_REQUEST_PRECEDENCE_RESULT: i64 = 119
    TAMPERED_ARTIFACT_RESULT: i64 = 161
    TAMPERED_ARTIFACT_BYTE: u8 = 9
    CORRUPT_CLIENT_PENDING_RESULT: i64 = 120
    INVALID_CLIENT_PENDING_COUNT: usize = 33
    INVALID_RECORDING_CURSOR_RESULT: i64 = 121
    INVALID_REPLAY_TASK_RESULT: i64 = 134
    INVALID_AGENT_ACK_RESULT: i64 = 122
    NATIVE_AGENT_PROTOCOL_MAJOR: u32 = 1
    NATIVE_AGENT_BUILD_ID: u64 = 2
    NATIVE_AGENT_TARGET_ID: u64 = 3
    INVALID_REATTACH_BUILD_ID: u64 = 0
    UNRESOLVED_FUNCTION_RESULT: i64 = 130
    NO_RESOLUTION_INSTRUCTION: u64 = 18446744073709551615
    INVALID_MEMORY_METHOD_RESULT: i64 = 131
    POSTMORTEM_LAUNCH_RESULT: i64 = 134
    POSTMORTEM_RECORDING_RESULT: i64 = 135
    ATTACHED_DISCOVERY_RESULT: i64 = 136
    ATTACHABLE_DISCOVERY_SESSION_ID: u64 = 12
    ATTACHABLE_OPERATION_SESSION_ID: u64 = 22
    STALE_GENERATION_DETAIL: u32 = 4
    INVALID_APPENDED_ORDINAL_RESULT: i64 = 138
    INVALID_NATIVE_PROVIDER_RESULT: i64 = 139
    INVALID_TASK_PARENT_CYCLE_RESULT: i64 = 140
    INVALID_WAIT_STATE_RESULT: i64 = 141
    INVALID_TASK_STATUS_RESULT: i64 = 143
    BREAKPOINT_BRANCH_ID: u64 = 600
    BREAKPOINT_OTHER_BRANCH_ID: u64 = 601
    BREAKPOINT_HIT_TARGET: u64 = 2
    BREAKPOINT_HIT_STRIDE: u64 = 2
    BREAKPOINT_BRANCH_RESULT: i64 = 144
    BREAKPOINT_SOURCE_ID: u64 = 500
    BREAKPOINT_SOURCE_LINE: u64 = 4
    BREAKPOINT_RESOLUTION_RESULT: i64 = 145
    INVALID_BREAKPOINT_STATUS_RESULT: i64 = 146
    CANCEL_DISCOVERY_RESULT: i64 = 147
    MALFORMED_ERROR_ENVELOPE_RESULT: i64 = 149
    IDLESS_DISCOVERY_RESULT: i64 = 150
    GENERIC_TRACE_RESULT_UNAVAILABLE: i64 = 160
    UNKNOWN_TYPED_REQUEST_RESULT: i64 = 162
    INVALID_BREAKPOINT_LOCATION_RESULT: i64 = 163
    EXPECTED_PARSED_REQUEST_ID: u64 = 1
    PARSED_REPLAY_REQUEST_LENGTH: usize = 26
    PARSED_SEEK_REQUEST_LENGTH: usize = 40
    PARSED_TRACE_VERIFY_REQUEST_LENGTH: usize = 32
    PARSED_TRACE_EXPORT_REQUEST_LENGTH: usize = 32


def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(1),
        runtime: DebuggerIdentity::debug_id(2),
        source: DebuggerIdentity::debug_id(3),
        target: DebuggerIdentity::debug_id(4),
        metadata_version: 1
    }
    session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(9), build, DebuggerCapabilities::managed_capabilities())
    discovery: DebuggerDiscovery::Discovery = DebuggerDiscovery::discovery_for(session)
    return 85 if not DebuggerDiscovery::discovery_is_valid(discovery) or not DebuggerDiscovery::discovery_supports(discovery, DebuggerProtocol::Method.Memory)
    return 90 if not DebuggerDiscovery::discovery_supports(discovery, DebuggerProtocol::Method.CreateSession)
    return 86 if discovery.product.value == 0 or discovery.trace_schema != 1 or not discovery.installation_healthy
    unhealthy_discovery: mutable DebuggerDiscovery::Discovery = discovery
    unhealthy_discovery.installation_healthy <- false
    return 87 if DebuggerDiscovery::discovery_supports(unhealthy_discovery, DebuggerProtocol::Method.Memory)
    return 89 if not DebuggerDiscovery::discovery_supports(unhealthy_discovery, DebuggerProtocol::Method.Cancel) or not DebuggerDiscovery::discovery_supports(unhealthy_discovery, DebuggerProtocol::Method.Close)
    return Test::CANCEL_DISCOVERY_RESULT if not DebuggerDiscovery::discovery_supports(discovery, DebuggerProtocol::Method.Cancel)
    return Test::INVALID_MEMORY_METHOD_RESULT if not DebuggerProtocol::method_is_valid(DebuggerProtocol::Method.Memory)
    return 88 if DebuggerDiscovery::discovery_supports(discovery, DebuggerProtocol::Method.Attach)
    postmortem_capabilities: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::postmortem_capabilities()
    postmortem_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(10), build, postmortem_capabilities)
    postmortem_discovery: DebuggerDiscovery::Discovery = DebuggerDiscovery::discovery_for(postmortem_session)
    return Test::POSTMORTEM_LAUNCH_RESULT if DebuggerDiscovery::discovery_supports(postmortem_discovery, DebuggerProtocol::Method.Launch) or DebuggerDiscovery::discovery_supports(postmortem_discovery, DebuggerProtocol::Method.Attach)
    return Test::POSTMORTEM_LAUNCH_RESULT if DebuggerDiscovery::discovery_supports(postmortem_discovery, DebuggerProtocol::Method.Pause) or DebuggerDiscovery::discovery_supports(postmortem_discovery, DebuggerProtocol::Method.Continue) or DebuggerDiscovery::discovery_supports(postmortem_discovery, DebuggerProtocol::Method.Step) or DebuggerDiscovery::discovery_supports(postmortem_discovery, DebuggerProtocol::Method.Terminate)
    postmortem_launch: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(postmortem_session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: 17, has_id: true, expected_generation: 0, target_event: 0, valid: true}, 0)
    return Test::POSTMORTEM_LAUNCH_RESULT if postmortem_launch.accepted or postmortem_launch.session.state != DebuggerSession::SessionState.Created or postmortem_launch.failure.code != DebuggerErrors::ErrorCode.Unsupported
    postmortem_stopped: DebuggerSession::Session = postmortem_session
    postmortem_stopped.state <- DebuggerSession::SessionState.Stopped
    postmortem_recording: DebuggerSession::Session = DebuggerSession::session_begin_recording(postmortem_stopped)
    return Test::POSTMORTEM_RECORDING_RESULT if postmortem_recording.state != DebuggerSession::SessionState.Stopped or postmortem_recording.last_error != DebuggerSession::SessionError.Unsupported
    attached_capabilities: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::native_attach_capabilities()
    attached_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(11), build, attached_capabilities)
    attached_discovery: DebuggerDiscovery::Discovery = DebuggerDiscovery::discovery_for(attached_session)
    return Test::ATTACHED_DISCOVERY_RESULT if DebuggerDiscovery::discovery_supports(attached_discovery, DebuggerProtocol::Method.Attach) or DebuggerDiscovery::discovery_supports(attached_discovery, DebuggerProtocol::Method.Launch)
    attachable_capabilities: mutable DebuggerCapabilities::CapabilitySet = attached_capabilities
    attachable_capabilities.native_attach <- true
    attachable_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(Test::ATTACHABLE_DISCOVERY_SESSION_ID), build, attachable_capabilities)
    attachable_discovery: DebuggerDiscovery::Discovery = DebuggerDiscovery::discovery_for(attachable_session)
    return Test::ATTACHED_DISCOVERY_RESULT if not DebuggerDiscovery::discovery_supports(attachable_discovery, DebuggerProtocol::Method.Attach) or DebuggerDiscovery::discovery_supports(attachable_discovery, DebuggerProtocol::Method.Launch)
    no_reverse_discovery: mutable DebuggerDiscovery::Discovery = discovery
    no_reverse_discovery.capabilities.reverse_execution <- false
    return Test::INVALID_REVERSE_DISCOVERY_RESULT if DebuggerDiscovery::discovery_supports(no_reverse_discovery, DebuggerProtocol::Method.ReverseStep)
    create: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.CreateSession, id: 1, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    created: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(session, create, 0)
    return 1 if not created.accepted or created.session.state != DebuggerSession::SessionState.Configuring
    launch: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: 2, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    launched: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(created.session, launch, 0)
    return 2 if not launched.accepted or launched.session.state != DebuggerSession::SessionState.Running
    pause: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Pause, id: 3, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    stopped: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(launched.session, pause, 0)
    return 3 if not stopped.accepted or stopped.session.state != DebuggerSession::SessionState.Stopped
    replay: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Replay, id: 4, has_id: true, expected_generation: stopped.session.stop_generation, target_event: 0, valid: true}
    replayed: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(stopped.session, replay, 0)
    return 7 if not replayed.accepted or replayed.session.state != DebuggerSession::SessionState.Replaying
    parsed_payload: mutable u8[Test::PARSED_REPLAY_REQUEST_LENGTH] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 114, 101, 112, 108, 97, 121, 34, 44, 34, 105, 100, 34, 58, 49, 125]
    parsed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(parsed_payload[0], Test::PARSED_REPLAY_REQUEST_LENGTH)
    return 8 if not parsed.valid or not parsed.has_id or parsed.id != Test::EXPECTED_PARSED_REQUEST_ID or parsed.method != DebuggerProtocolRequest::RequestMethod.Replay
    malformed_payload: mutable u8[17] = [34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 114, 101, 112, 108, 97, 121, 34]
    malformed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(malformed_payload[0], 17)
    return Test::INVALID_JSON_SHAPE_RESULT if malformed.valid
    seek_payload: mutable u8[Test::PARSED_SEEK_REQUEST_LENGTH] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 115, 101, 101, 107, 34, 44, 34, 105, 100, 34, 58, 49, 44, 34, 116, 97, 114, 103, 101, 116, 69, 118, 101, 110, 116, 34, 58, 55, 125]
    parsed_seek: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(seek_payload[0], Test::PARSED_SEEK_REQUEST_LENGTH)
    return 31 if not parsed_seek.valid or not parsed_seek.has_id or parsed_seek.id != Test::EXPECTED_PARSED_REQUEST_ID or parsed_seek.method != DebuggerProtocolRequest::RequestMethod.Seek or parsed_seek.target_event != 7
    trace_verify_payload: mutable u8[Test::PARSED_TRACE_VERIFY_REQUEST_LENGTH] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 116, 114, 97, 99, 101, 46, 118, 101, 114, 105, 102, 121, 34, 44, 34, 105, 100, 34, 58, 49, 125]
    parsed_trace_verify: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(trace_verify_payload[0], Test::PARSED_TRACE_VERIFY_REQUEST_LENGTH)
    return 89 if not parsed_trace_verify.valid or not parsed_trace_verify.has_id or parsed_trace_verify.id != Test::EXPECTED_PARSED_REQUEST_ID or parsed_trace_verify.method != DebuggerProtocolRequest::RequestMethod.TraceVerify
    trace_export_payload: mutable u8[Test::PARSED_TRACE_EXPORT_REQUEST_LENGTH] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 116, 114, 97, 99, 101, 46, 101, 120, 112, 111, 114, 116, 34, 44, 34, 105, 100, 34, 58, 49, 125]
    parsed_trace_export: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(trace_export_payload[0], Test::PARSED_TRACE_EXPORT_REQUEST_LENGTH)
    return 90 if not parsed_trace_export.valid or not parsed_trace_export.has_id or parsed_trace_export.id != Test::EXPECTED_PARSED_REQUEST_ID or parsed_trace_export.method != DebuggerProtocolRequest::RequestMethod.TraceExport
    stale: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(stopped.session, launch, 99)
    return 4 if stale.accepted or stale.failure.code != DebuggerErrors::ErrorCode.StaleGeneration
    channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    policy_channel: DebuggerRemote::RemoteChannel = DebuggerRemote::remote_new_with_policy(DebuggerSecurity::default_policy(), DebuggerRemote::RemoteDisconnectPolicy.Pause)
    return 147 if not DebuggerRemote::remote_should_pause(policy_channel) or DebuggerRemote::remote_should_detach(policy_channel) or DebuggerRemote::remote_should_continue(policy_channel)
    process_quota_failure: DebuggerErrors::DebuggerError = DebuggerSecurity::policy_check_all_quotas(DebuggerSecurity::default_policy(), 0, 0, 0, 2)
    return 147 if process_quota_failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    handshake: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 0, engine: 1, trace_schema: 1, authenticated: true}
    channel <- DebuggerRemote::remote_authenticate(channel, 1, 1)
    channel <- DebuggerRemote::remote_accept_handshake(channel, handshake)
    return 5 if not DebuggerRemote::remote_is_connected(channel)
    channel <- DebuggerRemote::remote_heartbeat_missed(channel)
    channel <- DebuggerRemote::remote_heartbeat_missed(channel)
    channel <- DebuggerRemote::remote_heartbeat_missed(channel)
    return 6 if channel.state != DebuggerRemote::RemoteState.Draining or channel.last_error.code != DebuggerErrors::ErrorCode.Transport
    quota_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    quota_channel.policy.quotas.remote_payload_bytes <- 4
    quota_channel <- DebuggerRemote::remote_authenticate(quota_channel, 1, 1)
    quota_channel <- DebuggerRemote::remote_accept_handshake(quota_channel, handshake)
    quota_channel <- DebuggerRemote::remote_receive(quota_channel, 3)
    quota_channel <- DebuggerRemote::remote_receive(quota_channel, 2)
    return 9 if quota_channel.bytes_received != 3
    return 34 if not quota_channel.quota_exceeded or quota_channel.last_error.code != DebuggerErrors::ErrorCode.ResourceLimit
    return 49 if quota_channel.state != DebuggerRemote::RemoteState.Draining or DebuggerRemote::remote_can_control(quota_channel)
    quota_reconnect: DebuggerRemote::RemoteChannel = DebuggerRemote::remote_reconnect(quota_channel)
    return 112 if quota_reconnect.state != DebuggerRemote::RemoteState.Draining or not quota_reconnect.quota_exceeded
    quota_disconnected: DebuggerRemote::RemoteChannel = DebuggerRemote::remote_disconnect(quota_channel)
    return 158 if not quota_disconnected.quota_exceeded
    quota_reconnect_after_disconnect: DebuggerRemote::RemoteChannel = DebuggerRemote::remote_reconnect(quota_disconnected)
    return 159 if quota_reconnect_after_disconnect.state != DebuggerRemote::RemoteState.Disconnected or not quota_reconnect_after_disconnect.quota_exceeded
    incompatible_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    incompatible: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 1, engine: 1, trace_schema: 1, authenticated: true}
    incompatible_channel <- DebuggerRemote::remote_authenticate(incompatible_channel, 1, 1)
    incompatible_channel <- DebuggerRemote::remote_accept_handshake(incompatible_channel, incompatible)
    return 35 if incompatible_channel.state != DebuggerRemote::RemoteState.Failed or incompatible_channel.last_error.code != DebuggerErrors::ErrorCode.Unsupported
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    DebuggerConcurrencyRuntime::runtime_initialize(runtime, false)
    root_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    child_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, root_task)
    return 36 if root_task.value == 0 or child_task.value == 0
    return 37 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, root_task, DebuggerConcurrency::TaskState.Running)
    return 38 if not DebuggerConcurrencyRuntime::runtime_wait(runtime, root_task, child_task, DebuggerIdentity::debug_id(77), DebuggerConcurrency::SynchronizationKind.Mutex)
    return 42 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, child_task, DebuggerConcurrency::TaskState.Running)
    return 39 if not DebuggerConcurrencyRuntime::runtime_wait(runtime, child_task, root_task, DebuggerIdentity::debug_id(78), DebuggerConcurrency::SynchronizationKind.Mutex)
    return 40 if not DebuggerConcurrencyRuntime::runtime_has_deadlock(runtime)
    return 41 if not DebuggerConcurrencyRuntime::runtime_wake(runtime, root_task)
    cycle_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    DebuggerConcurrencyRuntime::runtime_initialize(cycle_runtime, false)
    cycle_root: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(cycle_runtime, DebuggerIdentity::debug_id(0))
    cycle_child: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(cycle_runtime, cycle_root)
    cycle_snapshot: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(cycle_runtime)
    cycle_snapshot.tasks[0].parent <- cycle_child
    return Test::INVALID_TASK_PARENT_CYCLE_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(cycle_snapshot)
    invalid_wait_snapshot: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(cycle_runtime)
    invalid_wait_snapshot.wait_count <- 1
    invalid_wait_snapshot.waits[0] <- DebuggerConcurrency::WaitEdge{waiter: cycle_root, owner: cycle_child, resource: DebuggerIdentity::debug_id(79), kind: DebuggerConcurrency::SynchronizationKind.Mutex}
    return Test::INVALID_WAIT_STATE_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_wait_snapshot)
    status_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    DebuggerConcurrencyRuntime::runtime_initialize(status_runtime, false)
    _ = DebuggerConcurrencyRuntime::runtime_spawn(status_runtime, DebuggerIdentity::debug_id(0))
    invalid_status_snapshot: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(status_runtime)
    invalid_status_snapshot.status <- DebuggerConcurrencyRuntime::RuntimeStatus.Completed
    return Test::INVALID_TASK_STATUS_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_status_snapshot)
    invalid_current_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(status_runtime)
    invalid_current_snapshot.tasks[0].state <- DebuggerConcurrency::TaskState.Completed
    invalid_current_snapshot.current <- status_runtime.current
    return 152 if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_current_snapshot)
    replay_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    DebuggerConcurrencyRuntime::runtime_initialize(replay_runtime, true)
    replay_root: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(replay_runtime, DebuggerIdentity::debug_id(0))
    replay_runtime.scheduler.count <- 1
    replay_runtime.scheduler.decisions[0] <- DebuggerScheduler::ScheduleDecision{ordinal: 0, task: replay_runtime.tasks[0], kind: DebuggerScheduler::ScheduleKind.Run, synchronization: 0}
    return 148 if DebuggerConcurrencyRuntime::runtime_schedule(replay_runtime, replay_root, DebuggerScheduler::ScheduleKind.Yield, DebuggerIdentity::debug_id(0)) or replay_runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Diverged
    service: mutable DebuggerSessionService::Service = DebuggerSessionService::service_new(stopped.session)
    service_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.Replay, request_id: 10, session_id: stopped.session.id.value, expected_stop_generation: stopped.session.stop_generation, page_size: 0, target_event: 0}
    service_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, service_request)
    return 10 if not service_response.ok or service.session.state != DebuggerSession::SessionState.Replaying
    idless_discovery_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.Discover, request_id: 0, session_id: 0, expected_stop_generation: 0, page_size: 0, target_event: 0}
    idless_discovery_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, idless_discovery_request)
    return Test::IDLESS_DISCOVERY_RESULT if not idless_discovery_response.ok or idless_discovery_response.request_id == 0
    invalid_service_request: DebuggerProtocol::RequestEnvelope = service_request
    invalid_service_request.request_id <- 0
    invalid_service_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, invalid_service_request)
    return 108 if invalid_service_response.ok or invalid_service_response.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    cancel_envelope: DebuggerProtocol::RequestEnvelope = service_request
    cancel_envelope.method <- DebuggerProtocol::Method.Cancel
    cancel_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, cancel_envelope)
    return Test::UNREPRESENTABLE_CANCEL_RESULT if cancel_response.ok or cancel_response.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    managed_service: mutable DebuggerManagedService::Service
    DebuggerSessionService::managed_initialize(managed_service, stopped.session, 1)
    invalid_typed_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: 0, has_id: false, expected_generation: stopped.session.stop_generation + 1, target_event: 0, valid: false}
    invalid_typed_result: DebuggerManagedService::Result = DebuggerManagedService::service_dispatch(managed_service, invalid_typed_request)
    return Test::INVALID_REQUEST_PRECEDENCE_RESULT if invalid_typed_result.accepted or invalid_typed_result.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    unknown_typed_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Unknown, id: 12, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    unknown_typed_result: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(stopped.session, unknown_typed_request, 0)
    return Test::UNKNOWN_TYPED_REQUEST_RESULT if unknown_typed_result.accepted or unknown_typed_result.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    managed_invalid_request: DebuggerProtocol::RequestEnvelope = service_request
    managed_invalid_request.request_id <- 0
    managed_invalid_request.expected_stop_generation <- stopped.session.stop_generation + 1
    managed_invalid_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle_managed(managed_service, managed_invalid_request)
    return Test::MANAGED_INVALID_REQUEST_PRECEDENCE_RESULT if managed_invalid_response.ok or managed_invalid_response.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    seek_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.Seek, request_id: 14, session_id: service.session.id.value, expected_stop_generation: service.session.stop_generation, page_size: 0, target_event: 0}
    seek_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, seek_request)
    return 30 if not seek_response.ok or service.session.state != DebuggerSession::SessionState.Stopped
    artifact_bytes: mutable u8[Test::ARTIFACT_SIZE] = [1, 2, 3]
    transfer: mutable DebuggerRemoteArtifact::ArtifactTransfer = DebuggerRemoteArtifact::transfer_new(Test::ARTIFACT_SIZE, Test::ARTIFACT_CHECKSUM)
    transfer_error: DebuggerErrors::DebuggerError = DebuggerRemoteArtifact::transfer_accept(transfer, 0, artifact_bytes[0], Test::ARTIFACT_SIZE)
    return 11 if not DebuggerErrors::error_is_ok(transfer_error)
    return 12 if not DebuggerErrors::error_is_ok(DebuggerRemoteArtifact::transfer_finish(transfer)) or not DebuggerRemoteArtifact::transfer_is_complete(transfer)
    zero_length_transfer: mutable DebuggerRemoteArtifact::ArtifactTransfer = DebuggerRemoteArtifact::transfer_new(Test::ARTIFACT_SIZE, Test::ARTIFACT_CHECKSUM)
    zero_length_error: DebuggerErrors::DebuggerError = DebuggerRemoteArtifact::transfer_accept(zero_length_transfer, 0, artifact_bytes[0], 0)
    return Test::ZERO_LENGTH_TRANSFER_RESULT if zero_length_error.code != DebuggerErrors::ErrorCode.ResourceLimit or zero_length_transfer.state != DebuggerRemoteArtifact::TransferState.QuotaExceeded
    repeated_finish_error: DebuggerErrors::DebuggerError = DebuggerRemoteArtifact::transfer_finish(transfer)
    return 151 if repeated_finish_error.code != DebuggerErrors::ErrorCode.InvalidState
    post_complete_bytes: mutable u8[1] = [4]
    post_complete_error: DebuggerErrors::DebuggerError = DebuggerRemoteArtifact::transfer_accept(transfer, Test::ARTIFACT_SIZE, post_complete_bytes[0], 1)
    return 87 if post_complete_error.code != DebuggerErrors::ErrorCode.InvalidState
