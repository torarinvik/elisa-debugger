# Compile-time coverage for breakpoint, scheduling, query, agent, and public
# protocol/provider modules.

include "../src/breakpoint/manager.elisa"
include "../src/concurrency/scheduler.elisa"
include "../src/query/index.elisa"
include "../src/query/provenance.elisa"
include "../src/agent/hooks.elisa"
include "../src/protocol/messages.elisa"
include "../src/protocol/session_service.elisa"
include "../src/protocol/dispatcher.elisa"
include "../src/protocol/remote.elisa"
include "../src/native/controller.elisa"
include "../src/protocol/remote_artifact.elisa"
include "../src/breakpoint/resolver.elisa"
include "../src/platform/process.elisa"
include "../src/protocol/client.elisa"
include "../src/concurrency/runtime.elisa"

const ARTIFACT_SIZE: usize = 3
const ARTIFACT_CHECKSUM: u64 = 11570874782335668893

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(1),
        runtime: DebuggerIdentity::debug_id(2),
        source: DebuggerIdentity::debug_id(3),
        target: DebuggerIdentity::debug_id(4),
        metadata_version: 1
    }
    session: mutable DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(9), build, DebuggerCapabilities::managed_capabilities())
    create: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.CreateSession, id: 1, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    created: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(session, create, 0)
    return 1 if not created.accepted or created.session.state != DebuggerSession::SessionState.Configuring
    launch: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Launch, id: 2, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    launched: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(created.session, launch, 0)
    return 2 if not launched.accepted or launched.session.state != DebuggerSession::SessionState.Running
    pause: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Pause, id: 3, has_id: true, expected_generation: 0, target_event: 0, valid: true}
    stopped: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(launched.session, pause, 0)
    return 3 if not stopped.accepted or stopped.session.state != DebuggerSession::SessionState.Stopped
    replay: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Replay, id: 4, has_id: true, expected_generation: stopped.session.stop_generation, target_event: 0, valid: true}
    replayed: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(stopped.session, replay, 0)
    return 7 if not replayed.accepted or replayed.session.state != DebuggerSession::SessionState.Replaying
    parsed_payload: mutable u8[19] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 114, 101, 112, 108, 97, 121, 34, 125]
    parsed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(parsed_payload[0], 19)
    return 8 if not parsed.valid or parsed.method != DebuggerProtocolRequest::RequestMethod.Replay
    seek_payload: mutable u8[39] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 115, 101, 101, 107, 34, 44, 34, 116, 97, 114, 103, 101, 116, 69, 118, 101, 110, 116, 34, 58, 55, 125]
    parsed_seek: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(seek_payload[0], 33)
    return 31 if not parsed_seek.valid or parsed_seek.method != DebuggerProtocolRequest::RequestMethod.Seek or parsed_seek.target_event != 7
    stale: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(stopped.session, launch, 99)
    return 4 if stale.accepted or stale.failure.code != DebuggerErrors::ErrorCode.StaleGeneration
    channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    handshake: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 0, engine: 1, trace_schema: 1, authenticated: true}
    channel <- DebuggerRemote::remote_accept_handshake(channel, handshake)
    return 5 if not DebuggerRemote::remote_is_connected(channel)
    channel <- DebuggerRemote::remote_heartbeat_missed(channel)
    channel <- DebuggerRemote::remote_heartbeat_missed(channel)
    channel <- DebuggerRemote::remote_heartbeat_missed(channel)
    return 6 if channel.state != DebuggerRemote::RemoteState.Draining
    quota_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    quota_channel.policy.quotas.remote_payload_bytes <- 4
    quota_channel <- DebuggerRemote::remote_accept_handshake(quota_channel, handshake)
    quota_channel <- DebuggerRemote::remote_receive(quota_channel, 3)
    quota_channel <- DebuggerRemote::remote_receive(quota_channel, 2)
    return 9 if quota_channel.bytes_received != 3
    return 34 if not quota_channel.quota_exceeded or quota_channel.last_error.code != DebuggerErrors::ErrorCode.ResourceLimit
    incompatible_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    incompatible: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 1, engine: 1, trace_schema: 1, authenticated: true}
    incompatible_channel <- DebuggerRemote::remote_accept_handshake(incompatible_channel, incompatible)
    return 35 if incompatible_channel.state != DebuggerRemote::RemoteState.Failed or incompatible_channel.last_error.code != DebuggerErrors::ErrorCode.Unsupported
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    root_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    child_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, root_task)
    return 36 if root_task.value == 0 or child_task.value == 0
    return 37 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, root_task, DebuggerConcurrency::TaskState.Running)
    return 38 if not DebuggerConcurrencyRuntime::runtime_wait(runtime, root_task, child_task, DebuggerIdentity::debug_id(77), DebuggerConcurrency::SynchronizationKind.Mutex)
    return 42 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, child_task, DebuggerConcurrency::TaskState.Running)
    return 39 if not DebuggerConcurrencyRuntime::runtime_wait(runtime, child_task, root_task, DebuggerIdentity::debug_id(78), DebuggerConcurrency::SynchronizationKind.Mutex)
    return 40 if not DebuggerConcurrencyRuntime::runtime_has_deadlock(runtime)
    return 41 if not DebuggerConcurrencyRuntime::runtime_wake(runtime, root_task)
    service: mutable DebuggerSessionService::Service = DebuggerSessionService::service_new(stopped.session)
    service_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.Replay, request_id: 10, session_id: stopped.session.id.value, expected_stop_generation: stopped.session.stop_generation, page_size: 0, target_event: 0}
    service_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, service_request)
    return 10 if not service_response.ok or service.session.state != DebuggerSession::SessionState.Replaying
    seek_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{kind: DebuggerProtocol::MessageKind.Request, method: DebuggerProtocol::Method.Seek, request_id: 14, session_id: service.session.id.value, expected_stop_generation: service.session.stop_generation, page_size: 0, target_event: 0}
    seek_response: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, seek_request)
    return 30 if not seek_response.ok or service.session.state != DebuggerSession::SessionState.Stopped
    artifact_bytes: mutable u8[ARTIFACT_SIZE] = [1, 2, 3]
    transfer: mutable DebuggerRemoteArtifact::ArtifactTransfer = DebuggerRemoteArtifact::transfer_new(ARTIFACT_SIZE, ARTIFACT_CHECKSUM)
    transfer_error: DebuggerErrors::DebuggerError = DebuggerRemoteArtifact::transfer_accept(transfer, 0, artifact_bytes[0], ARTIFACT_SIZE)
    return 11 if not DebuggerErrors::error_is_ok(transfer_error)
    return 12 if not DebuggerErrors::error_is_ok(DebuggerRemoteArtifact::transfer_finish(transfer)) or not DebuggerRemoteArtifact::transfer_is_complete(transfer)
    resolver: mutable DebuggerBreakpointResolver::Resolver = DebuggerBreakpointResolver::resolver_new()
    source_span: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(500), start_byte: 0, end_byte: 10, start_line: 4, start_column: 0, end_line: 4, end_column: 8, discriminator: 0}
    return 13 if not DebuggerBreakpointResolver::resolver_add(resolver, DebuggerBreakpointResolver::Candidate{id: DebuggerIdentity::debug_id(1), function: DebuggerIdentity::debug_id(2), source: source_span, instruction: 9})
    location: DebuggerMetadata::SourceLocation = DebuggerMetadata::SourceLocation{file: DebuggerIdentity::debug_id(500), line: 4, column: 2, discriminator: 0}
    resolved: DebuggerBreakpointResolver::Resolution = DebuggerBreakpointResolver::resolver_source(resolver, location)
    return 14 if resolved.status != DebuggerMetadata::BreakpointResolution.Resolved or resolved.instruction != 9
    process: DebuggerProcess::ProcessHandle = DebuggerProcess::process_attach(22, 33)
    return 15 if not DebuggerProcess::process_is_valid(process) or process.state != DebuggerProcess::ProcessState.Stopped
    owned_process: DebuggerProcess::ProcessHandle = DebuggerProcess::process_launch(24, 35)
    return 28 if not DebuggerProcess::process_can_control(owned_process, 24, 35) or DebuggerProcess::process_can_control(owned_process, 24, 99)
    terminated_process: DebuggerProcess::ProcessHandle = DebuggerProcess::process_terminate(owned_process, 24, 35)
    return 29 if terminated_process.state != DebuggerProcess::ProcessState.Exited
    memory_bytes: mutable u8[2] = [8, 9]
    memory: DebuggerProcess::MemoryRead = DebuggerProcess::memory_read_from_buffer(4096, memory_bytes[0], 2)
    return 16 if not memory.complete or memory.bytes[1] != 9
    agent: mutable DebuggerAgent::AgentBuffer = DebuggerAgent::agent_request_stop(DebuggerAgent::agent_buffer_new())
    agent <- DebuggerAgent::agent_acknowledge_stop(agent)
    return 17 if not DebuggerAgent::agent_stop_is_acknowledged(agent) or not DebuggerAgent::agent_is_exact(agent)
    client: mutable DebuggerProtocolClient::ReferenceClient = DebuggerProtocolClient::client_new(DebuggerProtocol::protocol_version())
    return 18 if not DebuggerErrors::error_is_ok(DebuggerProtocolClient::client_start(client, service.session.id.value))
    client_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocolClient::client_make_request(client, DebuggerProtocol::Method.Threads, 0)
    return 19 if client_request.request_id == 0 or client_request.page_size == 0
    client_response: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::response_ok(client_request.request_id, service.session.stop_generation)
    return 20 if not DebuggerErrors::error_is_ok(DebuggerProtocolClient::client_accept(client, client_response)) or not DebuggerProtocolClient::client_is_idle(client)
    quota_remaining: u64 = DebuggerRemote::remote_quota_remaining(channel)
    return 23 if quota_remaining == 0
    return 24 if DebuggerRemote::remote_can_control(channel)
    channel <- DebuggerRemote::remote_disconnect(channel)
    channel <- DebuggerRemote::remote_reconnect(channel)
    channel <- DebuggerRemote::remote_accept_handshake(channel, handshake)
    return 22 if not DebuggerRemote::remote_is_connected(channel)
    trace_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(20), build, DebuggerCapabilities::managed_capabilities())
    opened_trace: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(trace_session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.OpenTrace, id: 11, has_id: true, expected_generation: 0, target_event: 0, valid: true}, 0)
    return 25 if not opened_trace.accepted or opened_trace.session.state != DebuggerSession::SessionState.Stopped
    verified_trace: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(opened_trace.session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.TraceVerify, id: 12, has_id: true, expected_generation: opened_trace.session.stop_generation, target_event: 0, valid: true}, 0)
    return 26 if not verified_trace.accepted
    native_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(21), build, DebuggerCapabilities::native_live_capabilities())
    attached: DebuggerProtocolDispatcher::DispatchResult = DebuggerProtocolDispatcher::dispatch_request(native_session, DebuggerProtocolRequest::Request{method: DebuggerProtocolRequest::RequestMethod.Attach, id: 13, has_id: true, expected_generation: 0, target_event: 0, valid: true}, 0)
    return 27 if not attached.accepted or attached.session.state != DebuggerSession::SessionState.Stopped
    overflow_payload: mutable u8[65] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 108, 97, 117, 110, 99, 104, 34, 44, 34, 101, 120, 112, 101, 99, 116, 101, 100, 83, 116, 111, 112, 71, 101, 110, 101, 114, 97, 116, 105, 111, 110, 34, 58, 49, 56, 52, 52, 54, 55, 52, 52, 48, 55, 51, 55, 48, 57, 53, 53, 49, 54, 49, 54, 125]
    overflow_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(overflow_payload[0], 65)
    return 32 if overflow_request.valid
    wrong_session: mutable DebuggerProtocol::RequestEnvelope = seek_request
    wrong_session.session_id <- service.session.id.value + 1
    rejected_session: DebuggerProtocol::ResponseEnvelope = DebuggerSessionService::service_handle(service, wrong_session)
    return 33 if rejected_session.ok
    return 0
