# Compile-time coverage for canonical trace encoding and durable storage.

include "../src/trace/binary.elisa"
include "../src/trace/storage.elisa"
include "../src/trace/manifest.elisa"
include "../src/trace/recorder.elisa"
include "../src/trace/bundle.elisa"
include "../src/replay/checkpoint.elisa"
include "../src/replay/checkpoint_codec.elisa"
include "../src/vm/edir.elisa"
include "../src/trace/reader.elisa"
include "../src/trace/verify.elisa"
include "../src/trace/export.elisa"

const module Test:
    U16_VALUE: u16 = 4660
    U32_VALUE: u32 = 2309737967
    U64_VALUE: u64 = 1234605616436508552
    CHUNK_CHECKSUM: u64 = 4953205138095159339
    PAYLOAD_BYTE: u8 = 42
    SCHEMA: u32 = 1
    EVENT_SCHEMA: u32 = 1
    EVENT_ORDINAL: u64 = 0
    EVENT_PAYLOAD: u64 = 123
    BUILD_COMPILER: u64 = 1
    BUILD_RUNTIME: u64 = 2
    BUILD_SOURCE: u64 = 3
    BUILD_TARGET: u64 = 4
    RECORDING_ID: u64 = 40
    EXPECTED_LAST_EVENT: u64 = 4
    EVENT_ENCODED_BYTES: usize = 84
    EXPECTED_CHUNK_BYTES: usize = 132
    TRUNCATED_CHUNK_BYTES: usize = 131
    CHECKPOINT_ID: u64 = 70
    CHECKPOINT_FRAME_VALUE: i64 = 42
    CHECKPOINT_RETURN_PC: u64 = 9
    BAD_EVENT_ORDINAL: u64 = 1
    EXPORT_CHUNK_COUNT: usize = 1
    BINARY_CAPACITY_OVERFLOW: usize = 8193
    INVALID_RECORDER_PENDING: usize = 17
    INVALID_READER_EVENT_COUNT: usize = 257
    INVALID_METADATA_VERSION: u32 = 0
    CHECKPOINT_FLAGS_OFFSET: usize = 1164
    CHECKPOINT_PROGRAM_COUNTER_OFFSET: usize = 28
    SHORT_CHECKPOINT_LENGTH: usize = 4
    EMPTY_CHECKPOINT_ID: u64 = 0
    INVALID_STORAGE_RANGE_RESULT: i64 = 80
    EMPTY_EVENT_ENCODING_RESULT: i64 = 81
    INVALID_MANIFEST_RANGE_RESULT: i64 = 82
    INVALID_MANIFEST_DECODE_RESULT: i64 = 83
    EMPTY_MANIFEST_ENCODING_RESULT: i64 = 84
    MISSING_MANIFEST_RESULT: i64 = 85
    EXPORTED_STORAGE_RESULT: i64 = 86
    INVALID_CHECKPOINT_FLAGS_RESULT: i64 = 87
    MANIFEST_BUNDLE_RESULT: i64 = 88
    EMPTY_RECORDER_RESULT: i64 = 89
    TAMPERED_RECORDER_MANIFEST_RESULT: i64 = 90
    INVALID_RECORDER_POSITION_RESULT: i64 = 91
    TAMPERED_RECORDER_PENDING_RESULT: i64 = 92
    TAMPERED_RECORDER_CHUNK_RESULT: i64 = 93
    RECORDER_EVENT_POSITION_EVENT_OFFSET: usize = 36
    TAMPERED_READER_POSITION_RESULT: i64 = 94
    TAMPERED_READER_CHECKPOINT_COUNT_RESULT: i64 = 95
    MALFORMED_STORAGE_EVENT_RESULT: i64 = 96
    GAPPED_STORAGE_EVENT_RESULT: i64 = 97
    INVALID_STORAGE_CHECKPOINT_RESULT: i64 = 98
    RECORDER_EVENT_ORDINAL_OFFSET: usize = 4
    GAPPED_EVENT_ORDINAL: u8 = 2
    OPAQUE_VERIFIED_EVENT_RESULT: i64 = 99
    INVALID_STORAGE_SCHEMA_RESULT: i64 = 100


def check_checkpoint_validation() -> i64:
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    snapshot: mutable DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(machine, DebuggerIdentity::debug_id(Test::CHECKPOINT_ID), 0, 0)
    snapshot.locals_initialized[0] <- true
    snapshot.frame_locals[0] <- Test::CHECKPOINT_FRAME_VALUE
    snapshot.frame_locals_initialized[0] <- true
    snapshot.return_stack[0] <- Test::CHECKPOINT_RETURN_PC
    snapshot.return_stack_pointer <- 1
    snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(snapshot)
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerCheckpointCodec::checkpoint_encode(snapshot)
    roundtrip_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(encoded.bytes[0], encoded.length)
    roundtrip: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpointCodec::checkpoint_decode(roundtrip_reader)
    return 5 if roundtrip.locals_initialized[0] != true or roundtrip.frame_locals[0] != Test::CHECKPOINT_FRAME_VALUE or not roundtrip.frame_locals_initialized[0] or roundtrip.return_stack_pointer != 1 or roundtrip.return_stack[0] != Test::CHECKPOINT_RETURN_PC
    invalid_snapshot: mutable DebuggerCheckpoint::MachineSnapshot = snapshot
    invalid_snapshot.id <- DebuggerIdentity::debug_id(Test::EMPTY_CHECKPOINT_ID)
    invalid_encoded: DebuggerTraceBinary::ByteWriter = DebuggerCheckpointCodec::checkpoint_encode(invalid_snapshot)
    return 4 if DebuggerTraceBinary::writer_is_valid(invalid_encoded)
    offset_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(encoded.bytes[0], encoded.length)
    offset_reader.offset <- 1
    return 1 if DebuggerCheckpointCodec::checkpoint_bytes_are_valid(offset_reader)
    invalid_pc: mutable DebuggerTraceBinary::ByteWriter = encoded
    invalid_pc.bytes[Test::CHECKPOINT_PROGRAM_COUNTER_OFFSET] <- 0
    invalid_pc.bytes[Test::CHECKPOINT_PROGRAM_COUNTER_OFFSET + 1] <- 1
    invalid_pc_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(invalid_pc.bytes[0], invalid_pc.length)
    return 2 if DebuggerCheckpointCodec::checkpoint_bytes_are_valid(invalid_pc_reader)
    short_decode_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(encoded.bytes[0], Test::SHORT_CHECKPOINT_LENGTH)
    short_snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpointCodec::checkpoint_decode(short_decode_reader)
    return 3 if short_snapshot.id.value != Test::EMPTY_CHECKPOINT_ID
    return 0

def check_export_rejects_partial() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME), source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE), target: DebuggerIdentity::debug_id(Test::BUILD_TARGET), metadata_version: 1}
    bundle: mutable DebuggerTraceBundle::TraceBundle = DebuggerTraceBundle::bundle_new(build)
    _ = DebuggerTraceBundle::bundle_seal(bundle, true)
    exported: DebuggerTraceExport::ExportResult = DebuggerTraceExport::export_bundle(bundle)
    return 1 if DebuggerErrors::error_is_ok(exported.failure)
    return 0

def check_empty_event_chunk() -> i64:
    empty_events: mutable DebuggerTraceStorage::StoredChunk = zeroed
    empty_events.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: 0, first_event: 0, last_event: 0, payload_length: 0, checksum: 1469598103934665603}
    empty_events.checksum <- 1469598103934665603
    empty_events_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(empty_events)
    return Test::EMPTY_EVENT_ENCODING_RESULT if DebuggerTraceBinary::writer_is_valid(empty_events_bytes)
    empty_events_scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(empty_events_bytes.bytes[0], empty_events_bytes.length)
    return 1 if empty_events_scan.status != DebuggerTraceStorage::StorageStatus.Invalid
    return 0

def check_empty_manifest_chunk() -> i64:
    empty_manifest: mutable DebuggerTraceStorage::StoredChunk = zeroed
    empty_manifest.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: 0, payload_length: 0, checksum: 1469598103934665603}
    empty_manifest.checksum <- 1469598103934665603
    reader: DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    failure: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(reader, empty_manifest)
    return Test::EMPTY_MANIFEST_ENCODING_RESULT if DebuggerErrors::error_is_ok(failure)
    return 0

def check_invalid_manifest() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME), source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE), target: DebuggerIdentity::debug_id(Test::BUILD_TARGET), metadata_version: 1}
    manifest: mutable DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
    manifest.runtime <- DebuggerIdentity::debug_id(0)
    return 1 if DebuggerTraceManifest::manifest_is_replayable(manifest)
    manifest.runtime <- DebuggerIdentity::debug_id(Test::BUILD_RUNTIME)
    manifest.metadata_version <- Test::INVALID_METADATA_VERSION
    return 2 if DebuggerTraceManifest::manifest_is_replayable(manifest)
    return 0

def check_corrupt_bundle() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME), source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE), target: DebuggerIdentity::debug_id(Test::BUILD_TARGET), metadata_version: 1}
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Metadata, sequence: 0, first_event: 0, last_event: 0, payload_length: 1, checksum: Test::CHUNK_CHECKSUM}
    chunk.payload[0] <- Test::PAYLOAD_BYTE
    chunk.payload_length <- 1
    chunk.checksum <- Test::CHUNK_CHECKSUM
    bundle: mutable DebuggerTraceBundle::TraceBundle = DebuggerTraceBundle::bundle_new(build)
    _ = DebuggerTraceBundle::bundle_append(bundle, chunk)
    _ = DebuggerTraceBundle::bundle_seal(bundle, false)
    bundle.chunks[0].checksum <- bundle.chunks[0].checksum + 1
    report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_bundle(bundle)
    return 1 if report.state != DebuggerTraceVerify::VerificationState.Corrupt or report.verified_chunks != 0
    return 0

def check_corrupt_bundle_state() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME), source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE), target: DebuggerIdentity::debug_id(Test::BUILD_TARGET), metadata_version: 1}
    bundle: mutable DebuggerTraceBundle::TraceBundle = DebuggerTraceBundle::bundle_new(build)
    bundle.state <- DebuggerTraceBundle::BundleState.Corrupt
    report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_bundle(bundle)
    return 1 if report.state != DebuggerTraceVerify::VerificationState.Corrupt or report.replayable
    return 0

def check_pre_manifest() -> i64:
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Metadata, sequence: 0, first_event: 0, last_event: 0, payload_length: 1, checksum: Test::CHUNK_CHECKSUM}
    chunk.payload[0] <- Test::PAYLOAD_BYTE
    chunk.payload_length <- 1
    chunk.checksum <- Test::CHUNK_CHECKSUM
    reader: DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 1 if DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, chunk))
    return 0

def check_trailing_manifest() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME), source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE), target: DebuggerIdentity::debug_id(Test::BUILD_TARGET), metadata_version: 1}
    manifest: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
    manifest_payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: 0, payload_length: manifest_payload.length.u64() + 1, checksum: 0}
    chunk.payload_length <- manifest_payload.length + 1
    for index in 0..<manifest_payload.length:
        chunk.payload[index] <- manifest_payload.bytes[index]
    chunk.payload[manifest_payload.length] <- Test::PAYLOAD_BYTE
    payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    for index in 0..<chunk.payload_length:
        payload <- DebuggerTraceBinary::writer_put_byte(payload, chunk.payload[index])
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    chunk.header.checksum <- chunk.checksum
    reader: DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 1 if DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, chunk))
    return 0

def check_schema_recorder() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME), source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE), target: DebuggerIdentity::debug_id(Test::BUILD_TARGET), metadata_version: 1}
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build, DebuggerIdentity::debug_id(Test::RECORDING_ID + 2))
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::RECORDING_ID))
    event: mutable DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::EVENT_SCHEMA + 1, Test::EVENT_ORDINAL, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_PAYLOAD)
    failure: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(recorder, event)
    return 1 if DebuggerErrors::error_is_ok(failure) or failure.detail != 4
    return 0

def check_opaque_validation() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME), source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE), target: DebuggerIdentity::debug_id(Test::BUILD_TARGET), metadata_version: 1}
    manifest: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
    manifest_payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    manifest_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    manifest_chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: 0, payload_length: manifest_payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_payload)}
    manifest_chunk.payload_length <- manifest_payload.length
    manifest_chunk.checksum <- DebuggerTraceBinary::writer_checksum(manifest_payload)
    for index in 0..<manifest_payload.length:
        manifest_chunk.payload[index] <- manifest_payload.bytes[index]
    reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 1 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, manifest_chunk))
    opaque: mutable DebuggerTraceStorage::StoredChunk = zeroed
    opaque.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA + 1, kind: DebuggerTrace::ChunkKind.Metadata, sequence: 1, first_event: 0, last_event: 0, payload_length: 1, checksum: Test::CHUNK_CHECKSUM}
    opaque.payload[0] <- Test::PAYLOAD_BYTE
    opaque.payload_length <- 1
    opaque.checksum <- Test::CHUNK_CHECKSUM
    return 2 if DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, opaque))
    return 0

def main() -> i64:
    return 78 if check_checkpoint_validation() != 0
    return 79 if check_export_rejects_partial() != 0
    corrupt_writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    corrupt_writer.length <- Test::BINARY_CAPACITY_OVERFLOW
    return 44 if DebuggerTraceBinary::writer_is_valid(corrupt_writer) or DebuggerTraceBinary::writer_checksum(corrupt_writer) != 0
    corrupt_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(corrupt_writer.bytes[0], Test::BINARY_CAPACITY_OVERFLOW)
    return 45 if DebuggerTraceBinary::reader_is_valid(corrupt_reader)
    writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    writer <- DebuggerTraceBinary::writer_put_u16(writer, Test::U16_VALUE)
    writer <- DebuggerTraceBinary::writer_put_u32(writer, Test::U32_VALUE)
    writer <- DebuggerTraceBinary::writer_put_u64(writer, Test::U64_VALUE)
    return 1 if not DebuggerTraceBinary::writer_is_valid(writer)
    reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(writer.bytes[0], writer.length)
    return 2 if DebuggerTraceBinary::reader_take_u16(reader) != Test::U16_VALUE
    return 3 if DebuggerTraceBinary::reader_take_u32(reader) != Test::U32_VALUE
    return 4 if DebuggerTraceBinary::reader_take_u64(reader) != Test::U64_VALUE
    return 5 if not DebuggerTraceBinary::reader_is_valid(reader)
    storage_position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::RECORDING_ID))
    storage_event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::EVENT_SCHEMA, Test::EVENT_ORDINAL, storage_position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_PAYLOAD)
    storage_event_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceRecorder::encode_event(storage_event)
    return 54 if not DebuggerTraceBinary::writer_is_valid(storage_event_bytes) or storage_event_bytes.length != Test::EVENT_ENCODED_BYTES
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: 0, first_event: Test::EVENT_ORDINAL, last_event: Test::EVENT_ORDINAL, payload_length: storage_event_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(storage_event_bytes)}
    chunk.payload_length <- storage_event_bytes.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(storage_event_bytes)
    for event_byte_index in 0..<storage_event_bytes.length:
        chunk.payload[event_byte_index] <- storage_event_bytes.bytes[event_byte_index]
    corrupt_storage_chunk: mutable DebuggerTraceStorage::StoredChunk = chunk
    corrupt_storage_chunk.payload[0] <- corrupt_storage_chunk.payload[0] + 1
    corrupt_storage_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(corrupt_storage_chunk)
    return 48 if DebuggerTraceBinary::writer_is_valid(corrupt_storage_bytes)
    invalid_storage_range: mutable DebuggerTraceStorage::StoredChunk = chunk
    invalid_storage_range.header.first_event <- 1
    invalid_storage_range_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(invalid_storage_range)
    return Test::INVALID_STORAGE_RANGE_RESULT if DebuggerTraceBinary::writer_is_valid(invalid_storage_range_bytes)
    invalid_storage_schema: mutable DebuggerTraceStorage::StoredChunk = chunk
    invalid_storage_schema.header.schema <- Test::SCHEMA + 1
    invalid_storage_schema_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(invalid_storage_schema)
    return Test::INVALID_STORAGE_SCHEMA_RESULT if DebuggerTraceBinary::writer_is_valid(invalid_storage_schema_bytes)
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(chunk)
    return 6 if not DebuggerTraceBinary::writer_is_valid(encoded)
    return 7 if encoded.length != Test::EXPECTED_CHUNK_BYTES
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(encoded.bytes[0], encoded.length)
    return 8 if scan.status != DebuggerTraceStorage::StorageStatus.Ready or scan.verified_chunks != 1 or scan.footer_verified or not scan.event_chunk_seen
    footerless_report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(encoded.bytes[0], encoded.length)
    return 29 if footerless_report.state != DebuggerTraceVerify::VerificationState.Partial or footerless_report.replayable
    truncated: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(encoded.bytes[0], Test::TRUNCATED_CHUNK_BYTES)
    return 9 if truncated.status != DebuggerTraceStorage::StorageStatus.Truncated
    return 39 if check_empty_event_chunk() != 0
    return 84 if check_empty_manifest_chunk() != 0
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(1, 0)
    combined: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    for encoded_index in 0..<encoded.length:
        combined <- DebuggerTraceBinary::writer_put_byte(combined, encoded.bytes[encoded_index])
    for footer_index in 0..<footer.length:
        combined <- DebuggerTraceBinary::writer_put_byte(combined, footer.bytes[footer_index])
    scan_with_footer: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(combined.bytes[0], combined.length)
    return 10 if scan_with_footer.status != DebuggerTraceStorage::StorageStatus.Invalid or scan_with_footer.footer_verified or scan_with_footer.manifest_seen or not scan_with_footer.event_chunk_seen
    footer_only_report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(combined.bytes[0], combined.length)
    return Test::MISSING_MANIFEST_RESULT if footer_only_report.state != DebuggerTraceVerify::VerificationState.Corrupt or footer_only_report.replayable
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME), source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE), target: DebuggerIdentity::debug_id(Test::BUILD_TARGET), metadata_version: 1}
    manifest: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
    manifest.last_event <- Test::EXPECTED_LAST_EVENT
    manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    manifest_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(manifest_bytes.bytes[0], manifest_bytes.length)
    decoded: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_decode(manifest_reader)
    return 11 if not DebuggerTraceManifest::manifest_is_replayable(decoded) or decoded.compiler.value != Test::BUILD_COMPILER or decoded.last_event != Test::EXPECTED_LAST_EVENT
    return 43 if check_invalid_manifest() != 0
    recorder_build: DebuggerIdentity::BuildIdentity = build
    empty_recorder: DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(recorder_build, DebuggerIdentity::debug_id(Test::RECORDING_ID + 3))
    return Test::EMPTY_RECORDER_RESULT if DebuggerTraceRecorder::recorder_is_exact(empty_recorder)
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(recorder_build, DebuggerIdentity::debug_id(Test::RECORDING_ID))
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::RECORDING_ID))
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::EVENT_SCHEMA, Test::EVENT_ORDINAL, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_PAYLOAD)
    append_error: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(recorder, event)
    return 12 if not DebuggerErrors::error_is_ok(append_error)
    invalid_position_event: mutable DebuggerEvents::EventEnvelope = event
    invalid_position_event.position.event <- Test::BAD_EVENT_ORDINAL
    invalid_position_recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(recorder_build, DebuggerIdentity::debug_id(Test::RECORDING_ID))
    invalid_position_error: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(invalid_position_recorder, invalid_position_event)
    return Test::INVALID_RECORDER_POSITION_RESULT if DebuggerErrors::error_is_ok(invalid_position_error)
    finalize_error: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_finalize(recorder)
    return 13 if not DebuggerErrors::error_is_ok(finalize_error) or DebuggerTraceRecorder::recorder_chunk_count(recorder) != 1 or not DebuggerTraceRecorder::recorder_is_exact(recorder)
    malformed_recorder: mutable DebuggerTraceRecorder::TraceRecorder = recorder
    malformed_recorder.pending_count <- Test::INVALID_RECORDER_PENDING
    return 46 if DebuggerTraceRecorder::recorder_is_exact(malformed_recorder)
    tampered_recorder: mutable DebuggerTraceRecorder::TraceRecorder = recorder
    tampered_recorder.manifest.last_event <- tampered_recorder.manifest.last_event + 1
    return Test::TAMPERED_RECORDER_MANIFEST_RESULT if DebuggerTraceRecorder::recorder_is_exact(tampered_recorder)
    tampered_chunk_recorder: mutable DebuggerTraceRecorder::TraceRecorder = recorder
    tampered_chunk: mutable DebuggerTraceStorage::StoredChunk = tampered_chunk_recorder.chunks[0]
    tampered_chunk.payload[Test::RECORDER_EVENT_POSITION_EVENT_OFFSET] <- Test::BAD_EVENT_ORDINAL
    tampered_chunk_payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    for tampered_index in 0..<tampered_chunk.payload_length:
        tampered_chunk_payload <- DebuggerTraceBinary::writer_put_byte(tampered_chunk_payload, tampered_chunk.payload[tampered_index])
    tampered_chunk.checksum <- DebuggerTraceBinary::writer_checksum(tampered_chunk_payload)
    tampered_chunk.header.checksum <- tampered_chunk.checksum
    tampered_chunk_recorder.chunks[0] <- tampered_chunk
    return Test::TAMPERED_RECORDER_CHUNK_RESULT if DebuggerTraceRecorder::recorder_is_exact(tampered_chunk_recorder)
    pending_recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(recorder_build, DebuggerIdentity::debug_id(Test::RECORDING_ID))
