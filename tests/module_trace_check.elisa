# Compile-time coverage for canonical trace encoding and durable storage.

include "../src/trace/binary.elisa"
include "../src/trace/storage.elisa"
include "../src/trace/manifest.elisa"
include "../src/trace/recorder.elisa"

const TEST_U16_VALUE: u16 = 4660
const TEST_U32_VALUE: u32 = 2309737967
const TEST_U64_VALUE: u64 = 1234605616436508552
const TEST_CHUNK_CHECKSUM: u64 = 4953205138095159339
const TEST_PAYLOAD_BYTE: u8 = 42
const TEST_SCHEMA: u32 = 1
const TEST_EVENT_SCHEMA: u32 = 1
const TEST_EVENT_ORDINAL: u64 = 0
const TEST_EVENT_PAYLOAD: u64 = 123
const TEST_BUILD_COMPILER: u64 = 1
const TEST_BUILD_RUNTIME: u64 = 2
const TEST_BUILD_SOURCE: u64 = 3
const TEST_BUILD_TARGET: u64 = 4
const TEST_RECORDING_ID: u64 = 40
const TEST_EXPECTED_LAST_EVENT: u64 = 4
const TEST_EXPECTED_CHUNK_BYTES: usize = 49
const TEST_TRUNCATED_CHUNK_BYTES: usize = 48

def main() -> i64:
    writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    writer <- DebuggerTraceBinary::writer_put_u16(writer, TEST_U16_VALUE)
    writer <- DebuggerTraceBinary::writer_put_u32(writer, TEST_U32_VALUE)
    writer <- DebuggerTraceBinary::writer_put_u64(writer, TEST_U64_VALUE)
    return 1 if not DebuggerTraceBinary::writer_is_valid(writer)
    reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(writer.bytes[0], writer.length)
    return 2 if DebuggerTraceBinary::reader_take_u16(reader) != TEST_U16_VALUE
    return 3 if DebuggerTraceBinary::reader_take_u32(reader) != TEST_U32_VALUE
    return 4 if DebuggerTraceBinary::reader_take_u64(reader) != TEST_U64_VALUE
    return 5 if not DebuggerTraceBinary::reader_is_valid(reader)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: TEST_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: 0, first_event: 0, last_event: 0, payload_length: 1, checksum: TEST_CHUNK_CHECKSUM}
    chunk.payload[0] <- TEST_PAYLOAD_BYTE
    chunk.payload_length <- 1
    chunk.checksum <- TEST_CHUNK_CHECKSUM
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(chunk)
    return 6 if not DebuggerTraceBinary::writer_is_valid(encoded)
    return 7 if encoded.length != TEST_EXPECTED_CHUNK_BYTES
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(encoded.bytes[0], encoded.length)
    return 8 if scan.status != DebuggerTraceStorage::StorageStatus.Ready or scan.verified_chunks != 1
    truncated: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(encoded.bytes[0], TEST_TRUNCATED_CHUNK_BYTES)
    return 9 if truncated.status != DebuggerTraceStorage::StorageStatus.Truncated
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(1, 0)
    combined: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    for encoded_index in 0..<encoded.length:
        combined <- DebuggerTraceBinary::writer_put_byte(combined, encoded.bytes[encoded_index])
    for footer_index in 0..<footer.length:
        combined <- DebuggerTraceBinary::writer_put_byte(combined, footer.bytes[footer_index])
    scan_with_footer: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(combined.bytes[0], combined.length)
    return 10 if scan_with_footer.status != DebuggerTraceStorage::StorageStatus.Ready
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(TEST_BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(TEST_BUILD_RUNTIME), source: DebuggerIdentity::debug_id(TEST_BUILD_SOURCE), target: DebuggerIdentity::debug_id(TEST_BUILD_TARGET), metadata_version: 1}
    manifest: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
    manifest.last_event <- TEST_EXPECTED_LAST_EVENT
    manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    manifest_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(manifest_bytes.bytes[0], manifest_bytes.length)
    decoded: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_decode(manifest_reader)
    return 11 if not DebuggerTraceManifest::manifest_is_replayable(decoded) or decoded.compiler.value != TEST_BUILD_COMPILER or decoded.last_event != TEST_EXPECTED_LAST_EVENT
    recorder_build: DebuggerIdentity::BuildIdentity = build
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(recorder_build, DebuggerIdentity::debug_id(TEST_RECORDING_ID))
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(TEST_RECORDING_ID))
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(TEST_EVENT_SCHEMA, TEST_EVENT_ORDINAL, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, TEST_EVENT_PAYLOAD)
    append_error: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(recorder, event)
    return 12 if not DebuggerErrors::error_is_ok(append_error)
    finalize_error: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_finalize(recorder)
    return 13 if not DebuggerErrors::error_is_ok(finalize_error) or DebuggerTraceRecorder::recorder_chunk_count(recorder) != 1 or not DebuggerTraceRecorder::recorder_is_exact(recorder)
    return 0
