# Compile-time coverage for canonical trace encoding and durable storage.

include "../src/trace/binary.elisa"
include "../src/trace/storage.elisa"
include "../src/trace/manifest.elisa"
include "../src/trace/recorder.elisa"
include "../src/trace/bundle.elisa"
include "../src/replay/checkpoint.elisa"
include "../src/replay/checkpoint_codec.elisa"
include "../src/vm/edir.elisa"
include "../src/trace/reader.elisa"
include "../src/trace/verify.elisa"
include "../src/trace/export.elisa"

const TEST_U16_VALUE: u16 = 4660
const TEST_U32_VALUE: u32 = 2309737967
const TEST_U64_VALUE: u64 = 1234605616436508552
const TEST_CHUNK_CHECKSUM: u64 = 4953205138095159339
const TEST_PAYLOAD_BYTE: u8 = 42
const TEST_SCHEMA: u32 = 1
const TEST_EVENT_SCHEMA: u32 = 1
const TEST_EVENT_ORDINAL: u64 = 0
const TEST_EVENT_PAYLOAD: u64 = 123
const TEST_BUILD_COMPILER: u64 = 1
const TEST_BUILD_RUNTIME: u64 = 2
const TEST_BUILD_SOURCE: u64 = 3
const TEST_BUILD_TARGET: u64 = 4
const TEST_RECORDING_ID: u64 = 40
const TEST_EXPECTED_LAST_EVENT: u64 = 4
const TEST_EXPECTED_CHUNK_BYTES: usize = 49
const TEST_TRUNCATED_CHUNK_BYTES: usize = 48
const TEST_CHECKPOINT_ID: u64 = 70
const TEST_BAD_EVENT_ORDINAL: u64 = 1
const TEST_EXPORT_CHUNK_COUNT: usize = 1

def main() -> i64:
    writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    writer <- DebuggerTraceBinary::writer_put_u16(writer, TEST_U16_VALUE)
    writer <- DebuggerTraceBinary::writer_put_u32(writer, TEST_U32_VALUE)
    writer <- DebuggerTraceBinary::writer_put_u64(writer, TEST_U64_VALUE)
    return 1 if not DebuggerTraceBinary::writer_is_valid(writer)
    reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(writer.bytes[0], writer.length)
    return 2 if DebuggerTraceBinary::reader_take_u16(reader) != TEST_U16_VALUE
    return 3 if DebuggerTraceBinary::reader_take_u32(reader) != TEST_U32_VALUE
    return 4 if DebuggerTraceBinary::reader_take_u64(reader) != TEST_U64_VALUE
    return 5 if not DebuggerTraceBinary::reader_is_valid(reader)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: TEST_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: 0, first_event: 0, last_event: 0, payload_length: 1, checksum: TEST_CHUNK_CHECKSUM}
    chunk.payload[0] <- TEST_PAYLOAD_BYTE
    chunk.payload_length <- 1
    chunk.checksum <- TEST_CHUNK_CHECKSUM
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(chunk)
    return 6 if not DebuggerTraceBinary::writer_is_valid(encoded)
    return 7 if encoded.length != TEST_EXPECTED_CHUNK_BYTES
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(encoded.bytes[0], encoded.length)
    return 8 if scan.status != DebuggerTraceStorage::StorageStatus.Ready or scan.verified_chunks != 1 or scan.footer_verified
    footerless_report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(encoded.bytes[0], encoded.length)
    return 29 if footerless_report.state != DebuggerTraceVerify::VerificationState.Partial or footerless_report.replayable
    truncated: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(encoded.bytes[0], TEST_TRUNCATED_CHUNK_BYTES)
    return 9 if truncated.status != DebuggerTraceStorage::StorageStatus.Truncated
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(1, 0)
    combined: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    for encoded_index in 0..<encoded.length:
        combined <- DebuggerTraceBinary::writer_put_byte(combined, encoded.bytes[encoded_index])
    for footer_index in 0..<footer.length:
        combined <- DebuggerTraceBinary::writer_put_byte(combined, footer.bytes[footer_index])
    scan_with_footer: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(combined.bytes[0], combined.length)
    return 10 if scan_with_footer.status != DebuggerTraceStorage::StorageStatus.Ready or not scan_with_footer.footer_verified
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(TEST_BUILD_COMPILER), runtime: DebuggerIdentity::debug_id(TEST_BUILD_RUNTIME), source: DebuggerIdentity::debug_id(TEST_BUILD_SOURCE), target: DebuggerIdentity::debug_id(TEST_BUILD_TARGET), metadata_version: 1}
    manifest: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build, DebuggerTraceManifest::ManifestStatus.Exact)
    manifest.last_event <- TEST_EXPECTED_LAST_EVENT
    manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    manifest_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(manifest_bytes.bytes[0], manifest_bytes.length)
    decoded: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_decode(manifest_reader)
    return 11 if not DebuggerTraceManifest::manifest_is_replayable(decoded) or decoded.compiler.value != TEST_BUILD_COMPILER or decoded.last_event != TEST_EXPECTED_LAST_EVENT
    recorder_build: DebuggerIdentity::BuildIdentity = build
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(recorder_build, DebuggerIdentity::debug_id(TEST_RECORDING_ID))
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(TEST_RECORDING_ID))
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(TEST_EVENT_SCHEMA, TEST_EVENT_ORDINAL, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, TEST_EVENT_PAYLOAD)
    append_error: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(recorder, event)
    return 12 if not DebuggerErrors::error_is_ok(append_error)
    finalize_error: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_finalize(recorder)
    return 13 if not DebuggerErrors::error_is_ok(finalize_error) or DebuggerTraceRecorder::recorder_chunk_count(recorder) != 1 or not DebuggerTraceRecorder::recorder_is_exact(recorder)
    bundle: mutable DebuggerTraceBundle::TraceBundle = DebuggerTraceBundle::bundle_new(build)
    bundle_error: DebuggerErrors::DebuggerError = DebuggerTraceBundle::bundle_append(bundle, chunk)
    return 14 if not DebuggerErrors::error_is_ok(bundle_error) or DebuggerTraceBundle::bundle_chunk_count(bundle) != 1
    return 15 if not DebuggerErrors::error_is_ok(DebuggerTraceBundle::bundle_scan(bundle))
    seal_error: DebuggerErrors::DebuggerError = DebuggerTraceBundle::bundle_seal(bundle, false)
    return 16 if not DebuggerErrors::error_is_ok(seal_error) or not DebuggerTraceBundle::bundle_is_replayable(bundle)
    verification: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_bundle(bundle)
    return 17 if verification.state != DebuggerTraceVerify::VerificationState.Exact or not verification.replayable
    partial_verification: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(encoded.bytes[0], TEST_TRUNCATED_CHUNK_BYTES)
    return 18 if partial_verification.state != DebuggerTraceVerify::VerificationState.Partial
    checkpoint_machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    checkpoint: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(checkpoint_machine, DebuggerIdentity::debug_id(TEST_CHECKPOINT_ID), TEST_EVENT_ORDINAL, TEST_EVENT_PAYLOAD)
    checkpoint_bytes: DebuggerTraceBinary::ByteWriter = DebuggerCheckpointCodec::checkpoint_encode(checkpoint)
    checkpoint_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(checkpoint_bytes.bytes[0], checkpoint_bytes.length)
    decoded_checkpoint: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpointCodec::checkpoint_decode(checkpoint_reader)
    return 19 if not DebuggerCheckpointCodec::checkpoint_bytes_are_valid(checkpoint_reader) or decoded_checkpoint.id.value != TEST_CHECKPOINT_ID or decoded_checkpoint.state_hash != TEST_EVENT_PAYLOAD
    checkpoint_bytes.bytes[0] <- 2
    invalid_checkpoint_reader: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(checkpoint_bytes.bytes[0], checkpoint_bytes.length)
    return 28 if DebuggerCheckpointCodec::checkpoint_bytes_are_valid(invalid_checkpoint_reader)
    manifest_payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(recorder.manifest)
    manifest_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    manifest_chunk.header <- DebuggerTrace::ChunkHeader{schema: TEST_SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: TEST_EVENT_ORDINAL, payload_length: manifest_payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_payload)}
    manifest_chunk.payload_length <- manifest_payload.length
    manifest_chunk.checksum <- DebuggerTraceBinary::writer_checksum(manifest_payload)
    for manifest_index in 0..<manifest_payload.length:
        manifest_chunk.payload[manifest_index] <- manifest_payload.bytes[manifest_index]
    trace_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 20 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(trace_reader, manifest_chunk))
    event_read_error: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(trace_reader, recorder.chunks[0])
    return 21 if not DebuggerErrors::error_is_ok(event_read_error)
    return 22 if DebuggerTraceReader::reader_event_count(trace_reader) != 1
    return 23 if not DebuggerTraceReader::reader_is_exact(trace_reader)
    bad_range_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 33 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(bad_range_reader, manifest_chunk))
    bad_range_chunk: mutable DebuggerTraceStorage::StoredChunk = recorder.chunks[0]
    bad_range_chunk.header.first_event <- 1
    bad_range_error: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(bad_range_reader, bad_range_chunk)
    return 34 if DebuggerErrors::error_is_ok(bad_range_error)
    corrupt_recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build, DebuggerIdentity::debug_id(TEST_RECORDING_ID + 1))
    bad_event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(TEST_EVENT_SCHEMA, TEST_BAD_EVENT_ORDINAL, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, TEST_EVENT_PAYLOAD)
    bad_append: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(corrupt_recorder, bad_event)
    return 24 if DebuggerErrors::error_is_ok(bad_append)
    return 25 if DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_finalize(corrupt_recorder))
    exported: DebuggerTraceExport::ExportResult = DebuggerTraceExport::export_bundle(bundle)
    return 26 if not DebuggerErrors::error_is_ok(exported.failure) or exported.chunk_count != TEST_EXPORT_CHUNK_COUNT
    exported_scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(exported.bytes.bytes[0], exported.bytes.length)
    return 27 if exported_scan.status != DebuggerTraceStorage::StorageStatus.Ready or exported_scan.verified_chunks != TEST_EXPORT_CHUNK_COUNT + 1
    corrupt_manifest: mutable DebuggerTraceStorage::StoredChunk = manifest_chunk
    corrupt_manifest.checksum <- manifest_chunk.checksum + 1
    fresh_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    corrupt_manifest_error: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(fresh_reader, corrupt_manifest)
    return 30 if DebuggerErrors::error_is_ok(corrupt_manifest_error) or fresh_reader.next_sequence != 0
    sealed_append: DebuggerErrors::DebuggerError = DebuggerTraceBundle::bundle_append(bundle, chunk)
    return 31 if DebuggerErrors::error_is_ok(sealed_append)
    short_checkpoint: mutable DebuggerTraceBinary::ByteReader = DebuggerTraceBinary::reader_new(checkpoint_bytes.bytes[0], 4)
    short_checkpoint.bytes[0] <- 1
    return 32 if DebuggerCheckpointCodec::checkpoint_bytes_are_valid(short_checkpoint)
    return 0
