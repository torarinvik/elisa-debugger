include "../src/native/artifact.elisa"

const ELF_BYTES: usize = 64
const MACHO_BYTES: usize = 32
const INVALID_BYTES: usize = 4
const ELF_MACHINE_OFFSET: usize = 18
const ELF_HEADER_SIZE_OFFSET: usize = 52
const MACHO_CPU_OFFSET: usize = 4
const MACHO_SUBTYPE_OFFSET: usize = 8
const MACHO_FILE_TYPE_OFFSET: usize = 12

def put_u16(bytes: mutable u8&, offset: usize, value: u16) -> void:
    bytes[offset] <- value.u8()
    bytes[offset + 1] <- (value >> 8).u8()

def put_u32(bytes: mutable u8&, offset: usize, value: u32) -> void:
    bytes[offset] <- value.u8()
    bytes[offset + 1] <- (value >> 8).u8()
    bytes[offset + 2] <- (value >> 16).u8()
    bytes[offset + 3] <- (value >> 24).u8()

def main() -> i64:
    elf: mutable u8[ELF_BYTES] = zeroed
    elf[0] <- 127
    elf[1] <- 69
    elf[2] <- 76
    elf[3] <- 70
    elf[4] <- 2
    elf[5] <- 1
    elf[6] <- 1
    put_u16(elf[0], 16, 2)
    put_u16(elf[0], ELF_MACHINE_OFFSET, 62)
    put_u16(elf[0], ELF_HEADER_SIZE_OFFSET, 64)
    parsed_elf: DebuggerNativeArtifact::NativeArtifact = DebuggerNativeArtifact::artifact_parse(elf[0], ELF_BYTES)
    return 1 if parsed_elf.format != DebuggerNativeArtifact::ArtifactFormat.Elf64Little or not DebuggerNativeArtifact::artifact_is_supported(parsed_elf)

    macho: mutable u8[MACHO_BYTES] = zeroed
    macho[0] <- 207
    macho[1] <- 250
    macho[2] <- 237
    macho[3] <- 254
    put_u32(macho[0], MACHO_CPU_OFFSET, 16777228)
    put_u32(macho[0], MACHO_SUBTYPE_OFFSET, 0)
    put_u32(macho[0], MACHO_FILE_TYPE_OFFSET, 2)
    parsed_macho: DebuggerNativeArtifact::NativeArtifact = DebuggerNativeArtifact::artifact_parse(macho[0], MACHO_BYTES)
    return 2 if parsed_macho.format != DebuggerNativeArtifact::ArtifactFormat.MachO64Little or not DebuggerNativeArtifact::artifact_is_supported(parsed_macho)

    invalid: mutable u8[INVALID_BYTES] = zeroed
    invalid[0] <- 1
    invalid[1] <- 2
    invalid[2] <- 3
    invalid[3] <- 4
    parsed_invalid: DebuggerNativeArtifact::NativeArtifact = DebuggerNativeArtifact::artifact_parse(invalid[0], INVALID_BYTES)
    return 3 if parsed_invalid.format != DebuggerNativeArtifact::ArtifactFormat.Unknown or parsed_invalid.valid

    malformed_elf: mutable u8[ELF_BYTES] = elf
    put_u16(malformed_elf[0], ELF_MACHINE_OFFSET, 1)
    parsed_malformed: DebuggerNativeArtifact::NativeArtifact = DebuggerNativeArtifact::artifact_parse(malformed_elf[0], ELF_BYTES)
    return 4 if parsed_malformed.format != DebuggerNativeArtifact::ArtifactFormat.Elf64Little or parsed_malformed.valid
    parsed_malformed.format <- 99
    parsed_malformed.valid <- true
    return 5 if DebuggerNativeArtifact::artifact_is_supported(parsed_malformed)
    return 0
