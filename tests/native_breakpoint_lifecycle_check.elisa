include "../src/native/attach.elisa"

const PROCESS_ID: u64 = 101
const PROCESS_START_IDENTITY: u64 = 202
const BREAKPOINT_ADDRESS: u64 = 4096
const ORIGINAL_INSTRUCTION_BYTE: u8 = 144
const BREAKPOINT_INDEX: usize = 0
const BREAKPOINT_ID: u64 = 1
const REGISTER_ID: u64 = 7
const REGISTER_VALUE: u64 = 42
const ADD_BREAKPOINT_FAILURE: i64 = 1
const RUNNING_REMOVE_FAILURE: i64 = 2
const STOPPED_REMOVE_FAILURE: i64 = 3
const INVALID_REGISTER_FAILURE: i64 = 4

def main() -> i64:
    process: mutable DebuggerProcess::ProcessHandle = DebuggerProcess::process_attach(PROCESS_ID, PROCESS_START_IDENTITY)
    session: mutable DebuggerNativeAttach::AttachSession = DebuggerNativeAttach::attach_new(process)
    invalid_register: DebuggerNativeAttach::Register = DebuggerNativeAttach::Register{id: DebuggerIdentity::debug_id(REGISTER_ID), value: REGISTER_VALUE, valid: false}
    session <- DebuggerNativeAttach::attach_add_register(session, invalid_register)
    return INVALID_REGISTER_FAILURE if session.register_count != 0 or not DebuggerNativeAttach::attach_validate(session)

    valid_register: DebuggerNativeAttach::Register = DebuggerNativeAttach::Register{id: DebuggerIdentity::debug_id(REGISTER_ID), value: REGISTER_VALUE, valid: true}
    session <- DebuggerNativeAttach::attach_add_register(session, valid_register)
    return INVALID_REGISTER_FAILURE if session.register_count != 1 or not DebuggerNativeAttach::attach_validate(session)
    session <- DebuggerNativeAttach::attach_add_breakpoint(session, BREAKPOINT_ADDRESS, ORIGINAL_INSTRUCTION_BYTE)
    return ADD_BREAKPOINT_FAILURE if session.breakpoint_count != 1 or not DebuggerNativeAttach::attach_validate(session)

    id: DebuggerIdentity::DebugId = DebuggerIdentity::debug_id(BREAKPOINT_ID)
    session.process <- DebuggerProcess::process_mark_running(session.process)
    running_removal: DebuggerNativeAttach::AttachSession = DebuggerNativeAttach::attach_remove_breakpoint(session, id)
    return RUNNING_REMOVE_FAILURE if running_removal.breakpoint_count != 1 or running_removal.breakpoints[BREAKPOINT_INDEX].id.value != id.value or running_removal.breakpoints[BREAKPOINT_INDEX].address != BREAKPOINT_ADDRESS or running_removal.breakpoints[BREAKPOINT_INDEX].original_byte != ORIGINAL_INSTRUCTION_BYTE or not running_removal.breakpoints[BREAKPOINT_INDEX].enabled or not DebuggerNativeAttach::attach_validate(running_removal)

    session.process <- DebuggerProcess::process_mark_stopped(session.process)
    stopped_removal: DebuggerNativeAttach::AttachSession = DebuggerNativeAttach::attach_remove_breakpoint(session, id)
    return STOPPED_REMOVE_FAILURE if stopped_removal.breakpoint_count != 0 or not DebuggerNativeAttach::attach_validate(stopped_removal)
    return 0
