include "../src/native/controller.elisa"

const INVALID_PROVIDER_DETAIL: u32 = 3
const INVALID_STATE_DETAIL: u32 = 4
const PROTOCOL_MAJOR: u32 = 1
const AGENT_BUILD: u64 = 2
const AGENT_TARGET: u64 = 3
const TARGET_CRASH_DETAIL: u32 = 41
const AGENT_TRANSPORT_DETAIL: u32 = 42

def main() -> i64:
    provider: DebuggerEngine::Provider = DebuggerEngine::provider_new(DebuggerCapabilities::EngineKind.InstrumentedNative, DebuggerCapabilities::native_live_capabilities())
    controller: mutable DebuggerNative::NativeController = DebuggerNative::native_controller_new(provider)
    paused: DebuggerNative::NativeController = DebuggerNative::native_pause(controller)
    return 1 if paused.last_error.detail != INVALID_STATE_DETAIL
    controller <- DebuggerNative::native_attach(controller, DebuggerNative::AgentIdentity{protocol_major: PROTOCOL_MAJOR, build: AGENT_BUILD, target: AGENT_TARGET})
    return 2 if controller.status != DebuggerNative::NativeStopStatus.Attached
    controller <- DebuggerNative::native_pause(controller)
    controller <- DebuggerNative::native_acknowledge_pause(controller)
    crashed: DebuggerNative::NativeController = DebuggerNative::native_target_crashed(controller, TARGET_CRASH_DETAIL)
    return 5 if crashed.status != DebuggerNative::NativeStopStatus.Crashed or crashed.crash_detail != TARGET_CRASH_DETAIL or not DebuggerNative::native_can_inspect(crashed)
    agent_failed: DebuggerNative::NativeController = DebuggerNative::native_agent_failed(controller, AGENT_TRANSPORT_DETAIL)
    return 6 if agent_failed.status != DebuggerNative::NativeStopStatus.AgentFailed or agent_failed.last_error.code != DebuggerErrors::ErrorCode.Transport or agent_failed.last_error.detail != AGENT_TRANSPORT_DETAIL or DebuggerNative::native_can_inspect(agent_failed)
    failed_detach: DebuggerNative::NativeController = DebuggerNative::native_detach(agent_failed)
    return 7 if failed_detach.status != DebuggerNative::NativeStopStatus.AgentFailed or failed_detach.last_error.code != DebuggerErrors::ErrorCode.Transport
    invalid_crash: DebuggerNative::NativeController = DebuggerNative::native_target_crashed(DebuggerNative::native_controller_new(provider), TARGET_CRASH_DETAIL)
    return 8 if invalid_crash.status != DebuggerNative::NativeStopStatus.Detached or invalid_crash.last_error.code != DebuggerErrors::ErrorCode.InvalidState
    controller <- DebuggerNative::native_resume(controller)
    return 3 if controller.status != DebuggerNative::NativeStopStatus.Attached
    detached: DebuggerNative::NativeController = DebuggerNative::native_detach(controller)
    repeated: DebuggerNative::NativeController = DebuggerNative::native_detach(detached)
    return 4 if repeated.last_error.detail != INVALID_STATE_DETAIL
    return 0
