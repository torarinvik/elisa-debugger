include "../src/native/dwarf_line.elisa"

const module DwarfTestCapacity:
    SECTION_BYTES: usize = 512
    MAX_FILENAME_BYTES: usize = DebuggerNativeDwarfLineCapacity::FILENAME_BYTES
    OVERLONG_FILENAME_BYTES: usize = DwarfTestCapacity::MAX_FILENAME_BYTES + 1
    LONG_STRING_BYTES: usize = DwarfTestCapacity::OVERLONG_FILENAME_BYTES + 1
    WORD_BYTES: usize = 4
    HALFWORD_BYTES: usize = 2
    LEB_BYTES: usize = 10
    COMPILER_TABLE_BYTES: usize = 66
    COMPILER_FILENAME_BYTES: usize = 12

const module DwarfTestOffset:
    FIRST: usize = 0
    SECOND: usize = 1
    THIRD: usize = 2
    FOURTH: usize = 3
    BYTE_BITS: u32 = 8

const module DwarfTestEncoding:
    DWARF_V2: u16 = 2
    DWARF_V3: u16 = 3
    DWARF_V4: u16 = 4
    UNSUPPORTED_DWARF_VERSION: u16 = 5
    INITIAL_LENGTH_BYTES: usize = 4
    V2_OPCODE_BASE: u8 = 10
    V3_OPCODE_BASE: u8 = 13
    MAX_OPERATIONS_PER_INSTRUCTION: u8 = 2
    DEFAULT_MAX_OPERATIONS: u8 = 1
    ADDRESS_WIDTH: usize = 4
    UNSUPPORTED_ADDRESS_WIDTH: usize = 2
    START_ADDRESS: u32 = 4096
    SECOND_SEQUENCE_ADDRESS: u32 = 8192
    ADDRESS_ADVANCE: u8 = 1
    LINE_ADVANCE: u8 = 1
    SOURCE_ADDRESS_JUMP: u32 = 4097
    FIXED_ADDRESS_ADVANCE: u16 = 2
    END_SEQUENCE_LENGTH: u8 = 1
    SET_ADDRESS_LENGTH: u8 = 5
    STANDARD_OPERAND_COUNT: u8 = 1
    NO_OPERANDS: u8 = 0
    SLEB_NEGATIVE_TWO: u8 = 126
    NULL_BYTE: u8 = 0
    BYTE_INCREMENT: usize = 1
    NO_DIRECTORY_INDEX: u8 = 0
    NO_TIMESTAMP: u8 = 0
    NO_FILE_SIZE: u8 = 0
    SIGNED_LINE_BASE: u8 = 251
    LINE_RANGE: u8 = 14
    DWARF4_STANDARD_OPCODE_COUNT: usize = 12
    DWARF2_STANDARD_OPCODE_COUNT: usize = 9
    ADDRESS_WIDTH_64: usize = 8
    EXTENDED_OPCODE_PREFIX: u8 = 0
    EXTENDED_SET_ADDRESS: u8 = 2
    EXTENDED_END_SEQUENCE: u8 = 1
    STANDARD_COPY: u8 = 1
    STANDARD_ADVANCE_PC: u8 = 2
    STANDARD_ADVANCE_LINE: u8 = 3
    STANDARD_FIXED_ADVANCE_PC: u8 = 9
    STANDARD_ADVANCE_PC_INDEX: usize = 1
    STANDARD_ADVANCE_LINE_INDEX: usize = 2
    STANDARD_SET_FILE_INDEX: usize = 3
    STANDARD_SET_COLUMN_INDEX: usize = 4
    STANDARD_FIXED_ADVANCE_PC_INDEX: usize = 8
    INITIAL_LINE: i64 = 1
    SECOND_LINE: i64 = 2
    THIRD_LINE: i64 = 3
    FIRST_FILE_INDEX: u64 = 1
    NO_OPERATION_INDEX: u64 = 0
    SECOND_OPERATION_INDEX: u64 = 1
    NO_DIRECTORY_INDEX_VALUE: u32 = 0
    ZERO_ADDRESS: u64 = 0
    SINGLE_BYTE_LIMIT: usize = 1
    THREE_BYTE_LIMIT: usize = 3
    ZERO_LENGTH: u32 = 0
    MINIMUM_INSTRUCTION_LENGTH: u8 = 1
    DEFAULT_IS_STATEMENT: u8 = 1
    INVALID_FILE_INDEX: u64 = 2
    INVALID_DIRECTORY_INDEX: u8 = 1
    EXPECTED_FILENAME_LENGTH: usize = 7

const module DwarfTestCharacter:
    LOWER_A: u8 = 97
    LOWER_E: u8 = 101
    LOWER_I: u8 = 105
    LOWER_L: u8 = 108
    LOWER_S: u8 = 115
    PERIOD: u8 = 46

const module DwarfTestLeb:
    ULEB_624485_FIRST: u8 = 229
    ULEB_624485_SECOND: u8 = 142
    ULEB_624485_THIRD: u8 = 38
    ULEB_624485_VALUE: u64 = 624485
    SLEB_NEGATIVE_FIVE: u8 = 123
    SLEB_NEGATIVE_FIVE_VALUE: i64 = -5
    SLEB_MAXIMUM_PREFIX_BYTES: usize = DwarfTestCapacity::LEB_BYTES - DwarfTestEncoding::BYTE_INCREMENT
    SLEB_MAXIMUM_CONTINUATION: u8 = 255
    SLEB_ZERO_CONTINUATION: u8 = 128
    SLEB_MAXIMUM_TERMINAL: u8 = 0
    SLEB_MINIMUM_TERMINAL: u8 = 127
    SLEB_POSITIVE_OVERFLOW_TERMINAL: u8 = 1
    SLEB_NEGATIVE_OVERFLOW_TERMINAL: u8 = 126
    CONTINUATION: u8 = 128
    INVALID_TOP_PAYLOAD: u8 = 2
    LAST_BYTE_INDEX: usize = DwarfTestCapacity::LEB_BYTES - DwarfTestEncoding::BYTE_INCREMENT
    MAXIMUM_SIGNED_VALUE: i64 = 9223372036854775807
    MINIMUM_SIGNED_VALUE: i64 = -9223372036854775807 - 1

const module DwarfTestInteger:
    LITTLE_ENDIAN_BYTE_0: u8 = 120
    LITTLE_ENDIAN_BYTE_1: u8 = 86
    LITTLE_ENDIAN_BYTE_2: u8 = 52
    LITTLE_ENDIAN_BYTE_3: u8 = 18
    LITTLE_ENDIAN_EXPECTED: u64 = 305419896
    DWARF64_MARKER_BYTE: u8 = 255

const module DwarfTestCompilerArtifact:
    SEQUENCE_END_ADDRESS: u64 = 12
    EXPECTED_LINE: i64 = 3
    EXPECTED_COLUMN: u64 = 5
    EXPECTED_FILENAME_LENGTH: usize = DwarfTestCapacity::COMPILER_FILENAME_BYTES
    PERIOD_INDEX: usize = 6
    LAST_FILENAME_INDEX: usize = 11

const module DwarfTestResult:
    PASS: i64 = 0
    V2_LOOKUP: i64 = 1
    V3_LOOKUP: i64 = 2
    V4_FIRST_ROW: i64 = 3
    V4_SECOND_ROW: i64 = 4
    V4_SECOND_SEQUENCE: i64 = 5
    FILE_METADATA: i64 = 6
    FILE_INDEX: i64 = 7
    INVALID_DIRECTORY: i64 = 8
    UNSUPPORTED_VERSION: i64 = 9
    UNSUPPORTED_FORMAT: i64 = 10
    ADDRESS_WIDTH: i64 = 11
    LINE_UNDERFLOW: i64 = 12
    SET_ADDRESS_JUMP: i64 = 13
    ACTUAL_ELISA_TABLE: i64 = 14
    ACTUAL_ELISA_LINE: i64 = 15
    ACTUAL_ELISA_COLUMN: i64 = 16
    ACTUAL_ELISA_FILENAME: i64 = 17
    ACTUAL_ELISA_FILENAME_BYTES: i64 = 18
    ACTUAL_ELISA_END: i64 = 19
    TRAILING_MALFORMED_UNIT: i64 = 20
    LONG_FILENAME: i64 = 21
    LEB_INTEGER: i64 = 22
    INTEGER_READ: i64 = 23

struct DwarfFixture:
    length: usize
    directory_index_offset: usize
    version_offset: usize

def put_byte(bytes: mutable u8&, cursor: mutable usize&, value: u8) -> void:
    bytes[cursor] <- value
    cursor <- cursor + DwarfTestEncoding::BYTE_INCREMENT

def put_u16(bytes: mutable u8&, cursor: mutable usize&, value: u16) -> void:
    for index in 0..<DwarfTestCapacity::HALFWORD_BYTES:
        bytes[cursor + index] <- (value >> (index.u32() * DwarfTestOffset::BYTE_BITS)).u8()
    cursor <- cursor + DwarfTestCapacity::HALFWORD_BYTES

def put_u32(bytes: mutable u8&, cursor: mutable usize&, value: u32) -> void:
    for index in 0..<DwarfTestCapacity::WORD_BYTES:
        bytes[cursor + index] <- (value >> (index.u32() * DwarfTestOffset::BYTE_BITS)).u8()
    cursor <- cursor + DwarfTestCapacity::WORD_BYTES

def set_u32(bytes: mutable u8&, offset: usize, value: u32) -> void:
    for index in 0..<DwarfTestCapacity::WORD_BYTES:
        bytes[offset + index] <- (value >> (index.u32() * DwarfTestOffset::BYTE_BITS)).u8()

def put_extended_set_address(bytes: mutable u8&, cursor: mutable usize&, address: u32) -> void:
    put_byte(bytes, cursor, DwarfTestEncoding::EXTENDED_OPCODE_PREFIX)
    put_byte(bytes, cursor, DwarfTestEncoding::SET_ADDRESS_LENGTH)
    put_byte(bytes, cursor, DwarfTestEncoding::EXTENDED_SET_ADDRESS)
    put_u32(bytes, cursor, address)

def put_end_sequence(bytes: mutable u8&, cursor: mutable usize&) -> void:
    put_byte(bytes, cursor, DwarfTestEncoding::EXTENDED_OPCODE_PREFIX)
    put_byte(bytes, cursor, DwarfTestEncoding::END_SEQUENCE_LENGTH)
    put_byte(bytes, cursor, DwarfTestEncoding::EXTENDED_END_SEQUENCE)

def put_source_filename(bytes: mutable u8&, cursor: mutable usize&) -> void:
    put_byte(bytes, cursor, DwarfTestCharacter::LOWER_A)
    put_byte(bytes, cursor, DwarfTestCharacter::PERIOD)
    put_byte(bytes, cursor, DwarfTestCharacter::LOWER_E)
    put_byte(bytes, cursor, DwarfTestCharacter::LOWER_L)
    put_byte(bytes, cursor, DwarfTestCharacter::LOWER_I)
    put_byte(bytes, cursor, DwarfTestCharacter::LOWER_S)
    put_byte(bytes, cursor, DwarfTestCharacter::LOWER_A)
    put_byte(bytes, cursor, DwarfTestEncoding::NULL_BYTE)

def put_standard_opcode_lengths(bytes: mutable u8&, cursor: mutable usize&, count: usize) -> void:
    for index in 0..<count:
        operand_count: mutable u8 = DwarfTestEncoding::NO_OPERANDS
        if index == DwarfTestEncoding::STANDARD_ADVANCE_PC_INDEX or index == DwarfTestEncoding::STANDARD_ADVANCE_LINE_INDEX or index == DwarfTestEncoding::STANDARD_SET_FILE_INDEX or index == DwarfTestEncoding::STANDARD_SET_COLUMN_INDEX or index == DwarfTestEncoding::STANDARD_FIXED_ADVANCE_PC_INDEX:
            operand_count <- DwarfTestEncoding::STANDARD_OPERAND_COUNT
        put_byte(bytes, cursor, operand_count)

def build_fixture(bytes: mutable u8&, version: u16, maximum_operations: u8, underflow_line: bool, jump_address: bool) -> DwarfFixture:
    cursor: mutable usize = DwarfTestOffset::FIRST
    put_u32(bytes, cursor, DwarfTestEncoding::ZERO_LENGTH)
    version_offset: usize = cursor
    put_u16(bytes, cursor, version)
    header_length_offset: usize = cursor
    put_u32(bytes, cursor, DwarfTestEncoding::ZERO_LENGTH)
    header_start: usize = cursor
    put_byte(bytes, cursor, DwarfTestEncoding::MINIMUM_INSTRUCTION_LENGTH)
    if version == DwarfTestEncoding::DWARF_V4:
        put_byte(bytes, cursor, maximum_operations)
    put_byte(bytes, cursor, DwarfTestEncoding::DEFAULT_IS_STATEMENT)
    put_byte(bytes, cursor, DwarfTestEncoding::SIGNED_LINE_BASE)
    put_byte(bytes, cursor, DwarfTestEncoding::LINE_RANGE)
    opcode_base: u8 = DwarfTestEncoding::V3_OPCODE_BASE if version != DwarfTestEncoding::DWARF_V2 else DwarfTestEncoding::V2_OPCODE_BASE
    put_byte(bytes, cursor, opcode_base)
    standard_count: usize = DwarfTestEncoding::DWARF4_STANDARD_OPCODE_COUNT if opcode_base == DwarfTestEncoding::V3_OPCODE_BASE else DwarfTestEncoding::DWARF2_STANDARD_OPCODE_COUNT
    put_standard_opcode_lengths(bytes, cursor, standard_count)
    put_byte(bytes, cursor, DwarfTestEncoding::NULL_BYTE)
    put_source_filename(bytes, cursor)
    directory_index_offset: usize = cursor
    put_byte(bytes, cursor, DwarfTestEncoding::NO_DIRECTORY_INDEX.u8())
    put_byte(bytes, cursor, DwarfTestEncoding::NO_TIMESTAMP)
    put_byte(bytes, cursor, DwarfTestEncoding::NO_FILE_SIZE)
    put_byte(bytes, cursor, DwarfTestEncoding::NULL_BYTE)
    program_offset: usize = cursor
    set_u32(bytes, header_length_offset, (program_offset - header_start).u32())
    put_extended_set_address(bytes, cursor, DwarfTestEncoding::START_ADDRESS)
    if underflow_line:
        put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_ADVANCE_LINE)
        put_byte(bytes, cursor, DwarfTestEncoding::SLEB_NEGATIVE_TWO)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_COPY)
    if jump_address:
        put_extended_set_address(bytes, cursor, DwarfTestEncoding::SOURCE_ADDRESS_JUMP)
    else:
        put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_ADVANCE_PC)
        put_byte(bytes, cursor, DwarfTestEncoding::ADDRESS_ADVANCE)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_ADVANCE_LINE)
    put_byte(bytes, cursor, DwarfTestEncoding::LINE_ADVANCE)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_COPY)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_ADVANCE_PC)
    put_byte(bytes, cursor, DwarfTestEncoding::ADDRESS_ADVANCE)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_ADVANCE_LINE)
    put_byte(bytes, cursor, DwarfTestEncoding::LINE_ADVANCE)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_COPY)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_ADVANCE_PC)
    put_byte(bytes, cursor, DwarfTestEncoding::ADDRESS_ADVANCE)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_FIXED_ADVANCE_PC)
    put_u16(bytes, cursor, DwarfTestEncoding::FIXED_ADDRESS_ADVANCE)
    put_end_sequence(bytes, cursor)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_ADVANCE_PC)
    put_byte(bytes, cursor, DwarfTestEncoding::ADDRESS_ADVANCE)
    put_extended_set_address(bytes, cursor, DwarfTestEncoding::SECOND_SEQUENCE_ADDRESS)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_COPY)
    put_byte(bytes, cursor, DwarfTestEncoding::STANDARD_ADVANCE_PC)
    put_byte(bytes, cursor, DwarfTestEncoding::FIXED_ADDRESS_ADVANCE.u8())
    put_end_sequence(bytes, cursor)
    set_u32(bytes, DwarfTestOffset::FIRST, (cursor - DwarfTestEncoding::INITIAL_LENGTH_BYTES).u32())
    return DwarfFixture{length: cursor, directory_index_offset: directory_index_offset, version_offset: version_offset}

def main() -> i64:
    integer_bytes: mutable u8[DwarfTestCapacity::WORD_BYTES] = zeroed
    integer_bytes[DwarfTestOffset::FIRST] <- DwarfTestInteger::LITTLE_ENDIAN_BYTE_0
    integer_bytes[DwarfTestOffset::SECOND] <- DwarfTestInteger::LITTLE_ENDIAN_BYTE_1
    integer_bytes[DwarfTestOffset::THIRD] <- DwarfTestInteger::LITTLE_ENDIAN_BYTE_2
    integer_bytes[DwarfTestOffset::FOURTH] <- DwarfTestInteger::LITTLE_ENDIAN_BYTE_3
    integer: DebuggerNativeDwarfLineFormat::IntegerResult = DebuggerNativeDwarfLineFormat::dwarf_line_read_uint(integer_bytes[DwarfTestOffset::FIRST], DwarfTestCapacity::WORD_BYTES, DwarfTestOffset::FIRST, DwarfTestCapacity::WORD_BYTES)
    return DwarfTestResult::INTEGER_READ if not integer.valid or integer.value != DwarfTestInteger::LITTLE_ENDIAN_EXPECTED

    leb_bytes: mutable u8[DwarfTestCapacity::LEB_BYTES] = zeroed
    leb_bytes[DwarfTestOffset::FIRST] <- DwarfTestLeb::ULEB_624485_FIRST
    leb_bytes[DwarfTestOffset::SECOND] <- DwarfTestLeb::ULEB_624485_SECOND
    leb_bytes[DwarfTestOffset::THIRD] <- DwarfTestLeb::ULEB_624485_THIRD
    uleb: DebuggerNativeDwarfLineFormat::UlebResult = DebuggerNativeDwarfLineFormat::dwarf_line_read_uleb(leb_bytes[DwarfTestOffset::FIRST], DwarfTestEncoding::THREE_BYTE_LIMIT, DwarfTestEncoding::THREE_BYTE_LIMIT, DwarfTestOffset::FIRST)
    leb_bytes[DwarfTestOffset::FIRST] <- DwarfTestLeb::SLEB_NEGATIVE_FIVE
    sleb: DebuggerNativeDwarfLineFormat::SlebResult = DebuggerNativeDwarfLineFormat::dwarf_line_read_sleb(leb_bytes[DwarfTestOffset::FIRST], DwarfTestEncoding::SINGLE_BYTE_LIMIT, DwarfTestEncoding::SINGLE_BYTE_LIMIT, DwarfTestOffset::FIRST)
    return DwarfTestResult::LEB_INTEGER if not uleb.valid or uleb.value != DwarfTestLeb::ULEB_624485_VALUE or not sleb.valid or sleb.value != DwarfTestLeb::SLEB_NEGATIVE_FIVE_VALUE
    for index in 0..<DwarfTestLeb::SLEB_MAXIMUM_PREFIX_BYTES:
        leb_bytes[index] <- DwarfTestLeb::SLEB_MAXIMUM_CONTINUATION
    leb_bytes[DwarfTestLeb::LAST_BYTE_INDEX] <- DwarfTestLeb::SLEB_MAXIMUM_TERMINAL
    sleb_maximum: DebuggerNativeDwarfLineFormat::SlebResult = DebuggerNativeDwarfLineFormat::dwarf_line_read_sleb(leb_bytes[DwarfTestOffset::FIRST], DwarfTestCapacity::LEB_BYTES, DwarfTestCapacity::LEB_BYTES, DwarfTestOffset::FIRST)
    return DwarfTestResult::LEB_INTEGER if not sleb_maximum.valid or sleb_maximum.value != DwarfTestLeb::MAXIMUM_SIGNED_VALUE or sleb_maximum.next_offset != DwarfTestCapacity::LEB_BYTES
    for index in 0..<DwarfTestLeb::SLEB_MAXIMUM_PREFIX_BYTES:
        leb_bytes[index] <- DwarfTestLeb::SLEB_ZERO_CONTINUATION
    leb_bytes[DwarfTestLeb::LAST_BYTE_INDEX] <- DwarfTestLeb::SLEB_MINIMUM_TERMINAL
    sleb_minimum: DebuggerNativeDwarfLineFormat::SlebResult = DebuggerNativeDwarfLineFormat::dwarf_line_read_sleb(leb_bytes[DwarfTestOffset::FIRST], DwarfTestCapacity::LEB_BYTES, DwarfTestCapacity::LEB_BYTES, DwarfTestOffset::FIRST)
    return DwarfTestResult::LEB_INTEGER if not sleb_minimum.valid or sleb_minimum.value != DwarfTestLeb::MINIMUM_SIGNED_VALUE or sleb_minimum.next_offset != DwarfTestCapacity::LEB_BYTES
    leb_bytes[DwarfTestLeb::LAST_BYTE_INDEX] <- DwarfTestLeb::SLEB_POSITIVE_OVERFLOW_TERMINAL
    return DwarfTestResult::LEB_INTEGER if DebuggerNativeDwarfLineFormat::dwarf_line_read_sleb(leb_bytes[DwarfTestOffset::FIRST], DwarfTestCapacity::LEB_BYTES, DwarfTestCapacity::LEB_BYTES, DwarfTestOffset::FIRST).valid
    leb_bytes[DwarfTestLeb::LAST_BYTE_INDEX] <- DwarfTestLeb::SLEB_NEGATIVE_OVERFLOW_TERMINAL
    return DwarfTestResult::LEB_INTEGER if DebuggerNativeDwarfLineFormat::dwarf_line_read_sleb(leb_bytes[DwarfTestOffset::FIRST], DwarfTestCapacity::LEB_BYTES, DwarfTestCapacity::LEB_BYTES, DwarfTestOffset::FIRST).valid
    leb_bytes[DwarfTestOffset::FIRST] <- DwarfTestLeb::CONTINUATION
    return DwarfTestResult::LEB_INTEGER if DebuggerNativeDwarfLineFormat::dwarf_line_read_uleb(leb_bytes[DwarfTestOffset::FIRST], DwarfTestEncoding::SINGLE_BYTE_LIMIT, DwarfTestEncoding::SINGLE_BYTE_LIMIT, DwarfTestOffset::FIRST).valid
    for index in 0..<DwarfTestCapacity::LEB_BYTES:
        leb_bytes[index] <- DwarfTestLeb::CONTINUATION
    leb_bytes[DwarfTestLeb::LAST_BYTE_INDEX] <- DwarfTestLeb::INVALID_TOP_PAYLOAD
    return DwarfTestResult::LEB_INTEGER if DebuggerNativeDwarfLineFormat::dwarf_line_read_uleb(leb_bytes[DwarfTestOffset::FIRST], DwarfTestCapacity::LEB_BYTES, DwarfTestCapacity::LEB_BYTES, DwarfTestOffset::FIRST).valid

    long_string: mutable u8[DwarfTestCapacity::LONG_STRING_BYTES] = zeroed
    for index in 0..<DwarfTestCapacity::OVERLONG_FILENAME_BYTES:
        long_string[index] <- DwarfTestCharacter::LOWER_A
    long_string[DwarfTestCapacity::OVERLONG_FILENAME_BYTES] <- DwarfTestEncoding::NULL_BYTE
    parsed_long_string: DebuggerNativeDwarfLineFormat::StringResult = DebuggerNativeDwarfLineFormat::dwarf_line_read_string(long_string[DwarfTestOffset::FIRST], DwarfTestCapacity::LONG_STRING_BYTES, DwarfTestCapacity::LONG_STRING_BYTES, DwarfTestOffset::FIRST)
    return DwarfTestResult::LONG_FILENAME if not parsed_long_string.valid or not parsed_long_string.truncated or parsed_long_string.length != DwarfTestCapacity::MAX_FILENAME_BYTES

    v2_bytes: mutable u8[DwarfTestCapacity::SECTION_BYTES] = zeroed
    v2_fixture: DwarfFixture = build_fixture(v2_bytes[DwarfTestOffset::FIRST], DwarfTestEncoding::DWARF_V2, DwarfTestEncoding::DEFAULT_MAX_OPERATIONS, false, false)
    v2_unit: DebuggerNativeDwarfLineFormat::Unit = DebuggerNativeDwarfLineFormat::dwarf_line_parse_unit(v2_bytes[DwarfTestOffset::FIRST], v2_fixture.length, DwarfTestOffset::FIRST)
    v2_lookup: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(v2_bytes[DwarfTestOffset::FIRST], v2_fixture.length, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::START_ADDRESS.u64())
    return DwarfTestResult::V2_LOOKUP if v2_unit.status != DebuggerNativeDwarfLineFormat::UnitStatus.Ready or v2_unit.maximum_operations_per_instruction != DwarfTestEncoding::DEFAULT_MAX_OPERATIONS or v2_lookup.status != DebuggerNativeDwarfLine::Status.Found or v2_lookup.line != DwarfTestEncoding::INITIAL_LINE or v2_lookup.operation_index != DwarfTestEncoding::NO_OPERATION_INDEX

    v3_bytes: mutable u8[DwarfTestCapacity::SECTION_BYTES] = zeroed
    v3_fixture: DwarfFixture = build_fixture(v3_bytes[DwarfTestOffset::FIRST], DwarfTestEncoding::DWARF_V3, DwarfTestEncoding::DEFAULT_MAX_OPERATIONS, false, false)
    v3_lookup: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(v3_bytes[DwarfTestOffset::FIRST], v3_fixture.length, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::START_ADDRESS.u64() + DwarfTestEncoding::ADDRESS_ADVANCE.u64())
    return DwarfTestResult::V3_LOOKUP if v3_lookup.status != DebuggerNativeDwarfLine::Status.Found or v3_lookup.line != DwarfTestEncoding::SECOND_LINE or v3_lookup.operation_index != DwarfTestEncoding::NO_OPERATION_INDEX

    v4_bytes: mutable u8[DwarfTestCapacity::SECTION_BYTES] = zeroed
    v4_fixture: DwarfFixture = build_fixture(v4_bytes[DwarfTestOffset::FIRST], DwarfTestEncoding::DWARF_V4, DwarfTestEncoding::MAX_OPERATIONS_PER_INSTRUCTION, false, false)
    v4_unit: DebuggerNativeDwarfLineFormat::Unit = DebuggerNativeDwarfLineFormat::dwarf_line_parse_unit(v4_bytes[DwarfTestOffset::FIRST], v4_fixture.length, DwarfTestOffset::FIRST)
    v4_first: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(v4_bytes[DwarfTestOffset::FIRST], v4_fixture.length, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::START_ADDRESS.u64())
    v4_second: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(v4_bytes[DwarfTestOffset::FIRST], v4_fixture.length, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::START_ADDRESS.u64() + DwarfTestEncoding::ADDRESS_ADVANCE.u64())
    v4_second_sequence: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(v4_bytes[DwarfTestOffset::FIRST], v4_fixture.length, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::SECOND_SEQUENCE_ADDRESS.u64())
    return DwarfTestResult::V4_FIRST_ROW if v4_first.status != DebuggerNativeDwarfLine::Status.Found or v4_first.line != DwarfTestEncoding::SECOND_LINE or v4_first.operation_index != DwarfTestEncoding::SECOND_OPERATION_INDEX
    return DwarfTestResult::V4_SECOND_ROW if v4_second.status != DebuggerNativeDwarfLine::Status.Found or v4_second.line != DwarfTestEncoding::THIRD_LINE or v4_second.operation_index != DwarfTestEncoding::NO_OPERATION_INDEX
    return DwarfTestResult::V4_SECOND_SEQUENCE if v4_second_sequence.status != DebuggerNativeDwarfLine::Status.Found or v4_second_sequence.line != DwarfTestEncoding::INITIAL_LINE or v4_second_sequence.operation_index != DwarfTestEncoding::NO_OPERATION_INDEX
    return DwarfTestResult::FILE_METADATA if v4_first.filename_length != DwarfTestEncoding::EXPECTED_FILENAME_LENGTH or v4_first.filename_truncated or v4_first.file_index != DwarfTestEncoding::FIRST_FILE_INDEX.u32() or v4_first.directory_index != DwarfTestEncoding::NO_DIRECTORY_INDEX_VALUE or v4_first.filename[DwarfTestOffset::FIRST] != DwarfTestCharacter::LOWER_A or v4_first.filename[DwarfTestOffset::SECOND] != DwarfTestCharacter::PERIOD
    return DwarfTestResult::FILE_INDEX if DebuggerNativeDwarfLineFormat::dwarf_line_file_info(v4_bytes[DwarfTestOffset::FIRST], v4_fixture.length, v4_unit, DwarfTestEncoding::INVALID_FILE_INDEX).valid

    bad_directory: mutable u8[DwarfTestCapacity::SECTION_BYTES] = v4_bytes
    bad_directory[v4_fixture.directory_index_offset] <- DwarfTestEncoding::INVALID_DIRECTORY_INDEX
    invalid_directory_unit: DebuggerNativeDwarfLineFormat::Unit = DebuggerNativeDwarfLineFormat::dwarf_line_parse_unit(bad_directory[DwarfTestOffset::FIRST], v4_fixture.length, DwarfTestOffset::FIRST)
    return DwarfTestResult::INVALID_DIRECTORY if invalid_directory_unit.status != DebuggerNativeDwarfLineFormat::UnitStatus.Invalid

    bad_version: mutable u8[DwarfTestCapacity::SECTION_BYTES] = v4_bytes
    bad_version[v4_fixture.version_offset] <- DwarfTestEncoding::UNSUPPORTED_DWARF_VERSION.u8()
    unsupported_version: DebuggerNativeDwarfLineFormat::Unit = DebuggerNativeDwarfLineFormat::dwarf_line_parse_unit(bad_version[DwarfTestOffset::FIRST], v4_fixture.length, DwarfTestOffset::FIRST)
    return DwarfTestResult::UNSUPPORTED_VERSION if unsupported_version.status != DebuggerNativeDwarfLineFormat::UnitStatus.UnsupportedVersion
    return DwarfTestResult::UNSUPPORTED_FORMAT if DebuggerNativeDwarfLineFormat::dwarf_line_parse_unit(integer_bytes[DwarfTestOffset::FIRST], DwarfTestCapacity::WORD_BYTES, DwarfTestOffset::FIRST).status != DebuggerNativeDwarfLineFormat::UnitStatus.Invalid
    integer_bytes[DwarfTestOffset::FIRST] <- DwarfTestInteger::DWARF64_MARKER_BYTE
    integer_bytes[DwarfTestOffset::SECOND] <- DwarfTestInteger::DWARF64_MARKER_BYTE
    integer_bytes[DwarfTestOffset::THIRD] <- DwarfTestInteger::DWARF64_MARKER_BYTE
    integer_bytes[DwarfTestOffset::FOURTH] <- DwarfTestInteger::DWARF64_MARKER_BYTE
    return DwarfTestResult::UNSUPPORTED_FORMAT if DebuggerNativeDwarfLineFormat::dwarf_line_parse_unit(integer_bytes[DwarfTestOffset::FIRST], DwarfTestCapacity::WORD_BYTES, DwarfTestOffset::FIRST).status != DebuggerNativeDwarfLineFormat::UnitStatus.UnsupportedFormat
    return DwarfTestResult::ADDRESS_WIDTH if DebuggerNativeDwarfLine::dwarf_line_lookup(v4_bytes[DwarfTestOffset::FIRST], v4_fixture.length, DwarfTestEncoding::UNSUPPORTED_ADDRESS_WIDTH, DwarfTestEncoding::ZERO_ADDRESS).status != DebuggerNativeDwarfLine::Status.UnsupportedAddressSize

    underflow_bytes: mutable u8[DwarfTestCapacity::SECTION_BYTES] = zeroed
    underflow_fixture: DwarfFixture = build_fixture(underflow_bytes[DwarfTestOffset::FIRST], DwarfTestEncoding::DWARF_V3, DwarfTestEncoding::DEFAULT_MAX_OPERATIONS, true, false)
    underflow_result: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(underflow_bytes[DwarfTestOffset::FIRST], underflow_fixture.length, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::START_ADDRESS.u64())
    return DwarfTestResult::LINE_UNDERFLOW if underflow_result.status != DebuggerNativeDwarfLine::Status.Invalid

    jump_bytes: mutable u8[DwarfTestCapacity::SECTION_BYTES] = zeroed
    jump_fixture: DwarfFixture = build_fixture(jump_bytes[DwarfTestOffset::FIRST], DwarfTestEncoding::DWARF_V4, DwarfTestEncoding::DEFAULT_MAX_OPERATIONS, false, true)
    jump_previous_row: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(jump_bytes[DwarfTestOffset::FIRST], jump_fixture.length, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::START_ADDRESS.u64())
    jump_next_row: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(jump_bytes[DwarfTestOffset::FIRST], jump_fixture.length, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::SOURCE_ADDRESS_JUMP.u64())
    return DwarfTestResult::SET_ADDRESS_JUMP if jump_previous_row.status != DebuggerNativeDwarfLine::Status.Found or jump_previous_row.line != DwarfTestEncoding::INITIAL_LINE or jump_next_row.status != DebuggerNativeDwarfLine::Status.Found or jump_next_row.line != DwarfTestEncoding::SECOND_LINE

    # Captured from the compiler's DWARF v4 __debug_line output.
    compiler_table: mutable u8[DwarfTestCapacity::COMPILER_TABLE_BYTES] = [62, 0, 0, 0, 4, 0, 36, 0, 0, 0, 1, 1, 1, 251, 14, 13, 0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1, 0, 115, 116, 97, 103, 101, 49, 46, 101, 108, 105, 115, 97, 0, 0, 0, 0, 0, 5, 5, 10, 0, 9, 2, 0, 0, 0, 0, 0, 0, 0, 0, 20, 2, 12, 0, 1, 1]
    compiler_row: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(compiler_table[DwarfTestOffset::FIRST], DwarfTestCapacity::COMPILER_TABLE_BYTES, DwarfTestEncoding::ADDRESS_WIDTH_64, DwarfTestEncoding::ZERO_ADDRESS)
    return DwarfTestResult::ACTUAL_ELISA_TABLE if compiler_row.status != DebuggerNativeDwarfLine::Status.Found
    return DwarfTestResult::ACTUAL_ELISA_LINE if compiler_row.line != DwarfTestCompilerArtifact::EXPECTED_LINE
    return DwarfTestResult::ACTUAL_ELISA_COLUMN if compiler_row.column != DwarfTestCompilerArtifact::EXPECTED_COLUMN
    return DwarfTestResult::ACTUAL_ELISA_FILENAME if compiler_row.filename_length != DwarfTestCompilerArtifact::EXPECTED_FILENAME_LENGTH
    return DwarfTestResult::ACTUAL_ELISA_FILENAME_BYTES if compiler_row.filename[DwarfTestCompilerArtifact::PERIOD_INDEX] != DwarfTestCharacter::PERIOD or compiler_row.filename[DwarfTestCompilerArtifact::LAST_FILENAME_INDEX] != DwarfTestCharacter::LOWER_A
    compiler_end: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(compiler_table[DwarfTestOffset::FIRST], DwarfTestCapacity::COMPILER_TABLE_BYTES, DwarfTestEncoding::ADDRESS_WIDTH_64, DwarfTestCompilerArtifact::SEQUENCE_END_ADDRESS)
    return DwarfTestResult::ACTUAL_ELISA_END if compiler_end.status != DebuggerNativeDwarfLine::Status.NotFound

    malformed_tail: mutable u8[DwarfTestCapacity::SECTION_BYTES] = v2_bytes
    tail_cursor: mutable usize = v2_fixture.length
    put_u32(malformed_tail[DwarfTestOffset::FIRST], tail_cursor, DwarfTestEncoding::ZERO_LENGTH)
    malformed_lookup: DebuggerNativeDwarfLine::Lookup = DebuggerNativeDwarfLine::dwarf_line_lookup(malformed_tail[DwarfTestOffset::FIRST], tail_cursor, DwarfTestEncoding::ADDRESS_WIDTH, DwarfTestEncoding::START_ADDRESS.u64())
    return DwarfTestResult::TRAILING_MALFORMED_UNIT if malformed_lookup.status != DebuggerNativeDwarfLine::Status.Invalid
    return DwarfTestResult::PASS
