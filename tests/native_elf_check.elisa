include "../src/native/elf.elisa"

const ELF_BYTES: usize = 64

def main() -> i64:
    image: mutable u8[ELF_BYTES] = zeroed
    image[0] <- 127
    image[1] <- 69
    image[2] <- 76
    image[3] <- 70
    image[4] <- 2
    image[5] <- 1
    image[6] <- 1
    image[52] <- 64
    image[16] <- 2
    image[18] <- 62
    header: DebuggerNativeElf::ElfHeader = DebuggerNativeElf::elf_parse(image[0], ELF_BYTES)
    return 1 if not header.valid or not header.executable or header.machine != DebuggerNativeElf::ElfMachine.X86_64 or not DebuggerNativeElf::elf_machine_is_supported(header)
    image[0] <- 0
    return 2 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[0] <- 127
    image[4] <- 1
    return 3 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[4] <- 2
    image[6] <- 2
    return 6 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[6] <- 1
    image[4] <- 2
    image[32] <- 64
    image[54] <- 1
    image[56] <- 1
    return 5 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[54] <- 0
    return 7 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    return 4 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES - 1).valid
    return 0
