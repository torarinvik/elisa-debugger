include "../src/native/elf.elisa"

const ELF_BYTES: usize = 320
const ELF_HEADER_BYTES: usize = 64
const ELF_PROGRAM_ENTRY_BYTES: usize = 56
const ELF_SECTION_OFFSET: usize = 120
const ELF_SECTION_ENTRY_BYTES: usize = 64
const ELF_SYMBOL_OFFSET: usize = 256
const ELF_SYMBOL_ENTRY_BYTES: usize = 24
const ELF_STRING_OFFSET: usize = 280

def put_u32(bytes: mutable u8&, offset: usize, value: u32) -> void:
    bytes[offset] <- value.u8()
    bytes[offset + 1] <- (value >> 8).u8()
    bytes[offset + 2] <- (value >> 16).u8()
    bytes[offset + 3] <- (value >> 24).u8()

def put_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
    for index in 0..<8:
        bytes[offset + index] <- (value >> (index.u64() * 8)).u8()

def main() -> i64:
    image: mutable u8[ELF_BYTES] = zeroed
    image[0] <- 127
    image[1] <- 69
    image[2] <- 76
    image[3] <- 70
    image[4] <- 2
    image[5] <- 1
    image[6] <- 1
    image[52] <- 64
    image[16] <- 2
    image[18] <- 62
    put_u64(image[0], 32, ELF_HEADER_BYTES.u64())
    image[54] <- ELF_PROGRAM_ENTRY_BYTES.u8()
    image[56] <- 1
    put_u32(image[0], ELF_HEADER_BYTES, 1)
    put_u32(image[0], ELF_HEADER_BYTES + 4, 5)
    put_u64(image[0], ELF_HEADER_BYTES + 16, 4096)
    put_u64(image[0], ELF_HEADER_BYTES + 32, 32)
    put_u64(image[0], ELF_HEADER_BYTES + 40, 48)
    put_u64(image[0], 40, ELF_SECTION_OFFSET.u64())
    image[58] <- ELF_SECTION_ENTRY_BYTES.u8()
    image[60] <- 2
    put_u32(image[0], ELF_SECTION_OFFSET, 7)
    put_u32(image[0], ELF_SECTION_OFFSET + 4, 2)
    put_u64(image[0], ELF_SECTION_OFFSET + 16, 8192)
    put_u64(image[0], ELF_SECTION_OFFSET + 24, ELF_SYMBOL_OFFSET.u64())
    put_u64(image[0], ELF_SECTION_OFFSET + 32, ELF_SYMBOL_ENTRY_BYTES.u64())
    put_u64(image[0], ELF_SECTION_OFFSET + 56, ELF_SYMBOL_ENTRY_BYTES.u64())
    put_u32(image[0], ELF_SECTION_OFFSET + 40, 1)
    put_u32(image[0], ELF_SECTION_OFFSET + 4, 2)
    put_u32(image[0], ELF_SECTION_OFFSET + 64 + 4, 3)
    put_u64(image[0], ELF_SECTION_OFFSET + 64 + 24, ELF_STRING_OFFSET.u64())
    put_u64(image[0], ELF_SECTION_OFFSET + 64 + 32, 5)
    put_u32(image[0], ELF_SYMBOL_OFFSET, 1)
    image[ELF_SYMBOL_OFFSET + 4] <- 18
    image[ELF_SYMBOL_OFFSET + 5] <- 0
    image[ELF_SYMBOL_OFFSET + 6] <- 1
    put_u64(image[0], ELF_SYMBOL_OFFSET + 8, 4096)
    put_u64(image[0], ELF_SYMBOL_OFFSET + 16, 32)
    header: DebuggerNativeElf::ElfHeader = DebuggerNativeElf::elf_parse(image[0], ELF_BYTES)
    return 1 if not header.valid or not header.executable or header.machine != DebuggerNativeElf::ElfMachine.X86_64 or not DebuggerNativeElf::elf_machine_is_supported(header)
    segment: DebuggerNativeElf::ElfProgramHeader = DebuggerNativeElf::elf_program_header(image[0], ELF_BYTES, header, 0)
    return 9 if not segment.valid or segment.kind != 1 or segment.flags != 5 or segment.virtual_address != 4096 or segment.file_size != 32 or segment.memory_size != 48
    return 10 if DebuggerNativeElf::elf_program_header(image[0], ELF_BYTES, header, 1).valid
    section: DebuggerNativeElf::ElfSectionHeader = DebuggerNativeElf::elf_section_header(image[0], ELF_BYTES, header, 0)
    return 13 if not section.valid
    return 18 if section.name != 7
    return 19 if section.kind != 2
    return 20 if section.address != 8192
    return 21 if section.offset != ELF_SYMBOL_OFFSET.u64()
    return 22 if section.size != ELF_SYMBOL_ENTRY_BYTES.u64()
    return 23 if section.entry_size != ELF_SYMBOL_ENTRY_BYTES.u64()
    string_section: DebuggerNativeElf::ElfSectionHeader = DebuggerNativeElf::elf_section_header(image[0], ELF_BYTES, header, 1)
    return 14 if not string_section.valid or string_section.kind != 3 or string_section.offset != ELF_STRING_OFFSET.u64() or string_section.size != 5
    return 27 if DebuggerNativeElf::elf_section_header(image[0], ELF_BYTES, header, 2).valid
    symbol: DebuggerNativeElf::ElfSymbol = DebuggerNativeElf::elf_symbol(image[0], ELF_BYTES, header, 0, 0)
    return 16 if not symbol.valid or symbol.name_offset != 1 or symbol.info != 18 or symbol.section_index != 1 or symbol.value != 4096 or symbol.size != 32
    return 17 if DebuggerNativeElf::elf_symbol(image[0], ELF_BYTES, header, 0, 1).valid
    image[ELF_STRING_OFFSET] <- 0
    image[ELF_STRING_OFFSET + 1] <- 102
    image[ELF_STRING_OFFSET + 2] <- 111
    image[ELF_STRING_OFFSET + 3] <- 111
    image[ELF_STRING_OFFSET + 4] <- 0
    symbol_name: DebuggerNativeElf::ElfSymbolName = DebuggerNativeElf::elf_symbol_name(image[0], ELF_BYTES, header, 0, 0)
    return 25 if not symbol_name.valid or symbol_name.truncated or symbol_name.length != 3 or symbol_name.bytes[0] != 102 or symbol_name.bytes[2] != 111
    return 26 if DebuggerNativeElf::elf_symbol_name(image[0], ELF_BYTES, header, 0, 1).valid
    put_u64(image[0], ELF_SECTION_OFFSET + 32, 25)
    return 24 if DebuggerNativeElf::elf_symbol(image[0], ELF_BYTES, header, 0, 0).valid
    put_u64(image[0], ELF_SECTION_OFFSET + 32, ELF_SYMBOL_ENTRY_BYTES.u64())
    put_u64(image[0], ELF_SECTION_OFFSET + 24, 319)
    put_u64(image[0], ELF_SECTION_OFFSET + 32, 8)
    return 15 if DebuggerNativeElf::elf_section_header(image[0], ELF_BYTES, header, 0).valid
    put_u64(image[0], ELF_SECTION_OFFSET + 24, ELF_SYMBOL_OFFSET.u64())
    put_u64(image[0], ELF_SECTION_OFFSET + 32, ELF_SYMBOL_ENTRY_BYTES.u64())
    put_u64(image[0], ELF_HEADER_BYTES + 8, 319)
    put_u64(image[0], ELF_HEADER_BYTES + 32, 2)
    return 11 if DebuggerNativeElf::elf_program_header(image[0], ELF_BYTES, header, 0).valid
    put_u64(image[0], ELF_HEADER_BYTES + 8, 0)
    put_u64(image[0], ELF_HEADER_BYTES + 32, 32)
    put_u64(image[0], ELF_HEADER_BYTES + 40, 16)
    return 12 if DebuggerNativeElf::elf_program_header(image[0], ELF_BYTES, header, 0).valid
    image[0] <- 0
    return 2 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[0] <- 127
    image[4] <- 1
    return 3 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[4] <- 2
    image[6] <- 2
    return 6 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[6] <- 1
    image[4] <- 2
    image[32] <- 64
    image[54] <- 1
    image[56] <- 1
    return 5 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[32] <- 0
    return 8 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    image[54] <- 0
    return 7 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES).valid
    return 4 if DebuggerNativeElf::elf_parse(image[0], ELF_BYTES - 1).valid
    return 0
