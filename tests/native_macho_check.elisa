include "../src/native/macho.elisa"


const module TestFixture:
    MACHO_BYTES: usize = 40
    UUID_IMAGE_BYTES: usize = 56
    SYMBOL_IMAGE_BYTES: usize = 80
    DSYM_IMAGE_BYTES: usize = 292

const module TestCommand:
    COMMAND_OFFSET: usize = 32
    COMMAND_KIND: u32 = 25
    COMMAND_SIZE: u32 = 8

const module TestUuid:
    UUID_COMMAND_BYTES: u32 = 24
    UUID_COMMAND_OFFSET: usize = 32

const module TestSymbolTable:
    SYMBOL_COMMAND_BYTES: u32 = 24
    SYMBOL_COMMAND_OFFSET: usize = 32
    SYMBOL_TABLE_OFFSET: u32 = 56
    SYMBOL_COUNT: u32 = 1
    SYMBOL_STRING_OFFSET: u32 = 72
    SYMBOL_STRING_SIZE: u32 = 8

const module TestCpu:
    MACHO_CPU_OFFSET: usize = 4
    MACHO_SUBTYPE_OFFSET: usize = 8
    MACHO_FILE_TYPE_OFFSET: usize = 12
    TEST_CPU_X86_64: u32 = 16777223
    TEST_CPU_ARM64: u32 = 16777228
    TEST_SUBTYPE_X86_64_ALL: u32 = 3
    TEST_SUBTYPE_ARM64_ALL: u32 = 0
    TEST_SUBTYPE_ARM64E: u32 = 2
    TEST_SUBTYPE_CAPABILITY_BITS: u32 = 2147483648


def put_u32(bytes: mutable u8&, offset: usize, value: u32) -> void:
    bytes[offset] <- value.u8()
    bytes[offset + 1] <- (value >> 8).u8()
    bytes[offset + 2] <- (value >> 16).u8()
    bytes[offset + 3] <- (value >> 24).u8()

def put_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
    for index in 0..<8:
        bytes[offset + index] <- (value >> (index.u64() * 8)).u8()

def main() -> i64:
    image: mutable u8[TestFixture::MACHO_BYTES] = zeroed
    image[0] <- 207
    image[1] <- 250
    image[2] <- 237
    image[3] <- 254
    put_u32(image[0], TestCpu::MACHO_CPU_OFFSET, TestCpu::TEST_CPU_ARM64)
    image[12] <- 2
    image[16] <- 1
    image[20] <- 8
    image[TestCommand::COMMAND_OFFSET] <- TestCommand::COMMAND_KIND.u8()
    image[36] <- 8
    header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES)
    return 1 if not header.valid or not header.executable or header.machine != DebuggerNativeMachO::MachOMachine.AArch64 or not DebuggerNativeMachO::macho_machine_is_supported(header)
    return 8 if not DebuggerNativeMachO::macho_commands_are_valid(header, image[0], TestFixture::MACHO_BYTES)
    command: DebuggerNativeMachO::MachOCommand = DebuggerNativeMachO::macho_command(header, image[0], TestFixture::MACHO_BYTES, 0)
    return 10 if not command.valid or command.kind != TestCommand::COMMAND_KIND or command.size != TestCommand::COMMAND_SIZE or command.offset != TestCommand::COMMAND_OFFSET
    return 11 if DebuggerNativeMachO::macho_command(header, image[0], TestFixture::MACHO_BYTES, 1).valid
    return 12 if DebuggerNativeMachO::macho_commands_are_valid(header, image[0], 31)
    return 13 if DebuggerNativeMachO::macho_command(header, image[0], 31, 0).valid
    put_u32(image[0], TestCpu::MACHO_SUBTYPE_OFFSET, TestCpu::TEST_SUBTYPE_ARM64E | TestCpu::TEST_SUBTYPE_CAPABILITY_BITS)
    arm64e_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES)
    return 21 if not arm64e_header.valid or arm64e_header.machine != DebuggerNativeMachO::MachOMachine.AArch64
    x86_image: mutable u8[TestFixture::MACHO_BYTES] = image
    put_u32(x86_image[0], TestCpu::MACHO_CPU_OFFSET, TestCpu::TEST_CPU_X86_64)
    put_u32(x86_image[0], TestCpu::MACHO_SUBTYPE_OFFSET, TestCpu::TEST_SUBTYPE_X86_64_ALL | TestCpu::TEST_SUBTYPE_CAPABILITY_BITS)
    x86_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(x86_image[0], TestFixture::MACHO_BYTES)
    return 22 if not x86_header.valid or x86_header.machine != DebuggerNativeMachO::MachOMachine.X86_64
    put_u32(image[0], TestCpu::MACHO_SUBTYPE_OFFSET, TestCpu::TEST_SUBTYPE_ARM64_ALL)
    uuid_image: mutable u8[TestFixture::UUID_IMAGE_BYTES] = zeroed
    uuid_image[0] <- 207
    uuid_image[1] <- 250
    uuid_image[2] <- 237
    uuid_image[3] <- 254
    put_u32(uuid_image[0], TestCpu::MACHO_CPU_OFFSET, TestCpu::TEST_CPU_ARM64)
    uuid_image[12] <- 2
    uuid_image[16] <- 1
    uuid_image[20] <- TestUuid::UUID_COMMAND_BYTES.u8()
    uuid_image[TestUuid::UUID_COMMAND_OFFSET] <- 27
    uuid_image[TestUuid::UUID_COMMAND_OFFSET + 4] <- TestUuid::UUID_COMMAND_BYTES.u8()
    uuid_image[TestUuid::UUID_COMMAND_OFFSET + 8] <- 42
    uuid_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(uuid_image[0], TestFixture::UUID_IMAGE_BYTES)
    uuid: DebuggerNativeMachO::MachOUuid = DebuggerNativeMachO::macho_uuid(uuid_header, uuid_image[0], TestFixture::UUID_IMAGE_BYTES)
    return 14 if not uuid.valid or uuid.bytes[0] != 42
    uuid_image[TestUuid::UUID_COMMAND_OFFSET + 4] <- 8
    malformed_uuid_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(uuid_image[0], TestFixture::UUID_IMAGE_BYTES)
    return 15 if DebuggerNativeMachO::macho_uuid(malformed_uuid_header, uuid_image[0], TestFixture::UUID_IMAGE_BYTES).valid
    symbol_image: mutable u8[TestFixture::SYMBOL_IMAGE_BYTES] = zeroed
    symbol_image[0] <- 207
    symbol_image[1] <- 250
    symbol_image[2] <- 237
    symbol_image[3] <- 254
    put_u32(symbol_image[0], TestCpu::MACHO_CPU_OFFSET, TestCpu::TEST_CPU_ARM64)
    symbol_image[12] <- 2
    symbol_image[16] <- 1
    symbol_image[20] <- TestSymbolTable::SYMBOL_COMMAND_BYTES.u8()
    symbol_image[TestSymbolTable::SYMBOL_COMMAND_OFFSET] <- 2
    symbol_image[TestSymbolTable::SYMBOL_COMMAND_OFFSET + 4] <- TestSymbolTable::SYMBOL_COMMAND_BYTES.u8()
    put_u32(symbol_image[0], TestSymbolTable::SYMBOL_COMMAND_OFFSET + 8, TestSymbolTable::SYMBOL_TABLE_OFFSET)
    put_u32(symbol_image[0], TestSymbolTable::SYMBOL_COMMAND_OFFSET + 12, TestSymbolTable::SYMBOL_COUNT)
    put_u32(symbol_image[0], TestSymbolTable::SYMBOL_COMMAND_OFFSET + 16, TestSymbolTable::SYMBOL_STRING_OFFSET)
    put_u32(symbol_image[0], TestSymbolTable::SYMBOL_COMMAND_OFFSET + 20, TestSymbolTable::SYMBOL_STRING_SIZE)
    put_u32(symbol_image[0], TestSymbolTable::SYMBOL_TABLE_OFFSET.usize(), 1)
    symbol_image[TestSymbolTable::SYMBOL_TABLE_OFFSET.usize() + 4] <- 15
    symbol_image[TestSymbolTable::SYMBOL_TABLE_OFFSET.usize() + 5] <- 1
    put_u64(symbol_image[0], TestSymbolTable::SYMBOL_TABLE_OFFSET.usize() + 8, 8192)
    symbol_image[TestSymbolTable::SYMBOL_STRING_OFFSET.usize()] <- 0
    symbol_image[TestSymbolTable::SYMBOL_STRING_OFFSET.usize() + 1] <- 102
    symbol_image[TestSymbolTable::SYMBOL_STRING_OFFSET.usize() + 2] <- 111
    symbol_image[TestSymbolTable::SYMBOL_STRING_OFFSET.usize() + 3] <- 111
    symbol_image[TestSymbolTable::SYMBOL_STRING_OFFSET.usize() + 4] <- 0
    symbol_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(symbol_image[0], TestFixture::SYMBOL_IMAGE_BYTES)
    symbol: DebuggerNativeMachO::MachOSymbol = DebuggerNativeMachO::macho_symbol(symbol_header, symbol_image[0], TestFixture::SYMBOL_IMAGE_BYTES, 0)
    return 16 if not symbol.valid or symbol.name_offset != 1 or symbol.symbol_type != 15 or symbol.section != 1 or symbol.value != 8192
    return 17 if DebuggerNativeMachO::macho_symbol(symbol_header, symbol_image[0], TestFixture::SYMBOL_IMAGE_BYTES, 1).valid
    symbol_name: DebuggerNativeMachO::MachOSymbolName = DebuggerNativeMachO::macho_symbol_name(symbol_header, symbol_image[0], TestFixture::SYMBOL_IMAGE_BYTES, 0)
    return 18 if not symbol_name.valid or symbol_name.truncated or symbol_name.length != 3 or symbol_name.bytes[0] != 102 or symbol_name.bytes[2] != 111
    put_u32(symbol_image[0], TestSymbolTable::SYMBOL_TABLE_OFFSET.usize(), 0)
    empty_symbol_name: DebuggerNativeMachO::MachOSymbolName = DebuggerNativeMachO::macho_symbol_name(symbol_header, symbol_image[0], TestFixture::SYMBOL_IMAGE_BYTES, 0)
    return 20 if not empty_symbol_name.valid or empty_symbol_name.length != 0
    put_u32(symbol_image[0], TestSymbolTable::SYMBOL_TABLE_OFFSET.usize(), 1)
    symbol_image[TestSymbolTable::SYMBOL_TABLE_OFFSET.usize()] <- 8
    return 19 if DebuggerNativeMachO::macho_symbol_name(symbol_header, symbol_image[0], TestFixture::SYMBOL_IMAGE_BYTES, 0).valid
    dsym_image: mutable u8[TestFixture::DSYM_IMAGE_BYTES] = zeroed
    dsym_image[0] <- 207
    dsym_image[1] <- 250
    dsym_image[2] <- 237
    dsym_image[3] <- 254
    put_u32(dsym_image[0], TestCpu::MACHO_CPU_OFFSET, TestCpu::TEST_CPU_ARM64)
    put_u32(dsym_image[0], TestCpu::MACHO_FILE_TYPE_OFFSET, 10)
    put_u32(dsym_image[0], 16, 2)
    put_u32(dsym_image[0], 20, 256)
    put_u32(dsym_image[0], 32, 27)
    put_u32(dsym_image[0], 36, 24)
    dsym_image[40] <- 55
    put_u32(dsym_image[0], 56, 25)
    put_u32(dsym_image[0], 60, 232)
    dsym_image[64] <- 95
    dsym_image[65] <- 95
    dsym_image[66] <- 68
    dsym_image[67] <- 87
    dsym_image[68] <- 65
    dsym_image[69] <- 82
    dsym_image[70] <- 70
    put_u32(dsym_image[0], 120, 2)
    dsym_image[128] <- 95
    dsym_image[129] <- 95
    dsym_image[130] <- 100
    dsym_image[131] <- 101
    dsym_image[132] <- 98
    dsym_image[133] <- 117
    dsym_image[134] <- 103
    dsym_image[135] <- 95
    dsym_image[136] <- 108
    dsym_image[137] <- 105
    dsym_image[138] <- 110
    dsym_image[139] <- 101
    dsym_image[144] <- 95
    dsym_image[145] <- 95
    dsym_image[146] <- 68
    dsym_image[147] <- 87
    dsym_image[148] <- 65
    dsym_image[149] <- 82
    dsym_image[150] <- 70
    put_u64(dsym_image[0], 160, 4096)
    put_u64(dsym_image[0], 168, 4)
    put_u32(dsym_image[0], 176, 288)
    dsym_image[208] <- 95
    dsym_image[209] <- 95
    dsym_image[210] <- 100
    dsym_image[211] <- 101
    dsym_image[212] <- 98
    dsym_image[213] <- 117
    dsym_image[214] <- 103
    dsym_image[215] <- 95
    dsym_image[216] <- 105
    dsym_image[217] <- 110
    dsym_image[218] <- 102
    dsym_image[219] <- 111
    dsym_image[224] <- 95
    dsym_image[225] <- 95
    dsym_image[226] <- 68
    dsym_image[227] <- 87
    dsym_image[228] <- 65
    dsym_image[229] <- 82
    dsym_image[230] <- 70
    put_u64(dsym_image[0], 240, 4100)
    put_u64(dsym_image[0], 248, 4)
    put_u32(dsym_image[0], 256, 288)
    dsym_image[288] <- 1
    dsym_image[289] <- 2
    dsym_image[290] <- 3
    dsym_image[291] <- 4
    dsym_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(dsym_image[0], TestFixture::DSYM_IMAGE_BYTES)
    return 23 if not dsym_header.valid or dsym_header.executable or not dsym_header.debug_symbols
    dsym_uuid: DebuggerNativeMachO::MachOUuid = DebuggerNativeMachO::macho_uuid(dsym_header, dsym_image[0], TestFixture::DSYM_IMAGE_BYTES)
    return 24 if not dsym_uuid.valid or dsym_uuid.bytes[0] != 55
    expected_section: mutable u8[12] = [95, 95, 100, 101, 98, 117, 103, 95, 108, 105, 110, 101]
    debug_line: DebuggerNativeMachO::MachOSection = DebuggerNativeMachO::macho_find_section(dsym_header, dsym_image[0], TestFixture::DSYM_IMAGE_BYTES, expected_section[0], 12)
    return 25 if not debug_line.valid or not debug_line.file_backed or debug_line.address != 4096 or debug_line.size != 4 or debug_line.file_offset != 288
    return 26 if DebuggerNativeMachO::macho_section(dsym_header, dsym_image[0], TestFixture::DSYM_IMAGE_BYTES, 2).valid
    put_u32(dsym_image[0], 256, 290)
    return 30 if DebuggerNativeMachO::macho_find_section(dsym_header, dsym_image[0], TestFixture::DSYM_IMAGE_BYTES, expected_section[0], 12).valid
    put_u32(dsym_image[0], 256, 288)
    truncated_line: DebuggerNativeMachO::MachOSection = DebuggerNativeMachO::macho_find_section(dsym_header, dsym_image[0], 291, expected_section[0], 12)
    return 27 if truncated_line.valid
    put_u32(dsym_image[0], 120, 3)
    return 28 if DebuggerNativeMachO::macho_find_section(dsym_header, dsym_image[0], TestFixture::DSYM_IMAGE_BYTES, expected_section[0], 12).valid
    put_u32(dsym_image[0], 120, 2)
    put_u32(dsym_image[0], 192, 1)
    put_u64(dsym_image[0], 168, 8192)
    put_u32(dsym_image[0], 176, 0)
    zero_fill_line: DebuggerNativeMachO::MachOSection = DebuggerNativeMachO::macho_find_section(dsym_header, dsym_image[0], TestFixture::DSYM_IMAGE_BYTES, expected_section[0], 12)
    return 29 if not zero_fill_line.valid or zero_fill_line.file_backed
    image[36] <- 4
    return 9 if DebuggerNativeMachO::macho_commands_are_valid(header, image[0], TestFixture::MACHO_BYTES)
    image[36] <- 8
    image[8] <- 1
    return 5 if DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES).valid
    image[8] <- 0
    image[20] <- 9
    return 2 if DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES).valid
    image[20] <- 8
    image[16] <- 0
    return 5 if DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES).valid
    image[16] <- 1
    image[20] <- 0
    return 6 if DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES).valid
    image[20] <- 8
    image[12] <- 6
    return 3 if DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES).executable
    image[12] <- 2
    image[28] <- 1
    return 7 if DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES).valid
    image[0] <- 0
    return 4 if DebuggerNativeMachO::macho_parse(image[0], TestFixture::MACHO_BYTES).valid
    return 0
