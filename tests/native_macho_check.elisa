include "../src/native/macho.elisa"

const MACHO_BYTES: usize = 40
const COMMAND_OFFSET: usize = 32
const COMMAND_KIND: u32 = 25
const COMMAND_SIZE: u32 = 8
const UUID_IMAGE_BYTES: usize = 56
const UUID_COMMAND_BYTES: u32 = 24
const UUID_COMMAND_OFFSET: usize = 32
const SYMBOL_IMAGE_BYTES: usize = 80
const SYMBOL_COMMAND_BYTES: u32 = 24
const SYMBOL_COMMAND_OFFSET: usize = 32
const SYMBOL_TABLE_OFFSET: u32 = 56
const SYMBOL_COUNT: u32 = 1
const SYMBOL_STRING_OFFSET: u32 = 72
const SYMBOL_STRING_SIZE: u32 = 8

def put_u32(bytes: mutable u8&, offset: usize, value: u32) -> void:
    bytes[offset] <- value.u8()
    bytes[offset + 1] <- (value >> 8).u8()
    bytes[offset + 2] <- (value >> 16).u8()
    bytes[offset + 3] <- (value >> 24).u8()

def put_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
    for index in 0..<8:
        bytes[offset + index] <- (value >> (index.u64() * 8)).u8()

def main() -> i64:
    image: mutable u8[MACHO_BYTES] = zeroed
    image[0] <- 207
    image[1] <- 250
    image[2] <- 237
    image[3] <- 254
    image[4] <- 12
    image[7] <- 1
    image[12] <- 2
    image[16] <- 1
    image[20] <- 8
    image[COMMAND_OFFSET] <- COMMAND_KIND.u8()
    image[36] <- 8
    header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(image[0], MACHO_BYTES)
    return 1 if not header.valid or not header.executable or header.machine != DebuggerNativeMachO::MachOMachine.AArch64 or not DebuggerNativeMachO::macho_machine_is_supported(header)
    return 8 if not DebuggerNativeMachO::macho_commands_are_valid(header, image[0], MACHO_BYTES)
    command: DebuggerNativeMachO::MachOCommand = DebuggerNativeMachO::macho_command(header, image[0], MACHO_BYTES, 0)
    return 10 if not command.valid or command.kind != COMMAND_KIND or command.size != COMMAND_SIZE or command.offset != COMMAND_OFFSET
    return 11 if DebuggerNativeMachO::macho_command(header, image[0], MACHO_BYTES, 1).valid
    return 12 if DebuggerNativeMachO::macho_commands_are_valid(header, image[0], 31)
    return 13 if DebuggerNativeMachO::macho_command(header, image[0], 31, 0).valid
    uuid_image: mutable u8[UUID_IMAGE_BYTES] = zeroed
    uuid_image[0] <- 207
    uuid_image[1] <- 250
    uuid_image[2] <- 237
    uuid_image[3] <- 254
    uuid_image[4] <- 12
    uuid_image[7] <- 1
    uuid_image[12] <- 2
    uuid_image[16] <- 1
    uuid_image[20] <- UUID_COMMAND_BYTES.u8()
    uuid_image[UUID_COMMAND_OFFSET] <- 27
    uuid_image[UUID_COMMAND_OFFSET + 4] <- UUID_COMMAND_BYTES.u8()
    uuid_image[UUID_COMMAND_OFFSET + 8] <- 42
    uuid_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(uuid_image[0], UUID_IMAGE_BYTES)
    uuid: DebuggerNativeMachO::MachOUuid = DebuggerNativeMachO::macho_uuid(uuid_header, uuid_image[0], UUID_IMAGE_BYTES)
    return 14 if not uuid.valid or uuid.bytes[0] != 42
    uuid_image[UUID_COMMAND_OFFSET + 4] <- 8
    malformed_uuid_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(uuid_image[0], UUID_IMAGE_BYTES)
    return 15 if DebuggerNativeMachO::macho_uuid(malformed_uuid_header, uuid_image[0], UUID_IMAGE_BYTES).valid
    symbol_image: mutable u8[SYMBOL_IMAGE_BYTES] = zeroed
    symbol_image[0] <- 207
    symbol_image[1] <- 250
    symbol_image[2] <- 237
    symbol_image[3] <- 254
    symbol_image[4] <- 12
    symbol_image[7] <- 1
    symbol_image[12] <- 2
    symbol_image[16] <- 1
    symbol_image[20] <- SYMBOL_COMMAND_BYTES.u8()
    symbol_image[SYMBOL_COMMAND_OFFSET] <- 2
    symbol_image[SYMBOL_COMMAND_OFFSET + 4] <- SYMBOL_COMMAND_BYTES.u8()
    put_u32(symbol_image[0], SYMBOL_COMMAND_OFFSET + 8, SYMBOL_TABLE_OFFSET)
    put_u32(symbol_image[0], SYMBOL_COMMAND_OFFSET + 12, SYMBOL_COUNT)
    put_u32(symbol_image[0], SYMBOL_COMMAND_OFFSET + 16, SYMBOL_STRING_OFFSET)
    put_u32(symbol_image[0], SYMBOL_COMMAND_OFFSET + 20, SYMBOL_STRING_SIZE)
    put_u32(symbol_image[0], SYMBOL_TABLE_OFFSET.usize(), 1)
    symbol_image[SYMBOL_TABLE_OFFSET.usize() + 4] <- 15
    symbol_image[SYMBOL_TABLE_OFFSET.usize() + 5] <- 1
    put_u64(symbol_image[0], SYMBOL_TABLE_OFFSET.usize() + 8, 8192)
    symbol_image[SYMBOL_STRING_OFFSET.usize()] <- 0
    symbol_image[SYMBOL_STRING_OFFSET.usize() + 1] <- 102
    symbol_image[SYMBOL_STRING_OFFSET.usize() + 2] <- 111
    symbol_image[SYMBOL_STRING_OFFSET.usize() + 3] <- 111
    symbol_image[SYMBOL_STRING_OFFSET.usize() + 4] <- 0
    symbol_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(symbol_image[0], SYMBOL_IMAGE_BYTES)
    symbol: DebuggerNativeMachO::MachOSymbol = DebuggerNativeMachO::macho_symbol(symbol_header, symbol_image[0], SYMBOL_IMAGE_BYTES, 0)
    return 16 if not symbol.valid or symbol.name_offset != 1 or symbol.symbol_type != 15 or symbol.section != 1 or symbol.value != 8192
    return 17 if DebuggerNativeMachO::macho_symbol(symbol_header, symbol_image[0], SYMBOL_IMAGE_BYTES, 1).valid
    symbol_name: DebuggerNativeMachO::MachOSymbolName = DebuggerNativeMachO::macho_symbol_name(symbol_header, symbol_image[0], SYMBOL_IMAGE_BYTES, 0)
    return 18 if not symbol_name.valid or symbol_name.truncated or symbol_name.length != 3 or symbol_name.bytes[0] != 102 or symbol_name.bytes[2] != 111
    put_u32(symbol_image[0], SYMBOL_TABLE_OFFSET.usize(), 0)
    empty_symbol_name: DebuggerNativeMachO::MachOSymbolName = DebuggerNativeMachO::macho_symbol_name(symbol_header, symbol_image[0], SYMBOL_IMAGE_BYTES, 0)
    return 20 if not empty_symbol_name.valid or empty_symbol_name.length != 0
    put_u32(symbol_image[0], SYMBOL_TABLE_OFFSET.usize(), 1)
    symbol_image[SYMBOL_TABLE_OFFSET.usize()] <- 8
    return 19 if DebuggerNativeMachO::macho_symbol_name(symbol_header, symbol_image[0], SYMBOL_IMAGE_BYTES, 0).valid
    image[36] <- 4
    return 9 if DebuggerNativeMachO::macho_commands_are_valid(header, image[0], MACHO_BYTES)
    image[36] <- 8
    image[8] <- 1
    return 5 if DebuggerNativeMachO::macho_parse(image[0], MACHO_BYTES).valid
    image[8] <- 0
    image[20] <- 9
    return 2 if DebuggerNativeMachO::macho_parse(image[0], MACHO_BYTES).valid
    image[20] <- 8
    image[16] <- 0
    return 5 if DebuggerNativeMachO::macho_parse(image[0], MACHO_BYTES).valid
    image[16] <- 1
    image[20] <- 0
    return 6 if DebuggerNativeMachO::macho_parse(image[0], MACHO_BYTES).valid
    image[20] <- 8
    image[12] <- 6
    return 3 if DebuggerNativeMachO::macho_parse(image[0], MACHO_BYTES).executable
    image[12] <- 2
    image[28] <- 1
    return 7 if DebuggerNativeMachO::macho_parse(image[0], MACHO_BYTES).valid
    image[0] <- 0
    return 4 if DebuggerNativeMachO::macho_parse(image[0], MACHO_BYTES).valid
    return 0
