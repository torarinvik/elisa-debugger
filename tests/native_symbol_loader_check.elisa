include "../src/native/symbol_loader.elisa"


const module TestName:
    NAME_CAPACITY: usize = 64
    SYMBOL_NAME_LENGTH: usize = 3
    NAME_F: u8 = 102
    NAME_O: u8 = 111
    NAME_B: u8 = 98
    NAME_A: u8 = 97
    OVER_CAPACITY_SYMBOL_NAME_LENGTH: usize = TestName::NAME_CAPACITY + 1
    OVER_CAPACITY_SYMBOL_NAME_OFFSET: usize = 1
    SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET: usize = TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_LENGTH + 1
    SYMBOL_STRING_TABLE_LENGTH: usize = TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET + TestName::SYMBOL_NAME_LENGTH + 1

const module TestElf:
    ELF_SECTION_TABLE_OFFSET: usize = 64
    ELF_SYMBOL_TABLE_OFFSET: usize = 256
    ELF_STRING_TABLE_OFFSET: usize = 352
    ELF_FIXTURE_BYTES: usize = TestElf::ELF_STRING_TABLE_OFFSET + TestName::SYMBOL_STRING_TABLE_LENGTH

const module TestMachO:
    MACHO_SYMBOL_TABLE_OFFSET: usize = 56
    MACHO_STRING_TABLE_OFFSET: usize = 136
    MACHO_FIXTURE_BYTES: usize = TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::SYMBOL_STRING_TABLE_LENGTH


def put_u32(bytes: mutable u8&, offset: usize, value: u32) -> void:
    bytes[offset] <- value.u8()
    bytes[offset + 1] <- (value >> 8).u8()
    bytes[offset + 2] <- (value >> 16).u8()
    bytes[offset + 3] <- (value >> 24).u8()

def put_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
    for index in 0..<8:
        bytes[offset + index] <- (value >> (index.u64() * 8)).u8()

def main() -> i64:
    elf_name: mutable DebuggerNativeElf::ElfSymbolName = zeroed
    elf_name.valid <- true
    elf_name.length <- TestName::SYMBOL_NAME_LENGTH
    elf_name.bytes[0] <- TestName::NAME_F
    elf_name.bytes[1] <- TestName::NAME_O
    elf_name.bytes[2] <- TestName::NAME_B
    elf_symbol: DebuggerNativeElf::ElfSymbol = DebuggerNativeElf::ElfSymbol{valid: true, name_offset: 1, info: 0, other: 0, section_index: 1, value: 4096, size: 16}
    table: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(table)
    _ = DebuggerNativeSymbolLoader::add_elf_symbol(table, elf_symbol, elf_name, zeroed)
    return 1 if table.count != 1 or table.symbols[0].address != 4096 or table.symbols[0].size != 16 or table.symbols[0].name.value == 0
    second_symbol: DebuggerNativeElf::ElfSymbol = elf_symbol
    second_symbol.value <- 8192
    _ = DebuggerNativeSymbolLoader::add_elf_symbol(table, second_symbol, elf_name, zeroed)
    return 2 if table.count != 2
    undefined_elf_symbol: mutable DebuggerNativeElf::ElfSymbol = elf_symbol
    undefined_elf_symbol.section_index <- 0
    invalid_elf_table: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(invalid_elf_table)
    invalid_elf_accepted: bool = DebuggerNativeSymbolLoader::add_elf_symbol(invalid_elf_table, undefined_elf_symbol, elf_name, zeroed)
    return 13 if invalid_elf_accepted or invalid_elf_table.count != 0
    unnamed: mutable DebuggerNativeElf::ElfSymbolName = elf_name
    unnamed.length <- 0
    unnamed_elf_accepted: bool = DebuggerNativeSymbolLoader::add_elf_symbol(table, elf_symbol, unnamed, zeroed)
    return 3 if unnamed_elf_accepted or table.count != 2
    macho_name: mutable DebuggerNativeMachO::MachOSymbolName = zeroed
    macho_name.valid <- true
    macho_name.length <- TestName::SYMBOL_NAME_LENGTH
    macho_name.bytes[0] <- TestName::NAME_F
    macho_name.bytes[1] <- TestName::NAME_O
    macho_name.bytes[2] <- TestName::NAME_B
    macho_symbol: DebuggerNativeMachO::MachOSymbol = DebuggerNativeMachO::MachOSymbol{valid: true, name_offset: 1, symbol_type: 15, section: 1, description: 0, value: 12288}
    _ = DebuggerNativeSymbolLoader::add_macho_symbol(table, macho_symbol, macho_name, 8, zeroed)
    return 4 if table.count != 3 or table.symbols[2].address != 12288 or table.symbols[2].size != 8
    invalid_macho_table: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(invalid_macho_table)
    invalid_macho_accepted: bool = DebuggerNativeSymbolLoader::add_macho_symbol(invalid_macho_table, macho_symbol, macho_name, 0, zeroed)
    return 14 if invalid_macho_accepted or invalid_macho_table.count != 0
    undefined_macho_symbol: mutable DebuggerNativeMachO::MachOSymbol = macho_symbol
    undefined_macho_symbol.symbol_type <- 1
    undefined_macho_table: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(undefined_macho_table)
    undefined_macho_accepted: bool = DebuggerNativeSymbolLoader::add_macho_symbol(undefined_macho_table, undefined_macho_symbol, macho_name, 8, zeroed)
    return 15 if undefined_macho_accepted or undefined_macho_table.count != 0

    elf_image: mutable u8[TestElf::ELF_FIXTURE_BYTES] = zeroed
    elf_image[0] <- 127
    elf_image[1] <- 69
    elf_image[2] <- 76
    elf_image[3] <- 70
    elf_image[4] <- 2
    elf_image[5] <- 1
    elf_image[6] <- 1
    elf_image[16] <- 2
    elf_image[18] <- 62
    elf_image[52] <- 64
    put_u64(elf_image[0], 40, TestElf::ELF_SECTION_TABLE_OFFSET.u64())
    elf_image[58] <- 64
    elf_image[60] <- 3
    put_u32(elf_image[0], TestElf::ELF_SECTION_TABLE_OFFSET + 64 + 4, 2)
    put_u64(elf_image[0], TestElf::ELF_SECTION_TABLE_OFFSET + 64 + 24, TestElf::ELF_SYMBOL_TABLE_OFFSET.u64())
    put_u64(elf_image[0], TestElf::ELF_SECTION_TABLE_OFFSET + 64 + 32, 96)
    put_u32(elf_image[0], TestElf::ELF_SECTION_TABLE_OFFSET + 64 + 40, 2)
    put_u64(elf_image[0], TestElf::ELF_SECTION_TABLE_OFFSET + 64 + 56, 24)
    put_u32(elf_image[0], TestElf::ELF_SECTION_TABLE_OFFSET + 128 + 4, 3)
    put_u64(elf_image[0], TestElf::ELF_SECTION_TABLE_OFFSET + 128 + 24, TestElf::ELF_STRING_TABLE_OFFSET.u64())
    put_u64(elf_image[0], TestElf::ELF_SECTION_TABLE_OFFSET + 128 + 32, TestName::SYMBOL_STRING_TABLE_LENGTH.u64())
    put_u32(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 24, 1)
    elf_image[TestElf::ELF_SYMBOL_TABLE_OFFSET + 24 + 4] <- 18
    elf_image[TestElf::ELF_SYMBOL_TABLE_OFFSET + 24 + 6] <- 1
    put_u64(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 24 + 8, 4096)
    put_u64(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 24 + 16, 16)
    put_u32(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 48, TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET.u32())
    elf_image[TestElf::ELF_SYMBOL_TABLE_OFFSET + 48 + 4] <- 18
    elf_image[TestElf::ELF_SYMBOL_TABLE_OFFSET + 48 + 6] <- 1
    put_u64(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 48 + 8, 4096)
    put_u64(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 48 + 16, 16)
    put_u32(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 72, TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET.u32())
    elf_image[TestElf::ELF_SYMBOL_TABLE_OFFSET + 72 + 4] <- 18
    elf_image[TestElf::ELF_SYMBOL_TABLE_OFFSET + 72 + 6] <- 1
    put_u64(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 72 + 8, 8192)
    put_u64(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 72 + 16, 16)
    for index in 0..<TestName::OVER_CAPACITY_SYMBOL_NAME_LENGTH:
        elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + index] <- TestName::NAME_A
    elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_LENGTH] <- 0
    elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET] <- TestName::NAME_F
    elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET + 1] <- TestName::NAME_O
    elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET + 2] <- TestName::NAME_B
    elf_header: DebuggerNativeElf::ElfHeader = DebuggerNativeElf::elf_parse(elf_image[0], TestElf::ELF_FIXTURE_BYTES)
    return 7 if not elf_header.valid
    overlong_elf_name: DebuggerNativeElf::ElfSymbolName = DebuggerNativeElf::elf_symbol_name(elf_image[0], TestElf::ELF_FIXTURE_BYTES, elf_header, 1, 1)
    return 16 if not overlong_elf_name.valid or not overlong_elf_name.truncated or overlong_elf_name.length != TestName::NAME_CAPACITY or overlong_elf_name.bytes[TestName::NAME_CAPACITY - 1] != TestName::NAME_A
    elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::NAME_CAPACITY] <- 0
    exact_capacity_elf_name: DebuggerNativeElf::ElfSymbolName = DebuggerNativeElf::elf_symbol_name(elf_image[0], TestElf::ELF_FIXTURE_BYTES, elf_header, 1, 1)
    return 18 if not exact_capacity_elf_name.valid or exact_capacity_elf_name.truncated or exact_capacity_elf_name.length != TestName::NAME_CAPACITY
    elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::NAME_CAPACITY] <- TestName::NAME_A
    unterminated_elf_image: mutable u8[TestElf::ELF_FIXTURE_BYTES] = elf_image
    unterminated_elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_LENGTH] <- TestName::NAME_A
    unterminated_elf_image[TestElf::ELF_STRING_TABLE_OFFSET + TestName::SYMBOL_STRING_TABLE_LENGTH - 1] <- TestName::NAME_A
    unterminated_elf_name: DebuggerNativeElf::ElfSymbolName = DebuggerNativeElf::elf_symbol_name(unterminated_elf_image[0], TestElf::ELF_FIXTURE_BYTES, elf_header, 1, 1)
    return 19 if unterminated_elf_name.valid or not unterminated_elf_name.truncated
    elf_loaded: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(elf_loaded)
    elf_load_accepted: bool = DebuggerNativeSymbolLoader::load_elf_section(elf_loaded, elf_image[0], TestElf::ELF_FIXTURE_BYTES, elf_header, 1, zeroed)
    return 8 if not elf_load_accepted or elf_loaded.count != 2 or elf_loaded.symbols[0].address != 4096 or elf_loaded.symbols[1].address != 8192
    put_u32(elf_image[0], TestElf::ELF_SYMBOL_TABLE_OFFSET + 48, 99)
    malformed_elf_loaded: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(malformed_elf_loaded)
    _ = DebuggerNativeSymbolLoader::add_elf_symbol(malformed_elf_loaded, elf_symbol, elf_name, zeroed)
    malformed_elf_load_accepted: bool = DebuggerNativeSymbolLoader::load_elf_section(malformed_elf_loaded, elf_image[0], TestElf::ELF_FIXTURE_BYTES, elf_header, 1, zeroed)
    return 9 if malformed_elf_load_accepted or malformed_elf_loaded.count != 1

    macho_image: mutable u8[TestMachO::MACHO_FIXTURE_BYTES] = zeroed
    macho_image[0] <- 207
    macho_image[1] <- 250
    macho_image[2] <- 237
    macho_image[3] <- 254
    macho_image[4] <- 7
    macho_image[7] <- 1
    macho_image[8] <- 3
    macho_image[12] <- 2
    macho_image[16] <- 1
    macho_image[20] <- 24
    macho_image[32] <- 2
    macho_image[36] <- 24
    put_u32(macho_image[0], 40, TestMachO::MACHO_SYMBOL_TABLE_OFFSET.u32())
    put_u32(macho_image[0], 44, 5)
    put_u32(macho_image[0], 48, TestMachO::MACHO_STRING_TABLE_OFFSET.u32())
    put_u32(macho_image[0], 52, TestName::SYMBOL_STRING_TABLE_LENGTH.u32())
    put_u32(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET, 0)
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 4] <- 1
    put_u32(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 16, TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET.u32())
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 16 + 4] <- 15
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 16 + 5] <- 1
    put_u64(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 16 + 8, 8192)
    put_u32(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 32, TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET.u32())
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 32 + 4] <- 15
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 32 + 5] <- 1
    put_u64(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 32 + 8, 12288)
    put_u32(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 48, TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET.u32())
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 48 + 4] <- 15
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 48 + 5] <- 1
    put_u64(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 48 + 8, 12288)
    put_u32(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 64, TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET.u32())
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 64 + 4] <- 15
    macho_image[TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 64 + 5] <- 1
    put_u64(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 64 + 8, 16384)
    for index in 0..<TestName::OVER_CAPACITY_SYMBOL_NAME_LENGTH:
        macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + index] <- TestName::NAME_A
    macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_LENGTH] <- 0
    macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET] <- TestName::NAME_F
    macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET + 1] <- TestName::NAME_O
    macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::SYMBOL_NAME_AFTER_OVER_CAPACITY_OFFSET + 2] <- TestName::NAME_B
    macho_header: DebuggerNativeMachO::MachOHeader = DebuggerNativeMachO::macho_parse(macho_image[0], TestMachO::MACHO_FIXTURE_BYTES)
    return 10 if not macho_header.valid
    overlong_macho_name: DebuggerNativeMachO::MachOSymbolName = DebuggerNativeMachO::macho_symbol_name(macho_header, macho_image[0], TestMachO::MACHO_FIXTURE_BYTES, 1)
    return 17 if not overlong_macho_name.valid or not overlong_macho_name.truncated or overlong_macho_name.length != TestName::NAME_CAPACITY or overlong_macho_name.bytes[TestName::NAME_CAPACITY - 1] != TestName::NAME_A
    macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::NAME_CAPACITY] <- 0
    exact_capacity_macho_name: DebuggerNativeMachO::MachOSymbolName = DebuggerNativeMachO::macho_symbol_name(macho_header, macho_image[0], TestMachO::MACHO_FIXTURE_BYTES, 1)
    return 20 if not exact_capacity_macho_name.valid or exact_capacity_macho_name.truncated or exact_capacity_macho_name.length != TestName::NAME_CAPACITY
    macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::NAME_CAPACITY] <- TestName::NAME_A
    unterminated_macho_image: mutable u8[TestMachO::MACHO_FIXTURE_BYTES] = macho_image
    unterminated_macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_OFFSET + TestName::OVER_CAPACITY_SYMBOL_NAME_LENGTH] <- TestName::NAME_A
    unterminated_macho_image[TestMachO::MACHO_STRING_TABLE_OFFSET + TestName::SYMBOL_STRING_TABLE_LENGTH - 1] <- TestName::NAME_A
    unterminated_macho_name: DebuggerNativeMachO::MachOSymbolName = DebuggerNativeMachO::macho_symbol_name(macho_header, unterminated_macho_image[0], TestMachO::MACHO_FIXTURE_BYTES, 1)
    return 21 if unterminated_macho_name.valid or not unterminated_macho_name.truncated
    macho_sizes: mutable u64[5] = [0, 4, 8, 8, 4]
    macho_fixture_loaded: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(macho_fixture_loaded)
    macho_load_accepted: bool = DebuggerNativeSymbolLoader::load_macho_symbols(macho_fixture_loaded, macho_image[0], TestMachO::MACHO_FIXTURE_BYTES, macho_header, 5, macho_sizes[0], 5, zeroed)
    return 11 if not macho_load_accepted or macho_fixture_loaded.count != 2 or macho_fixture_loaded.symbols[0].address != 12288 or macho_fixture_loaded.symbols[1].address != 16384
    put_u32(macho_image[0], TestMachO::MACHO_SYMBOL_TABLE_OFFSET + 32, 99)
    malformed_macho_loaded: mutable DebuggerNativeSymbols::SymbolTable = zeroed
    DebuggerNativeSymbols::symbols_initialize(malformed_macho_loaded)
    _ = DebuggerNativeSymbolLoader::add_macho_symbol(malformed_macho_loaded, macho_symbol, macho_name, 8, zeroed)
    malformed_macho_load_accepted: bool = DebuggerNativeSymbolLoader::load_macho_symbols(malformed_macho_loaded, macho_image[0], TestMachO::MACHO_FIXTURE_BYTES, macho_header, 5, macho_sizes[0], 5, zeroed)
    return 12 if malformed_macho_load_accepted or malformed_macho_loaded.count != 1

    empty_bytes: mutable u8[1] = zeroed
    invalid_header: DebuggerNativeElf::ElfHeader = zeroed
    loaded: bool = DebuggerNativeSymbolLoader::load_elf_section(table, empty_bytes[0], 0, invalid_header, 0, zeroed)
    return 5 if loaded or table.count != 3
    macho_loaded: bool = DebuggerNativeSymbolLoader::load_macho_symbols(table, empty_bytes[0], 0, zeroed, 0, empty_bytes[0], 0, zeroed)
    return 6 if macho_loaded or table.count != 3
    return 0
