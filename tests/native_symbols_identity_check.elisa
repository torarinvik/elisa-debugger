include "../src/native/symbols.elisa"


const module TestName:
    SYMBOL_NAME_BYTES: usize = 3
    SYMBOL_NAME_CAPACITY: usize = 256
    INVALID_LENGTH: usize = 257


def main() -> i64:
    name: mutable u8[TestName::SYMBOL_NAME_CAPACITY] = zeroed
    name[0] <- 102
    name[1] <- 111
    name[2] <- 111
    first: DebuggerIdentity::DebugId = DebuggerNativeSymbols::symbol_name_id(name[0], TestName::SYMBOL_NAME_BYTES)
    second: DebuggerIdentity::DebugId = DebuggerNativeSymbols::symbol_name_id(name[0], TestName::SYMBOL_NAME_BYTES)
    return 1 if first.value == 0 or first.value != second.value
    name[2] <- 98
    changed: DebuggerIdentity::DebugId = DebuggerNativeSymbols::symbol_name_id(name[0], TestName::SYMBOL_NAME_BYTES)
    return 2 if changed.value == 0 or changed.value == first.value
    return 3 if DebuggerNativeSymbols::symbol_name_id(name[0], 0).value != 0
    return 4 if DebuggerNativeSymbols::symbol_name_id(name[0], TestName::INVALID_LENGTH).value != 0
    return 0
