include "../src/security/path.elisa"

const module Test:
    PATH_POLICY_WINDOWS_PARENT_SEGMENT: cstr = "dir/.. /secret"
    PATH_POLICY_WINDOWS_DOTTED_PARENT_SEGMENT: cstr = "dir/.. ./secret"


def main() -> i64:
    return 1 if not DebuggerPathPolicy::path_is_safe("src/main.elisa")
    return 2 if DebuggerPathPolicy::path_is_safe("../secret")
    return 3 if DebuggerPathPolicy::path_is_safe("/tmp/trace")
    return 4 if DebuggerPathPolicy::path_is_safe("C:\\trace")
    return 5 if DebuggerPathPolicy::path_is_safe("dir/../../trace")
    return 6 if DebuggerPathPolicy::path_is_safe("")
    return 7 if DebuggerPathPolicy::path_is_safe(Test::PATH_POLICY_WINDOWS_PARENT_SEGMENT) or DebuggerPathPolicy::path_is_safe(Test::PATH_POLICY_WINDOWS_DOTTED_PARENT_SEGMENT)
    return 0
