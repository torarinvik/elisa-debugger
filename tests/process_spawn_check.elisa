include "../src/platform/child_process.elisa"

@link_name("write")
extern process_check_write(fd: i32, buffer: void&, count: usize) -> isize can[Blocking.IO]
@link_name("unlink")
extern process_check_unlink(path: cstr) -> i32 can[Blocking.IO]
@link_name("access")
extern process_check_access(path: cstr, mode: i32) -> i32 can[Blocking.IO]

const PROCESS_CHECK_ARGUMENT: cstr = "literal ;$(touch build/elisa-debugger-process-shell-marker)"
const PROCESS_CHECK_CHILD_SWITCH: cstr = "--process-check-child"
const PROCESS_CHECK_MARKER_PATH: cstr = "build/elisa-debugger-process-shell-marker"
const PROCESS_CHECK_MISSING_EXECUTABLE: cstr = "build/elisa-debugger-process-missing-executable"
const PROCESS_CHECK_STDOUT_TEXT: cstr = "stdout-ok\n"
const PROCESS_CHECK_STDERR_TEXT: cstr = "stderr-ok\n"
const PROCESS_CHECK_STDOUT_LENGTH: usize = 10
const PROCESS_CHECK_STDERR_LENGTH: usize = 10
const PROCESS_CHECK_EXPECTED_OUTPUT_LENGTH: usize = PROCESS_CHECK_STDOUT_LENGTH + PROCESS_CHECK_STDERR_LENGTH
const PROCESS_CHECK_STDOUT_FD: i32 = 1
const PROCESS_CHECK_STDERR_FD: i32 = 2
const PROCESS_CHECK_SUCCESS: i64 = 0
const PROCESS_CHECK_FAILURE: i64 = 1
const PROCESS_CHECK_BAD_ARGUMENT: i64 = 37
const PROCESS_CHECK_BAD_CHILD_MODE: i64 = 38
const PROCESS_CHECK_CHILD_EXIT: i32 = 73
const PROCESS_CHECK_CHILD_ARGUMENT_COUNT: i64 = 3
const PROCESS_CHECK_NO_FILE_ACCESS: i32 = -1
const PROCESS_CHECK_ACCESS_MODE: i32 = 0
const PROCESS_CHECK_NO_SYSTEM_ERROR: i32 = 0
const PROCESS_CHECK_C_STRING_TERMINATOR: u8 = 0
const PROCESS_CHECK_INDEX_INCREMENT: usize = 1
const PROCESS_CHECK_PARENT_ARGUMENT_COUNT: i64 = 4
const PROCESS_CHECK_PARENT_MODE_INDEX: usize = 1
const PROCESS_CHECK_PARENT_FIRST_RESERVED_INDEX: usize = 2
const PROCESS_CHECK_PARENT_SECOND_RESERVED_INDEX: usize = 3
const PROCESS_CHECK_CHILD_SWITCH_INDEX: usize = 1
const PROCESS_CHECK_CHILD_LITERAL_INDEX: usize = 2
const PROCESS_CHECK_CHILD_EXECUTABLE_INDEX: usize = 0
const PROCESS_CHECK_ARGV_TERMINATOR_INDEX: usize = 3
const PROCESS_CHECK_PREFIX_CAPTURE_LENGTH: usize = PROCESS_CHECK_STDOUT_LENGTH
const PROCESS_CHECK_SIZE_INCREMENT: usize = 1
const PROCESS_CHECK_PARENT_MODE: cstr = "--process-check-parent"
const PROCESS_CHECK_RESERVED_FIRST: cstr = "reserved-first"
const PROCESS_CHECK_RESERVED_SECOND: cstr = "reserved-second"
const PROCESS_CHECK_SPAWN_FAILURE: i64 = 2
const PROCESS_CHECK_EXIT_FAILURE: i64 = 3
const PROCESS_CHECK_OUTPUT_FAILURE: i64 = 4
const PROCESS_CHECK_SHELL_EXECUTION_FAILURE: i64 = 5

def process_check_cstr_equal(left: cstr, right: cstr) -> bool:
    index: mutable usize = 0
    while left[index].u8() == right[index].u8():
        return true if left[index].u8() == PROCESS_CHECK_C_STRING_TERMINATOR
        index <- index + PROCESS_CHECK_INDEX_INCREMENT
    return false

def process_check_output_matches(output: u8&, output_length: usize) -> bool:
    return false if output_length != PROCESS_CHECK_EXPECTED_OUTPUT_LENGTH
    for index in 0..<PROCESS_CHECK_STDOUT_LENGTH:
        return false if output[index] != PROCESS_CHECK_STDOUT_TEXT[index].u8()
    for index in 0..<PROCESS_CHECK_STDERR_LENGTH:
        output_index: usize = PROCESS_CHECK_STDOUT_LENGTH + index
        return false if output[output_index] != PROCESS_CHECK_STDERR_TEXT[index].u8()
    return true

def process_check_prefix_matches(output: u8&, output_length: usize) -> bool:
    return false if output_length != PROCESS_CHECK_PREFIX_CAPTURE_LENGTH
    for index in 0..<PROCESS_CHECK_PREFIX_CAPTURE_LENGTH:
        return false if output[index] != PROCESS_CHECK_STDOUT_TEXT[index].u8()
    return true

def main(argc: i64, argv: mutable void&) -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    arguments: mutable cstr&& = argv.cast[mutable cstr&&]
    if argc == PROCESS_CHECK_CHILD_ARGUMENT_COUNT:
        return PROCESS_CHECK_BAD_CHILD_MODE if not process_check_cstr_equal(arguments[PROCESS_CHECK_CHILD_SWITCH_INDEX].cast[cstr], PROCESS_CHECK_CHILD_SWITCH)
        return PROCESS_CHECK_BAD_ARGUMENT if not process_check_cstr_equal(arguments[PROCESS_CHECK_CHILD_LITERAL_INDEX].cast[cstr], PROCESS_CHECK_ARGUMENT)
        stdout_written: isize = process_check_write(PROCESS_CHECK_STDOUT_FD, PROCESS_CHECK_STDOUT_TEXT.cast[void&], PROCESS_CHECK_STDOUT_LENGTH) can Blocking.IO, Unsafe.PointerCast
        return PROCESS_CHECK_BAD_CHILD_MODE if stdout_written != PROCESS_CHECK_STDOUT_LENGTH.isize()
        stderr_written: isize = process_check_write(PROCESS_CHECK_STDERR_FD, PROCESS_CHECK_STDERR_TEXT.cast[void&], PROCESS_CHECK_STDERR_LENGTH) can Blocking.IO, Unsafe.PointerCast
        return PROCESS_CHECK_BAD_CHILD_MODE if stderr_written != PROCESS_CHECK_STDERR_LENGTH.isize()
        return PROCESS_CHECK_CHILD_EXIT
    return PROCESS_CHECK_FAILURE if argc != PROCESS_CHECK_PARENT_ARGUMENT_COUNT

    _ = process_check_unlink(PROCESS_CHECK_MARKER_PATH) can Blocking.IO
    return PROCESS_CHECK_FAILURE if not process_check_cstr_equal(arguments[PROCESS_CHECK_PARENT_MODE_INDEX].cast[cstr], PROCESS_CHECK_PARENT_MODE) or not process_check_cstr_equal(arguments[PROCESS_CHECK_PARENT_FIRST_RESERVED_INDEX].cast[cstr], PROCESS_CHECK_RESERVED_FIRST) or not process_check_cstr_equal(arguments[PROCESS_CHECK_PARENT_SECOND_RESERVED_INDEX].cast[cstr], PROCESS_CHECK_RESERVED_SECOND)
    mutable_slots: mutable void&& = argv.cast[mutable void&&] can Unsafe.PointerCast
    mutable_slots[PROCESS_CHECK_CHILD_SWITCH_INDEX] <- PROCESS_CHECK_CHILD_SWITCH.cast[mutable void&] can Unsafe.PointerCast
    mutable_slots[PROCESS_CHECK_CHILD_LITERAL_INDEX] <- PROCESS_CHECK_ARGUMENT.cast[mutable void&] can Unsafe.PointerCast
    null_argument: mutable void& = 0.usize().cast[mutable void&] can Unsafe.PointerCast
    mutable_slots[PROCESS_CHECK_ARGV_TERMINATOR_INDEX] <- null_argument
    captured_output: mutable u8[PROCESS_CHECK_EXPECTED_OUTPUT_LENGTH] = zeroed
    child_argv: mutable cstr&& = mutable_slots.cast[mutable cstr&&] can Unsafe.PointerCast
    executable_path: cstr = arguments[PROCESS_CHECK_CHILD_EXECUTABLE_INDEX].cast[cstr]
    result: DebuggerHostProcess::SpawnResult = DebuggerHostProcess::spawn_capture(executable_path, child_argv, captured_output[0], PROCESS_CHECK_EXPECTED_OUTPUT_LENGTH) can Blocking.IO, Unsafe.PointerCast
    prefix_output: mutable u8[PROCESS_CHECK_PREFIX_CAPTURE_LENGTH] = zeroed
    truncated_result: DebuggerHostProcess::SpawnResult = DebuggerHostProcess::spawn_capture(executable_path, child_argv, prefix_output[0], PROCESS_CHECK_PREFIX_CAPTURE_LENGTH) can Blocking.IO, Unsafe.PointerCast
    rejected_output: mutable u8[PROCESS_CHECK_EXPECTED_OUTPUT_LENGTH] = zeroed
    rejected_result: DebuggerHostProcess::SpawnResult = DebuggerHostProcess::spawn_capture(PROCESS_CHECK_MISSING_EXECUTABLE, child_argv, rejected_output[0], PROCESS_CHECK_EXPECTED_OUTPUT_LENGTH) can Blocking.IO, Unsafe.PointerCast
    invalid_capacity_result: DebuggerHostProcess::SpawnResult = DebuggerHostProcess::spawn_capture(executable_path, child_argv, prefix_output[0], DebuggerHostProcess::spawn_output_capacity() + PROCESS_CHECK_SIZE_INCREMENT) can Blocking.IO, Unsafe.PointerCast
    marker_status: i32 = process_check_access(PROCESS_CHECK_MARKER_PATH, PROCESS_CHECK_ACCESS_MODE) can Blocking.IO
    _ = process_check_unlink(PROCESS_CHECK_MARKER_PATH) can Blocking.IO

    return PROCESS_CHECK_SPAWN_FAILURE if result.failure != DebuggerHostProcess::SpawnFailure.None or not result.child_spawned or not result.child_reaped or truncated_result.failure != DebuggerHostProcess::SpawnFailure.None or not truncated_result.child_spawned or not truncated_result.child_reaped or rejected_result.failure != DebuggerHostProcess::SpawnFailure.SpawnRejected or rejected_result.child_spawned or rejected_result.child_reaped or rejected_result.system_error == PROCESS_CHECK_NO_SYSTEM_ERROR or rejected_result.output_length != 0 or invalid_capacity_result.failure != DebuggerHostProcess::SpawnFailure.InvalidArgument or invalid_capacity_result.child_spawned or invalid_capacity_result.output_length != 0
    return PROCESS_CHECK_EXIT_FAILURE if result.exit_code != PROCESS_CHECK_CHILD_EXIT or result.terminated_by_signal or truncated_result.exit_code != PROCESS_CHECK_CHILD_EXIT or truncated_result.terminated_by_signal
    return PROCESS_CHECK_OUTPUT_FAILURE if result.output_truncated or not process_check_output_matches(captured_output[0], result.output_length) or not truncated_result.output_truncated or not process_check_prefix_matches(prefix_output[0], truncated_result.output_length)
    return PROCESS_CHECK_SHELL_EXECUTION_FAILURE if marker_status != PROCESS_CHECK_NO_FILE_ACCESS
    return PROCESS_CHECK_SUCCESS
