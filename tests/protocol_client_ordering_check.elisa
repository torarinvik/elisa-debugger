include "../src/protocol/messages.elisa"
include "../src/protocol/client.elisa"

const TEST_SESSION_ID: u64 = 1
const INITIAL_RESPONSE_GENERATION: u64 = 0
const NEWER_RESPONSE_GENERATION: u64 = 2
const STALE_RESPONSE_GENERATION: u64 = 1
const DEFAULT_PAGE_SIZE: u64 = 0
const TEST_FAILURE_CLIENT_START: i64 = 1
const TEST_FAILURE_REQUEST_CREATION: i64 = 2
const TEST_FAILURE_OUT_OF_ORDER_RESPONSE: i64 = 3
const TEST_FAILURE_HIGH_WATER_MARK: i64 = 4
const TEST_FAILURE_STALE_RESPONSE: i64 = 5

def main() -> i64:
    client: mutable DebuggerProtocolClient::ReferenceClient = DebuggerProtocolClient::client_new(DebuggerProtocol::protocol_version())
    return TEST_FAILURE_CLIENT_START if not DebuggerErrors::error_is_ok(DebuggerProtocolClient::client_start(client, TEST_SESSION_ID))

    older_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocolClient::client_make_request(client, DebuggerProtocol::Method.Threads, DEFAULT_PAGE_SIZE)
    newer_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocolClient::client_make_request(client, DebuggerProtocol::Method.Step, DEFAULT_PAGE_SIZE)
    return TEST_FAILURE_REQUEST_CREATION if older_request.request_id == 0 or newer_request.request_id == 0

    newer_response: DebuggerErrors::DebuggerError = DebuggerProtocolClient::client_accept(client, DebuggerProtocol::response_ok(newer_request.request_id, NEWER_RESPONSE_GENERATION))
    return TEST_FAILURE_OUT_OF_ORDER_RESPONSE if not DebuggerErrors::error_is_ok(newer_response)
    older_response: DebuggerErrors::DebuggerError = DebuggerProtocolClient::client_accept(client, DebuggerProtocol::response_ok(older_request.request_id, INITIAL_RESPONSE_GENERATION))
    return TEST_FAILURE_OUT_OF_ORDER_RESPONSE if not DebuggerErrors::error_is_ok(older_response) or client.state != DebuggerProtocolClient::ClientState.Ready or not DebuggerProtocolClient::client_is_idle(client)
    return TEST_FAILURE_HIGH_WATER_MARK if client.stop_generation != NEWER_RESPONSE_GENERATION

    stale_client: mutable DebuggerProtocolClient::ReferenceClient = DebuggerProtocolClient::client_new(DebuggerProtocol::protocol_version())
    return TEST_FAILURE_CLIENT_START if not DebuggerErrors::error_is_ok(DebuggerProtocolClient::client_start(stale_client, TEST_SESSION_ID))
    stale_client.stop_generation <- NEWER_RESPONSE_GENERATION
    stale_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocolClient::client_make_request(stale_client, DebuggerProtocol::Method.Threads, DEFAULT_PAGE_SIZE)
    stale_response: DebuggerErrors::DebuggerError = DebuggerProtocolClient::client_accept(stale_client, DebuggerProtocol::response_ok(stale_request.request_id, STALE_RESPONSE_GENERATION))
    return TEST_FAILURE_STALE_RESPONSE if stale_response.code != DebuggerErrors::ErrorCode.Corrupt or stale_client.state != DebuggerProtocolClient::ClientState.Failed
    return 0
