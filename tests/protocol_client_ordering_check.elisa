include "../src/protocol/messages.elisa"
include "../src/protocol/client.elisa"

const module Test:
    SESSION_ID: u64 = 1
    INITIAL_RESPONSE_GENERATION: u64 = 0
    NEWER_RESPONSE_GENERATION: u64 = 2
    STALE_RESPONSE_GENERATION: u64 = 1
    DEFAULT_PAGE_SIZE: u64 = 0
    FAILURE_CLIENT_START: i64 = 1
    FAILURE_REQUEST_CREATION: i64 = 2
    FAILURE_OUT_OF_ORDER_RESPONSE: i64 = 3
    FAILURE_HIGH_WATER_MARK: i64 = 4
    FAILURE_STALE_RESPONSE: i64 = 5


def main() -> i64:
    client: mutable DebuggerProtocolClient::ReferenceClient = DebuggerProtocolClient::client_new(DebuggerProtocol::protocol_version())
    return Test::FAILURE_CLIENT_START if not DebuggerErrors::error_is_ok(DebuggerProtocolClient::client_start(client, Test::SESSION_ID))

    older_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocolClient::client_make_request(client, DebuggerProtocol::Method.Threads, Test::DEFAULT_PAGE_SIZE)
    newer_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocolClient::client_make_request(client, DebuggerProtocol::Method.Step, Test::DEFAULT_PAGE_SIZE)
    return Test::FAILURE_REQUEST_CREATION if older_request.request_id == 0 or newer_request.request_id == 0

    newer_response: DebuggerErrors::DebuggerError = DebuggerProtocolClient::client_accept(client, DebuggerProtocol::response_ok(newer_request.request_id, Test::NEWER_RESPONSE_GENERATION))
    return Test::FAILURE_OUT_OF_ORDER_RESPONSE if not DebuggerErrors::error_is_ok(newer_response)
    older_response: DebuggerErrors::DebuggerError = DebuggerProtocolClient::client_accept(client, DebuggerProtocol::response_ok(older_request.request_id, Test::INITIAL_RESPONSE_GENERATION))
    return Test::FAILURE_OUT_OF_ORDER_RESPONSE if not DebuggerErrors::error_is_ok(older_response) or client.state != DebuggerProtocolClient::ClientState.Ready or not DebuggerProtocolClient::client_is_idle(client)
    return Test::FAILURE_HIGH_WATER_MARK if client.stop_generation != Test::NEWER_RESPONSE_GENERATION

    stale_client: mutable DebuggerProtocolClient::ReferenceClient = DebuggerProtocolClient::client_new(DebuggerProtocol::protocol_version())
    return Test::FAILURE_CLIENT_START if not DebuggerErrors::error_is_ok(DebuggerProtocolClient::client_start(stale_client, Test::SESSION_ID))
    stale_client.stop_generation <- Test::NEWER_RESPONSE_GENERATION
    stale_request: DebuggerProtocol::RequestEnvelope = DebuggerProtocolClient::client_make_request(stale_client, DebuggerProtocol::Method.Threads, Test::DEFAULT_PAGE_SIZE)
    stale_response: DebuggerErrors::DebuggerError = DebuggerProtocolClient::client_accept(stale_client, DebuggerProtocol::response_ok(stale_request.request_id, Test::STALE_RESPONSE_GENERATION))
    return Test::FAILURE_STALE_RESPONSE if stale_response.code != DebuggerErrors::ErrorCode.Corrupt or stale_client.state != DebuggerProtocolClient::ClientState.Failed
    return 0
