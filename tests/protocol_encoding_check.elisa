include "../src/protocol/encoding.elisa"
include "../src/protocol/request.elisa"

const SUCCESS_ID: u64 = 42
const SUCCESS_GENERATION: u64 = 9
const SESSION_ID: u64 = 7
const TARGET_EVENT: u64 = 11
const PAGE_SIZE: u64 = 32
const MAX_PAGE_SIZE: u64 = 256
const MAX_TRACE_EVENTS: u64 = 1024
const OWNER_TOKEN: u64 = 13
const CLIENT_NAME: u64 = 14
const CLIENT_VERSION: u64 = 15
const CLIENT_INSTANCE: u64 = 16
const INVALID_DETAIL: u32 = 1
const ASCII_COLON: u8 = 58
const ASCII_FALSE_F: u8 = 102
const ASCII_FALSE_A: u8 = 97
const ASCII_FALSE_L: u8 = 108
const ASCII_FALSE_S: u8 = 115
const ASCII_FALSE_E: u8 = 101
const ASCII_TRUE_T: u8 = 116
const ASCII_TRUE_R: u8 = 114
const ASCII_TRUE_U: u8 = 117
const ASCII_TRUE_E: u8 = 101
const JSON_KEY_SOURCE_BREAKPOINTS: cstr = "\"sourceBreakpoints\""
const JSON_KEY_REVERSE_EXECUTION: cstr = "\"reverseExecution\""
const JSON_KEY_TYPED_VALUES: cstr = "\"typedValues\""
const JSON_KEY_HISTORICAL_QUERIES: cstr = "\"historicalQueries\""
const JSON_KEY_TRACE_EXPORT: cstr = "\"traceExport\""

def discovery_flag_matches(buffer: DebuggerProtocolEncoding::JsonBuffer, key: cstr, expected: bool) -> bool:
    key_length: mutable usize = 0
    while key[key_length] != 0:
        key_length <- key_length + 1
    for start in 0..<buffer.length:
        return false if key_length > buffer.length - start
        matches: mutable bool = true
        for offset in 0..<key_length:
            matches <- false if buffer.bytes[start + offset] != key[offset].u8()
        if matches:
            value_start: mutable usize = start + key_length
            return false if value_start >= buffer.length or buffer.bytes[value_start] != ASCII_COLON
            value_start <- value_start + 1
            return false if expected and value_start + 4 > buffer.length
            return false if not expected and value_start + 5 > buffer.length
            if expected:
                return buffer.bytes[value_start] == ASCII_TRUE_T and buffer.bytes[value_start + 1] == ASCII_TRUE_R and buffer.bytes[value_start + 2] == ASCII_TRUE_U and buffer.bytes[value_start + 3] == ASCII_TRUE_E
            return buffer.bytes[value_start] == ASCII_FALSE_F and buffer.bytes[value_start + 1] == ASCII_FALSE_A and buffer.bytes[value_start + 2] == ASCII_FALSE_L and buffer.bytes[value_start + 3] == ASCII_FALSE_S and buffer.bytes[value_start + 4] == ASCII_FALSE_E
    return false

def main() -> i64:
    success: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::response_ok(SUCCESS_ID, SUCCESS_GENERATION)
    encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::response_encode(success)
    return 1 if not DebuggerProtocolEncoding::json_buffer_is_valid(encoded)
    return 2 if encoded.length != 87 or encoded.bytes[0] != 123 or encoded.bytes[86] != 125
    invalid_response_id: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::response_ok(0, SUCCESS_GENERATION)
    return 13 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::response_encode(invalid_response_id))
    inconsistent_response: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::ResponseEnvelope{request_id: SUCCESS_ID, ok: true, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Internal, false, INVALID_DETAIL), stop_generation: SUCCESS_GENERATION, next_page: 0}
    return 14 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::response_encode(inconsistent_response))
    oversized_page: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::ResponseEnvelope{request_id: SUCCESS_ID, ok: true, failure: DebuggerErrors::no_error(), stop_generation: SUCCESS_GENERATION, next_page: MAX_TRACE_EVENTS + 1}
    return 15 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::response_encode(oversized_page))

    request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{
        kind: DebuggerProtocol::MessageKind.Request,
        method: DebuggerProtocol::Method.Seek,
        request_id: SUCCESS_ID,
        session_id: SESSION_ID,
        expected_stop_generation: SUCCESS_GENERATION,
        page_size: PAGE_SIZE,
        target_event: TARGET_EVENT
    }
    request_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::request_encode(request)
    return 3 if not DebuggerProtocolEncoding::json_buffer_is_valid(request_encoded)
    parsed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(request_encoded.bytes[0], request_encoded.length)
    return 4 if not parsed.valid or parsed.method != DebuggerProtocolRequest::RequestMethod.Seek
    return 5 if not parsed.has_id or parsed.id != SUCCESS_ID or parsed.expected_generation != SUCCESS_GENERATION or parsed.target_event != TARGET_EVENT

    discovery: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{
        kind: DebuggerProtocol::MessageKind.Request,
        method: DebuggerProtocol::Method.Discover,
        request_id: 0,
        session_id: 0,
        expected_stop_generation: 0,
        page_size: 0,
        target_event: 0
    }
    discovery_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::request_encode(discovery)
    discovery_parsed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(discovery_encoded.bytes[0], discovery_encoded.length)
    return 6 if discovery_encoded.failed or not discovery_parsed.valid or discovery_parsed.has_id
    managed_capabilities: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    discovery_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::discovery_response_encode(SUCCESS_ID, managed_capabilities)
    return 17 if not DebuggerProtocolEncoding::json_buffer_is_valid(discovery_response)
    return 18 if discovery_flag_matches(discovery_response, JSON_KEY_SOURCE_BREAKPOINTS, managed_capabilities.source_breakpoints) == false
    return 19 if discovery_flag_matches(discovery_response, JSON_KEY_REVERSE_EXECUTION, managed_capabilities.reverse_execution) == false
    return 20 if discovery_flag_matches(discovery_response, JSON_KEY_TYPED_VALUES, managed_capabilities.typed_values) == false
    return 21 if discovery_flag_matches(discovery_response, JSON_KEY_HISTORICAL_QUERIES, managed_capabilities.historical_queries) == false
    return 22 if discovery_flag_matches(discovery_response, JSON_KEY_TRACE_EXPORT, managed_capabilities.trace_export) == false
    restricted_capabilities: mutable DebuggerCapabilities::CapabilitySet = managed_capabilities
    restricted_capabilities.source_breakpoints <- false
    restricted_capabilities.reverse_execution <- false
    restricted_capabilities.typed_values <- false
    restricted_capabilities.trace_export <- false
    restricted_discovery: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::discovery_response_encode(SUCCESS_ID, restricted_capabilities)
    return 23 if discovery_flag_matches(restricted_discovery, JSON_KEY_SOURCE_BREAKPOINTS, false) == false or discovery_flag_matches(restricted_discovery, JSON_KEY_REVERSE_EXECUTION, false) == false or discovery_flag_matches(restricted_discovery, JSON_KEY_TYPED_VALUES, false) == false or discovery_flag_matches(restricted_discovery, JSON_KEY_TRACE_EXPORT, false) == false

    invalid_id: DebuggerProtocol::RequestEnvelope = request
    invalid_id.request_id <- 0
    invalid_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::request_encode(invalid_id)
    return 7 if not invalid_encoded.failed

    invalid_page: DebuggerProtocol::RequestEnvelope = request
    invalid_page.page_size <- MAX_PAGE_SIZE + 1
    invalid_page_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::request_encode(invalid_page)
    return 8 if not invalid_page_encoded.failed

    integration_request: DebuggerProtocolIntegration::SessionRequest = DebuggerProtocolIntegration::SessionRequest{
        client: DebuggerProtocolIntegration::ClientIdentity{
            name: DebuggerIdentity::debug_id(CLIENT_NAME),
            version: DebuggerIdentity::debug_id(CLIENT_VERSION),
            instance: DebuggerIdentity::debug_id(CLIENT_INSTANCE)
        },
        request_id: SUCCESS_ID,
        session_id: SESSION_ID,
        owner_token: OWNER_TOKEN,
        expected_generation: SUCCESS_GENERATION,
        method: DebuggerProtocol::Method.Seek,
        page_size: PAGE_SIZE,
        target_event: TARGET_EVENT
    }
    integration_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::session_request_encode(integration_request)
    return 9 if not DebuggerProtocolEncoding::json_buffer_is_valid(integration_encoded)
    integration_parsed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(integration_encoded.bytes[0], integration_encoded.length)
    return 10 if not integration_parsed.valid or integration_parsed.id != SUCCESS_ID or integration_parsed.expected_generation != SUCCESS_GENERATION or integration_parsed.target_event != TARGET_EVENT

    integration_response: DebuggerProtocolIntegration::SessionResponse = DebuggerProtocolIntegration::SessionResponse{
        request_id: SUCCESS_ID,
        session_id: SESSION_ID,
        stop_generation: SUCCESS_GENERATION,
        accepted: true,
        next_page: 0,
        failure: DebuggerErrors::no_error()
    }
    response_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::session_response_encode(integration_response)
    return 11 if not DebuggerProtocolEncoding::json_buffer_is_valid(response_encoded)
    invalid_response: DebuggerProtocolIntegration::SessionResponse = DebuggerProtocolIntegration::SessionResponse{
        request_id: SUCCESS_ID,
        session_id: SESSION_ID,
        stop_generation: SUCCESS_GENERATION,
        accepted: true,
        next_page: 0,
        failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Internal, false, 1)
    }
    return 12 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::session_response_encode(invalid_response))
    oversized_session_page: DebuggerProtocolIntegration::SessionResponse = integration_response
    oversized_session_page.next_page <- MAX_TRACE_EVENTS + 1
    return 16 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::session_response_encode(oversized_session_page))
    return 0
