include "../src/protocol/encoding.elisa"
include "../src/protocol/request.elisa"

const module Test:
    SUCCESS: i64 = 0
    SUCCESS_ID: u64 = 42
    SUCCESS_GENERATION: u64 = 9
    SESSION_ID: u64 = 7
    TARGET_EVENT: u64 = 11
    PAGE_SIZE: u64 = 32
    MAX_PAGE_SIZE: u64 = 256
    MAX_TRACE_EVENTS: u64 = 1024
    OWNER_TOKEN: u64 = 13
    CLIENT_NAME: u64 = 14
    CLIENT_VERSION: u64 = 15
    CLIENT_INSTANCE: u64 = 16
    INVALID_DETAIL: u32 = 1
    ASCII_COLON: u8 = 58
    ASCII_FALSE_F: u8 = 102
    ASCII_FALSE_A: u8 = 97
    ASCII_FALSE_L: u8 = 108
    ASCII_FALSE_S: u8 = 115
    ASCII_FALSE_E: u8 = 101
    ASCII_TRUE_T: u8 = 116
    ASCII_TRUE_R: u8 = 114
    ASCII_TRUE_U: u8 = 117
    ASCII_TRUE_E: u8 = 101
    JSON_KEY_SOURCE_BREAKPOINTS: cstr = "\"sourceBreakpoints\""
    JSON_KEY_REVERSE_EXECUTION: cstr = "\"reverseExecution\""
    JSON_KEY_TIMELINE: cstr = "\"timeline\""
    TIMELINE_GENERATION: u64 = 4
    TIMELINE_RECORDING_ID: u64 = 5
    TIMELINE_BRANCH_ID: u64 = 6
    TIMELINE_FIRST_EVENT: u64 = 0
    TIMELINE_EVENT: u64 = 1
    TIMELINE_LAST_EVENT: u64 = 2
    TIMELINE_LABEL_ID: u64 = 700
    TIMELINE_NOTE_ID: u64 = 701
    TIMELINE_CHECKPOINT_EVENT: u64 = 1
    TIMELINE_CHECKPOINT_HASH: u64 = 391
    TIMELINE_NO_CHECKPOINT_EVENT: u64 = 0
    TIMELINE_NO_CHECKPOINT_HASH: u64 = 0
    ASCII_BRACE_CLOSE: u8 = 125
    TIMELINE_FIELD: cstr = "\"timeline\":{"
    TIMELINE_POSITION: cstr = "\"position\":{\"event\":\"1\",\"branch\":\"6\"}"
    TIMELINE_RETAINED_BOUNDS: cstr = "\"retained\":{\"available\":true,\"firstEvent\":\"0\",\"lastEvent\":\"2\"}"
    TIMELINE_BOOKMARK: cstr = "\"bookmarks\":[{\"id\":\"1\",\"event\":\"1\""
    TIMELINE_CHECKPOINT: cstr = "\"checkpoint\":{\"available\":true,\"event\":\"1\",\"stateHash\":\"391\"}"
    JSON_KEY_TYPED_VALUES: cstr = "\"typedValues\""
    JSON_KEY_FUNCTION_BREAKPOINTS: cstr = "\"functionBreakpoints\""
    JSON_KEY_DATA_BREAKPOINTS: cstr = "\"dataBreakpoints\""
    JSON_KEY_EXPRESSION_EVALUATION: cstr = "\"expressionEvaluation\""
    JSON_KEY_CHECKPOINTS: cstr = "\"checkpoints\""
    JSON_KEY_BRANCHES: cstr = "\"branches\""
    JSON_KEY_CONCURRENCY_GRAPH: cstr = "\"concurrencyGraph\""
    JSON_KEY_PROVENANCE: cstr = "\"provenance\""
    JSON_KEY_REMOTE_TRANSPORT: cstr = "\"remoteTransport\""
    JSON_KEY_TRACE_VERIFICATION: cstr = "\"traceVerification\""
    JSON_KEY_MEMORY_READ: cstr = "\"memoryRead\""
    JSON_KEY_SCHEDULE_EXPLORATION: cstr = "\"scheduleExploration\""
    JSON_KEY_NATIVE_ATTACH: cstr = "\"nativeAttach\""
    JSON_KEY_POSTMORTEM_INSPECTION: cstr = "\"postmortemInspection\""
    JSON_KEY_HISTORICAL_QUERIES: cstr = "\"historicalQueries\""
    JSON_KEY_TRACE_EXPORT: cstr = "\"traceExport\""
    THREADS_RESPONSE_FRAGMENT: cstr = "\"threads\":[{\"id\":\"1\",\"name\":\"main\"}]"
    FAILURE_THREAD_RESPONSE: i64 = 30
    FAILURE_INVALID_THREAD_REQUEST_ID: i64 = 31
    FAILURE_DISCOVERY_CAPABILITY_FIELDS: i64 = 32
    FRAME_ACCUMULATOR_VALUE: cstr = "\"accumulator\":\"-42\""
    LOCAL_UNAVAILABLE_VALUE: cstr = "\"availability\":\"uninitialized\",\"value\":null"
    FRAME_ID: u64 = 1
    FRAME_INSTRUCTION: u64 = 2
    FRAME_EVENT: u64 = 3
    FRAME_ACCUMULATOR: i64 = -42
    FRAME_RESULT: i64 = 12
    FRAME_RETURN_DEPTH: usize = 2
    LOCAL_COUNT: usize = 2
    FIRST_LOCAL_INDEX: usize = 0
    SECOND_LOCAL_INDEX: usize = 1
    FIRST_LOCAL_VALUE: i64 = 40
    FAILURE_OVERSIZED_LOCAL_PAGE: i64 = 28
    INITIALIZE_MINOR_REQUEST: u64 = 17
    INCOMPATIBLE_PROTOCOL_MAJOR: u64 = 2
    FAILURE_INITIALIZE_ENCODING: i64 = 29
    FAILURE_TIMELINE_ENCODING: i64 = 34
    INITIALIZE_PROTOCOL_MAJOR: cstr = "\"protocolMajor\":1"
    INITIALIZE_PROTOCOL_MINOR: cstr = "\"protocolMinor\":0"
    INITIALIZE_SERVER_NAME: cstr = "\"server\":\"elisa-debugger\""
    INCOMPATIBLE_VERSION_CODE: cstr = "\"code\":\"INCOMPATIBLE_VERSION\""
    INCOMPATIBLE_REQUESTED_MAJOR: cstr = "\"requestedProtocolMajor\":2"
    INITIALIZE_REQUIRED_ERROR_CODE: cstr = "\"code\":\"INITIALIZE_REQUIRED\""
    MEMORY_RESPONSE_ADDRESS: cstr = "\"address\":\"8\""
    MEMORY_RESPONSE_BYTES: cstr = "\"bytes\":\"0001fe7f\""
    MEMORY_RESPONSE_STATE: cstr = "\"state\":\"available\""
    CHECKPOINT_RESPONSE_EVENT: cstr = "\"event\":\"3\""
    CHECKPOINT_RESPONSE_HASH: cstr = "\"stateHash\":\"99\""
    BRANCH_RESPONSE_ID: cstr = "\"branch\":{\"id\":\"2\"}"


def discovery_flag_matches(buffer: DebuggerProtocolEncoding::JsonBuffer, key: cstr, expected: bool) -> bool:
    key_length: mutable usize = 0
    while key[key_length] != 0:
        key_length <- key_length + 1
    for start in 0..<buffer.length:
        return false if key_length > buffer.length - start
        matches: mutable bool = true
        for offset in 0..<key_length:
            matches <- false if buffer.bytes[start + offset] != key[offset].u8()
        if matches:
            value_start: mutable usize = start + key_length
            return false if value_start >= buffer.length or buffer.bytes[value_start] != Test::ASCII_COLON
            value_start <- value_start + 1
            return false if expected and value_start + 4 > buffer.length
            return false if not expected and value_start + 5 > buffer.length
            if expected:
                return buffer.bytes[value_start] == Test::ASCII_TRUE_T and buffer.bytes[value_start + 1] == Test::ASCII_TRUE_R and buffer.bytes[value_start + 2] == Test::ASCII_TRUE_U and buffer.bytes[value_start + 3] == Test::ASCII_TRUE_E
            return buffer.bytes[value_start] == Test::ASCII_FALSE_F and buffer.bytes[value_start + 1] == Test::ASCII_FALSE_A and buffer.bytes[value_start + 2] == Test::ASCII_FALSE_L and buffer.bytes[value_start + 3] == Test::ASCII_FALSE_S and buffer.bytes[value_start + 4] == Test::ASCII_FALSE_E
    return false

def encoded_response_contains(buffer: DebuggerProtocolEncoding::JsonBuffer, expected: cstr) -> bool:
    expected_length: mutable usize = 0
    while expected[expected_length] != 0:
        expected_length <- expected_length + 1
    return false if expected_length > buffer.length
    for start in 0..<(buffer.length - expected_length + 1):
        matches: mutable bool = true
        for offset in 0..<expected_length:
            matches <- false if buffer.bytes[start + offset] != expected[offset].u8()
        return true if matches
    return false

def main() -> i64:
    success: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::response_ok(Test::SUCCESS_ID, Test::SUCCESS_GENERATION)
    encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::response_encode(success)
    return 1 if not DebuggerProtocolEncoding::json_buffer_is_valid(encoded)
    return 2 if encoded.length != 87 or encoded.bytes[0] != 123 or encoded.bytes[86] != 125
    invalid_response_id: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::response_ok(0, Test::SUCCESS_GENERATION)
    return 13 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::response_encode(invalid_response_id))
    inconsistent_response: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::ResponseEnvelope{request_id: Test::SUCCESS_ID, ok: true, failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Internal, false, Test::INVALID_DETAIL), stop_generation: Test::SUCCESS_GENERATION, next_page: 0}
    return 14 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::response_encode(inconsistent_response))
    oversized_page: DebuggerProtocol::ResponseEnvelope = DebuggerProtocol::ResponseEnvelope{request_id: Test::SUCCESS_ID, ok: true, failure: DebuggerErrors::no_error(), stop_generation: Test::SUCCESS_GENERATION, next_page: Test::MAX_TRACE_EVENTS + 1}
    return 15 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::response_encode(oversized_page))

    request: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{
        kind: DebuggerProtocol::MessageKind.Request,
        method: DebuggerProtocol::Method.Seek,
        request_id: Test::SUCCESS_ID,
        session_id: Test::SESSION_ID,
        expected_stop_generation: Test::SUCCESS_GENERATION,
        page_size: Test::PAGE_SIZE,
        target_event: Test::TARGET_EVENT
    }
    request_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::request_encode(request)
    return 3 if not DebuggerProtocolEncoding::json_buffer_is_valid(request_encoded)
    parsed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(request_encoded.bytes[0], request_encoded.length)
    return 4 if not parsed.valid or parsed.method != DebuggerProtocolRequest::RequestMethod.Seek
    return 5 if not parsed.has_id or parsed.id != Test::SUCCESS_ID or parsed.expected_generation != Test::SUCCESS_GENERATION or parsed.target_event != Test::TARGET_EVENT

    discovery: DebuggerProtocol::RequestEnvelope = DebuggerProtocol::RequestEnvelope{
        kind: DebuggerProtocol::MessageKind.Request,
        method: DebuggerProtocol::Method.Discover,
        request_id: 0,
        session_id: 0,
        expected_stop_generation: 0,
        page_size: 0,
        target_event: 0
    }
    discovery_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::request_encode(discovery)
    discovery_parsed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(discovery_encoded.bytes[0], discovery_encoded.length)
    return 6 if discovery_encoded.failed or not discovery_parsed.valid or discovery_parsed.has_id
    managed_capabilities: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    discovery_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::discovery_response_encode(Test::SUCCESS_ID, managed_capabilities)
    return 17 if not DebuggerProtocolEncoding::json_buffer_is_valid(discovery_response)
    return 18 if discovery_flag_matches(discovery_response, Test::JSON_KEY_SOURCE_BREAKPOINTS, managed_capabilities.source_breakpoints) == false
    return 19 if discovery_flag_matches(discovery_response, Test::JSON_KEY_REVERSE_EXECUTION, managed_capabilities.reverse_execution) == false
    return 33 if discovery_flag_matches(discovery_response, Test::JSON_KEY_TIMELINE, managed_capabilities.history != DebuggerCapabilities::HistoryKind.None) == false
    return 20 if discovery_flag_matches(discovery_response, Test::JSON_KEY_TYPED_VALUES, managed_capabilities.typed_values) == false
    return 21 if discovery_flag_matches(discovery_response, Test::JSON_KEY_HISTORICAL_QUERIES, managed_capabilities.historical_queries) == false
    return 22 if discovery_flag_matches(discovery_response, Test::JSON_KEY_TRACE_EXPORT, managed_capabilities.trace_export) == false
    return Test::FAILURE_DISCOVERY_CAPABILITY_FIELDS if discovery_flag_matches(discovery_response, Test::JSON_KEY_FUNCTION_BREAKPOINTS, managed_capabilities.function_breakpoints) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_DATA_BREAKPOINTS, managed_capabilities.data_breakpoints) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_EXPRESSION_EVALUATION, managed_capabilities.expression_evaluation) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_CHECKPOINTS, managed_capabilities.checkpoints) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_BRANCHES, managed_capabilities.branches) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_CONCURRENCY_GRAPH, managed_capabilities.concurrency_graph) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_PROVENANCE, managed_capabilities.provenance) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_REMOTE_TRANSPORT, managed_capabilities.remote_transport) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_TRACE_VERIFICATION, managed_capabilities.trace_verification) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_MEMORY_READ, managed_capabilities.memory_read) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_SCHEDULE_EXPLORATION, managed_capabilities.schedule_exploration) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_NATIVE_ATTACH, managed_capabilities.native_attach) == false or discovery_flag_matches(discovery_response, Test::JSON_KEY_POSTMORTEM_INSPECTION, managed_capabilities.postmortem_inspection) == false

    initialize_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::initialize_response_encode(Test::SUCCESS_ID, Test::INITIALIZE_MINOR_REQUEST)
    return Test::FAILURE_INITIALIZE_ENCODING if not DebuggerProtocolEncoding::json_buffer_is_valid(initialize_response) or not encoded_response_contains(initialize_response, Test::INITIALIZE_PROTOCOL_MAJOR) or not encoded_response_contains(initialize_response, Test::INITIALIZE_PROTOCOL_MINOR) or not encoded_response_contains(initialize_response, Test::INITIALIZE_SERVER_NAME)
    incompatible_version: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::initialize_version_error_encode(Test::SUCCESS_ID, Test::INCOMPATIBLE_PROTOCOL_MAJOR)
    return Test::FAILURE_INITIALIZE_ENCODING if not DebuggerProtocolEncoding::json_buffer_is_valid(incompatible_version) or not encoded_response_contains(incompatible_version, Test::INCOMPATIBLE_VERSION_CODE) or not encoded_response_contains(incompatible_version, Test::INCOMPATIBLE_REQUESTED_MAJOR)
    invalid_initialize: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::initialize_arguments_error_encode(Test::SUCCESS_ID)
    return Test::FAILURE_INITIALIZE_ENCODING if not DebuggerProtocolEncoding::json_buffer_is_valid(invalid_initialize) or not encoded_response_contains(invalid_initialize, "\"code\":\"INVALID_ARGUMENT\"")
    initialize_required: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::initialize_required_error_encode(Test::SUCCESS_ID)
    return Test::FAILURE_INITIALIZE_ENCODING if not DebuggerProtocolEncoding::json_buffer_is_valid(initialize_required) or not encoded_response_contains(initialize_required, Test::INITIALIZE_REQUIRED_ERROR_CODE)

    frame: DebuggerManagedInspection::FrameSnapshot = DebuggerManagedInspection::FrameSnapshot{id: DebuggerIdentity::debug_id(Test::FRAME_ID), instruction: DebuggerIdentity::debug_id(Test::FRAME_INSTRUCTION), event: Test::FRAME_EVENT, accumulator: Test::FRAME_ACCUMULATOR, result: Test::FRAME_RESULT, return_depth: Test::FRAME_RETURN_DEPTH}
    frame_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_frame_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, frame)
    return 25 if not DebuggerProtocolEncoding::json_buffer_is_valid(frame_response) or not encoded_response_contains(frame_response, Test::FRAME_ACCUMULATOR_VALUE)
    locals_page: mutable DebuggerManagedInspection::LocalPage = zeroed
    locals_page.count <- Test::LOCAL_COUNT
    locals_page.complete <- true
    locals_page.entries[Test::FIRST_LOCAL_INDEX] <- DebuggerManagedInspection::LocalSnapshot{index: Test::FIRST_LOCAL_INDEX, value: Test::FIRST_LOCAL_VALUE, available: true}
    locals_page.entries[Test::SECOND_LOCAL_INDEX] <- DebuggerManagedInspection::LocalSnapshot{index: Test::SECOND_LOCAL_INDEX, value: 0, available: false}
    locals_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_locals_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, Test::TARGET_EVENT, locals_page)
    return 26 if not DebuggerProtocolEncoding::json_buffer_is_valid(locals_response) or not encoded_response_contains(locals_response, Test::LOCAL_UNAVAILABLE_VALUE)
    memory_read: mutable DebuggerMemory::MemoryRead = zeroed
    memory_read.address <- 8
    memory_read.length <- 4
    memory_read.state <- DebuggerMemory::MemoryState.Available
    memory_read.failure <- DebuggerErrors::no_error()
    memory_read.bytes[0] <- 0
    memory_read.bytes[1] <- 1
    memory_read.bytes[2] <- 254
    memory_read.bytes[3] <- 127
    memory_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_memory_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, memory_read)
    return 35 if not DebuggerProtocolEncoding::json_buffer_is_valid(memory_response) or not encoded_response_contains(memory_response, Test::MEMORY_RESPONSE_ADDRESS) or not encoded_response_contains(memory_response, Test::MEMORY_RESPONSE_STATE) or not encoded_response_contains(memory_response, Test::MEMORY_RESPONSE_BYTES)
    invalid_memory_response: mutable DebuggerMemory::MemoryRead = memory_read
    invalid_memory_response.state <- DebuggerMemory::MemoryState.Invalid
    return 36 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::managed_memory_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, invalid_memory_response))
    checkpoint_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_checkpoint_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, 3, 99)
    return 37 if not DebuggerProtocolEncoding::json_buffer_is_valid(checkpoint_response) or not encoded_response_contains(checkpoint_response, Test::CHECKPOINT_RESPONSE_EVENT) or not encoded_response_contains(checkpoint_response, Test::CHECKPOINT_RESPONSE_HASH)
    branch_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_branch_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, 2)
    return 38 if not DebuggerProtocolEncoding::json_buffer_is_valid(branch_response) or not encoded_response_contains(branch_response, Test::BRANCH_RESPONSE_ID)
    return 39 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::managed_branch_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, 0))
    oversized_locals_page: mutable DebuggerManagedInspection::LocalPage = zeroed
    oversized_locals_page.count <- DebuggerManagedInspection::local_page_capacity() + 1
    return Test::FAILURE_OVERSIZED_LOCAL_PAGE if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::managed_locals_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, Test::TARGET_EVENT, oversized_locals_page))
    scopes_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_scopes_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION, 2)
    return 27 if not DebuggerProtocolEncoding::json_buffer_is_valid(scopes_response) or scopes_response.bytes[scopes_response.length - 1] != 125
    threads_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_threads_response_encode(Test::SUCCESS_ID, Test::SUCCESS_GENERATION)
    return Test::FAILURE_THREAD_RESPONSE if not DebuggerProtocolEncoding::json_buffer_is_valid(threads_response) or not encoded_response_contains(threads_response, Test::THREADS_RESPONSE_FRAGMENT)
    invalid_thread_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_threads_response_encode(0, Test::SUCCESS_GENERATION)
    return Test::FAILURE_INVALID_THREAD_REQUEST_ID if DebuggerProtocolEncoding::json_buffer_is_valid(invalid_thread_response)
    restricted_capabilities: mutable DebuggerCapabilities::CapabilitySet = managed_capabilities
    restricted_capabilities.source_breakpoints <- false
    restricted_capabilities.reverse_execution <- false
    restricted_capabilities.typed_values <- false
    restricted_capabilities.trace_export <- false
    restricted_capabilities.memory_read <- false
    restricted_capabilities.checkpoints <- false
    restricted_capabilities.branches <- false
    restricted_capabilities.trace_verification <- false
    restricted_discovery: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::discovery_response_encode(Test::SUCCESS_ID, restricted_capabilities)
    return 23 if discovery_flag_matches(restricted_discovery, Test::JSON_KEY_SOURCE_BREAKPOINTS, false) == false or discovery_flag_matches(restricted_discovery, Test::JSON_KEY_REVERSE_EXECUTION, false) == false or discovery_flag_matches(restricted_discovery, Test::JSON_KEY_TYPED_VALUES, false) == false or discovery_flag_matches(restricted_discovery, Test::JSON_KEY_TRACE_EXPORT, false) == false or discovery_flag_matches(restricted_discovery, Test::JSON_KEY_MEMORY_READ, false) == false or discovery_flag_matches(restricted_discovery, Test::JSON_KEY_CHECKPOINTS, false) == false or discovery_flag_matches(restricted_discovery, Test::JSON_KEY_BRANCHES, false) == false or discovery_flag_matches(restricted_discovery, Test::JSON_KEY_TRACE_VERIFICATION, false) == false

    invalid_id: DebuggerProtocol::RequestEnvelope = request
    invalid_id.request_id <- 0
    invalid_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::request_encode(invalid_id)
    return 7 if not invalid_encoded.failed

    invalid_page: DebuggerProtocol::RequestEnvelope = request
    invalid_page.page_size <- Test::MAX_PAGE_SIZE + 1
    invalid_page_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::request_encode(invalid_page)
    return 8 if not invalid_page_encoded.failed

    integration_request: DebuggerProtocolIntegration::SessionRequest = DebuggerProtocolIntegration::SessionRequest{
        client: DebuggerProtocolIntegration::ClientIdentity{
            name: DebuggerIdentity::debug_id(Test::CLIENT_NAME),
            version: DebuggerIdentity::debug_id(Test::CLIENT_VERSION),
            instance: DebuggerIdentity::debug_id(Test::CLIENT_INSTANCE)
        },
        request_id: Test::SUCCESS_ID,
        session_id: Test::SESSION_ID,
        owner_token: Test::OWNER_TOKEN,
        expected_generation: Test::SUCCESS_GENERATION,
        method: DebuggerProtocol::Method.Seek,
        page_size: Test::PAGE_SIZE,
        target_event: Test::TARGET_EVENT
    }
    integration_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::session_request_encode(integration_request)
    return 9 if not DebuggerProtocolEncoding::json_buffer_is_valid(integration_encoded)
    integration_parsed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(integration_encoded.bytes[0], integration_encoded.length)
    return 10 if not integration_parsed.valid or integration_parsed.id != Test::SUCCESS_ID or integration_parsed.expected_generation != Test::SUCCESS_GENERATION or integration_parsed.target_event != Test::TARGET_EVENT

    integration_response: DebuggerProtocolIntegration::SessionResponse = DebuggerProtocolIntegration::SessionResponse{
        request_id: Test::SUCCESS_ID,
        session_id: Test::SESSION_ID,
        stop_generation: Test::SUCCESS_GENERATION,
        accepted: true,
        next_page: 0,
        failure: DebuggerErrors::no_error()
    }
    response_encoded: mutable DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::session_response_encode(integration_response)
    return 11 if not DebuggerProtocolEncoding::json_buffer_is_valid(response_encoded)
    invalid_response: DebuggerProtocolIntegration::SessionResponse = DebuggerProtocolIntegration::SessionResponse{
        request_id: Test::SUCCESS_ID,
        session_id: Test::SESSION_ID,
        stop_generation: Test::SUCCESS_GENERATION,
        accepted: true,
        next_page: 0,
        failure: DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Internal, false, 1)
    }
    return 12 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::session_response_encode(invalid_response))
    oversized_session_page: DebuggerProtocolIntegration::SessionResponse = integration_response
    oversized_session_page.next_page <- Test::MAX_TRACE_EVENTS + 1
    return 16 if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::session_response_encode(oversized_session_page))

    timeline_position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::TIMELINE_RECORDING_ID))
    timeline_position.branch <- DebuggerIdentity::debug_id(Test::TIMELINE_BRANCH_ID)
    timeline_position.event <- Test::TIMELINE_EVENT
    timeline: mutable DebuggerTimeline::Timeline = DebuggerTimeline::timeline_new(timeline_position, managed_capabilities)
    timeline.bounds.retained_first <- Test::TIMELINE_FIRST_EVENT
    timeline.bounds.retained_last <- Test::TIMELINE_LAST_EVENT
    timeline.bounds.exact_first <- Test::TIMELINE_FIRST_EVENT
    timeline.bounds.exact_last <- Test::TIMELINE_LAST_EVENT
    timeline.bounds.current <- Test::TIMELINE_EVENT
    bookmark: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_add_bookmark(timeline, DebuggerIdentity::debug_id(Test::TIMELINE_LABEL_ID), DebuggerIdentity::debug_id(Test::TIMELINE_NOTE_ID), true)
    return Test::FAILURE_TIMELINE_ENCODING if not bookmark.accepted
    timeline_response: DebuggerProtocolEncoding::JsonBuffer = DebuggerProtocolEncoding::managed_timeline_response_encode(Test::SUCCESS_ID, Test::TIMELINE_GENERATION, bookmark.timeline, true, Test::TIMELINE_CHECKPOINT_EVENT, Test::TIMELINE_CHECKPOINT_HASH)
    return Test::FAILURE_TIMELINE_ENCODING if not DebuggerProtocolEncoding::json_buffer_is_valid(timeline_response) or not encoded_response_contains(timeline_response, Test::TIMELINE_FIELD) or not encoded_response_contains(timeline_response, Test::TIMELINE_POSITION) or not encoded_response_contains(timeline_response, Test::TIMELINE_RETAINED_BOUNDS) or not encoded_response_contains(timeline_response, Test::TIMELINE_BOOKMARK) or not encoded_response_contains(timeline_response, Test::TIMELINE_CHECKPOINT) or timeline_response.bytes[timeline_response.length - 1] != Test::ASCII_BRACE_CLOSE
    malformed_timeline: mutable DebuggerTimeline::Timeline = bookmark.timeline
    malformed_timeline.bounds.retained_first <- Test::TIMELINE_LAST_EVENT
    malformed_timeline.bounds.retained_last <- Test::TIMELINE_FIRST_EVENT
    return Test::FAILURE_TIMELINE_ENCODING if DebuggerProtocolEncoding::json_buffer_is_valid(DebuggerProtocolEncoding::managed_timeline_response_encode(Test::SUCCESS_ID, Test::TIMELINE_GENERATION, malformed_timeline, false, Test::TIMELINE_NO_CHECKPOINT_EVENT, Test::TIMELINE_NO_CHECKPOINT_HASH))
    return Test::SUCCESS
