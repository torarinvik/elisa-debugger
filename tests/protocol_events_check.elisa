include "../src/protocol/events.elisa"

const module Test:
    SESSION_ID: u64 = 1
    PAYLOAD_ID: u64 = 2
    FIRST_EVENT_SEQUENCE: u64 = 1
    GENERATION: u64 = 3
    PROGRESS_COMPLETED: u64 = 1
    PROGRESS_TOTAL: u64 = 2
    INVALID_EVENT_RESULT: i64 = 6
    CORRUPT_ACK_RESULT: i64 = 7
    INVALID_QUEUE_COUNT: usize = 65


def main() -> i64:
    queue: mutable DebuggerProtocolEvents::EventQueue = DebuggerProtocolEvents::event_queue_new()
    emitted: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_emit(queue, DebuggerIdentity::debug_id(Test::SESSION_ID), Test::GENERATION, DebuggerProtocolEvents::EventKind.Progress, DebuggerProtocolEvents::OutputChannel.Telemetry, DebuggerIdentity::debug_id(Test::PAYLOAD_ID), Test::PROGRESS_COMPLETED, Test::PROGRESS_TOTAL)
    return 1 if not DebuggerErrors::error_is_ok(emitted) or not DebuggerProtocolEvents::event_queue_is_valid(queue)
    queued_event: DebuggerProtocolEvents::Event = DebuggerProtocolEvents::event_queue_peek(queue)
    return 2 if queued_event.sequence != Test::FIRST_EVENT_SEQUENCE or queued_event.progress_completed != Test::PROGRESS_COMPLETED
    wrong_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, Test::PAYLOAD_ID)
    return 3 if wrong_ack.code != DebuggerErrors::ErrorCode.InvalidArgument
    return Test::INVALID_EVENT_RESULT if DebuggerProtocolEvents::event_queue_is_valid(queue)
    acknowledged: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, Test::FIRST_EVENT_SEQUENCE)
    return 4 if not DebuggerErrors::error_is_ok(acknowledged) or DebuggerProtocolEvents::event_queue_count(queue) != 0
    empty_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, Test::FIRST_EVENT_SEQUENCE)
    return 5 if empty_ack.code != DebuggerErrors::ErrorCode.Unavailable
    invalid_generation: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_emit(queue, DebuggerIdentity::debug_id(Test::SESSION_ID), 0, DebuggerProtocolEvents::EventKind.Progress, DebuggerProtocolEvents::OutputChannel.Telemetry, DebuggerIdentity::debug_id(Test::PAYLOAD_ID), Test::PROGRESS_COMPLETED, Test::PROGRESS_TOTAL)
    return 6 if invalid_generation.code != DebuggerErrors::ErrorCode.InvalidArgument
    corrupt_queue: mutable DebuggerProtocolEvents::EventQueue = DebuggerProtocolEvents::event_queue_new()
    corrupt_queue.count <- Test::INVALID_QUEUE_COUNT
    corrupt_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(corrupt_queue, Test::FIRST_EVENT_SEQUENCE)
    return Test::CORRUPT_ACK_RESULT if corrupt_ack.code != DebuggerErrors::ErrorCode.Corrupt or corrupt_queue.last_error.code != DebuggerErrors::ErrorCode.Corrupt
    return 0
