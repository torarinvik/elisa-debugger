include "../src/protocol/events.elisa"

const module Test:
    const module Queue:
        SESSION_ID: u64 = 1
        PAYLOAD_ID: u64 = 2
        FIRST_EVENT_SEQUENCE: u64 = 1
        GENERATION: u64 = 3
        PROGRESS_COMPLETED: u64 = 1
        PROGRESS_TOTAL: u64 = 2
        EMPTY_COUNT: usize = 0
        INVALID_GENERATION: u64 = 0
        INVALID_QUEUE_COUNT: usize = 65
        RESULT_EMIT_FAILURE: i64 = 1
        RESULT_PEEK_FAILURE: i64 = 2
        RESULT_ACK_REJECTION_FAILURE: i64 = 3
        RESULT_ACK_FAILURE: i64 = 4
        RESULT_EMPTY_ACK_FAILURE: i64 = 5
        INVALID_EVENT_RESULT: i64 = 6
        CORRUPT_ACK_RESULT: i64 = 7
        REINITIALIZATION_FAILURE: i64 = 8
        INVALID_GENERATION_FAILURE: i64 = 9
        SUCCESS: i64 = 0


def main() -> i64:
    queue: mutable DebuggerProtocolEvents::EventQueue = zeroed
    DebuggerProtocolEvents::event_queue_initialize(queue)
    emitted: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_emit(queue, DebuggerIdentity::debug_id(Test::Queue::SESSION_ID), Test::Queue::GENERATION, DebuggerProtocolEvents::EventKind.Progress, DebuggerProtocolEvents::OutputChannel.Telemetry, DebuggerIdentity::debug_id(Test::Queue::PAYLOAD_ID), Test::Queue::PROGRESS_COMPLETED, Test::Queue::PROGRESS_TOTAL)
    return Test::Queue::RESULT_EMIT_FAILURE if not DebuggerErrors::error_is_ok(emitted) or not DebuggerProtocolEvents::event_queue_is_valid(queue)
    queued_event: DebuggerProtocolEvents::Event = DebuggerProtocolEvents::event_queue_peek(queue)
    return Test::Queue::RESULT_PEEK_FAILURE if queued_event.sequence != Test::Queue::FIRST_EVENT_SEQUENCE or queued_event.progress_completed != Test::Queue::PROGRESS_COMPLETED
    wrong_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, Test::Queue::PAYLOAD_ID)
    return Test::Queue::RESULT_ACK_REJECTION_FAILURE if wrong_ack.code != DebuggerErrors::ErrorCode.InvalidArgument
    return Test::Queue::INVALID_EVENT_RESULT if DebuggerProtocolEvents::event_queue_is_valid(queue)
    acknowledged: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, Test::Queue::FIRST_EVENT_SEQUENCE)
    return Test::Queue::RESULT_ACK_FAILURE if not DebuggerErrors::error_is_ok(acknowledged) or DebuggerProtocolEvents::event_queue_count(queue) != Test::Queue::EMPTY_COUNT
    empty_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, Test::Queue::FIRST_EVENT_SEQUENCE)
    return Test::Queue::RESULT_EMPTY_ACK_FAILURE if empty_ack.code != DebuggerErrors::ErrorCode.Unavailable
    invalid_generation: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_emit(queue, DebuggerIdentity::debug_id(Test::Queue::SESSION_ID), Test::Queue::INVALID_GENERATION, DebuggerProtocolEvents::EventKind.Progress, DebuggerProtocolEvents::OutputChannel.Telemetry, DebuggerIdentity::debug_id(Test::Queue::PAYLOAD_ID), Test::Queue::PROGRESS_COMPLETED, Test::Queue::PROGRESS_TOTAL)
    return Test::Queue::INVALID_GENERATION_FAILURE if invalid_generation.code != DebuggerErrors::ErrorCode.InvalidArgument
    dirty_queue: mutable DebuggerProtocolEvents::EventQueue = zeroed
    DebuggerProtocolEvents::event_queue_initialize(dirty_queue)
    _ = DebuggerProtocolEvents::event_queue_emit(dirty_queue, DebuggerIdentity::debug_id(Test::Queue::SESSION_ID), Test::Queue::GENERATION, DebuggerProtocolEvents::EventKind.Progress, DebuggerProtocolEvents::OutputChannel.Telemetry, DebuggerIdentity::debug_id(Test::Queue::PAYLOAD_ID), Test::Queue::PROGRESS_COMPLETED, Test::Queue::PROGRESS_TOTAL)
    DebuggerProtocolEvents::event_queue_initialize(dirty_queue)
    return Test::Queue::REINITIALIZATION_FAILURE if dirty_queue.count != Test::Queue::EMPTY_COUNT or dirty_queue.next_sequence != Test::Queue::FIRST_EVENT_SEQUENCE or dirty_queue.overflowed or not DebuggerProtocolEvents::event_queue_is_valid(dirty_queue)
    corrupt_queue: mutable DebuggerProtocolEvents::EventQueue = zeroed
    DebuggerProtocolEvents::event_queue_initialize(corrupt_queue)
    corrupt_queue.count <- Test::Queue::INVALID_QUEUE_COUNT
    corrupt_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(corrupt_queue, Test::Queue::FIRST_EVENT_SEQUENCE)
    return Test::Queue::CORRUPT_ACK_RESULT if corrupt_ack.code != DebuggerErrors::ErrorCode.Corrupt or corrupt_queue.last_error.code != DebuggerErrors::ErrorCode.Corrupt
    return Test::Queue::SUCCESS
