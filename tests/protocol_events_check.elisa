include "../src/protocol/events.elisa"

const TEST_SESSION_ID: u64 = 1
const TEST_PAYLOAD_ID: u64 = 2
const FIRST_EVENT_SEQUENCE: u64 = 1
const TEST_GENERATION: u64 = 3
const TEST_PROGRESS_COMPLETED: u64 = 1
const TEST_PROGRESS_TOTAL: u64 = 2
const INVALID_EVENT_RESULT: i64 = 6
const CORRUPT_ACK_RESULT: i64 = 7
const INVALID_QUEUE_COUNT: usize = 65

def main() -> i64:
    queue: mutable DebuggerProtocolEvents::EventQueue = DebuggerProtocolEvents::event_queue_new()
    emitted: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_emit(queue, DebuggerIdentity::debug_id(TEST_SESSION_ID), TEST_GENERATION, DebuggerProtocolEvents::EventKind.Progress, DebuggerProtocolEvents::OutputChannel.Telemetry, DebuggerIdentity::debug_id(TEST_PAYLOAD_ID), TEST_PROGRESS_COMPLETED, TEST_PROGRESS_TOTAL)
    return 1 if not DebuggerErrors::error_is_ok(emitted) or not DebuggerProtocolEvents::event_queue_is_valid(queue)
    queued_event: DebuggerProtocolEvents::Event = DebuggerProtocolEvents::event_queue_peek(queue)
    return 2 if queued_event.sequence != FIRST_EVENT_SEQUENCE or queued_event.progress_completed != TEST_PROGRESS_COMPLETED
    wrong_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, TEST_PAYLOAD_ID)
    return 3 if wrong_ack.code != DebuggerErrors::ErrorCode.InvalidArgument
    return INVALID_EVENT_RESULT if DebuggerProtocolEvents::event_queue_is_valid(queue)
    acknowledged: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, FIRST_EVENT_SEQUENCE)
    return 4 if not DebuggerErrors::error_is_ok(acknowledged) or DebuggerProtocolEvents::event_queue_count(queue) != 0
    empty_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(queue, FIRST_EVENT_SEQUENCE)
    return 5 if empty_ack.code != DebuggerErrors::ErrorCode.Unavailable
    corrupt_queue: mutable DebuggerProtocolEvents::EventQueue = DebuggerProtocolEvents::event_queue_new()
    corrupt_queue.count <- INVALID_QUEUE_COUNT
    corrupt_ack: DebuggerErrors::DebuggerError = DebuggerProtocolEvents::event_queue_ack(corrupt_queue, FIRST_EVENT_SEQUENCE)
    return CORRUPT_ACK_RESULT if corrupt_ack.code != DebuggerErrors::ErrorCode.Corrupt or corrupt_queue.last_error.code != DebuggerErrors::ErrorCode.Corrupt
    return 0
