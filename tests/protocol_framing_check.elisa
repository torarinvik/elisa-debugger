include "../src/protocol/framing.elisa"

const module Test:
    EMPTY_FRAME_LENGTH: usize = 3
    PAYLOAD_FRAME_LENGTH: usize = 7
    PAYLOAD_LENGTH: usize = 4
    OVERSIZED_LENGTH: usize = 65537
    EXPECTED_PAYLOAD_BYTE: u8 = 68


def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    empty_payload: mutable u8[1] = zeroed
    empty: DebuggerProtocolFraming::FrameBuffer = DebuggerProtocolFraming::frame_encode(empty_payload[0], 0)
    return 1 if not DebuggerProtocolFraming::frame_buffer_is_valid(empty) or empty.length != Test::EMPTY_FRAME_LENGTH or empty.bytes[0] != 48 or empty.bytes[1] != 32 or empty.bytes[2] != 10

    payload: mutable u8[Test::PAYLOAD_LENGTH] = [65, 66, 67, Test::EXPECTED_PAYLOAD_BYTE]
    encoded: DebuggerProtocolFraming::FrameBuffer = DebuggerProtocolFraming::frame_encode(payload[0], Test::PAYLOAD_LENGTH)
    return 2 if not DebuggerProtocolFraming::frame_buffer_is_valid(encoded) or encoded.length != Test::PAYLOAD_FRAME_LENGTH or encoded.bytes[0] != 52 or encoded.bytes[1] != 32 or encoded.bytes[2] != 65 or encoded.bytes[5] != Test::EXPECTED_PAYLOAD_BYTE or encoded.bytes[6] != 10

    decoder: mutable DebuggerProtocolFraming::FrameDecoder = DebuggerProtocolFraming::frame_decoder_new()
    complete: mutable bool = false
    for index in 0..<encoded.length:
        complete <- DebuggerProtocolFraming::frame_decoder_accept(decoder, encoded.bytes[index])
    return 3 if not complete or not DebuggerProtocolFraming::frame_decoder_is_complete(decoder) or DebuggerProtocolFraming::frame_decoder_length(decoder) != Test::PAYLOAD_LENGTH or decoder.payload[3] != Test::EXPECTED_PAYLOAD_BYTE

    # A decoder must be reset between frames so a stale completed frame cannot
    # consume bytes from a subsequent message.
    DebuggerProtocolFraming::frame_decoder_reset(decoder)
    for index in 0..<encoded.length:
        _ = DebuggerProtocolFraming::frame_decoder_accept(decoder, encoded.bytes[index])
    return 4 if not DebuggerProtocolFraming::frame_decoder_is_complete(decoder)

    oversized_payload: mutable u8[1] = zeroed
    oversized: DebuggerProtocolFraming::FrameBuffer = DebuggerProtocolFraming::frame_encode(oversized_payload[0], Test::OVERSIZED_LENGTH)
    return 5 if DebuggerProtocolFraming::frame_buffer_is_valid(oversized)
    return 0
