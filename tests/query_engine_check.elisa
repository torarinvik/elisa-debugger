include "../src/query/engine.elisa"

const module Test:
    QUERY_FIRST_EVENT: u64 = 0
    QUERY_LAST_EVENT: u64 = 10
    QUERY_MAX_RESULTS: u64 = 8
    QUERY_MAX_STEPS: u64 = 64
    BINDING: u64 = 11
    ALLOCATION: u64 = 12
    SOURCE: u64 = 13
    CANCELLED_RESULT: i64 = 1
    MATCH_RESULT: i64 = 2
    NEXT_RESULT: i64 = 3
    MAX_EVENT: u64 = 18446744073709551615
    BUDGET_RESULT: i64 = 4
    DEADLINE_RESULT: i64 = 5
    FIRST_CHANGE_RESULT: i64 = 6
    PARTIAL_FIRST_CHANGE_RESULT: i64 = 7
    SINGLE_RESULT_LIMIT: u64 = 1
    QUERY_RESULT_CAPACITY: usize = 64
    LARGE_RESULT_LIMIT: u64 = 65
    LARGE_INDEX_COUNT: usize = Test::QUERY_RESULT_CAPACITY + 1
    LARGE_RESULT_FAILURE: i64 = 8
    EXACT_CAPACITY_RESULT: i64 = 17
    EXACT_CAPACITY_LAST_EVENT: u64 = Test::QUERY_RESULT_CAPACITY.u64() - 1
    EXACT_CAPACITY_STEP_LIMIT: u64 = Test::QUERY_RESULT_CAPACITY.u64()
    EMPTY_CANCEL_FAILURE: i64 = 9
    INVALID_PROVENANCE_COUNT: usize = 513
    INVALID_PROVENANCE_RESULT: i64 = 10
    NON_WRITE_FILTER_RESULT: i64 = 11
    ALLOCATION_WRITE_FILTER_RESULT: i64 = 12
    RESUMED_FIRST_CHANGE_RESULT: i64 = 13
    EXPECTED_RESUMED_CHANGE_EVENT: u64 = 3
    FIRST_PAGE_UNCHANGED_HASH: u64 = 100
    SINGLE_STEP_LIMIT: u64 = 1
    QUERY_PAGE_BUDGET_RESULT: i64 = 14


def main() -> i64:
    binding: DebuggerIdentity::BindingIdentity = DebuggerIdentity::BindingIdentity{declaration: DebuggerIdentity::debug_id(Test::BINDING), incarnation: 1}
    mutation: DebuggerProvenance::Mutation = DebuggerProvenance::Mutation{
        event: 4,
        binding: binding,
        allocation: DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(Test::ALLOCATION), generation: 1, offset: 0},
        kind: DebuggerProvenance::MutationKind.Assignment,
        value_hash: 99,
        source: DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(Test::SOURCE), start_byte: 0, end_byte: 1, start_line: 1, start_column: 0, end_line: 1, end_column: 1, discriminator: 0}
    }
    index: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_append(DebuggerProvenance::provenance_new(), mutation)
    window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: Test::QUERY_FIRST_EVENT, last_event: Test::QUERY_LAST_EVENT, max_results: Test::QUERY_MAX_RESULTS, max_steps: Test::QUERY_MAX_STEPS}
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
    cancelled_empty_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_cancel(token)
    cancelled_empty: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(DebuggerProvenance::provenance_new(), binding, window, cancelled_empty_token)
    return Test::EMPTY_CANCEL_FAILURE if not cancelled_empty.cancelled or cancelled_empty.failure.code != DebuggerErrors::ErrorCode.Cancelled
    result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(index, binding, window, token)
    return Test::MATCH_RESULT if result.count != 1 or result.matches[0].event != mutation.event or not result.complete
    lifecycle_mutation: mutable DebuggerProvenance::Mutation = mutation
    lifecycle_mutation.event <- 9
    lifecycle_mutation.kind <- DebuggerProvenance::MutationKind.Deallocation
    lifecycle_index: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_append(index, lifecycle_mutation)
    lifecycle_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(lifecycle_index, binding, window, token)
    return Test::NON_WRITE_FILTER_RESULT if lifecycle_result.count != 1 or lifecycle_result.matches[0].event != mutation.event
    return Test::NON_WRITE_FILTER_RESULT if DebuggerQueryEngine::query_find_next_write(lifecycle_index, binding, mutation.event, window).event != 0
    allocation_write: DebuggerProvenance::Mutation = DebuggerProvenance::provenance_last_allocation_write(lifecycle_index, mutation.allocation, Test::QUERY_LAST_EVENT + 1)
    return Test::ALLOCATION_WRITE_FILTER_RESULT if allocation_write.event != mutation.event or allocation_write.kind != DebuggerProvenance::MutationKind.Assignment
    capped_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: Test::QUERY_FIRST_EVENT, last_event: Test::QUERY_LAST_EVENT, max_results: Test::SINGLE_RESULT_LIMIT, max_steps: Test::QUERY_MAX_STEPS}
    capped_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(index, binding, capped_window, token)
    return Test::MATCH_RESULT if capped_result.count != Test::SINGLE_RESULT_LIMIT or not capped_result.complete
    large_index: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_new()
    for event_index in 0..<Test::LARGE_INDEX_COUNT:
        large_mutation: mutable DebuggerProvenance::Mutation = mutation
        large_mutation.event <- event_index.u64()
        large_index <- DebuggerProvenance::provenance_append(large_index, large_mutation)
    large_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: Test::QUERY_FIRST_EVENT, last_event: Test::QUERY_LAST_EVENT + Test::LARGE_INDEX_COUNT.u64(), max_results: Test::LARGE_RESULT_LIMIT, max_steps: Test::QUERY_MAX_STEPS}
    large_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(large_index, binding, large_window, token)
    return Test::LARGE_RESULT_FAILURE if large_result.count != Test::QUERY_RESULT_CAPACITY or large_result.complete or large_result.failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    exact_capacity_index: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_new()
    for event_index in 0..<Test::QUERY_RESULT_CAPACITY:
        exact_capacity_mutation: mutable DebuggerProvenance::Mutation = mutation
        exact_capacity_mutation.event <- event_index.u64()
        exact_capacity_index <- DebuggerProvenance::provenance_append(exact_capacity_index, exact_capacity_mutation)
    exact_capacity_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: Test::QUERY_FIRST_EVENT, last_event: Test::EXACT_CAPACITY_LAST_EVENT, max_results: Test::LARGE_RESULT_LIMIT, max_steps: Test::EXACT_CAPACITY_STEP_LIMIT}
    exact_capacity: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(exact_capacity_index, binding, exact_capacity_window, token)
    return Test::EXACT_CAPACITY_RESULT if exact_capacity.count != Test::QUERY_RESULT_CAPACITY or not exact_capacity.complete or exact_capacity.next_index != Test::QUERY_RESULT_CAPACITY or not DebuggerErrors::error_is_ok(exact_capacity.failure)
    invalid_index: mutable DebuggerProvenance::ProvenanceIndex = index
    invalid_index.count <- Test::INVALID_PROVENANCE_COUNT
    invalid_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(invalid_index, binding, window, token)
    return Test::INVALID_PROVENANCE_RESULT if invalid_result.failure.code != DebuggerErrors::ErrorCode.ResourceLimit or invalid_result.scanned != 0
    invalid_next: DebuggerProvenance::Mutation = DebuggerQueryEngine::query_find_next_write(invalid_index, binding, 0, window)
    return Test::INVALID_PROVENANCE_RESULT if invalid_next.event != 0
    malformed_provenance: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_new()
    malformed_mutation: DebuggerProvenance::Mutation = mutation
    malformed_mutation.binding.declaration <- DebuggerIdentity::debug_id(0)
    malformed_provenance <- DebuggerProvenance::provenance_append(malformed_provenance, malformed_mutation)
    return 12 if not malformed_provenance.overflowed or DebuggerProvenance::provenance_is_complete(malformed_provenance)
    deadline_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(1)
    deadline_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(index, binding, window, deadline_token)
    return Test::DEADLINE_RESULT if not deadline_result.cancelled or deadline_result.failure.code != DebuggerErrors::ErrorCode.Cancelled
    next: DebuggerProvenance::Mutation = DebuggerQueryEngine::query_find_next_write(index, binding, 0, window)
    return Test::NEXT_RESULT if next.event != mutation.event
    cancelled_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_cancel(token)
    cancelled: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(index, binding, window, cancelled_token)
    return Test::CANCELLED_RESULT if not cancelled.cancelled or cancelled.failure.code != DebuggerErrors::ErrorCode.Cancelled
    max_mutation: DebuggerProvenance::Mutation = mutation
    max_mutation.event <- Test::MAX_EVENT
    max_index: DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_append(index, max_mutation)
    max_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: 0, last_event: Test::MAX_EVENT, max_results: Test::QUERY_MAX_RESULTS, max_steps: Test::QUERY_MAX_STEPS}
    max_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(max_index, binding, max_window, token)
    return Test::BUDGET_RESULT if max_result.next_event != Test::MAX_EVENT
    budget_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: 0, last_event: Test::QUERY_LAST_EVENT, max_results: Test::QUERY_MAX_RESULTS, max_steps: 1}
    budget_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(max_index, DebuggerIdentity::BindingIdentity{declaration: DebuggerIdentity::debug_id(Test::BINDING + 1), incarnation: 1}, budget_window, token)
    return Test::BUDGET_RESULT if budget_result.failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    later_mutation: DebuggerProvenance::Mutation = mutation
    later_mutation.event <- 8
    later_mutation.value_hash <- 100
    earlier_mutation: DebuggerProvenance::Mutation = mutation
    earlier_mutation.event <- 3
    earlier_mutation.value_hash <- 101
    unordered: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_new()
    unordered <- DebuggerProvenance::provenance_append(unordered, later_mutation)
    unordered <- DebuggerProvenance::provenance_append(unordered, earlier_mutation)
    first_change: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_first_change(unordered, binding, window, 0, token)
    return Test::FIRST_CHANGE_RESULT if first_change.count != 1 or first_change.matches[0].event != 3
    partial_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: 0, last_event: Test::QUERY_LAST_EVENT, max_results: 1, max_steps: Test::QUERY_MAX_STEPS}
    partial_first_change: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_first_change(unordered, binding, partial_window, 0, token)
    return Test::PARTIAL_FIRST_CHANGE_RESULT if partial_first_change.complete or partial_first_change.count != 1
    exhausted_page_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: 0, last_event: Test::QUERY_LAST_EVENT, max_results: Test::SINGLE_RESULT_LIMIT, max_steps: Test::SINGLE_STEP_LIMIT}
    exhausted_page: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(unordered, binding, exhausted_page_window, token)
    return Test::QUERY_PAGE_BUDGET_RESULT if exhausted_page.complete or exhausted_page.next_index != 1 or exhausted_page.failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    resumed: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_resume_writes(DebuggerQueryEngine::query_find_writes(unordered, binding, partial_window, token), unordered, binding, token)
    return Test::PARTIAL_FIRST_CHANGE_RESULT if not resumed.complete or resumed.count != 1 or resumed.matches[0].event != earlier_mutation.event
    first_change_page: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_first_change(unordered, binding, partial_window, Test::FIRST_PAGE_UNCHANGED_HASH, token)
    return Test::RESUMED_FIRST_CHANGE_RESULT if first_change_page.complete or first_change_page.count != 0
    resumed_first_change: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_resume_first_change(first_change_page, unordered, binding, Test::FIRST_PAGE_UNCHANGED_HASH, token)
    return Test::RESUMED_FIRST_CHANGE_RESULT if not resumed_first_change.complete or resumed_first_change.count != 1 or resumed_first_change.matches[0].event != Test::EXPECTED_RESUMED_CHANGE_EVENT or resumed_first_change.matches[0].mutation.value_hash == Test::FIRST_PAGE_UNCHANGED_HASH
    left_samples: mutable DebuggerQueryEngine::StateSample[2] = [DebuggerQueryEngine::StateSample{event: 9, value_hash: 7}, DebuggerQueryEngine::StateSample{event: 4, value_hash: 11}]
    right_samples: mutable DebuggerQueryEngine::StateSample[2] = [DebuggerQueryEngine::StateSample{event: 8, value_hash: 7}, DebuggerQueryEngine::StateSample{event: 3, value_hash: 11}]
    series: DebuggerQueryEngine::StateDifference = DebuggerQueryEngine::query_compare_series(left_samples[0], 2, right_samples[0], 2)
    return 6 if series.left.event != 4 or series.right.event != 3 or series.left.value_hash != 11 or series.right.value_hash != 11 or series.different
    return 0
