include "../src/query/engine.elisa"

const QUERY_FIRST_EVENT: u64 = 0
const QUERY_LAST_EVENT: u64 = 10
const QUERY_MAX_RESULTS: u64 = 8
const QUERY_MAX_STEPS: u64 = 64
const TEST_BINDING: u64 = 11
const TEST_ALLOCATION: u64 = 12
const TEST_SOURCE: u64 = 13
const CANCELLED_RESULT: i64 = 1
const MATCH_RESULT: i64 = 2
const NEXT_RESULT: i64 = 3
const MAX_EVENT: u64 = 18446744073709551615
const BUDGET_RESULT: i64 = 4
const DEADLINE_RESULT: i64 = 5
const FIRST_CHANGE_RESULT: i64 = 6
const PARTIAL_FIRST_CHANGE_RESULT: i64 = 7
const SINGLE_RESULT_LIMIT: u64 = 1
const QUERY_RESULT_CAPACITY: usize = 64
const LARGE_RESULT_LIMIT: u64 = 65
const LARGE_INDEX_COUNT: usize = QUERY_RESULT_CAPACITY + 1
const LARGE_RESULT_FAILURE: i64 = 8
const EMPTY_CANCEL_FAILURE: i64 = 9
const INVALID_PROVENANCE_COUNT: usize = 513
const INVALID_PROVENANCE_RESULT: i64 = 10

def main() -> i64:
    binding: DebuggerIdentity::BindingIdentity = DebuggerIdentity::BindingIdentity{declaration: DebuggerIdentity::debug_id(TEST_BINDING), incarnation: 1}
    mutation: DebuggerProvenance::Mutation = DebuggerProvenance::Mutation{
        event: 4,
        binding: binding,
        allocation: DebuggerIdentity::AllocationIdentity{allocation: DebuggerIdentity::debug_id(TEST_ALLOCATION), generation: 1, offset: 0},
        kind: DebuggerProvenance::MutationKind.Assignment,
        value_hash: 99,
        source: DebuggerIdentity::SourceSpan{file: DebuggerIdentity::debug_id(TEST_SOURCE), start_byte: 0, end_byte: 1, start_line: 1, start_column: 0, end_line: 1, end_column: 1, discriminator: 0}
    }
    index: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_append(DebuggerProvenance::provenance_new(), mutation)
    window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: QUERY_FIRST_EVENT, last_event: QUERY_LAST_EVENT, max_results: QUERY_MAX_RESULTS, max_steps: QUERY_MAX_STEPS}
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
    cancelled_empty_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_cancel(token)
    cancelled_empty: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(DebuggerProvenance::provenance_new(), binding, window, cancelled_empty_token)
    return EMPTY_CANCEL_FAILURE if not cancelled_empty.cancelled or cancelled_empty.failure.code != DebuggerErrors::ErrorCode.Cancelled
    result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(index, binding, window, token)
    return MATCH_RESULT if result.count != 1 or result.matches[0].event != mutation.event or not result.complete
    capped_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: QUERY_FIRST_EVENT, last_event: QUERY_LAST_EVENT, max_results: SINGLE_RESULT_LIMIT, max_steps: QUERY_MAX_STEPS}
    capped_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(index, binding, capped_window, token)
    return MATCH_RESULT if capped_result.count != SINGLE_RESULT_LIMIT or not capped_result.complete
    large_index: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_new()
    for event_index in 0..<LARGE_INDEX_COUNT:
        large_mutation: mutable DebuggerProvenance::Mutation = mutation
        large_mutation.event <- event_index.u64()
        large_index <- DebuggerProvenance::provenance_append(large_index, large_mutation)
    large_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: QUERY_FIRST_EVENT, last_event: QUERY_LAST_EVENT + LARGE_INDEX_COUNT.u64(), max_results: LARGE_RESULT_LIMIT, max_steps: QUERY_MAX_STEPS}
    large_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(large_index, binding, large_window, token)
    return LARGE_RESULT_FAILURE if large_result.count != QUERY_RESULT_CAPACITY or large_result.complete or large_result.failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    invalid_index: mutable DebuggerProvenance::ProvenanceIndex = index
    invalid_index.count <- INVALID_PROVENANCE_COUNT
    invalid_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(invalid_index, binding, window, token)
    return INVALID_PROVENANCE_RESULT if invalid_result.failure.code != DebuggerErrors::ErrorCode.ResourceLimit or invalid_result.scanned != 0
    invalid_next: DebuggerProvenance::Mutation = DebuggerQueryEngine::query_find_next_write(invalid_index, binding, 0, window)
    return INVALID_PROVENANCE_RESULT if invalid_next.event != 0
    deadline_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(1)
    deadline_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(index, binding, window, deadline_token)
    return DEADLINE_RESULT if not deadline_result.cancelled or deadline_result.failure.code != DebuggerErrors::ErrorCode.Cancelled
    next: DebuggerProvenance::Mutation = DebuggerQueryEngine::query_find_next_write(index, binding, 0, window)
    return NEXT_RESULT if next.event != mutation.event
    cancelled_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_cancel(token)
    cancelled: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(index, binding, window, cancelled_token)
    return CANCELLED_RESULT if not cancelled.cancelled or cancelled.failure.code != DebuggerErrors::ErrorCode.Cancelled
    max_mutation: DebuggerProvenance::Mutation = mutation
    max_mutation.event <- MAX_EVENT
    max_index: DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_append(index, max_mutation)
    max_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: 0, last_event: MAX_EVENT, max_results: QUERY_MAX_RESULTS, max_steps: QUERY_MAX_STEPS}
    max_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(max_index, binding, max_window, token)
    return BUDGET_RESULT if max_result.next_event != MAX_EVENT
    budget_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: 0, last_event: QUERY_LAST_EVENT, max_results: QUERY_MAX_RESULTS, max_steps: 1}
    budget_result: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(max_index, DebuggerIdentity::BindingIdentity{declaration: DebuggerIdentity::debug_id(TEST_BINDING + 1), incarnation: 1}, budget_window, token)
    return BUDGET_RESULT if budget_result.failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    later_mutation: DebuggerProvenance::Mutation = mutation
    later_mutation.event <- 8
    later_mutation.value_hash <- 100
    earlier_mutation: DebuggerProvenance::Mutation = mutation
    earlier_mutation.event <- 3
    earlier_mutation.value_hash <- 101
    unordered: mutable DebuggerProvenance::ProvenanceIndex = DebuggerProvenance::provenance_new()
    unordered <- DebuggerProvenance::provenance_append(unordered, later_mutation)
    unordered <- DebuggerProvenance::provenance_append(unordered, earlier_mutation)
    first_change: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_first_change(unordered, binding, window, 0, token)
    return FIRST_CHANGE_RESULT if first_change.count != 1 or first_change.matches[0].event != 3
    partial_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: 0, last_event: QUERY_LAST_EVENT, max_results: 1, max_steps: QUERY_MAX_STEPS}
    partial_first_change: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_first_change(unordered, binding, partial_window, 0, token)
    return PARTIAL_FIRST_CHANGE_RESULT if partial_first_change.complete or partial_first_change.count != 1
    resumed: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_resume_writes(DebuggerQueryEngine::query_find_writes(unordered, binding, partial_window, token), unordered, binding, token)
    return PARTIAL_FIRST_CHANGE_RESULT if not resumed.complete or resumed.count != 1 or resumed.matches[0].event != earlier_mutation.event
    left_samples: mutable DebuggerQueryEngine::StateSample[2] = [DebuggerQueryEngine::StateSample{event: 9, value_hash: 7}, DebuggerQueryEngine::StateSample{event: 4, value_hash: 11}]
    right_samples: mutable DebuggerQueryEngine::StateSample[2] = [DebuggerQueryEngine::StateSample{event: 8, value_hash: 7}, DebuggerQueryEngine::StateSample{event: 3, value_hash: 11}]
    series: DebuggerQueryEngine::StateDifference = DebuggerQueryEngine::query_compare_series(left_samples[0], 2, right_samples[0], 2)
    return 6 if series.left.event != 4 or series.right.event != 3 or series.left.value_hash != 11 or series.right.value_hash != 11 or series.different
    return 0
