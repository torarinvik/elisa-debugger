include "../src/query/evaluator.elisa"

const OUT_OF_RANGE_FIRST_EVENT: u64 = 100
const OUT_OF_RANGE_SECOND_EVENT: u64 = 101
const QUERY_FIRST_EVENT: u64 = 0
const QUERY_LAST_EVENT: u64 = 10
const QUERY_BUDGET: u64 = 1
const EXPECTED_SCANNED: u64 = 1

def main() -> i64:
    index: mutable DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_new()
    index <- DebuggerQueryIndex::event_index_append(index, DebuggerQueryIndex::EventIndexEntry{event: OUT_OF_RANGE_FIRST_EVENT, task: zeroed, statement: zeroed, state_hash: 1})
    index <- DebuggerQueryIndex::event_index_append(index, DebuggerQueryIndex::EventIndexEntry{event: OUT_OF_RANGE_SECOND_EVENT, task: zeroed, statement: zeroed, state_hash: 1})
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
    result: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_first(index, DebuggerQueryEvaluator::Predicate{kind: DebuggerQueryEvaluator::PredicateKind.StateHashEquals, value: 1, second: 0}, QUERY_FIRST_EVENT, QUERY_LAST_EVENT, token, QUERY_BUDGET)
    return 1 if result.status != DebuggerQueryEvaluator::QueryStatus.ResourceLimit
    return 2 if result.scanned != EXPECTED_SCANNED
    return 0
