include "../src/query/evaluator.elisa"

const OUT_OF_RANGE_FIRST_EVENT: u64 = 100
const OUT_OF_RANGE_SECOND_EVENT: u64 = 101
const QUERY_FIRST_EVENT: u64 = 0
const QUERY_LAST_EVENT: u64 = 10
const QUERY_BUDGET: u64 = 1
const QUERY_COMPARE_BUDGET: u64 = 10
const QUERY_MISMATCH_COMPARE_BUDGET: u64 = 12
const QUERY_COMPARE_INNER_LIMIT: u64 = 2
const QUERY_COMPARE_DEADLINE: u64 = 2
const EXPECTED_SCANNED: u64 = 1
const EXPECTED_COMPARE_SCANNED: u64 = 10
const EXPECTED_MISMATCH_COMPARE_SCANNED: u64 = 12
const EXPECTED_COMPARE_LIMIT_SCANNED: u64 = 2
const DEADLINE_RESULT: i64 = 3
const EVENT_ORDER_COMPARE_RESULT: i64 = 4
const EVENT_VALUE_COMPARE_RESULT: i64 = 5
const EVENT_MISSING_COMPARE_RESULT: i64 = 6
const EVENT_COMPARE_BUDGET_RESULT: i64 = 7
const EARLIEST_EVENT_MISMATCH_RESULT: i64 = 8

def main() -> i64:
    index: mutable DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_new()
    index <- DebuggerQueryIndex::event_index_append(index, DebuggerQueryIndex::EventIndexEntry{event: OUT_OF_RANGE_FIRST_EVENT, task: zeroed, statement: zeroed, state_hash: 1})
    index <- DebuggerQueryIndex::event_index_append(index, DebuggerQueryIndex::EventIndexEntry{event: OUT_OF_RANGE_SECOND_EVENT, task: zeroed, statement: zeroed, state_hash: 1})
    token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(0)
    result: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_first(index, DebuggerQueryEvaluator::Predicate{kind: DebuggerQueryEvaluator::PredicateKind.StateHashEquals, value: 1, second: 0}, QUERY_FIRST_EVENT, QUERY_LAST_EVENT, token, QUERY_BUDGET)
    return 1 if result.status != DebuggerQueryEvaluator::QueryStatus.ResourceLimit
    return 2 if result.scanned != EXPECTED_SCANNED
    empty_deadline: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(1)
    empty_result: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_first(DebuggerQueryIndex::event_index_new(), DebuggerQueryEvaluator::Predicate{kind: DebuggerQueryEvaluator::PredicateKind.StateHashEquals, value: 1, second: 0}, QUERY_FIRST_EVENT, QUERY_LAST_EVENT, empty_deadline, QUERY_BUDGET)
    return DEADLINE_RESULT if empty_result.status != DebuggerQueryEvaluator::QueryStatus.Cancelled or empty_result.scanned != 0
    ordered_left: mutable DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_new()
    ordered_left <- DebuggerQueryIndex::event_index_append(ordered_left, DebuggerQueryIndex::EventIndexEntry{event: 8, task: DebuggerIdentity::debug_id(1), statement: DebuggerIdentity::debug_id(2), state_hash: 80})
    ordered_left <- DebuggerQueryIndex::event_index_append(ordered_left, DebuggerQueryIndex::EventIndexEntry{event: 2, task: DebuggerIdentity::debug_id(3), statement: DebuggerIdentity::debug_id(4), state_hash: 20})
    ordered_right: mutable DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_new()
    ordered_right <- DebuggerQueryIndex::event_index_append(ordered_right, DebuggerQueryIndex::EventIndexEntry{event: 2, task: DebuggerIdentity::debug_id(3), statement: DebuggerIdentity::debug_id(4), state_hash: 20})
    ordered_right <- DebuggerQueryIndex::event_index_append(ordered_right, DebuggerQueryIndex::EventIndexEntry{event: 8, task: DebuggerIdentity::debug_id(1), statement: DebuggerIdentity::debug_id(2), state_hash: 80})
    reordered_compare: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_compare_with_cancellation(ordered_left, ordered_right, token, QUERY_COMPARE_BUDGET)
    return EVENT_ORDER_COMPARE_RESULT if reordered_compare.status != DebuggerQueryEvaluator::QueryStatus.NoMatch or reordered_compare.scanned != EXPECTED_COMPARE_SCANNED
    changed_event: mutable DebuggerQueryIndex::EventIndex = ordered_right
    changed_event.entries[1].state_hash <- 81
    changed_compare: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_compare_with_cancellation(ordered_left, changed_event, token, QUERY_COMPARE_BUDGET)
    return EVENT_VALUE_COMPARE_RESULT if changed_compare.status != DebuggerQueryEvaluator::QueryStatus.Match or changed_compare.event != 8
    missing_compare: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_compare_with_cancellation(DebuggerQueryIndex::event_index_new(), ordered_left, token, QUERY_COMPARE_BUDGET)
    return EVENT_MISSING_COMPARE_RESULT if missing_compare.status != DebuggerQueryEvaluator::QueryStatus.Match or missing_compare.event != 2
    mismatch_left: mutable DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_new()
    mismatch_left <- DebuggerQueryIndex::event_index_append(mismatch_left, DebuggerQueryIndex::EventIndexEntry{event: 8, task: DebuggerIdentity::debug_id(1), statement: DebuggerIdentity::debug_id(2), state_hash: 80})
    mismatch_left <- DebuggerQueryIndex::event_index_append(mismatch_left, DebuggerQueryIndex::EventIndexEntry{event: 10, task: DebuggerIdentity::debug_id(3), statement: DebuggerIdentity::debug_id(4), state_hash: 100})
    mismatch_right: mutable DebuggerQueryIndex::EventIndex = DebuggerQueryIndex::event_index_new()
    mismatch_right <- DebuggerQueryIndex::event_index_append(mismatch_right, DebuggerQueryIndex::EventIndexEntry{event: 2, task: DebuggerIdentity::debug_id(5), statement: DebuggerIdentity::debug_id(6), state_hash: 20})
    mismatch_right <- DebuggerQueryIndex::event_index_append(mismatch_right, DebuggerQueryIndex::EventIndexEntry{event: 10, task: DebuggerIdentity::debug_id(3), statement: DebuggerIdentity::debug_id(4), state_hash: 100})
    earliest_mismatch: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_compare_with_cancellation(mismatch_left, mismatch_right, token, QUERY_MISMATCH_COMPARE_BUDGET)
    return EARLIEST_EVENT_MISMATCH_RESULT if earliest_mismatch.status != DebuggerQueryEvaluator::QueryStatus.Match or earliest_mismatch.event != 2 or earliest_mismatch.scanned != EXPECTED_MISMATCH_COMPARE_SCANNED
    limited_compare: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_compare_with_cancellation(ordered_left, ordered_right, token, QUERY_BUDGET)
    return EVENT_COMPARE_BUDGET_RESULT if limited_compare.status != DebuggerQueryEvaluator::QueryStatus.ResourceLimit or limited_compare.scanned != 1
    inner_limited_compare: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_compare_with_cancellation(ordered_left, ordered_right, token, QUERY_COMPARE_INNER_LIMIT)
    return EVENT_COMPARE_BUDGET_RESULT if inner_limited_compare.status != DebuggerQueryEvaluator::QueryStatus.ResourceLimit or inner_limited_compare.scanned != EXPECTED_COMPARE_LIMIT_SCANNED
    deadline_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(QUERY_COMPARE_DEADLINE)
    cancelled_inner_compare: DebuggerQueryEvaluator::QueryResult = DebuggerQueryEvaluator::query_compare_with_cancellation(ordered_left, ordered_right, deadline_token, QUERY_COMPARE_BUDGET)
    return DEADLINE_RESULT if cancelled_inner_compare.status != DebuggerQueryEvaluator::QueryStatus.Cancelled or cancelled_inner_compare.scanned != EXPECTED_COMPARE_LIMIT_SCANNED
    return 0
