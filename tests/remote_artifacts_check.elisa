include "../src/protocol/artifacts.elisa"
include "../src/protocol/remote.elisa"

const ARTIFACT_SIZE: usize = 5
const SEQUENCE_ERROR: i64 = 1
const SIZE_ERROR: i64 = 2
const CHECKSUM_ERROR: i64 = 3

def main() -> i64:
    bytes: mutable u8[ARTIFACT_SIZE] = zeroed
    bytes[0] <- 65
    bytes[1] <- 66
    bytes[2] <- 67
    bytes[3] <- 68
    bytes[4] <- 69
    transfer: mutable DebuggerRemoteArtifacts::ArtifactTransfer = DebuggerRemoteArtifacts::transfer_new()
    return 4 if not DebuggerRemoteArtifacts::transfer_is_valid(transfer)
    rejected_transfer: DebuggerRemoteArtifacts::ArtifactTransfer = DebuggerRemoteArtifacts::transfer_begin(transfer, 0, 0)
    return 8 if rejected_transfer.state != DebuggerRemoteArtifacts::TransferState.Failed or not DebuggerRemoteArtifacts::transfer_is_valid(rejected_transfer)
    transfer <- DebuggerRemoteArtifacts::transfer_begin(transfer, ARTIFACT_SIZE, DebuggerRemoteArtifacts::transfer_checksum(bytes[0], ARTIFACT_SIZE))
    transfer <- DebuggerRemoteArtifacts::transfer_push(transfer, 1, bytes[0], 2)
    return SEQUENCE_ERROR if transfer.state != DebuggerRemoteArtifacts::TransferState.Failed
    transfer <- DebuggerRemoteArtifacts::transfer_begin(DebuggerRemoteArtifacts::transfer_new(), ARTIFACT_SIZE, DebuggerRemoteArtifacts::transfer_checksum(bytes[0], ARTIFACT_SIZE))
    transfer <- DebuggerRemoteArtifacts::transfer_push(transfer, 0, bytes[0], 2)
    transfer <- DebuggerRemoteArtifacts::transfer_push(transfer, 1, bytes[2], 3)
    transfer <- DebuggerRemoteArtifacts::transfer_finish(transfer)
    return SIZE_ERROR if not DebuggerRemoteArtifacts::transfer_is_complete(transfer)
    copied: mutable u8[ARTIFACT_SIZE] = zeroed
    return 5 if not DebuggerErrors::error_is_ok(DebuggerRemoteArtifacts::transfer_copy(transfer, copied[0], ARTIFACT_SIZE)) or copied[4] != bytes[4]
    transfer <- DebuggerRemoteArtifacts::transfer_begin(DebuggerRemoteArtifacts::transfer_new(), ARTIFACT_SIZE, 1)
    transfer <- DebuggerRemoteArtifacts::transfer_push(transfer, 0, bytes[0], ARTIFACT_SIZE)
    transfer <- DebuggerRemoteArtifacts::transfer_finish(transfer)
    return CHECKSUM_ERROR if transfer.state != DebuggerRemoteArtifacts::TransferState.Failed
    channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    channel <- DebuggerRemote::remote_authenticate(channel, 1, 1)
    channel <- DebuggerRemote::remote_accept_handshake(channel, DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 0, engine: 1, trace_schema: 1, authenticated: true})
    channel <- DebuggerRemote::remote_begin_artifact(channel, ARTIFACT_SIZE, DebuggerRemoteArtifacts::transfer_checksum(bytes[0], ARTIFACT_SIZE))
    channel <- DebuggerRemote::remote_push_artifact(channel, 0, bytes[0], 2)
    channel <- DebuggerRemote::remote_push_artifact(channel, 1, bytes[2], 3)
    channel <- DebuggerRemote::remote_finish_artifact(channel)
    return 6 if not DebuggerRemoteArtifacts::transfer_is_complete(channel.artifact) or channel.bytes_received != ARTIFACT_SIZE.u64()
    invalid_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    invalid_channel <- DebuggerRemote::remote_authenticate(invalid_channel, 1, 1)
    invalid_channel <- DebuggerRemote::remote_accept_handshake(invalid_channel, DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 0, engine: 1, trace_schema: 1, authenticated: true})
    invalid_channel <- DebuggerRemote::remote_begin_artifact(invalid_channel, ARTIFACT_SIZE, DebuggerRemoteArtifacts::transfer_checksum(bytes[0], ARTIFACT_SIZE))
    invalid_channel <- DebuggerRemote::remote_push_artifact(invalid_channel, 1, bytes[0], 2)
    return 7 if invalid_channel.last_error.code != DebuggerErrors::ErrorCode.Corrupt
    return 0
