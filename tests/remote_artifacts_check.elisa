include "../src/protocol/artifacts.elisa"

const ARTIFACT_SIZE: usize = 5
const ARTIFACT_HASH_OFFSET_BASIS: u64 = 1469598103934665603
const ARTIFACT_HASH_PRIME: u64 = 1099511628211
const SEQUENCE_ERROR: i64 = 1
const SIZE_ERROR: i64 = 2
const CHECKSUM_ERROR: i64 = 3

def checksum(bytes: u8&, length: usize) -> u64:
    value: mutable u64 = ARTIFACT_HASH_OFFSET_BASIS
    for index in 0..<length:
        value <- (value ^ bytes[index].u64()) * ARTIFACT_HASH_PRIME
    return value

def main() -> i64:
    bytes: mutable u8[ARTIFACT_SIZE] = zeroed
    bytes[0] <- 65
    bytes[1] <- 66
    bytes[2] <- 67
    bytes[3] <- 68
    bytes[4] <- 69
    transfer: mutable DebuggerRemoteArtifacts::ArtifactTransfer = DebuggerRemoteArtifacts::transfer_new()
    transfer <- DebuggerRemoteArtifacts::transfer_begin(transfer, ARTIFACT_SIZE, checksum(bytes[0], ARTIFACT_SIZE))
    transfer <- DebuggerRemoteArtifacts::transfer_push(transfer, 1, bytes[0], 2)
    return SEQUENCE_ERROR if transfer.state != DebuggerRemoteArtifacts::TransferState.Failed
    transfer <- DebuggerRemoteArtifacts::transfer_begin(DebuggerRemoteArtifacts::transfer_new(), ARTIFACT_SIZE, checksum(bytes[0], ARTIFACT_SIZE))
    transfer <- DebuggerRemoteArtifacts::transfer_push(transfer, 0, bytes[0], 2)
    transfer <- DebuggerRemoteArtifacts::transfer_push(transfer, 1, bytes[2], 3)
    transfer <- DebuggerRemoteArtifacts::transfer_finish(transfer)
    return SIZE_ERROR if not DebuggerRemoteArtifacts::transfer_is_complete(transfer)
    transfer <- DebuggerRemoteArtifacts::transfer_begin(DebuggerRemoteArtifacts::transfer_new(), ARTIFACT_SIZE, 1)
    transfer <- DebuggerRemoteArtifacts::transfer_push(transfer, 0, bytes[0], ARTIFACT_SIZE)
    transfer <- DebuggerRemoteArtifacts::transfer_finish(transfer)
    return CHECKSUM_ERROR if transfer.state != DebuggerRemoteArtifacts::TransferState.Failed
    return 0
