include "../src/protocol/remote.elisa"

const module Test:
    EXPECTED_CREDENTIAL: u64 = 77
    WRONG_CREDENTIAL: u64 = 78
    AUTHENTICATION_ATTEMPTS: u32 = 3
    FIRST_AUTHENTICATION_ATTEMPT: u32 = 1
    SECOND_AUTHENTICATION_ATTEMPT: u32 = 2
    REAUTHENTICATION_FAILURE: i64 = 7
    QUOTA_LIMIT: u64 = 4
    QUOTA_FIRST_CHUNK: u64 = 3
    QUOTA_SECOND_CHUNK: u64 = 2
    NO_QUOTA_REMAINING: u64 = 0
    QUOTA_REMAINING_FAILURE: i64 = 19
    DISCONNECTED_QUOTA_REMAINING_FAILURE: i64 = 20


def main() -> i64:
    channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    channel <- DebuggerRemote::remote_authenticate(channel, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    return 1 if channel.state != DebuggerRemote::RemoteState.Authenticating or channel.auth_attempts != 1 or channel.last_error.code != DebuggerErrors::ErrorCode.PermissionDenied
    channel <- DebuggerRemote::remote_authenticate(channel, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    channel <- DebuggerRemote::remote_authenticate(channel, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    return 2 if channel.state != DebuggerRemote::RemoteState.Failed or DebuggerRemote::remote_authentication_attempts(channel) != Test::AUTHENTICATION_ATTEMPTS or channel.last_error.retryable
    channel <- DebuggerRemote::remote_reconnect(channel)
    return 3 if channel.state != DebuggerRemote::RemoteState.Failed or channel.auth_attempts != Test::AUTHENTICATION_ATTEMPTS
    channel <- DebuggerRemote::remote_disconnect(channel)
    return 4 if channel.state != DebuggerRemote::RemoteState.Disconnected or channel.auth_attempts != Test::AUTHENTICATION_ATTEMPTS

    retry_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    retry_channel <- DebuggerRemote::remote_authenticate(retry_channel, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    return 12 if retry_channel.auth_attempts != Test::FIRST_AUTHENTICATION_ATTEMPT
    retry_channel <- DebuggerRemote::remote_disconnect(retry_channel)
    retry_channel <- DebuggerRemote::remote_reconnect(retry_channel)
    return 13 if retry_channel.state != DebuggerRemote::RemoteState.Authenticating or retry_channel.auth_attempts != Test::FIRST_AUTHENTICATION_ATTEMPT
    retry_channel <- DebuggerRemote::remote_authenticate(retry_channel, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    retry_channel <- DebuggerRemote::remote_disconnect(retry_channel)
    retry_channel <- DebuggerRemote::remote_reconnect(retry_channel)
    return 14 if retry_channel.state != DebuggerRemote::RemoteState.Authenticating or retry_channel.auth_attempts != Test::SECOND_AUTHENTICATION_ATTEMPT
    retry_channel <- DebuggerRemote::remote_authenticate(retry_channel, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    return 15 if retry_channel.state != DebuggerRemote::RemoteState.Failed or retry_channel.auth_attempts != Test::AUTHENTICATION_ATTEMPTS
    retry_channel <- DebuggerRemote::remote_disconnect(retry_channel)
    return 16 if DebuggerRemote::remote_reconnect(retry_channel).state != DebuggerRemote::RemoteState.Disconnected
    return 17 if DebuggerRemote::remote_begin(retry_channel).state != DebuggerRemote::RemoteState.Disconnected

    success_resets_attempts: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    success_resets_attempts <- DebuggerRemote::remote_authenticate(success_resets_attempts, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    success_resets_attempts <- DebuggerRemote::remote_authenticate(success_resets_attempts, Test::EXPECTED_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    return 18 if success_resets_attempts.auth_attempts != 0 or not success_resets_attempts.handshake.authenticated

    fresh_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    fresh_channel <- DebuggerRemote::remote_authenticate(fresh_channel, Test::EXPECTED_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    return 5 if not fresh_channel.handshake.authenticated or fresh_channel.state != DebuggerRemote::RemoteState.Authenticating
    rejected: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    rejected <- DebuggerRemote::remote_authenticate(rejected, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    rejected <- DebuggerRemote::remote_authenticate(rejected, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    rejected <- DebuggerRemote::remote_authenticate(rejected, Test::WRONG_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    stale_handshake: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 0, engine: 1, trace_schema: 1, authenticated: true}
    rejected <- DebuggerRemote::remote_accept_handshake(rejected, stale_handshake)
    return Test::REAUTHENTICATION_FAILURE if rejected.state != DebuggerRemote::RemoteState.Failed or rejected.handshake.authenticated
    rejected <- DebuggerRemote::remote_begin(rejected)
    return 9 if rejected.state != DebuggerRemote::RemoteState.Failed or rejected.auth_attempts != Test::AUTHENTICATION_ATTEMPTS
    rejected <- DebuggerRemote::remote_disconnect(rejected)
    rejected <- DebuggerRemote::remote_begin(rejected)
    return 10 if rejected.state != DebuggerRemote::RemoteState.Disconnected or rejected.auth_attempts != Test::AUTHENTICATION_ATTEMPTS
    handshake: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 0, engine: 1, trace_schema: 1, authenticated: fresh_channel.handshake.authenticated}
    fresh_channel <- DebuggerRemote::remote_accept_handshake(fresh_channel, handshake)
    return 6 if not DebuggerRemote::remote_is_connected(fresh_channel)
    forged_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    forged_handshake: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{protocol_major: 1, protocol_minor: 0, engine: 1, trace_schema: 1, authenticated: true}
    forged_channel <- DebuggerRemote::remote_accept_handshake(forged_channel, forged_handshake)
    return 7 if forged_channel.state != DebuggerRemote::RemoteState.Failed or forged_channel.last_error.code != DebuggerErrors::ErrorCode.PermissionDenied
    quota_channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(DebuggerSecurity::default_policy()))
    quota_channel.policy.quotas.remote_payload_bytes <- Test::QUOTA_LIMIT
    quota_channel <- DebuggerRemote::remote_authenticate(quota_channel, Test::EXPECTED_CREDENTIAL, Test::EXPECTED_CREDENTIAL)
    quota_channel <- DebuggerRemote::remote_accept_handshake(quota_channel, handshake)
    oversized_artifact: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin_artifact(quota_channel, Test::QUOTA_LIMIT + 1, 0)
    return 11 if oversized_artifact.state != DebuggerRemote::RemoteState.Draining or not oversized_artifact.quota_exceeded
    quota_channel <- DebuggerRemote::remote_receive(quota_channel, Test::QUOTA_FIRST_CHUNK)
    quota_channel <- DebuggerRemote::remote_receive(quota_channel, Test::QUOTA_SECOND_CHUNK)
    return Test::QUOTA_REMAINING_FAILURE if DebuggerRemote::remote_quota_remaining(quota_channel) != Test::NO_QUOTA_REMAINING
    quota_channel <- DebuggerRemote::remote_disconnect(quota_channel)
    return Test::DISCONNECTED_QUOTA_REMAINING_FAILURE if DebuggerRemote::remote_quota_remaining(quota_channel) != Test::NO_QUOTA_REMAINING
    return 8 if not quota_channel.quota_exceeded or quota_channel.last_error.code != DebuggerErrors::ErrorCode.ResourceLimit or DebuggerRemote::remote_reconnect(quota_channel).state != DebuggerRemote::RemoteState.Disconnected
    return 0
