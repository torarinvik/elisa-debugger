include "../src/protocol/remote.elisa"

const TEST_CREDENTIAL: u64 = 91
const TEST_ARTIFACT_BYTE: u8 = 65
const TEST_ARTIFACT_SIZE: usize = 1
const TEST_AUTH_PROTOCOL_MAJOR: u32 = 1
const TEST_AUTH_PROTOCOL_MINOR: u32 = 0
const TEST_AUTH_ENGINE_MANAGED: u32 = 1
const TEST_AUTH_TRACE_SCHEMA: u32 = 1
const TEST_CHUNK_SEQUENCE: u64 = 0
const TEST_PAYLOAD_LIMIT_ZERO: u64 = 0
const TEST_PAYLOAD_BYTE_COUNT: u64 = 1
const TEST_EXPECTED_INSPECT_DETAIL: u32 = 6
const TEST_EXPECTED_MUTATE_DETAIL: u32 = 8
const TEST_EXPECTED_EXTERNAL_DETAIL: u32 = 9
const TEST_EXPECTED_ARTIFACT_DETAIL: u32 = 10
const TEST_EXPECTED_TRANSPORT_DETAIL: u32 = 11
const TEST_FAILURE_DISCONNECTED: i64 = 1
const TEST_FAILURE_DEFAULT_POLICY: i64 = 2
const TEST_FAILURE_MUTATE_POLICY: i64 = 3
const TEST_FAILURE_EXTERNAL_POLICY: i64 = 4
const TEST_FAILURE_INSPECT_ISOLATION: i64 = 5
const TEST_FAILURE_CONTROL_ISOLATION: i64 = 6
const TEST_FAILURE_ARTIFACT_DENIED: i64 = 7
const TEST_FAILURE_ARTIFACT_RECHECK: i64 = 8
const TEST_FAILURE_ARTIFACT_ACCEPTED: i64 = 9
const TEST_FAILURE_QUOTA_DENIED: i64 = 10

def connected_channel(policy: DebuggerSecurity::Policy) -> DebuggerRemote::RemoteChannel:
    channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(policy))
    channel <- DebuggerRemote::remote_authenticate(channel, TEST_CREDENTIAL, TEST_CREDENTIAL)
    handshake: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{
        protocol_major: TEST_AUTH_PROTOCOL_MAJOR,
        protocol_minor: TEST_AUTH_PROTOCOL_MINOR,
        engine: TEST_AUTH_ENGINE_MANAGED,
        trace_schema: TEST_AUTH_TRACE_SCHEMA,
        authenticated: true
    }
    channel <- DebuggerRemote::remote_accept_handshake(channel, handshake)
    return channel

def main() -> i64:
    disconnected: DebuggerRemote::RemoteChannel = DebuggerRemote::remote_new(DebuggerSecurity::default_policy())
    disconnected_result: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(disconnected, DebuggerRemote::RemoteOperation.Inspect)
    return TEST_FAILURE_DISCONNECTED if disconnected_result.code != DebuggerErrors::ErrorCode.Transport or disconnected_result.detail != TEST_EXPECTED_TRANSPORT_DETAIL

    channel: mutable DebuggerRemote::RemoteChannel = connected_channel(DebuggerSecurity::default_policy())
    return TEST_FAILURE_DEFAULT_POLICY if not DebuggerRemote::remote_can_inspect(channel) or not DebuggerRemote::remote_can_control(channel)
    return TEST_FAILURE_DEFAULT_POLICY if DebuggerErrors::error_is_ok(DebuggerRemote::remote_authorize(channel, DebuggerRemote::RemoteOperation.Mutate)) or DebuggerRemote::remote_can_mutate(channel)
    denied_mutate: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(channel, DebuggerRemote::RemoteOperation.Mutate)
    return TEST_FAILURE_MUTATE_POLICY if denied_mutate.code != DebuggerErrors::ErrorCode.PermissionDenied or denied_mutate.detail != TEST_EXPECTED_MUTATE_DETAIL
    denied_external: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(channel, DebuggerRemote::RemoteOperation.ExternalExecution)
    return TEST_FAILURE_EXTERNAL_POLICY if denied_external.code != DebuggerErrors::ErrorCode.PermissionDenied or denied_external.detail != TEST_EXPECTED_EXTERNAL_DETAIL or DebuggerRemote::remote_can_execute_external(channel)

    channel.policy.mutate <- true
    return TEST_FAILURE_MUTATE_POLICY if not DebuggerRemote::remote_can_mutate(channel)
    channel.policy.write_files <- true
    channel.policy.mutate <- false
    return TEST_FAILURE_MUTATE_POLICY if DebuggerRemote::remote_can_mutate(channel)
    channel.policy.mutate <- true
    channel.policy.inspect <- false
    denied_inspect: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(channel, DebuggerRemote::RemoteOperation.Inspect)
    return TEST_FAILURE_INSPECT_ISOLATION if denied_inspect.code != DebuggerErrors::ErrorCode.PermissionDenied or denied_inspect.detail != TEST_EXPECTED_INSPECT_DETAIL or DebuggerRemote::remote_can_inspect(channel)
    return TEST_FAILURE_INSPECT_ISOLATION if not DebuggerRemote::remote_can_control(channel) or not DebuggerRemote::remote_can_mutate(channel)
    channel.policy.inspect <- true
    channel.policy.execute <- false
    return TEST_FAILURE_CONTROL_ISOLATION if DebuggerRemote::remote_can_control(channel) or not DebuggerRemote::remote_can_inspect(channel) or not DebuggerRemote::remote_can_mutate(channel)
    channel.policy.spawn_process <- true
    return TEST_FAILURE_EXTERNAL_POLICY if not DebuggerRemote::remote_can_execute_external(channel) or DebuggerRemote::remote_can_control(channel)

    denied_artifact_policy: mutable DebuggerSecurity::Policy = DebuggerSecurity::default_policy()
    denied_artifact_policy.export_trace <- false
    denied_artifact_channel: DebuggerRemote::RemoteChannel = connected_channel(denied_artifact_policy)
    denied_artifact_bytes: mutable u8[TEST_ARTIFACT_SIZE] = zeroed
    denied_artifact_bytes[0] <- TEST_ARTIFACT_BYTE
    denied_artifact: DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin_artifact(denied_artifact_channel, TEST_ARTIFACT_SIZE, DebuggerRemoteArtifacts::transfer_checksum(denied_artifact_bytes[0], TEST_ARTIFACT_SIZE))
    return TEST_FAILURE_ARTIFACT_DENIED if denied_artifact.last_error.code != DebuggerErrors::ErrorCode.PermissionDenied or denied_artifact.last_error.detail != TEST_EXPECTED_ARTIFACT_DETAIL or DebuggerRemoteArtifacts::transfer_is_receiving(denied_artifact.artifact)

    transfer: mutable DebuggerRemote::RemoteChannel = connected_channel(DebuggerSecurity::default_policy())
    expected_checksum: u64 = DebuggerRemoteArtifacts::transfer_checksum(denied_artifact_bytes[0], TEST_ARTIFACT_SIZE)
    transfer <- DebuggerRemote::remote_begin_artifact(transfer, TEST_ARTIFACT_SIZE, expected_checksum)
    return TEST_FAILURE_ARTIFACT_ACCEPTED if not DebuggerRemoteArtifacts::transfer_is_receiving(transfer.artifact)
    transfer.policy.export_trace <- false
    transfer <- DebuggerRemote::remote_push_artifact(transfer, TEST_CHUNK_SEQUENCE, denied_artifact_bytes[0], TEST_ARTIFACT_SIZE)
    return TEST_FAILURE_ARTIFACT_RECHECK if transfer.last_error.code != DebuggerErrors::ErrorCode.PermissionDenied or transfer.bytes_received != 0 or transfer.artifact.received_size != 0
    transfer.policy.export_trace <- true
    transfer <- DebuggerRemote::remote_push_artifact(transfer, TEST_CHUNK_SEQUENCE, denied_artifact_bytes[0], TEST_ARTIFACT_SIZE)
    transfer <- DebuggerRemote::remote_finish_artifact(transfer)
    return TEST_FAILURE_ARTIFACT_ACCEPTED if not DebuggerRemoteArtifacts::transfer_is_complete(transfer.artifact) or transfer.bytes_received != TEST_PAYLOAD_BYTE_COUNT

    quota: mutable DebuggerRemote::RemoteChannel = connected_channel(DebuggerSecurity::default_policy())
    quota.policy.quotas.remote_payload_bytes <- TEST_PAYLOAD_LIMIT_ZERO
    quota <- DebuggerRemote::remote_receive(quota, TEST_PAYLOAD_BYTE_COUNT)
    quota_result: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(quota, DebuggerRemote::RemoteOperation.Inspect)
    return TEST_FAILURE_QUOTA_DENIED if quota_result.code != DebuggerErrors::ErrorCode.ResourceLimit or DebuggerRemote::remote_can_inspect(quota)
    return 0
