include "../src/protocol/remote.elisa"

const module Test:
    CREDENTIAL: u64 = 91
    ARTIFACT_BYTE: u8 = 65
    ARTIFACT_SIZE: usize = 1
    AUTH_PROTOCOL_MAJOR: u32 = 1
    AUTH_PROTOCOL_MINOR: u32 = 0
    AUTH_ENGINE_MANAGED: u32 = 1
    AUTH_TRACE_SCHEMA: u32 = 2
    CHUNK_SEQUENCE: u64 = 0
    PAYLOAD_LIMIT_ZERO: u64 = 0
    PAYLOAD_BYTE_COUNT: u64 = 1
    EXPECTED_INSPECT_DETAIL: u32 = 6
    EXPECTED_MUTATE_DETAIL: u32 = 8
    EXPECTED_EXTERNAL_DETAIL: u32 = 9
    EXPECTED_ARTIFACT_DETAIL: u32 = 10
    EXPECTED_TRANSPORT_DETAIL: u32 = 11
    FAILURE_DISCONNECTED: i64 = 1
    FAILURE_DEFAULT_POLICY: i64 = 2
    FAILURE_MUTATE_POLICY: i64 = 3
    FAILURE_EXTERNAL_POLICY: i64 = 4
    FAILURE_INSPECT_ISOLATION: i64 = 5
    FAILURE_CONTROL_ISOLATION: i64 = 6
    FAILURE_ARTIFACT_DENIED: i64 = 7
    FAILURE_ARTIFACT_RECHECK: i64 = 8
    FAILURE_ARTIFACT_ACCEPTED: i64 = 9
    FAILURE_QUOTA_DENIED: i64 = 10


def connected_channel(policy: DebuggerSecurity::Policy) -> DebuggerRemote::RemoteChannel:
    channel: mutable DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin(DebuggerRemote::remote_new(policy))
    channel <- DebuggerRemote::remote_authenticate(channel, Test::CREDENTIAL, Test::CREDENTIAL)
    handshake: DebuggerRemote::RemoteHandshake = DebuggerRemote::RemoteHandshake{
        protocol_major: Test::AUTH_PROTOCOL_MAJOR,
        protocol_minor: Test::AUTH_PROTOCOL_MINOR,
        engine: Test::AUTH_ENGINE_MANAGED,
        trace_schema: Test::AUTH_TRACE_SCHEMA,
        authenticated: true
    }
    channel <- DebuggerRemote::remote_accept_handshake(channel, handshake)
    return channel

def main() -> i64:
    disconnected: DebuggerRemote::RemoteChannel = DebuggerRemote::remote_new(DebuggerSecurity::default_policy())
    disconnected_result: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(disconnected, DebuggerRemote::RemoteOperation.Inspect)
    return Test::FAILURE_DISCONNECTED if disconnected_result.code != DebuggerErrors::ErrorCode.Transport or disconnected_result.detail != Test::EXPECTED_TRANSPORT_DETAIL

    channel: mutable DebuggerRemote::RemoteChannel = connected_channel(DebuggerSecurity::default_policy())
    return Test::FAILURE_DEFAULT_POLICY if not DebuggerRemote::remote_can_inspect(channel) or not DebuggerRemote::remote_can_control(channel)
    return Test::FAILURE_DEFAULT_POLICY if DebuggerErrors::error_is_ok(DebuggerRemote::remote_authorize(channel, DebuggerRemote::RemoteOperation.Mutate)) or DebuggerRemote::remote_can_mutate(channel)
    denied_mutate: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(channel, DebuggerRemote::RemoteOperation.Mutate)
    return Test::FAILURE_MUTATE_POLICY if denied_mutate.code != DebuggerErrors::ErrorCode.PermissionDenied or denied_mutate.detail != Test::EXPECTED_MUTATE_DETAIL
    denied_external: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(channel, DebuggerRemote::RemoteOperation.ExternalExecution)
    return Test::FAILURE_EXTERNAL_POLICY if denied_external.code != DebuggerErrors::ErrorCode.PermissionDenied or denied_external.detail != Test::EXPECTED_EXTERNAL_DETAIL or DebuggerRemote::remote_can_execute_external(channel)

    channel.policy.mutate <- true
    return Test::FAILURE_MUTATE_POLICY if not DebuggerRemote::remote_can_mutate(channel)
    channel.policy.write_files <- true
    channel.policy.mutate <- false
    return Test::FAILURE_MUTATE_POLICY if DebuggerRemote::remote_can_mutate(channel)
    channel.policy.mutate <- true
    channel.policy.inspect <- false
    denied_inspect: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(channel, DebuggerRemote::RemoteOperation.Inspect)
    return Test::FAILURE_INSPECT_ISOLATION if denied_inspect.code != DebuggerErrors::ErrorCode.PermissionDenied or denied_inspect.detail != Test::EXPECTED_INSPECT_DETAIL or DebuggerRemote::remote_can_inspect(channel)
    return Test::FAILURE_INSPECT_ISOLATION if not DebuggerRemote::remote_can_control(channel) or not DebuggerRemote::remote_can_mutate(channel)
    channel.policy.inspect <- true
    channel.policy.execute <- false
    return Test::FAILURE_CONTROL_ISOLATION if DebuggerRemote::remote_can_control(channel) or not DebuggerRemote::remote_can_inspect(channel) or not DebuggerRemote::remote_can_mutate(channel)
    channel.policy.spawn_process <- true
    return Test::FAILURE_EXTERNAL_POLICY if not DebuggerRemote::remote_can_execute_external(channel) or DebuggerRemote::remote_can_control(channel)

    denied_artifact_policy: mutable DebuggerSecurity::Policy = DebuggerSecurity::default_policy()
    denied_artifact_policy.export_trace <- false
    denied_artifact_channel: DebuggerRemote::RemoteChannel = connected_channel(denied_artifact_policy)
    denied_artifact_bytes: mutable u8[Test::ARTIFACT_SIZE] = zeroed
    denied_artifact_bytes[0] <- Test::ARTIFACT_BYTE
    denied_artifact: DebuggerRemote::RemoteChannel = DebuggerRemote::remote_begin_artifact(denied_artifact_channel, Test::ARTIFACT_SIZE, DebuggerRemoteArtifacts::transfer_checksum(denied_artifact_bytes[0], Test::ARTIFACT_SIZE))
    return Test::FAILURE_ARTIFACT_DENIED if denied_artifact.last_error.code != DebuggerErrors::ErrorCode.PermissionDenied or denied_artifact.last_error.detail != Test::EXPECTED_ARTIFACT_DETAIL or DebuggerRemoteArtifacts::transfer_is_receiving(denied_artifact.artifact)

    transfer: mutable DebuggerRemote::RemoteChannel = connected_channel(DebuggerSecurity::default_policy())
    expected_checksum: u64 = DebuggerRemoteArtifacts::transfer_checksum(denied_artifact_bytes[0], Test::ARTIFACT_SIZE)
    transfer <- DebuggerRemote::remote_begin_artifact(transfer, Test::ARTIFACT_SIZE, expected_checksum)
    return Test::FAILURE_ARTIFACT_ACCEPTED if not DebuggerRemoteArtifacts::transfer_is_receiving(transfer.artifact)
    transfer.policy.export_trace <- false
    transfer <- DebuggerRemote::remote_push_artifact(transfer, Test::CHUNK_SEQUENCE, denied_artifact_bytes[0], Test::ARTIFACT_SIZE)
    return Test::FAILURE_ARTIFACT_RECHECK if transfer.last_error.code != DebuggerErrors::ErrorCode.PermissionDenied or transfer.bytes_received != 0 or transfer.artifact.received_size != 0
    transfer.policy.export_trace <- true
    transfer <- DebuggerRemote::remote_push_artifact(transfer, Test::CHUNK_SEQUENCE, denied_artifact_bytes[0], Test::ARTIFACT_SIZE)
    transfer <- DebuggerRemote::remote_finish_artifact(transfer)
    return Test::FAILURE_ARTIFACT_ACCEPTED if not DebuggerRemoteArtifacts::transfer_is_complete(transfer.artifact) or transfer.bytes_received != Test::PAYLOAD_BYTE_COUNT

    quota: mutable DebuggerRemote::RemoteChannel = connected_channel(DebuggerSecurity::default_policy())
    quota.policy.quotas.remote_payload_bytes <- Test::PAYLOAD_LIMIT_ZERO
    quota <- DebuggerRemote::remote_receive(quota, Test::PAYLOAD_BYTE_COUNT)
    quota_result: DebuggerErrors::DebuggerError = DebuggerRemote::remote_authorize(quota, DebuggerRemote::RemoteOperation.Inspect)
    return Test::FAILURE_QUOTA_DENIED if quota_result.code != DebuggerErrors::ErrorCode.ResourceLimit or DebuggerRemote::remote_can_inspect(quota)
    return 0
