include "../src/replay/branches.elisa"
include "../src/replay/engine.elisa"

const module Test:
    ROOT_EVENT: u64 = 4
    CHILD_EVENT: u64 = 7
    VALUE_HASH: u64 = 99
    ENGINE_RECORDING_ID: u64 = 20
    FIRST_BRANCH_ID: u64 = 1
    SECOND_BRANCH_ID: u64 = 2
    THIRD_BRANCH_ID: u64 = 3
    REUSED_ANCESTOR_RESULT: i64 = 6
    INVALID_BRANCH_FORK_RESULT: i64 = 7
    VALID_DEEP_LINEAGE_RESULT: i64 = 8
    BRANCH_PREFIX_RESULT: i64 = 9
    BRANCH_EARLY_FORK_RESULT: i64 = 10
    BRANCH_DEEP_PREFIX_RESULT: i64 = 11
    BRANCH_POSITION_RESULT: i64 = 12
    BRANCH_FORK_HASH_RESULT: i64 = 13
    BRANCH_CORRUPT_FORK_RESULT: i64 = 14
    BRANCH_INTERVENTION_OWNERSHIP_RESULT: i64 = 15
    BRANCH_FORK_BOUNDARY_INTERVENTION_RESULT: i64 = 16
    BRANCH_CORRUPT_STORE_FORK_RESULT: i64 = 17
    BRANCH_CORRUPT_INITIAL_ROOT_RESULT: i64 = 18
    PROGRAM_VERSION: u32 = 1
    PROGRAM_INSTRUCTION_COUNT: u64 = 8
    PROGRAM_RETURN_INDEX: usize = 7
    PROGRAM_LOCAL_COUNT: u64 = 0
    NO_OPERAND: i64 = 0
    ROOT_BRANCH_ID: u64 = 0
    FIRST_INSTRUCTION_INDEX: usize = 0
    FIRST_BRANCH_LINEAGE_INDEX: usize = 1
    PARENT_FORK_EVENT: usize = 4
    PARENT_CURRENT_EVENT: usize = 6
    REWIND_EVENT: usize = 2
    DEEP_REWIND_EVENT: usize = 1
    PREFIX_FIRST_EVENT: usize = 2
    PREFIX_SECOND_EVENT: usize = 3
    PARENT_FIRST_EVENT: usize = 4
    PARENT_LAST_EVENT: usize = 5
    INTERVENTION_TEST_PROGRAM_INSTRUCTION_COUNT: u64 = 6
    INTERVENTION_TEST_CONSTANT_INDEX: usize = 0
    INTERVENTION_TEST_FIRST_NOP_INDEX: usize = 1
    INTERVENTION_TEST_ADD_INDEX: usize = 4
    INTERVENTION_TEST_NOP_END_INDEX: usize = Test::INTERVENTION_TEST_ADD_INDEX
    INTERVENTION_TEST_RETURN_INDEX: usize = 5
    INTERVENTION_TEST_PARENT_BRANCH_ID: u64 = 10
    INTERVENTION_TEST_CHILD_BRANCH_ID: u64 = 11
    INTERVENTION_TEST_PARENT_BOUNDARY: usize = 4
    INTERVENTION_TEST_CHILD_FORK_EVENT: usize = 1
    INTERVENTION_TEST_PARENT_VALUE: i64 = 100
    INTERVENTION_TEST_INITIAL_VALUE: i64 = 1
    INTERVENTION_TEST_ADD_VALUE: i64 = 1
    INTERVENTION_TEST_EXPECTED_CHILD_RESULT: i64 = 2
    INTERVENTION_TEST_UNUSED_OPERAND: i64 = 0
    INTERVENTION_BOUNDARY_PARENT_BRANCH_ID: u64 = 12
    INTERVENTION_BOUNDARY_CHILD_BRANCH_ID: u64 = 13
    INTERVENTION_BOUNDARY_EVENT: usize = 1
    INTERVENTION_BOUNDARY_REWIND_EVENT: usize = 0
    INTERVENTION_BOUNDARY_EXPECTED_RESULT: i64 = Test::INTERVENTION_TEST_PARENT_VALUE + Test::INTERVENTION_TEST_ADD_VALUE
    CORRUPT_INITIAL_ROOT_BRANCH_ID: u64 = 4
    CORRUPT_INITIAL_ROOT_ACCUMULATOR: i64 = 1


def branch_test_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::PROGRAM_INSTRUCTION_COUNT, local_count: Test::PROGRAM_LOCAL_COUNT, has_return: true}
    for index in Test::FIRST_INSTRUCTION_INDEX..<Test::PROGRAM_RETURN_INDEX:
        image.instructions[index] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: Test::NO_OPERAND, b: Test::NO_OPERAND, source: zeroed}
    image.instructions[Test::PROGRAM_RETURN_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::NO_OPERAND, b: Test::NO_OPERAND, source: zeroed}
    return image

def branch_engine_step_count(engine: mutable DebuggerReplayEngine::ReplayEngine&, count: usize) -> void:
    for index in Test::FIRST_INSTRUCTION_INDEX..<count:
        DebuggerReplayEngine::replay_engine_step(engine)

def branch_intervention_test_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::INTERVENTION_TEST_PROGRAM_INSTRUCTION_COUNT, local_count: Test::PROGRAM_LOCAL_COUNT, has_return: true}
    image.instructions[Test::INTERVENTION_TEST_CONSTANT_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Constant, a: Test::INTERVENTION_TEST_INITIAL_VALUE, b: Test::INTERVENTION_TEST_UNUSED_OPERAND, source: zeroed}
    for index in Test::INTERVENTION_TEST_FIRST_NOP_INDEX..<Test::INTERVENTION_TEST_NOP_END_INDEX:
        image.instructions[index] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Nop, a: Test::NO_OPERAND, b: Test::NO_OPERAND, source: zeroed}
    image.instructions[Test::INTERVENTION_TEST_ADD_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Add, a: Test::INTERVENTION_TEST_ADD_VALUE, b: Test::INTERVENTION_TEST_UNUSED_OPERAND, source: zeroed}
    image.instructions[Test::INTERVENTION_TEST_RETURN_INDEX] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::NO_OPERAND, b: Test::NO_OPERAND, source: zeroed}
    return image

def check_branch_intervention_ownership() -> i64:
    root: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(branch_intervention_test_image(), DebuggerIdentity::debug_id(Test::ENGINE_RECORDING_ID))
    parent: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(root, DebuggerIdentity::debug_id(Test::INTERVENTION_TEST_PARENT_BRANCH_ID))
    return Test::BRANCH_INTERVENTION_OWNERSHIP_RESULT if parent.engine_error != DebuggerReplayEngine::EngineError.None
    branch_engine_step_count(parent, Test::INTERVENTION_TEST_PARENT_BOUNDARY)
    return Test::BRANCH_INTERVENTION_OWNERSHIP_RESULT if parent.event_count != Test::INTERVENTION_TEST_PARENT_BOUNDARY or not DebuggerReplayEngine::replay_engine_set_accumulator(parent, Test::INTERVENTION_TEST_PARENT_VALUE)
    branch_engine_step_count(parent, Test::INTERVENTION_TEST_PROGRAM_INSTRUCTION_COUNT.usize() - Test::INTERVENTION_TEST_PARENT_BOUNDARY)
    return Test::BRANCH_INTERVENTION_OWNERSHIP_RESULT if not parent.machine.halted or parent.machine.result != Test::INTERVENTION_TEST_PARENT_VALUE + Test::INTERVENTION_TEST_ADD_VALUE

    DebuggerReplayEngine::replay_engine_seek(parent, Test::INTERVENTION_TEST_CHILD_FORK_EVENT)
    return Test::BRANCH_INTERVENTION_OWNERSHIP_RESULT if parent.engine_error != DebuggerReplayEngine::EngineError.None or parent.event_count != Test::INTERVENTION_TEST_CHILD_FORK_EVENT
    child: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(parent, DebuggerIdentity::debug_id(Test::INTERVENTION_TEST_CHILD_BRANCH_ID))
    return Test::BRANCH_INTERVENTION_OWNERSHIP_RESULT if child.engine_error != DebuggerReplayEngine::EngineError.None
    branch_engine_step_count(child, Test::INTERVENTION_TEST_PROGRAM_INSTRUCTION_COUNT.usize() - Test::INTERVENTION_TEST_CHILD_FORK_EVENT)
    return Test::BRANCH_INTERVENTION_OWNERSHIP_RESULT if not child.machine.halted or child.machine.result != Test::INTERVENTION_TEST_EXPECTED_CHILD_RESULT
    return Test::BRANCH_INTERVENTION_OWNERSHIP_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(child)
    return 0

def check_fork_boundary_intervention_inheritance() -> i64:
    root: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(branch_intervention_test_image(), DebuggerIdentity::debug_id(Test::ENGINE_RECORDING_ID))
    parent: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(root, DebuggerIdentity::debug_id(Test::INTERVENTION_BOUNDARY_PARENT_BRANCH_ID))
    return Test::BRANCH_FORK_BOUNDARY_INTERVENTION_RESULT if parent.engine_error != DebuggerReplayEngine::EngineError.None
    branch_engine_step_count(parent, Test::INTERVENTION_BOUNDARY_EVENT)
    return Test::BRANCH_FORK_BOUNDARY_INTERVENTION_RESULT if not DebuggerReplayEngine::replay_engine_set_accumulator(parent, Test::INTERVENTION_TEST_PARENT_VALUE)
    child: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(parent, DebuggerIdentity::debug_id(Test::INTERVENTION_BOUNDARY_CHILD_BRANCH_ID))
    return Test::BRANCH_FORK_BOUNDARY_INTERVENTION_RESULT if child.engine_error != DebuggerReplayEngine::EngineError.None
    DebuggerReplayEngine::replay_engine_seek(child, Test::INTERVENTION_BOUNDARY_REWIND_EVENT)
    return Test::BRANCH_FORK_BOUNDARY_INTERVENTION_RESULT if child.engine_error != DebuggerReplayEngine::EngineError.None
    branch_engine_step_count(child, Test::INTERVENTION_TEST_PROGRAM_INSTRUCTION_COUNT.usize())
    return Test::BRANCH_FORK_BOUNDARY_INTERVENTION_RESULT if not child.machine.halted or child.machine.result != Test::INTERVENTION_BOUNDARY_EXPECTED_RESULT
    return Test::BRANCH_FORK_BOUNDARY_INTERVENTION_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(child)
    return 0

def check_initial_root_state_integrity() -> i64:
    root: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(branch_test_image(), DebuggerIdentity::debug_id(Test::ENGINE_RECORDING_ID))
    return Test::BRANCH_CORRUPT_INITIAL_ROOT_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(root)
    root.machine.accumulator <- Test::CORRUPT_INITIAL_ROOT_ACCUMULATOR
    return Test::BRANCH_CORRUPT_INITIAL_ROOT_RESULT if DebuggerReplayEngine::replay_engine_is_exact(root)
    rejected_fork: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(root, DebuggerIdentity::debug_id(Test::CORRUPT_INITIAL_ROOT_BRANCH_ID))
    return Test::BRANCH_CORRUPT_INITIAL_ROOT_RESULT if rejected_fork.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable
    return 0

def check_seek_preserves_branch_prefix() -> i64:
    root: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(branch_test_image(), DebuggerIdentity::debug_id(Test::ENGINE_RECORDING_ID))
    branch_engine_step_count(root, Test::PARENT_FORK_EVENT)
    child: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(root, DebuggerIdentity::debug_id(Test::FIRST_BRANCH_ID))
    return Test::BRANCH_PREFIX_RESULT if child.engine_error != DebuggerReplayEngine::EngineError.None
    branch_engine_step_count(child, Test::PARENT_CURRENT_EVENT - Test::PARENT_FORK_EVENT)
    return Test::BRANCH_PREFIX_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(child)

    DebuggerReplayEngine::replay_engine_seek(child, Test::REWIND_EVENT)
    return Test::BRANCH_PREFIX_RESULT if child.engine_error != DebuggerReplayEngine::EngineError.None or child.event_count != Test::REWIND_EVENT
    return Test::BRANCH_POSITION_RESULT if DebuggerReplayEngine::replay_engine_position(child).branch.value != Test::ROOT_BRANCH_ID
    early_fork: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(child, DebuggerIdentity::debug_id(Test::THIRD_BRANCH_ID))
    return Test::BRANCH_EARLY_FORK_RESULT if early_fork.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable
    branch_engine_step_count(child, Test::PARENT_FORK_EVENT - Test::REWIND_EVENT)
    return Test::BRANCH_PREFIX_RESULT if child.events[Test::PREFIX_FIRST_EVENT].position.branch.value != Test::ROOT_BRANCH_ID or child.events[Test::PREFIX_SECOND_EVENT].position.branch.value != Test::ROOT_BRANCH_ID or child.events[Test::PARENT_FIRST_EVENT].position.branch.value != Test::FIRST_BRANCH_ID or child.events[Test::PARENT_LAST_EVENT].position.branch.value != Test::FIRST_BRANCH_ID
    return Test::BRANCH_PREFIX_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(child)
    branch_engine_step_count(child, Test::PARENT_CURRENT_EVENT - Test::PARENT_FORK_EVENT)
    return Test::BRANCH_PREFIX_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(child)
    corrupt_fork_hash: mutable DebuggerReplayEngine::ReplayEngine = child
    corrupt_fork_hash.branch_fork_hashes[Test::FIRST_BRANCH_LINEAGE_INDEX] <- corrupt_fork_hash.branch_fork_hashes[Test::FIRST_BRANCH_LINEAGE_INDEX] + 1
    return Test::BRANCH_FORK_HASH_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_fork_hash)
    corrupt_current_fork_hash: mutable DebuggerReplayEngine::ReplayEngine = child
    corrupt_current_fork_hash.fork_state_hash <- corrupt_current_fork_hash.fork_state_hash + 1
    return Test::BRANCH_FORK_HASH_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_current_fork_hash)
    corrupt_parent_history: mutable DebuggerReplayEngine::ReplayEngine = child
    corrupt_parent_history.events[Test::FIRST_INSTRUCTION_INDEX].payload_hash <- corrupt_parent_history.events[Test::FIRST_INSTRUCTION_INDEX].payload_hash + 1
    rejected_corrupt_fork: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(corrupt_parent_history, DebuggerIdentity::debug_id(Test::THIRD_BRANCH_ID))
    return Test::BRANCH_CORRUPT_FORK_RESULT if rejected_corrupt_fork.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable

    grandchild: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(child, DebuggerIdentity::debug_id(Test::SECOND_BRANCH_ID))
    return Test::BRANCH_DEEP_PREFIX_RESULT if grandchild.engine_error != DebuggerReplayEngine::EngineError.None
    branch_engine_step_count(grandchild, Test::PROGRAM_INSTRUCTION_COUNT.usize() - Test::PARENT_CURRENT_EVENT)
    DebuggerReplayEngine::replay_engine_seek(grandchild, Test::DEEP_REWIND_EVENT)
    return Test::BRANCH_DEEP_PREFIX_RESULT if grandchild.engine_error != DebuggerReplayEngine::EngineError.None
    branch_engine_step_count(grandchild, Test::PARENT_CURRENT_EVENT - Test::DEEP_REWIND_EVENT)
    return Test::BRANCH_DEEP_PREFIX_RESULT if grandchild.events[Test::PREFIX_FIRST_EVENT].position.branch.value != Test::ROOT_BRANCH_ID or grandchild.events[Test::PREFIX_SECOND_EVENT].position.branch.value != Test::ROOT_BRANCH_ID or grandchild.events[Test::PARENT_FIRST_EVENT].position.branch.value != Test::FIRST_BRANCH_ID or grandchild.events[Test::PARENT_LAST_EVENT].position.branch.value != Test::FIRST_BRANCH_ID or grandchild.events[Test::PARENT_CURRENT_EVENT].position.branch.value != Test::SECOND_BRANCH_ID
    return Test::BRANCH_DEEP_PREFIX_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(grandchild)
    corrupt_ancestor_fork_hash: mutable DebuggerReplayEngine::ReplayEngine = grandchild
    corrupt_ancestor_fork_hash.branch_fork_hashes[Test::FIRST_BRANCH_LINEAGE_INDEX] <- corrupt_ancestor_fork_hash.branch_fork_hashes[Test::FIRST_BRANCH_LINEAGE_INDEX] + 1
    return Test::BRANCH_FORK_HASH_RESULT if DebuggerReplayEngine::replay_engine_is_exact(corrupt_ancestor_fork_hash)
    return 0

def main() -> i64:
    store: mutable DebuggerBranches::BranchStore = DebuggerBranches::branches_new()
    store <- DebuggerBranches::branches_fork(store, DebuggerIdentity::debug_id(0), Test::ROOT_EVENT, 10)
    root: DebuggerIdentity::DebugId = store.branches[0].id
    store <- DebuggerBranches::branches_fork(store, root, Test::CHILD_EVENT, 20)
    child: DebuggerIdentity::DebugId = store.branches[1].id
    intervention: DebuggerBranches::Intervention = DebuggerBranches::Intervention{event: Test::CHILD_EVENT, kind: DebuggerBranches::InterventionKind.Value, target: DebuggerIdentity::debug_id(8), value_hash: Test::VALUE_HASH}
    store <- DebuggerBranches::branches_add_intervention(store, child, intervention)
    return 1 if not DebuggerBranches::branches_is_valid(store)

    malformed: mutable DebuggerBranches::BranchStore = store
    malformed.branches[1].parent <- child
    return 2 if DebuggerBranches::branches_is_valid(malformed)

    malformed <- store
    malformed.branches[1].interventions[0].event <- Test::ROOT_EVENT
    return 3 if DebuggerBranches::branches_is_valid(malformed)

    malformed <- store
    malformed.next_id <- 1
    return 4 if DebuggerBranches::branches_is_valid(malformed)
    empty_counter: DebuggerBranches::BranchStore = DebuggerBranches::branches_new()
    empty_counter.next_id <- 9
    return 5 if DebuggerBranches::branches_is_valid(empty_counter)

    corrupt_fork_store: mutable DebuggerBranches::BranchStore = store
    corrupt_fork_store.next_id <- 9
    return Test::BRANCH_CORRUPT_STORE_FORK_RESULT if DebuggerBranches::branches_is_valid(corrupt_fork_store)
    rejected_corrupt_store_fork: DebuggerBranches::BranchStore = DebuggerBranches::branches_fork(corrupt_fork_store, root, Test::CHILD_EVENT, 30)
    return Test::BRANCH_CORRUPT_STORE_FORK_RESULT if rejected_corrupt_store_fork.count != corrupt_fork_store.count or rejected_corrupt_store_fork.next_id != corrupt_fork_store.next_id

    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: 1, instruction_count: 1, local_count: 0, has_return: true}
    image.instructions[0] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: 0, b: 0, source: zeroed}
    engine: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(Test::ENGINE_RECORDING_ID))
    first: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(engine, DebuggerIdentity::debug_id(Test::FIRST_BRANCH_ID))
    second: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(first, DebuggerIdentity::debug_id(Test::SECOND_BRANCH_ID))
    third: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(second, DebuggerIdentity::debug_id(Test::THIRD_BRANCH_ID))
    reused_ancestor: DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_fork(third, DebuggerIdentity::debug_id(Test::FIRST_BRANCH_ID))
    return Test::REUSED_ANCESTOR_RESULT if reused_ancestor.engine_error != DebuggerReplayEngine::EngineError.HistoryUnavailable
    return Test::VALID_DEEP_LINEAGE_RESULT if not DebuggerReplayEngine::replay_engine_is_exact(third)
    return Test::INVALID_BRANCH_FORK_RESULT if DebuggerReplayEngine::replay_engine_is_exact(reused_ancestor)
    branch_prefix_result: i64 = check_seek_preserves_branch_prefix()
    return branch_prefix_result if branch_prefix_result != 0
    intervention_ownership_result: i64 = check_branch_intervention_ownership()
    return intervention_ownership_result if intervention_ownership_result != 0
    fork_boundary_intervention_result: i64 = check_fork_boundary_intervention_inheritance()
    return fork_boundary_intervention_result if fork_boundary_intervention_result != 0
    initial_root_integrity_result: i64 = check_initial_root_state_integrity()
    return initial_root_integrity_result if initial_root_integrity_result != 0
    return 0
