include "../src/core/identity.elisa"
include "../src/core/cancellation.elisa"
include "../src/query/edir_provenance.elisa"
include "../src/query/engine.elisa"
include "../src/query/history.elisa"
include "../src/query/provenance.elisa"
include "../src/replay/engine.elisa"
include "../src/vm/edir.elisa"

const PROVENANCE_RESULT_INVALID_FINAL_STATE: i64 = 1
const PROVENANCE_RESULT_INVALID_INDEX: i64 = 2
const PROVENANCE_RESULT_INVALID_FIRST_WRITE: i64 = 3
const PROVENANCE_RESULT_INVALID_SECOND_WRITE: i64 = 4
const PROVENANCE_RESULT_INVALID_THIRD_WRITE: i64 = 5
const PROVENANCE_RESULT_INVALID_LOOKUP: i64 = 6
const PROVENANCE_RESULT_INVALID_REVERSE: i64 = 7
const PROVENANCE_RESULT_INVALID_REPLAY: i64 = 8
const PROVENANCE_RESULT_ACCEPTED_CORRUPT_EVENT: i64 = 9
const PROVENANCE_RESULT_RECORDED_FAILED_STORE: i64 = 10
const PROVENANCE_RESULT_INVALID_SEEK: i64 = 11
const PROVENANCE_RESULT_INVALID_REPLAYED_LOOKUP: i64 = 12
const PROVENANCE_RESULT_INVALID_QUERY: i64 = 13
const PROVENANCE_RESULT_INVALID_SYNTHETIC_ID: i64 = 14
const PROVENANCE_TEST_SUCCESS: i64 = 0
const PROVENANCE_EXPECTED_WRITE_COUNT: usize = 3
const PROVENANCE_EXPECTED_REWOUND_WRITE_COUNT: usize = 2
const PROVENANCE_EXPECTED_EMPTY_WRITE_COUNT: usize = 0
const PROVENANCE_EXPECTED_QUERY_MATCH_COUNT: usize = 2
const PROVENANCE_FIRST_MUTATION_INDEX: usize = 0
const PROVENANCE_SECOND_MUTATION_INDEX: usize = 1
const PROVENANCE_THIRD_MUTATION_INDEX: usize = 2
const PROVENANCE_FIRST_QUERY_MATCH_INDEX: usize = 0
const PROVENANCE_SECOND_QUERY_MATCH_INDEX: usize = 1
const PROVENANCE_EVENT_COUNT_OFFSET: usize = 1
const PROVENANCE_CORRUPT_HASH_OFFSET: u64 = 1

const PROVENANCE_RECORDING_ID: u64 = 30
const PROVENANCE_RECORDING_ID_OFFSET: u64 = 1
const PROVENANCE_SOURCE_FILE_ID: u64 = 40
const PROVENANCE_SOURCE_BYTE_OFFSET: u64 = 1
const PROVENANCE_SOURCE_START_COLUMN: u32 = 0
const PROVENANCE_SOURCE_END_COLUMN: u32 = 1
const PROVENANCE_PROGRAM_VERSION: u32 = 1
const PROVENANCE_INSTRUCTION_COUNT: u64 = 9
const PROVENANCE_LOCAL_COUNT: u64 = 0
const PROVENANCE_MEMORY_BINDING_ID_BASE: u64 = 18446744073709551552
const PROVENANCE_FIRST_ALLOCATION_ID: u64 = 1
const PROVENANCE_SECOND_ALLOCATION_ID: u64 = 4
const PROVENANCE_ALLOCATION_GENERATION: u64 = 1
const PROVENANCE_INVALID_ID: u64 = 0
const PROVENANCE_MAX_IDENTIFIER: u64 = 18446744073709551615
const PROVENANCE_FIRST_STORE_EVENT: u64 = 2
const PROVENANCE_SECOND_STORE_EVENT: u64 = 5
const PROVENANCE_THIRD_STORE_EVENT: u64 = 7
const PROVENANCE_FIRST_STORE_LINE: u32 = 12
const PROVENANCE_SECOND_STORE_LINE: u32 = 24
const PROVENANCE_THIRD_STORE_LINE: u32 = 36
const PROVENANCE_ALLOCATE_ONE_SLOT: i64 = 1
const PROVENANCE_UNUSED_OPERAND: i64 = 0
const PROVENANCE_FIRST_VALUE: i64 = 11
const PROVENANCE_SECOND_VALUE: i64 = 22
const PROVENANCE_THIRD_VALUE: i64 = 33
const PROVENANCE_SLOT_ZERO: u64 = 0
const PROVENANCE_SLOT_ONE: u64 = 1
const PROVENANCE_SLOT_LAST: u64 = 63
const PROVENANCE_INVALID_SLOT: u64 = 64
const PROVENANCE_STORE_ZERO_INDEX: usize = 2
const PROVENANCE_STORE_ONE_INDEX: usize = 5
const PROVENANCE_STORE_ZERO_AGAIN_INDEX: usize = 7
const PROVENANCE_RETURN_INDEX: usize = 8
const PROVENANCE_FIRST_ALLOCATE_INDEX: usize = 0
const PROVENANCE_FIRST_CONSTANT_INDEX: usize = 1
const PROVENANCE_SECOND_ALLOCATE_INDEX: usize = 3
const PROVENANCE_SECOND_CONSTANT_INDEX: usize = 4
const PROVENANCE_THIRD_CONSTANT_INDEX: usize = 6
const PROVENANCE_REPLAY_LIMIT: u64 = 16
const PROVENANCE_AFTER_FIRST_REVERSE: usize = 8
const PROVENANCE_BEFORE_LAST_WRITE: u64 = 7
const PROVENANCE_AFTER_SECOND_REVERSE: usize = 7
const PROVENANCE_AFTER_REPLAYED_WRITE: usize = 8
const PROVENANCE_BEFORE_LAST_SLOT_ZERO_WRITE: u64 = 8
const PROVENANCE_BEFORE_FIRST_WRITE: u64 = 3
const PROVENANCE_QUERY_FIRST_EVENT: u64 = 0
const PROVENANCE_QUERY_LAST_EVENT: u64 = 8
const PROVENANCE_QUERY_MAX_RESULTS: u64 = 4
const PROVENANCE_QUERY_MAX_STEPS: u64 = 4
const PROVENANCE_EMPTY_PROGRAM_VERSION: u32 = 1
const PROVENANCE_EMPTY_PROGRAM_COUNT: u64 = 2
const PROVENANCE_FAILED_STORE_INDEX: usize = 0
const PROVENANCE_EMPTY_RETURN_INDEX: usize = 1
const PROVENANCE_FIRST_ALLOCATE_LINE: u32 = 10
const PROVENANCE_FIRST_CONSTANT_LINE: u32 = 11
const PROVENANCE_SECOND_ALLOCATE_LINE: u32 = 22
const PROVENANCE_SECOND_CONSTANT_LINE: u32 = 23
const PROVENANCE_THIRD_CONSTANT_LINE: u32 = 35
const PROVENANCE_RETURN_LINE: u32 = 40
const PROVENANCE_FAILED_STORE_LINE: u32 = 50
const PROVENANCE_EMPTY_RETURN_LINE: u32 = 51
const PROVENANCE_CANCELLATION_GENERATION: u64 = 0

def provenance_source(line: u32) -> DebuggerIdentity::SourceSpan:
    return DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(PROVENANCE_SOURCE_FILE_ID),
        start_byte: line.u64(),
        end_byte: line.u64() + PROVENANCE_SOURCE_BYTE_OFFSET,
        start_line: line,
        start_column: PROVENANCE_SOURCE_START_COLUMN,
        end_line: line,
        end_column: PROVENANCE_SOURCE_END_COLUMN,
        discriminator: PROVENANCE_SOURCE_START_COLUMN
    }

def provenance_instruction(opcode: DebuggerEDIR::Opcode, operand: i64, line: u32) -> DebuggerEDIR::Instruction:
    return DebuggerEDIR::Instruction{opcode: opcode, a: operand, b: PROVENANCE_UNUSED_OPERAND, source: provenance_source(line)}

def provenance_test_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: PROVENANCE_PROGRAM_VERSION, instruction_count: PROVENANCE_INSTRUCTION_COUNT, local_count: PROVENANCE_LOCAL_COUNT, has_return: true}
    image.instructions[PROVENANCE_FIRST_ALLOCATE_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Allocate, PROVENANCE_ALLOCATE_ONE_SLOT, PROVENANCE_FIRST_ALLOCATE_LINE)
    image.instructions[PROVENANCE_FIRST_CONSTANT_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Constant, PROVENANCE_FIRST_VALUE, PROVENANCE_FIRST_CONSTANT_LINE)
    image.instructions[PROVENANCE_STORE_ZERO_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.StoreMemory, PROVENANCE_SLOT_ZERO.i64(), PROVENANCE_FIRST_STORE_LINE)
    image.instructions[PROVENANCE_SECOND_ALLOCATE_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Allocate, PROVENANCE_ALLOCATE_ONE_SLOT, PROVENANCE_SECOND_ALLOCATE_LINE)
    image.instructions[PROVENANCE_SECOND_CONSTANT_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Constant, PROVENANCE_SECOND_VALUE, PROVENANCE_SECOND_CONSTANT_LINE)
    image.instructions[PROVENANCE_STORE_ONE_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.StoreMemory, PROVENANCE_SLOT_ONE.i64(), PROVENANCE_SECOND_STORE_LINE)
    image.instructions[PROVENANCE_THIRD_CONSTANT_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Constant, PROVENANCE_THIRD_VALUE, PROVENANCE_THIRD_CONSTANT_LINE)
    image.instructions[PROVENANCE_STORE_ZERO_AGAIN_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.StoreMemory, PROVENANCE_SLOT_ZERO.i64(), PROVENANCE_THIRD_STORE_LINE)
    image.instructions[PROVENANCE_RETURN_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Return, PROVENANCE_UNUSED_OPERAND, PROVENANCE_RETURN_LINE)
    return image

def provenance_failed_store_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: PROVENANCE_EMPTY_PROGRAM_VERSION, instruction_count: PROVENANCE_EMPTY_PROGRAM_COUNT, local_count: PROVENANCE_LOCAL_COUNT, has_return: true}
    image.instructions[PROVENANCE_FAILED_STORE_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.StoreMemory, PROVENANCE_SLOT_ZERO.i64(), PROVENANCE_FAILED_STORE_LINE)
    image.instructions[PROVENANCE_EMPTY_RETURN_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Return, PROVENANCE_UNUSED_OPERAND, PROVENANCE_EMPTY_RETURN_LINE)
    return image

def main() -> i64:
    valid_allocation: DebuggerIdentity::AllocationIdentity = DebuggerIdentity::AllocationIdentity{
        allocation: DebuggerIdentity::debug_id(PROVENANCE_FIRST_ALLOCATION_ID),
        generation: PROVENANCE_ALLOCATION_GENERATION,
        offset: PROVENANCE_SLOT_ZERO
    }
    last_slot_binding: DebuggerIdentity::BindingIdentity = DebuggerEDIRProvenance::edir_provenance_binding(valid_allocation, PROVENANCE_SLOT_LAST)
    return PROVENANCE_RESULT_INVALID_SYNTHETIC_ID if last_slot_binding.declaration.value != PROVENANCE_MAX_IDENTIFIER
    invalid_allocation: DebuggerIdentity::AllocationIdentity = zeroed
    invalid_binding: DebuggerIdentity::BindingIdentity = DebuggerEDIRProvenance::edir_provenance_binding(invalid_allocation, PROVENANCE_SLOT_ZERO)
    return PROVENANCE_RESULT_INVALID_SYNTHETIC_ID if invalid_binding.declaration.value != PROVENANCE_INVALID_ID
    out_of_range_binding: DebuggerIdentity::BindingIdentity = DebuggerEDIRProvenance::edir_provenance_binding(valid_allocation, PROVENANCE_INVALID_SLOT)
    return PROVENANCE_RESULT_INVALID_SYNTHETIC_ID if out_of_range_binding.declaration.value != PROVENANCE_INVALID_ID

    engine: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(provenance_test_image(), DebuggerIdentity::debug_id(PROVENANCE_RECORDING_ID))
    DebuggerReplayEngine::replay_engine_run(engine, PROVENANCE_REPLAY_LIMIT)
    return PROVENANCE_RESULT_INVALID_FINAL_STATE if not engine.machine.halted or engine.engine_error != DebuggerReplayEngine::EngineError.None

    writes: DebuggerProvenance::ProvenanceIndex = DebuggerEDIRProvenance::edir_provenance_from_engine(engine)
    return PROVENANCE_RESULT_INVALID_INDEX if not DebuggerProvenance::provenance_is_complete(writes) or DebuggerProvenance::provenance_count(writes) != PROVENANCE_EXPECTED_WRITE_COUNT
    first_write: DebuggerProvenance::Mutation = writes.mutations[PROVENANCE_FIRST_MUTATION_INDEX]
    second_write: DebuggerProvenance::Mutation = writes.mutations[PROVENANCE_SECOND_MUTATION_INDEX]
    third_write: DebuggerProvenance::Mutation = writes.mutations[PROVENANCE_THIRD_MUTATION_INDEX]
    return PROVENANCE_RESULT_INVALID_FIRST_WRITE if first_write.event != PROVENANCE_FIRST_STORE_EVENT or first_write.value_hash != PROVENANCE_FIRST_VALUE.u64() or first_write.source.start_line != PROVENANCE_FIRST_STORE_LINE
    return PROVENANCE_RESULT_INVALID_FIRST_WRITE if first_write.allocation.allocation.value != PROVENANCE_FIRST_ALLOCATION_ID or first_write.allocation.generation != PROVENANCE_ALLOCATION_GENERATION or first_write.allocation.offset != PROVENANCE_SLOT_ZERO
    return PROVENANCE_RESULT_INVALID_FIRST_WRITE if first_write.binding.declaration.value != PROVENANCE_MEMORY_BINDING_ID_BASE or first_write.binding.incarnation != PROVENANCE_FIRST_ALLOCATION_ID
    return PROVENANCE_RESULT_INVALID_SECOND_WRITE if second_write.event != PROVENANCE_SECOND_STORE_EVENT or second_write.value_hash != PROVENANCE_SECOND_VALUE.u64() or second_write.source.start_line != PROVENANCE_SECOND_STORE_LINE
    return PROVENANCE_RESULT_INVALID_SECOND_WRITE if second_write.allocation.allocation.value != PROVENANCE_SECOND_ALLOCATION_ID or second_write.allocation.offset != PROVENANCE_SLOT_ZERO
    return PROVENANCE_RESULT_INVALID_SECOND_WRITE if second_write.binding.declaration.value != PROVENANCE_MEMORY_BINDING_ID_BASE + PROVENANCE_SLOT_ONE or second_write.binding.incarnation != PROVENANCE_SECOND_ALLOCATION_ID
    return PROVENANCE_RESULT_INVALID_THIRD_WRITE if third_write.event != PROVENANCE_THIRD_STORE_EVENT or third_write.value_hash != PROVENANCE_THIRD_VALUE.u64() or third_write.source.start_line != PROVENANCE_THIRD_STORE_LINE
    return PROVENANCE_RESULT_INVALID_THIRD_WRITE if third_write.allocation.allocation.value != PROVENANCE_FIRST_ALLOCATION_ID or third_write.allocation.offset != PROVENANCE_SLOT_ZERO

    last_slot_zero: DebuggerProvenance::Mutation = DebuggerEDIRProvenance::edir_provenance_last_memory_write(engine, PROVENANCE_SLOT_ZERO, PROVENANCE_BEFORE_LAST_SLOT_ZERO_WRITE)
    return PROVENANCE_RESULT_INVALID_LOOKUP if last_slot_zero.event != PROVENANCE_THIRD_STORE_EVENT or last_slot_zero.value_hash != PROVENANCE_THIRD_VALUE.u64()
    first_slot_zero: DebuggerProvenance::Mutation = DebuggerProvenance::provenance_last_write_at_or_before(writes, first_write.binding, PROVENANCE_BEFORE_FIRST_WRITE)
    return PROVENANCE_RESULT_INVALID_LOOKUP if first_slot_zero.event != PROVENANCE_FIRST_STORE_EVENT
    query_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: PROVENANCE_QUERY_FIRST_EVENT, last_event: PROVENANCE_QUERY_LAST_EVENT, max_results: PROVENANCE_QUERY_MAX_RESULTS, max_steps: PROVENANCE_QUERY_MAX_STEPS}
    query_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(PROVENANCE_CANCELLATION_GENERATION)
    query: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(writes, first_write.binding, query_window, query_token)
    return PROVENANCE_RESULT_INVALID_QUERY if not query.complete or query.count != PROVENANCE_EXPECTED_QUERY_MATCH_COUNT or query.matches[PROVENANCE_FIRST_QUERY_MATCH_INDEX].event != PROVENANCE_FIRST_STORE_EVENT or query.matches[PROVENANCE_SECOND_QUERY_MATCH_INDEX].event != PROVENANCE_THIRD_STORE_EVENT
    return PROVENANCE_RESULT_INVALID_QUERY if query.matches[PROVENANCE_FIRST_QUERY_MATCH_INDEX].mutation.value_hash != PROVENANCE_FIRST_VALUE.u64() or query.matches[PROVENANCE_SECOND_QUERY_MATCH_INDEX].mutation.value_hash != PROVENANCE_THIRD_VALUE.u64()

    DebuggerReplayEngine::replay_engine_reverse_one(engine)
    return PROVENANCE_RESULT_INVALID_REVERSE if engine.event_count != PROVENANCE_AFTER_FIRST_REVERSE
    DebuggerReplayEngine::replay_engine_reverse_one(engine)
    rewound: DebuggerProvenance::ProvenanceIndex = DebuggerEDIRProvenance::edir_provenance_from_engine(engine)
    return PROVENANCE_RESULT_INVALID_REVERSE if engine.event_count != PROVENANCE_AFTER_SECOND_REVERSE or not DebuggerProvenance::provenance_is_complete(rewound) or DebuggerProvenance::provenance_count(rewound) != PROVENANCE_EXPECTED_REWOUND_WRITE_COUNT
    last_before_rewound_store: DebuggerProvenance::Mutation = DebuggerEDIRProvenance::edir_provenance_last_memory_write(engine, PROVENANCE_SLOT_ZERO, PROVENANCE_BEFORE_LAST_WRITE)
    return PROVENANCE_RESULT_INVALID_REVERSE if last_before_rewound_store.event != PROVENANCE_FIRST_STORE_EVENT

    DebuggerReplayEngine::replay_engine_step(engine)
    replayed: DebuggerProvenance::ProvenanceIndex = DebuggerEDIRProvenance::edir_provenance_from_engine(engine)
    return PROVENANCE_RESULT_INVALID_REPLAY if engine.event_count != PROVENANCE_AFTER_REPLAYED_WRITE or not DebuggerProvenance::provenance_is_complete(replayed) or DebuggerProvenance::provenance_count(replayed) != PROVENANCE_EXPECTED_WRITE_COUNT
    replayed_last_write: DebuggerProvenance::Mutation = DebuggerEDIRProvenance::edir_provenance_last_memory_write(engine, PROVENANCE_SLOT_ZERO, PROVENANCE_BEFORE_LAST_SLOT_ZERO_WRITE)
    return PROVENANCE_RESULT_INVALID_REPLAY if replayed_last_write.event != PROVENANCE_THIRD_STORE_EVENT or replayed_last_write.value_hash != PROVENANCE_THIRD_VALUE.u64()

    DebuggerReplayEngine::replay_engine_seek(engine, PROVENANCE_SECOND_STORE_EVENT.usize() + PROVENANCE_EVENT_COUNT_OFFSET)
    sought: DebuggerProvenance::ProvenanceIndex = DebuggerEDIRProvenance::edir_provenance_from_engine(engine)
    return PROVENANCE_RESULT_INVALID_SEEK if engine.event_count != PROVENANCE_SECOND_STORE_EVENT.usize() + PROVENANCE_EVENT_COUNT_OFFSET or not DebuggerProvenance::provenance_is_complete(sought) or DebuggerProvenance::provenance_count(sought) != PROVENANCE_EXPECTED_REWOUND_WRITE_COUNT
    DebuggerReplayEngine::replay_engine_seek(engine, PROVENANCE_INSTRUCTION_COUNT.usize())
    returned: DebuggerProvenance::ProvenanceIndex = DebuggerEDIRProvenance::edir_provenance_from_engine(engine)
    return PROVENANCE_RESULT_INVALID_REPLAYED_LOOKUP if not DebuggerProvenance::provenance_is_complete(returned) or DebuggerProvenance::provenance_count(returned) != PROVENANCE_EXPECTED_WRITE_COUNT

    corrupted: mutable DebuggerReplayEngine::ReplayEngine = engine
    corrupted.events[PROVENANCE_FIRST_STORE_EVENT.usize()].payload_hash <- corrupted.events[PROVENANCE_FIRST_STORE_EVENT.usize()].payload_hash + PROVENANCE_CORRUPT_HASH_OFFSET
    corrupted_writes: DebuggerProvenance::ProvenanceIndex = DebuggerEDIRProvenance::edir_provenance_from_engine(corrupted)
    return PROVENANCE_RESULT_ACCEPTED_CORRUPT_EVENT if DebuggerProvenance::provenance_is_complete(corrupted_writes)

    failed_store: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(provenance_failed_store_image(), DebuggerIdentity::debug_id(PROVENANCE_RECORDING_ID + PROVENANCE_RECORDING_ID_OFFSET))
    DebuggerReplayEngine::replay_engine_step(failed_store)
    failed_store_writes: DebuggerProvenance::ProvenanceIndex = DebuggerEDIRProvenance::edir_provenance_from_engine(failed_store)
    return PROVENANCE_RESULT_RECORDED_FAILED_STORE if not DebuggerProvenance::provenance_is_complete(failed_store_writes) or DebuggerProvenance::provenance_count(failed_store_writes) != PROVENANCE_EXPECTED_EMPTY_WRITE_COUNT
    return PROVENANCE_TEST_SUCCESS
