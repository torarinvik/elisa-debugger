include "../src/core/identity.elisa"
include "../src/core/cancellation.elisa"
include "../src/query/edir_provenance.elisa"
include "../src/query/engine.elisa"
include "../src/query/history.elisa"
include "../src/query/provenance.elisa"
include "../src/replay/engine.elisa"
include "../src/vm/edir.elisa"

const module Test:
    PROVENANCE_RESULT_INVALID_FINAL_STATE: i64 = 1
    PROVENANCE_RESULT_INVALID_INDEX: i64 = 2
    PROVENANCE_RESULT_INVALID_FIRST_WRITE: i64 = 3
    PROVENANCE_RESULT_INVALID_SECOND_WRITE: i64 = 4
    PROVENANCE_RESULT_INVALID_THIRD_WRITE: i64 = 5
    PROVENANCE_RESULT_INVALID_LOOKUP: i64 = 6
    PROVENANCE_RESULT_INVALID_REVERSE: i64 = 7
    PROVENANCE_RESULT_INVALID_REPLAY: i64 = 8
    PROVENANCE_RESULT_ACCEPTED_CORRUPT_EVENT: i64 = 9
    PROVENANCE_RESULT_RECORDED_FAILED_STORE: i64 = 10
    PROVENANCE_RESULT_INVALID_SEEK: i64 = 11
    PROVENANCE_RESULT_INVALID_REPLAYED_LOOKUP: i64 = 12
    PROVENANCE_RESULT_INVALID_QUERY: i64 = 13
    PROVENANCE_RESULT_INVALID_SYNTHETIC_ID: i64 = 14
    PROVENANCE_TEST_SUCCESS: i64 = 0
    PROVENANCE_EXPECTED_WRITE_COUNT: usize = 3
    PROVENANCE_EXPECTED_REWOUND_WRITE_COUNT: usize = 2
    PROVENANCE_EXPECTED_EMPTY_WRITE_COUNT: usize = 0
    PROVENANCE_EXPECTED_QUERY_MATCH_COUNT: usize = 2
    PROVENANCE_FIRST_MUTATION_INDEX: usize = 0
    PROVENANCE_SECOND_MUTATION_INDEX: usize = 1
    PROVENANCE_THIRD_MUTATION_INDEX: usize = 2
    PROVENANCE_FIRST_QUERY_MATCH_INDEX: usize = 0
    PROVENANCE_SECOND_QUERY_MATCH_INDEX: usize = 1
    PROVENANCE_EVENT_COUNT_OFFSET: usize = 1
    PROVENANCE_CORRUPT_HASH_OFFSET: u64 = 1
    PROVENANCE_RECORDING_ID: u64 = 30
    PROVENANCE_RECORDING_ID_OFFSET: u64 = 1
    PROVENANCE_SOURCE_FILE_ID: u64 = 40
    PROVENANCE_SOURCE_BYTE_OFFSET: u64 = 1
    PROVENANCE_SOURCE_START_COLUMN: u32 = 0
    PROVENANCE_SOURCE_END_COLUMN: u32 = 1
    PROVENANCE_PROGRAM_VERSION: u32 = 1
    PROVENANCE_INSTRUCTION_COUNT: u64 = 9
    PROVENANCE_LOCAL_COUNT: u64 = 0
    PROVENANCE_MEMORY_BINDING_ID_BASE: u64 = 18446744073709551552
    PROVENANCE_FIRST_ALLOCATION_ID: u64 = 1
    PROVENANCE_SECOND_ALLOCATION_ID: u64 = 4
    PROVENANCE_ALLOCATION_GENERATION: u64 = 1
    PROVENANCE_INVALID_ID: u64 = 0
    PROVENANCE_MAX_IDENTIFIER: u64 = 18446744073709551615
    PROVENANCE_FIRST_STORE_EVENT: u64 = 2
    PROVENANCE_SECOND_STORE_EVENT: u64 = 5
    PROVENANCE_THIRD_STORE_EVENT: u64 = 7
    PROVENANCE_FIRST_STORE_LINE: u32 = 12
    PROVENANCE_SECOND_STORE_LINE: u32 = 24
    PROVENANCE_THIRD_STORE_LINE: u32 = 36
    PROVENANCE_ALLOCATE_ONE_SLOT: i64 = 1
    PROVENANCE_UNUSED_OPERAND: i64 = 0
    PROVENANCE_FIRST_VALUE: i64 = 11
    PROVENANCE_SECOND_VALUE: i64 = 22
    PROVENANCE_THIRD_VALUE: i64 = 33
    PROVENANCE_SLOT_ZERO: u64 = 0
    PROVENANCE_SLOT_ONE: u64 = 1
    PROVENANCE_SLOT_LAST: u64 = 63
    PROVENANCE_INVALID_SLOT: u64 = 64
    PROVENANCE_STORE_ZERO_INDEX: usize = 2
    PROVENANCE_STORE_ONE_INDEX: usize = 5
    PROVENANCE_STORE_ZERO_AGAIN_INDEX: usize = 7
    PROVENANCE_RETURN_INDEX: usize = 8
    PROVENANCE_FIRST_ALLOCATE_INDEX: usize = 0
    PROVENANCE_FIRST_CONSTANT_INDEX: usize = 1
    PROVENANCE_SECOND_ALLOCATE_INDEX: usize = 3
    PROVENANCE_SECOND_CONSTANT_INDEX: usize = 4
    PROVENANCE_THIRD_CONSTANT_INDEX: usize = 6
    PROVENANCE_REPLAY_LIMIT: u64 = 16
    PROVENANCE_AFTER_FIRST_REVERSE: usize = 8
    PROVENANCE_BEFORE_LAST_WRITE: u64 = 7
    PROVENANCE_AFTER_SECOND_REVERSE: usize = 7
    PROVENANCE_AFTER_REPLAYED_WRITE: usize = 8
    PROVENANCE_BEFORE_LAST_SLOT_ZERO_WRITE: u64 = 8
    PROVENANCE_BEFORE_FIRST_WRITE: u64 = 3
    PROVENANCE_QUERY_FIRST_EVENT: u64 = 0
    PROVENANCE_QUERY_LAST_EVENT: u64 = 8
    PROVENANCE_QUERY_MAX_RESULTS: u64 = 4
    PROVENANCE_QUERY_MAX_STEPS: u64 = 4
    PROVENANCE_EMPTY_PROGRAM_VERSION: u32 = 1
    PROVENANCE_EMPTY_PROGRAM_COUNT: u64 = 2
    PROVENANCE_FAILED_STORE_INDEX: usize = 0
    PROVENANCE_EMPTY_RETURN_INDEX: usize = 1
    PROVENANCE_FIRST_ALLOCATE_LINE: u32 = 10
    PROVENANCE_FIRST_CONSTANT_LINE: u32 = 11
    PROVENANCE_SECOND_ALLOCATE_LINE: u32 = 22
    PROVENANCE_SECOND_CONSTANT_LINE: u32 = 23
    PROVENANCE_THIRD_CONSTANT_LINE: u32 = 35
    PROVENANCE_RETURN_LINE: u32 = 40
    PROVENANCE_FAILED_STORE_LINE: u32 = 50
    PROVENANCE_EMPTY_RETURN_LINE: u32 = 51
    PROVENANCE_CANCELLATION_GENERATION: u64 = 0



def provenance_source(line: u32) -> DebuggerIdentity::SourceSpan:
    return DebuggerIdentity::SourceSpan{
        file: DebuggerIdentity::debug_id(Test::PROVENANCE_SOURCE_FILE_ID),
        start_byte: line.u64(),
        end_byte: line.u64() + Test::PROVENANCE_SOURCE_BYTE_OFFSET,
        start_line: line,
        start_column: Test::PROVENANCE_SOURCE_START_COLUMN,
        end_line: line,
        end_column: Test::PROVENANCE_SOURCE_END_COLUMN,
        discriminator: Test::PROVENANCE_SOURCE_START_COLUMN
    }

def provenance_instruction(opcode: DebuggerEDIR::Opcode, operand: i64, line: u32) -> DebuggerEDIR::Instruction:
    return DebuggerEDIR::Instruction{opcode: opcode, a: operand, b: Test::PROVENANCE_UNUSED_OPERAND, source: provenance_source(line)}

def provenance_test_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROVENANCE_PROGRAM_VERSION, instruction_count: Test::PROVENANCE_INSTRUCTION_COUNT, local_count: Test::PROVENANCE_LOCAL_COUNT, has_return: true}
    image.instructions[Test::PROVENANCE_FIRST_ALLOCATE_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Allocate, Test::PROVENANCE_ALLOCATE_ONE_SLOT, Test::PROVENANCE_FIRST_ALLOCATE_LINE)
    image.instructions[Test::PROVENANCE_FIRST_CONSTANT_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Constant, Test::PROVENANCE_FIRST_VALUE, Test::PROVENANCE_FIRST_CONSTANT_LINE)
    image.instructions[Test::PROVENANCE_STORE_ZERO_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.StoreMemory, Test::PROVENANCE_SLOT_ZERO.i64(), Test::PROVENANCE_FIRST_STORE_LINE)
    image.instructions[Test::PROVENANCE_SECOND_ALLOCATE_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Allocate, Test::PROVENANCE_ALLOCATE_ONE_SLOT, Test::PROVENANCE_SECOND_ALLOCATE_LINE)
    image.instructions[Test::PROVENANCE_SECOND_CONSTANT_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Constant, Test::PROVENANCE_SECOND_VALUE, Test::PROVENANCE_SECOND_CONSTANT_LINE)
    image.instructions[Test::PROVENANCE_STORE_ONE_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.StoreMemory, Test::PROVENANCE_SLOT_ONE.i64(), Test::PROVENANCE_SECOND_STORE_LINE)
    image.instructions[Test::PROVENANCE_THIRD_CONSTANT_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Constant, Test::PROVENANCE_THIRD_VALUE, Test::PROVENANCE_THIRD_CONSTANT_LINE)
    image.instructions[Test::PROVENANCE_STORE_ZERO_AGAIN_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.StoreMemory, Test::PROVENANCE_SLOT_ZERO.i64(), Test::PROVENANCE_THIRD_STORE_LINE)
    image.instructions[Test::PROVENANCE_RETURN_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Return, Test::PROVENANCE_UNUSED_OPERAND, Test::PROVENANCE_RETURN_LINE)
    return image

def provenance_failed_store_image() -> DebuggerEDIR::ProgramImage:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROVENANCE_EMPTY_PROGRAM_VERSION, instruction_count: Test::PROVENANCE_EMPTY_PROGRAM_COUNT, local_count: Test::PROVENANCE_LOCAL_COUNT, has_return: true}
    image.instructions[Test::PROVENANCE_FAILED_STORE_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.StoreMemory, Test::PROVENANCE_SLOT_ZERO.i64(), Test::PROVENANCE_FAILED_STORE_LINE)
    image.instructions[Test::PROVENANCE_EMPTY_RETURN_INDEX] <- provenance_instruction(DebuggerEDIR::Opcode.Return, Test::PROVENANCE_UNUSED_OPERAND, Test::PROVENANCE_EMPTY_RETURN_LINE)
    return image

def main() -> i64:
    valid_allocation: DebuggerIdentity::AllocationIdentity = DebuggerIdentity::AllocationIdentity{
        allocation: DebuggerIdentity::debug_id(Test::PROVENANCE_FIRST_ALLOCATION_ID),
        generation: Test::PROVENANCE_ALLOCATION_GENERATION,
        offset: Test::PROVENANCE_SLOT_ZERO
    }
    last_slot_binding: DebuggerIdentity::BindingIdentity = DebuggerEDIRProvenance::edir_provenance_binding(valid_allocation, Test::PROVENANCE_SLOT_LAST)
    return Test::PROVENANCE_RESULT_INVALID_SYNTHETIC_ID if last_slot_binding.declaration.value != Test::PROVENANCE_MAX_IDENTIFIER
    invalid_allocation: DebuggerIdentity::AllocationIdentity = zeroed
    invalid_binding: DebuggerIdentity::BindingIdentity = DebuggerEDIRProvenance::edir_provenance_binding(invalid_allocation, Test::PROVENANCE_SLOT_ZERO)
    return Test::PROVENANCE_RESULT_INVALID_SYNTHETIC_ID if invalid_binding.declaration.value != Test::PROVENANCE_INVALID_ID
    out_of_range_binding: DebuggerIdentity::BindingIdentity = DebuggerEDIRProvenance::edir_provenance_binding(valid_allocation, Test::PROVENANCE_INVALID_SLOT)
    return Test::PROVENANCE_RESULT_INVALID_SYNTHETIC_ID if out_of_range_binding.declaration.value != Test::PROVENANCE_INVALID_ID

    engine: mutable DebuggerReplayEngine::ReplayEngine
    DebuggerReplayEngine::replay_engine_initialize(engine, provenance_test_image(), DebuggerIdentity::debug_id(Test::PROVENANCE_RECORDING_ID))
    DebuggerReplayEngine::replay_engine_run(engine, Test::PROVENANCE_REPLAY_LIMIT)
    return Test::PROVENANCE_RESULT_INVALID_FINAL_STATE if not engine.machine.halted or engine.engine_error != DebuggerReplayEngine::EngineError.None

    writes: mutable DebuggerProvenance::ProvenanceIndex = zeroed
    DebuggerEDIRProvenance::edir_provenance_from_engine(engine, writes)
    return Test::PROVENANCE_RESULT_INVALID_INDEX if not DebuggerProvenance::provenance_is_complete(writes) or DebuggerProvenance::provenance_count(writes) != Test::PROVENANCE_EXPECTED_WRITE_COUNT
    first_write: DebuggerProvenance::Mutation = writes.mutations[Test::PROVENANCE_FIRST_MUTATION_INDEX]
    second_write: DebuggerProvenance::Mutation = writes.mutations[Test::PROVENANCE_SECOND_MUTATION_INDEX]
    third_write: DebuggerProvenance::Mutation = writes.mutations[Test::PROVENANCE_THIRD_MUTATION_INDEX]
    return Test::PROVENANCE_RESULT_INVALID_FIRST_WRITE if first_write.event != Test::PROVENANCE_FIRST_STORE_EVENT or first_write.value_hash != Test::PROVENANCE_FIRST_VALUE.u64() or first_write.source.start_line != Test::PROVENANCE_FIRST_STORE_LINE
    return Test::PROVENANCE_RESULT_INVALID_FIRST_WRITE if first_write.allocation.allocation.value != Test::PROVENANCE_FIRST_ALLOCATION_ID or first_write.allocation.generation != Test::PROVENANCE_ALLOCATION_GENERATION or first_write.allocation.offset != Test::PROVENANCE_SLOT_ZERO
    return Test::PROVENANCE_RESULT_INVALID_FIRST_WRITE if first_write.binding.declaration.value != Test::PROVENANCE_MEMORY_BINDING_ID_BASE or first_write.binding.incarnation != Test::PROVENANCE_FIRST_ALLOCATION_ID
    return Test::PROVENANCE_RESULT_INVALID_SECOND_WRITE if second_write.event != Test::PROVENANCE_SECOND_STORE_EVENT or second_write.value_hash != Test::PROVENANCE_SECOND_VALUE.u64() or second_write.source.start_line != Test::PROVENANCE_SECOND_STORE_LINE
    return Test::PROVENANCE_RESULT_INVALID_SECOND_WRITE if second_write.allocation.allocation.value != Test::PROVENANCE_SECOND_ALLOCATION_ID or second_write.allocation.offset != Test::PROVENANCE_SLOT_ZERO
    return Test::PROVENANCE_RESULT_INVALID_SECOND_WRITE if second_write.binding.declaration.value != Test::PROVENANCE_MEMORY_BINDING_ID_BASE + Test::PROVENANCE_SLOT_ONE or second_write.binding.incarnation != Test::PROVENANCE_SECOND_ALLOCATION_ID
    return Test::PROVENANCE_RESULT_INVALID_THIRD_WRITE if third_write.event != Test::PROVENANCE_THIRD_STORE_EVENT or third_write.value_hash != Test::PROVENANCE_THIRD_VALUE.u64() or third_write.source.start_line != Test::PROVENANCE_THIRD_STORE_LINE
    return Test::PROVENANCE_RESULT_INVALID_THIRD_WRITE if third_write.allocation.allocation.value != Test::PROVENANCE_FIRST_ALLOCATION_ID or third_write.allocation.offset != Test::PROVENANCE_SLOT_ZERO

    last_slot_zero: DebuggerProvenance::Mutation = DebuggerEDIRProvenance::edir_provenance_last_memory_write(engine, Test::PROVENANCE_SLOT_ZERO, Test::PROVENANCE_BEFORE_LAST_SLOT_ZERO_WRITE)
    return Test::PROVENANCE_RESULT_INVALID_LOOKUP if last_slot_zero.event != Test::PROVENANCE_THIRD_STORE_EVENT or last_slot_zero.value_hash != Test::PROVENANCE_THIRD_VALUE.u64()
    first_slot_zero: DebuggerProvenance::Mutation = DebuggerProvenance::provenance_last_write_at_or_before(writes, first_write.binding, Test::PROVENANCE_BEFORE_FIRST_WRITE)
    return Test::PROVENANCE_RESULT_INVALID_LOOKUP if first_slot_zero.event != Test::PROVENANCE_FIRST_STORE_EVENT
    query_window: DebuggerHistory::QueryWindow = DebuggerHistory::QueryWindow{first_event: Test::PROVENANCE_QUERY_FIRST_EVENT, last_event: Test::PROVENANCE_QUERY_LAST_EVENT, max_results: Test::PROVENANCE_QUERY_MAX_RESULTS, max_steps: Test::PROVENANCE_QUERY_MAX_STEPS}
    query_token: DebuggerCancellation::CancellationToken = DebuggerCancellation::cancellation_token_new(Test::PROVENANCE_CANCELLATION_GENERATION)
    query: DebuggerQueryEngine::QueryExecution = DebuggerQueryEngine::query_find_writes(writes, first_write.binding, query_window, query_token)
    return Test::PROVENANCE_RESULT_INVALID_QUERY if not query.complete or query.count != Test::PROVENANCE_EXPECTED_QUERY_MATCH_COUNT or query.matches[Test::PROVENANCE_FIRST_QUERY_MATCH_INDEX].event != Test::PROVENANCE_FIRST_STORE_EVENT or query.matches[Test::PROVENANCE_SECOND_QUERY_MATCH_INDEX].event != Test::PROVENANCE_THIRD_STORE_EVENT
    return Test::PROVENANCE_RESULT_INVALID_QUERY if query.matches[Test::PROVENANCE_FIRST_QUERY_MATCH_INDEX].mutation.value_hash != Test::PROVENANCE_FIRST_VALUE.u64() or query.matches[Test::PROVENANCE_SECOND_QUERY_MATCH_INDEX].mutation.value_hash != Test::PROVENANCE_THIRD_VALUE.u64()

    DebuggerReplayEngine::replay_engine_reverse_one(engine)
    return Test::PROVENANCE_RESULT_INVALID_REVERSE if engine.event_count != Test::PROVENANCE_AFTER_FIRST_REVERSE
    DebuggerReplayEngine::replay_engine_reverse_one(engine)
    rewound: mutable DebuggerProvenance::ProvenanceIndex = zeroed
    DebuggerEDIRProvenance::edir_provenance_from_engine(engine, rewound)
    return Test::PROVENANCE_RESULT_INVALID_REVERSE if engine.event_count != Test::PROVENANCE_AFTER_SECOND_REVERSE or not DebuggerProvenance::provenance_is_complete(rewound) or DebuggerProvenance::provenance_count(rewound) != Test::PROVENANCE_EXPECTED_REWOUND_WRITE_COUNT
    last_before_rewound_store: DebuggerProvenance::Mutation = DebuggerEDIRProvenance::edir_provenance_last_memory_write(engine, Test::PROVENANCE_SLOT_ZERO, Test::PROVENANCE_BEFORE_LAST_WRITE)
    return Test::PROVENANCE_RESULT_INVALID_REVERSE if last_before_rewound_store.event != Test::PROVENANCE_FIRST_STORE_EVENT

    DebuggerReplayEngine::replay_engine_step(engine)
    replayed: mutable DebuggerProvenance::ProvenanceIndex = zeroed
    DebuggerEDIRProvenance::edir_provenance_from_engine(engine, replayed)
    return Test::PROVENANCE_RESULT_INVALID_REPLAY if engine.event_count != Test::PROVENANCE_AFTER_REPLAYED_WRITE or not DebuggerProvenance::provenance_is_complete(replayed) or DebuggerProvenance::provenance_count(replayed) != Test::PROVENANCE_EXPECTED_WRITE_COUNT
    replayed_last_write: DebuggerProvenance::Mutation = DebuggerEDIRProvenance::edir_provenance_last_memory_write(engine, Test::PROVENANCE_SLOT_ZERO, Test::PROVENANCE_BEFORE_LAST_SLOT_ZERO_WRITE)
    return Test::PROVENANCE_RESULT_INVALID_REPLAY if replayed_last_write.event != Test::PROVENANCE_THIRD_STORE_EVENT or replayed_last_write.value_hash != Test::PROVENANCE_THIRD_VALUE.u64()

    DebuggerReplayEngine::replay_engine_seek(engine, Test::PROVENANCE_SECOND_STORE_EVENT.usize() + Test::PROVENANCE_EVENT_COUNT_OFFSET)
    sought: mutable DebuggerProvenance::ProvenanceIndex = zeroed
    DebuggerEDIRProvenance::edir_provenance_from_engine(engine, sought)
    return Test::PROVENANCE_RESULT_INVALID_SEEK if engine.event_count != Test::PROVENANCE_SECOND_STORE_EVENT.usize() + Test::PROVENANCE_EVENT_COUNT_OFFSET or not DebuggerProvenance::provenance_is_complete(sought) or DebuggerProvenance::provenance_count(sought) != Test::PROVENANCE_EXPECTED_REWOUND_WRITE_COUNT
    DebuggerReplayEngine::replay_engine_seek(engine, Test::PROVENANCE_INSTRUCTION_COUNT.usize())
    returned: mutable DebuggerProvenance::ProvenanceIndex = zeroed
    DebuggerEDIRProvenance::edir_provenance_from_engine(engine, returned)
    return Test::PROVENANCE_RESULT_INVALID_REPLAYED_LOOKUP if not DebuggerProvenance::provenance_is_complete(returned) or DebuggerProvenance::provenance_count(returned) != Test::PROVENANCE_EXPECTED_WRITE_COUNT

    corrupted: mutable DebuggerReplayEngine::ReplayEngine = engine
    corrupted.events[Test::PROVENANCE_FIRST_STORE_EVENT.usize()].payload_hash <- corrupted.events[Test::PROVENANCE_FIRST_STORE_EVENT.usize()].payload_hash + Test::PROVENANCE_CORRUPT_HASH_OFFSET
    corrupted_writes: mutable DebuggerProvenance::ProvenanceIndex = zeroed
    DebuggerEDIRProvenance::edir_provenance_from_engine(corrupted, corrupted_writes)
    return Test::PROVENANCE_RESULT_ACCEPTED_CORRUPT_EVENT if DebuggerProvenance::provenance_is_complete(corrupted_writes)

    failed_store: mutable DebuggerReplayEngine::ReplayEngine
    DebuggerReplayEngine::replay_engine_initialize(failed_store, provenance_failed_store_image(), DebuggerIdentity::debug_id(Test::PROVENANCE_RECORDING_ID + Test::PROVENANCE_RECORDING_ID_OFFSET))
    DebuggerReplayEngine::replay_engine_step(failed_store)
    failed_store_writes: mutable DebuggerProvenance::ProvenanceIndex = zeroed
    DebuggerEDIRProvenance::edir_provenance_from_engine(failed_store, failed_store_writes)
    return Test::PROVENANCE_RESULT_RECORDED_FAILED_STORE if not DebuggerProvenance::provenance_is_complete(failed_store_writes) or DebuggerProvenance::provenance_count(failed_store_writes) != Test::PROVENANCE_EXPECTED_EMPTY_WRITE_COUNT
    return Test::PROVENANCE_TEST_SUCCESS
