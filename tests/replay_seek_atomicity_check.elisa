include "../src/replay/engine.elisa"
include "../src/core/identity.elisa"
include "../src/vm/edir.elisa"

const module Test:
    SUCCESS: i64 = 0
    FAILED_ERROR_RESULT: i64 = 1
    FAILED_MACHINE_ROLLBACK_RESULT: i64 = 2
    FAILED_HISTORY_ROLLBACK_RESULT: i64 = 3
    FAILED_EVENT_ROLLBACK_RESULT: i64 = 4
    PROGRAM_VERSION: u32 = 1
    PROGRAM_INSTRUCTION_COUNT: u64 = 2
    NO_LOCALS: u64 = 0
    ZERO_VALUE: i64 = 0
    FIRST_EVENT: usize = 0
    TARGET_EVENT: usize = 1
    RECORDING_ID: u64 = 1


def main() -> i64:
    image: mutable DebuggerEDIR::ProgramImage = zeroed
    image.program <- DebuggerEDIR::Program{version: Test::PROGRAM_VERSION, instruction_count: Test::PROGRAM_INSTRUCTION_COUNT, local_count: Test::NO_LOCALS, has_return: true}
    image.instructions[Test::FIRST_EVENT] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Divide, a: Test::ZERO_VALUE, b: Test::ZERO_VALUE, source: zeroed}
    image.instructions[Test::TARGET_EVENT] <- DebuggerEDIR::Instruction{opcode: DebuggerEDIR::Opcode.Return, a: Test::ZERO_VALUE, b: Test::ZERO_VALUE, source: zeroed}
    engine: mutable DebuggerReplayEngine::ReplayEngine = DebuggerReplayEngine::replay_engine_new(image, DebuggerIdentity::debug_id(Test::RECORDING_ID))
    original_state_hash: u64 = DebuggerReplayEngine::replay_engine_state_hash(engine)
    original_snapshot: DebuggerCheckpoint::MachineSnapshot = engine.history[Test::FIRST_EVENT]
    original_event: DebuggerEvents::EventEnvelope = engine.events[Test::FIRST_EVENT]

    DebuggerReplayEngine::replay_engine_seek(engine, Test::TARGET_EVENT)

    return Test::FAILED_ERROR_RESULT if engine.engine_error != DebuggerReplayEngine::EngineError.ExecutionFault
    return Test::FAILED_MACHINE_ROLLBACK_RESULT if engine.event_count != Test::FIRST_EVENT or DebuggerReplayEngine::replay_engine_state_hash(engine) != original_state_hash or engine.machine.faulted or engine.machine.halted
    return Test::FAILED_HISTORY_ROLLBACK_RESULT if engine.history[Test::FIRST_EVENT].id.value != original_snapshot.id.value or engine.history[Test::FIRST_EVENT].event != original_snapshot.event or engine.history[Test::FIRST_EVENT].state_hash != original_snapshot.state_hash
    return Test::FAILED_EVENT_ROLLBACK_RESULT if engine.events[Test::FIRST_EVENT].schema != original_event.schema or engine.events[Test::FIRST_EVENT].ordinal != original_event.ordinal or engine.events[Test::FIRST_EVENT].payload_hash != original_event.payload_hash
    return Test::SUCCESS
