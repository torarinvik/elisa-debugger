include "../src/protocol/request.elisa"

const TEST_U64_MAX: u64 = 18446744073709551615
const TEST_FAILURE_VALID_LAUNCH: i64 = 1
const TEST_FAILURE_ESCAPED_PATH: i64 = 2
const TEST_FAILURE_UNICODE_PATH: i64 = 3
const TEST_FAILURE_SURROGATE_PATH: i64 = 4
const TEST_FAILURE_SURROGATE_VALID: i64 = 41
const TEST_FAILURE_SURROGATE_LENGTH: i64 = 42
const TEST_FAILURE_PATH_BOUNDARY: i64 = 43
const TEST_FAILURE_INVALID_UTF8: i64 = 44
const TEST_FAILURE_MISSING_ARGUMENTS: i64 = 5
const TEST_FAILURE_MISSING_PROGRAM: i64 = 6
const TEST_FAILURE_DUPLICATE_ARGUMENTS: i64 = 7
const TEST_FAILURE_DUPLICATE_PROGRAM: i64 = 8
const TEST_FAILURE_INVALID_PATH: i64 = 9
const TEST_FAILURE_INVALID_PAGE_SIZE: i64 = 10
const TEST_FAILURE_DUPLICATE_PAGE_SIZE: i64 = 11
const TEST_FAILURE_PAGE_START: i64 = 12
const TEST_FAILURE_DUPLICATE_PAGE_START: i64 = 13
const TEST_FAILURE_NON_LAUNCH_OPERANDS: i64 = 14
const TEST_FAILURE_ESCAPED_KEYS: i64 = 15
const TEST_FAILURE_STRING_VARIABLES_REFERENCE: i64 = 16
const TEST_FAILURE_INITIALIZE_VERSION: i64 = 17
const TEST_EXPECTED_PAGE_SIZE: u64 = 64
const TEST_EXPECTED_PAGE_START: u64 = 3
const TEST_EXPECTED_VARIABLES_REFERENCE: u64 = 7
const TEST_EXPECTED_STRING_PAGE_START: u64 = 13
const TEST_EXPECTED_ESCAPED_KEY_PAGE_SIZE: u64 = 8
const TEST_EXPECTED_ESCAPED_KEY_PAGE_START: u64 = 4
const TEST_MAX_PAGE_SIZE: u64 = 256
const TEST_PATH_CAPACITY: usize = 1024
const TEST_LAUNCH_BUFFER_CAPACITY: usize = TEST_PATH_CAPACITY + 128
const TEST_PATH_FILL_BYTE: u8 = 97
const TEST_PATH_INVALID_UTF8_BYTE: u8 = 192
const TEST_PATH_ESCAPED_BACKSLASH_OFFSET: usize = 6
const TEST_PATH_UNICODE_FIRST_BYTE_OFFSET: usize = 12
const TEST_PATH_UNICODE_SECOND_BYTE_OFFSET: usize = 13
const TEST_PATH_SURROGATE_FIRST_BYTE_OFFSET: usize = 10
const TEST_PATH_UNICODE_LENGTH: usize = 20
const TEST_PATH_SURROGATE_LENGTH: usize = 20
const TEST_PATH_UNICODE_BYTE_ONE: u8 = 195
const TEST_PATH_UNICODE_BYTE_TWO: u8 = 169
const TEST_PATH_SURROGATE_BYTE_ONE: u8 = 240
const TEST_PATH_SURROGATE_BYTE_TWO: u8 = 159
const TEST_PATH_SURROGATE_BYTE_THREE: u8 = 152
const TEST_PATH_SURROGATE_BYTE_FOUR: u8 = 128
const TEST_PROTOCOL_MAJOR: u64 = 1
const TEST_PROTOCOL_MINOR: u64 = 0

const VALID_LAUNCH_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/demo.elisa\"},\"pageSize\":64,\"pageStart\":3}"
const ESCAPED_PATH_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/a\\\\b/caf\\u00e9.elisa\"}}"
const SURROGATE_PATH_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/face-\\ud83d\\ude00.elisa\"}}"
const MISSING_ARGUMENTS_JSON: cstr = "{\"method\":\"launch\",\"id\":1}"
const MISSING_PROGRAM_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{}}"
const NESTED_DECOY_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"other\":{\"arguments\":{\"program\":\"/tmp/decoy.elisa\"}}}"
const DUPLICATE_ARGUMENTS_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/a.elisa\"},\"arguments\":{\"program\":\"/tmp/b.elisa\"}}"
const DUPLICATE_PROGRAM_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/a.elisa\",\"program\":\"/tmp/b.elisa\"}}"
const EMPTY_PATH_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"\"}}"
const WRONG_PATH_TYPE_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":7}}"
const INVALID_ESCAPE_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/bad\\q.elisa\"}}"
const INVALID_UNICODE_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/bad\\u12G4.elisa\"}}"
const INVALID_SURROGATE_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/bad-\\ud800.elisa\"}}"
const INVALID_CONTROL_ESCAPE_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/bad\\n.elisa\"}}"
const VALID_PAGE_START_MAX_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"arguments\":{\"variablesReference\":7},\"pageSize\":256,\"pageStart\":18446744073709551615}"
const VALID_PAGE_START_MAX_STRING_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"arguments\":{\"variablesReference\":7},\"pageStart\":\"18446744073709551615\"}"
const VALID_PAGE_START_STRING_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"arguments\":{\"variablesReference\":7},\"pageStart\":\"13\"}"
const INVALID_PAGE_SIZE_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"pageSize\":257}"
const DUPLICATE_PAGE_SIZE_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"pageSize\":5,\"pageSize\":6}"
const INVALID_PAGE_START_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"pageStart\":18446744073709551616}"
const INVALID_PAGE_START_STRING_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"pageStart\":\"13x\"}"
const INVALID_PAGE_START_ZERO_PADDED_STRING_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"pageStart\":\"013\"}"
const DUPLICATE_PAGE_START_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"pageStart\":1,\"pageStart\":2}"
const NON_LAUNCH_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"arguments\":{\"variablesReference\":7}}"
const MISSING_VARIABLES_REFERENCE_JSON: cstr = "{\"method\":\"variables\",\"id\":2}"
const STRING_VARIABLES_REFERENCE_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"arguments\":{\"variablesReference\":\"7\"}}"
const ESCAPED_VARIABLES_REFERENCE_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"arguments\":{\"variables\\u0052eference\":7}}"
const DUPLICATE_VARIABLES_REFERENCE_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"arguments\":{\"variablesReference\":7,\"variables\\u0052eference\":8}}"
const ESCAPED_KEYS_LAUNCH_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arg\\u0075ments\":{\"pr\\u006fgram\":\"/tmp/key.elisa\"},\"page\\u0053ize\":8,\"page\\u0053tart\":4}"
const DUPLICATE_ESCAPED_ARGUMENTS_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/a.elisa\"},\"arg\\u0075ments\":{\"program\":\"/tmp/b.elisa\"}}"
const DUPLICATE_ESCAPED_PROGRAM_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/a.elisa\",\"pr\\u006fgram\":\"/tmp/b.elisa\"}}"
const DUPLICATE_ESCAPED_PAGE_SIZE_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"pageSize\":5,\"page\\u0053ize\":6}"
const DUPLICATE_ESCAPED_PAGE_START_JSON: cstr = "{\"method\":\"variables\",\"id\":2,\"pageStart\":1,\"page\\u0053tart\":2}"
const VALID_INITIALIZE_VERSION_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"protocolMajor\":1,\"protocolMinor\":0}"
const VALID_INITIALIZE_ESCAPED_KEYS_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"protocolMaj\\u006fr\":1,\"protocolMino\\u0072\":0}"
const MISSING_INITIALIZE_MINOR_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"protocolMajor\":1}"
const STRING_INITIALIZE_VERSION_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"protocolMajor\":\"1\",\"protocolMinor\":0}"
const OVERFLOW_INITIALIZE_VERSION_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"protocolMajor\":4294967296,\"protocolMinor\":0}"
const DUPLICATE_INITIALIZE_MAJOR_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"protocolMajor\":1,\"protocolMaj\\u006fr\":1,\"protocolMinor\":0}"
const NESTED_INITIALIZE_VERSION_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"arguments\":{\"protocolMajor\":1,\"protocolMinor\":0}}"
const TEST_PATH_REQUEST_PREFIX: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\""
const TEST_PATH_REQUEST_SUFFIX: cstr = "\"}}"

def test_cstr_length(value: cstr) -> usize:
    length: mutable usize = 0
    while value[length] != 0:
        length <- length + 1
    return length

def parse_operands(payload: cstr) -> DebuggerProtocolRequest::RequestOperands:
    return DebuggerProtocolRequest::request_operands_parse(payload.cast[u8&], test_cstr_length(payload))

def path_is_ascii(path: DebuggerProtocolRequest::ProgramPath, expected: cstr) -> bool:
    expected_length: usize = test_cstr_length(expected)
    return false if not path.valid or path.length != expected_length
    for index in 0..<expected_length:
        return false if path.bytes[index] != expected[index].u8()
    return true

def build_path_request(payload: mutable u8&, path_length: usize, path_byte: u8) -> usize:
    prefix_length: usize = test_cstr_length(TEST_PATH_REQUEST_PREFIX)
    cursor: mutable usize = 0
    for index in 0..<prefix_length:
        payload[cursor] <- TEST_PATH_REQUEST_PREFIX[index].u8()
        cursor <- cursor + 1
    for index in 0..<path_length:
        payload[cursor] <- path_byte
        cursor <- cursor + 1
    suffix_length: usize = test_cstr_length(TEST_PATH_REQUEST_SUFFIX)
    for index in 0..<suffix_length:
        payload[cursor] <- TEST_PATH_REQUEST_SUFFIX[index].u8()
        cursor <- cursor + 1
    return cursor

def main() -> i64:
    valid_launch: DebuggerProtocolRequest::RequestOperands = parse_operands(VALID_LAUNCH_JSON)
    return TEST_FAILURE_VALID_LAUNCH if not valid_launch.valid or not valid_launch.has_program or not path_is_ascii(valid_launch.program, "/tmp/demo.elisa") or not valid_launch.has_page_size or valid_launch.page_size != TEST_EXPECTED_PAGE_SIZE or not valid_launch.has_page_start or valid_launch.page_start != TEST_EXPECTED_PAGE_START

    escaped_path: DebuggerProtocolRequest::RequestOperands = parse_operands(ESCAPED_PATH_JSON)
    return TEST_FAILURE_ESCAPED_PATH if not escaped_path.valid or escaped_path.program.length != TEST_PATH_UNICODE_LENGTH
    return TEST_FAILURE_ESCAPED_PATH if escaped_path.program.bytes[TEST_PATH_ESCAPED_BACKSLASH_OFFSET] != 92 or escaped_path.program.bytes[TEST_PATH_UNICODE_FIRST_BYTE_OFFSET] != TEST_PATH_UNICODE_BYTE_ONE or escaped_path.program.bytes[TEST_PATH_UNICODE_SECOND_BYTE_OFFSET] != TEST_PATH_UNICODE_BYTE_TWO

    surrogate_path: DebuggerProtocolRequest::RequestOperands = parse_operands(SURROGATE_PATH_JSON)
    return TEST_FAILURE_SURROGATE_VALID if not surrogate_path.valid
    return TEST_FAILURE_SURROGATE_LENGTH if surrogate_path.program.length != TEST_PATH_SURROGATE_LENGTH
    return TEST_FAILURE_SURROGATE_PATH if surrogate_path.program.bytes[TEST_PATH_SURROGATE_FIRST_BYTE_OFFSET] != TEST_PATH_SURROGATE_BYTE_ONE or surrogate_path.program.bytes[TEST_PATH_SURROGATE_FIRST_BYTE_OFFSET + 1] != TEST_PATH_SURROGATE_BYTE_TWO or surrogate_path.program.bytes[TEST_PATH_SURROGATE_FIRST_BYTE_OFFSET + 2] != TEST_PATH_SURROGATE_BYTE_THREE or surrogate_path.program.bytes[TEST_PATH_SURROGATE_FIRST_BYTE_OFFSET + 3] != TEST_PATH_SURROGATE_BYTE_FOUR

    escaped_keys: DebuggerProtocolRequest::RequestOperands = parse_operands(ESCAPED_KEYS_LAUNCH_JSON)
    return TEST_FAILURE_ESCAPED_KEYS if not escaped_keys.valid or not escaped_keys.has_program or not path_is_ascii(escaped_keys.program, "/tmp/key.elisa") or not escaped_keys.has_page_size or escaped_keys.page_size != TEST_EXPECTED_ESCAPED_KEY_PAGE_SIZE or not escaped_keys.has_page_start or escaped_keys.page_start != TEST_EXPECTED_ESCAPED_KEY_PAGE_START

    return TEST_FAILURE_MISSING_ARGUMENTS if parse_operands(MISSING_ARGUMENTS_JSON).valid
    return TEST_FAILURE_MISSING_PROGRAM if parse_operands(MISSING_PROGRAM_JSON).valid
    return TEST_FAILURE_MISSING_PROGRAM if parse_operands(NESTED_DECOY_JSON).valid
    return TEST_FAILURE_DUPLICATE_ARGUMENTS if parse_operands(DUPLICATE_ARGUMENTS_JSON).valid
    return TEST_FAILURE_DUPLICATE_ARGUMENTS if parse_operands(DUPLICATE_ESCAPED_ARGUMENTS_JSON).valid
    return TEST_FAILURE_DUPLICATE_PROGRAM if parse_operands(DUPLICATE_PROGRAM_JSON).valid
    return TEST_FAILURE_DUPLICATE_PROGRAM if parse_operands(DUPLICATE_ESCAPED_PROGRAM_JSON).valid
    return TEST_FAILURE_INVALID_PATH if parse_operands(EMPTY_PATH_JSON).valid or parse_operands(WRONG_PATH_TYPE_JSON).valid
    return TEST_FAILURE_INVALID_PATH if parse_operands(INVALID_ESCAPE_JSON).valid or parse_operands(INVALID_UNICODE_JSON).valid or parse_operands(INVALID_SURROGATE_JSON).valid or parse_operands(INVALID_CONTROL_ESCAPE_JSON).valid

    max_page_start: DebuggerProtocolRequest::RequestOperands = parse_operands(VALID_PAGE_START_MAX_JSON)
    return TEST_FAILURE_PAGE_START if not max_page_start.valid or max_page_start.has_program or not max_page_start.has_variables_reference or max_page_start.variables_reference != TEST_EXPECTED_VARIABLES_REFERENCE or not max_page_start.has_page_size or max_page_start.page_size != TEST_MAX_PAGE_SIZE or not max_page_start.has_page_start or max_page_start.page_start != TEST_U64_MAX
    string_page_start: DebuggerProtocolRequest::RequestOperands = parse_operands(VALID_PAGE_START_STRING_JSON)
    return TEST_FAILURE_PAGE_START if not string_page_start.valid or not string_page_start.has_page_start or string_page_start.page_start != TEST_EXPECTED_STRING_PAGE_START or not string_page_start.has_variables_reference or string_page_start.variables_reference != TEST_EXPECTED_VARIABLES_REFERENCE
    max_string_page_start: DebuggerProtocolRequest::RequestOperands = parse_operands(VALID_PAGE_START_MAX_STRING_JSON)
    return TEST_FAILURE_PAGE_START if not max_string_page_start.valid or not max_string_page_start.has_page_start or max_string_page_start.page_start != TEST_U64_MAX
    return TEST_FAILURE_INVALID_PAGE_SIZE if parse_operands(INVALID_PAGE_SIZE_JSON).valid
    return TEST_FAILURE_DUPLICATE_PAGE_SIZE if parse_operands(DUPLICATE_PAGE_SIZE_JSON).valid
    return TEST_FAILURE_DUPLICATE_PAGE_SIZE if parse_operands(DUPLICATE_ESCAPED_PAGE_SIZE_JSON).valid
    return TEST_FAILURE_PAGE_START if parse_operands(INVALID_PAGE_START_JSON).valid
    return TEST_FAILURE_PAGE_START if parse_operands(INVALID_PAGE_START_STRING_JSON).valid
    return TEST_FAILURE_PAGE_START if parse_operands(INVALID_PAGE_START_ZERO_PADDED_STRING_JSON).valid
    return TEST_FAILURE_DUPLICATE_PAGE_START if parse_operands(DUPLICATE_PAGE_START_JSON).valid
    return TEST_FAILURE_DUPLICATE_PAGE_START if parse_operands(DUPLICATE_ESCAPED_PAGE_START_JSON).valid

    no_pagination: DebuggerProtocolRequest::RequestOperands = parse_operands(NON_LAUNCH_JSON)
    return TEST_FAILURE_NON_LAUNCH_OPERANDS if not no_pagination.valid or no_pagination.has_program or not no_pagination.has_variables_reference or no_pagination.variables_reference != TEST_EXPECTED_VARIABLES_REFERENCE or no_pagination.has_page_size or no_pagination.page_size != 0 or no_pagination.has_page_start or no_pagination.page_start != 0
    return TEST_FAILURE_NON_LAUNCH_OPERANDS if parse_operands(MISSING_VARIABLES_REFERENCE_JSON).valid
    string_variables_reference: DebuggerProtocolRequest::RequestOperands = parse_operands(STRING_VARIABLES_REFERENCE_JSON)
    return TEST_FAILURE_STRING_VARIABLES_REFERENCE if not string_variables_reference.valid or not string_variables_reference.has_variables_reference or string_variables_reference.variables_reference != TEST_EXPECTED_VARIABLES_REFERENCE
    escaped_variables_reference: DebuggerProtocolRequest::RequestOperands = parse_operands(ESCAPED_VARIABLES_REFERENCE_JSON)
    return TEST_FAILURE_NON_LAUNCH_OPERANDS if not escaped_variables_reference.valid or not escaped_variables_reference.has_variables_reference or escaped_variables_reference.variables_reference != TEST_EXPECTED_VARIABLES_REFERENCE
    return TEST_FAILURE_NON_LAUNCH_OPERANDS if parse_operands(DUPLICATE_VARIABLES_REFERENCE_JSON).valid

    initialize_version: DebuggerProtocolRequest::RequestOperands = parse_operands(VALID_INITIALIZE_VERSION_JSON)
    return TEST_FAILURE_INITIALIZE_VERSION if not initialize_version.valid or not initialize_version.has_protocol_major or initialize_version.protocol_major != TEST_PROTOCOL_MAJOR or not initialize_version.has_protocol_minor or initialize_version.protocol_minor != TEST_PROTOCOL_MINOR
    escaped_initialize_version: DebuggerProtocolRequest::RequestOperands = parse_operands(VALID_INITIALIZE_ESCAPED_KEYS_JSON)
    return TEST_FAILURE_INITIALIZE_VERSION if not escaped_initialize_version.valid or not escaped_initialize_version.has_protocol_major or escaped_initialize_version.protocol_major != TEST_PROTOCOL_MAJOR or not escaped_initialize_version.has_protocol_minor or escaped_initialize_version.protocol_minor != TEST_PROTOCOL_MINOR
    return TEST_FAILURE_INITIALIZE_VERSION if parse_operands(MISSING_INITIALIZE_MINOR_JSON).valid or parse_operands(STRING_INITIALIZE_VERSION_JSON).valid or parse_operands(OVERFLOW_INITIALIZE_VERSION_JSON).valid or parse_operands(DUPLICATE_INITIALIZE_MAJOR_JSON).valid or parse_operands(NESTED_INITIALIZE_VERSION_JSON).valid

    exact_path_json: mutable u8[TEST_LAUNCH_BUFFER_CAPACITY] = zeroed
    exact_path_json_length: usize = build_path_request(exact_path_json[0], TEST_PATH_CAPACITY, TEST_PATH_FILL_BYTE)
    exact_path: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(exact_path_json[0], exact_path_json_length)
    return TEST_FAILURE_PATH_BOUNDARY if not exact_path.valid or not exact_path.has_program or exact_path.program.length != TEST_PATH_CAPACITY

    over_capacity_json: mutable u8[TEST_LAUNCH_BUFFER_CAPACITY] = zeroed
    over_capacity_json_length: usize = build_path_request(over_capacity_json[0], TEST_PATH_CAPACITY + 1, TEST_PATH_FILL_BYTE)
    over_capacity_path: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(over_capacity_json[0], over_capacity_json_length)
    return TEST_FAILURE_PATH_BOUNDARY if over_capacity_path.valid

    invalid_utf8_json: mutable u8[TEST_LAUNCH_BUFFER_CAPACITY] = zeroed
    invalid_utf8_json_length: usize = build_path_request(invalid_utf8_json[0], 1, TEST_PATH_INVALID_UTF8_BYTE)
    invalid_utf8_path: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(invalid_utf8_json[0], invalid_utf8_json_length)
    return TEST_FAILURE_INVALID_UTF8 if invalid_utf8_path.valid
    return 0
