    DUPLICATE_ESCAPED_PROGRAM_JSON: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\"/tmp/a.elisa\",\"pr\\u006fgram\":\"/tmp/b.elisa\"}}"
