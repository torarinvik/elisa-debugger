    OVERFLOW_INITIALIZE_VERSION_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"protocolMajor\":4294967296,\"protocolMinor\":0}"
    DUPLICATE_INITIALIZE_MAJOR_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"protocolMajor\":1,\"protocolMaj\\u006fr\":1,\"protocolMinor\":0}"
    NESTED_INITIALIZE_VERSION_JSON: cstr = "{\"method\":\"initialize\",\"id\":3,\"arguments\":{\"protocolMajor\":1,\"protocolMinor\":0}}"
    PATH_REQUEST_PREFIX: cstr = "{\"method\":\"launch\",\"id\":1,\"arguments\":{\"program\":\""
    PATH_REQUEST_SUFFIX: cstr = "\"}}"

const module EvaluationCases:
    EVALUATE_JSON: cstr = "{\"method\":\"evaluate\",\"id\":9,\"expectedStopGeneration\":\"4\",\"arguments\":{\"expression\":\"local0 + global0\",\"frameIndex\":2}}"
    ESCAPED_EVALUATE_JSON: cstr = "{\"method\":\"evaluate\",\"id\":10,\"arguments\":{\"expression\":\"local0\\n+\\u0031\"}}"
    MISSING_EVALUATE_EXPRESSION_JSON: cstr = "{\"method\":\"evaluate\",\"id\":11,\"arguments\":{}}"
    DUPLICATE_EVALUATE_EXPRESSION_JSON: cstr = "{\"method\":\"evaluate\",\"id\":12,\"arguments\":{\"expression\":\"1\",\"expression\":\"2\"}}"
    ESCAPED_DUPLICATE_EVALUATE_EXPRESSION_JSON: cstr = "{\"method\":\"evaluate\",\"id\":13,\"arguments\":{\"expression\":\"1\",\"express\\u0069on\":\"2\"}}"
    INVALID_EVALUATE_TYPE_JSON: cstr = "{\"method\":\"evaluate\",\"id\":14,\"arguments\":{\"expression\":7}}"
    INVALID_EVALUATE_FRAME_JSON: cstr = "{\"method\":\"evaluate\",\"id\":15,\"arguments\":{\"expression\":\"1\",\"frameIndex\":\"1\"}}"
    DUPLICATE_EVALUATE_FRAME_JSON: cstr = "{\"method\":\"evaluate\",\"id\":16,\"arguments\":{\"expression\":\"1\",\"frameIndex\":0,\"frameIndex\":1}}"
    OVERFLOW_EVALUATE_FRAME_JSON: cstr = "{\"method\":\"evaluate\",\"id\":17,\"arguments\":{\"expression\":\"1\",\"frameIndex\":4294967296}}"
    EMPTY_EVALUATE_JSON: cstr = "{\"method\":\"evaluate\",\"id\":18,\"arguments\":{\"expression\":\"\"}}"
    EXPECTED_EXPRESSION_LENGTH: usize = 16
    EXPECTED_ESCAPED_EXPRESSION_LENGTH: usize = 9
    EXPECTED_FRAME_INDEX: u64 = 2
    EXPRESSION_NEWLINE_OFFSET: usize = 6
    EXPRESSION_LITERAL_OFFSET: usize = 8

    const module ExpectedBytes:
        ASCII_LINE_FEED: u8 = 10
        ASCII_ONE: u8 = 49

    const module Failure:
        VALID_OPERANDS: i64 = 46
        ESCAPED_OPERAND: i64 = 47
        REQUIRED_AND_UNIQUE: i64 = 48
        INVALID_SHAPES: i64 = 49
        SOURCE_BOUNDARY: i64 = 50

const module EvaluationBounds:
    MAX_EXPRESSION_BYTES: usize = DebuggerExpressionLimits::Source::MAX_EXPRESSION_BYTES
    REQUEST_OVERHEAD_CAPACITY: usize = 64
    ASCII_ONE: u8 = 49
    INDEX_INCREMENT: usize = 1
    REQUEST_PREFIX: cstr = "{\"method\":\"evaluate\",\"id\":20,\"arguments\":{\"expression\":\""
    REQUEST_SUFFIX: cstr = "\"}}"



def test_cstr_length(value: cstr) -> usize:
    length: mutable usize = 0
    while value[length] != 0:
        length <- length + 1
    return length

def parse_operands(payload: cstr) -> DebuggerProtocolRequest::RequestOperands:
    return DebuggerProtocolRequest::request_operands_parse(payload.cast[u8&], test_cstr_length(payload))

def expression_bytes_match(expression: DebuggerProtocolRequest::ExpressionText, expected: cstr) -> bool:
    expected_length: usize = test_cstr_length(expected)
    return false if not expression.valid or expression.length != expected_length
    for index in 0..<expected_length:
        return false if expression.bytes[index] != expected[index].u8()
    return true

def build_evaluate_request(payload: mutable u8&, expression_length: usize, expression_byte: u8) -> usize:
    prefix_length: usize = test_cstr_length(EvaluationBounds::REQUEST_PREFIX)
    cursor: mutable usize = 0
    for index in 0..<prefix_length:
        payload[cursor] <- EvaluationBounds::REQUEST_PREFIX[index].u8()
        cursor <- cursor + EvaluationBounds::INDEX_INCREMENT
    for index in 0..<expression_length:
        payload[cursor] <- expression_byte
        cursor <- cursor + EvaluationBounds::INDEX_INCREMENT
    suffix_length: usize = test_cstr_length(EvaluationBounds::REQUEST_SUFFIX)
    for index in 0..<suffix_length:
        payload[cursor] <- EvaluationBounds::REQUEST_SUFFIX[index].u8()
        cursor <- cursor + EvaluationBounds::INDEX_INCREMENT
    return cursor

def path_is_ascii(path: DebuggerProtocolRequest::ProgramPath, expected: cstr) -> bool:
    expected_length: usize = test_cstr_length(expected)
    return false if not path.valid or path.length != expected_length
    for index in 0..<expected_length:
        return false if path.bytes[index] != expected[index].u8()
    return true

def build_path_request(payload: mutable u8&, path_length: usize, path_byte: u8) -> usize:
    prefix_length: usize = test_cstr_length(Test::PATH_REQUEST_PREFIX)
    cursor: mutable usize = 0
    for index in 0..<prefix_length:
        payload[cursor] <- Test::PATH_REQUEST_PREFIX[index].u8()
        cursor <- cursor + 1
    for index in 0..<path_length:
        payload[cursor] <- path_byte
        cursor <- cursor + 1
    suffix_length: usize = test_cstr_length(Test::PATH_REQUEST_SUFFIX)
    for index in 0..<suffix_length:
        payload[cursor] <- Test::PATH_REQUEST_SUFFIX[index].u8()
        cursor <- cursor + 1
    return cursor

def main() -> i64:
    valid_launch: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::VALID_LAUNCH_JSON)
    return Test::FAILURE_VALID_LAUNCH if not valid_launch.valid or not valid_launch.has_program or not path_is_ascii(valid_launch.program, "/tmp/demo.elisa") or not valid_launch.has_page_size or valid_launch.page_size != Test::EXPECTED_PAGE_SIZE or not valid_launch.has_page_start or valid_launch.page_start != Test::EXPECTED_PAGE_START

    escaped_path: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::ESCAPED_PATH_JSON)
    return Test::FAILURE_ESCAPED_PATH if not escaped_path.valid or escaped_path.program.length != Test::PATH_UNICODE_LENGTH
    return Test::FAILURE_ESCAPED_PATH if escaped_path.program.bytes[Test::PATH_ESCAPED_BACKSLASH_OFFSET] != 92 or escaped_path.program.bytes[Test::PATH_UNICODE_FIRST_BYTE_OFFSET] != Test::PATH_UNICODE_BYTE_ONE or escaped_path.program.bytes[Test::PATH_UNICODE_SECOND_BYTE_OFFSET] != Test::PATH_UNICODE_BYTE_TWO

    surrogate_path: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::SURROGATE_PATH_JSON)
    return Test::FAILURE_SURROGATE_VALID if not surrogate_path.valid
    return Test::FAILURE_SURROGATE_LENGTH if surrogate_path.program.length != Test::PATH_SURROGATE_LENGTH
    return Test::FAILURE_SURROGATE_PATH if surrogate_path.program.bytes[Test::PATH_SURROGATE_FIRST_BYTE_OFFSET] != Test::PATH_SURROGATE_BYTE_ONE or surrogate_path.program.bytes[Test::PATH_SURROGATE_FIRST_BYTE_OFFSET + 1] != Test::PATH_SURROGATE_BYTE_TWO or surrogate_path.program.bytes[Test::PATH_SURROGATE_FIRST_BYTE_OFFSET + 2] != Test::PATH_SURROGATE_BYTE_THREE or surrogate_path.program.bytes[Test::PATH_SURROGATE_FIRST_BYTE_OFFSET + 3] != Test::PATH_SURROGATE_BYTE_FOUR

    escaped_keys: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::ESCAPED_KEYS_LAUNCH_JSON)
    return Test::FAILURE_ESCAPED_KEYS if not escaped_keys.valid or not escaped_keys.has_program or not path_is_ascii(escaped_keys.program, "/tmp/key.elisa") or not escaped_keys.has_page_size or escaped_keys.page_size != Test::EXPECTED_ESCAPED_KEY_PAGE_SIZE or not escaped_keys.has_page_start or escaped_keys.page_start != Test::EXPECTED_ESCAPED_KEY_PAGE_START

    return Test::FAILURE_MISSING_ARGUMENTS if parse_operands(Test::MISSING_ARGUMENTS_JSON).valid
    return Test::FAILURE_MISSING_PROGRAM if parse_operands(Test::MISSING_PROGRAM_JSON).valid
    return Test::FAILURE_MISSING_PROGRAM if parse_operands(Test::NESTED_DECOY_JSON).valid
    return Test::FAILURE_DUPLICATE_ARGUMENTS if parse_operands(Test::DUPLICATE_ARGUMENTS_JSON).valid
    return Test::FAILURE_DUPLICATE_ARGUMENTS if parse_operands(Test::DUPLICATE_ESCAPED_ARGUMENTS_JSON).valid
    return Test::FAILURE_DUPLICATE_PROGRAM if parse_operands(Test::DUPLICATE_PROGRAM_JSON).valid
    return Test::FAILURE_DUPLICATE_PROGRAM if parse_operands(Test::DUPLICATE_ESCAPED_PROGRAM_JSON).valid
    return Test::FAILURE_INVALID_PATH if parse_operands(Test::EMPTY_PATH_JSON).valid or parse_operands(Test::WRONG_PATH_TYPE_JSON).valid
    return Test::FAILURE_INVALID_PATH if parse_operands(Test::INVALID_ESCAPE_JSON).valid or parse_operands(Test::INVALID_UNICODE_JSON).valid or parse_operands(Test::INVALID_SURROGATE_JSON).valid or parse_operands(Test::INVALID_CONTROL_ESCAPE_JSON).valid

    max_page_start: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::VALID_PAGE_START_MAX_JSON)
    return Test::FAILURE_PAGE_START if not max_page_start.valid or max_page_start.has_program or not max_page_start.has_variables_reference or max_page_start.variables_reference != Test::EXPECTED_VARIABLES_REFERENCE or not max_page_start.has_page_size or max_page_start.page_size != Test::MAX_PAGE_SIZE or not max_page_start.has_page_start or max_page_start.page_start != Test::U64_MAX
    string_page_start: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::VALID_PAGE_START_STRING_JSON)
    return Test::FAILURE_PAGE_START if not string_page_start.valid or not string_page_start.has_page_start or string_page_start.page_start != Test::EXPECTED_STRING_PAGE_START or not string_page_start.has_variables_reference or string_page_start.variables_reference != Test::EXPECTED_VARIABLES_REFERENCE
    max_string_page_start: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::VALID_PAGE_START_MAX_STRING_JSON)
    return Test::FAILURE_PAGE_START if not max_string_page_start.valid or not max_string_page_start.has_page_start or max_string_page_start.page_start != Test::U64_MAX
    return Test::FAILURE_INVALID_PAGE_SIZE if parse_operands(Test::INVALID_PAGE_SIZE_JSON).valid
    return Test::FAILURE_DUPLICATE_PAGE_SIZE if parse_operands(Test::DUPLICATE_PAGE_SIZE_JSON).valid
    return Test::FAILURE_DUPLICATE_PAGE_SIZE if parse_operands(Test::DUPLICATE_ESCAPED_PAGE_SIZE_JSON).valid
    return Test::FAILURE_PAGE_START if parse_operands(Test::INVALID_PAGE_START_JSON).valid
    return Test::FAILURE_PAGE_START if parse_operands(Test::INVALID_PAGE_START_STRING_JSON).valid
    return Test::FAILURE_PAGE_START if parse_operands(Test::INVALID_PAGE_START_ZERO_PADDED_STRING_JSON).valid
    return Test::FAILURE_DUPLICATE_PAGE_START if parse_operands(Test::DUPLICATE_PAGE_START_JSON).valid
    return Test::FAILURE_DUPLICATE_PAGE_START if parse_operands(Test::DUPLICATE_ESCAPED_PAGE_START_JSON).valid

    no_pagination: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::NON_LAUNCH_JSON)
    return Test::FAILURE_NON_LAUNCH_OPERANDS if not no_pagination.valid or no_pagination.has_program or not no_pagination.has_variables_reference or no_pagination.variables_reference != Test::EXPECTED_VARIABLES_REFERENCE or no_pagination.has_page_size or no_pagination.page_size != 0 or no_pagination.has_page_start or no_pagination.page_start != 0
    return Test::FAILURE_NON_LAUNCH_OPERANDS if parse_operands(Test::MISSING_VARIABLES_REFERENCE_JSON).valid
    string_variables_reference: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::STRING_VARIABLES_REFERENCE_JSON)
    return Test::FAILURE_STRING_VARIABLES_REFERENCE if not string_variables_reference.valid or not string_variables_reference.has_variables_reference or string_variables_reference.variables_reference != Test::EXPECTED_VARIABLES_REFERENCE
    escaped_variables_reference: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::ESCAPED_VARIABLES_REFERENCE_JSON)
    return Test::FAILURE_NON_LAUNCH_OPERANDS if not escaped_variables_reference.valid or not escaped_variables_reference.has_variables_reference or escaped_variables_reference.variables_reference != Test::EXPECTED_VARIABLES_REFERENCE
    return Test::FAILURE_NON_LAUNCH_OPERANDS if parse_operands(Test::DUPLICATE_VARIABLES_REFERENCE_JSON).valid

    evaluate: DebuggerProtocolRequest::RequestOperands = parse_operands(EvaluationCases::EVALUATE_JSON)
    return EvaluationCases::Failure::VALID_OPERANDS if not evaluate.valid or not evaluate.has_expression or evaluate.expression.length != EvaluationCases::EXPECTED_EXPRESSION_LENGTH or not evaluate.has_frame_index or evaluate.frame_index != EvaluationCases::EXPECTED_FRAME_INDEX or not evaluate.has_expected_generation
    return EvaluationCases::Failure::VALID_OPERANDS if not expression_bytes_match(evaluate.expression, "local0 + global0")
    escaped_evaluate: DebuggerProtocolRequest::RequestOperands = parse_operands(EvaluationCases::ESCAPED_EVALUATE_JSON)
    return EvaluationCases::Failure::ESCAPED_OPERAND if not escaped_evaluate.valid or escaped_evaluate.expression.length != EvaluationCases::EXPECTED_ESCAPED_EXPRESSION_LENGTH or escaped_evaluate.expression.bytes[EvaluationCases::EXPRESSION_NEWLINE_OFFSET] != EvaluationCases::ExpectedBytes::ASCII_LINE_FEED or escaped_evaluate.expression.bytes[EvaluationCases::EXPRESSION_LITERAL_OFFSET] != EvaluationCases::ExpectedBytes::ASCII_ONE
    return EvaluationCases::Failure::REQUIRED_AND_UNIQUE if parse_operands(EvaluationCases::MISSING_EVALUATE_EXPRESSION_JSON).valid or parse_operands(EvaluationCases::DUPLICATE_EVALUATE_EXPRESSION_JSON).valid or parse_operands(EvaluationCases::ESCAPED_DUPLICATE_EVALUATE_EXPRESSION_JSON).valid
    return EvaluationCases::Failure::INVALID_SHAPES if parse_operands(EvaluationCases::INVALID_EVALUATE_TYPE_JSON).valid or parse_operands(EvaluationCases::INVALID_EVALUATE_FRAME_JSON).valid or parse_operands(EvaluationCases::DUPLICATE_EVALUATE_FRAME_JSON).valid or parse_operands(EvaluationCases::OVERFLOW_EVALUATE_FRAME_JSON).valid or parse_operands(EvaluationCases::EMPTY_EVALUATE_JSON).valid
    bounded_expression_request: mutable u8[EvaluationBounds::MAX_EXPRESSION_BYTES + EvaluationBounds::REQUEST_OVERHEAD_CAPACITY] = zeroed
    bounded_expression_length: usize = build_evaluate_request(bounded_expression_request[0], EvaluationBounds::MAX_EXPRESSION_BYTES, EvaluationBounds::ASCII_ONE)
    bounded_expression: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(bounded_expression_request[0], bounded_expression_length)
    return EvaluationCases::Failure::SOURCE_BOUNDARY if not bounded_expression.valid or bounded_expression.expression.length != EvaluationBounds::MAX_EXPRESSION_BYTES
    oversized_expression_request: mutable u8[EvaluationBounds::MAX_EXPRESSION_BYTES + EvaluationBounds::REQUEST_OVERHEAD_CAPACITY] = zeroed
    oversized_expression_length: usize = build_evaluate_request(oversized_expression_request[0], EvaluationBounds::MAX_EXPRESSION_BYTES + EvaluationBounds::INDEX_INCREMENT, EvaluationBounds::ASCII_ONE)
    oversized_expression: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(oversized_expression_request[0], oversized_expression_length)
    return EvaluationCases::Failure::SOURCE_BOUNDARY if oversized_expression.valid

    initialize_version: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::VALID_INITIALIZE_VERSION_JSON)
    return Test::FAILURE_INITIALIZE_VERSION if not initialize_version.valid or not initialize_version.has_protocol_major or initialize_version.protocol_major != Test::PROTOCOL_MAJOR or not initialize_version.has_protocol_minor or initialize_version.protocol_minor != Test::PROTOCOL_MINOR
    escaped_initialize_version: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::VALID_INITIALIZE_ESCAPED_KEYS_JSON)
    return Test::FAILURE_INITIALIZE_VERSION if not escaped_initialize_version.valid or not escaped_initialize_version.has_protocol_major or escaped_initialize_version.protocol_major != Test::PROTOCOL_MAJOR or not escaped_initialize_version.has_protocol_minor or escaped_initialize_version.protocol_minor != Test::PROTOCOL_MINOR
    return Test::FAILURE_INITIALIZE_VERSION if parse_operands(Test::MISSING_INITIALIZE_MINOR_JSON).valid or parse_operands(Test::STRING_INITIALIZE_VERSION_JSON).valid or parse_operands(Test::OVERFLOW_INITIALIZE_VERSION_JSON).valid or parse_operands(Test::DUPLICATE_INITIALIZE_MAJOR_JSON).valid or parse_operands(Test::NESTED_INITIALIZE_VERSION_JSON).valid

    memory: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::MEMORY_JSON)
    return Test::FAILURE_NON_LAUNCH_OPERANDS if not memory.valid or not memory.has_memory_address or memory.memory_address != Test::MEMORY_ADDRESS or not memory.has_memory_length or memory.memory_length != Test::MEMORY_LENGTH
    numeric_memory: DebuggerProtocolRequest::RequestOperands = parse_operands(Test::MEMORY_NUMERIC_ADDRESS_JSON)
    return Test::FAILURE_NON_LAUNCH_OPERANDS if not numeric_memory.valid or numeric_memory.memory_address != 0 or numeric_memory.memory_length != 0
    return Test::FAILURE_NON_LAUNCH_OPERANDS if parse_operands(Test::MEMORY_MISSING_LENGTH_JSON).valid or parse_operands(Test::MEMORY_OVERSIZED_LENGTH_JSON).valid or parse_operands(Test::MEMORY_DUPLICATE_ADDRESS_JSON).valid

    exact_path_json: mutable u8[Test::LAUNCH_BUFFER_CAPACITY] = zeroed
    exact_path_json_length: usize = build_path_request(exact_path_json[0], Test::PATH_CAPACITY, Test::PATH_FILL_BYTE)
    exact_path: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(exact_path_json[0], exact_path_json_length)
    return Test::FAILURE_PATH_BOUNDARY if not exact_path.valid or not exact_path.has_program or exact_path.program.length != Test::PATH_CAPACITY

    over_capacity_json: mutable u8[Test::LAUNCH_BUFFER_CAPACITY] = zeroed
    over_capacity_json_length: usize = build_path_request(over_capacity_json[0], Test::PATH_CAPACITY + 1, Test::PATH_FILL_BYTE)
    over_capacity_path: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(over_capacity_json[0], over_capacity_json_length)
    return Test::FAILURE_PATH_BOUNDARY if over_capacity_path.valid

    invalid_utf8_json: mutable u8[Test::LAUNCH_BUFFER_CAPACITY] = zeroed
    invalid_utf8_json_length: usize = build_path_request(invalid_utf8_json[0], 1, Test::PATH_INVALID_UTF8_BYTE)
    invalid_utf8_path: DebuggerProtocolRequest::RequestOperands = DebuggerProtocolRequest::request_operands_parse(invalid_utf8_json[0], invalid_utf8_json_length)
    return Test::FAILURE_INVALID_UTF8 if invalid_utf8_path.valid
    return 0
