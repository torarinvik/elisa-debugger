include "../src/protocol/request.elisa"

const DISCOVER_LENGTH: usize = 33
const SEEK_LENGTH: usize = 68
const TRAILING_DATA_LENGTH: usize = 29
const TRAILING_COMMA_LENGTH: usize = 22
const LEADING_COMMA_LENGTH: usize = 23
const EXPECTED_GENERATION: u64 = 3
const TARGET_EVENT: u64 = 7

def main() -> i64:
    discover_payload: mutable u8[DISCOVER_LENGTH] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 32, 58, 32, 34, 100, 105, 115, 99, 111, 118, 101, 114, 34, 44, 32, 34, 105, 100, 34, 32, 58, 32, 55, 125]
    discover: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(discover_payload[0], DISCOVER_LENGTH)
    return 1 if not discover.valid or discover.method != DebuggerProtocolRequest::RequestMethod.Discover or not discover.has_id or discover.id != TARGET_EVENT
    seek_payload: mutable u8[SEEK_LENGTH] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 32, 58, 32, 34, 115, 101, 101, 107, 34, 44, 32, 34, 101, 120, 112, 101, 99, 116, 101, 100, 83, 116, 111, 112, 71, 101, 110, 101, 114, 97, 116, 105, 111, 110, 34, 32, 58, 32, 51, 44, 32, 34, 116, 97, 114, 103, 101, 116, 69, 118, 101, 110, 116, 34, 32, 58, 32, 55, 125]
    seek: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(seek_payload[0], SEEK_LENGTH)
    return 2 if not seek.valid or seek.method != DebuggerProtocolRequest::RequestMethod.Seek or seek.expected_generation != EXPECTED_GENERATION or seek.target_event != TARGET_EVENT
    trailing_data: mutable u8[TRAILING_DATA_LENGTH] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 100, 105, 115, 99, 111, 118, 101, 114, 34, 125, 103, 97, 114, 98, 97, 103, 101, 125]
    malformed: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(trailing_data[0], TRAILING_DATA_LENGTH)
    return 3 if malformed.valid
    trailing_comma: mutable u8[TRAILING_COMMA_LENGTH] = [123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 100, 105, 115, 99, 111, 118, 101, 114, 34, 44, 125]
    trailing_comma_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(trailing_comma[0], TRAILING_COMMA_LENGTH)
    return 4 if trailing_comma_request.valid
    leading_comma: mutable u8[LEADING_COMMA_LENGTH] = [123, 44, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 100, 105, 115, 99, 111, 118, 101, 114, 34, 125]
    leading_comma_request: DebuggerProtocolRequest::Request = DebuggerProtocolRequest::request_parse(leading_comma[0], LEADING_COMMA_LENGTH)
    return 5 if leading_comma_request.valid
    return 0
