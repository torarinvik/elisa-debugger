# A replayed virtual file open must resolve the captured identity, not invent
# a new resource or let fixture seeding replace recorded input.

include "../src/replay/resources.elisa"

const module Test:
    PATH_ID: u64 = 4001
    PATH_OFFSET: u64 = 1
    GENERATION: u64 = 17
    BYTE_COUNT: usize = 3
    ONE_BYTE: usize = 1
    FIRST_BYTE_INDEX: usize = 0
    SECOND_BYTE_INDEX: usize = 1
    LAST_BYTE_INDEX: usize = 2
    ONE_FILE: usize = 1
    ONE_OPEN_OPERATION: usize = 1
    NO_OPERATIONS: usize = 0
    AFTER_READ_OPERATION: usize = 2
    AFTER_SEEK_OPERATION: usize = 3
    FIRST_FILE_INDEX: usize = 0
    FIRST_HANDLE: u64 = 1
    FIRST_BYTE: u8 = 7
    SECOND_BYTE: u8 = 8
    THIRD_BYTE: u8 = 9
    WRITE_BYTE: u8 = 10
    CHANGED_WRITE_BYTE: u8 = 11
    MISMATCH_SEEK_OFFSET: usize = 1
    FILE_START_OFFSET: usize = 0
    FAILURE_RECORD_OPEN: i64 = 1
    FAILURE_RECORD_SEED: i64 = 2
    FAILURE_MATCHED_OPEN: i64 = 3
    FAILURE_MISSING_OPEN: i64 = 4
    FAILURE_CHANGED_GENERATION: i64 = 5
    FAILURE_CHANGED_ACCESS: i64 = 6
    FAILURE_STATE_MUTATION: i64 = 7
    FAILURE_REPLAY_READ: i64 = 8
    FAILURE_STORE_VALIDATION: i64 = 9
    FAILURE_CORRUPT_OPEN: i64 = 10
    FAILURE_RECORD_READ: i64 = 11
    FAILURE_REPLAY_RESTART: i64 = 12
    FAILURE_RECORD_WRITE: i64 = 13
    FAILURE_READ_MISMATCH: i64 = 14
    FAILURE_SEEK_MISMATCH: i64 = 15
    FAILURE_WRITE_MISMATCH: i64 = 16
    FAILURE_OPERATION_OVERFLOW: i64 = 17
    FAILURE_APPEND_REPLAY: i64 = 18
    TEST_SUCCESS: i64 = 0

    const module AppendReplay:
        PATH_ID: u64 = 4101
        GENERATION: u64 = 18
        INITIAL_LENGTH: usize = 1
        APPENDED_LENGTH: usize = 1
        INITIAL_BYTE: u8 = 21
        APPENDED_BYTE: u8 = 22
        FIRST_INDEX: usize = 0
        APPEND_OFFSET: usize = 1
        WRITE_OPERATION_INDEX: usize = 2
        OPERATION_COUNT: usize = 3

def main() -> i64:
    store: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(store, DebuggerVirtualResources::ResourceMode.Recording)
    recorded: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(store, DebuggerIdentity::debug_id(Test::PATH_ID), true, Test::GENERATION)
    return Test::FAILURE_RECORD_OPEN if not recorded.accepted or not DebuggerErrors::error_is_ok(recorded.failure) or recorded.handle.value != Test::FIRST_HANDLE or store.count != Test::ONE_FILE

    phantom_resource_store: mutable DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_clone_snapshot(store)
    phantom_resource_store.operation_count <- Test::NO_OPERATIONS
    phantom_resource_store.operation_cursor <- Test::NO_OPERATIONS
    return Test::FAILURE_STORE_VALIDATION if DebuggerVirtualResources::resources_is_valid(phantom_resource_store)

    bytes: mutable u8[Test::BYTE_COUNT] = [Test::FIRST_BYTE, Test::SECOND_BYTE, Test::THIRD_BYTE]
    seed_failure: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seed(store, recorded.handle, bytes[Test::FIRST_BYTE_INDEX], Test::BYTE_COUNT)
    return Test::FAILURE_RECORD_SEED if not DebuggerErrors::error_is_ok(seed_failure)

    recorded_output: mutable u8[Test::BYTE_COUNT] = zeroed
    recorded_read: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(store, recorded.handle, recorded_output[Test::FIRST_BYTE_INDEX], Test::BYTE_COUNT)
    return Test::FAILURE_RECORD_READ if not DebuggerErrors::error_is_ok(recorded_read.failure) or recorded_read.transferred != Test::BYTE_COUNT or recorded_output[Test::LAST_BYTE_INDEX] != Test::THIRD_BYTE
    recorded_seek: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seek(store, recorded.handle, Test::FILE_START_OFFSET)
    return Test::FAILURE_RECORD_WRITE if not DebuggerErrors::error_is_ok(recorded_seek)
    write_bytes: mutable u8[Test::ONE_BYTE] = [Test::WRITE_BYTE]
    recorded_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(store, recorded.handle, write_bytes[Test::FIRST_BYTE_INDEX], Test::ONE_BYTE)
    return Test::FAILURE_RECORD_WRITE if not DebuggerErrors::error_is_ok(recorded_write.failure) or recorded_write.transferred != Test::ONE_BYTE

    restart_failure: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_replay_restart(store)
    return Test::FAILURE_REPLAY_RESTART if not DebuggerErrors::error_is_ok(restart_failure)
    recorded_count: usize = store.count
    recorded_next_handle: u64 = store.next_handle
    before_missing_cursor: usize = store.operation_cursor
    missing: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(store, DebuggerIdentity::debug_id(Test::PATH_ID + Test::PATH_OFFSET), true, Test::GENERATION)
    return Test::FAILURE_MISSING_OPEN if missing.accepted or missing.failure.code != DebuggerErrors::ErrorCode.Diverged or store.count != recorded_count or store.next_handle != recorded_next_handle or store.operation_cursor != before_missing_cursor

    changed_generation: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(store, DebuggerIdentity::debug_id(Test::PATH_ID), true, Test::GENERATION + Test::PATH_OFFSET)
    return Test::FAILURE_CHANGED_GENERATION if changed_generation.accepted or changed_generation.failure.code != DebuggerErrors::ErrorCode.Diverged or store.count != recorded_count or store.next_handle != recorded_next_handle or store.operation_cursor != before_missing_cursor

    changed_access: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(store, DebuggerIdentity::debug_id(Test::PATH_ID), false, Test::GENERATION)
    return Test::FAILURE_CHANGED_ACCESS if changed_access.accepted or changed_access.failure.code != DebuggerErrors::ErrorCode.Diverged or store.count != recorded_count or store.next_handle != recorded_next_handle or store.operation_cursor != before_missing_cursor

    matched: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(store, DebuggerIdentity::debug_id(Test::PATH_ID), true, Test::GENERATION)
    return Test::FAILURE_MATCHED_OPEN if not matched.accepted or matched.handle.value != recorded.handle.value or store.count != recorded_count or store.next_handle != recorded_next_handle or store.operation_cursor != Test::ONE_OPEN_OPERATION

    seed_during_replay: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seed(store, recorded.handle, bytes[Test::FIRST_BYTE_INDEX], Test::BYTE_COUNT)
    return Test::FAILURE_STATE_MUTATION if seed_during_replay.code != DebuggerErrors::ErrorCode.InvalidState or store.files[Test::FIRST_FILE_INDEX].length != Test::BYTE_COUNT or store.files[Test::FIRST_FILE_INDEX].bytes[Test::FIRST_BYTE_INDEX] != Test::FIRST_BYTE

    restored: mutable u8[Test::BYTE_COUNT] = zeroed
    read_result: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(store, matched.handle, restored[Test::FIRST_BYTE_INDEX], Test::BYTE_COUNT)
    return Test::FAILURE_REPLAY_READ if not DebuggerErrors::error_is_ok(read_result.failure) or read_result.transferred != Test::BYTE_COUNT or restored[Test::FIRST_BYTE_INDEX] != Test::FIRST_BYTE or restored[Test::SECOND_BYTE_INDEX] != Test::SECOND_BYTE or restored[Test::LAST_BYTE_INDEX] != Test::THIRD_BYTE
    restart_again: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_replay_restart(store)
    return Test::FAILURE_REPLAY_RESTART if not DebuggerErrors::error_is_ok(restart_again)
    matched_again: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(store, DebuggerIdentity::debug_id(Test::PATH_ID), true, Test::GENERATION)
    mismatch_read: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(store, matched_again.handle, restored[Test::FIRST_BYTE_INDEX], Test::BYTE_COUNT - Test::ONE_BYTE)
    return Test::FAILURE_READ_MISMATCH if mismatch_read.failure.code != DebuggerErrors::ErrorCode.Diverged or store.operation_cursor != Test::ONE_OPEN_OPERATION or store.files[Test::FIRST_FILE_INDEX].cursor != Test::FIRST_BYTE_INDEX
    read_result_again: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_read(store, matched_again.handle, restored[Test::FIRST_BYTE_INDEX], Test::BYTE_COUNT)
    return Test::FAILURE_READ_MISMATCH if not DebuggerErrors::error_is_ok(read_result_again.failure) or read_result_again.transferred != Test::BYTE_COUNT
    mismatch_seek: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seek(store, matched_again.handle, Test::MISMATCH_SEEK_OFFSET)
    return Test::FAILURE_SEEK_MISMATCH if mismatch_seek.code != DebuggerErrors::ErrorCode.Diverged or store.operation_cursor != Test::AFTER_READ_OPERATION or store.files[Test::FIRST_FILE_INDEX].cursor != Test::BYTE_COUNT
    replay_seek: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seek(store, matched_again.handle, Test::FILE_START_OFFSET)
    return Test::FAILURE_SEEK_MISMATCH if not DebuggerErrors::error_is_ok(replay_seek)
    changed_bytes: mutable u8[Test::ONE_BYTE] = [Test::CHANGED_WRITE_BYTE]
    mismatch_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(store, matched_again.handle, changed_bytes[Test::FIRST_BYTE_INDEX], Test::ONE_BYTE)
    return Test::FAILURE_WRITE_MISMATCH if mismatch_write.failure.code != DebuggerErrors::ErrorCode.Diverged or store.operation_cursor != Test::AFTER_SEEK_OPERATION or store.files[Test::FIRST_FILE_INDEX].cursor != Test::FILE_START_OFFSET or store.files[Test::FIRST_FILE_INDEX].bytes[Test::FIRST_BYTE_INDEX] != Test::FIRST_BYTE
    replay_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(store, matched_again.handle, write_bytes[Test::FIRST_BYTE_INDEX], Test::ONE_BYTE)
    return Test::FAILURE_WRITE_MISMATCH if not DebuggerErrors::error_is_ok(replay_write.failure) or replay_write.transferred != Test::ONE_BYTE or store.files[Test::FIRST_FILE_INDEX].bytes[Test::FIRST_BYTE_INDEX] != Test::WRITE_BYTE or not DebuggerVirtualResources::resources_replay_complete(store) or not DebuggerVirtualResources::resources_is_exact(store)
    return Test::FAILURE_STORE_VALIDATION if not DebuggerVirtualResources::resources_is_valid(store)

    corrupted_store: mutable DebuggerVirtualResources::ResourceStore = store
    corrupted_store.next_handle <- recorded.handle.value
    corrupted_next_handle: u64 = corrupted_store.next_handle
    corrupt_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(corrupted_store, DebuggerIdentity::debug_id(Test::PATH_ID), true, Test::GENERATION)
    return Test::FAILURE_CORRUPT_OPEN if corrupt_open.accepted or corrupt_open.failure.code != DebuggerErrors::ErrorCode.Corrupt or corrupted_store.count != recorded_count or corrupted_store.next_handle != corrupted_next_handle

    overflow_store: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(overflow_store, DebuggerVirtualResources::ResourceMode.Recording)
    first_overflow_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_store, DebuggerIdentity::debug_id(Test::PATH_ID), true, Test::GENERATION)
    return Test::FAILURE_OPERATION_OVERFLOW if not first_overflow_open.accepted
    while overflow_store.operation_count < DebuggerVirtualResources::Limits::MAX_OPERATIONS:
        fill_operation: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_store, DebuggerIdentity::debug_id(Test::PATH_ID), true, Test::GENERATION)
        return Test::FAILURE_OPERATION_OVERFLOW if not fill_operation.accepted or not DebuggerErrors::error_is_ok(fill_operation.failure)
    operation_count_before_overflow: usize = overflow_store.operation_count
    next_handle_before_overflow: u64 = overflow_store.next_handle
    overflowed_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(overflow_store, DebuggerIdentity::debug_id(Test::PATH_ID), true, Test::GENERATION)
    return Test::FAILURE_OPERATION_OVERFLOW if overflowed_open.accepted or overflowed_open.failure.code != DebuggerErrors::ErrorCode.ResourceLimit or not overflow_store.operation_overflowed or overflow_store.operation_count != operation_count_before_overflow or overflow_store.operation_cursor != operation_count_before_overflow or overflow_store.next_handle != next_handle_before_overflow
    replay_after_overflow: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_replay_restart(overflow_store)
    return Test::FAILURE_OPERATION_OVERFLOW if replay_after_overflow.code != DebuggerErrors::ErrorCode.ResourceLimit or overflow_store.mode != DebuggerVirtualResources::ResourceMode.Recording or not DebuggerVirtualResources::resources_is_valid(overflow_store) or DebuggerVirtualResources::resources_is_exact(overflow_store) or DebuggerVirtualResources::resources_replay_complete(overflow_store)

    append_store: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(append_store, DebuggerVirtualResources::ResourceMode.Recording)
    append_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(append_store, DebuggerIdentity::debug_id(Test::AppendReplay::PATH_ID), true, Test::AppendReplay::GENERATION)
    return Test::FAILURE_APPEND_REPLAY if not append_open.accepted
    initial_byte: mutable u8[Test::AppendReplay::INITIAL_LENGTH] = [Test::AppendReplay::INITIAL_BYTE]
    append_seed_failure: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seed(append_store, append_open.handle, initial_byte[Test::AppendReplay::FIRST_INDEX], Test::AppendReplay::INITIAL_LENGTH)
    return Test::FAILURE_APPEND_REPLAY if not DebuggerErrors::error_is_ok(append_seed_failure)
    append_seek_failure: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seek(append_store, append_open.handle, Test::AppendReplay::APPEND_OFFSET)
    return Test::FAILURE_APPEND_REPLAY if not DebuggerErrors::error_is_ok(append_seek_failure)
    appended_byte: mutable u8[Test::AppendReplay::APPENDED_LENGTH] = [Test::AppendReplay::APPENDED_BYTE]
    append_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(append_store, append_open.handle, appended_byte[Test::AppendReplay::FIRST_INDEX], Test::AppendReplay::APPENDED_LENGTH)
    return Test::FAILURE_APPEND_REPLAY if not DebuggerErrors::error_is_ok(append_write.failure) or append_store.files[Test::AppendReplay::FIRST_INDEX].length != Test::AppendReplay::INITIAL_LENGTH + Test::AppendReplay::APPENDED_LENGTH
    corrupt_append_store: mutable DebuggerVirtualResources::ResourceStore = DebuggerVirtualResources::resources_clone_snapshot(append_store)
    corrupt_append_store.operations[Test::AppendReplay::WRITE_OPERATION_INDEX].offset <- Test::AppendReplay::FIRST_INDEX
    return Test::FAILURE_APPEND_REPLAY if DebuggerVirtualResources::resources_is_valid(corrupt_append_store)
    append_restart: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_replay_restart(append_store)
    return Test::FAILURE_APPEND_REPLAY if not DebuggerErrors::error_is_ok(append_restart)
    append_replay_open: DebuggerVirtualResources::ResourceOpenResult = DebuggerVirtualResources::resources_open_checked(append_store, DebuggerIdentity::debug_id(Test::AppendReplay::PATH_ID), true, Test::AppendReplay::GENERATION)
    return Test::FAILURE_APPEND_REPLAY if not append_replay_open.accepted
    append_replay_seek: DebuggerErrors::DebuggerError = DebuggerVirtualResources::resources_seek(append_store, append_replay_open.handle, Test::AppendReplay::APPEND_OFFSET)
    return Test::FAILURE_APPEND_REPLAY if not DebuggerErrors::error_is_ok(append_replay_seek)
    append_replay_write: DebuggerVirtualResources::IoResult = DebuggerVirtualResources::resources_write(append_store, append_replay_open.handle, appended_byte[Test::AppendReplay::FIRST_INDEX], Test::AppendReplay::APPENDED_LENGTH)
    return Test::FAILURE_APPEND_REPLAY if not DebuggerErrors::error_is_ok(append_replay_write.failure) or append_store.files[Test::AppendReplay::FIRST_INDEX].length != Test::AppendReplay::INITIAL_LENGTH + Test::AppendReplay::APPENDED_LENGTH or append_store.files[Test::AppendReplay::FIRST_INDEX].bytes[Test::AppendReplay::APPEND_OFFSET] != Test::AppendReplay::APPENDED_BYTE or not DebuggerVirtualResources::resources_replay_complete(append_store) or append_store.operation_count != Test::AppendReplay::OPERATION_COUNT
    return Test::TEST_SUCCESS
