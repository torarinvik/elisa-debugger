include "../src/concurrency/runtime.elisa"
include "../src/concurrency/checkpoint.elisa"

const FIRST_TASK: u64 = 1
const SECOND_TASK: u64 = 2
const INVALID_SCHEDULER_FLAG_RESULT: i64 = 9
const INVALID_TASK_COUNT: usize = 65
const INVALID_PARENT_CYCLE_RESULT: i64 = 18
const OWNER_TERMINAL_RESULT: i64 = 21
const INVALID_WAIT_COUNT: usize = 129
const INVALID_WAIT_COUNT_RESULT: i64 = 23
const WAIT_RESOURCE_ID: u64 = 99
const SECOND_WAIT_RESOURCE_ID: u64 = 100
const BLOCKED_TRANSITION_RESULT: i64 = 24
const WAKE_EDGE_COUNT_RESULT: i64 = 25

def runtime_with_blocked_waiter() -> DebuggerConcurrencyRuntime::TaskRuntime:
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    owner: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    _ = DebuggerConcurrencyRuntime::runtime_transition(runtime, owner, DebuggerConcurrency::TaskState.Running)
    _ = DebuggerConcurrencyRuntime::runtime_transition(runtime, waiter, DebuggerConcurrency::TaskState.Running)
    _ = DebuggerConcurrencyRuntime::runtime_wait(runtime, waiter, owner, DebuggerIdentity::debug_id(WAIT_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex)
    return runtime

def main() -> i64:
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    return 10 if not DebuggerConcurrencyRuntime::runtime_is_valid(runtime)
    first: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    second: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    return 1 if first.value != FIRST_TASK or second.value != SECOND_TASK
    return 2 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, first, DebuggerConcurrency::TaskState.Blocked)
    return 3 if runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Ready
    mixed_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)
    return 8 if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(mixed_snapshot)
    invalid_divergence: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = mixed_snapshot
    invalid_divergence.scheduler_diverged <- true
    return INVALID_SCHEDULER_FLAG_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_divergence)
    invalid_overflow: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = mixed_snapshot
    invalid_overflow.scheduler_overflowed <- true
    return INVALID_SCHEDULER_FLAG_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_overflow)
    return 4 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, second, DebuggerConcurrency::TaskState.Running)
    return 5 if runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Running
    return 6 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, second, DebuggerConcurrency::TaskState.Completed)
    return 7 if runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Blocked
    return 12 if runtime.current.value == SECOND_TASK
    malformed: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed.tasks[0].id <- malformed.tasks[1].id
    return 11 if DebuggerConcurrencyRuntime::runtime_is_valid(malformed)
    malformed_parent: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_parent.tasks[0].parent <- DebuggerIdentity::debug_id(99)
    return 16 if DebuggerConcurrencyRuntime::runtime_is_valid(malformed_parent)
    terminal_current: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    terminal_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(terminal_current, DebuggerIdentity::debug_id(0))
    terminal_current.tasks[0].state <- DebuggerConcurrency::TaskState.Completed
    terminal_current.current <- terminal_task
    return 13 if DebuggerConcurrencyRuntime::runtime_is_valid(terminal_current)
    contradictory: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    contradictory.status <- DebuggerConcurrencyRuntime::RuntimeStatus.Running
    return 14 if DebuggerConcurrencyRuntime::runtime_is_valid(contradictory)
    malformed_count: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_count.task_count <- INVALID_TASK_COUNT
    return 15 if DebuggerConcurrencyRuntime::runtime_status_is_consistent(malformed_count)
    malformed_counter: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_counter.next_id <- 99
    return 22 if DebuggerConcurrencyRuntime::runtime_is_valid(malformed_counter)
    diverged: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    diverged.status <- DebuggerConcurrencyRuntime::RuntimeStatus.Diverged
    diverged.scheduler.diverged <- true
    return 17 if not DebuggerConcurrencyRuntime::runtime_is_valid(diverged)
    return 19 if DebuggerConcurrencyRuntime::runtime_transition(diverged, first, DebuggerConcurrency::TaskState.Running)
    malformed_diverged: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_diverged.scheduler.diverged <- true
    return 20 if DebuggerConcurrencyRuntime::runtime_is_valid(malformed_diverged)
    owner_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    owner: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(owner_runtime, DebuggerIdentity::debug_id(0))
    waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(owner_runtime, DebuggerIdentity::debug_id(0))
    return OWNER_TERMINAL_RESULT if not DebuggerConcurrencyRuntime::runtime_transition(owner_runtime, owner, DebuggerConcurrency::TaskState.Running) or not DebuggerConcurrencyRuntime::runtime_transition(owner_runtime, waiter, DebuggerConcurrency::TaskState.Running) or not DebuggerConcurrencyRuntime::runtime_wait(owner_runtime, waiter, owner, DebuggerIdentity::debug_id(99), DebuggerConcurrency::SynchronizationKind.Mutex)
    return OWNER_TERMINAL_RESULT if owner_runtime.current.value == waiter.value
    return OWNER_TERMINAL_RESULT if DebuggerConcurrencyRuntime::runtime_transition(owner_runtime, owner, DebuggerConcurrency::TaskState.Completed) or not DebuggerConcurrencyRuntime::runtime_is_valid(owner_runtime)
    malformed_waits: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    malformed_wait_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(malformed_waits, DebuggerIdentity::debug_id(0))
    return INVALID_WAIT_COUNT_RESULT if not DebuggerConcurrencyRuntime::runtime_transition(malformed_waits, malformed_wait_task, DebuggerConcurrency::TaskState.Running)
    malformed_waits.wait_count <- INVALID_WAIT_COUNT
    return INVALID_WAIT_COUNT_RESULT if DebuggerConcurrencyRuntime::runtime_transition(malformed_waits, malformed_wait_task, DebuggerConcurrency::TaskState.Completed)
    return INVALID_WAIT_COUNT_RESULT if malformed_waits.tasks[0].state != DebuggerConcurrency::TaskState.Running or malformed_waits.tasks[0].logical_time != 1 or malformed_waits.current.value != malformed_wait_task.value or malformed_waits.status != DebuggerConcurrencyRuntime::RuntimeStatus.Running
    malformed_cycle: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_cycle.tasks[0].parent <- second
    malformed_cycle.tasks[1].parent <- first
    return INVALID_PARENT_CYCLE_RESULT if DebuggerConcurrencyRuntime::runtime_is_valid(malformed_cycle)
    cancelled_waiter_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime_with_blocked_waiter()
    return BLOCKED_TRANSITION_RESULT if cancelled_waiter_runtime.wait_count != 1 or not DebuggerConcurrencyRuntime::runtime_transition(cancelled_waiter_runtime, DebuggerIdentity::debug_id(SECOND_TASK), DebuggerConcurrency::TaskState.Cancelled)
    return BLOCKED_TRANSITION_RESULT if cancelled_waiter_runtime.wait_count != 0 or not DebuggerConcurrencyRuntime::runtime_is_valid(cancelled_waiter_runtime)
    resumed_waiter_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime_with_blocked_waiter()
    return BLOCKED_TRANSITION_RESULT if resumed_waiter_runtime.wait_count != 1 or not DebuggerConcurrencyRuntime::runtime_transition(resumed_waiter_runtime, DebuggerIdentity::debug_id(SECOND_TASK), DebuggerConcurrency::TaskState.Runnable)
    return BLOCKED_TRANSITION_RESULT if resumed_waiter_runtime.wait_count != 0 or not DebuggerConcurrencyRuntime::runtime_is_valid(resumed_waiter_runtime)
    wake_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime_with_blocked_waiter()
    other_waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(wake_runtime, DebuggerIdentity::debug_id(0))
    return WAKE_EDGE_COUNT_RESULT if other_waiter.value == 0 or not DebuggerConcurrencyRuntime::runtime_transition(wake_runtime, other_waiter, DebuggerConcurrency::TaskState.Running)
    return WAKE_EDGE_COUNT_RESULT if not DebuggerConcurrencyRuntime::runtime_wait(wake_runtime, other_waiter, DebuggerIdentity::debug_id(FIRST_TASK), DebuggerIdentity::debug_id(SECOND_WAIT_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex)
    return WAKE_EDGE_COUNT_RESULT if wake_runtime.wait_count != 2 or not DebuggerConcurrencyRuntime::runtime_wake(wake_runtime, DebuggerIdentity::debug_id(SECOND_TASK))
    return WAKE_EDGE_COUNT_RESULT if wake_runtime.wait_count != 1 or wake_runtime.waits[0].waiter.value != other_waiter.value or not DebuggerConcurrencyRuntime::runtime_is_valid(wake_runtime)
    return 0
