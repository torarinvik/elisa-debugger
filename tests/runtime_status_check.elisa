include "../src/concurrency/runtime.elisa"
include "../src/concurrency/checkpoint.elisa"

const module Test:
    FIRST_TASK: u64 = 1
    SECOND_TASK: u64 = 2
    INVALID_SCHEDULER_FLAG_RESULT: i64 = 9
    INVALID_TASK_COUNT: usize = 65
    INVALID_PARENT_CYCLE_RESULT: i64 = 18
    OWNER_TERMINAL_RESULT: i64 = 21
    INVALID_WAIT_COUNT: usize = 129
    INVALID_WAIT_COUNT_RESULT: i64 = 23
    WAIT_RESOURCE_ID: u64 = 99
    SECOND_WAIT_RESOURCE_ID: u64 = 100
    BLOCKED_TRANSITION_RESULT: i64 = 24
    WAKE_EDGE_COUNT_RESULT: i64 = 25
    COMPLETED_RESPAWN_RESULT: i64 = 26
    BLOCKED_RESPAWN_RESULT: i64 = 27
    THIRD_WAIT_RESOURCE_ID: u64 = 101
    CURRENT_FALLBACK_RESULT: i64 = 28
    CURRENT_FALLBACK_RESOURCE_ID: u64 = 102
    INVALID_SCHEDULER_COUNT: usize = 513
    INVALID_SCHEDULER_CURSOR: usize = 1
    INVALID_SCHEDULER_RESULT: i64 = 29
    INVALID_SCHEDULER_DECISION_RESULT: i64 = 30
    INVALID_SCHEDULER_DECISION_ORDINAL: u64 = 1
    FIRST_SCHEDULER_DECISION_INDEX: usize = 0
    FIRST_SCHEDULER_DECISION_ORDINAL: u64 = 0
    SECOND_SCHEDULER_DECISION_ORDINAL: u64 = 1
    FIRST_SCHEDULER_DECISION_CONSUMED_COUNT: usize = 1
    FUTURE_SCHEDULER_LOGICAL_TIME: u64 = 8
    FUTURE_SCHEDULER_OS_THREAD: u64 = 2
    ROOT_TASK_ID: u64 = 0
    NO_SYNCHRONIZATION_ID: u64 = 0
    UNKNOWN_SCHEDULER_TASK_ID: u64 = 99
    INVALID_SCHEDULER_TASK_RESULT: i64 = 31


def runtime_with_blocked_waiter() -> DebuggerConcurrencyRuntime::TaskRuntime:
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    owner: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    _ = DebuggerConcurrencyRuntime::runtime_transition(runtime, owner, DebuggerConcurrency::TaskState.Running)
    _ = DebuggerConcurrencyRuntime::runtime_transition(runtime, waiter, DebuggerConcurrency::TaskState.Running)
    _ = DebuggerConcurrencyRuntime::runtime_wait(runtime, waiter, owner, DebuggerIdentity::debug_id(Test::WAIT_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex)
    return runtime

def main() -> i64:
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    return 10 if not DebuggerConcurrencyRuntime::runtime_is_valid(runtime)
    invalid_scheduler_count: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    invalid_scheduler_count.scheduler.count <- Test::INVALID_SCHEDULER_COUNT
    return Test::INVALID_SCHEDULER_RESULT if DebuggerConcurrencyRuntime::runtime_is_valid(invalid_scheduler_count)
    invalid_scheduler_cursor: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    invalid_scheduler_cursor.scheduler.cursor <- Test::INVALID_SCHEDULER_CURSOR
    return Test::INVALID_SCHEDULER_RESULT if DebuggerConcurrencyRuntime::runtime_is_valid(invalid_scheduler_cursor)
    invalid_scheduler_decision: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    decision_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(invalid_scheduler_decision, DebuggerIdentity::debug_id(Test::ROOT_TASK_ID))
    return Test::INVALID_SCHEDULER_DECISION_RESULT if not DebuggerConcurrencyRuntime::runtime_schedule(invalid_scheduler_decision, decision_task, DebuggerScheduler::ScheduleKind.Run, DebuggerIdentity::debug_id(Test::NO_SYNCHRONIZATION_ID))
    invalid_scheduler_decision.scheduler.decisions[Test::FIRST_SCHEDULER_DECISION_INDEX].ordinal <- Test::INVALID_SCHEDULER_DECISION_ORDINAL
    return Test::INVALID_SCHEDULER_DECISION_RESULT if DebuggerConcurrencyRuntime::runtime_is_valid(invalid_scheduler_decision)
    invalid_scheduler_decision.scheduler.decisions[Test::FIRST_SCHEDULER_DECISION_INDEX].ordinal <- Test::FIRST_SCHEDULER_DECISION_ORDINAL
    invalid_scheduler_decision.scheduler.decisions[Test::FIRST_SCHEDULER_DECISION_INDEX].task.id <- DebuggerIdentity::debug_id(Test::UNKNOWN_SCHEDULER_TASK_ID)
    return Test::INVALID_SCHEDULER_TASK_RESULT if DebuggerConcurrencyRuntime::runtime_is_valid(invalid_scheduler_decision)
    replay_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(true)
    replay_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(replay_runtime, DebuggerIdentity::debug_id(Test::ROOT_TASK_ID))
    future_task: DebuggerConcurrency::TaskInfo = DebuggerConcurrency::TaskInfo{id: DebuggerIdentity::debug_id(Test::SECOND_TASK), parent: DebuggerIdentity::debug_id(Test::ROOT_TASK_ID), state: DebuggerConcurrency::TaskState.Runnable, logical_time: Test::FUTURE_SCHEDULER_LOGICAL_TIME, os_thread: Test::FUTURE_SCHEDULER_OS_THREAD}
    replay_history: mutable DebuggerScheduler::DeterministicScheduler = DebuggerScheduler::scheduler_new(false)
    replay_history <- DebuggerScheduler::scheduler_append(replay_history, DebuggerScheduler::ScheduleDecision{ordinal: Test::FIRST_SCHEDULER_DECISION_ORDINAL, task: replay_runtime.tasks[Test::FIRST_SCHEDULER_DECISION_INDEX], kind: DebuggerScheduler::ScheduleKind.Run, synchronization: Test::NO_SYNCHRONIZATION_ID})
    replay_history <- DebuggerScheduler::scheduler_append(replay_history, DebuggerScheduler::ScheduleDecision{ordinal: Test::SECOND_SCHEDULER_DECISION_ORDINAL, task: future_task, kind: DebuggerScheduler::ScheduleKind.Run, synchronization: Test::NO_SYNCHRONIZATION_ID})
    replay_history.replaying <- true
    replay_history.cursor <- Test::FIRST_SCHEDULER_DECISION_CONSUMED_COUNT
    replay_runtime.scheduler <- replay_history
    return Test::INVALID_SCHEDULER_TASK_RESULT if replay_task.value != Test::FIRST_TASK or not DebuggerConcurrencyRuntime::runtime_is_valid(replay_runtime) or not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(DebuggerConcurrencyCheckpoint::task_snapshot_capture(replay_runtime))
    first: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    second: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(runtime, DebuggerIdentity::debug_id(0))
    return 1 if first.value != Test::FIRST_TASK or second.value != Test::SECOND_TASK
    return 2 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, first, DebuggerConcurrency::TaskState.Blocked)
    return 3 if runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Ready
    mixed_snapshot: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)
    return 8 if not DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(mixed_snapshot)
    invalid_divergence: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = mixed_snapshot
    invalid_divergence.scheduler_diverged <- true
    return Test::INVALID_SCHEDULER_FLAG_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_divergence)
    invalid_overflow: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = mixed_snapshot
    invalid_overflow.scheduler_overflowed <- true
    return Test::INVALID_SCHEDULER_FLAG_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(invalid_overflow)
    return 4 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, second, DebuggerConcurrency::TaskState.Running)
    return 5 if runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Running
    return 6 if not DebuggerConcurrencyRuntime::runtime_transition(runtime, second, DebuggerConcurrency::TaskState.Completed)
    return 7 if runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Blocked
    return 12 if runtime.current.value == Test::SECOND_TASK
    malformed: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed.tasks[0].id <- malformed.tasks[1].id
    return 11 if DebuggerConcurrencyRuntime::runtime_is_valid(malformed)
    malformed_parent: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_parent.tasks[0].parent <- DebuggerIdentity::debug_id(99)
    return 16 if DebuggerConcurrencyRuntime::runtime_is_valid(malformed_parent)
    terminal_current: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    terminal_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(terminal_current, DebuggerIdentity::debug_id(0))
    terminal_current.tasks[0].state <- DebuggerConcurrency::TaskState.Completed
    terminal_current.current <- terminal_task
    return 13 if DebuggerConcurrencyRuntime::runtime_is_valid(terminal_current)
    contradictory: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    contradictory.status <- DebuggerConcurrencyRuntime::RuntimeStatus.Running
    return 14 if DebuggerConcurrencyRuntime::runtime_is_valid(contradictory)
    malformed_count: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_count.task_count <- Test::INVALID_TASK_COUNT
    return 15 if DebuggerConcurrencyRuntime::runtime_status_is_consistent(malformed_count)
    malformed_counter: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_counter.next_id <- 99
    return 22 if DebuggerConcurrencyRuntime::runtime_is_valid(malformed_counter)
    diverged: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    diverged.status <- DebuggerConcurrencyRuntime::RuntimeStatus.Diverged
    diverged.scheduler.diverged <- true
    return 17 if not DebuggerConcurrencyRuntime::runtime_is_valid(diverged)
    return 19 if DebuggerConcurrencyRuntime::runtime_transition(diverged, first, DebuggerConcurrency::TaskState.Running)
    malformed_diverged: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_diverged.scheduler.diverged <- true
    return 20 if DebuggerConcurrencyRuntime::runtime_is_valid(malformed_diverged)
    owner_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    owner: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(owner_runtime, DebuggerIdentity::debug_id(0))
    waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(owner_runtime, DebuggerIdentity::debug_id(0))
    return Test::OWNER_TERMINAL_RESULT if not DebuggerConcurrencyRuntime::runtime_transition(owner_runtime, owner, DebuggerConcurrency::TaskState.Running) or not DebuggerConcurrencyRuntime::runtime_transition(owner_runtime, waiter, DebuggerConcurrency::TaskState.Running) or not DebuggerConcurrencyRuntime::runtime_wait(owner_runtime, waiter, owner, DebuggerIdentity::debug_id(99), DebuggerConcurrency::SynchronizationKind.Mutex)
    return Test::OWNER_TERMINAL_RESULT if owner_runtime.current.value == waiter.value
    return Test::OWNER_TERMINAL_RESULT if DebuggerConcurrencyRuntime::runtime_transition(owner_runtime, owner, DebuggerConcurrency::TaskState.Completed) or not DebuggerConcurrencyRuntime::runtime_is_valid(owner_runtime)
    malformed_waits: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    malformed_wait_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(malformed_waits, DebuggerIdentity::debug_id(0))
    return Test::INVALID_WAIT_COUNT_RESULT if not DebuggerConcurrencyRuntime::runtime_transition(malformed_waits, malformed_wait_task, DebuggerConcurrency::TaskState.Running)
    malformed_waits.wait_count <- Test::INVALID_WAIT_COUNT
    return Test::INVALID_WAIT_COUNT_RESULT if DebuggerConcurrencyRuntime::runtime_transition(malformed_waits, malformed_wait_task, DebuggerConcurrency::TaskState.Completed)
    return Test::INVALID_WAIT_COUNT_RESULT if malformed_waits.tasks[0].state != DebuggerConcurrency::TaskState.Running or malformed_waits.tasks[0].logical_time != 1 or malformed_waits.current.value != malformed_wait_task.value or malformed_waits.status != DebuggerConcurrencyRuntime::RuntimeStatus.Running
    malformed_cycle: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime
    malformed_cycle.tasks[0].parent <- second
    malformed_cycle.tasks[1].parent <- first
    return Test::INVALID_PARENT_CYCLE_RESULT if DebuggerConcurrencyRuntime::runtime_is_valid(malformed_cycle)
    cancelled_waiter_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime_with_blocked_waiter()
    return Test::BLOCKED_TRANSITION_RESULT if cancelled_waiter_runtime.wait_count != 1 or not DebuggerConcurrencyRuntime::runtime_transition(cancelled_waiter_runtime, DebuggerIdentity::debug_id(Test::SECOND_TASK), DebuggerConcurrency::TaskState.Cancelled)
    return Test::BLOCKED_TRANSITION_RESULT if cancelled_waiter_runtime.wait_count != 0 or not DebuggerConcurrencyRuntime::runtime_is_valid(cancelled_waiter_runtime)
    resumed_waiter_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime_with_blocked_waiter()
    return Test::BLOCKED_TRANSITION_RESULT if resumed_waiter_runtime.wait_count != 1 or not DebuggerConcurrencyRuntime::runtime_transition(resumed_waiter_runtime, DebuggerIdentity::debug_id(Test::SECOND_TASK), DebuggerConcurrency::TaskState.Runnable)
    return Test::BLOCKED_TRANSITION_RESULT if resumed_waiter_runtime.wait_count != 0 or not DebuggerConcurrencyRuntime::runtime_is_valid(resumed_waiter_runtime)
    wake_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = runtime_with_blocked_waiter()
    other_waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(wake_runtime, DebuggerIdentity::debug_id(0))
    return Test::WAKE_EDGE_COUNT_RESULT if other_waiter.value == 0 or not DebuggerConcurrencyRuntime::runtime_transition(wake_runtime, other_waiter, DebuggerConcurrency::TaskState.Running)
    return Test::WAKE_EDGE_COUNT_RESULT if not DebuggerConcurrencyRuntime::runtime_wait(wake_runtime, other_waiter, DebuggerIdentity::debug_id(Test::FIRST_TASK), DebuggerIdentity::debug_id(Test::SECOND_WAIT_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex)
    return Test::WAKE_EDGE_COUNT_RESULT if wake_runtime.wait_count != 2 or not DebuggerConcurrencyRuntime::runtime_wake(wake_runtime, DebuggerIdentity::debug_id(Test::SECOND_TASK))
    return Test::WAKE_EDGE_COUNT_RESULT if wake_runtime.wait_count != 1 or wake_runtime.waits[0].waiter.value != other_waiter.value or not DebuggerConcurrencyRuntime::runtime_is_valid(wake_runtime)
    completed_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    completed_task: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(completed_runtime, DebuggerIdentity::debug_id(0))
    return Test::COMPLETED_RESPAWN_RESULT if not DebuggerConcurrencyRuntime::runtime_transition(completed_runtime, completed_task, DebuggerConcurrency::TaskState.Running) or not DebuggerConcurrencyRuntime::runtime_transition(completed_runtime, completed_task, DebuggerConcurrency::TaskState.Completed) or completed_runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Completed
    completed_respawn: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(completed_runtime, DebuggerIdentity::debug_id(0))
    return Test::COMPLETED_RESPAWN_RESULT if completed_respawn.value == 0 or completed_runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Ready or completed_runtime.current.value != completed_respawn.value or not DebuggerConcurrencyRuntime::runtime_is_valid(completed_runtime)
    blocked_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    blocked_owner: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(blocked_runtime, DebuggerIdentity::debug_id(0))
    blocked_waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(blocked_runtime, DebuggerIdentity::debug_id(0))
    return Test::BLOCKED_RESPAWN_RESULT if not DebuggerConcurrencyRuntime::runtime_transition(blocked_runtime, blocked_owner, DebuggerConcurrency::TaskState.Running) or not DebuggerConcurrencyRuntime::runtime_transition(blocked_runtime, blocked_waiter, DebuggerConcurrency::TaskState.Running)
    return Test::BLOCKED_RESPAWN_RESULT if not DebuggerConcurrencyRuntime::runtime_wait(blocked_runtime, blocked_waiter, blocked_owner, DebuggerIdentity::debug_id(Test::SECOND_WAIT_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex) or not DebuggerConcurrencyRuntime::runtime_wait(blocked_runtime, blocked_owner, blocked_waiter, DebuggerIdentity::debug_id(Test::THIRD_WAIT_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex) or blocked_runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Blocked or not DebuggerConcurrencyRuntime::runtime_is_valid(blocked_runtime)
    blocked_respawn: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(blocked_runtime, DebuggerIdentity::debug_id(0))
    return Test::BLOCKED_RESPAWN_RESULT if blocked_respawn.value == 0 or blocked_runtime.status != DebuggerConcurrencyRuntime::RuntimeStatus.Ready or blocked_runtime.current.value != blocked_respawn.value or not DebuggerConcurrencyRuntime::runtime_is_valid(blocked_runtime)
    fallback_runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = DebuggerConcurrencyRuntime::runtime_new(false)
    completed_current: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(fallback_runtime, DebuggerIdentity::debug_id(0))
    fallback_waiter: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(fallback_runtime, DebuggerIdentity::debug_id(0))
    running_owner: DebuggerIdentity::DebugId = DebuggerConcurrencyRuntime::runtime_spawn(fallback_runtime, DebuggerIdentity::debug_id(0))
    return Test::CURRENT_FALLBACK_RESULT if not DebuggerConcurrencyRuntime::runtime_transition(fallback_runtime, completed_current, DebuggerConcurrency::TaskState.Running) or not DebuggerConcurrencyRuntime::runtime_transition(fallback_runtime, fallback_waiter, DebuggerConcurrency::TaskState.Running) or not DebuggerConcurrencyRuntime::runtime_transition(fallback_runtime, running_owner, DebuggerConcurrency::TaskState.Running)
    return Test::CURRENT_FALLBACK_RESULT if not DebuggerConcurrencyRuntime::runtime_wait(fallback_runtime, fallback_waiter, running_owner, DebuggerIdentity::debug_id(Test::CURRENT_FALLBACK_RESOURCE_ID), DebuggerConcurrency::SynchronizationKind.Mutex)
    return Test::CURRENT_FALLBACK_RESULT if not DebuggerConcurrencyRuntime::runtime_transition(fallback_runtime, completed_current, DebuggerConcurrency::TaskState.Completed) or fallback_runtime.current.value != running_owner.value or not DebuggerConcurrencyRuntime::runtime_is_valid(fallback_runtime)
    blocked_current_snapshot: mutable DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(fallback_runtime)
    blocked_current_snapshot.current <- fallback_waiter
    return Test::CURRENT_FALLBACK_RESULT if DebuggerConcurrencyCheckpoint::task_snapshot_is_valid(blocked_current_snapshot)
    return 0
