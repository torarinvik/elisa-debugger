include "../src/protocol/framing.elisa"

const PAYLOAD_LENGTH: usize = 4
const FRAME_LENGTH: usize = 7
const BUFFER_LENGTH: usize = FRAME_LENGTH * 2
const EXPECTED_LAST_BYTE: u8 = 68

def main() -> i64:
    payload: mutable u8[PAYLOAD_LENGTH] = [65, 66, 67, EXPECTED_LAST_BYTE]
    encoded: DebuggerProtocolFraming::FrameBuffer = DebuggerProtocolFraming::frame_encode(payload[0], PAYLOAD_LENGTH)
    return 1 if not DebuggerProtocolFraming::frame_buffer_is_valid(encoded) or encoded.length != FRAME_LENGTH

    decoder: mutable DebuggerProtocolFraming::FrameDecoder = DebuggerProtocolFraming::frame_decoder_new()
    combined: mutable u8[BUFFER_LENGTH] = zeroed
    for index in 0..<FRAME_LENGTH:
        combined[index] <- encoded.bytes[index]
        combined[FRAME_LENGTH + index] <- encoded.bytes[index]
    completed_count: mutable usize = 0
    for index in 0..<BUFFER_LENGTH:
        completed: bool = DebuggerProtocolFraming::frame_decoder_accept(decoder, combined[index])
        if completed:
            completed_count <- completed_count + 1
            return 2 if decoder.payload[3] != EXPECTED_LAST_BYTE
            DebuggerProtocolFraming::frame_decoder_reset(decoder)
    return 3 if completed_count != 2 or decoder.state != DebuggerProtocolFraming::FrameDecoderState.Header
    return 0
