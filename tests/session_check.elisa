include "../src/core/session.elisa"
include "../src/core/identity.elisa"
include "../src/core/capabilities.elisa"

const POSTMORTEM_ATTACH_RESULT: i64 = 6
const LIVE_NATIVE_ATTACH_RESULT: i64 = 9

def main() -> i64:
    build: DebuggerIdentity::BuildIdentity = DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(1), runtime: DebuggerIdentity::debug_id(2), source: DebuggerIdentity::debug_id(3), target: DebuggerIdentity::debug_id(4), metadata_version: 1}
    session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(1), build, DebuggerCapabilities::managed_capabilities())
    configured: DebuggerSession::Session = DebuggerSession::session_configure(session)
    return 1 if configured.state != DebuggerSession::SessionState.Configuring
    launched: DebuggerSession::Session = DebuggerSession::session_launch(configured)
    stopped: DebuggerSession::Session = DebuggerSession::session_pause(launched)
    restored: DebuggerSession::Session = DebuggerSession::session_begin_restore(stopped, stopped.stop_generation)
    finished: DebuggerSession::Session = DebuggerSession::session_finish_restore(restored)
    return 2 if finished.state != DebuggerSession::SessionState.Stopped
    recording: DebuggerSession::Session = DebuggerSession::session_begin_recording(launched)
    detached_recording: DebuggerSession::Session = DebuggerSession::session_detach(recording)
    return 5 if detached_recording.state != DebuggerSession::SessionState.Detached
    replaying: DebuggerSession::Session = DebuggerSession::session_begin_replay(finished)
    resumed_replay: DebuggerSession::Session = DebuggerSession::session_resume(replaying)
    return 7 if resumed_replay.state != DebuggerSession::SessionState.Replaying
    stopped_replay: DebuggerSession::Session = DebuggerSession::session_stop(resumed_replay)
    return 8 if stopped_replay.state != DebuggerSession::SessionState.Stopped or stopped_replay.last_error != DebuggerSession::SessionError.None
    at_origin: DebuggerSession::Session = DebuggerSession::session_reverse_step(finished)
    return 3 if at_origin.last_error != DebuggerSession::SessionError.HistoryUnavailable
    return 4 if at_origin.position.recording.value != finished.position.recording.value
    postmortem_capabilities: DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::postmortem_capabilities()
    postmortem_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(2), build, postmortem_capabilities)
    rejected_postmortem_attach: DebuggerSession::Session = DebuggerSession::session_attach(postmortem_session)
    return POSTMORTEM_ATTACH_RESULT if rejected_postmortem_attach.state != DebuggerSession::SessionState.Created or rejected_postmortem_attach.last_error != DebuggerSession::SessionError.Unsupported
    postmortem_session.state <- DebuggerSession::SessionState.Stopped
    rejected_postmortem_detach: DebuggerSession::Session = DebuggerSession::session_detach(postmortem_session)
    return 10 if rejected_postmortem_detach.state != DebuggerSession::SessionState.Stopped or rejected_postmortem_detach.last_error != DebuggerSession::SessionError.Unsupported
    rejected_postmortem_terminate: DebuggerSession::Session = DebuggerSession::session_terminate(postmortem_session)
    return 11 if rejected_postmortem_terminate.state != DebuggerSession::SessionState.Stopped or rejected_postmortem_terminate.last_error != DebuggerSession::SessionError.Unsupported
    rejected_postmortem_resume: DebuggerSession::Session = DebuggerSession::session_resume(postmortem_session)
    return 12 if rejected_postmortem_resume.state != DebuggerSession::SessionState.Stopped or rejected_postmortem_resume.last_error != DebuggerSession::SessionError.Unsupported
    rejected_postmortem_step: DebuggerSession::Session = DebuggerSession::session_step(postmortem_session)
    return 13 if rejected_postmortem_step.state != DebuggerSession::SessionState.Stopped or rejected_postmortem_step.last_error != DebuggerSession::SessionError.Unsupported
    attached_native_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(4), build, DebuggerCapabilities::native_attach_capabilities())
    attached_native_session.state <- DebuggerSession::SessionState.Stopped
    rejected_attached_terminate: DebuggerSession::Session = DebuggerSession::session_terminate(attached_native_session)
    return 14 if rejected_attached_terminate.state != DebuggerSession::SessionState.Stopped or rejected_attached_terminate.last_error != DebuggerSession::SessionError.Unsupported
    live_native_session: DebuggerSession::Session = DebuggerSession::new_session(DebuggerIdentity::debug_id(3), build, DebuggerCapabilities::native_live_capabilities())
    rejected_live_native_attach: DebuggerSession::Session = DebuggerSession::session_attach(live_native_session)
    return LIVE_NATIVE_ATTACH_RESULT if rejected_live_native_attach.state != DebuggerSession::SessionState.Created or rejected_live_native_attach.last_error != DebuggerSession::SessionError.Unsupported
    return 0
