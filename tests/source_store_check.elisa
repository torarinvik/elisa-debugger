include "../src/metadata/source_store.elisa"

const SOURCE_STORE_FILE_ID: u64 = 901
const SOURCE_STORE_PATH_ID: u64 = 902
const SOURCE_STORE_CONTENT_ID: u64 = 903
const SOURCE_STORE_FUNCTION_ID: u64 = 904
const SOURCE_STORE_FIRST_INDEX: usize = 0
const SOURCE_STORE_NO_ID: u64 = 0
const SOURCE_STORE_PATH_LENGTH: usize = 14
const SOURCE_STORE_PATH_BYTES: u8[SOURCE_STORE_PATH_LENGTH] = [115, 114, 99, 47, 109, 97, 105, 110, 46, 101, 108, 105, 115, 97]
const SOURCE_STORE_EXPECTED_PATH_CAPACITY: usize = 1024
const SOURCE_STORE_OVERSIZED_PATH_LENGTH: usize = SOURCE_STORE_EXPECTED_PATH_CAPACITY + 1
const SOURCE_STORE_INVALID_UTF8_BYTE: u8 = 255
const SOURCE_STORE_DOT_BYTE: u8 = 46
const SOURCE_STORE_DRIVE_PATH_LENGTH: usize = 8
const SOURCE_STORE_DRIVE_PATH_BYTES: u8[SOURCE_STORE_DRIVE_PATH_LENGTH] = [67, 58, 47, 115, 114, 99, 47, 97]
const SOURCE_STORE_UNICODE_PATH_LENGTH: usize = 2
const SOURCE_STORE_UNICODE_PATH_BYTES: u8[SOURCE_STORE_UNICODE_PATH_LENGTH] = [195, 184]

def main() -> i64:
    store: mutable DebuggerSourceStore::SourceStore = DebuggerSourceStore::source_store_new()
    return 1 if not DebuggerSourceStore::source_store_is_valid(store)
    return 13 if DebuggerMetadata::source_path_capacity() != SOURCE_STORE_EXPECTED_PATH_CAPACITY
    file: mutable DebuggerMetadata::SourceFile = zeroed
    file.id <- DebuggerIdentity::debug_id(SOURCE_STORE_FILE_ID)
    file.logical_path <- DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID)
    file.content <- DebuggerIdentity::debug_id(SOURCE_STORE_CONTENT_ID)
    file.line_count <- 1
    file.path_length <- SOURCE_STORE_PATH_LENGTH
    for path_index in 0..<SOURCE_STORE_PATH_LENGTH:
        file.path_bytes[path_index] <- SOURCE_STORE_PATH_BYTES[path_index]
    failure: mutable DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_file(store, file)
    return 2 if not DebuggerErrors::error_is_ok(failure)
    duplicate_path: DebuggerMetadata::SourceFile = file
    duplicate_path.id <- DebuggerIdentity::debug_id(SOURCE_STORE_FILE_ID + 1)
    duplicate_path.logical_path <- DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 1)
    duplicate_path.content <- DebuggerIdentity::debug_id(SOURCE_STORE_CONTENT_ID + 1)
    duplicate_path_failure: DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_file(store, duplicate_path)
    return 12 if DebuggerErrors::error_is_ok(duplicate_path_failure)
    return 3 if DebuggerSourceStore::source_store_find_index(store, file.id) != SOURCE_STORE_FIRST_INDEX
    found_file: DebuggerMetadata::SourceFile = DebuggerSourceStore::source_store_find_file(store, file.id)
    return 14 if found_file.path_length != SOURCE_STORE_PATH_LENGTH or not DebuggerMetadata::source_file_paths_equal(found_file, file)
    invalid_utf8_file: DebuggerMetadata::SourceFile = file
    invalid_utf8_file.id <- DebuggerIdentity::debug_id(SOURCE_STORE_FILE_ID + 2)
    invalid_utf8_file.logical_path <- DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 2)
    invalid_utf8_file.content <- DebuggerIdentity::debug_id(SOURCE_STORE_CONTENT_ID + 2)
    invalid_utf8_file.path_length <- 1
    invalid_utf8_file.path_bytes[0] <- SOURCE_STORE_INVALID_UTF8_BYTE
    return 19 if DebuggerMetadata::source_path_utf8_is_valid(invalid_utf8_file.path_bytes[0], invalid_utf8_file.path_length)
    return 20 if DebuggerMetadata::source_path_utf8_is_valid(invalid_utf8_file.path_bytes[0], SOURCE_STORE_OVERSIZED_PATH_LENGTH)
    invalid_utf8_failure: DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_file(store, invalid_utf8_file)
    return 15 if DebuggerErrors::error_is_ok(invalid_utf8_failure)
    dot_segment_file: DebuggerMetadata::SourceFile = file
    dot_segment_file.id <- DebuggerIdentity::debug_id(SOURCE_STORE_FILE_ID + 3)
    dot_segment_file.logical_path <- DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 3)
    dot_segment_file.content <- DebuggerIdentity::debug_id(SOURCE_STORE_CONTENT_ID + 3)
    dot_segment_file.path_length <- 2
    dot_segment_file.path_bytes[0] <- SOURCE_STORE_DOT_BYTE
    dot_segment_file.path_bytes[1] <- SOURCE_STORE_DOT_BYTE
    dot_segment_failure: DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_file(store, dot_segment_file)
    return 16 if DebuggerErrors::error_is_ok(dot_segment_failure)
    drive_path_file: mutable DebuggerMetadata::SourceFile = file
    drive_path_file.id <- DebuggerIdentity::debug_id(SOURCE_STORE_FILE_ID + 4)
    drive_path_file.logical_path <- DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 4)
    drive_path_file.content <- DebuggerIdentity::debug_id(SOURCE_STORE_CONTENT_ID + 4)
    drive_path_file.path_length <- SOURCE_STORE_DRIVE_PATH_LENGTH
    for path_index in 0..<SOURCE_STORE_DRIVE_PATH_LENGTH:
        drive_path_file.path_bytes[path_index] <- SOURCE_STORE_DRIVE_PATH_BYTES[path_index]
    drive_path_failure: DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_file(store, drive_path_file)
    return 17 if DebuggerErrors::error_is_ok(drive_path_failure)
    unicode_path_file: mutable DebuggerMetadata::SourceFile = file
    unicode_path_file.id <- DebuggerIdentity::debug_id(SOURCE_STORE_FILE_ID + 5)
    unicode_path_file.logical_path <- DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 5)
    unicode_path_file.content <- DebuggerIdentity::debug_id(SOURCE_STORE_CONTENT_ID + 5)
    unicode_path_file.path_length <- SOURCE_STORE_UNICODE_PATH_LENGTH
    for path_index in 0..<SOURCE_STORE_UNICODE_PATH_LENGTH:
        unicode_path_file.path_bytes[path_index] <- SOURCE_STORE_UNICODE_PATH_BYTES[path_index]
    return 21 if not DebuggerMetadata::source_path_utf8_is_valid(unicode_path_file.path_bytes[0], unicode_path_file.path_length)
    unicode_path_failure: DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_file(store, unicode_path_file)
    return 18 if not DebuggerErrors::error_is_ok(unicode_path_failure)
    span: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{file: file.id, start_byte: 0, end_byte: 1, start_line: 1, start_column: 1, end_line: 1, end_column: 2, discriminator: 0}
    function: DebuggerMetadata::FunctionInfo = DebuggerMetadata::FunctionInfo{id: DebuggerIdentity::debug_id(SOURCE_STORE_FUNCTION_ID), source: span, name: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 1), inline_parent: DebuggerIdentity::debug_id(SOURCE_STORE_NO_ID), generic_instance: DebuggerIdentity::debug_id(SOURCE_STORE_NO_ID)}
    failure <- DebuggerSourceStore::source_store_add_function(store, file.id, function)
    return 4 if not DebuggerErrors::error_is_ok(failure)
    found_function: DebuggerMetadata::FunctionInfo = DebuggerSourceStore::source_store_find_function(store, function.id)
    return 5 if found_function.id.value != function.id.value
    invalid_function: DebuggerMetadata::FunctionInfo = function
    invalid_function.source.end_line <- file.line_count.u32() + 1
    invalid_failure: DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_function(store, file.id, invalid_function)
    return 10 if DebuggerErrors::error_is_ok(invalid_failure)
    unnamed_function: DebuggerMetadata::FunctionInfo = function
    unnamed_function.name <- DebuggerIdentity::debug_id(SOURCE_STORE_NO_ID)
    unnamed_failure: DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_function(store, file.id, unnamed_function)
    return 11 if DebuggerErrors::error_is_ok(unnamed_failure)
    mapping: DebuggerSourceStore::PathMapping = DebuggerSourceStore::PathMapping{client_root: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID), server_root: file.id}
    failure <- DebuggerSourceStore::source_store_add_mapping(store, mapping)
    return 6 if not DebuggerErrors::error_is_ok(failure)
    return 7 if DebuggerSourceStore::source_store_resolve_client_file(store, mapping.client_root).value != file.id.value
    invalid_mapping: DebuggerSourceStore::PathMapping = DebuggerSourceStore::PathMapping{client_root: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 10), server_root: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 11)}
    failure <- DebuggerSourceStore::source_store_add_mapping(store, invalid_mapping)
    return 9 if DebuggerErrors::error_is_ok(failure)
    return 8 if not DebuggerSourceStore::source_store_is_valid(store)
    return 0
