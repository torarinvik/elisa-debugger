include "../src/metadata/source_store.elisa"

const SOURCE_STORE_FILE_ID: u64 = 901
const SOURCE_STORE_PATH_ID: u64 = 902
const SOURCE_STORE_CONTENT_ID: u64 = 903
const SOURCE_STORE_FUNCTION_ID: u64 = 904
const SOURCE_STORE_FIRST_INDEX: usize = 0
const SOURCE_STORE_NO_ID: u64 = 0

def main() -> i64:
    store: mutable DebuggerSourceStore::SourceStore = DebuggerSourceStore::source_store_new()
    return 1 if not DebuggerSourceStore::source_store_is_valid(store)
    file: DebuggerMetadata::SourceFile = DebuggerMetadata::SourceFile{id: DebuggerIdentity::debug_id(SOURCE_STORE_FILE_ID), logical_path: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID), content: DebuggerIdentity::debug_id(SOURCE_STORE_CONTENT_ID), line_count: 1, embedded: false}
    failure: mutable DebuggerErrors::DebuggerError = DebuggerSourceStore::source_store_add_file(store, file)
    return 2 if not DebuggerErrors::error_is_ok(failure)
    return 3 if DebuggerSourceStore::source_store_find_index(store, file.id) != SOURCE_STORE_FIRST_INDEX
    span: DebuggerIdentity::SourceSpan = DebuggerIdentity::SourceSpan{file: file.id, start_byte: 0, end_byte: 1, start_line: 1, start_column: 1, end_line: 1, end_column: 2, discriminator: 0}
    function: DebuggerMetadata::FunctionInfo = DebuggerMetadata::FunctionInfo{id: DebuggerIdentity::debug_id(SOURCE_STORE_FUNCTION_ID), source: span, name: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 1), inline_parent: DebuggerIdentity::debug_id(SOURCE_STORE_NO_ID), generic_instance: DebuggerIdentity::debug_id(SOURCE_STORE_NO_ID)}
    failure <- DebuggerSourceStore::source_store_add_function(store, file.id, function)
    return 4 if not DebuggerErrors::error_is_ok(failure)
    found_function: DebuggerMetadata::FunctionInfo = DebuggerSourceStore::source_store_find_function(store, function.id)
    return 5 if found_function.id.value != function.id.value
    mapping: DebuggerSourceStore::PathMapping = DebuggerSourceStore::PathMapping{client_root: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID), server_root: file.id}
    failure <- DebuggerSourceStore::source_store_add_mapping(store, mapping)
    return 6 if not DebuggerErrors::error_is_ok(failure)
    return 7 if DebuggerSourceStore::source_store_resolve_client_file(store, mapping.client_root).value != file.id.value
    invalid_mapping: DebuggerSourceStore::PathMapping = DebuggerSourceStore::PathMapping{client_root: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 10), server_root: DebuggerIdentity::debug_id(SOURCE_STORE_PATH_ID + 11)}
    failure <- DebuggerSourceStore::source_store_add_mapping(store, invalid_mapping)
    return 9 if DebuggerErrors::error_is_ok(failure)
    return 8 if not DebuggerSourceStore::source_store_is_valid(store)
    return 0
