include "../src/engine/state.elisa"

def main() -> i64:
    state: mutable DebuggerManagedState::State = DebuggerManagedState::state_new()
    return 1 if not DebuggerManagedState::state_is_valid(state)
    state.branches.next_id <- 0
    return 2 if DebuggerManagedState::state_is_valid(state)
    return 0
