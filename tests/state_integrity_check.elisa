include "../src/engine/state.elisa"

const module Test:
    const module Reinitialization:
        RESOURCE_COUNT: usize = 1
        RESOURCE_NEXT_HANDLE: u64 = 2
        RESOURCE_EMPTY_COUNT: usize = 0
        RESOURCE_FIRST_HANDLE: u64 = 1
        RESOURCE_LOOKUP_MISS: usize = 16
        WATCHPOINT_COUNT: usize = 1
        WATCHPOINT_NEXT_ID: u64 = 2
        WATCHPOINT_EMPTY_COUNT: usize = 0
        WATCHPOINT_FIRST_ID: u64 = 1
        INVALID_BRANCH_NEXT_ID: u64 = 0
        RESOURCE_PROBE_HANDLE: u64 = 1
    const module Result:
        INITIAL_STATE_INVALID: i64 = 1
        RESOURCE_RESET_INVALID: i64 = 2
        RESOURCE_STALE_ENTRY_VISIBLE: i64 = 3
        WATCHPOINT_RESET_INVALID: i64 = 4
        RESET_STATE_INVALID: i64 = 5
        CORRUPT_BRANCH_ACCEPTED: i64 = 6
        SUCCESS: i64 = 0

def main() -> i64:
    state: mutable DebuggerManagedState::State = zeroed
    DebuggerManagedState::state_initialize(state)
    return Test::Result::INITIAL_STATE_INVALID if not DebuggerManagedState::state_is_valid(state)

    state.resources.count <- Test::Reinitialization::RESOURCE_COUNT
    state.resources.next_handle <- Test::Reinitialization::RESOURCE_NEXT_HANDLE
    state.resources.mode <- DebuggerVirtualResources::ResourceMode.Replaying
    state.watchpoints.count <- Test::Reinitialization::WATCHPOINT_COUNT
    state.watchpoints.next_id <- Test::Reinitialization::WATCHPOINT_NEXT_ID
    DebuggerManagedState::state_initialize(state)

    return Test::Result::RESOURCE_RESET_INVALID if state.resources.count != Test::Reinitialization::RESOURCE_EMPTY_COUNT or state.resources.next_handle != Test::Reinitialization::RESOURCE_FIRST_HANDLE or state.resources.mode != DebuggerVirtualResources::ResourceMode.Recording
    return Test::Result::RESOURCE_STALE_ENTRY_VISIBLE if DebuggerVirtualResources::resources_find(state.resources, DebuggerIdentity::debug_id(Test::Reinitialization::RESOURCE_PROBE_HANDLE)) != Test::Reinitialization::RESOURCE_LOOKUP_MISS
    return Test::Result::WATCHPOINT_RESET_INVALID if state.watchpoints.count != Test::Reinitialization::WATCHPOINT_EMPTY_COUNT or state.watchpoints.next_id != Test::Reinitialization::WATCHPOINT_FIRST_ID or not DebuggerWatchpoints::watchpoints_is_valid(state.watchpoints)
    return Test::Result::RESET_STATE_INVALID if not DebuggerManagedState::state_is_valid(state)

    state.branches.next_id <- Test::Reinitialization::INVALID_BRANCH_NEXT_ID
    return Test::Result::CORRUPT_BRANCH_ACCEPTED if DebuggerManagedState::state_is_valid(state)
    return Test::Result::SUCCESS
