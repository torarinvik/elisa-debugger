include "../src/query/timeline.elisa"
include "../src/core/identity.elisa"
include "../src/core/capabilities.elisa"

def main() -> i64:
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(1))
    exact: DebuggerTimeline::Timeline = DebuggerTimeline::timeline_new(position, DebuggerCapabilities::managed_capabilities())
    observational: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_set_capabilities(exact, DebuggerCapabilities::native_live_capabilities())
    return 1 if not observational.accepted or observational.timeline.bounds.has_exact
    invalid: mutable DebuggerCapabilities::CapabilitySet = DebuggerCapabilities::managed_capabilities()
    invalid.reverse_execution <- true
    invalid.history <- DebuggerCapabilities::HistoryKind.Observational
    rejected: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_set_capabilities(exact, invalid)
    return 2 if rejected.accepted or rejected.failure.code != DebuggerErrors::ErrorCode.InvalidArgument
    return 0
