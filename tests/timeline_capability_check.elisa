include "../src/query/timeline.elisa"
include "../src/core/identity.elisa"
include "../src/core/capabilities.elisa"

def main() -> i64:
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(1))
    observational: DebuggerTimeline::Timeline = DebuggerTimeline::timeline_new(position, DebuggerCapabilities::native_live_capabilities())
    exact: DebuggerTimeline::Timeline = DebuggerTimeline::timeline_new(position, DebuggerCapabilities::managed_capabilities())
    exact_bounds: DebuggerTimeline::HistoryBounds = DebuggerTimeline::history_bounds_new(0)
    rejected: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_set_bounds(observational, exact_bounds)
    return 1 if rejected.accepted
    return 3 + rejected.failure.code.u16().i64() if rejected.failure.code != DebuggerErrors::ErrorCode.Unsupported
    accepted: DebuggerTimeline::TimelineResult = DebuggerTimeline::timeline_set_bounds(exact, exact_bounds)
    return 2 if not accepted.accepted
    return 0
