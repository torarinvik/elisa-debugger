# Focused compile-time coverage for canonical bytes, manifests, and checkpoints.

include "../src/trace/binary.elisa"
include "../src/trace/manifest.elisa"
include "../src/trace/format.elisa"
include "../src/replay/checkpoint.elisa"
include "../src/replay/checkpoint_codec.elisa"
include "../src/vm/edir.elisa"

const module Test:
    const module Binary:
        U16: u16 = 4660
        U32: u32 = 2309737967
        U64: u64 = 1234605616436508552
        EMPTY_ID: u64 = 0
        EMPTY_INDEX: usize = 0
        SHORT_BYTES: usize = 4
        FNV64_EMPTY: u64 = 14695981039346656037
        FNV64_A_STANDARD: u64 = 12638187200555641996
        FNV64_A_LEGACY: u64 = 4953267810257967366
    const module Identity:
        BUILD: u64 = 11
        CHECKPOINT: u64 = 13
        RUNTIME_OFFSET: u64 = 1
        SOURCE_OFFSET: u64 = 2
        TARGET_OFFSET: u64 = 3
        METADATA_VERSION: u32 = 1
    const module Fixture:
        HEADER_SCHEMA: u32 = 1
        FIRST_SEQUENCE: u64 = 1
        FIRST_EVENT: u64 = 1
        SINGLE_BYTE_LENGTH: u64 = 1
        ZERO_CHECKSUM: u64 = 0
        EMPTY_OFFSET: usize = 0
        CHECKSUM_INPUT_BYTE: u8 = 97
        CHUNK_CHECKSUM_INPUT_BYTE: u64 = 65
        CHANGED_SEQUENCE: u64 = 257
        CHANGED_PAYLOAD_LENGTH: u64 = 257
        CHECKPOINT_EVENT: u64 = 0
        INITIAL_STATE_HASH: u64 = 0
    const module Result:
        SUCCESS: i64 = 0
        BINARY_VALIDATION: i64 = 1
        BINARY_U16_DECODE: i64 = 2
        BINARY_U32_DECODE: i64 = 3
        BINARY_U64_DECODE: i64 = 4
        BINARY_READER_STATE: i64 = 5
        MANIFEST_VALID: i64 = 6
        MANIFEST_DECODE: i64 = 7
        MANIFEST_REJECTION: i64 = 8
        CHECKPOINT_VALID: i64 = 9
        CHECKPOINT_DECODE: i64 = 10
        CHECKPOINT_SHORT_INPUT: i64 = 11
        HEADER_SEQUENCE_CHECKSUM: i64 = 12
        HEADER_KIND_CHECKSUM: i64 = 13
        HEADER_LENGTH_CHECKSUM: i64 = 14
        EMPTY_CHECKSUM: i64 = 15
        BYTE_CHECKSUM: i64 = 16
        LEGACY_CHECKSUM: i64 = 17
        READER_REINITIALIZATION: i64 = 18


def build_identity() -> DebuggerIdentity::BuildIdentity:
    return DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::Identity::BUILD), runtime: DebuggerIdentity::debug_id(Test::Identity::BUILD + Test::Identity::RUNTIME_OFFSET), source: DebuggerIdentity::debug_id(Test::Identity::BUILD + Test::Identity::SOURCE_OFFSET), target: DebuggerIdentity::debug_id(Test::Identity::BUILD + Test::Identity::TARGET_OFFSET), metadata_version: Test::Identity::METADATA_VERSION}

def check_binary() -> i64:
    empty: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(empty)
    return Test::Result::EMPTY_CHECKSUM if DebuggerTraceBinary::writer_checksum(empty) != Test::Binary::FNV64_EMPTY
    single: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(single)
    DebuggerTraceBinary::writer_put_byte(single, Test::Fixture::CHECKSUM_INPUT_BYTE)
    return Test::Result::BYTE_CHECKSUM if DebuggerTraceBinary::writer_checksum(single) != Test::Binary::FNV64_A_STANDARD
    return Test::Result::LEGACY_CHECKSUM if not DebuggerTraceBinary::writer_checksum_matches(single, Test::Binary::FNV64_A_LEGACY)
    writer: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(writer)
    DebuggerTraceBinary::writer_put_u16(writer, Test::Binary::U16)
    DebuggerTraceBinary::writer_put_u32(writer, Test::Binary::U32)
    DebuggerTraceBinary::writer_put_u64(writer, Test::Binary::U64)
    return Test::Result::BINARY_VALIDATION if not DebuggerTraceBinary::writer_is_valid(writer)
    reader: mutable DebuggerTraceBinary::ByteReader = zeroed
    DebuggerTraceBinary::reader_initialize(reader, writer.bytes[Test::Binary::EMPTY_INDEX], writer.length)
    return Test::Result::BINARY_U16_DECODE if DebuggerTraceBinary::reader_take_u16(reader) != Test::Binary::U16
    return Test::Result::BINARY_U32_DECODE if DebuggerTraceBinary::reader_take_u32(reader) != Test::Binary::U32
    return Test::Result::BINARY_U64_DECODE if DebuggerTraceBinary::reader_take_u64(reader) != Test::Binary::U64
    return Test::Result::BINARY_READER_STATE if not DebuggerTraceBinary::reader_is_valid(reader) or reader.offset != writer.length
    _ = DebuggerTraceBinary::reader_take_byte(reader)
    DebuggerTraceBinary::reader_initialize(reader, single.bytes[Test::Binary::EMPTY_INDEX], single.length)
    return Test::Result::READER_REINITIALIZATION if reader.offset != Test::Fixture::EMPTY_OFFSET or reader.failed or DebuggerTraceBinary::reader_take_byte(reader) != Test::Fixture::CHECKSUM_INPUT_BYTE or not DebuggerTraceBinary::reader_is_valid(reader)
    return Test::Result::SUCCESS

def check_header_checksum() -> i64:
    first: DebuggerTrace::ChunkHeader = DebuggerTrace::ChunkHeader{schema: Test::Fixture::HEADER_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: Test::Fixture::FIRST_SEQUENCE, first_event: Test::Fixture::FIRST_EVENT, last_event: Test::Fixture::FIRST_EVENT, payload_length: Test::Fixture::SINGLE_BYTE_LENGTH, checksum: Test::Fixture::ZERO_CHECKSUM}
    changed: DebuggerTrace::ChunkHeader = first
    changed.sequence <- Test::Fixture::CHANGED_SEQUENCE
    return Test::Result::HEADER_SEQUENCE_CHECKSUM if DebuggerTrace::trace_chunk_checksum(first, Test::Fixture::CHUNK_CHECKSUM_INPUT_BYTE) == DebuggerTrace::trace_chunk_checksum(changed, Test::Fixture::CHUNK_CHECKSUM_INPUT_BYTE)
    changed.kind <- DebuggerTrace::ChunkKind.Metadata
    return Test::Result::HEADER_KIND_CHECKSUM if DebuggerTrace::trace_chunk_checksum(first, Test::Fixture::CHUNK_CHECKSUM_INPUT_BYTE) == DebuggerTrace::trace_chunk_checksum(changed, Test::Fixture::CHUNK_CHECKSUM_INPUT_BYTE)
    changed.kind <- first.kind
    changed.payload_length <- Test::Fixture::CHANGED_PAYLOAD_LENGTH
    return Test::Result::HEADER_LENGTH_CHECKSUM if DebuggerTrace::trace_chunk_checksum(first, Test::Fixture::CHUNK_CHECKSUM_INPUT_BYTE) == DebuggerTrace::trace_chunk_checksum(changed, Test::Fixture::CHUNK_CHECKSUM_INPUT_BYTE)
    return Test::Result::SUCCESS

def check_manifest() -> i64:
    manifest: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build_identity(), DebuggerTraceManifest::ManifestStatus.Exact)
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    return Test::Result::MANIFEST_VALID if not DebuggerTraceBinary::writer_is_valid(encoded)
    decoded_reader: mutable DebuggerTraceBinary::ByteReader = zeroed
    DebuggerTraceBinary::reader_initialize(decoded_reader, encoded.bytes[Test::Binary::EMPTY_INDEX], encoded.length)
    decoded: DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_decode(decoded_reader)
    return Test::Result::MANIFEST_DECODE if decoded.schema != manifest.schema or decoded.compiler.value != manifest.compiler.value or not DebuggerTraceManifest::manifest_is_replayable(decoded)
    invalid: mutable DebuggerTraceManifest::BundleManifest = decoded
    invalid.runtime <- DebuggerIdentity::debug_id(Test::Binary::EMPTY_ID)
    return Test::Result::MANIFEST_REJECTION if DebuggerTraceManifest::manifest_is_replayable(invalid)
    return Test::Result::SUCCESS

def check_checkpoint() -> i64:
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    snapshot: mutable DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(machine, DebuggerIdentity::debug_id(Test::Identity::CHECKPOINT), Test::Fixture::CHECKPOINT_EVENT, Test::Fixture::INITIAL_STATE_HASH)
    snapshot.state_hash <- DebuggerCheckpoint::snapshot_state_hash(snapshot)
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerCheckpointCodec::checkpoint_encode(snapshot)
    return Test::Result::CHECKPOINT_VALID if not DebuggerTraceBinary::writer_is_valid(encoded)
    reader: mutable DebuggerTraceBinary::ByteReader = zeroed
    DebuggerTraceBinary::reader_initialize(reader, encoded.bytes[Test::Binary::EMPTY_INDEX], encoded.length)
    decoded: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpointCodec::checkpoint_decode(reader)
    validation_reader: mutable DebuggerTraceBinary::ByteReader = zeroed
    DebuggerTraceBinary::reader_initialize(validation_reader, encoded.bytes[Test::Binary::EMPTY_INDEX], encoded.length)
    return Test::Result::CHECKPOINT_DECODE if decoded.id.value != Test::Identity::CHECKPOINT or decoded.state_hash != snapshot.state_hash or not DebuggerCheckpointCodec::checkpoint_bytes_are_valid(validation_reader)
    short_reader: mutable DebuggerTraceBinary::ByteReader = zeroed
    DebuggerTraceBinary::reader_initialize(short_reader, encoded.bytes[Test::Binary::EMPTY_INDEX], Test::Binary::SHORT_BYTES)
    short_snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpointCodec::checkpoint_decode(short_reader)
    return Test::Result::CHECKPOINT_SHORT_INPUT if short_snapshot.id.value != Test::Binary::EMPTY_ID
    return Test::Result::SUCCESS

def main() -> i64:
    return check_binary() if check_binary() != Test::Result::SUCCESS
    return check_manifest() if check_manifest() != Test::Result::SUCCESS
    return check_checkpoint() if check_checkpoint() != Test::Result::SUCCESS
    return check_header_checksum() if check_header_checksum() != Test::Result::SUCCESS
    return Test::Result::SUCCESS
