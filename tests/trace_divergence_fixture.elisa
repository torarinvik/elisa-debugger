# Test infrastructure: emit a structurally valid artifact whose last canonical
# event disagrees with deterministic execution. The real clients must report
# replay divergence, rather than treating a transport checksum as execution proof.

include "../src/trace/file_reader.elisa"
include "../src/trace/recorder.elisa"
include "../src/trace/pipeline.elisa"
include "../src/trace/export.elisa"
include "../src/trace/file.elisa"

const module Test:
    SOURCE: cstr = "build/dap-trace-effects.eltr"
    SOURCE_LENGTH: usize = 28
    DESTINATION: cstr = "build/replay-divergence.eltr"
    DESTINATION_LENGTH: usize = 28
    FIRST: usize = 0
    INCREMENT: usize = 1
    CHECKPOINT_COUNT: usize = 1
    OK: i64 = 0
    LOAD: i64 = 1
    APPEND: i64 = 2
    EXPORT: i64 = 3
    WRITE: i64 = 4

def create_fixture(reader: mutable DebuggerTraceReader::TraceReader&) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    return Test::LOAD if reader.event_count == Test::FIRST or reader.full_checkpoint_count != Test::CHECKPOINT_COUNT
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = reader.full_checkpoints[Test::FIRST]
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = zeroed
    DebuggerTraceRecorder::recorder_initialize(recorder, checkpoint.build, checkpoint.recording)
    last: usize = reader.event_count - Test::INCREMENT
    reader.events[last].state_hash <- reader.events[last].state_hash ^ Test::INCREMENT.u64()
    for index in Test::FIRST..<reader.event_count:
        failure: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(recorder, reader.events[index])
        return Test::APPEND if not DebuggerErrors::error_is_ok(failure)
    failure: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append_checkpoint(recorder, checkpoint)
    return Test::APPEND if not DebuggerErrors::error_is_ok(failure)
    built: DebuggerTracePipeline::BundleBuildResult = DebuggerTracePipeline::bundle_from_recorder(recorder) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
    return Test::EXPORT if not built.accepted
    bundle: mutable heap DebuggerTraceBundle::TraceBundle& = DebuggerTracePipeline::bundle_build_result_bundle(built) can Abort.Panic
    exported: DebuggerTraceExport::ExportResult = DebuggerTraceExport::export_bundle(bundle) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
    DebuggerTraceBundle::bundle_destroy(bundle) can Memory.Release, Unsafe.PointerCast
    return Test::EXPORT if not DebuggerErrors::error_is_ok(exported.failure)
    written: DebuggerTraceFile::WriteResult = DebuggerTraceFile::trace_file_write(Test::DESTINATION.cast[u8&], Test::DESTINATION_LENGTH, exported.bytes.bytes[Test::FIRST], exported.bytes.length) can Blocking.IO, Unsafe.PointerCast
    return Test::OK if written.accepted else Test::WRITE

def main() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    loaded: mutable DebuggerTraceFileReader::LoadResult = DebuggerTraceFileReader::trace_file_reader_load(Test::SOURCE.cast[u8&], Test::SOURCE_LENGTH) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
    return Test::LOAD if not loaded.accepted
    reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceFileReader::trace_file_reader_result_reader(loaded) can Abort.Panic
    result: i64 = create_fixture(reader) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
    DebuggerTraceFileReader::trace_file_reader_result_destroy(loaded) can Memory.Release, Unsafe.PointerCast
    return result
