# Bounded on-disk trace round trip and torn-footer recovery classification.

include "../src/trace/file.elisa"
include "../src/trace/binary.elisa"
include "../src/trace/recorder.elisa"
include "../src/trace/pipeline.elisa"
include "../src/trace/export.elisa"
include "../src/trace/file_reader.elisa"

extern creat(path: cstr, mode: u32) -> i32 can[Blocking.IO]
extern close(fd: i32) -> i32 can[Blocking.IO]
extern write(fd: i32, buffer: void&, count: usize) -> isize can[Blocking.IO]

const module Test:
    BUILD_COMPILER_ID: u64 = 401
    BUILD_RUNTIME_ID: u64 = 402
    BUILD_SOURCE_ID: u64 = 403
    BUILD_TARGET_ID: u64 = 404
    BUILD_METADATA_VERSION: u32 = 1
    RECORDING_ID: u64 = 405
    EVENT_SCHEMA: u32 = 3
    FIRST_EVENT: u64 = 0
    EVENT_HASH: u64 = 406
    ALTERNATE_EVENT_HASH: u64 = 407
    PATH_BUFFER_CAPACITY: usize = 64
    EXPECTED_MAX_PATH_BYTES: usize = 1024
    FIRST_BYTE_INDEX: usize = 0
    BYTE_INCREMENT: usize = 1
    PATH_NUL: u8 = 0
    FILE_MODE_OWNER_READ_WRITE: u32 = 384
    FILE_OPEN_FAILURE: i32 = -1
    FILE_CLOSE_FAILURE: i32 = -1
    WRITE_FAILURE: isize = -1
    WRITE_NO_PROGRESS: isize = 0
    FIRST_WRITE_OFFSET: usize = 0
    EVENT_COUNT: usize = 1
    MINIMUM_TRACE_BYTES: usize = 1

const module TestPaths:
    VALID_TRACE: cstr = "build/trace-file-roundtrip.eltr"
    TRUNCATED_TRACE: cstr = "build/trace-file-truncated.eltr"
    MISSING_TRACE: cstr = "/__elisa_debugger_trace_file_missing__/trace.eltr"
    DIRECTORY_TARGET: cstr = "build"
    PARENT_TRACE: cstr = "build/../trace-file-parent.eltr"

const module TestResult:
    OK: i64 = 0
    LIMITS: i64 = 1
    RECORD: i64 = 2
    BUNDLE: i64 = 3
    EXPORT: i64 = 4
    WRITE: i64 = 5
    READ: i64 = 6
    OPEN_FAILURE: i64 = 7
    ROUND_TRIP_BYTES: i64 = 8
    SMALL_BUFFER: i64 = 9
    TRUNCATED_SETUP: i64 = 10
    TRUNCATED_READ: i64 = 11
    PREFLIGHT: i64 = 12
    PRESERVED_FILE: i64 = 13
    ALTERNATE_TRACE: i64 = 14
    PARTIAL_WRITE_INJECTION: i64 = 15
    PARTIAL_WRITE_PRESERVATION: i64 = 16
    COMMIT_INJECTION: i64 = 17
    COMMIT_PRESERVATION: i64 = 18
    PATH_TRAVERSAL: i64 = 19
    FILE_READER: i64 = 20
    TRUNCATED_FILE_READER: i64 = 21
    CREATE_FAILURE: i64 = 22
    RENAME_FAILURE: i64 = 23

def build_identity() -> DebuggerIdentity::BuildIdentity:
    return DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER_ID),
        runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME_ID),
        source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE_ID),
        target: DebuggerIdentity::debug_id(Test::BUILD_TARGET_ID),
        metadata_version: Test::BUILD_METADATA_VERSION
    }

def copy_path(source: cstr, output: mutable u8&) -> usize:
    length: mutable usize = Test::FIRST_BYTE_INDEX
    while length < Test::PATH_BUFFER_CAPACITY:
        byte: u8 = source[length].u8()
        break if byte == Test::PATH_NUL
        output[length] <- byte
        length <- length + Test::BYTE_INCREMENT
    return length

def write_prefix(fd: i32, bytes: u8&, length: usize) -> bool can[Blocking.IO, Unsafe.PointerCast]:
    offset: mutable usize = Test::FIRST_WRITE_OFFSET
    while offset < length:
        written: isize = write(fd, (&bytes[offset]).cast[void&], length - offset) can Blocking.IO, Unsafe.PointerCast
        return false if written <= Test::WRITE_NO_PROGRESS or written == Test::WRITE_FAILURE
        return false if written.usize() > length - offset
        offset <- offset + written.usize()
    return true

def write_truncated_fixture(path: u8&, path_length: usize, bytes: u8&, length: usize) -> bool can[Blocking.IO, Unsafe.PointerCast]:
    terminated_path: mutable u8[Test::PATH_BUFFER_CAPACITY + Test::BYTE_INCREMENT] = zeroed
    for index in Test::FIRST_BYTE_INDEX..<path_length:
        terminated_path[index] <- path[index]
    terminated_path[path_length] <- Test::PATH_NUL
    descriptor: i32 = creat((&terminated_path[Test::FIRST_BYTE_INDEX]).cast[cstr], Test::FILE_MODE_OWNER_READ_WRITE) can Blocking.IO, Unsafe.PointerCast
    return false if descriptor == Test::FILE_OPEN_FAILURE
    written: bool = write_prefix(descriptor, bytes, length) can Blocking.IO, Unsafe.PointerCast
    close_status: i32 = close(descriptor) can Blocking.IO
    return written and close_status != Test::FILE_CLOSE_FAILURE

def main() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    return TestResult::LIMITS if DebuggerTraceFileLimits::PATH_CAPACITY_BYTES != Test::EXPECTED_MAX_PATH_BYTES or DebuggerTraceFileLimits::MAX_FILE_BYTES != DebuggerTraceStorageLimits::MAX_FILE_BYTES

    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING_ID))
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::RECORDING_ID))
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::EVENT_SCHEMA, Test::FIRST_EVENT, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_HASH)
    return TestResult::RECORD if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    built: DebuggerTracePipeline::BundleBuildResult = DebuggerTracePipeline::bundle_from_recorder(recorder)
    return TestResult::BUNDLE if not built.accepted
    bundle: mutable heap DebuggerTraceBundle::TraceBundle& = DebuggerTracePipeline::bundle_build_result_bundle(built) can Abort.Panic
    exported: DebuggerTraceExport::ExportResult = DebuggerTraceExport::export_bundle(bundle) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
    DebuggerTraceBundle::bundle_destroy(bundle) can Memory.Release, Unsafe.PointerCast
    return TestResult::EXPORT if not DebuggerErrors::error_is_ok(exported.failure) or not DebuggerTraceBinary::writer_is_valid(exported.bytes)
    return TestResult::EXPORT if exported.bytes.length <= Test::MINIMUM_TRACE_BYTES or exported.chunk_count != Test::EVENT_COUNT

    valid_path: mutable u8[Test::PATH_BUFFER_CAPACITY] = zeroed
    valid_path_length: usize = copy_path(TestPaths::VALID_TRACE, valid_path[Test::FIRST_BYTE_INDEX])
    read_buffer: mutable u8[DebuggerTraceFileLimits::MAX_FILE_BYTES] = zeroed
    missing_path: mutable u8[Test::PATH_BUFFER_CAPACITY] = zeroed
    missing_path_length: usize = copy_path(TestPaths::MISSING_TRACE, missing_path[Test::FIRST_BYTE_INDEX])
    missing: DebuggerTraceFile::ReadResult = DebuggerTraceFile::trace_file_read(missing_path[Test::FIRST_BYTE_INDEX], missing_path_length, read_buffer[Test::FIRST_BYTE_INDEX], DebuggerTraceFileLimits::MAX_FILE_BYTES) can Blocking.IO, Unsafe.PointerCast
    return TestResult::OPEN_FAILURE if missing.status != DebuggerTraceFile::FileStatus.OpenFailure
    missing_write: DebuggerTraceFile::WriteResult = DebuggerTraceFile::trace_file_write(missing_path[Test::FIRST_BYTE_INDEX], missing_path_length, exported.bytes.bytes[Test::FIRST_BYTE_INDEX], exported.bytes.length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::CREATE_FAILURE if missing_write.accepted or missing_write.status != DebuggerTraceFile::FileStatus.OpenFailure

    directory_path: mutable u8[Test::PATH_BUFFER_CAPACITY] = zeroed
    directory_path_length: usize = copy_path(TestPaths::DIRECTORY_TARGET, directory_path[Test::FIRST_BYTE_INDEX])
    directory_write: DebuggerTraceFile::WriteResult = DebuggerTraceFile::trace_file_write(directory_path[Test::FIRST_BYTE_INDEX], directory_path_length, exported.bytes.bytes[Test::FIRST_BYTE_INDEX], exported.bytes.length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::RENAME_FAILURE if directory_write.accepted or directory_write.status != DebuggerTraceFile::FileStatus.CommitFailure

    written: DebuggerTraceFile::WriteResult = DebuggerTraceFile::trace_file_write(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, exported.bytes.bytes[Test::FIRST_BYTE_INDEX], exported.bytes.length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::WRITE if not written.accepted or written.status != DebuggerTraceFile::FileStatus.Ready or not written.scan.footer_verified

    loaded: DebuggerTraceFile::ReadResult = DebuggerTraceFile::trace_file_read(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, read_buffer[Test::FIRST_BYTE_INDEX], DebuggerTraceFileLimits::MAX_FILE_BYTES) can Blocking.IO, Unsafe.PointerCast
    return TestResult::READ if not loaded.accepted or loaded.status != DebuggerTraceFile::FileStatus.Ready or loaded.bytes_read != exported.bytes.length or not loaded.scan.footer_verified
    for index in Test::FIRST_BYTE_INDEX..<loaded.bytes_read:
        return TestResult::ROUND_TRIP_BYTES if read_buffer[index] != exported.bytes.bytes[index]

    imported: DebuggerTraceFileReader::LoadResult = DebuggerTraceFileReader::trace_file_reader_load(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
    return TestResult::FILE_READER if not imported.accepted or imported.reader == null
    imported_reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceFileReader::trace_file_reader_result_reader(imported) can Abort.Panic
    return TestResult::FILE_READER if not DebuggerTraceReader::reader_is_exact(imported_reader) or imported_reader.event_count != Test::EVENT_COUNT or imported_reader.recording.value != Test::RECORDING_ID
    DebuggerTraceFileReader::trace_file_reader_result_destroy(imported) can Memory.Release, Unsafe.PointerCast

    too_small: DebuggerTraceFile::ReadResult = DebuggerTraceFile::trace_file_read(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, read_buffer[Test::FIRST_BYTE_INDEX], exported.bytes.length - Test::BYTE_INCREMENT) can Blocking.IO, Unsafe.PointerCast
    return TestResult::SMALL_BUFFER if too_small.status != DebuggerTraceFile::FileStatus.TooLarge or too_small.bytes_read != exported.bytes.length - Test::BYTE_INCREMENT

    truncated_path: mutable u8[Test::PATH_BUFFER_CAPACITY] = zeroed
    truncated_path_length: usize = copy_path(TestPaths::TRUNCATED_TRACE, truncated_path[Test::FIRST_BYTE_INDEX])
    truncated_length: usize = exported.bytes.length - DebuggerTraceStorageLimits::FOOTER_BYTES
    return TestResult::TRUNCATED_SETUP if truncated_length <= Test::MINIMUM_TRACE_BYTES or not write_truncated_fixture(truncated_path[Test::FIRST_BYTE_INDEX], truncated_path_length, exported.bytes.bytes[Test::FIRST_BYTE_INDEX], truncated_length) can Blocking.IO, Unsafe.PointerCast
    truncated: DebuggerTraceFile::ReadResult = DebuggerTraceFile::trace_file_read(truncated_path[Test::FIRST_BYTE_INDEX], truncated_path_length, read_buffer[Test::FIRST_BYTE_INDEX], DebuggerTraceFileLimits::MAX_FILE_BYTES) can Blocking.IO, Unsafe.PointerCast
    return TestResult::TRUNCATED_READ if truncated.accepted or truncated.status != DebuggerTraceFile::FileStatus.TruncatedTrace or truncated.bytes_read != truncated_length or truncated.scan.verified_chunks == Test::FIRST_BYTE_INDEX or truncated.scan.footer_verified
    truncated_import: DebuggerTraceFileReader::LoadResult = DebuggerTraceFileReader::trace_file_reader_load(truncated_path[Test::FIRST_BYTE_INDEX], truncated_path_length) can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
    return TestResult::TRUNCATED_FILE_READER if truncated_import.accepted or truncated_import.reader != null

    preflight: DebuggerTraceFile::WriteResult = DebuggerTraceFile::trace_file_write(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, exported.bytes.bytes[Test::FIRST_BYTE_INDEX], truncated_length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PREFLIGHT if preflight.accepted or preflight.status != DebuggerTraceFile::FileStatus.TruncatedTrace
    preserved: DebuggerTraceFile::ReadResult = DebuggerTraceFile::trace_file_read(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, read_buffer[Test::FIRST_BYTE_INDEX], DebuggerTraceFileLimits::MAX_FILE_BYTES) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PRESERVED_FILE if not preserved.accepted or preserved.bytes_read != exported.bytes.length or not preserved.scan.footer_verified
    for index in Test::FIRST_BYTE_INDEX..<preserved.bytes_read:
        return TestResult::PRESERVED_FILE if read_buffer[index] != exported.bytes.bytes[index]

    alternate_recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(alternate_recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING_ID))
    alternate_event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::EVENT_SCHEMA, Test::FIRST_EVENT, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::ALTERNATE_EVENT_HASH)
    return TestResult::ALTERNATE_TRACE if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(alternate_recorder, alternate_event))
    alternate_bundle: DebuggerTracePipeline::BundleBuildResult = DebuggerTracePipeline::bundle_from_recorder(alternate_recorder)
    return TestResult::ALTERNATE_TRACE if not alternate_bundle.accepted
    alternate_bundle_handle: mutable heap DebuggerTraceBundle::TraceBundle& = DebuggerTracePipeline::bundle_build_result_bundle(alternate_bundle) can Abort.Panic
    alternate_export: DebuggerTraceExport::ExportResult = DebuggerTraceExport::export_bundle(alternate_bundle_handle) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast
    DebuggerTraceBundle::bundle_destroy(alternate_bundle_handle) can Memory.Release, Unsafe.PointerCast
    return TestResult::ALTERNATE_TRACE if not DebuggerErrors::error_is_ok(alternate_export.failure) or not DebuggerTraceBinary::writer_is_valid(alternate_export.bytes)
    return TestResult::ALTERNATE_TRACE if alternate_export.bytes.length != exported.bytes.length
    alternate_differs: mutable bool = false
    for index in Test::FIRST_BYTE_INDEX..<exported.bytes.length:
        alternate_differs <- true if alternate_export.bytes.bytes[index] != exported.bytes.bytes[index]
    return TestResult::ALTERNATE_TRACE if not alternate_differs

    partial_failure: DebuggerTraceFile::WriteResult = DebuggerTraceFile::TestSupport::trace_file_write_with_failure_injection(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, alternate_export.bytes.bytes[Test::FIRST_BYTE_INDEX], alternate_export.bytes.length, DebuggerTraceFile::TestSupport::FailurePoint.AfterPartialWrite) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PARTIAL_WRITE_INJECTION if partial_failure.accepted or partial_failure.status != DebuggerTraceFile::FileStatus.WriteFailure
    after_partial_failure: DebuggerTraceFile::ReadResult = DebuggerTraceFile::trace_file_read(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, read_buffer[Test::FIRST_BYTE_INDEX], DebuggerTraceFileLimits::MAX_FILE_BYTES) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PARTIAL_WRITE_PRESERVATION if not after_partial_failure.accepted or after_partial_failure.bytes_read != exported.bytes.length
    for index in Test::FIRST_BYTE_INDEX..<after_partial_failure.bytes_read:
        return TestResult::PARTIAL_WRITE_PRESERVATION if read_buffer[index] != exported.bytes.bytes[index]

    commit_failure: DebuggerTraceFile::WriteResult = DebuggerTraceFile::TestSupport::trace_file_write_with_failure_injection(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, alternate_export.bytes.bytes[Test::FIRST_BYTE_INDEX], alternate_export.bytes.length, DebuggerTraceFile::TestSupport::FailurePoint.BeforeCommit) can Blocking.IO, Unsafe.PointerCast
    return TestResult::COMMIT_INJECTION if commit_failure.accepted or commit_failure.status != DebuggerTraceFile::FileStatus.CommitFailure
    after_commit_failure: DebuggerTraceFile::ReadResult = DebuggerTraceFile::trace_file_read(valid_path[Test::FIRST_BYTE_INDEX], valid_path_length, read_buffer[Test::FIRST_BYTE_INDEX], DebuggerTraceFileLimits::MAX_FILE_BYTES) can Blocking.IO, Unsafe.PointerCast
    return TestResult::COMMIT_PRESERVATION if not after_commit_failure.accepted or after_commit_failure.bytes_read != exported.bytes.length
    for index in Test::FIRST_BYTE_INDEX..<after_commit_failure.bytes_read:
        return TestResult::COMMIT_PRESERVATION if read_buffer[index] != exported.bytes.bytes[index]

    parent_path: mutable u8[Test::PATH_BUFFER_CAPACITY] = zeroed
    parent_path_length: usize = copy_path(TestPaths::PARENT_TRACE, parent_path[Test::FIRST_BYTE_INDEX])
    parent_write: DebuggerTraceFile::WriteResult = DebuggerTraceFile::trace_file_write(parent_path[Test::FIRST_BYTE_INDEX], parent_path_length, exported.bytes.bytes[Test::FIRST_BYTE_INDEX], exported.bytes.length) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PATH_TRAVERSAL if parent_write.accepted or parent_write.status != DebuggerTraceFile::FileStatus.InvalidPath
    parent_read: DebuggerTraceFile::ReadResult = DebuggerTraceFile::trace_file_read(parent_path[Test::FIRST_BYTE_INDEX], parent_path_length, read_buffer[Test::FIRST_BYTE_INDEX], DebuggerTraceFileLimits::MAX_FILE_BYTES) can Blocking.IO, Unsafe.PointerCast
    return TestResult::PATH_TRAVERSAL if parent_read.accepted or parent_read.status != DebuggerTraceFile::FileStatus.InvalidPath
    return TestResult::OK
