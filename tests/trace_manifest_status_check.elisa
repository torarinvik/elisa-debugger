# Partial and observational manifests remain valid storage metadata while
# exact replay eligibility stays a separate predicate.

include "../src/trace/binary.elisa"
include "../src/trace/manifest.elisa"
include "../src/trace/storage.elisa"
include "../src/trace/verify.elisa"

const module Test:
    ID: u64 = 41
    SCHEMA: u32 = 1
    MANIFEST_SEQUENCE: u64 = 0
    EVENT_SEQUENCE: u64 = 1
    NEXT_SEQUENCE: u64 = 2
    EVENT_QUALITY_OFFSET: usize = 74
    EVENT_QUALITY_HIGH_BYTE_OFFSET: usize = 75
    EVENT_BRANCH_OFFSET: usize = 28
    PARTIAL_QUALITY_LOW_BYTE: u8 = 1
    PARTIAL_QUALITY_HIGH_BYTE: u8 = 0
    NON_ROOT_BRANCH_LOW_BYTE: u8 = 1
    NONEXACT_EVENT_RESULT: i64 = 5
    NON_ROOT_BRANCH_RESULT: i64 = 6


def build_identity() -> DebuggerIdentity::BuildIdentity:
    return DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::ID), runtime: DebuggerIdentity::debug_id(Test::ID + 1), source: DebuggerIdentity::debug_id(Test::ID + 2), target: DebuggerIdentity::debug_id(Test::ID + 3), metadata_version: 1}

def main() -> i64:
    manifest: mutable DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build_identity(), DebuggerTraceManifest::ManifestStatus.Partial)
    manifest.checkpoint_count <- 0
    manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    return 1 if not DebuggerTraceManifest::manifest_is_well_formed(manifest) or DebuggerTraceManifest::manifest_is_replayable(manifest)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: 0, payload_length: manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_bytes)}
    chunk.payload_length <- manifest_bytes.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(manifest_bytes)
    for index in 0..<manifest_bytes.length:
        chunk.payload[index] <- manifest_bytes.bytes[index]
    encoded_chunk: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(chunk)
    combined: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(combined)
    for index in 0..<encoded_chunk.length:
        DebuggerTraceBinary::writer_put_byte(combined, encoded_chunk.bytes[index])
    event_payload: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(event_payload)
    DebuggerTraceBinary::writer_put_u32(event_payload, Test::SCHEMA)
    DebuggerTraceBinary::writer_put_u64(event_payload, 0)
    DebuggerTraceBinary::writer_put_u64(event_payload, 1)
    DebuggerTraceBinary::writer_put_u64(event_payload, Test::ID)
    DebuggerTraceBinary::writer_put_u64(event_payload, 0)
    DebuggerTraceBinary::writer_put_u64(event_payload, 0)
    DebuggerTraceBinary::writer_put_u64(event_payload, 1)
    DebuggerTraceBinary::writer_put_u64(event_payload, 1)
    DebuggerTraceBinary::writer_put_u64(event_payload, 1)
    DebuggerTraceBinary::writer_put_u32(event_payload, 0)
    DebuggerTraceBinary::writer_put_u16(event_payload, 0)
    DebuggerTraceBinary::writer_put_u16(event_payload, 0)
    DebuggerTraceBinary::writer_put_u64(event_payload, 0)
    event_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    event_chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: 1, first_event: 0, last_event: 0, payload_length: event_payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(event_payload)}
    event_chunk.payload_length <- event_payload.length
    event_chunk.checksum <- DebuggerTraceBinary::writer_checksum(event_payload)
    for index in 0..<event_payload.length:
        event_chunk.payload[index] <- event_payload.bytes[index]
    encoded_event_chunk: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(event_chunk)
    for index in 0..<encoded_event_chunk.length:
        DebuggerTraceBinary::writer_put_byte(combined, encoded_event_chunk.bytes[index])
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(2, 0)
    for index in 0..<footer.length:
        DebuggerTraceBinary::writer_put_byte(combined, footer.bytes[index])
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(combined.bytes[0], combined.length)
    return 2 if scan.status != DebuggerTraceStorage::StorageStatus.Ready or not scan.footer_verified or not scan.manifest_seen or scan.manifest_exact or not scan.event_chunk_seen
    report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(combined.bytes[0], combined.length)
    return 3 if report.state != DebuggerTraceVerify::VerificationState.Partial or report.replayable
    manifest.status <- DebuggerTraceManifest::ManifestStatus.Observational
    return 4 if not DebuggerTraceManifest::manifest_is_well_formed(manifest) or DebuggerTraceManifest::manifest_is_replayable(manifest)
    manifest.status <- DebuggerTraceManifest::ManifestStatus.Exact
    exact_manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    exact_manifest_chunk: mutable DebuggerTraceStorage::StoredChunk = chunk
    exact_manifest_chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: Test::MANIFEST_SEQUENCE, first_event: manifest.first_event, last_event: manifest.last_event, payload_length: exact_manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(exact_manifest_bytes)}
    exact_manifest_chunk.payload_length <- exact_manifest_bytes.length
    exact_manifest_chunk.checksum <- DebuggerTraceBinary::writer_checksum(exact_manifest_bytes)
    for index in 0..<exact_manifest_bytes.length:
        exact_manifest_chunk.payload[index] <- exact_manifest_bytes.bytes[index]
    encoded_exact_manifest: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(exact_manifest_chunk)
    partial_event_payload: mutable DebuggerTraceBinary::ByteWriter = event_payload
    partial_event_payload.bytes[Test::EVENT_QUALITY_OFFSET] <- Test::PARTIAL_QUALITY_LOW_BYTE
    partial_event_payload.bytes[Test::EVENT_QUALITY_HIGH_BYTE_OFFSET] <- Test::PARTIAL_QUALITY_HIGH_BYTE
    partial_event_chunk: mutable DebuggerTraceStorage::StoredChunk = event_chunk
    partial_event_chunk.header.sequence <- Test::EVENT_SEQUENCE
    partial_event_chunk.header.checksum <- DebuggerTraceBinary::writer_checksum(partial_event_payload)
    partial_event_chunk.checksum <- DebuggerTraceBinary::writer_checksum(partial_event_payload)
    for index in 0..<partial_event_payload.length:
        partial_event_chunk.payload[index] <- partial_event_payload.bytes[index]
    encoded_partial_event: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(partial_event_chunk)
    exact_claim_bytes: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(exact_claim_bytes)
    for index in 0..<encoded_exact_manifest.length:
        DebuggerTraceBinary::writer_put_byte(exact_claim_bytes, encoded_exact_manifest.bytes[index])
    for index in 0..<encoded_partial_event.length:
        DebuggerTraceBinary::writer_put_byte(exact_claim_bytes, encoded_partial_event.bytes[index])
    exact_claim_footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(Test::NEXT_SEQUENCE, manifest.last_event)
    for index in 0..<exact_claim_footer.length:
        DebuggerTraceBinary::writer_put_byte(exact_claim_bytes, exact_claim_footer.bytes[index])
    exact_claim_scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(exact_claim_bytes.bytes[0], exact_claim_bytes.length)
    return Test::NONEXACT_EVENT_RESULT if exact_claim_scan.status != DebuggerTraceStorage::StorageStatus.Ready or exact_claim_scan.event_qualities_exact
    exact_claim_report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(exact_claim_bytes.bytes[0], exact_claim_bytes.length)
    return Test::NONEXACT_EVENT_RESULT if exact_claim_report.state != DebuggerTraceVerify::VerificationState.Partial or exact_claim_report.replayable

    non_root_event_payload: mutable DebuggerTraceBinary::ByteWriter = event_payload
    non_root_event_payload.bytes[Test::EVENT_BRANCH_OFFSET] <- Test::NON_ROOT_BRANCH_LOW_BYTE
    non_root_event_chunk: mutable DebuggerTraceStorage::StoredChunk = event_chunk
    non_root_event_chunk.header.sequence <- Test::EVENT_SEQUENCE
    non_root_event_chunk.header.checksum <- DebuggerTraceBinary::writer_checksum(non_root_event_payload)
    non_root_event_chunk.checksum <- DebuggerTraceBinary::writer_checksum(non_root_event_payload)
    for index in 0..<non_root_event_payload.length:
        non_root_event_chunk.payload[index] <- non_root_event_payload.bytes[index]
    encoded_non_root_event: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(non_root_event_chunk)
    non_root_branch_bytes: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(non_root_branch_bytes)
    for index in 0..<encoded_exact_manifest.length:
        DebuggerTraceBinary::writer_put_byte(non_root_branch_bytes, encoded_exact_manifest.bytes[index])
    for index in 0..<encoded_non_root_event.length:
        DebuggerTraceBinary::writer_put_byte(non_root_branch_bytes, encoded_non_root_event.bytes[index])
    non_root_branch_footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(Test::NEXT_SEQUENCE, manifest.last_event)
    for index in 0..<non_root_branch_footer.length:
        DebuggerTraceBinary::writer_put_byte(non_root_branch_bytes, non_root_branch_footer.bytes[index])
    non_root_branch_scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(non_root_branch_bytes.bytes[0], non_root_branch_bytes.length)
    return Test::NON_ROOT_BRANCH_RESULT if non_root_branch_scan.status != DebuggerTraceStorage::StorageStatus.Ready or not non_root_branch_scan.footer_verified or non_root_branch_scan.event_branches_root
    non_root_branch_report: DebuggerTraceVerify::VerificationReport = DebuggerTraceVerify::verify_storage(non_root_branch_bytes.bytes[0], non_root_branch_bytes.length)
    return Test::NON_ROOT_BRANCH_RESULT if non_root_branch_report.state != DebuggerTraceVerify::VerificationState.Partial or non_root_branch_report.replayable
    return 0
