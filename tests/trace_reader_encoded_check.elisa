include "../src/trace/binary.elisa"
include "../src/trace/storage.elisa"
include "../src/trace/manifest.elisa"
include "../src/trace/recorder.elisa"
include "../src/trace/reader.elisa"
include "../src/core/events.elisa"
include "../src/core/identity.elisa"
include "../src/core/errors.elisa"

const BUILD_COMPILER: u64 = 51
const BUILD_RUNTIME: u64 = 52
const BUILD_SOURCE: u64 = 53
const BUILD_TARGET: u64 = 54
const RECORDING_ID: u64 = 55
const EVENT_PAYLOAD_HASH: u64 = 56
const TRACE_SCHEMA: u32 = 1
const TRUNCATION: usize = 1
const CORRUPTION: u8 = 1
const MAX_EVENT_MANIFEST_SEQUENCE: u64 = 0
const MAX_EVENT_ORDINAL: u64 = 18446744073709551615
const MAX_EVENT_CHUNK_SEQUENCE: u64 = 1
const MAX_EVENT_NEXT_CHUNK_SEQUENCE: u64 = 2
const TEST_ROOT_BRANCH: u64 = 0
const TEST_NON_ROOT_BRANCH: u64 = 1
const NON_ROOT_BRANCH_READER_RESULT: i64 = 16
const NON_ROOT_BRANCH_STORAGE_RESULT: i64 = 17
const NON_ROOT_BRANCH_STATE_RESULT: i64 = 18
const TEST_LEGACY_HASH_OFFSET_BASIS: u64 = 1469598103934665603
const TEST_HASH_PRIME: u64 = 1099511628211

def test_legacy_checksum(bytes: u8&, length: usize) -> u64:
    checksum: mutable u64 = TEST_LEGACY_HASH_OFFSET_BASIS
    for index in 0..<length:
        checksum <- (checksum ^ bytes[index].u64()) * TEST_HASH_PRIME
    return checksum

def build_identity() -> DebuggerIdentity::BuildIdentity:
    return DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(BUILD_COMPILER),
        runtime: DebuggerIdentity::debug_id(BUILD_RUNTIME),
        source: DebuggerIdentity::debug_id(BUILD_SOURCE),
        target: DebuggerIdentity::debug_id(BUILD_TARGET),
        metadata_version: 1
    }

def manifest_encoded(recorder: DebuggerTraceRecorder::TraceRecorder) -> DebuggerTraceBinary::ByteWriter:
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(recorder.manifest)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{
        schema: TRACE_SCHEMA,
        kind: DebuggerTrace::ChunkKind.Manifest,
        sequence: 0,
        first_event: recorder.manifest.first_event,
        last_event: recorder.manifest.last_event,
        payload_length: payload.length.u64(),
        checksum: DebuggerTraceBinary::writer_checksum(payload)
    }
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return DebuggerTraceStorage::storage_encode_chunk(chunk)

def max_event_manifest_chunk() -> DebuggerTraceStorage::StoredChunk:
    manifest: mutable DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build_identity(), DebuggerTraceManifest::ManifestStatus.Exact)
    manifest.first_event <- MAX_EVENT_ORDINAL
    manifest.last_event <- MAX_EVENT_ORDINAL
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: TRACE_SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: MAX_EVENT_MANIFEST_SEQUENCE, first_event: MAX_EVENT_ORDINAL, last_event: MAX_EVENT_ORDINAL, payload_length: payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(payload)}
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def max_event_chunk(sequence: u64, branch_id: u64) -> DebuggerTraceStorage::StoredChunk:
    position: mutable DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(RECORDING_ID))
    position.branch <- DebuggerIdentity::debug_id(branch_id)
    position.event <- MAX_EVENT_ORDINAL
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(TRACE_SCHEMA, MAX_EVENT_ORDINAL, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, EVENT_PAYLOAD_HASH)
    payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    payload <- DebuggerTraceBinary::writer_put_u32(payload, event.schema)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.ordinal)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.task.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.recording.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.branch.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.event)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.task.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.invocation.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.statement.value)
    payload <- DebuggerTraceBinary::writer_put_u32(payload, event.position.microstep)
    payload <- DebuggerTraceBinary::writer_put_u16(payload, event.kind.u16())
    payload <- DebuggerTraceBinary::writer_put_u16(payload, event.quality.u16())
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.payload_hash)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: TRACE_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: sequence, first_event: MAX_EVENT_ORDINAL, last_event: MAX_EVENT_ORDINAL, payload_length: payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(payload)}
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def main() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build_identity(), DebuggerIdentity::debug_id(RECORDING_ID))
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(RECORDING_ID))
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(TRACE_SCHEMA, 0, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, EVENT_PAYLOAD_HASH)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_finalize(recorder))
    manifest: DebuggerTraceBinary::ByteWriter = manifest_encoded(recorder)
    event_chunk: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(recorder.chunks[0])
    return 3 if not DebuggerTraceBinary::writer_is_valid(manifest) or not DebuggerTraceBinary::writer_is_valid(event_chunk)

    reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    truncated: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest_encoded(reader, manifest.bytes[0], manifest.length - TRUNCATION)
    return 4 if truncated.code != DebuggerErrors::ErrorCode.Unavailable or not truncated.retryable or reader.state != DebuggerTraceReader::ReaderState.Empty
    return 5 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest_encoded(reader, manifest.bytes[0], manifest.length))
    return 6 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest_encoded(reader, event_chunk.bytes[0], event_chunk.length))
    return 7 if not DebuggerTraceReader::reader_is_exact(reader)

    damaged: mutable u8[8192] = zeroed
    for index in 0..<event_chunk.length:
        damaged[index] <- event_chunk.bytes[index]
    damaged[event_chunk.length - TRUNCATION] <- damaged[event_chunk.length - TRUNCATION] + CORRUPTION
    corrupt_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 8 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest_encoded(corrupt_reader, manifest.bytes[0], manifest.length))
    failure: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest_encoded(corrupt_reader, damaged[0], event_chunk.length)
    return 9 if failure.code != DebuggerErrors::ErrorCode.Corrupt or corrupt_reader.state != DebuggerTraceReader::ReaderState.Corrupt

    max_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 10 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(max_reader, max_event_manifest_chunk()))
    max_chunk: DebuggerTraceStorage::StoredChunk = max_event_chunk(MAX_EVENT_CHUNK_SEQUENCE, TEST_ROOT_BRANCH)
    return 11 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(max_reader, max_chunk))
    return 12 if not max_reader.event_exhausted or not DebuggerTraceReader::reader_is_exact(max_reader)
    modified_branch_reader: mutable DebuggerTraceReader::TraceReader = max_reader
    modified_branch_reader.events[0].position.branch <- DebuggerIdentity::debug_id(TEST_NON_ROOT_BRANCH)
    return NON_ROOT_BRANCH_STATE_RESULT if DebuggerTraceReader::reader_is_exact(modified_branch_reader)
    non_root_chunk: DebuggerTraceStorage::StoredChunk = max_event_chunk(MAX_EVENT_CHUNK_SEQUENCE, TEST_NON_ROOT_BRANCH)
    encoded_non_root_chunk: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(non_root_chunk)
    decoded_non_root_chunk: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(encoded_non_root_chunk.bytes[0], encoded_non_root_chunk.length)
    return NON_ROOT_BRANCH_STORAGE_RESULT if not DebuggerTraceBinary::writer_is_valid(encoded_non_root_chunk) or decoded_non_root_chunk.status != DebuggerTraceStorage::StorageStatus.Ready
    non_root_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return NON_ROOT_BRANCH_READER_RESULT if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(non_root_reader, max_event_manifest_chunk()))
    non_root_result: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(non_root_reader, non_root_chunk)
    return NON_ROOT_BRANCH_READER_RESULT if not DebuggerErrors::error_is_ok(non_root_result) or non_root_reader.state != DebuggerTraceReader::ReaderState.Ready
    return NON_ROOT_BRANCH_STATE_RESULT if DebuggerTraceReader::reader_is_exact(non_root_reader)
    legacy_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    legacy_manifest: mutable DebuggerTraceStorage::StoredChunk = max_event_manifest_chunk()
    legacy_manifest.checksum <- test_legacy_checksum(legacy_manifest.payload[0], legacy_manifest.payload_length)
    legacy_manifest.header.checksum <- legacy_manifest.checksum
    return 14 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(legacy_reader, legacy_manifest))
    legacy_chunk: mutable DebuggerTraceStorage::StoredChunk = max_event_chunk(MAX_EVENT_CHUNK_SEQUENCE, TEST_ROOT_BRANCH)
    legacy_chunk.checksum <- test_legacy_checksum(legacy_chunk.payload[0], legacy_chunk.payload_length)
    legacy_chunk.header.checksum <- legacy_chunk.checksum
    return 15 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(legacy_reader, legacy_chunk)) or not DebuggerTraceReader::reader_is_exact(legacy_reader)
    exhausted_reader: mutable DebuggerTraceReader::TraceReader = max_reader
    repeated_max_chunk: mutable DebuggerTraceStorage::StoredChunk = max_event_chunk(MAX_EVENT_NEXT_CHUNK_SEQUENCE, TEST_ROOT_BRANCH)
    repeated_max_error: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(exhausted_reader, repeated_max_chunk)
    return 13 if DebuggerErrors::error_is_ok(repeated_max_error)
    return 0
