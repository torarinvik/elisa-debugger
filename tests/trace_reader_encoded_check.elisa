include "../src/trace/binary.elisa"
include "../src/trace/storage.elisa"
include "../src/trace/manifest.elisa"
include "../src/trace/recorder.elisa"
include "../src/trace/reader.elisa"
include "../src/core/events.elisa"
include "../src/core/identity.elisa"
include "../src/core/errors.elisa"

const module Test:
    BUILD_COMPILER: u64 = 51
    BUILD_RUNTIME: u64 = 52
    BUILD_SOURCE: u64 = 53
    BUILD_TARGET: u64 = 54
    RECORDING_ID: u64 = 55
    EVENT_PAYLOAD_HASH: u64 = 56
    TRACE_SCHEMA: u32 = 1
    TRUNCATION: usize = 1
    CORRUPTION: u8 = 1
    MAX_EVENT_MANIFEST_SEQUENCE: u64 = 0
    MAX_EVENT_ORDINAL: u64 = 18446744073709551615
    MAX_EVENT_CHUNK_SEQUENCE: u64 = 1
    MAX_EVENT_NEXT_CHUNK_SEQUENCE: u64 = 2
    FIRST_TEST_EVENT: u64 = 0
    SECOND_TEST_EVENT: u64 = 1
    FIRST_TEST_EVENT_INDEX: usize = 0
    INVALID_EVENT_SCHEMA: u32 = 2
    INVALID_CHUNK_READER_RESULT: i64 = 19
    ROOT_BRANCH: u64 = 0
    NON_ROOT_BRANCH: u64 = 1
    NON_ROOT_BRANCH_READER_RESULT: i64 = 16
    NON_ROOT_BRANCH_STORAGE_RESULT: i64 = 17
    NON_ROOT_BRANCH_STATE_RESULT: i64 = 18
    LEGACY_HASH_OFFSET_BASIS: u64 = 1469598103934665603
    HASH_PRIME: u64 = 1099511628211


def test_legacy_checksum(bytes: u8&, length: usize) -> u64:
    checksum: mutable u64 = Test::LEGACY_HASH_OFFSET_BASIS
    for index in 0..<length:
        checksum <- (checksum ^ bytes[index].u64()) * Test::HASH_PRIME
    return checksum

def build_identity() -> DebuggerIdentity::BuildIdentity:
    return DebuggerIdentity::BuildIdentity{
        compiler: DebuggerIdentity::debug_id(Test::BUILD_COMPILER),
        runtime: DebuggerIdentity::debug_id(Test::BUILD_RUNTIME),
        source: DebuggerIdentity::debug_id(Test::BUILD_SOURCE),
        target: DebuggerIdentity::debug_id(Test::BUILD_TARGET),
        metadata_version: 1
    }

def manifest_encoded(recorder: DebuggerTraceRecorder::TraceRecorder) -> DebuggerTraceBinary::ByteWriter:
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(recorder.manifest)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{
        schema: Test::TRACE_SCHEMA,
        kind: DebuggerTrace::ChunkKind.Manifest,
        sequence: 0,
        first_event: recorder.manifest.first_event,
        last_event: recorder.manifest.last_event,
        payload_length: payload.length.u64(),
        checksum: DebuggerTraceBinary::writer_checksum(payload)
    }
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return DebuggerTraceStorage::storage_encode_chunk(chunk)

def test_manifest_chunk(first_event: u64, last_event: u64) -> DebuggerTraceStorage::StoredChunk:
    manifest: mutable DebuggerTraceManifest::BundleManifest = DebuggerTraceManifest::manifest_new(build_identity(), DebuggerTraceManifest::ManifestStatus.Exact)
    manifest.first_event <- first_event
    manifest.last_event <- last_event
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::TRACE_SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: Test::MAX_EVENT_MANIFEST_SEQUENCE, first_event: first_event, last_event: last_event, payload_length: payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(payload)}
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def max_event_manifest_chunk() -> DebuggerTraceStorage::StoredChunk:
    return test_manifest_chunk(Test::MAX_EVENT_ORDINAL, Test::MAX_EVENT_ORDINAL)

def test_event_payload(ordinal: u64, schema: u32) -> DebuggerTraceBinary::ByteWriter:
    position: mutable DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::RECORDING_ID))
    position.event <- ordinal
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(schema, ordinal, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_PAYLOAD_HASH)
    payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    payload <- DebuggerTraceBinary::writer_put_u32(payload, event.schema)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.ordinal)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.task.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.recording.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.branch.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.event)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.task.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.invocation.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.statement.value)
    payload <- DebuggerTraceBinary::writer_put_u32(payload, event.position.microstep)
    payload <- DebuggerTraceBinary::writer_put_u16(payload, event.kind.u16())
    payload <- DebuggerTraceBinary::writer_put_u16(payload, event.quality.u16())
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.payload_hash)
    return payload

def two_event_chunk_with_invalid_second() -> DebuggerTraceStorage::StoredChunk:
    first: DebuggerTraceBinary::ByteWriter = test_event_payload(Test::FIRST_TEST_EVENT, Test::TRACE_SCHEMA)
    second: DebuggerTraceBinary::ByteWriter = test_event_payload(Test::SECOND_TEST_EVENT, Test::INVALID_EVENT_SCHEMA)
    payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    for index in 0..<first.length:
        payload <- DebuggerTraceBinary::writer_put_byte(payload, first.bytes[index])
    for index in 0..<second.length:
        payload <- DebuggerTraceBinary::writer_put_byte(payload, second.bytes[index])
    checksum: u64 = DebuggerTraceBinary::writer_checksum(payload)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::TRACE_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: Test::MAX_EVENT_CHUNK_SEQUENCE, first_event: Test::FIRST_TEST_EVENT, last_event: Test::SECOND_TEST_EVENT, payload_length: payload.length.u64(), checksum: checksum}
    chunk.payload_length <- payload.length
    chunk.checksum <- checksum
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def max_event_chunk(sequence: u64, branch_id: u64) -> DebuggerTraceStorage::StoredChunk:
    position: mutable DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::RECORDING_ID))
    position.branch <- DebuggerIdentity::debug_id(branch_id)
    position.event <- Test::MAX_EVENT_ORDINAL
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::TRACE_SCHEMA, Test::MAX_EVENT_ORDINAL, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_PAYLOAD_HASH)
    payload: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    payload <- DebuggerTraceBinary::writer_put_u32(payload, event.schema)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.ordinal)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.task.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.recording.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.branch.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.event)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.task.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.invocation.value)
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.position.statement.value)
    payload <- DebuggerTraceBinary::writer_put_u32(payload, event.position.microstep)
    payload <- DebuggerTraceBinary::writer_put_u16(payload, event.kind.u16())
    payload <- DebuggerTraceBinary::writer_put_u16(payload, event.quality.u16())
    payload <- DebuggerTraceBinary::writer_put_u64(payload, event.payload_hash)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::TRACE_SCHEMA, kind: DebuggerTrace::ChunkKind.Events, sequence: sequence, first_event: Test::MAX_EVENT_ORDINAL, last_event: Test::MAX_EVENT_ORDINAL, payload_length: payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(payload)}
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def main() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build_identity(), DebuggerIdentity::debug_id(Test::RECORDING_ID))
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::RECORDING_ID))
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::TRACE_SCHEMA, 0, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_PAYLOAD_HASH)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_finalize(recorder))
    manifest: DebuggerTraceBinary::ByteWriter = manifest_encoded(recorder)
    event_chunk: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(recorder.chunks[0])
    return 3 if not DebuggerTraceBinary::writer_is_valid(manifest) or not DebuggerTraceBinary::writer_is_valid(event_chunk)

    reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    truncated: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest_encoded(reader, manifest.bytes[0], manifest.length - Test::TRUNCATION)
    return 4 if truncated.code != DebuggerErrors::ErrorCode.Unavailable or not truncated.retryable or reader.state != DebuggerTraceReader::ReaderState.Empty
    return 5 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest_encoded(reader, manifest.bytes[0], manifest.length))
    return 6 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest_encoded(reader, event_chunk.bytes[0], event_chunk.length))
    return 7 if not DebuggerTraceReader::reader_is_exact(reader)

    damaged: mutable u8[8192] = zeroed
    for index in 0..<event_chunk.length:
        damaged[index] <- event_chunk.bytes[index]
    damaged[event_chunk.length - Test::TRUNCATION] <- damaged[event_chunk.length - Test::TRUNCATION] + Test::CORRUPTION
    corrupt_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 8 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest_encoded(corrupt_reader, manifest.bytes[0], manifest.length))
    failure: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest_encoded(corrupt_reader, damaged[0], event_chunk.length)
    return 9 if failure.code != DebuggerErrors::ErrorCode.Corrupt or corrupt_reader.state != DebuggerTraceReader::ReaderState.Corrupt

    partial_chunk_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return Test::INVALID_CHUNK_READER_RESULT if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(partial_chunk_reader, test_manifest_chunk(Test::FIRST_TEST_EVENT, Test::SECOND_TEST_EVENT)))
    partial_chunk_failure: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(partial_chunk_reader, two_event_chunk_with_invalid_second())
    return Test::INVALID_CHUNK_READER_RESULT if partial_chunk_failure.code != DebuggerErrors::ErrorCode.Corrupt or partial_chunk_reader.state != DebuggerTraceReader::ReaderState.Corrupt or partial_chunk_reader.event_count != 0 or partial_chunk_reader.events[Test::FIRST_TEST_EVENT_INDEX].schema != 0 or partial_chunk_reader.next_event != Test::FIRST_TEST_EVENT or partial_chunk_reader.recording_seen or partial_chunk_reader.next_sequence != Test::MAX_EVENT_CHUNK_SEQUENCE

    max_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 10 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(max_reader, max_event_manifest_chunk()))
    max_chunk: DebuggerTraceStorage::StoredChunk = max_event_chunk(Test::MAX_EVENT_CHUNK_SEQUENCE, Test::ROOT_BRANCH)
    return 11 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(max_reader, max_chunk))
    return 12 if not max_reader.event_exhausted or not DebuggerTraceReader::reader_is_exact(max_reader)
    modified_branch_reader: mutable DebuggerTraceReader::TraceReader = max_reader
    modified_branch_reader.events[0].position.branch <- DebuggerIdentity::debug_id(Test::NON_ROOT_BRANCH)
    return Test::NON_ROOT_BRANCH_STATE_RESULT if DebuggerTraceReader::reader_is_exact(modified_branch_reader)
    non_root_chunk: DebuggerTraceStorage::StoredChunk = max_event_chunk(Test::MAX_EVENT_CHUNK_SEQUENCE, Test::NON_ROOT_BRANCH)
    encoded_non_root_chunk: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(non_root_chunk)
    decoded_non_root_chunk: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(encoded_non_root_chunk.bytes[0], encoded_non_root_chunk.length)
    return Test::NON_ROOT_BRANCH_STORAGE_RESULT if not DebuggerTraceBinary::writer_is_valid(encoded_non_root_chunk) or decoded_non_root_chunk.status != DebuggerTraceStorage::StorageStatus.Ready
    non_root_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return Test::NON_ROOT_BRANCH_READER_RESULT if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(non_root_reader, max_event_manifest_chunk()))
    non_root_result: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(non_root_reader, non_root_chunk)
    return Test::NON_ROOT_BRANCH_READER_RESULT if not DebuggerErrors::error_is_ok(non_root_result) or non_root_reader.state != DebuggerTraceReader::ReaderState.Ready
    return Test::NON_ROOT_BRANCH_STATE_RESULT if DebuggerTraceReader::reader_is_exact(non_root_reader)
    legacy_reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    legacy_manifest: mutable DebuggerTraceStorage::StoredChunk = max_event_manifest_chunk()
    legacy_manifest.checksum <- test_legacy_checksum(legacy_manifest.payload[0], legacy_manifest.payload_length)
    legacy_manifest.header.checksum <- legacy_manifest.checksum
    return 14 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(legacy_reader, legacy_manifest))
    legacy_chunk: mutable DebuggerTraceStorage::StoredChunk = max_event_chunk(Test::MAX_EVENT_CHUNK_SEQUENCE, Test::ROOT_BRANCH)
    legacy_chunk.checksum <- test_legacy_checksum(legacy_chunk.payload[0], legacy_chunk.payload_length)
    legacy_chunk.header.checksum <- legacy_chunk.checksum
    return 15 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(legacy_reader, legacy_chunk)) or not DebuggerTraceReader::reader_is_exact(legacy_reader)
    exhausted_reader: mutable DebuggerTraceReader::TraceReader = max_reader
    repeated_max_chunk: mutable DebuggerTraceStorage::StoredChunk = max_event_chunk(Test::MAX_EVENT_NEXT_CHUNK_SEQUENCE, Test::ROOT_BRANCH)
    repeated_max_error: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(exhausted_reader, repeated_max_chunk)
    return 13 if DebuggerErrors::error_is_ok(repeated_max_error)
    return 0
