    RESULT_LIMIT_NOT_REPORTED: i64 = 24
    RESULT_LIMIT_PREFIX_MISMATCH: i64 = 25
    RESULT_LIMIT_PREFIX_SCAN_FAILED: i64 = 26
    RESULT_TORN_NEXT_HEADER_ENCODE_FAILED: i64 = 28
    RESULT_TORN_NEXT_HEADER_NOT_TRUNCATED: i64 = 29
    RESULT_TORN_NEXT_HEADER_PREFIX_COUNT: i64 = 30
    RESULT_TORN_NEXT_HEADER_EVENT: i64 = 31
    RESULT_TORN_NEXT_HEADER_SEQUENCE: i64 = 32
    RESULT_TORN_NEXT_HEADER_FOOTER: i64 = 33
    RESULT_NON_ROOT_EVENT_ACCEPTED: i64 = 34
    RESULT_NON_ROOT_CHECKPOINT_ACCEPTED: i64 = 35
    RESULT_UNSTORABLE_EVENT_ACCEPTED: i64 = 36
    RESULT_CHECKPOINT_SELECTION_MISMATCH: i64 = 37
    RESULT_EVENT_ENVELOPE_CONTRACT: i64 = 38
    RESULT_PAYLOAD_VALIDATION: i64 = 40
    RESULT_PAYLOAD_RECORDING_FAILED: i64 = 41
    RESULT_PAYLOAD_MANIFEST_FAILED: i64 = 42
    RESULT_PAYLOAD_EVENT_INGEST_FAILED: i64 = 43
    RESULT_PAYLOAD_DATA_MISMATCH: i64 = 44
    RESULT_PAYLOAD_READER_NOT_EXACT: i64 = 45
    RESULT_PAYLOAD_WIRE_LENGTH: i64 = 57
    RESULT_PAYLOAD_WIRE_FIELDS: i64 = 58
    RESULT_PAYLOAD_STORAGE_REJECTED: i64 = 59
    RESULT_PAYLOAD_CORRUPTION_ACCEPTED: i64 = 60

    const module PayloadFixture:
        LENGTH: usize = 4
        CAPACITY: usize = 64
        FIRST: u8 = 17
        SECOND: u8 = 34
        THIRD: u8 = 51
        FOURTH: u8 = 68
        CORRUPTION_DELTA: u8 = 1
        PADDING_CORRUPTION_BYTE: u8 = 127
        ENCODED_BYTES: usize = 160
        KIND_OFFSET: usize = 84
        LENGTH_OFFSET: usize = 86
        BODY_OFFSET: usize = 96

    const module VariableCodec:
        NO_PAYLOAD_FAILURE: i64 = 61
        PAYLOAD_FAILURE: i64 = 62
        TRUNCATED_FAILURE: i64 = 63
        PAYLOAD_LENGTH: usize = 3
        FIRST: u8 = 17
        SECOND: u8 = 34
        THIRD: u8 = 51


def build_identity() -> DebuggerIdentity::BuildIdentity:
    return DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(Test::BUILD), runtime: DebuggerIdentity::debug_id(Test::BUILD + 1), source: DebuggerIdentity::debug_id(Test::BUILD + 2), target: DebuggerIdentity::debug_id(Test::BUILD + 3), metadata_version: 1}

def make_event(recording: u64, schema: u32, ordinal: u64) -> DebuggerEvents::EventEnvelope:
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(recording))
    position.event <- ordinal
    return DebuggerEvents::event_envelope(schema, ordinal, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_HASH)

def make_checkpoint(recording: u64, event: u64) -> DebuggerFullCheckpoint::ManagedCheckpoint:
    machine: DebuggerEDIR::Machine = DebuggerEDIR::machine_new()
    machine.steps <- event
    snapshot: DebuggerCheckpoint::MachineSnapshot = DebuggerCheckpoint::snapshot_capture(machine, DebuggerIdentity::debug_id(event + Test::CHECKPOINT_ID_OFFSET), event, Test::CHECKPOINT_STATE_HASH_SEED)
    state_hash: u64 = DebuggerCheckpoint::snapshot_state_hash(snapshot)
    runtime: mutable DebuggerConcurrencyRuntime::TaskRuntime = zeroed
    DebuggerConcurrencyRuntime::runtime_initialize(runtime, false)
    tasks: DebuggerConcurrencyCheckpoint::TaskSnapshot = DebuggerConcurrencyCheckpoint::task_snapshot_capture(runtime)
    effects: mutable DebuggerEffects::EffectOracle = zeroed
    DebuggerEffects::effect_oracle_initialize(effects, DebuggerEffects::EffectMode.Recording)
    resources: mutable DebuggerVirtualResources::ResourceStore = zeroed
    DebuggerVirtualResources::resources_initialize(resources, DebuggerVirtualResources::ResourceMode.Recording)
    adapters: mutable DebuggerReplayAdapters::AdapterSnapshot = zeroed
    DebuggerReplayAdapters::adapter_snapshot_initialize_replay(adapters)
    return DebuggerFullCheckpoint::full_checkpoint_capture_with_adapters(machine, tasks, effects, resources, adapters, DebuggerIdentity::debug_id(recording), DebuggerIdentity::debug_id(Test::CHECKPOINT_BRANCH), event, state_hash, build_identity(), Test::CHECKPOINT_IMAGE_FINGERPRINT, true)

def make_manifest_chunk(manifest: DebuggerTraceManifest::BundleManifest) -> DebuggerTraceStorage::StoredChunk:
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(manifest)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: manifest.schema.u32(), kind: DebuggerTrace::ChunkKind.Manifest, sequence: Test::MANIFEST_SEQUENCE, first_event: manifest.first_event, last_event: manifest.last_event, payload_length: payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(payload)}
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    return chunk

def append_trace_chunk(output: mutable DebuggerTraceBinary::ByteWriter&, chunk: DebuggerTraceStorage::StoredChunk) -> void:
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(chunk)
    if not DebuggerTraceBinary::writer_is_valid(encoded):
        output.failed <- true
        return
    for index in 0..<encoded.length:
        DebuggerTraceBinary::writer_put_byte(output, encoded.bytes[index])

def append_trace_bytes(output: mutable DebuggerTraceBinary::ByteWriter&, encoded: DebuggerTraceBinary::ByteWriter&) -> void:
    for index in 0..<encoded.length:
        DebuggerTraceBinary::writer_put_byte(output, encoded.bytes[index])

def check_record_and_read_full_checkpoint() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    return Test::RESULT_PAYLOAD_VALIDATION if DebuggerEventPayloadLimits::MAX_BYTES != Test::PayloadFixture::CAPACITY or DebuggerEvents::event_payload_capacity() != Test::PayloadFixture::CAPACITY
    first: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, Test::FIRST_EVENT)
    second: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, Test::CHECKPOINT_EVENT)
    return Test::RESULT_FIRST_CHECKPOINT_EVENT_APPEND_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, first))
    first_checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint(Test::RECORDING, Test::FIRST_CHECKPOINT_EVENT)
    return Test::RESULT_CHECKPOINT_APPEND_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append_checkpoint(recorder, first_checkpoint))
    return Test::RESULT_SECOND_CHECKPOINT_EVENT_APPEND_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, second))
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint(Test::RECORDING, Test::CHECKPOINT_EVENT)
    return Test::RESULT_CHECKPOINT_APPEND_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append_checkpoint(recorder, checkpoint))
    return Test::RESULT_CHECKPOINT_RECORDER_FINALIZE_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_finalize(recorder))
    return Test::RESULT_CHECKPOINT_RECORDER_NOT_EXACT if recorder.chunk_count != Test::RECORDED_CHUNK_COUNT or recorder.manifest.checkpoint_count != Test::CHECKPOINT_COUNT or not DebuggerTraceRecorder::recorder_is_exact(recorder)
    return Test::RESULT_CHECKPOINT_CHUNK_ORDER_MISMATCH if recorder.chunks[Test::FIRST_EVENT_CHUNK_INDEX].header.kind != DebuggerTrace::ChunkKind.Events or recorder.chunks[Test::CHECKPOINT_CHUNK_INDEX].header.kind != DebuggerTrace::ChunkKind.Checkpoint or recorder.chunks[Test::SECOND_EVENT_CHUNK_INDEX].header.kind != DebuggerTrace::ChunkKind.Events or recorder.chunks[Test::SECOND_CHECKPOINT_CHUNK_INDEX].header.kind != DebuggerTrace::ChunkKind.Checkpoint
    reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceReader::reader_new() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    return Test::RESULT_CHECKPOINT_MANIFEST_INGEST_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, make_manifest_chunk(recorder.manifest)))
    for index in 0..<recorder.chunk_count:
        return Test::RESULT_CHECKPOINT_CHUNK_INGEST_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, recorder.chunks[index]))
    return Test::RESULT_CHECKPOINT_READER_NOT_EXACT if DebuggerTraceReader::reader_event_count(reader) != Test::RECORDED_EVENT_COUNT or DebuggerTraceReader::reader_full_checkpoint_count(reader) != Test::RECORDED_CHECKPOINT_COUNT or not DebuggerTraceReader::reader_is_exact(reader)
    first_found: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_full_checkpoint_at(reader, Test::FIRST_CHECKPOINT_INDEX)
    return Test::RESULT_CHECKPOINT_LOOKUP_MISMATCH if not first_found.found or first_found.checkpoint.event != Test::FIRST_CHECKPOINT_EVENT or first_found.checkpoint.recording.value != Test::RECORDING
    before_first: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(reader, Test::FIRST_CHECKPOINT_EVENT)
    at_second: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(reader, Test::CHECKPOINT_EVENT)
    at_final_boundary: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(reader, Test::FINAL_EVENT_BOUNDARY)
    after_final_boundary: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(reader, Test::OUTSIDE_FINAL_EVENT_BOUNDARY)
    return Test::RESULT_CHECKPOINT_SELECTION_MISMATCH if not before_first.found or before_first.checkpoint.event != Test::FIRST_CHECKPOINT_EVENT or not at_second.found or at_second.checkpoint.event != Test::CHECKPOINT_EVENT or not at_final_boundary.found or at_final_boundary.checkpoint.event != Test::CHECKPOINT_EVENT or after_final_boundary.found
    partial_reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceReader::reader_clone(reader) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    partial_reader.manifest.status <- DebuggerTraceManifest::ManifestStatus.Partial
    partial_selection: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(partial_reader, Test::CHECKPOINT_EVENT)
    return Test::RESULT_CHECKPOINT_SELECTION_MISMATCH if partial_selection.found
    incompatible_reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceReader::reader_clone(reader) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    incompatible_reader.full_checkpoints[Test::RECORDED_CHECKPOINT_COUNT - Test::CHECKPOINT_ID_OFFSET.usize()].recording <- DebuggerIdentity::debug_id(Test::WRONG_RECORDING)
    compatible_fallback: DebuggerTraceReader::FullCheckpointLookup = DebuggerTraceReader::reader_nearest_checkpoint_at_or_before(incompatible_reader, Test::CHECKPOINT_EVENT)
    return Test::RESULT_CHECKPOINT_SELECTION_MISMATCH if not compatible_fallback.found or compatible_fallback.checkpoint.event != Test::FIRST_CHECKPOINT_EVENT
    trace: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(trace)
    append_trace_chunk(trace, make_manifest_chunk(recorder.manifest))
    for index in 0..<recorder.chunk_count:
        append_trace_chunk(trace, recorder.chunks[index])
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(recorder.chunk_count.u64() + Test::FOOTER_SEQUENCE_OFFSET, recorder.manifest.last_event)
    append_trace_bytes(trace, footer)
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(trace.bytes[0], trace.length)
    return Test::RESULT_CHECKPOINT_STORAGE_SCAN_FAILED if not DebuggerTraceBinary::writer_is_valid(trace) or scan.status != DebuggerTraceStorage::StorageStatus.Ready or not scan.footer_verified or scan.verified_chunks != recorder.chunk_count.u64() + Test::FOOTER_SEQUENCE_OFFSET
    torn_prefix: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(torn_prefix)
    append_trace_chunk(torn_prefix, make_manifest_chunk(recorder.manifest))
    append_trace_chunk(torn_prefix, recorder.chunks[Test::FIRST_EVENT_CHUNK_INDEX])
    following_chunk: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(recorder.chunks[Test::CHECKPOINT_CHUNK_INDEX])
    return Test::RESULT_TORN_NEXT_HEADER_ENCODE_FAILED if not DebuggerTraceBinary::writer_is_valid(following_chunk) or following_chunk.length < footer.length
    for index in 0..<footer.length:
        DebuggerTraceBinary::writer_put_byte(torn_prefix, following_chunk.bytes[index])
    torn_scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(torn_prefix.bytes[0], torn_prefix.length)
    return Test::RESULT_TORN_NEXT_HEADER_NOT_TRUNCATED if torn_scan.status != DebuggerTraceStorage::StorageStatus.Truncated
    return Test::RESULT_TORN_NEXT_HEADER_PREFIX_COUNT if torn_scan.verified_chunks != Test::FOOTER_SEQUENCE_OFFSET + 1
    return Test::RESULT_TORN_NEXT_HEADER_EVENT if torn_scan.verified_event != Test::FIRST_EVENT
    return Test::RESULT_TORN_NEXT_HEADER_SEQUENCE if torn_scan.next_sequence != Test::FOOTER_SEQUENCE_OFFSET + 1
    return Test::RESULT_TORN_NEXT_HEADER_FOOTER if torn_scan.footer_verified
    return 0

def check_resource_limit_keeps_verified_prefix() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    for ordinal in 0..<Test::RESOURCE_LIMIT_EVENT_COUNT:
        event: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, ordinal)
        return Test::RESULT_LIMIT_EVENT_APPEND_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    checkpoint: DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint(Test::RECORDING, Test::RESOURCE_LIMIT_EVENT_COUNT)
    failure: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append_checkpoint(recorder, checkpoint)
    return Test::RESULT_LIMIT_NOT_REPORTED if failure.code != DebuggerErrors::ErrorCode.ResourceLimit or recorder.status != DebuggerTraceRecorder::RecorderStatus.ResourceLimit
    return Test::RESULT_LIMIT_PREFIX_MISMATCH if recorder.pending_count != 0 or recorder.chunk_count != Test::RESOURCE_LIMIT_CHUNK_COUNT or recorder.manifest.last_event != Test::RESOURCE_LIMIT_LAST_EVENT or recorder.manifest.status != DebuggerTraceManifest::ManifestStatus.Partial
    trace: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(trace)
    append_trace_chunk(trace, make_manifest_chunk(recorder.manifest))
    for index in 0..<recorder.chunk_count:
        append_trace_chunk(trace, recorder.chunks[index])
    footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(recorder.chunk_count.u64() + Test::FOOTER_SEQUENCE_OFFSET, recorder.manifest.last_event)
    append_trace_bytes(trace, footer)
    scan: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(trace.bytes[0], trace.length)
    return Test::RESULT_LIMIT_PREFIX_SCAN_FAILED if not DebuggerTraceBinary::writer_is_valid(trace) or scan.status != DebuggerTraceStorage::StorageStatus.Ready or not scan.footer_verified or scan.manifest_exact or scan.verified_event != Test::RESOURCE_LIMIT_LAST_EVENT
    return 0

def check_resource_limit_rejects_unstorable_event() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    for ordinal in 0..<Test::RESOURCE_LIMIT_EVENT_COUNT:
        event: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, ordinal)
        return Test::RESULT_LIMIT_EVENT_APPEND_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    overflow: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, Test::RESOURCE_LIMIT_OVERFLOW_EVENT)
    failure: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(recorder, overflow)
    return Test::RESULT_UNSTORABLE_EVENT_ACCEPTED if DebuggerErrors::error_is_ok(failure) or failure.code != DebuggerErrors::ErrorCode.ResourceLimit
    return Test::RESULT_UNSTORABLE_EVENT_ACCEPTED if recorder.status != DebuggerTraceRecorder::RecorderStatus.ResourceLimit or recorder.pending_count != Test::RESOURCE_LIMIT_PENDING_EVENT_COUNT or recorder.next_ordinal != Test::RESOURCE_LIMIT_OVERFLOW_EVENT or recorder.chunk_count != Test::RESOURCE_LIMIT_CHUNK_COUNT or recorder.manifest.last_event != Test::RESOURCE_LIMIT_LAST_EVENT
    return 0

def check_record_and_read() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    event: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, 0)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_finalize(recorder))
    return 3 if recorder.chunk_count != 1 or recorder.manifest.last_event != 0 or recorder.manifest.checkpoint_count != 0 or not DebuggerTraceRecorder::recorder_is_exact(recorder)
    reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceReader::reader_new() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(recorder.manifest)
    manifest: mutable DebuggerTraceStorage::StoredChunk = zeroed
    manifest.header <- DebuggerTrace::ChunkHeader{schema: Test::EVENT_SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: 0, payload_length: manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_bytes)}
    manifest.payload_length <- manifest_bytes.length
    manifest.checksum <- DebuggerTraceBinary::writer_checksum(manifest_bytes)
    for index in 0..<manifest_bytes.length:
        manifest.payload[index] <- manifest_bytes.bytes[index]
    return 4 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, manifest))
    chunk: mutable DebuggerTraceStorage::StoredChunk = recorder.chunks[0]
    chunk.header.sequence <- 1
    return 5 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, chunk))
    return 6 if DebuggerTraceReader::reader_event_count(reader) != Test::EVENT_COUNT or not DebuggerTraceReader::reader_is_exact(reader)
    return 0

def check_rejects_bad_event() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    bad: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::BAD_SCHEMA, 0)
    return 7 if DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, bad))
    return 0

def check_rejects_corrupt_quality() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    corrupt: mutable DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, 0)
    corrupt.quality <- DebuggerEvents::EventQuality.Corrupt
    return 11 if DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, corrupt))
    return 0

def check_rejects_malformed_pending_position() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    event: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, 0)
    return 9 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    recorder.pending[0].position.event <- 1
    return 10 if DebuggerTraceRecorder::recorder_is_exact(recorder)
    return 0

def check_rejects_non_root_event() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    event: mutable DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, Test::FIRST_EVENT)
    event.position.branch <- DebuggerIdentity::debug_id(Test::NON_ROOT_BRANCH)
    failure: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append(recorder, event)
    return Test::RESULT_NON_ROOT_EVENT_ACCEPTED if DebuggerErrors::error_is_ok(failure) or recorder.status != DebuggerTraceRecorder::RecorderStatus.Corrupt or DebuggerTraceRecorder::recorder_is_exact(recorder)
    return 0

def check_rejects_non_root_checkpoint() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    event: DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, Test::FIRST_EVENT)
    return Test::RESULT_NON_ROOT_CHECKPOINT_ACCEPTED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    checkpoint: mutable DebuggerFullCheckpoint::ManagedCheckpoint = make_checkpoint(Test::RECORDING, Test::CHECKPOINT_EVENT)
    checkpoint.branch <- DebuggerIdentity::debug_id(Test::NON_ROOT_BRANCH)
    DebuggerFullCheckpoint::full_checkpoint_seal_side_state(checkpoint)
    failure: DebuggerErrors::DebuggerError = DebuggerTraceRecorder::recorder_append_checkpoint(recorder, checkpoint)
    return Test::RESULT_NON_ROOT_CHECKPOINT_ACCEPTED if DebuggerErrors::error_is_ok(failure) or recorder.status != DebuggerTraceRecorder::RecorderStatus.Corrupt or DebuggerTraceRecorder::recorder_is_exact(recorder)
    return 0

def check_rejects_malformed_manifest() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    malformed: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
    malformed.metadata_version <- 0
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(malformed)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::EVENT_SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: 0, payload_length: payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(payload)}
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceReader::reader_new() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    return 8 if DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, chunk))
    return 0

def check_event_envelope_contract() -> i64:
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(Test::RECORDING))
    event: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::EVENT_SCHEMA, Test::FIRST_EVENT, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, Test::EVENT_HASH)
    return Test::RESULT_EVENT_ENVELOPE_CONTRACT if not DebuggerEvents::event_envelope_is_well_formed(event) or not DebuggerEvents::event_envelopes_equal(event, event)
    corrupt_position: mutable DebuggerEvents::EventEnvelope = event
    corrupt_position.position.event <- Test::EVENT_COUNT
    return Test::RESULT_EVENT_ENVELOPE_CONTRACT if DebuggerEvents::event_envelope_is_well_formed(corrupt_position) or DebuggerEvents::event_envelopes_equal(event, corrupt_position)
    mismatched_task: mutable DebuggerEvents::EventEnvelope = event
    mismatched_task.position.task <- DebuggerIdentity::debug_id(Test::RECORDING)
    return Test::RESULT_EVENT_ENVELOPE_CONTRACT if DebuggerEvents::event_envelope_is_well_formed(mismatched_task)
    return 0

def check_variable_event_codec() -> i64:
    event: mutable DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, Test::FIRST_EVENT)
    encoded: mutable DebuggerTraceBinary::ByteWriter = zeroed
    DebuggerTraceBinary::writer_initialize(encoded)
    return Test::VariableCodec::NO_PAYLOAD_FAILURE if not DebuggerTraceEventCodec::event_record_encode(event, encoded)
    return Test::VariableCodec::NO_PAYLOAD_FAILURE if encoded.length != DebuggerTraceEventCodec::event_record_fixed_size()
    reader: mutable DebuggerTraceBinary::ByteReader = zeroed
    DebuggerTraceBinary::reader_initialize(reader, encoded.bytes[0], encoded.length)
    decoded: mutable DebuggerTraceEventCodec::DecodeResult = DebuggerTraceEventCodec::event_record_decode(reader)
    return Test::VariableCodec::NO_PAYLOAD_FAILURE if decoded.status != DebuggerTraceEventCodec::DecodeStatus.Ready
    return Test::VariableCodec::NO_PAYLOAD_FAILURE if reader.offset != reader.length
    return Test::VariableCodec::NO_PAYLOAD_FAILURE if not DebuggerEvents::event_envelopes_equal(event, decoded.event)

    payload: mutable u8[Test::VariableCodec::PAYLOAD_LENGTH] = [Test::VariableCodec::FIRST, Test::VariableCodec::SECOND, Test::VariableCodec::THIRD]
    return Test::VariableCodec::PAYLOAD_FAILURE if not DebuggerEvents::event_envelope_set_payload(event, DebuggerEvents::EventPayloadKind.Bytes, payload[0], Test::VariableCodec::PAYLOAD_LENGTH)
    DebuggerTraceBinary::writer_initialize(encoded)
    return Test::VariableCodec::PAYLOAD_FAILURE if not DebuggerTraceEventCodec::event_record_encode(event, encoded)
    return Test::VariableCodec::PAYLOAD_FAILURE if encoded.length != DebuggerTraceEventCodec::event_record_fixed_size() + Test::VariableCodec::PAYLOAD_LENGTH
    DebuggerTraceBinary::reader_initialize(reader, encoded.bytes[0], encoded.length)
    decoded <- DebuggerTraceEventCodec::event_record_decode(reader)
    return Test::VariableCodec::PAYLOAD_FAILURE if decoded.status != DebuggerTraceEventCodec::DecodeStatus.Ready
    return Test::VariableCodec::PAYLOAD_FAILURE if reader.offset != reader.length
    return Test::VariableCodec::PAYLOAD_FAILURE if not DebuggerEvents::event_envelopes_equal(event, decoded.event)

    DebuggerTraceBinary::reader_initialize(reader, encoded.bytes[0], encoded.length - 1)
    decoded <- DebuggerTraceEventCodec::event_record_decode(reader)
    return Test::VariableCodec::TRUNCATED_FAILURE if decoded.status != DebuggerTraceEventCodec::DecodeStatus.Invalid or DebuggerTraceBinary::reader_is_valid(reader)
    return 0

def check_payload_round_trip() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder
    DebuggerTraceRecorder::recorder_initialize(recorder, build_identity(), DebuggerIdentity::debug_id(Test::RECORDING))
    event: mutable DebuggerEvents::EventEnvelope = make_event(Test::RECORDING, Test::EVENT_SCHEMA, Test::FIRST_EVENT)
    payload: mutable u8[Test::PayloadFixture::LENGTH] = [Test::PayloadFixture::FIRST, Test::PayloadFixture::SECOND, Test::PayloadFixture::THIRD, Test::PayloadFixture::FOURTH]
    return Test::RESULT_PAYLOAD_VALIDATION if not DebuggerEvents::event_envelope_set_payload(event, DebuggerEvents::EventPayloadKind.Bytes, payload[0], Test::PayloadFixture::LENGTH)
    event.kind <- DebuggerEvents::EventKind.Input
    return Test::RESULT_PAYLOAD_VALIDATION if event.payload_kind != DebuggerEvents::EventPayloadKind.Bytes or event.payload_length.usize() != Test::PayloadFixture::LENGTH or not DebuggerEvents::event_envelope_is_well_formed(event)
    aliased_payload: mutable DebuggerEvents::EventEnvelope = event
    return Test::RESULT_PAYLOAD_VALIDATION if not DebuggerEvents::event_envelope_set_payload(aliased_payload, DebuggerEvents::EventPayloadKind.Bytes, aliased_payload.payload[0], Test::PayloadFixture::LENGTH) or aliased_payload.payload[0] != Test::PayloadFixture::FIRST or aliased_payload.payload[1] != Test::PayloadFixture::SECOND or aliased_payload.payload[2] != Test::PayloadFixture::THIRD or aliased_payload.payload[3] != Test::PayloadFixture::FOURTH
    invalid_scalar: mutable DebuggerEvents::EventEnvelope = event
    return Test::RESULT_PAYLOAD_VALIDATION if DebuggerEvents::event_envelope_set_payload(invalid_scalar, DebuggerEvents::EventPayloadKind.SignedScalar, payload[0], Test::PayloadFixture::LENGTH)
    corrupted: mutable DebuggerEvents::EventEnvelope = event
    corrupted.payload[0] <- corrupted.payload[0] + Test::PayloadFixture::CORRUPTION_DELTA
    return Test::RESULT_PAYLOAD_VALIDATION if DebuggerEvents::event_envelope_is_well_formed(corrupted) or DebuggerEvents::event_envelopes_equal(event, corrupted)
    noncanonical_padding: mutable DebuggerEvents::EventEnvelope = event
    noncanonical_padding.payload[Test::PayloadFixture::LENGTH] <- Test::PayloadFixture::PADDING_CORRUPTION_BYTE
    return Test::RESULT_PAYLOAD_VALIDATION if DebuggerEvents::event_envelope_is_well_formed(noncanonical_padding)
    invalid_output: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::EVENT_SCHEMA, Test::FIRST_EVENT, event.position, DebuggerEvents::EventKind.Output, DebuggerEvents::EventQuality.Exact, Test::EVENT_HASH)
    invalid_input: DebuggerEvents::EventEnvelope = DebuggerEvents::event_envelope(Test::EVENT_SCHEMA, Test::FIRST_EVENT, event.position, DebuggerEvents::EventKind.Input, DebuggerEvents::EventQuality.Exact, Test::EVENT_HASH)
    return Test::RESULT_PAYLOAD_VALIDATION if DebuggerEvents::event_envelope_is_well_formed(invalid_output) or DebuggerEvents::event_envelope_is_well_formed(invalid_input)
    valid_output: mutable DebuggerEvents::EventEnvelope = invalid_output
    return Test::RESULT_PAYLOAD_VALIDATION if not DebuggerEvents::event_envelope_set_payload(valid_output, DebuggerEvents::EventPayloadKind.Bytes, payload[0], Test::PayloadFixture::LENGTH) or not DebuggerEvents::event_envelope_is_well_formed(valid_output)
    return Test::RESULT_PAYLOAD_RECORDING_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event)) or not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_finalize(recorder))

    manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(recorder.manifest)
    manifest_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    manifest_chunk.header <- DebuggerTrace::ChunkHeader{schema: Test::EVENT_SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: Test::FIRST_EVENT, last_event: Test::FIRST_EVENT, payload_length: manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_bytes)}
    manifest_chunk.payload_length <- manifest_bytes.length
    manifest_chunk.checksum <- DebuggerTraceBinary::writer_checksum(manifest_bytes)
    for index in 0..<manifest_bytes.length:
        manifest_chunk.payload[index] <- manifest_bytes.bytes[index]

    reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceReader::reader_new() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    return Test::RESULT_PAYLOAD_MANIFEST_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, manifest_chunk))
    event_chunk: mutable DebuggerTraceStorage::StoredChunk = recorder.chunks[0]
    event_chunk.header.sequence <- 1
    return Test::RESULT_PAYLOAD_WIRE_LENGTH if event_chunk.payload_length != Test::PayloadFixture::ENCODED_BYTES
    return Test::RESULT_PAYLOAD_WIRE_FIELDS if event_chunk.payload[Test::PayloadFixture::KIND_OFFSET] != DebuggerEvents::EventPayloadKind.Bytes.u16().u8() or event_chunk.payload[Test::PayloadFixture::LENGTH_OFFSET] != Test::PayloadFixture::LENGTH.u8() or event_chunk.payload[Test::PayloadFixture::BODY_OFFSET] != Test::PayloadFixture::FIRST
    return Test::RESULT_PAYLOAD_STORAGE_REJECTED if not DebuggerTraceStorage::storage_event_payload_is_valid(event_chunk.payload[0], 0, event_chunk.payload_length, Test::EVENT_SCHEMA, Test::FIRST_EVENT, Test::FIRST_EVENT)
    event_ingest_failure: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(reader, event_chunk)
    return Test::RESULT_PAYLOAD_EVENT_INGEST_FAILED if not DebuggerErrors::error_is_ok(event_ingest_failure)
    return Test::RESULT_PAYLOAD_READER_NOT_EXACT if not DebuggerTraceReader::reader_is_exact(reader)
    decoded: DebuggerEvents::EventEnvelope = reader.events[0]
    return Test::RESULT_PAYLOAD_DATA_MISMATCH if decoded.state_hash != event.state_hash or decoded.payload_kind != event.payload_kind or decoded.payload_length != event.payload_length or decoded.payload_hash != event.payload_hash or decoded.payload[0] != Test::PayloadFixture::FIRST or decoded.payload[1] != Test::PayloadFixture::SECOND or decoded.payload[2] != Test::PayloadFixture::THIRD or decoded.payload[3] != Test::PayloadFixture::FOURTH
    corrupt_reader: mutable heap DebuggerTraceReader::TraceReader& = DebuggerTraceReader::reader_new() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    return Test::RESULT_PAYLOAD_MANIFEST_FAILED if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(corrupt_reader, manifest_chunk))
    corrupted_event_chunk: mutable DebuggerTraceStorage::StoredChunk = event_chunk
    corrupted_event_chunk.payload[Test::PayloadFixture::BODY_OFFSET] <- corrupted_event_chunk.payload[Test::PayloadFixture::BODY_OFFSET] + Test::PayloadFixture::CORRUPTION_DELTA
    corrupted_checksum: u64 = DebuggerTraceBinary::bytes_checksum(corrupted_event_chunk.payload[0], corrupted_event_chunk.payload_length)
    corrupted_event_chunk.checksum <- corrupted_checksum
    corrupted_event_chunk.header.checksum <- corrupted_checksum
    corrupt_event_failure: DebuggerErrors::DebuggerError = DebuggerTraceReader::reader_ingest(corrupt_reader, corrupted_event_chunk)
    return Test::RESULT_PAYLOAD_CORRUPTION_ACCEPTED if DebuggerErrors::error_is_ok(corrupt_event_failure) or DebuggerTraceReader::reader_is_exact(corrupt_reader) or DebuggerTraceReader::reader_event_count(corrupt_reader) != 0
    return 0

def main() -> i64:
    return check_variable_event_codec() if check_variable_event_codec() != 0
    return check_event_envelope_contract() if check_event_envelope_contract() != 0
    return check_payload_round_trip() if check_payload_round_trip() != 0
    return check_record_and_read() if check_record_and_read() != 0
    return check_record_and_read_full_checkpoint() if check_record_and_read_full_checkpoint() != 0
    return check_resource_limit_keeps_verified_prefix() if check_resource_limit_keeps_verified_prefix() != 0
    return check_resource_limit_rejects_unstorable_event() if check_resource_limit_rejects_unstorable_event() != 0
    return check_rejects_bad_event() if check_rejects_bad_event() != 0
    return check_rejects_corrupt_quality() if check_rejects_corrupt_quality() != 0
    return check_rejects_malformed_pending_position() if check_rejects_malformed_pending_position() != 0
    return check_rejects_non_root_event() if check_rejects_non_root_event() != 0
    return check_rejects_non_root_checkpoint() if check_rejects_non_root_checkpoint() != 0
    return check_rejects_malformed_manifest() if check_rejects_malformed_manifest() != 0
    return 0
