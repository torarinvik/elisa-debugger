# Focused compile-time coverage for recorder chunks and lossless reading.

include "../src/trace/binary.elisa"
include "../src/trace/storage.elisa"
include "../src/trace/manifest.elisa"
include "../src/trace/recorder.elisa"
include "../src/trace/reader.elisa"

const TEST_BUILD: u64 = 21
const TEST_RECORDING: u64 = 22
const TEST_EVENT_SCHEMA: u32 = 1
const TEST_EVENT_HASH: u64 = 23
const TEST_EVENT_COUNT: u64 = 1
const TEST_BAD_SCHEMA: u32 = 2
const TEST_EVENT_OFFSET: usize = 36

def build_identity() -> DebuggerIdentity::BuildIdentity:
    return DebuggerIdentity::BuildIdentity{compiler: DebuggerIdentity::debug_id(TEST_BUILD), runtime: DebuggerIdentity::debug_id(TEST_BUILD + 1), source: DebuggerIdentity::debug_id(TEST_BUILD + 2), target: DebuggerIdentity::debug_id(TEST_BUILD + 3), metadata_version: 1}

def make_event(recording: u64, schema: u32, ordinal: u64) -> DebuggerEvents::EventEnvelope:
    position: DebuggerIdentity::Position = DebuggerIdentity::initial_position(DebuggerIdentity::debug_id(recording))
    position.event <- ordinal
    return DebuggerEvents::event_envelope(schema, ordinal, position, DebuggerEvents::EventKind.ExecutionBoundary, DebuggerEvents::EventQuality.Exact, TEST_EVENT_HASH)

def check_record_and_read() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build_identity(), DebuggerIdentity::debug_id(TEST_RECORDING))
    event: DebuggerEvents::EventEnvelope = make_event(TEST_RECORDING, TEST_EVENT_SCHEMA, 0)
    return 1 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    return 2 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_finalize(recorder))
    return 3 if recorder.chunk_count != 1 or recorder.manifest.last_event != 0 or recorder.manifest.checkpoint_count != 0 or not DebuggerTraceRecorder::recorder_is_exact(recorder)
    reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    manifest_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(recorder.manifest)
    manifest: mutable DebuggerTraceStorage::StoredChunk = zeroed
    manifest.header <- DebuggerTrace::ChunkHeader{schema: 1, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: 0, payload_length: manifest_bytes.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(manifest_bytes)}
    manifest.payload_length <- manifest_bytes.length
    manifest.checksum <- DebuggerTraceBinary::writer_checksum(manifest_bytes)
    for index in 0..<manifest_bytes.length:
        manifest.payload[index] <- manifest_bytes.bytes[index]
    return 4 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, manifest))
    chunk: mutable DebuggerTraceStorage::StoredChunk = recorder.chunks[0]
    chunk.header.sequence <- 1
    return 5 if not DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, chunk))
    return 6 if DebuggerTraceReader::reader_event_count(reader) != TEST_EVENT_COUNT or not DebuggerTraceReader::reader_is_exact(reader)
    return 0

def check_rejects_bad_event() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build_identity(), DebuggerIdentity::debug_id(TEST_RECORDING))
    bad: DebuggerEvents::EventEnvelope = make_event(TEST_RECORDING, TEST_BAD_SCHEMA, 0)
    return 7 if DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, bad))
    return 0

def check_rejects_corrupt_quality() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build_identity(), DebuggerIdentity::debug_id(TEST_RECORDING))
    corrupt: mutable DebuggerEvents::EventEnvelope = make_event(TEST_RECORDING, TEST_EVENT_SCHEMA, 0)
    corrupt.quality <- DebuggerEvents::EventQuality.Corrupt
    return 11 if DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, corrupt))
    return 0

def check_rejects_malformed_pending_position() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build_identity(), DebuggerIdentity::debug_id(TEST_RECORDING))
    event: DebuggerEvents::EventEnvelope = make_event(TEST_RECORDING, TEST_EVENT_SCHEMA, 0)
    return 9 if not DebuggerErrors::error_is_ok(DebuggerTraceRecorder::recorder_append(recorder, event))
    recorder.pending[0].position.event <- 1
    return 10 if DebuggerTraceRecorder::recorder_is_exact(recorder)
    return 0

def check_rejects_malformed_manifest() -> i64:
    recorder: mutable DebuggerTraceRecorder::TraceRecorder = DebuggerTraceRecorder::recorder_new(build_identity(), DebuggerIdentity::debug_id(TEST_RECORDING))
    malformed: mutable DebuggerTraceManifest::BundleManifest = recorder.manifest
    malformed.metadata_version <- 0
    payload: DebuggerTraceBinary::ByteWriter = DebuggerTraceManifest::manifest_encode(malformed)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: TEST_EVENT_SCHEMA, kind: DebuggerTrace::ChunkKind.Manifest, sequence: 0, first_event: 0, last_event: 0, payload_length: payload.length.u64(), checksum: DebuggerTraceBinary::writer_checksum(payload)}
    chunk.payload_length <- payload.length
    chunk.checksum <- DebuggerTraceBinary::writer_checksum(payload)
    for index in 0..<payload.length:
        chunk.payload[index] <- payload.bytes[index]
    reader: mutable DebuggerTraceReader::TraceReader = DebuggerTraceReader::reader_new()
    return 8 if DebuggerErrors::error_is_ok(DebuggerTraceReader::reader_ingest(reader, chunk))
    return 0

def main() -> i64:
    return check_record_and_read() if check_record_and_read() != 0
    return check_rejects_bad_event() if check_rejects_bad_event() != 0
    return check_rejects_corrupt_quality() if check_rejects_corrupt_quality() != 0
    return check_rejects_malformed_pending_position() if check_rejects_malformed_pending_position() != 0
    return check_rejects_malformed_manifest() if check_rejects_malformed_manifest() != 0
    return 0
