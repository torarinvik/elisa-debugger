    EVENT_OFFSET: usize = 36
    CHECKPOINT_BRANCH: u64 = 0
    NON_ROOT_BRANCH: u64 = 1
    WRONG_RECORDING: u64 = Test::RECORDING + 100
    CHECKPOINT_STATE_HASH_SEED: u64 = 0
    FIRST_CHECKPOINT_EVENT: u64 = 0
    CHECKPOINT_EVENT: u64 = 1
    CHECKPOINT_ID_OFFSET: u64 = 1
    CHECKPOINT_COUNT: u64 = 2
    MANIFEST_SEQUENCE: u64 = 0
    FIRST_EVENT: u64 = 0
    FINAL_EVENT_BOUNDARY: u64 = Test::CHECKPOINT_EVENT + 1
    OUTSIDE_FINAL_EVENT_BOUNDARY: u64 = Test::FINAL_EVENT_BOUNDARY + 1
    RECORDED_EVENT_COUNT: usize = 2
    RECORDED_CHUNK_COUNT: usize = 4
    RECORDED_CHECKPOINT_COUNT: usize = 2
    FOOTER_SEQUENCE_OFFSET: u64 = 1
    FIRST_CHECKPOINT_INDEX: usize = 0
    RESOURCE_LIMIT_EVENT_COUNT: u64 = 128
    RESOURCE_LIMIT_LAST_EVENT: u64 = 127
    RESOURCE_LIMIT_CHUNK_COUNT: usize = 8
    RESOURCE_LIMIT_OVERFLOW_EVENT: u64 = Test::RESOURCE_LIMIT_EVENT_COUNT
    RESOURCE_LIMIT_PENDING_EVENT_COUNT: usize = 0
    FIRST_EVENT_CHUNK_INDEX: usize = 0
    CHECKPOINT_CHUNK_INDEX: usize = 1
    SECOND_EVENT_CHUNK_INDEX: usize = 2
    SECOND_CHECKPOINT_CHUNK_INDEX: usize = 3
    RESULT_FIRST_CHECKPOINT_EVENT_APPEND_FAILED: i64 = 12
    RESULT_CHECKPOINT_APPEND_FAILED: i64 = 13
    RESULT_SECOND_CHECKPOINT_EVENT_APPEND_FAILED: i64 = 14
    RESULT_CHECKPOINT_RECORDER_FINALIZE_FAILED: i64 = 15
    RESULT_CHECKPOINT_RECORDER_NOT_EXACT: i64 = 16
    RESULT_CHECKPOINT_CHUNK_ORDER_MISMATCH: i64 = 17
    RESULT_CHECKPOINT_MANIFEST_INGEST_FAILED: i64 = 18
    RESULT_CHECKPOINT_CHUNK_INGEST_FAILED: i64 = 19
    RESULT_CHECKPOINT_READER_NOT_EXACT: i64 = 20
    RESULT_CHECKPOINT_LOOKUP_MISMATCH: i64 = 21
    RESULT_CHECKPOINT_STORAGE_SCAN_FAILED: i64 = 22
