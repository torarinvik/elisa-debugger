include "../src/trace/retention.elisa"
include "../src/trace/health.elisa"

const FIRST_CHUNK: u64 = 1
const SECOND_CHUNK: u64 = 2
const LATE_CHILD_CHUNK: u64 = 4
const ROOT_PARENT_CHUNK: u64 = 0
const PARENT_CHUNK: u64 = 1
const EVENT: u64 = 4
const THIRD_CHUNK: u64 = 3
const COLLECTED_PARENT_RESULT: i64 = 15
const STALE_DEPENDENCY_RESULT: i64 = 16
const RETENTION_CHUNK_CAPACITY: usize = 128
const RETENTION_PIN_CAPACITY: usize = 64

def main() -> i64:
    store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_new()
    store <- DebuggerTraceRetention::retention_add_chunk(store, FIRST_CHUNK, 0)
    store <- DebuggerTraceRetention::retention_add_chunk(store, SECOND_CHUNK, PARENT_CHUNK)
    store <- DebuggerTraceRetention::retention_add_reference(store, FIRST_CHUNK)
    store <- DebuggerTraceRetention::retention_pin(store, SECOND_CHUNK)
    return 5 if store.chunks[0].references == 0 or store.chunks[1].references == 0
    plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(store)
    return 1 if plan.count != 0
    store <- DebuggerTraceRetention::retention_unpin(store, SECOND_CHUNK)
    store <- DebuggerTraceRetention::retention_apply_collection(store, DebuggerTraceRetention::retention_plan_collection(store))
    return 2 if store.chunks[1].live
    store <- DebuggerTraceRetention::retention_remove_reference(store, FIRST_CHUNK)
    store <- DebuggerTraceRetention::retention_apply_collection(store, DebuggerTraceRetention::retention_plan_collection(store))
    return 6 if store.chunks[0].live
    rejected_child: DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_add_chunk(store, THIRD_CHUNK, SECOND_CHUNK)
    return COLLECTED_PARENT_RESULT if rejected_child.count != store.count
    dead_reference_attempt: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_add_reference(store, SECOND_CHUNK)
    return 9 if dead_reference_attempt.chunks[1].references != 0 or dead_reference_attempt.chunks[1].live
    dead_pin_attempt: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_pin(store, SECOND_CHUNK)
    return 10 if dead_pin_attempt.chunks[1].pinned or dead_pin_attempt.chunks[1].references != 0
    stale_store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_new()
    stale_store <- DebuggerTraceRetention::retention_add_chunk(stale_store, SECOND_CHUNK, PARENT_CHUNK)
    return 8 if stale_store.count != 0
    stale_store <- DebuggerTraceRetention::retention_add_chunk(stale_store, FIRST_CHUNK, 0)
    stale_plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(stale_store)
    stale_store <- DebuggerTraceRetention::retention_pin(stale_store, FIRST_CHUNK)
    stale_store <- DebuggerTraceRetention::retention_apply_collection(stale_store, stale_plan)
    return 7 if not stale_store.chunks[0].live or not stale_store.chunks[0].pinned
    stale_dependency_store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_new()
    stale_dependency_store <- DebuggerTraceRetention::retention_add_chunk(stale_dependency_store, FIRST_CHUNK, ROOT_PARENT_CHUNK)
    stale_dependency_plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(stale_dependency_store)
    stale_dependency_store <- DebuggerTraceRetention::retention_add_chunk(stale_dependency_store, LATE_CHILD_CHUNK, FIRST_CHUNK)
    stale_dependency_store <- DebuggerTraceRetention::retention_apply_collection(stale_dependency_store, stale_dependency_plan)
    return STALE_DEPENDENCY_RESULT if not stale_dependency_store.chunks[0].live or not DebuggerTraceRetention::retention_chain_is_valid(stale_dependency_store, LATE_CHILD_CHUNK)
    health: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_verify(DebuggerTraceHealth::health_exact(), EVENT)
    return 3 if not DebuggerTraceHealth::health_can_replay(health, EVENT)
    degraded: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_downgrade(health, DebuggerTraceHealth::HealthState.Partial, EVENT + 1, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, 1))
    return 4 if DebuggerTraceHealth::health_can_replay(degraded, EVENT + 1)
    verified_after_failure: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_verify(degraded, EVENT + 2)
    return 11 if verified_after_failure.last_verified_event != EVENT or verified_after_failure.failure_event != EVENT + 1
    malformed_count: mutable DebuggerTraceRetention::RetentionStore = store
    malformed_count.count <- RETENTION_CHUNK_CAPACITY + 1
    return 12 if DebuggerTraceRetention::retention_find(malformed_count, FIRST_CHUNK) != RETENTION_CHUNK_CAPACITY
    malformed_pins: mutable DebuggerTraceRetention::RetentionStore = store
    malformed_pins.pin_count <- RETENTION_PIN_CAPACITY + 1
    _ = DebuggerTraceRetention::retention_unpin(malformed_pins, FIRST_CHUNK)
    orphan_pin: mutable DebuggerTraceRetention::RetentionStore = store
    orphan_pin.chunks[0].pinned <- true
    orphan_pin.chunks[0].references <- 1
    orphan_result: DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_unpin(orphan_pin, FIRST_CHUNK)
    return 13 if orphan_result.chunks[0].references != 1 or not orphan_result.chunks[0].pinned
    return 0
