include "../src/trace/retention.elisa"
include "../src/trace/health.elisa"

const FIRST_CHUNK: u64 = 1
const SECOND_CHUNK: u64 = 2
const PARENT_CHUNK: u64 = 1
const EVENT: u64 = 4

def main() -> i64:
    store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_new()
    store <- DebuggerTraceRetention::retention_add_chunk(store, FIRST_CHUNK, 0)
    store <- DebuggerTraceRetention::retention_add_chunk(store, SECOND_CHUNK, PARENT_CHUNK)
    store <- DebuggerTraceRetention::retention_add_reference(store, FIRST_CHUNK)
    store <- DebuggerTraceRetention::retention_pin(store, SECOND_CHUNK)
    plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(store)
    return 1 if plan.count != 0
    store <- DebuggerTraceRetention::retention_unpin(store, SECOND_CHUNK)
    store <- DebuggerTraceRetention::retention_apply_collection(store, DebuggerTraceRetention::retention_plan_collection(store))
    return 2 if store.chunks[1].live
    health: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_verify(DebuggerTraceHealth::health_exact(), EVENT)
    return 3 if not DebuggerTraceHealth::health_can_replay(health, EVENT)
    degraded: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_downgrade(health, DebuggerTraceHealth::HealthState.Partial, EVENT + 1, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, 1))
    return 4 if DebuggerTraceHealth::health_can_replay(degraded, EVENT + 1)
    return 0
