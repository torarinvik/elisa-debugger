include "../src/trace/retention.elisa"
include "../src/trace/health.elisa"

const module Test:
    FIRST_CHUNK: u64 = 1
    SECOND_CHUNK: u64 = 2
    LATE_CHILD_CHUNK: u64 = 4
    ROOT_PARENT_CHUNK: u64 = 0
    PARENT_CHUNK: u64 = 1
    EVENT: u64 = 4
    THIRD_CHUNK: u64 = 3
    COLLECTED_PARENT_RESULT: i64 = 15
    STALE_DEPENDENCY_RESULT: i64 = 16
    MALFORMED_COLLECTION_COUNT_RESULT: i64 = 17
    MALFORMED_COLLECTION_PIN_COUNT_RESULT: i64 = 18
    RETENTION_CHUNK_CAPACITY: usize = 128
    RETENTION_PIN_CAPACITY: usize = 64
    RETENTION_INVALID_CHUNK_COUNT: usize = Test::RETENTION_CHUNK_CAPACITY + 1
    RETENTION_INVALID_PIN_COUNT: usize = Test::RETENTION_PIN_CAPACITY + 1
    HEALTH_FIRST_FAILURE_EVENT: u64 = Test::EVENT + 1
    HEALTH_LATER_FAILURE_EVENT: u64 = Test::EVENT + 2
    HEALTH_FIRST_FAILURE_DETAIL: u32 = 1
    HEALTH_LATER_FAILURE_DETAIL: u32 = 2
    HEALTH_FAILURE_RESULT: i64 = 19
    HEALTH_EARLIER_FAILURE_DETAIL: u32 = 3
    HEALTH_EARLIER_FAILURE_RESULT: i64 = 20
    FIRST_TRACE_EVENT: u64 = 0
    HEALTH_EXPECTED_CLAMPED_EVENT: u64 = Test::EVENT - 1
    HEALTH_UNVERIFIED_REPLAY_RESULT: i64 = 21
    HEALTH_VERIFIED_FIRST_EVENT_RESULT: i64 = 22
    HEALTH_ZERO_FAILURE_BOUNDARY_RESULT: i64 = 23
    HEALTH_FAILURE_PREFIX_RESULT: i64 = 24


def main() -> i64:
    store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_new()
    store <- DebuggerTraceRetention::retention_add_chunk(store, Test::FIRST_CHUNK, 0)
    store <- DebuggerTraceRetention::retention_add_chunk(store, Test::SECOND_CHUNK, Test::PARENT_CHUNK)
    malformed_collection_store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_add_chunk(DebuggerTraceRetention::retention_new(), Test::FIRST_CHUNK, Test::ROOT_PARENT_CHUNK)
    malformed_collection_plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(malformed_collection_store)
    malformed_collection_store.count <- Test::RETENTION_INVALID_CHUNK_COUNT
    rejected_malformed_collection: DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_apply_collection(malformed_collection_store, malformed_collection_plan)
    return Test::MALFORMED_COLLECTION_COUNT_RESULT if rejected_malformed_collection.count != Test::RETENTION_INVALID_CHUNK_COUNT or not rejected_malformed_collection.chunks[0].live
    malformed_pin_store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_add_chunk(DebuggerTraceRetention::retention_new(), Test::FIRST_CHUNK, Test::ROOT_PARENT_CHUNK)
    malformed_pin_plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(malformed_pin_store)
    malformed_pin_store.pin_count <- Test::RETENTION_INVALID_PIN_COUNT
    rejected_malformed_pin_store: DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_apply_collection(malformed_pin_store, malformed_pin_plan)
    return Test::MALFORMED_COLLECTION_PIN_COUNT_RESULT if rejected_malformed_pin_store.pin_count != Test::RETENTION_INVALID_PIN_COUNT or not rejected_malformed_pin_store.chunks[0].live
    store <- DebuggerTraceRetention::retention_add_reference(store, Test::FIRST_CHUNK)
    store <- DebuggerTraceRetention::retention_pin(store, Test::SECOND_CHUNK)
    return 5 if store.chunks[0].references == 0 or store.chunks[1].references == 0
    plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(store)
    return 1 if plan.count != 0
    store <- DebuggerTraceRetention::retention_unpin(store, Test::SECOND_CHUNK)
    store <- DebuggerTraceRetention::retention_apply_collection(store, DebuggerTraceRetention::retention_plan_collection(store))
    return 2 if store.chunks[1].live
    store <- DebuggerTraceRetention::retention_remove_reference(store, Test::FIRST_CHUNK)
    store <- DebuggerTraceRetention::retention_apply_collection(store, DebuggerTraceRetention::retention_plan_collection(store))
    return 6 if store.chunks[0].live
    rejected_child: DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_add_chunk(store, Test::THIRD_CHUNK, Test::SECOND_CHUNK)
    return Test::COLLECTED_PARENT_RESULT if rejected_child.count != store.count
    dead_reference_attempt: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_add_reference(store, Test::SECOND_CHUNK)
    return 9 if dead_reference_attempt.chunks[1].references != 0 or dead_reference_attempt.chunks[1].live
    dead_pin_attempt: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_pin(store, Test::SECOND_CHUNK)
    return 10 if dead_pin_attempt.chunks[1].pinned or dead_pin_attempt.chunks[1].references != 0
    stale_store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_new()
    stale_store <- DebuggerTraceRetention::retention_add_chunk(stale_store, Test::SECOND_CHUNK, Test::PARENT_CHUNK)
    return 8 if stale_store.count != 0
    stale_store <- DebuggerTraceRetention::retention_add_chunk(stale_store, Test::FIRST_CHUNK, 0)
    stale_plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(stale_store)
    stale_store <- DebuggerTraceRetention::retention_pin(stale_store, Test::FIRST_CHUNK)
    stale_store <- DebuggerTraceRetention::retention_apply_collection(stale_store, stale_plan)
    return 7 if not stale_store.chunks[0].live or not stale_store.chunks[0].pinned
    stale_dependency_store: mutable DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_new()
    stale_dependency_store <- DebuggerTraceRetention::retention_add_chunk(stale_dependency_store, Test::FIRST_CHUNK, Test::ROOT_PARENT_CHUNK)
    stale_dependency_plan: DebuggerTraceRetention::CollectionPlan = DebuggerTraceRetention::retention_plan_collection(stale_dependency_store)
    stale_dependency_store <- DebuggerTraceRetention::retention_add_chunk(stale_dependency_store, Test::LATE_CHILD_CHUNK, Test::FIRST_CHUNK)
    stale_dependency_store <- DebuggerTraceRetention::retention_apply_collection(stale_dependency_store, stale_dependency_plan)
    return Test::STALE_DEPENDENCY_RESULT if not stale_dependency_store.chunks[0].live or not DebuggerTraceRetention::retention_chain_is_valid(stale_dependency_store, Test::LATE_CHILD_CHUNK)
    unverified_health: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_exact()
    return Test::HEALTH_UNVERIFIED_REPLAY_RESULT if DebuggerTraceHealth::health_can_replay(unverified_health, Test::FIRST_TRACE_EVENT)
    verified_first_event: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_verify(unverified_health, Test::FIRST_TRACE_EVENT)
    return Test::HEALTH_VERIFIED_FIRST_EVENT_RESULT if not DebuggerTraceHealth::health_can_replay(verified_first_event, Test::FIRST_TRACE_EVENT)
    zero_failure: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_downgrade(verified_first_event, DebuggerTraceHealth::HealthState.Partial, Test::FIRST_TRACE_EVENT, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Test::HEALTH_FIRST_FAILURE_DETAIL))
    return Test::HEALTH_ZERO_FAILURE_BOUNDARY_RESULT if zero_failure.has_verified_event
    health: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_verify(DebuggerTraceHealth::health_exact(), Test::EVENT)
    return 3 if not DebuggerTraceHealth::health_can_replay(health, Test::EVENT)
    degraded: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_downgrade(health, DebuggerTraceHealth::HealthState.Partial, Test::HEALTH_FIRST_FAILURE_EVENT, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Unavailable, true, Test::HEALTH_FIRST_FAILURE_DETAIL))
    return 4 if DebuggerTraceHealth::health_can_replay(degraded, Test::HEALTH_FIRST_FAILURE_EVENT)
    verified_after_failure: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_verify(degraded, Test::EVENT + 2)
    return 11 if verified_after_failure.last_verified_event != Test::EVENT or verified_after_failure.failure_event != Test::HEALTH_FIRST_FAILURE_EVENT
    diverged: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_downgrade(degraded, DebuggerTraceHealth::HealthState.Diverged, Test::HEALTH_LATER_FAILURE_EVENT, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.Diverged, false, Test::HEALTH_LATER_FAILURE_DETAIL))
    return Test::HEALTH_FAILURE_RESULT if diverged.state != DebuggerTraceHealth::HealthState.Diverged or diverged.failure_event != Test::HEALTH_FIRST_FAILURE_EVENT or diverged.failure.code != DebuggerErrors::ErrorCode.Unavailable or diverged.failure.detail != Test::HEALTH_FIRST_FAILURE_DETAIL
    earlier_partial: DebuggerTraceHealth::Health = DebuggerTraceHealth::health_downgrade(diverged, DebuggerTraceHealth::HealthState.Partial, Test::EVENT, DebuggerErrors::make_error(DebuggerErrors::ErrorCode.InvalidArgument, false, Test::HEALTH_EARLIER_FAILURE_DETAIL))
    return Test::HEALTH_EARLIER_FAILURE_RESULT if earlier_partial.state != DebuggerTraceHealth::HealthState.Diverged or earlier_partial.failure_event != Test::EVENT or earlier_partial.failure.code != DebuggerErrors::ErrorCode.InvalidArgument or earlier_partial.failure.detail != Test::HEALTH_EARLIER_FAILURE_DETAIL
    return Test::HEALTH_FAILURE_PREFIX_RESULT if not earlier_partial.has_verified_event or earlier_partial.last_verified_event != Test::HEALTH_EXPECTED_CLAMPED_EVENT
    malformed_count: mutable DebuggerTraceRetention::RetentionStore = store
    malformed_count.count <- Test::RETENTION_CHUNK_CAPACITY + 1
    return 12 if DebuggerTraceRetention::retention_find(malformed_count, Test::FIRST_CHUNK) != Test::RETENTION_CHUNK_CAPACITY
    malformed_pins: mutable DebuggerTraceRetention::RetentionStore = store
    malformed_pins.pin_count <- Test::RETENTION_PIN_CAPACITY + 1
    _ = DebuggerTraceRetention::retention_unpin(malformed_pins, Test::FIRST_CHUNK)
    orphan_pin: mutable DebuggerTraceRetention::RetentionStore = store
    orphan_pin.chunks[0].pinned <- true
    orphan_pin.chunks[0].references <- 1
    orphan_result: DebuggerTraceRetention::RetentionStore = DebuggerTraceRetention::retention_unpin(orphan_pin, Test::FIRST_CHUNK)
    return 13 if orphan_result.chunks[0].references != 1 or not orphan_result.chunks[0].pinned
    return 0
