include "../src/trace/storage.elisa"
include "../src/trace/binary.elisa"

const module Test:
    RECORDING_ID: u64 = 9
    CHUNK_SEQUENCE: u64 = 1
    FIRST_EVENT: u64 = 4
    LAST_EVENT: u64 = 4
    PAYLOAD_LENGTH: usize = 3
    TRAILING_BYTE_LENGTH: usize = 1
    EVENT_PAYLOAD_LENGTH: usize = 84
    STORAGE_FOOTER_LENGTH: usize = 20
    STORAGE_HEADER_BYTES: usize = 48
    STORAGE_CHECKSUM_OFFSET: usize = 40
    HASH_BYTE_BITS: u64 = 8
    HASH_PRIME: u64 = 1099511628211
    LEGACY_HASH_OFFSET_BASIS: u64 = 1469598103934665603


def test_legacy_checksum(bytes: u8&, length: usize) -> u64:
    checksum: mutable u64 = Test::LEGACY_HASH_OFFSET_BASIS
    for index in 0..<length:
        checksum <- (checksum ^ bytes[index].u64()) * Test::HASH_PRIME
    return checksum

def test_put_u64(bytes: mutable u8&, offset: usize, value: u64) -> void:
    for index in 0..<8:
        bytes[offset + index] <- (value >> (index.u64() * Test::HASH_BYTE_BITS)).u8()

def main() -> i64:
    payload_writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    payload_writer <- DebuggerTraceBinary::writer_put_byte(payload_writer, 65)
    payload_writer <- DebuggerTraceBinary::writer_put_byte(payload_writer, 66)
    payload_writer <- DebuggerTraceBinary::writer_put_byte(payload_writer, 67)
    checksum: u64 = DebuggerTraceBinary::writer_checksum(payload_writer)
    chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    chunk.header <- DebuggerTrace::ChunkHeader{schema: 1, kind: DebuggerTrace::ChunkKind.Metadata, sequence: Test::CHUNK_SEQUENCE, first_event: Test::FIRST_EVENT, last_event: Test::LAST_EVENT, payload_length: Test::PAYLOAD_LENGTH.u64(), checksum: checksum}
    chunk.payload_length <- Test::PAYLOAD_LENGTH
    chunk.checksum <- checksum
    for index in 0..<Test::PAYLOAD_LENGTH:
        chunk.payload[index] <- payload_writer.bytes[index]
    encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(chunk)
    return 1 if not DebuggerTraceBinary::writer_is_valid(encoded)
    decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(encoded.bytes[0], encoded.length)
    return 2 if decoded.status != DebuggerTraceStorage::StorageStatus.Ready or decoded.chunk.header.kind != DebuggerTrace::ChunkKind.Metadata or decoded.chunk.header.sequence != Test::CHUNK_SEQUENCE or decoded.chunk.payload_length != Test::PAYLOAD_LENGTH or decoded.chunk.payload[2] != 67
    legacy_checksum: u64 = test_legacy_checksum(payload_writer.bytes[0], payload_writer.length)
    legacy_wire: mutable u8[8192] = zeroed
    for index in 0..<encoded.length:
        legacy_wire[index] <- encoded.bytes[index]
    test_put_u64(legacy_wire[0], Test::STORAGE_CHECKSUM_OFFSET, legacy_checksum)
    legacy_decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(legacy_wire[0], encoded.length)
    return 9 if legacy_decoded.status != DebuggerTraceStorage::StorageStatus.Ready
    legacy_reencoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(legacy_decoded.chunk)
    return 10 if not DebuggerTraceBinary::writer_is_valid(legacy_reencoded)
    canonical_decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(legacy_reencoded.bytes[0], legacy_reencoded.length)
    return 11 if canonical_decoded.status != DebuggerTraceStorage::StorageStatus.Ready or canonical_decoded.chunk.header.checksum != checksum
    truncated: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(encoded.bytes[0], encoded.length - Test::TRAILING_BYTE_LENGTH)
    return 3 if truncated.status != DebuggerTraceStorage::StorageStatus.Truncated
    with_trailing: mutable u8[8192] = zeroed
    for index in 0..<encoded.length:
        with_trailing[index] <- encoded.bytes[index]
    with_trailing[encoded.length] <- 88
    trailing: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(with_trailing[0], encoded.length + Test::TRAILING_BYTE_LENGTH)
    return 4 if trailing.status != DebuggerTraceStorage::StorageStatus.Invalid
    with_trailing[encoded.length - 1] <- with_trailing[encoded.length - 1] + 1
    corrupt: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(with_trailing[0], encoded.length)
    return 5 if corrupt.status != DebuggerTraceStorage::StorageStatus.Invalid
    invalid_event_payload: mutable u8[Test::EVENT_PAYLOAD_LENGTH] = zeroed
    invalid_event_writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    for index in 0..<Test::EVENT_PAYLOAD_LENGTH:
        invalid_event_writer <- DebuggerTraceBinary::writer_put_byte(invalid_event_writer, invalid_event_payload[index])
    invalid_event_checksum: u64 = DebuggerTraceBinary::writer_checksum(invalid_event_writer)
    invalid_event_chunk: mutable DebuggerTraceStorage::StoredChunk = zeroed
    invalid_event_chunk.header <- DebuggerTrace::ChunkHeader{schema: 1, kind: DebuggerTrace::ChunkKind.Events, sequence: Test::CHUNK_SEQUENCE, first_event: Test::FIRST_EVENT, last_event: Test::FIRST_EVENT, payload_length: Test::EVENT_PAYLOAD_LENGTH.u64(), checksum: invalid_event_checksum}
    invalid_event_chunk.payload_length <- Test::EVENT_PAYLOAD_LENGTH
    invalid_event_chunk.checksum <- invalid_event_checksum
    for index in 0..<Test::EVENT_PAYLOAD_LENGTH:
        invalid_event_chunk.payload[index] <- invalid_event_payload[index]
    invalid_event_encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(invalid_event_chunk)
    invalid_event_decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(invalid_event_encoded.bytes[0], invalid_event_encoded.length)
    return 7 if invalid_event_decoded.status != DebuggerTraceStorage::StorageStatus.Invalid
    event_stream: mutable u8[8192] = zeroed
    for index in 0..<invalid_event_encoded.length:
        event_stream[index] <- invalid_event_encoded.bytes[index]
    invalid_footer: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(1, Test::FIRST_EVENT)
    for index in 0..<Test::STORAGE_FOOTER_LENGTH:
        event_stream[invalid_event_encoded.length + index] <- invalid_footer.bytes[index]
    scanned: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(event_stream[0], invalid_event_encoded.length + Test::STORAGE_FOOTER_LENGTH)
    return 8 if scanned.status != DebuggerTraceStorage::StorageStatus.Invalid
    inconsistent_recording_payload: mutable u8[Test::EVENT_PAYLOAD_LENGTH] = zeroed
    inconsistent_recording_writer: mutable DebuggerTraceBinary::ByteWriter = DebuggerTraceBinary::writer_new()
    inconsistent_recording_writer <- DebuggerTraceBinary::writer_put_u32(inconsistent_recording_writer, 1)
    inconsistent_recording_writer <- DebuggerTraceBinary::writer_put_u64(inconsistent_recording_writer, Test::FIRST_EVENT.u64())
    inconsistent_recording_writer <- DebuggerTraceBinary::writer_put_u64(inconsistent_recording_writer, 1)
    inconsistent_recording_writer <- DebuggerTraceBinary::writer_put_u64(inconsistent_recording_writer, Test::RECORDING_ID)
    inconsistent_recording_writer <- DebuggerTraceBinary::writer_put_u64(inconsistent_recording_writer, Test::RECORDING_ID + 1)
    for index in inconsistent_recording_writer.length..<Test::EVENT_PAYLOAD_LENGTH:
        inconsistent_recording_writer <- DebuggerTraceBinary::writer_put_byte(inconsistent_recording_writer, 0)
    inconsistent_recording_checksum: u64 = DebuggerTraceBinary::writer_checksum(inconsistent_recording_writer)
    inconsistent_recording_chunk: mutable DebuggerTraceStorage::StoredChunk = invalid_event_chunk
    inconsistent_recording_chunk.header <- DebuggerTrace::ChunkHeader{schema: 1, kind: DebuggerTrace::ChunkKind.Events, sequence: Test::CHUNK_SEQUENCE, first_event: Test::FIRST_EVENT, last_event: Test::FIRST_EVENT, payload_length: Test::EVENT_PAYLOAD_LENGTH.u64(), checksum: inconsistent_recording_checksum}
    inconsistent_recording_chunk.payload_length <- Test::EVENT_PAYLOAD_LENGTH
    inconsistent_recording_chunk.checksum <- inconsistent_recording_checksum
    for index in 0..<Test::EVENT_PAYLOAD_LENGTH:
        inconsistent_recording_chunk.payload[index] <- inconsistent_recording_writer.bytes[index]
    inconsistent_recording_encoded: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_chunk(inconsistent_recording_chunk)
    inconsistent_recording_decoded: DebuggerTraceStorage::ChunkDecode = DebuggerTraceStorage::storage_decode_chunk(inconsistent_recording_encoded.bytes[0], inconsistent_recording_encoded.length)
    return 10 if inconsistent_recording_decoded.status != DebuggerTraceStorage::StorageStatus.Invalid
    footer_bytes: DebuggerTraceBinary::ByteWriter = DebuggerTraceStorage::storage_encode_footer(Test::CHUNK_SEQUENCE + 1, Test::LAST_EVENT)
    footer: DebuggerTraceStorage::FooterDecode = DebuggerTraceStorage::storage_decode_footer(footer_bytes.bytes[0], footer_bytes.length)
    return 6 if footer.status != DebuggerTraceStorage::StorageStatus.Ready or footer.footer.next_sequence != Test::CHUNK_SEQUENCE + 1 or footer.footer.verified_event != Test::LAST_EVENT
    footer_only: DebuggerTraceStorage::StorageScan = DebuggerTraceStorage::storage_scan_bytes(footer_bytes.bytes[0], footer_bytes.length)
    return 9 if footer_only.status != DebuggerTraceStorage::StorageStatus.Invalid or footer_only.footer_verified
    return 0
