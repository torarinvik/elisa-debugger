include "../src/metadata/types.elisa"

const module Test:
    const module Fixture:
        EMPTY_COUNT: usize = 0
        FIRST_COUNT: usize = 1
        FIRST_INCARNATION: u32 = 1
        ZERO_ID: u64 = 0
        ZERO_FLAGS: u32 = 0
        TYPE_ID: u64 = 10
        TYPE_NAME_ID: u64 = 11
        TYPE_DUPLICATE_NAME_ID: u64 = 99
        SCOPE_ID: u64 = 12
        FUNCTION_ID: u64 = 13
        BINDING_DECLARATION_ID: u64 = 14
        BINDING_NAME_ID: u64 = 15
        INVALID_PARENT_ID: u64 = 16
        TYPE_SIZE: u64 = 16
        TYPE_ALIGNMENT: u64 = 8
        TYPE_CHILD_COUNT: u64 = 2
        SCOPE_START_EVENT: u64 = 2
        SCOPE_END_EVENT: u64 = 8
        BINDING_LIFETIME_START: u64 = 2
        BINDING_LIFETIME_END: u64 = 8
        LIVE_EVENT: u64 = 7
        EXPIRED_EVENT: u64 = 8
        INVALID_START_EVENT: u64 = 9
        INVALID_END_EVENT: u64 = 2
        INVALID_BINDING_START_EVENT: u64 = 1
    const module Result:
        TYPE_ADD_FAILURE: i64 = 1
        TYPE_LOOKUP_FAILURE: i64 = 2
        DUPLICATE_TYPE_FAILURE: i64 = 3
        INVALID_TYPE_FAILURE: i64 = 4
        SCOPE_ADD_FAILURE: i64 = 5
        SCOPE_LOOKUP_FAILURE: i64 = 6
        DUPLICATE_SCOPE_FAILURE: i64 = 7
        INVALID_SCOPE_FAILURE: i64 = 8
        INVALID_PARENT_FAILURE: i64 = 9
        BINDING_ADD_FAILURE: i64 = 10
        BINDING_LOOKUP_FAILURE: i64 = 11
        INVALID_BINDING_FAILURE: i64 = 12
        RESET_FAILURE: i64 = 13
        SUCCESS: i64 = 0

def main() -> i64:
    store: mutable DebuggerTypeMetadata::MetadataStore = zeroed
    DebuggerTypeMetadata::metadata_initialize(store)
    type_info: DebuggerTypeMetadata::TypeInfo = DebuggerTypeMetadata::TypeInfo{id: DebuggerIdentity::debug_id(Test::Fixture::TYPE_ID), kind: DebuggerTypeMetadata::TypeKind.Struct, name: DebuggerIdentity::debug_id(Test::Fixture::TYPE_NAME_ID), size: Test::Fixture::TYPE_SIZE, alignment: Test::Fixture::TYPE_ALIGNMENT, child_count: Test::Fixture::TYPE_CHILD_COUNT, pointee: DebuggerIdentity::debug_id(Test::Fixture::ZERO_ID), flags: Test::Fixture::ZERO_FLAGS}
    return Test::Result::TYPE_ADD_FAILURE if not DebuggerTypeMetadata::metadata_add_type(store, type_info)
    found_type: DebuggerTypeMetadata::TypeInfo = DebuggerTypeMetadata::metadata_find_type(store, type_info.id)
    return Test::Result::TYPE_LOOKUP_FAILURE if found_type.id.value != Test::Fixture::TYPE_ID or found_type.child_count != Test::Fixture::TYPE_CHILD_COUNT
    duplicate_type: DebuggerTypeMetadata::TypeInfo = type_info
    duplicate_type.name <- DebuggerIdentity::debug_id(Test::Fixture::TYPE_DUPLICATE_NAME_ID)
    return Test::Result::DUPLICATE_TYPE_FAILURE if DebuggerTypeMetadata::metadata_add_type(store, duplicate_type) or store.type_count != Test::Fixture::FIRST_COUNT
    invalid_type: DebuggerTypeMetadata::TypeInfo = type_info
    invalid_type.id <- DebuggerIdentity::debug_id(Test::Fixture::ZERO_ID)
    return Test::Result::INVALID_TYPE_FAILURE if DebuggerTypeMetadata::metadata_add_type(store, invalid_type) or store.type_count != Test::Fixture::FIRST_COUNT

    scope_info: DebuggerTypeMetadata::ScopeInfo = DebuggerTypeMetadata::ScopeInfo{id: DebuggerIdentity::debug_id(Test::Fixture::SCOPE_ID), parent: DebuggerIdentity::debug_id(Test::Fixture::ZERO_ID), function: DebuggerIdentity::debug_id(Test::Fixture::FUNCTION_ID), start_event: Test::Fixture::SCOPE_START_EVENT, end_event: Test::Fixture::SCOPE_END_EVENT}
    return Test::Result::SCOPE_ADD_FAILURE if not DebuggerTypeMetadata::metadata_add_scope(store, scope_info)
    found_scope: DebuggerTypeMetadata::ScopeInfo = DebuggerTypeMetadata::metadata_find_scope(store, scope_info.id)
    return Test::Result::SCOPE_LOOKUP_FAILURE if found_scope.id.value != Test::Fixture::SCOPE_ID or not DebuggerTypeMetadata::metadata_scope_is_active(found_scope, Test::Fixture::LIVE_EVENT)
    return Test::Result::DUPLICATE_SCOPE_FAILURE if DebuggerTypeMetadata::metadata_add_scope(store, scope_info) or store.scope_count != Test::Fixture::FIRST_COUNT
    invalid_scope: DebuggerTypeMetadata::ScopeInfo = scope_info
    invalid_scope.id <- DebuggerIdentity::debug_id(Test::Fixture::INVALID_PARENT_ID)
    invalid_scope.start_event <- Test::Fixture::INVALID_START_EVENT
    invalid_scope.end_event <- Test::Fixture::INVALID_END_EVENT
    return Test::Result::INVALID_SCOPE_FAILURE if DebuggerTypeMetadata::metadata_add_scope(store, invalid_scope) or store.scope_count != Test::Fixture::FIRST_COUNT
    invalid_parent_scope: DebuggerTypeMetadata::ScopeInfo = scope_info
    invalid_parent_scope.id <- DebuggerIdentity::debug_id(Test::Fixture::INVALID_PARENT_ID)
    invalid_parent_scope.parent <- DebuggerIdentity::debug_id(Test::Fixture::INVALID_PARENT_ID)
    return Test::Result::INVALID_PARENT_FAILURE if DebuggerTypeMetadata::metadata_add_scope(store, invalid_parent_scope) or store.scope_count != Test::Fixture::FIRST_COUNT

    binding_info: DebuggerTypeMetadata::BindingInfo = DebuggerTypeMetadata::BindingInfo{id: DebuggerIdentity::BindingIdentity{declaration: DebuggerIdentity::debug_id(Test::Fixture::BINDING_DECLARATION_ID), incarnation: Test::Fixture::FIRST_INCARNATION}, name: DebuggerIdentity::debug_id(Test::Fixture::BINDING_NAME_ID), type_id: type_info.id, scope: scope_info.id, lifetime_start: Test::Fixture::BINDING_LIFETIME_START, lifetime_end: Test::Fixture::BINDING_LIFETIME_END}
    return Test::Result::BINDING_ADD_FAILURE if not DebuggerTypeMetadata::metadata_add_binding(store, binding_info)
    found_binding: DebuggerTypeMetadata::BindingInfo = DebuggerTypeMetadata::metadata_find_binding(store, binding_info.id)
    return Test::Result::BINDING_LOOKUP_FAILURE if found_binding.name.value != Test::Fixture::BINDING_NAME_ID or not DebuggerTypeMetadata::metadata_binding_is_live(found_binding, Test::Fixture::LIVE_EVENT) or DebuggerTypeMetadata::metadata_binding_is_live(found_binding, Test::Fixture::EXPIRED_EVENT)
    invalid_binding: DebuggerTypeMetadata::BindingInfo = binding_info
    invalid_binding.lifetime_start <- Test::Fixture::INVALID_BINDING_START_EVENT
    return Test::Result::INVALID_BINDING_FAILURE if DebuggerTypeMetadata::metadata_add_binding(store, invalid_binding) or store.binding_count != Test::Fixture::FIRST_COUNT

    DebuggerTypeMetadata::metadata_initialize(store)
    return Test::Result::RESET_FAILURE if store.type_count != Test::Fixture::EMPTY_COUNT or store.scope_count != Test::Fixture::EMPTY_COUNT or store.binding_count != Test::Fixture::EMPTY_COUNT or DebuggerTypeMetadata::metadata_find_type(store, type_info.id).id.value != Test::Fixture::ZERO_ID or DebuggerTypeMetadata::metadata_find_scope(store, scope_info.id).id.value != Test::Fixture::ZERO_ID or DebuggerTypeMetadata::metadata_find_binding(store, binding_info.id).id.declaration.value != Test::Fixture::ZERO_ID
    return Test::Result::SUCCESS
