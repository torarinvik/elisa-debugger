include "../src/inspect/store.elisa"

const STORE_GENERATION: u64 = 7
const INVALID_NEXT_ID: u64 = 65
const VALUE_NAME: u64 = 100
const VALUE_TYPE: u64 = 101
const INVALID_GENERATION_RESULT: i64 = 2
const UNINITIALIZED_NAME: u64 = 102
const UNINITIALIZED_TYPE: u64 = 103

def main() -> i64:
    store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(STORE_GENERATION)
    store.next_id <- INVALID_NEXT_ID
    handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(store, DebuggerIdentity::debug_id(VALUE_NAME), DebuggerIdentity::debug_id(VALUE_TYPE), 1)
    return 1 if handle.id.value != 0 or store.count != 0
    valid_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(STORE_GENERATION)
    valid_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(valid_store, DebuggerIdentity::debug_id(VALUE_NAME), DebuggerIdentity::debug_id(VALUE_TYPE), 1)
    return 11 if DebuggerValueStore::value_store_set_state(valid_store, valid_handle, DebuggerValues::ValueState.Uninitialized)
    valid_store.nodes[0].handle.stop_generation <- STORE_GENERATION + 1
    return 9 if DebuggerValueStore::value_store_is_valid(valid_store)
    return INVALID_GENERATION_RESULT if DebuggerValueStore::value_store_read(valid_store, valid_handle).state != DebuggerValues::ValueState.Invalid
    corrupted_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(STORE_GENERATION)
    corrupted_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(corrupted_store, DebuggerIdentity::debug_id(VALUE_NAME), DebuggerIdentity::debug_id(VALUE_TYPE), 1)
    corrupted_store.nodes[0].state <- DebuggerValues::ValueState.Invalid
    return 3 if DebuggerValueStore::value_store_read(corrupted_store, corrupted_handle).state != DebuggerValues::ValueState.Invalid
    uninitialized_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(STORE_GENERATION)
    uninitialized_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_uninitialized(uninitialized_store, DebuggerIdentity::debug_id(UNINITIALIZED_NAME), DebuggerIdentity::debug_id(UNINITIALIZED_TYPE))
    return 4 if DebuggerValueStore::value_store_read(uninitialized_store, uninitialized_handle).state != DebuggerValues::ValueState.Uninitialized
    uninitialized_store.nodes[0].signed_value <- 99
    return 8 if DebuggerValueStore::value_store_read(uninitialized_store, uninitialized_handle).state != DebuggerValues::ValueState.Invalid
    aggregate_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(STORE_GENERATION)
    aggregate_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(aggregate_store, DebuggerIdentity::debug_id(VALUE_NAME), DebuggerIdentity::debug_id(VALUE_TYPE))
    aggregate_store.nodes[0].child_count <- 1
    return 5 if DebuggerValueStore::value_store_read(aggregate_store, aggregate_handle).state != DebuggerValues::ValueState.Invalid
    dangling_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(STORE_GENERATION)
    dangling_parent: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(dangling_store, DebuggerIdentity::debug_id(VALUE_NAME), DebuggerIdentity::debug_id(VALUE_TYPE))
    dangling_store.nodes[0].child_count <- 1
    dangling_store.nodes[0].children[0] <- DebuggerIdentity::debug_id(VALUE_NAME)
    return 6 if DebuggerValueStore::value_store_read(dangling_store, dangling_parent).state != DebuggerValues::ValueState.Invalid
    invalid_child_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(STORE_GENERATION)
    invalid_parent: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(invalid_child_store, DebuggerIdentity::debug_id(VALUE_NAME), DebuggerIdentity::debug_id(VALUE_TYPE))
    invalid_child: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(invalid_child_store, DebuggerIdentity::debug_id(VALUE_NAME + 1), DebuggerIdentity::debug_id(VALUE_TYPE), 2)
    _ = DebuggerValueStore::value_store_add_child(invalid_child_store, invalid_parent, invalid_child)
    invalid_child_store.nodes[1].state <- DebuggerValues::ValueState.Invalid
    return 7 if DebuggerValueStore::value_store_read(invalid_child_store, invalid_parent).state != DebuggerValues::ValueState.Invalid
    cycle_store: mutable DebuggerValueStore::ValueStore = DebuggerValueStore::value_store_new(STORE_GENERATION)
    cycle_parent: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(cycle_store, DebuggerIdentity::debug_id(VALUE_NAME), DebuggerIdentity::debug_id(VALUE_TYPE))
    cycle_child: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(cycle_store, DebuggerIdentity::debug_id(VALUE_NAME + 2), DebuggerIdentity::debug_id(VALUE_TYPE))
    _ = DebuggerValueStore::value_store_add_child(cycle_store, cycle_parent, cycle_child)
    cycle_store.nodes[1].children[0] <- cycle_parent.id
    cycle_store.nodes[1].child_count <- 1
    return 10 if DebuggerValueStore::value_store_is_valid(cycle_store)
    return 0
