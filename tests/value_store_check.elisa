include "../src/inspect/store.elisa"

const module Test:
    const module Initialization:
        EMPTY_COUNT: usize = 0
        DIRTY_COUNT: usize = 1
        DIRTY_NEXT_ID: u64 = 2
        FIRST_VALUE_ID: u64 = 1
        NEXT_GENERATION: u64 = 8
        REINITIALIZATION_RESULT: i64 = 17
    STORE_GENERATION: u64 = 7
    INVALID_NEXT_ID: u64 = 65
    GAP_NEXT_ID: u64 = 2
    VALUE_NAME: u64 = 100
    VALUE_TYPE: u64 = 101
    INVALID_GENERATION_RESULT: i64 = 2
    UNINITIALIZED_NAME: u64 = 102
    UNINITIALIZED_TYPE: u64 = 103
    INVALID_BOOLEAN_RESULT: i64 = 13
    VALID_BOOLEAN_RESULT: i64 = 14
    INVALID_BOOLEAN_VALUE: i64 = 2
    BOOLEAN_TRUE_VALUE: i64 = 1
    VALUE_ID_GAP_RESULT: i64 = 15
    AVAILABLE_STATE_RESTORE_RESULT: i64 = 16


def main() -> i64:
    reused_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(reused_store, Test::STORE_GENERATION)
    reused_store.count <- Test::Initialization::DIRTY_COUNT
    reused_store.next_id <- Test::Initialization::DIRTY_NEXT_ID
    DebuggerValueStore::value_store_initialize(reused_store, Test::Initialization::NEXT_GENERATION)
    return Test::Initialization::REINITIALIZATION_RESULT if reused_store.generation != Test::Initialization::NEXT_GENERATION or reused_store.count != Test::Initialization::EMPTY_COUNT or reused_store.next_id != Test::Initialization::FIRST_VALUE_ID or not DebuggerValueStore::value_store_is_valid(reused_store)

    store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(store, Test::STORE_GENERATION)
    store.next_id <- Test::INVALID_NEXT_ID
    handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE), 1)
    return 1 if handle.id.value != 0 or store.count != 0
    return 12 if DebuggerValueStore::value_store_is_valid(store)
    gap_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(gap_store, Test::STORE_GENERATION)
    gap_store.next_id <- Test::GAP_NEXT_ID
    gap_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(gap_store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE), 1)
    return Test::VALUE_ID_GAP_RESULT if gap_handle.id.value != 0 or gap_store.count != 0 or DebuggerValueStore::value_store_is_valid(gap_store)
    valid_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(valid_store, Test::STORE_GENERATION)
    valid_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(valid_store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE), 1)
    return 11 if DebuggerValueStore::value_store_set_state(valid_store, valid_handle, DebuggerValues::ValueState.Uninitialized)
    valid_store.nodes[0].handle.stop_generation <- Test::STORE_GENERATION + 1
    return 9 if DebuggerValueStore::value_store_is_valid(valid_store)
    return Test::INVALID_GENERATION_RESULT if DebuggerValueStore::value_store_read(valid_store, valid_handle).state != DebuggerValues::ValueState.Invalid
    corrupted_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(corrupted_store, Test::STORE_GENERATION)
    corrupted_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(corrupted_store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE), 1)
    corrupted_store.nodes[0].state <- DebuggerValues::ValueState.Invalid
    return 3 if DebuggerValueStore::value_store_read(corrupted_store, corrupted_handle).state != DebuggerValues::ValueState.Invalid
    uninitialized_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(uninitialized_store, Test::STORE_GENERATION)
    uninitialized_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_uninitialized(uninitialized_store, DebuggerIdentity::debug_id(Test::UNINITIALIZED_NAME), DebuggerIdentity::debug_id(Test::UNINITIALIZED_TYPE))
    return 4 if DebuggerValueStore::value_store_read(uninitialized_store, uninitialized_handle).state != DebuggerValues::ValueState.Uninitialized
    return Test::AVAILABLE_STATE_RESTORE_RESULT if DebuggerValueStore::value_store_set_state(uninitialized_store, uninitialized_handle, DebuggerValues::ValueState.Available) or DebuggerValueStore::value_store_read(uninitialized_store, uninitialized_handle).state != DebuggerValues::ValueState.Uninitialized
    uninitialized_store.nodes[0].signed_value <- 99
    return 8 if DebuggerValueStore::value_store_read(uninitialized_store, uninitialized_handle).state != DebuggerValues::ValueState.Invalid
    invalid_boolean_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(invalid_boolean_store, Test::STORE_GENERATION)
    invalid_boolean_node: mutable DebuggerValueStore::ValueNode = zeroed
    invalid_boolean_node.name <- DebuggerIdentity::debug_id(Test::VALUE_NAME)
    invalid_boolean_node.type_id <- DebuggerIdentity::debug_id(Test::VALUE_TYPE)
    invalid_boolean_node.kind <- DebuggerValues::ValueKind.Boolean
    invalid_boolean_node.state <- DebuggerValues::ValueState.Available
    invalid_boolean_node.signed_value <- Test::INVALID_BOOLEAN_VALUE
    invalid_boolean_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add(invalid_boolean_store, invalid_boolean_node)
    return Test::INVALID_BOOLEAN_RESULT if invalid_boolean_handle.id.value != 0 or invalid_boolean_store.count != 0 or not DebuggerValueStore::value_store_is_valid(invalid_boolean_store)
    boolean_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(boolean_store, Test::STORE_GENERATION)
    boolean_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_boolean(boolean_store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE), true)
    return Test::VALID_BOOLEAN_RESULT if boolean_handle.id.value == 0 or DebuggerValueStore::value_store_read(boolean_store, boolean_handle).signed_value != Test::BOOLEAN_TRUE_VALUE
    aggregate_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(aggregate_store, Test::STORE_GENERATION)
    aggregate_handle: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(aggregate_store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE))
    aggregate_store.nodes[0].child_count <- 1
    return 5 if DebuggerValueStore::value_store_read(aggregate_store, aggregate_handle).state != DebuggerValues::ValueState.Invalid
    dangling_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(dangling_store, Test::STORE_GENERATION)
    dangling_parent: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(dangling_store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE))
    dangling_store.nodes[0].child_count <- 1
    dangling_store.nodes[0].children[0] <- DebuggerIdentity::debug_id(Test::VALUE_NAME)
    return 6 if DebuggerValueStore::value_store_read(dangling_store, dangling_parent).state != DebuggerValues::ValueState.Invalid
    invalid_child_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(invalid_child_store, Test::STORE_GENERATION)
    invalid_parent: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(invalid_child_store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE))
    invalid_child: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_scalar(invalid_child_store, DebuggerIdentity::debug_id(Test::VALUE_NAME + 1), DebuggerIdentity::debug_id(Test::VALUE_TYPE), 2)
    _ = DebuggerValueStore::value_store_add_child(invalid_child_store, invalid_parent, invalid_child)
    invalid_child_store.nodes[1].state <- DebuggerValues::ValueState.Invalid
    return 7 if DebuggerValueStore::value_store_read(invalid_child_store, invalid_parent).state != DebuggerValues::ValueState.Invalid
    cycle_store: mutable DebuggerValueStore::ValueStore = zeroed
    DebuggerValueStore::value_store_initialize(cycle_store, Test::STORE_GENERATION)
    cycle_parent: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(cycle_store, DebuggerIdentity::debug_id(Test::VALUE_NAME), DebuggerIdentity::debug_id(Test::VALUE_TYPE))
    cycle_child: DebuggerValues::ValueHandle = DebuggerValueStore::value_store_add_aggregate(cycle_store, DebuggerIdentity::debug_id(Test::VALUE_NAME + 2), DebuggerIdentity::debug_id(Test::VALUE_TYPE))
    _ = DebuggerValueStore::value_store_add_child(cycle_store, cycle_parent, cycle_child)
    cycle_store.nodes[1].children[0] <- cycle_parent.id
    cycle_store.nodes[1].child_count <- 1
    return 10 if DebuggerValueStore::value_store_is_valid(cycle_store)
    return 0
